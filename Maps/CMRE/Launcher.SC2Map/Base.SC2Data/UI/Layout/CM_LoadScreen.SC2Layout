        <Frame type="TabControl" name="InfoTabController">
            <Anchor side="Top" relative="$parent" pos="Min" offset="175" />
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0" />
            <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
            <Anchor side="Right" relative="$parent" pos="Max" offset="0" />
            <Width val="950" />
            <Height val="540" />
            <Animation name="AutoCyclePages">
                <Event event="OnShown" action="Reset,Play" frame="$this" />
                <Event event="CM_LoadScreenStartCycle" action="Reset,Play" frame="$this" />
                <Event event="OnHidden" action="Reset,Stop" frame="$this" />
                <Controller type="Property" property="SelectedIndex" frame="$this" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="0" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="1" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="2" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="3" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="0" />
                </Controller>
                <Controller type="Property" property="Texture" frame="$parent/LoadScreenImage" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="#CM_LoadScreenTab1Img" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="#CM_LoadScreenTab2Img" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="#CM_LoadScreenTab3Img" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="#CM_LoadScreenTab4Img" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="#CM_LoadScreenTab1Img" />
                </Controller>
                <Controller type="Property" property="Toggled" frame="TabButtonsContainer/Button01" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="True" />
                </Controller>
                <Controller type="Property" property="Toggled" frame="TabButtonsContainer/Button02" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
                <Controller type="Property" property="Toggled" frame="TabButtonsContainer/Button03" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
                <Controller type="Property" property="Toggled" frame="TabButtonsContainer/Button04" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
                <Controller type="Property" property="Visible" frame="PanelsContainer/Panel01" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="True" />
                </Controller>
                <Controller type="Property" property="Visible" frame="PanelsContainer/Panel02" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
                <Controller type="Property" property="Visible" frame="PanelsContainer/Panel03" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
                <Controller type="Property" property="Visible" frame="PanelsContainer/Panel04" end="Loop">
                    <Key type="Property" time="#CM_LoadScreenCycleTime1" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime2" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime3" value="False" />
                    <Key type="Property" time="#CM_LoadScreenCycleTime4" value="True" />
                    <Key type="Property" time="#CM_LoadScreenCycleLoopTime" value="False" />
                </Controller>
            </Animation>
            <Animation name="CyclePage1">
                <Event event="CM_LoadScreenPage1" action="Reset,Play" frame="$this" />
                <Controller type="State" stateGroup="PageState" frame="$this" end="Pause">
                    <Key type="Identifier" time="0" value="Page1" />
                </Controller>
            </Animation>
            <Animation name="CyclePage2">
                <Event event="CM_LoadScreenPage2" action="Reset,Play" frame="$this" />
                <Controller type="State" stateGroup="PageState" frame="$this" end="Pause">
                    <Key type="Identifier" time="0" value="Page2" />
                </Controller>
            </Animation>
            <Animation name="CyclePage3">
                <Event event="CM_LoadScreenPage3" action="Reset,Play" frame="$this" />
                <Controller type="State" stateGroup="PageState" frame="$this" end="Pause">
                    <Key type="Identifier" time="0" value="Page3" />
                </Controller>
            </Animation>
            <Animation name="CyclePage4">
                <Event event="CM_LoadScreenPage4" action="Reset,Play" frame="$this" />
                <Controller type="State" stateGroup="PageState" frame="$this" end="Pause">
                    <Key type="Identifier" time="0" value="Page4" />
                </Controller>
            </Animation>
            <StateGroup name="PageState">
                <DefaultState val="Page1" />
                <State name="Page1">
                    <Action type="SetProperty" frame="$this" SelectedIndex="0" />
                    <Action type="SetProperty" frame="$parent/LoadScreenImage" Texture="#CM_LoadScreenTab1Img" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button01" Toggled="True" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button02" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button03" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button04" Toggled="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel01" Visible="True" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel02" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel03" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel04" Visible="False" />
                </State>
                <State name="Page2">
                    <Action type="SetProperty" frame="$this" SelectedIndex="1" />
                    <Action type="SetProperty" frame="$parent/LoadScreenImage" Texture="#CM_LoadScreenTab2Img" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button01" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button02" Toggled="True" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button03" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button04" Toggled="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel01" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel02" Visible="True" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel03" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel04" Visible="False" />
                </State>
                <State name="Page3">
                    <Action type="SetProperty" frame="$this" SelectedIndex="2" />
                    <Action type="SetProperty" frame="$parent/LoadScreenImage" Texture="#CM_LoadScreenTab3Img" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button01" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button02" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button03" Toggled="True" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button04" Toggled="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel01" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel02" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel03" Visible="True" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel04" Visible="False" />
                </State>
                <State name="Page4">
                    <Action type="SetProperty" frame="$this" SelectedIndex="3" />
                    <Action type="SetProperty" frame="$parent/LoadScreenImage" Texture="#CM_LoadScreenTab4Img" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button01" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button02" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button03" Toggled="False" />
                    <Action type="SetProperty" frame="TabButtonsContainer/Button04" Toggled="True" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel01" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel02" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel03" Visible="False" />
                    <Action type="SetProperty" frame="PanelsContainer/Panel04" Visible="True" />
                </State>
            </StateGroup>
            <TabListItem val="$this/TabButtonsContainer/Button01" />
            <TabListItem val="$this/TabButtonsContainer/Button02" />
            <TabListItem val="$this/TabButtonsContainer/Button03" />
            <TabListItem val="$this/TabButtonsContainer/Button04" />
            <PanelListItem val="$this/PanelsContainer/Panel01" />
            <PanelListItem val="$this/PanelsContainer/Panel02" />
            <PanelListItem val="$this/PanelsContainer/Panel03" />
            <PanelListItem val="$this/PanelsContainer/Panel04" />
            <Frame type="Frame" name="TabButtonsContainer">
                <Handle val="CM_LoadScreenTabButtonsContainer" />
                <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
                <Anchor side="Right" relative="$parent" pos="Max" offset="0" />
                <Height val="86" />
                <Frame type="Button" name="Button01" template="CM_LoadScreen/TabButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="-408" />
                    <Visible val="#CM_LoadScreenTab1On" />
                    <Frame type="Label" name="Label">
                        <Text val="#CM_LoadScreenTab1Name" />
                    </Frame>
                    <Animation name="SelectPage">
                        <Event event="OnClick" action="Reset,Play" frame="$this" />
                        <Controller type="State" stateGroup="PageState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="Page1" />
                        </Controller>
                    </Animation>
                </Frame>
                <Frame type="Button" name="Button02" template="CM_LoadScreen/TabButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Left" relative="$parent/Button01" pos="Max" offset="5" />
                    <Visible val="#CM_LoadScreenTab2On" />
                    <Frame type="Label" name="Label">
                        <Text val="#CM_LoadScreenTab2Name" />
                    </Frame>
                    <Animation name="SelectPage">
                        <Event event="OnClick" action="Reset,Play" />
                        <Controller type="State" stateGroup="PageState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="Page2" />
                        </Controller>
                    </Animation>
                </Frame>
                <Frame type="Button" name="Button03" template="CM_LoadScreen/TabButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Left" relative="$parent/Button02" pos="Max" offset="5" />
                    <Visible val="#CM_LoadScreenTab3On" />
                    <Frame type="Label" name="Label">
                        <Text val="#CM_LoadScreenTab3Name" />
                    </Frame>
                    <Animation name="SelectPage">
                        <Event event="OnClick" action="Reset,Play" />
                        <Controller type="State" stateGroup="PageState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="Page3" />
                        </Controller>
                    </Animation>
                </Frame>
                <Frame type="Button" name="Button04" template="CM_LoadScreen/TabButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
                    <Anchor side="Left" relative="$parent/Button03" pos="Max" offset="5" />
                    <Visible val="#CM_LoadScreenTab4On" />
                    <Frame type="Label" name="Label">
                        <Text val="#CM_LoadScreenTab4Name" />
                    </Frame>
                    <Animation name="SelectPage">
                        <Event event="OnClick" action="Reset,Play" />
                        <Controller type="State" stateGroup="PageState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="Page4" />
                        </Controller>
                    </Animation>
                </Frame>
            </Frame>
            <Frame type="Frame" name="PanelsContainer">
                <Handle val="CM_LoadScreenPanelsContainer" />
                <Anchor side="Top" relative="$parent/TabButtonsContainer" pos="Max" offset="0" />
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-52" />
                <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
                <Anchor side="Right" relative="$parent" pos="Max" offset="0" />
                <Frame type="Frame" name="Panel01" template="CM_LoadScreen/PanelTemplate">
                    <Frame type="ScrollableFrame" name="ScrollableList">
                        <Frame type="Frame" name="ContainerFrame">
                            <Frame type="Frame" name="ContentFrame">
                                <Frame type="Label" name="Lbl_Body">
                                    <Anchor side="Top" relative="$parent" pos="Min" offset="20" />
                                    <Anchor side="Left" relative="$parent" pos="Min" offset="20" />
                                    <Width val="800" />
                                    <Style val="LoadingScreenMission" />
                                    <Text val="#CM_LoadScreenTab1Text" />
                                </Frame>
                                <Frame type="Frame" name="ContentsBottom">
                                    <Anchor side="Bottom" relative="$parent/Lbl_Body" pos="Max" offset="0" />
                                </Frame>
                            </Frame>
                        </Frame>
                    </Frame>
                </Frame>
                <Frame type="Frame" name="Panel02" template="CM_LoadScreen/PanelTemplate">
                    <Frame type="ScrollableFrame" name="ScrollableList">
                        <Frame type="Frame" name="ContainerFrame">
                            <Frame type="Frame" name="ContentFrame">
                                <Frame type="Label" name="Lbl_Body">
                                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                                    <Anchor side="Left" relative="$parent" pos="Min" offset="20" />
                                    <Width val="800" />
                                    <Style val="LoadingScreenMission" />
                                    <Text val="#CM_LoadScreenTab2Text" />
                                </Frame>
                                <Frame type="Frame" name="ContentsBottom">
                                    <Anchor side="Bottom" relative="$parent/Lbl_Body" pos="Max" offset="0" />
                                </Frame>
                            </Frame>
                        </Frame>
                    </Frame>
                </Frame>
                <Frame type="Frame" name="Panel03" template="CM_LoadScreen/PanelTemplate">
                    <Frame type="ScrollableFrame" name="ScrollableList">
                        <Frame type="Frame" name="ContainerFrame">
                            <Frame type="Frame" name="ContentFrame">
                                <Frame type="Label" name="Lbl_Body">
                                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                                    <Anchor side="Left" relative="$parent" pos="Min" offset="20" />
                                    <Width val="800" />
                                    <Style val="LoadingScreenMission" />
                                    <Text val="#CM_LoadScreenTab3Text" />
                                </Frame>
                                <Frame type="Frame" name="ContentsBottom">
                                    <Anchor side="Bottom" relative="$parent/Lbl_Body" pos="Max" offset="0" />
                                </Frame>
                            </Frame>
                        </Frame>
                    </Frame>
                </Frame>
                <Frame type="Frame" name="Panel04" template="CM_LoadScreen/PanelTemplate">
                    <Frame type="ScrollableFrame" name="ScrollableList">
                        <Frame type="Frame" name="ContainerFrame">
                            <Frame type="Frame" name="ContentFrame">
                                <Frame type="Label" name="Lbl_Body">
                                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                                    <Anchor side="Left" relative="$parent" pos="Min" offset="20" />
                                    <Width val="800" />
                                    <Style val="LoadingScreenMission" />
                                    <Text val="#CM_LoadScreenTab4Text" />
                                </Frame>
                                <Frame type="Frame" name="ContentsBottom">
                                    <Anchor side="Bottom" relative="$parent/Lbl_Body" pos="Max" offset="0" />
                                </Frame>
                            </Frame>
                        </Frame>
                    </Frame>
                </Frame>
            </Frame>
            <Frame type="Frame" name="CommunityLinksContainer">
                <Handle val="CM_LoadScreenCommunityLinksContainer" />
                <Anchor side="Top" relative="$parent/PanelsContainer" pos="Max" offset="8" />
                <Anchor side="Left" relative="$parent" pos="Mid" offset="-320" />
                <Width val="640" />
                <Height val="36" />
                <RenderPriority val="650" />
                <Frame type="Frame" name="WebsiteLink" template="CM_LoadScreen/URLFrameTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
                    <Frame type="LaunchURLButton" name="WebsiteButton">
                        <!-- <Handle val="CM_LoadScreenWebsiteURLButton" /> -->
                        <Text val="#CM_LoadScreenEmptyText" />
                        <Tooltip val="#CM_LoadScreenWebsiteTooltip" />
                        <URL val="#CM_LoadScreenWebsiteURL" />
                    </Frame>
                    <Frame type="Label" name="URLLabel">
                        <Text val="#CM_LoadScreenWebsiteText" />
                    </Frame>
                </Frame>
                <Frame type="Frame" name="DiscordLink" template="CM_LoadScreen/URLFrameTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                    <Anchor side="Left" relative="$parent/WebsiteLink" pos="Max" offset="8" />
                    <Frame type="LaunchURLButton" name="WebsiteButton">
                        <!-- <Handle val="CM_LoadScreenDiscordURLButton" /> -->
                        <Text val="#CM_LoadScreenEmptyText" />
                        <Tooltip val="#CM_LoadScreenDiscordTooltip" />
                        <URL val="#CM_LoadScreenDiscordURL" />
                    </Frame>
                    <Frame type="Label" name="URLLabel">
                        <Text val="#CM_LoadScreenDiscordText" />
                    </Frame>
                </Frame>
                <Frame type="Frame" name="QQLink" template="CM_LoadScreen/URLFrameTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                    <Anchor side="Left" relative="$parent/DiscordLink" pos="Max" offset="8" />
                    <Frame type="LaunchURLButton" name="WebsiteButton">
                        <!-- <Handle val="CM_LoadScreenQQURLButton" /> -->
                        <Text val="#CM_LoadScreenEmptyText" />
                        <Tooltip val="#CM_LoadScreenQQTooltip" />
                        <URL val="https://qm.qq.com/q/dq1Bpe9fG0" />
                    </Frame>
                    <Frame type="Label" name="URLLabel">
                        <Text val="#CM_LoadScreenQQText" />
                    </Frame>
                </Frame>
                <Frame type="Frame" name="BiliBiliLink" template="CM_LoadScreen/URLFrameTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0" />
                    <Anchor side="Left" relative="$parent/QQLink" pos="Max" offset="8" />
                    <Frame type="LaunchURLButton" name="WebsiteButton">
                        <!-- <Handle val="CM_LoadScreenBiliBiliURLButton" /> -->
                        <Text val="#CM_LoadScreenEmptyText" />
                        <Tooltip val="#CM_LoadScreenBiliBiliTooltip" />
                        <URL val="#CM_LoadScreenBiliBiliURL" />
                    </Frame>
                    <Frame type="Label" name="URLLabel">
                        <Text val="#CM_LoadScreenBiliBiliText" />
                    </Frame>
                </Frame>
            </Frame>
        </Frame>
        <StateGroup name="Visible">
            <State name="DisableHelpTip">
                <When type="Property" frame="$ancestor[@type=ScreenLoading]/LoadingHelpLabel" Visible="True" />
                <Action type="SetProperty" frame="$ancestor[@type=ScreenLoading]/LoadingHelpLabel" Alpha="0" />
                <Action type="SetProperty" frame="$ancestor[@type=ScreenLoading]/LoadingHelpBackgroundImage" Alpha="0" />
                <Action type="SendEvent" frame="InfoTabController" event="CM_LoadScreenStartCycle" />
            </State>
            <State name="DisableHelpTipKRNGL">
                <When type="Property" frame="$ancestor[@type=ScreenLoading]/LoadingHelpLabel" Visible="True" />
                <Action type="SetProperty" frame="$ancestor[@type=ScreenLoading]/LoadingLegalLabelKRNGL" Alpha="0" />
                <Action type="SetProperty" frame="$ancestor[@type=ScreenLoading]/LoadingLegalBackgroundImageKRNGL" Alpha="0" />
                <Action type="SendEvent" frame="InfoTabController" event="CM_LoadScreenStartCycle" />
            </State>
        </StateGroup>
    </Frame>
</Desc>
