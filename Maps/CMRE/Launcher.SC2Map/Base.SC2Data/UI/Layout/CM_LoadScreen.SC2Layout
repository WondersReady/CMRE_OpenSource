<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Constant name="CM_LoadScreenCycleTime1" val="0" />
    <Constant name="CM_LoadScreenCycleTime2" val="8" />
    <Constant name="CM_LoadScreenCycleTime3" val="16" />
    <Constant name="CM_LoadScreenCycleTime4" val="24" />
    <Constant name="CM_LoadScreenCycleLoopTime" val="32" />

    <Constant name="CM_LoadScreenEmptyText" val="" />
    <Constant name="CM_LoadScreenTab1Name" val="最新更新" />
    <Constant name="CM_LoadScreenTab1Text" val="&lt;c val=&quot;FFE303&quot;&gt;CMRE 启动器&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;这是进入 CM 合作模式的统一入口。&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;主要功能&lt;/c&gt;&lt;n/&gt;· 集中选择&lt;c val=&quot;00FF66&quot;&gt;合作地图、指挥官与游戏设置&lt;/c&gt;&lt;n/&gt;· 直接进入所选任务，无需逐张打开地图&lt;n/&gt;· 已安装的自制指挥官、威望与扩展内容会在对应界面中提供&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;开始前&lt;/c&gt;&lt;n/&gt;请确认 CMRE 的 Mod 与地图已按 GitHub 说明放入正确目录。" />
    <Constant name="CM_LoadScreenTab2Name" val="特别鸣谢" />
    <Constant name="CM_LoadScreenTab2Text" val="&lt;c val=&quot;FFE303&quot;&gt;特别鸣谢&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;合作伙伴&lt;/c&gt;&lt;n/&gt;往毅、星际老男孩（黄哥&amp;孙哥）、枢纽制作组、Maguro&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFE303&quot;&gt;赞助者&lt;/c&gt;&lt;n/&gt;噼里啪啦蹦、歪比、Charlie、妹红、墨赫&lt;n/&gt;悠久の蒸汽機關～Lasteami、萌萌、从前有棵树&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;素材贡献&lt;/c&gt;&lt;n/&gt;喵头嘤Ey、冰破残梦、虚空即是虚无、塔达林的红果果&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;友情链接&lt;/c&gt;&lt;n/&gt;CM Oncall 群、时空枢纽、合作单一兵种作战" />
    <Constant name="CM_LoadScreenTab3Name" val="介绍" />
    <Constant name="CM_LoadScreenTab3Text" val="&lt;c val=&quot;FFE303&quot;&gt;CM 是什么？&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;CM 是由玩家社区制作并持续维护的《星际争霸 II》合作模式扩展 Mod。它不会替换官方合作模式，而是在熟悉的双人合作任务上加入更多玩法。&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;和官方合作模式相比&lt;/c&gt;&lt;n/&gt;· 增加莫比斯、瓦伦里安、塞伯鲁斯虫群等&lt;c val=&quot;00FF66&quot;&gt;社区自制指挥官&lt;/c&gt;&lt;n/&gt;· 为现有指挥官提供&lt;c val=&quot;00FF66&quot;&gt;自制威望、怀旧版本与趣味改造&lt;/c&gt;&lt;n/&gt;· 支持两位玩家选择&lt;c val=&quot;00FF66&quot;&gt;相同指挥官&lt;/c&gt;&lt;n/&gt;· 机制、强度和平衡会由社区持续调整，因此体验可能不同于官方版本&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;9F9F9F&quot;&gt;简单来说：熟悉的合作任务，更多指挥官、更多构筑，也更多变化。&lt;/c&gt;" />
    <Constant name="CM_LoadScreenTab4Name" val="开发者" />
    <Constant name="CM_LoadScreenTab4Text" val="&lt;c val=&quot;FFE303&quot;&gt;CM 制作组&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;核心团队&lt;/c&gt;&lt;n/&gt;CM 制作组全体成员&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;9F9F9F&quot;&gt;CM 持续欢迎对合作模式开发感兴趣的伙伴加入。&lt;/c&gt;" />
    <Constant name="CM_LoadScreenWebsiteText" val="GitHub" />
    <Constant name="CM_LoadScreenWebsiteTooltip" val="查看 CMRE OpenSource 源码、说明与更新" />
    <Constant name="CM_LoadScreenWebsiteURL" val="https://github.com/WondersReady/CMRE_OpenSource" />
    <Constant name="CM_LoadScreenDiscordText" val="Discord" />
    <Constant name="CM_LoadScreenDiscordTooltip" val="（暂未开放，敬请期待）" />
    <Constant name="CM_LoadScreenDiscordURL" val="" />
    <Constant name="CM_LoadScreenQQText" val="QQ群" />
    <Constant name="CM_LoadScreenQQTooltip" val="加入 CM 玩家交流群：517072" />
    <Constant name="CM_LoadScreenQQURL" val="https://qm.qq.com/q/dq1Bpe9fG0" />
    <Constant name="CM_LoadScreenBiliBiliText" val="B站" />
    <Constant name="CM_LoadScreenBiliBiliTooltip" val="关注 CM 官方 B 站频道" />
    <Constant name="CM_LoadScreenBiliBiliURL" val="https://space.bilibili.com/" />

