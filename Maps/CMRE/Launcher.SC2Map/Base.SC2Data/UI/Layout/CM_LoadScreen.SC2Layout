    <Constant name="CM_LoadScreenEmptyText" val="" />
    <Constant name="CM_LoadScreenTab1Name" val="最新更新" />
    <Constant name="CM_LoadScreenTab1Text" val="&lt;c val=&quot;FFE303&quot;&gt;【新指挥官】黑石计划（塞伯鲁斯虫群）&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&quot;击杀并研究敌人，化为自己的力量。&quot;&lt;n/&gt;&lt;n/&gt;· 适合&lt;c val=&quot;00FF66&quot;&gt;不同水平&lt;/c&gt;的玩家&lt;n/&gt;· 击杀并研究敌人，&lt;c val=&quot;FF9800&quot;&gt;不断强化战斗能力&lt;/c&gt;&lt;n/&gt;· 拥有一只&lt;c val=&quot;FF9800&quot;&gt;不断成长的巨兽级移动火力平台&lt;/c&gt;----坚城之主&lt;n/&gt;· &lt;c val=&quot;00FF66&quot;&gt;配合紧密&lt;/c&gt;，环环相扣的异虫部队&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFE303&quot;&gt;【平衡调整】瓦伦里安 · 5/23 补丁&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;兵种调整&lt;/c&gt;&lt;n/&gt;· 帝盾卫兵：攻击间隔 1.5→1.25，壁垒屏障冷却 60→45 秒&lt;n/&gt;· 猎犬部队：脱战回血提速并立即恢复 30 生命，三阶移速削弱&lt;n/&gt;· 帝国幽影：EMP 沉默按军衔分阶（0/1/2/3 阶 = 7/10/15/25 秒）&lt;n/&gt;· 君王护佑者：愈合冲击冷却 18→16，新增辅助瞄准防前冲&lt;n/&gt;· 君王铁锤：导弹伤害 150→125，军衔经验全面调整&lt;n/&gt;· 布塞法洛斯号：适应性回路现在带可见特效" />
    <Constant name="CM_LoadScreenTab2Name" val="特别鸣谢" />
    <Constant name="CM_LoadScreenTab2Text" val="&lt;c val=&quot;FFE303&quot;&gt;特别鸣谢&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;合作伙伴&lt;/c&gt;&lt;n/&gt;往毅、星际老男孩（黄哥&amp;孙哥）、枢纽制作组&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFE303&quot;&gt;赞助老板&lt;/c&gt;&lt;n/&gt;噼里啪啦蹦、歪比、Charlie、妹红、墨赫、悠久の蒸汽機關～Lasteami、萌萌、从前有棵树&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;素材贡献&lt;/c&gt;&lt;n/&gt;· 喵头嘤Ey -- 模型技术总监&lt;n/&gt;· 冰破残梦 - 模型支持&lt;n/&gt;· 虚空即是虚无 -- 蒙斯克面部动画修复&lt;n/&gt;· 塔达林的红果果 -- 表情包&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;友情链接&lt;/c&gt;&lt;n/&gt;CM Oncall 群、时空枢纽、合作单一兵种作战&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;9F9F9F&quot;&gt;感谢所有支持我们的朋友！&lt;/c&gt;" />
    <Constant name="CM_LoadScreenTab3Name" val="介绍" />
    <Constant name="CM_LoadScreenTab3Text" val="&lt;c val=&quot;FFE303&quot;&gt;CM · 指挥官 MOD&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;基于《星际争霸 2》合作模式的扩展项目，由热爱合作模式的玩家共同制作维护。&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;主要内容&lt;/c&gt;&lt;n/&gt;· &lt;c val=&quot;00FF66&quot;&gt;自制指挥官&lt;/c&gt;：莫比斯、瓦伦里安、塞伯鲁斯虫群、诺温蓓尔·泰拉等&lt;n/&gt;· &lt;c val=&quot;00FF66&quot;&gt;平衡实验区&lt;/c&gt;：经 CM 团队调试过的自制威望&lt;n/&gt;· &lt;c val=&quot;00FF66&quot;&gt;怀旧/魔改区&lt;/c&gt;：老神龙凯瑞甘、带追猎的圣堂表象·改 等趣味改造&lt;n/&gt;· &lt;c val=&quot;00FF66&quot;&gt;指挥官 Double&lt;/c&gt;：支持同指挥官搭档&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;玩家须知&lt;/c&gt;&lt;n/&gt;· 自制威望带 &lt;c val=&quot;00FF66&quot;&gt;- CM&lt;/c&gt; 后缀 = CM 团队认证、强度可控&lt;n/&gt;· &lt;c val=&quot;9F9F9F&quot;&gt;- Wonders / - YB&lt;/c&gt; 等后缀 = 作者自定义版本&lt;n/&gt;· 选人界面 &lt;c val=&quot;00FF66&quot;&gt;F3&lt;/c&gt; 切休伯利安、&lt;c val=&quot;00FF66&quot;&gt;W&lt;/c&gt; 切管诺娃兵营、&lt;c val=&quot;00FF66&quot;&gt;-SFA&lt;/c&gt; 指定玩家 2 指挥官&lt;n/&gt;· 支持两位玩家选择&lt;c val=&quot;00FF66&quot;&gt;相同指挥官&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;9F9F9F&quot;&gt;问题反馈与建议请通过下方社区渠道。&lt;/c&gt;" />
    <Constant name="CM_LoadScreenTab4Name" val="开发者" />
    <Constant name="CM_LoadScreenTab4Text" val="&lt;c val=&quot;FFE303&quot;&gt;CM 制作组&lt;/c&gt;&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;核心团队&lt;/c&gt;&lt;n/&gt;CM 制作组全体成员&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;FFFF8A&quot;&gt;优秀开发者&lt;/c&gt;&lt;n/&gt;HTXL、小狂狂、爱兰琪尔&lt;n/&gt;&lt;n/&gt;&lt;c val=&quot;9F9F9F&quot;&gt;CM 持续欢迎对合作模式开发感兴趣的伙伴加入。&lt;/c&gt;" />
