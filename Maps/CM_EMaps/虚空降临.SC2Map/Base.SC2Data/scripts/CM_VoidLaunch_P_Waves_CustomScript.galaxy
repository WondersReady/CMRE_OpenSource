int CMHD_ClampAttackSize(int lp_value) {
    if (lp_value < libCOMI_ge_CoopAIAttackWaveBuckets__1Smallest) {
        return libCOMI_ge_CoopAIAttackWaveBuckets__1Smallest;
    }
    if (lp_value > libCOMI_ge_CoopAIAttackWaveBuckets__7Largest) {
        return libCOMI_ge_CoopAIAttackWaveBuckets__7Largest;
    }
    return lp_value;
}

int CMHD_ClampTechLevel(int lp_value) {
    if (lp_value < libCOMI_ge_CoopAITechLevelBuckets__1Early) {
        return libCOMI_ge_CoopAITechLevelBuckets__1Early;
    }
    if (lp_value > libCOMI_ge_CoopAITechLevelBuckets_TechLevel07) {
        return libCOMI_ge_CoopAITechLevelBuckets_TechLevel07;
    }
    return lp_value;
}

int CMHD_ScaledAttackSize(int lp_baseSize, int lp_ordinal) {
    int lv_delta;

    lv_delta = 0;
    if (gv_mechanicDifficulty == 5) {
        if (ModI(lp_ordinal, 2) == 1) {
            lv_delta = 1;
        }
    }
    else {
        if (gv_mechanicDifficulty >= 6) {
            lv_delta = 1;
            if (ModI(lp_ordinal, 2) == 0) {
                lv_delta = 2;
            }
        }
    }
    return CMHD_ClampAttackSize(lp_baseSize + lv_delta);
}

int CMHD_ScaledTechLevel(int lp_baseTech, int lp_ordinal) {
    int lv_delta;

    lv_delta = 0;
    if (gv_mechanicDifficulty == 5) {
        lv_delta = 1;
        if (ModI(lp_ordinal, 2) == 0) {
            lv_delta = 2;
        }
    }
    else {
        if (gv_mechanicDifficulty >= 6) {
            lv_delta = 2;
        }
    }
    return CMHD_ClampTechLevel(lp_baseTech + lv_delta);
}

bool CMHD_IsPatternA() {
    return (gv_wave03Destination == ge_ExitLocation_LEFT);
}

bool CMHD_TestPWave(bool lp_testConds, int lp_minDifficulty) {
    if (lp_testConds == true) {
        if (libCOMI_gf_GameIsOver() != false) {
            return false;
        }
        if (TriggerIsEnabled(TriggerGetCurrent()) != true) {
            return false;
        }
        if (gv_mechanicDifficulty < lp_minDifficulty) {
            return false;
        }
    }
    return true;
}

void CMHD_MarkShuttleWaveEscaped(unit lp_shuttle) {
    int lv_waveSlot;

    lv_waveSlot = 1;
    while (lv_waveSlot <= gv_c_ShuttleWaveCapacity) {
        if (UnitGroupHasUnit(gv_shuttlesActive[lv_waveSlot], lp_shuttle) == true) {
            gv_shuttleEscapeThisWave[lv_waveSlot] = true;
            return;
        }
        lv_waveSlot = lv_waveSlot + 1;
    }
}

void CMHD_SendShuttlePWave(
    int lp_pWaveNumber,
    int lp_shuttleCount,
    int lp_baseSize,
    int lp_baseTech,
    int lp_patternALaunch,
    int lp_patternAExit,
    int lp_patternBLaunch,
    int lp_patternBExit
) {
    int lv_waveSlot;
    int lv_launch;
    int lv_exit;
    int lv_size;
    int lv_tech;

    gv_cMHDShuttlePWaveOrdinal = gv_cMHDShuttlePWaveOrdinal + 1;
    lv_waveSlot = 7 + lp_pWaveNumber;
    lv_launch = lp_patternALaunch;
    lv_exit = lp_patternAExit;
    if (CMHD_IsPatternA() == false) {
        lv_launch = lp_patternBLaunch;
        lv_exit = lp_patternBExit;
    }
    lv_size = CMHD_ScaledAttackSize(lp_baseSize, gv_cMHDShuttlePWaveOrdinal);
    lv_tech = CMHD_ScaledTechLevel(lp_baseTech, gv_cMHDShuttlePWaveOrdinal);

    gf_ShuttleDeathWatcher(lv_waveSlot);
    gf_ShuttleCreateWave(
        lv_waveSlot,
        "ProtossFrigate",
        lp_shuttleCount,
        lv_launch,
        lv_exit,
        ge_ShuttleWaveBehavior_ShuttleBehavior_StraightToDestination,
        lv_size,
        lv_tech,
        true
    );
}

void CMHD_SendAttackPWave(
    int lp_baseSize,
    int lp_baseTech,
    int lp_patternASpawnPointId,
    int lp_patternBSpawnPointId
) {
    int lv_size;
    int lv_tech;
    int lv_spawnPointId;
    point lv_spawnPoint;
    unitgroup lv_player03Group;
    unitgroup lv_player04Group;

    gv_cMHDAttackPWaveOrdinal = gv_cMHDAttackPWaveOrdinal + 1;
    lv_size = CMHD_ScaledAttackSize(lp_baseSize, gv_cMHDAttackPWaveOrdinal);
    lv_tech = CMHD_ScaledTechLevel(lp_baseTech, gv_cMHDAttackPWaveOrdinal);
    lv_spawnPointId = lp_patternASpawnPointId;
    if (CMHD_IsPatternA() == false) {
        lv_spawnPointId = lp_patternBSpawnPointId;
    }
    lv_spawnPoint = PointFromId(lv_spawnPointId);

    lv_player03Group = libCOMI_gf_CreateCommanderAttackGroupatPoint(
        gv_pLAYER_03_ENEMY,
        lv_size,
        lv_tech,
        lv_spawnPoint
    );
    lv_player04Group = libCOMI_gf_CreateCommanderAttackGroupatPoint(
        gv_pLAYER_04_ENEMY,
        lv_size,
        lv_tech,
        lv_spawnPoint
    );

    Wait(1.0, c_timeAI);
    libCOMU_gf_CT_Mutator_AttackWaveHook_WaveSent(
        gv_pLAYER_03_ENEMY,
        lv_player03Group,
        lv_spawnPoint,
        libCOMI_ge_CM_CoopAI_WaveAttackTargetType_PlayerBase
    );
    libCOMU_gf_CT_Mutator_AttackWaveHook_WaveSent(
        gv_pLAYER_04_ENEMY,
        lv_player04Group,
        lv_spawnPoint,
        libCOMI_ge_CM_CoopAI_WaveAttackTargetType_PlayerBase
    );
    if (UnitGroupCount(lv_player03Group, c_unitCountAlive) > 0) {
        AIAttackWaveSetGatherPoint(gv_pLAYER_03_ENEMY, lv_spawnPoint);
        AIAttackWaveSetTargetPoint(gv_pLAYER_03_ENEMY, gv_player03Target);
        AIAttackWaveUseGroup(gv_pLAYER_03_ENEMY, lv_player03Group);
        AIAttackWaveSend(gv_pLAYER_03_ENEMY, 0, false);
    }
    if (UnitGroupCount(lv_player04Group, c_unitCountAlive) > 0) {
        AIAttackWaveSetGatherPoint(gv_pLAYER_04_ENEMY, lv_spawnPoint);
        AIAttackWaveSetTargetPoint(gv_pLAYER_04_ENEMY, gv_player04Target);
        AIAttackWaveUseGroup(gv_pLAYER_04_ENEMY, lv_player04Group);
        AIAttackWaveSend(gv_pLAYER_04_ENEMY, 0, false);
    }
}

bool gt_ShuttleSendWaveP01_Func(bool testConds, bool runActions) {
    if (CMHD_TestPWave(testConds, 5) == false) { return false; }
    if (runActions == false) { return true; }
    TriggerEnable(TriggerGetCurrent(), false);
    CMHD_SendShuttlePWave(1, 1, libCOMI_ge_CoopAIAttackWaveBuckets__1Smallest, libCOMI_ge_CoopAITechLevelBuckets__1Early, ge_LaunchLocation_MIDDLE, ge_ExitLocation_LEFT, ge_LaunchLocation_MIDDLE, ge_ExitLocation_LEFT);
    return true;
}

