void CMHD_InitPWaveTriggers() {
    gv_cMHDShuttlePWaveOrdinal = 0;
    gv_cMHDAttackPWaveOrdinal = 0;

    gt_ShuttleSendWaveP01 = TriggerCreate("gt_ShuttleSendWaveP01_Func");
    gt_ShuttleSendWaveP02 = TriggerCreate("gt_ShuttleSendWaveP02_Func");
    gt_ShuttleSendWaveP03 = TriggerCreate("gt_ShuttleSendWaveP03_Func");
    gt_ShuttleSendWaveP04 = TriggerCreate("gt_ShuttleSendWaveP04_Func");
    gt_ShuttleSendWaveP05 = TriggerCreate("gt_ShuttleSendWaveP05_Func");
    gt_ShuttleSendWaveP06 = TriggerCreate("gt_ShuttleSendWaveP06_Func");
    gt_ShuttleSendWaveP07 = TriggerCreate("gt_ShuttleSendWaveP07_Func");
    gt_ShuttleSendWaveP08 = TriggerCreate("gt_ShuttleSendWaveP08_Func");
    gt_ShuttleSendWaveP09 = TriggerCreate("gt_ShuttleSendWaveP09_Func");
    gt_ShuttleSendWaveP10 = TriggerCreate("gt_ShuttleSendWaveP10_Func");
    gt_ShuttleSendWaveP11 = TriggerCreate("gt_ShuttleSendWaveP11_Func");
    gt_ShuttleSendWaveP12 = TriggerCreate("gt_ShuttleSendWaveP12_Func");
    gt_ShuttleSendWaveP13 = TriggerCreate("gt_ShuttleSendWaveP13_Func");
    gt_ShuttleSendWaveP14 = TriggerCreate("gt_ShuttleSendWaveP14_Func");

    gt_AttackWaveP01 = TriggerCreate("gt_AttackWaveP01_Func");
    gt_AttackWaveP02 = TriggerCreate("gt_AttackWaveP02_Func");
    gt_AttackWaveP03 = TriggerCreate("gt_AttackWaveP03_Func");
    gt_AttackWaveP04 = TriggerCreate("gt_AttackWaveP04_Func");
    gt_AttackWaveP05 = TriggerCreate("gt_AttackWaveP05_Func");
    gt_AttackWaveP06 = TriggerCreate("gt_AttackWaveP06_Func");
    gt_AttackWaveP07 = TriggerCreate("gt_AttackWaveP07_Func");
    gt_AttackWaveP08 = TriggerCreate("gt_AttackWaveP08_Func");
    gt_AttackWaveP09 = TriggerCreate("gt_AttackWaveP09_Func");
    gt_AttackWaveP10 = TriggerCreate("gt_AttackWaveP10_Func");
    gt_AttackWaveP11 = TriggerCreate("gt_AttackWaveP11_Func");
    gt_AttackWaveP12 = TriggerCreate("gt_AttackWaveP12_Func");
}
