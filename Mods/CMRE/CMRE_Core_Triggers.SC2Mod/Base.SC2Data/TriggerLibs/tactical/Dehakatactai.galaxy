    ord = CMDehakaBestUnitOrder(player, aiUnit, scanGroup, abilityLink, 9.0, damageCap, true, c_CMDehaka_NydusTargetMinScore);
    if (ord != null) {
        AICast(aiUnit, ord, c_noMarker, c_castHold);
        return;
    }
}

