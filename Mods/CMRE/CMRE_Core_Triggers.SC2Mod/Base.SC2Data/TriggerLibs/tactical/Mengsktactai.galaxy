//--------------------------------------------------------------------------------------------------
void AIThinkMengskThorSieged (int player, unit aiUnit, unitgroup scanGroup) {
    order ord;

    if ((UnitOrderHasAbil(aiUnit, c_CMMengsk_AB_ThorTargeted) == true) || (UnitOrderHasAbil(aiUnit, c_CMMengsk_AB_ThorTargetedRange) == true) || (UnitOrderHasAbil(aiUnit, c_CMMengsk_AB_ThorTargetedLarge) == true)) {
        return;
    }

    ord = CMMengskThorAirOrder(player, aiUnit, scanGroup);
    if (ord != null) {
        AICast(aiUnit, ord, c_noMarker, c_castHold);
        return;
    }

    ord = CMMengskThorUnsiegeOrder(player, aiUnit, scanGroup);
    if (ord != null) {
        AICast(aiUnit, ord, c_noMarker, c_castHold);
    }
}

