const string c_CMMengsk_EF_ThorTargetedSearch = "ThorMengskSiegeTargetSearch";
const string c_CMMengsk_EF_ThorTargetedLargeSearch = "ThorMengskSiegeTargetLargeAoESearch";
const string c_CMMengsk_EF_YamatoDamage = "BattlecruiserMengskYamatoDamage";
const string c_CMMengsk_EF_ArtilleryDamageSearch = "ArtilleryMengskBombardmentDamageSearch";
const string c_CMMengsk_EF_ArtilleryDamage = "ArtilleryMengskBombardmentDamage";
