//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libCMFE_InitLib_completed = false;

void libCMFE_InitLib () {
    if (libCMFE_InitLib_completed) {
        return;
    }

    libCMFE_InitLib_completed = true;

    libCMFE_InitLibraries();
    libCMFE_InitCustomScript();
}

