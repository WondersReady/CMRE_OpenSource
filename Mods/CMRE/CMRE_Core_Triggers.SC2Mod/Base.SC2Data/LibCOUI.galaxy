//--------------------------------------------------------------------------------------------------
// Trigger: CU_TychusSquadSpawnCheat
//--------------------------------------------------------------------------------------------------
bool libCOUI_gt_CU_TychusSquadSpawnCheat_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_barposition;
    string lv_barunittype;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((GameCheatsEnabled(c_gameCheatCategoryDevelopment) == true))) {
            return false;
        }

        if (!((libCOOC_gf_ActiveCommanderForPlayer(EventPlayer()) == "TerranTychus"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libCOUI_gv_cU_TychusSquadSpawnSkip[EventPlayer()] = true;
    CatalogFieldValueSet(c_gameCatalogAbil, "TychusStarportTrain", "InfoArray[" + IntToString(0) + "].Time", EventPlayer(), "0");
    if ((UnitIsAlive(libCOUI_gv_cU_TychusSquadBar[EventPlayer()]) == true)) {
        lv_barposition = UnitGetPosition(libCOUI_gv_cU_TychusSquadBar[EventPlayer()]);
        lv_barunittype = UnitGetType(libCOUI_gv_cU_TychusSquadBar[EventPlayer()]);
        UnitRemove(libCOUI_gv_cU_TychusSquadBar[EventPlayer()]);
        Wait(0.0625, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, lv_barunittype, c_unitCreateIgnorePlacement, EventPlayer(), lv_barposition);
        libCOUI_gf_CU_TychusSetBarUnit(UnitLastCreated());
    }

    libCOMI_gf_ApplyTychusMaxChargesPerk(EventPlayer());
    libNtve_gf_PlayerRemoveChargeUsed(EventPlayer(), "Abil/TychusTrain");
    return true;
}

