        if (lv_indexPlayer < 0) { break; }
        if ((EventUnit() == libCOUI_gv_cU_HeroUnit[1][lv_indexPlayer])) {
            lv_index = 1;
            lv_player = lv_indexPlayer;
            break;
        }
