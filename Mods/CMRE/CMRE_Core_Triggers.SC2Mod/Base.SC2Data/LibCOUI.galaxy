void libCOUI_gf_CU_FanfareDisplay (int lp_result, int lp_player) {
    // Variable Declarations
    playergroup lv_fanfarePlayers;

    // Automatic Variable Declarations
    string autoCD2F2DDE_val;

    // Variable Initialization
    lv_fanfarePlayers = PlayerGroupEmpty();

    // Implementation
    if ((libCOUI_gv_cU_FanfareShown[lp_player] == true)) {
        return ;
    }

    lv_fanfarePlayers = PlayerGroupSingle(lp_player);
    libCOUI_gv_cU_FanfareShown[lp_player] = true;
    libCOUI_gv_cU_FanfareResult[lp_player] = lp_result;
    libCOUI_gf_CU_FanfareCreate();
    TriggerEnable(libCOUI_gt_CU_FanfareDismissed, true);
    DialogSetVisible(libCOUI_gv_cU_FanfareDialog, lv_fanfarePlayers, true);
    autoCD2F2DDE_val = PlayerRace(lp_player);
    if (autoCD2F2DDE_val == "Terr") {
        DialogControlSetVisible(libCOUI_gv_cU_FanfareMainFrame_Terr, PlayerGroupSingle(lp_player), true);
    }
    else if (autoCD2F2DDE_val == "Zerg") {
        DialogControlSetVisible(libCOUI_gv_cU_FanfareMainFrame_Zerg, PlayerGroupSingle(lp_player), true);
    }
    else if (autoCD2F2DDE_val == "Prot") {
        DialogControlSetVisible(libCOUI_gv_cU_FanfareMainFrame_Prot, PlayerGroupSingle(lp_player), true);
    }
    else {
    }
    if ((lp_result != c_gameOverVictory)) {
        TriggerEnable(libCOUI_gt_CU_FanfareRestart, true);
    }
    else {
        SoundPlayForPlayer(SoundLink("UI_Victory_All", 0), c_maxPlayers, lv_fanfarePlayers, 100.0, 0.0);
    }
    Wait(2.0, c_timeGame);
    libNtve_gf_SetDialogItemText(libCOUI_gv_cU_FanfareNameText, PlayerName(lp_player), lv_fanfarePlayers);
    if ((lp_result != c_gameOverVictory)) {
        libCMFE_gf_CMUIX_GameHistoryRecordDefeat();
        libNtve_gf_SetDialogItemText(libCOUI_gv_cU_FanfareVictoryText, StringExternal("Param/Value/lib_COUI_1393498E"), lv_fanfarePlayers);
        DialogControlSetVisible(libCOUI_gv_cU_FanfareRestartButton, PlayerGroupAll(), true);
    }
    else {
        libCMFE_gf_CMUIX_GameHistoryRecordVictory();
        libNtve_gf_SetDialogItemText(libCOUI_gv_cU_FanfareVictoryText, StringExternal("Param/Value/lib_COUI_42C3DAD0"), lv_fanfarePlayers);
        DialogControlSetVisible(libCOUI_gv_cU_FanfareRestartButton, PlayerGroupAll(), false);
    }
    DialogControlSetVisible(libCOUI_gv_cU_FanfareNameText, PlayerGroupSingle(lp_player), true);
    DialogControlSetVisible(libCOUI_gv_cU_FanfareVictoryText, PlayerGroupSingle(lp_player), true);
}

