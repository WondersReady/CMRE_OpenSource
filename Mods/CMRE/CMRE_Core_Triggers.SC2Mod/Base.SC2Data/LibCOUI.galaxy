            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(libCOUI_gv_cU_FanfareDialog, PlayerGroupAll(), false);
    TriggerEnable(TriggerGetCurrent(), false);
    Wait(0.0, c_timeReal);
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
