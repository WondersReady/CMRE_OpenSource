        libCOUI_gv_cU_HealthWatchSoundBreath = null;
    }

    if ((libCOUI_gv_cU_HealthWatchSoundHeartbeat != null)) {
        SoundStop(libCOUI_gv_cU_HealthWatchSoundHeartbeat, true);
        libCOUI_gv_cU_HealthWatchSoundHeartbeat = null;
