        CMUIX_ResultPlayerCommanderLabels[lv_player] = c_invalidDialogControlId;
        CMUIX_ResultPlayerPrestigeLabels[lv_player] = c_invalidDialogControlId;
        lv_mastery = 0;
        while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            CMUIX_ResultPlayerMasteryRows[lv_mastery][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultPlayerMasteryValueRows[lv_mastery][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultPlayerMasteryNameLabels[lv_mastery][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultPlayerMasteryValueLabels[lv_mastery][lv_player] = c_invalidDialogControlId;
            lv_mastery += 1;
        }

        lv_player += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_RESULT_MUTATOR_DISPLAY_MAX)) {
        CMUIX_ResultMutatorItems[lv_index] = c_invalidDialogControlId;
        CMUIX_ResultMutatorIcons[lv_index] = c_invalidDialogControlId;
        CMUIX_ResultMutatorBadges[lv_index] = c_invalidDialogControlId;
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_RESULT_CHAOS_HISTORY_MAX)) {
        CMUIX_ResultChaosHistoryItems[lv_index] = c_invalidDialogControlId;
        CMUIX_ResultChaosHistoryIcons[lv_index] = c_invalidDialogControlId;
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        CMUIX_ResultStatTitleFrames[lv_index] = c_invalidDialogControlId;
        CMUIX_ResultStatTitleLabels[lv_index] = c_invalidDialogControlId;
        lv_player = 0;
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_ResultStatValueFrames[lv_index][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultStatValueLabels[lv_index][lv_player] = c_invalidDialogControlId;
            lv_player += 1;
        }

        lv_index += 1;
    }

    while ((lv_context <= CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
        CMUIX_ResultDamageChartsBuilt[lv_context] = false;
        CMUIX_ResultOverviewPanels[lv_context] = c_invalidDialogControlId;
        CMUIX_ResultOverviewChaosSummaryLabels[lv_context] = c_invalidDialogControlId;
        CMUIX_ResultOverviewChartsBuilt[lv_context] = false;
        lv_player = 0;
        while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
            CMUIX_ResultOverviewPlayerFrames[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewPlayerLabels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewPrestigeLabels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewKillsLabels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewDamageLabels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewMasteryLabels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewChartPanels[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultOverviewChartCanvas[lv_context][lv_player] = c_invalidDialogControlId;
            CMUIX_ResultDamageChartCanvas[lv_context][lv_player] = c_invalidDialogControlId;
            lv_player += 1;
        }

        lv_index = 0;
        while ((lv_index <= CMUIX_RESULT_OVERVIEW_CHAOS_MAX)) {
            CMUIX_ResultOverviewChaosItems[lv_context][lv_index] = c_invalidDialogControlId;
            CMUIX_ResultOverviewChaosIcons[lv_context][lv_index] = c_invalidDialogControlId;
            lv_index += 1;
        }

        lv_context += 1;
    }

    CMUIX_ResultMainNavigationContainer = c_invalidDialogControlId;
    CMUIX_ResultBackgroundCutscene = c_invalidDialogControlId;
