        CMUIX_ResultMutatorIcons[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultMutatorItems[lv_index], c_triggerControlTypeLabel, "CycleCount");
        CMUIX_ResultMutatorBadges[lv_index] = DialogControlLastCreated();
