    CMUIX_ResultOverviewHook(CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT, CMUIX_ResultOverviewPanel);
    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        CMUIX_ResultOverviewHook(CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE + lv_player, CMUIX_ResultOverviewPanel);
