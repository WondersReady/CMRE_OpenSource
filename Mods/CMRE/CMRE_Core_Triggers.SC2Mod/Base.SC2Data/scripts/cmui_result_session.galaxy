        lv_mastery = 1;
        while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            DialogControlHookup(CMUIX_ResultPlayerFrames[lv_player], c_triggerControlTypePanel, ("TitlesFrame/MasteryRow" + IntToString(lv_mastery)));
            CMUIX_ResultPlayerMasteryRows[lv_mastery][lv_player] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_ResultPlayerMasteryRows[lv_mastery][lv_player], c_triggerControlTypeLabel, "NameLabel");
            CMUIX_ResultPlayerMasteryNameLabels[lv_mastery][lv_player] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_ResultPlayerFrames[lv_player], c_triggerControlTypePanel, ("ValuesFrame/MasteryValueRow" + IntToString(lv_mastery)));
            CMUIX_ResultPlayerMasteryValueRows[lv_mastery][lv_player] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_ResultPlayerMasteryValueRows[lv_mastery][lv_player], c_triggerControlTypeLabel, "ValueLabel");
            CMUIX_ResultPlayerMasteryValueLabels[lv_mastery][lv_player] = DialogControlLastCreated();
            lv_mastery += 1;
        }

        lv_player += 1;
    }

    DialogControlHookup(CMUIX_ResultPlayersPanel, c_triggerControlTypePanel, "ChaosHistoryPanel");
    CMUIX_ResultChaosHistoryPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultChaosHistoryPanel, c_triggerControlTypeLabel, "ChaosHistoryTitleLabel");
    CMUIX_ResultChaosHistoryTitleLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultChaosHistoryPanel, c_triggerControlTypeLabel, "ChaosActiveCountLabel");
    CMUIX_ResultChaosActiveCountLabel = DialogControlLastCreated();
    while ((lv_row <= CMUIX_RESULT_CHAOS_HISTORY_ROWS)) {
        lv_column = 1;
        while ((lv_column <= CMUIX_RESULT_CHAOS_HISTORY_COLUMNS)) {
            DialogControlHookup(CMUIX_ResultChaosHistoryPanel, c_triggerControlTypePanel, ("ChaosHistoryGrid/Row" + IntToString(lv_row) + "/Mutator" + IntToString(lv_column)));
            CMUIX_ResultChaosHistoryItems[lv_slot] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_ResultChaosHistoryItems[lv_slot], c_triggerControlTypeImage, "MutatorIcon");
            CMUIX_ResultChaosHistoryIcons[lv_slot] = DialogControlLastCreated();
            lv_slot += 1;
            lv_column += 1;
        }

        lv_row += 1;
    }
}

void CMUIX_ResultOverviewHook(int lp_context, int lp_panel) {
    int lv_player;
    int lv_index;

    lv_player = 1;
    lv_index = 1;
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX) || (CMUIX_IsControlValid(lp_panel) == false)) {
        return;
    }

    CMUIX_ResultOverviewPanels[lp_context] = lp_panel;
    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        DialogControlHookup(lp_panel, c_triggerControlTypePanel, ("PlayerFrame" + IntToString(lv_player)));
        CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypeLabel, "PlayerLabel");
        CMUIX_ResultOverviewPlayerLabels[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypeLabel, "PrestigeLabel");
        CMUIX_ResultOverviewPrestigeLabels[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypeLabel, "TotalsFrame/KillsLabel");
        CMUIX_ResultOverviewKillsLabels[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypeLabel, "TotalsFrame/DamageLabel");
        CMUIX_ResultOverviewDamageLabels[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypeLabel, "MasteryLabel");
        CMUIX_ResultOverviewMasteryLabels[lp_context][lv_player] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], c_triggerControlTypePanel, "ChartPanel");
        CMUIX_ResultOverviewChartPanels[lp_context][lv_player] = DialogControlLastCreated();
        lv_player += 1;
    }

    DialogControlHookup(lp_panel, c_triggerControlTypeLabel, "ChaosSummaryPanel/SummaryLabel");
    CMUIX_ResultOverviewChaosSummaryLabels[lp_context] = DialogControlLastCreated();
    while ((lv_index <= CMUIX_RESULT_OVERVIEW_CHAOS_MAX)) {
        DialogControlHookup(lp_panel, c_triggerControlTypePanel, ("ChaosSummaryPanel/RecentMutators/Mutator" + IntToString(lv_index)));
        CMUIX_ResultOverviewChaosItems[lp_context][lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultOverviewChaosItems[lp_context][lv_index], c_triggerControlTypeImage, "MutatorIcon");
        CMUIX_ResultOverviewChaosIcons[lp_context][lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }

    CMUIX_ResultOverviewChartsBuilt[lp_context] = false;
}

void CMUIX_ResultHookup() {
