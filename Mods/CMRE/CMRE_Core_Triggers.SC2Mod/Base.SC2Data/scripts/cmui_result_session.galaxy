    CMUIX_ResultStatsButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/DamageButton");
    CMUIX_ResultDamageButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/PlayersButton");
    CMUIX_ResultPlayersButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/OverviewButton");
    CMUIX_ResultOverviewButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/CloseButton");
    CMUIX_ResultCloseButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/RestartButton");
    CMUIX_ResultRestartButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeButton, "ContentPanel/ExitButton");
    CMUIX_ResultExitButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, "ContentPanel/PageContainer/StatsPanel");
    CMUIX_ResultStatsPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, "ContentPanel/PageContainer/DamagePanel");
    CMUIX_ResultDamagePanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, "ContentPanel/PageContainer/PlayersPanel");
    CMUIX_ResultPlayersPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, "ContentPanel/PageContainer/OverviewPanel");
    CMUIX_ResultOverviewPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, "ContentPanel/TabControl");
    CMUIX_ResultTabControl = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultDamagePanel, c_triggerControlTypePanel, "PlayerChart1");
    CMUIX_ResultDamageChartPanels[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultDamagePanel, c_triggerControlTypePanel, "PlayerChart2");
    CMUIX_ResultDamageChartPanels[2] = DialogControlLastCreated();
    while ((lv_index <= CMUIX_RESULT_MUTATOR_DISPLAY_MAX)) {
        DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypePanel, ("ContentPanel/MutatorStrip/Mutator" + IntToString(lv_index)));
        CMUIX_ResultMutatorItems[lv_index] = DialogControlLastCreated();
