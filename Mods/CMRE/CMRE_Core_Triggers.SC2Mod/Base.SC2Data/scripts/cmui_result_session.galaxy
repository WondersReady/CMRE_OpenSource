    CMUIX_ResultDamageChartCount = 0;
}

void CMUIX_ResultHookStatsPanel() {
    int lv_index;
    int lv_frame;

    lv_index = 1;
    lv_frame = c_invalidDialogControlId;
    if ((CMUIX_IsControlValid(CMUIX_ResultStatsPanel) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_ResultStatsPanel, c_triggerControlTypePanel, "LocalPlayerFrame");
    CMUIX_ResultStatsPlayerFrames[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultStatsPlayerFrames[1], c_triggerControlTypeLabel, "NameLabel");
    CMUIX_ResultStatsPlayerNameLabels[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultStatsPlayerFrames[1], c_triggerControlTypeLabel, "CommanderLabel");
    CMUIX_ResultStatsCommanderLabels[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultStatsPanel, c_triggerControlTypePanel, "AllyPlayerFrame");
    CMUIX_ResultStatsPlayerFrames[2] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultStatsPlayerFrames[2], c_triggerControlTypeLabel, "NameLabel");
    CMUIX_ResultStatsPlayerNameLabels[2] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ResultStatsPlayerFrames[2], c_triggerControlTypeLabel, "CommanderLabel");
    CMUIX_ResultStatsCommanderLabels[2] = DialogControlLastCreated();
    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        DialogControlHookup(CMUIX_ResultStatsPanel, c_triggerControlTypePanel, ("TitlesFrame/ScoreValueNameFrame" + IntToString(lv_index - 1)));
        CMUIX_ResultStatTitleFrames[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultStatTitleFrames[lv_index], c_triggerControlTypeLabel, "ResultLabel");
        CMUIX_ResultStatTitleLabels[lv_index] = DialogControlLastCreated();

        lv_frame = CMUIX_ResultStatsPlayerFrames[1];
        DialogControlHookup(lv_frame, c_triggerControlTypePanel, ("ScoreValueFrame" + IntToString(lv_index - 1)));
        CMUIX_ResultStatValueFrames[lv_index][1] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultStatValueFrames[lv_index][1], c_triggerControlTypeLabel, "ResultLabel");
        CMUIX_ResultStatValueLabels[lv_index][1] = DialogControlLastCreated();

        lv_frame = CMUIX_ResultStatsPlayerFrames[2];
        DialogControlHookup(lv_frame, c_triggerControlTypePanel, ("ScoreValueFrame" + IntToString(lv_index - 1)));
        CMUIX_ResultStatValueFrames[lv_index][2] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_ResultStatValueFrames[lv_index][2], c_triggerControlTypeLabel, "ResultLabel");
        CMUIX_ResultStatValueLabels[lv_index][2] = DialogControlLastCreated();
        lv_index += 1;
    }
}

void CMUIX_ResultHookPlayersPanel() {
    int lv_player;
    int lv_mastery;
    int lv_row;
    int lv_column;
