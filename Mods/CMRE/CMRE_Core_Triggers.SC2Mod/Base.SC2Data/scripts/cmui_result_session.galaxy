    CMUIX_ResultGameResultLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeLabel, "ContentPanel/MapNameLabel");
    CMUIX_ResultMapNameLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeImage, "ContentPanel/EnemyRaceIcon");
    CMUIX_ResultEnemyRaceIcon = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ScorePanel, c_triggerControlTypeLabel, "ContentPanel/EnemyNameLabel");
    CMUIX_ResultEnemyNameLabel = DialogControlLastCreated();
