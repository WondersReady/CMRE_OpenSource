    CMUIX_ResultEnemyRaceIcon = c_invalidDialogControlId;
    CMUIX_ResultEnemyNameLabel = c_invalidDialogControlId;
    CMUIX_ResultStatsButton = c_invalidDialogControlId;
    CMUIX_ResultDamageButton = c_invalidDialogControlId;
    CMUIX_ResultPlayersButton = c_invalidDialogControlId;
