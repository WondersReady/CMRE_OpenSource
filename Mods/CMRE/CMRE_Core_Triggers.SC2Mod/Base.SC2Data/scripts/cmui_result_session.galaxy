    }
}

text CMUIX_ResultOutcomeText() {
    if ((CMUIX_ResultValue == c_gameOverVictory)) {
        return StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ResultVictory");
    }

    if ((CMUIX_ResultValue == c_gameOverDefeat)) {
        return StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ResultDefeat");
    }

    return StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ResultDraw");
}

color CMUIX_ResultOutcomeColor() {
    if ((CMUIX_ResultValue == c_gameOverVictory)) {
        return Color(38, 210, 126);
    }

    if ((CMUIX_ResultValue == c_gameOverDefeat)) {
        return Color(235, 72, 72);
    }

    return Color(230, 190, 80);
}

text CMUIX_ResultMutatorTooltip(string lp_mutator, bool lp_enhanced) {
    text lv_description;

    lv_description = libCOMU_gf_CT_MutatorDescription(lp_mutator);
    if ((lp_enhanced == true)) {
        lv_description = libCOMU_gf_CT_MutatorEnhanceDescription(lp_mutator);
    }

    return (libCOMU_gf_CT_MutatorName(lp_mutator) + StringToText("<n/>") + lv_description);
}

void CMUIX_ResultRefreshHeaderForPlayers(playergroup lp_players) {
    int lv_index;
    string lv_mutator;
    string lv_state;
    playergroup lv_players;

    lv_index = 1;
    lv_mutator = "";
    lv_state = "None";
    lv_players = lp_players;
    CMUIX_SetControlText(CMUIX_ResultGameResultLabel, lv_players, CMUIX_ResultOutcomeText());
    if ((CMUIX_IsControlValid(CMUIX_ResultGameResultLabel) == true)) {
        libNtve_gf_SetDialogItemColor(CMUIX_ResultGameResultLabel, CMUIX_ResultOutcomeColor(), lv_players);
    }

    CMUIX_SetControlText(CMUIX_ResultMapNameLabel, lv_players, CMUIX_MapSelectionDisplayName(CMUIX_ResultMapInstance));
    CMUIX_SetControlText(CMUIX_ResultEnemyNameLabel, lv_players, CMUIX_EnemySelectionDisplayName(CMUIX_ResultEnemy));
    if ((CMUIX_EnemySelectionRaceIsStandard(CMUIX_ResultEnemyRace) == true)) {
        lv_state = CMUIX_ResultEnemyRace;
    }

    if ((CMUIX_IsControlValid(CMUIX_ResultEnemyRaceIcon) == true)) {
        DialogControlSetAnimationState(CMUIX_ResultEnemyRaceIcon, lv_players, "RaceState", lv_state);
    }

    while ((lv_index <= CMUIX_RESULT_MUTATOR_DISPLAY_MAX)) {
        if ((lv_index <= CMUIX_ResultDirectMutatorCount)) {
            lv_mutator = CMUIX_ResultDirectMutators[lv_index];
            if ((CMUIX_IsControlValid(CMUIX_ResultMutatorItems[lv_index]) == true)) {
                DialogControlSetAnimationState(CMUIX_ResultMutatorItems[lv_index], lv_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lv_mutator, CMUIX_ResultDirectMutatorsEnhanced[lv_index]));
                CMUIX_SetControlTooltip(CMUIX_ResultMutatorItems[lv_index], lv_players, CMUIX_ResultMutatorTooltip(lv_mutator, CMUIX_ResultDirectMutatorsEnhanced[lv_index]));
                CMUIX_SetControlVisible(CMUIX_ResultMutatorItems[lv_index], lv_players, true);
            }

            if ((CMUIX_IsControlValid(CMUIX_ResultMutatorIcons[lv_index]) == true)) {
                libNtve_gf_SetDialogItemImage(CMUIX_ResultMutatorIcons[lv_index], libCOMU_gf_CT_MutatorIcon(lv_mutator), lv_players);
            }

            CMUIX_SetControlVisible(CMUIX_ResultMutatorBadges[lv_index], lv_players, false);
        }
        else {
            if ((lv_index == (CMUIX_ResultDirectMutatorCount + 1)) && (CMUIX_ResultChaosSlotCount > 0)) {
                if ((CMUIX_IsControlValid(CMUIX_ResultMutatorItems[lv_index]) == true)) {
                    DialogControlSetAnimationState(CMUIX_ResultMutatorItems[lv_index], lv_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState("Chaos", false));
                    CMUIX_SetControlTooltip(CMUIX_ResultMutatorItems[lv_index], lv_players, CMUIX_ResultMutatorTooltip("Chaos", false));
                    CMUIX_SetControlVisible(CMUIX_ResultMutatorItems[lv_index], lv_players, true);
                }

                if ((CMUIX_IsControlValid(CMUIX_ResultMutatorIcons[lv_index]) == true)) {
                    libNtve_gf_SetDialogItemImage(CMUIX_ResultMutatorIcons[lv_index], libCOMU_gf_CT_MutatorIcon("Chaos"), lv_players);
                }

                CMUIX_SetControlText(CMUIX_ResultMutatorBadges[lv_index], lv_players, IntToText(CMUIX_ResultChaosSlotCount));
                CMUIX_SetControlVisible(CMUIX_ResultMutatorBadges[lv_index], lv_players, true);
            }
            else {
                CMUIX_SetControlVisible(CMUIX_ResultMutatorItems[lv_index], lv_players, false);
            }
        }

        lv_index += 1;
    }
}

void CMUIX_ResultRefreshHeader() {
    CMUIX_ResultRefreshHeaderForPlayers(PlayerGroupAll());
}

void CMUIX_ResultRefreshStatsForPlayers(playergroup lp_players) {
    int lv_index;
    int lv_player;
    string lv_key;
    bool lv_visible;
    playergroup lv_players;

    lv_index = 1;
    lv_player = 1;
    lv_key = "";
    lv_visible = false;
    lv_players = lp_players;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_SetControlVisible(CMUIX_ResultStatsPlayerFrames[lv_player], lv_players, CMUIX_ResultPlayerPresent[lv_player]);
        if ((CMUIX_ResultPlayerPresent[lv_player] == true)) {
            CMUIX_SetControlText(CMUIX_ResultStatsPlayerNameLabels[lv_player], lv_players, StringToText(CMUIX_ResultPlayerName[lv_player]));
            CMUIX_SetControlText(CMUIX_ResultStatsCommanderLabels[lv_player], lv_players, libCOOC_gf_CC_CommanderName(CMUIX_ResultPlayerCommander[lv_player]));
        }

        lv_player += 1;
    }

    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        lv_key = CMUIX_ResultStatKeys[lv_index];
        lv_visible = ((lv_key != "") && (lv_key != null));
        CMUIX_SetControlVisible(CMUIX_ResultStatTitleFrames[lv_index], lv_players, lv_visible);
        if ((lv_visible == true)) {
            CMUIX_SetControlText(CMUIX_ResultStatTitleLabels[lv_index], lv_players, StringExternal("ScoreValue/Name/" + lv_key));
        }

        lv_player = 1;
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_SetControlVisible(CMUIX_ResultStatValueFrames[lv_index][lv_player], lv_players, (lv_visible == true) && (CMUIX_ResultPlayerPresent[lv_player] == true));
            if ((lv_visible == true) && (CMUIX_ResultPlayerPresent[lv_player] == true)) {
                CMUIX_SetControlText(CMUIX_ResultStatValueLabels[lv_index][lv_player], lv_players, IntToText(CMUIX_ResultStatValues[lv_index][lv_player]));
            }

            lv_player += 1;
        }

        lv_index += 1;
    }
}

void CMUIX_ResultRefreshStats() {
    CMUIX_ResultRefreshStatsForPlayers(PlayerGroupAll());
}

void CMUIX_ResultRefreshPlayersForPlayers(playergroup lp_players) {
    int lv_player;
    int lv_mastery;
    int lv_index;
    string lv_commander;
    string lv_masteryId;
    string lv_mutator;
    playergroup lv_players;

    lv_player = 1;
    lv_mastery = 1;
    lv_index = 1;
    lv_commander = "";
    lv_masteryId = "";
    lv_mutator = "";
    lv_players = lp_players;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_SetControlVisible(CMUIX_ResultPlayerFrames[lv_player], lv_players, CMUIX_ResultPlayerPresent[lv_player]);
        if ((CMUIX_ResultPlayerPresent[lv_player] == true)) {
            lv_commander = CMUIX_ResultPlayerCommander[lv_player];
            CMUIX_SetControlText(CMUIX_ResultPlayerNameLabels[lv_player], lv_players, StringToText(CMUIX_ResultPlayerName[lv_player]));
            CMUIX_SetControlText(CMUIX_ResultPlayerCommanderLabels[lv_player], lv_players, libCOOC_gf_CC_CommanderName(lv_commander));
            CMUIX_SetControlText(CMUIX_ResultPlayerPrestigeLabels[lv_player], lv_players, CMUIX_PrestigeLabelText(lv_player, lv_commander, CMUIX_ResultPlayerPrestige[lv_player]));
            lv_mastery = 1;
            while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
                lv_masteryId = CMUIX_ResultPlayerMasteryId[lv_mastery][lv_player];
                CMUIX_SetControlVisible(CMUIX_ResultPlayerMasteryRows[lv_mastery][lv_player], lv_players, (lv_masteryId != "") && (lv_masteryId != null));
                CMUIX_SetControlVisible(CMUIX_ResultPlayerMasteryValueRows[lv_mastery][lv_player], lv_players, (lv_masteryId != "") && (lv_masteryId != null));
                if ((lv_masteryId != "") && (lv_masteryId != null)) {
                    CMUIX_SetControlText(CMUIX_ResultPlayerMasteryNameLabels[lv_mastery][lv_player], lv_players, libCOOC_gf_CC_PlayerMasteryName(lv_masteryId));
                    CMUIX_SetControlText(CMUIX_ResultPlayerMasteryValueLabels[lv_mastery][lv_player], lv_players, IntToText(CMUIX_ResultPlayerMasteryValue[lv_mastery][lv_player]));
                }

                lv_mastery += 1;
            }
        }

        lv_player += 1;
    }

    CMUIX_SetControlVisible(CMUIX_ResultChaosHistoryPanel, lv_players, (CMUIX_ResultChaosSlotCount > 0));
    CMUIX_SetControlText(CMUIX_ResultChaosHistoryTitleLabel, lv_players, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ChaosHistory") + StringToText(" (") + IntToText(CMUIX_ResultChaosHistoryCount) + StringToText(")"));
    CMUIX_SetControlText(CMUIX_ResultChaosActiveCountLabel, lv_players, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ChaosActiveCount") + StringToText(" ") + IntToText(CMUIX_ResultChaosSlotCount));
    while ((lv_index <= CMUIX_RESULT_CHAOS_HISTORY_MAX)) {
        if ((lv_index <= CMUIX_ResultChaosHistoryCount)) {
            lv_mutator = CMUIX_ResultChaosHistoryMutators[lv_index];
            if ((CMUIX_IsControlValid(CMUIX_ResultChaosHistoryItems[lv_index]) == true)) {
                DialogControlSetAnimationState(CMUIX_ResultChaosHistoryItems[lv_index], lv_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lv_mutator, CMUIX_ResultChaosHistoryEnhanced[lv_index]));
                CMUIX_SetControlTooltip(CMUIX_ResultChaosHistoryItems[lv_index], lv_players, CMUIX_ResultMutatorTooltip(lv_mutator, CMUIX_ResultChaosHistoryEnhanced[lv_index]));
                CMUIX_SetControlVisible(CMUIX_ResultChaosHistoryItems[lv_index], lv_players, true);
            }

            if ((CMUIX_IsControlValid(CMUIX_ResultChaosHistoryIcons[lv_index]) == true)) {
                libNtve_gf_SetDialogItemImage(CMUIX_ResultChaosHistoryIcons[lv_index], libCOMU_gf_CT_MutatorIcon(lv_mutator), lv_players);
            }
        }
        else {
            CMUIX_SetControlVisible(CMUIX_ResultChaosHistoryItems[lv_index], lv_players, false);
        }

        lv_index += 1;
    }
}

void CMUIX_ResultRefreshPlayers() {
    CMUIX_ResultRefreshPlayersForPlayers(PlayerGroupAll());
}

void CMUIX_ResultRefreshAll() {
    CMUIX_ResultRefreshHeader();
    CMUIX_ResultRefreshStats();
    CMUIX_ResultRefreshPlayers();
    CMUIX_ResultOverviewRefresh(CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT);
}

void CMUIX_ResultDamageChartInsert(int lp_damage, string lp_unitType) {
    int lv_position;
    int lv_shift;

    lv_position = 1;
    lv_shift = 0;
    if ((lp_damage <= 0) || (lp_unitType == "") || (lp_unitType == null)) {
        return;
    }

    while ((lv_position <= CMUIX_ResultDamageChartCount) && (lp_damage <= CMUIX_ResultDamageChartValues[lv_position])) {
        lv_position += 1;
    }

    if ((lv_position > CMUIX_RESULT_CHART_TOP_UNITS)) {
        return;
    }

    lv_shift = MinI(CMUIX_ResultDamageChartCount + 1, CMUIX_RESULT_CHART_TOP_UNITS);
    while ((lv_shift > lv_position)) {
        CMUIX_ResultDamageChartValues[lv_shift] = CMUIX_ResultDamageChartValues[lv_shift - 1];
        CMUIX_ResultDamageChartUnitTypes[lv_shift] = CMUIX_ResultDamageChartUnitTypes[lv_shift - 1];
        lv_shift -= 1;
    }

    CMUIX_ResultDamageChartValues[lv_position] = lp_damage;
    CMUIX_ResultDamageChartUnitTypes[lv_position] = lp_unitType;
    if ((CMUIX_ResultDamageChartCount < CMUIX_RESULT_CHART_TOP_UNITS)) {
        CMUIX_ResultDamageChartCount += 1;
    }
}

void CMUIX_ResultDamageChartCollect(int lp_player) {
    int lv_index;

    lv_index = 0;
    CMUIX_ResultDamageChartCount = 0;
    while ((lv_index <= CMUIX_RESULT_CHART_UNIT_MAX)) {
        CMUIX_ResultDamageChartValues[lv_index] = 0;
        CMUIX_ResultDamageChartUnitTypes[lv_index] = "";
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= CMUIX_ResultDamageUnitCount[lp_player])) {
        CMUIX_ResultDamageChartCount += 1;
        CMUIX_ResultDamageChartValues[lv_index] = CMUIX_ResultDamageUnitValues[lv_index][lp_player];
        CMUIX_ResultDamageChartUnitTypes[lv_index] = CMUIX_ResultDamageUnitTypes[lv_index][lp_player];
        lv_index += 1;
    }
}

int CMUIX_ResultDamageChartTotal(int lp_player) {
    return CMUIX_ResultDamageTotal[lp_player];
}

fixed CMUIX_ResultDamageChartRatio(int lp_value, int lp_total) {
    int lv_scale;
    int lv_scaledValue;
    int lv_scaledTotal;

    lv_scale = 1;
    lv_scaledValue = 0;
    lv_scaledTotal = 0;
    if ((lp_value <= 0) || (lp_total <= 0)) {
        return 0.0;
    }

    lv_scale = MaxI((lp_total / 100000) + 1, 1);
    lv_scaledValue = lp_value / lv_scale;
    lv_scaledTotal = MaxI(lp_total / lv_scale, 1);
    return IntToFixed(lv_scaledValue) / IntToFixed(lv_scaledTotal);
}

int CMUIX_ResultDamageChartCreateControl(int lp_panel, int lp_type, int lp_width, int lp_height, int lp_anchor, int lp_x, int lp_y) {
    int lv_control;

    lv_control = c_invalidDialogControlId;
    if ((CMUIX_IsControlValid(lp_panel) == false)) {
        return lv_control;
    }

    DialogControlCreateInPanel(lp_panel, lp_type);
    lv_control = DialogControlLastCreated();
    DialogControlSetSize(lv_control, PlayerGroupAll(), lp_width, lp_height);
    DialogControlSetPosition(lv_control, PlayerGroupAll(), lp_anchor, lp_x, lp_y);
    return lv_control;
}

int CMUIX_ResultDamageChartCreateImage(int lp_panel, int lp_width, int lp_height, int lp_anchor, int lp_x, int lp_y, string lp_image, color lp_color, int lp_alpha) {
    int lv_control;

    lv_control = CMUIX_ResultDamageChartCreateControl(lp_panel, c_triggerControlTypeImage, lp_width, lp_height, lp_anchor, lp_x, lp_y);
    if ((CMUIX_IsControlValid(lv_control) == false)) {
        return lv_control;
    }

    libNtve_gf_SetDialogItemImage(lv_control, lp_image, PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(lv_control, c_triggerImageTypeNormal, PlayerGroupAll());
    libNtve_gf_SetDialogItemBlendMode(lv_control, c_triggerBlendModeNormal, PlayerGroupAll());
    libNtve_gf_SetDialogItemColor(lv_control, lp_color, PlayerGroupAll());
    DialogControlSetPropertyAsInt(lv_control, c_triggerControlPropertyAlpha, PlayerGroupAll(), lp_alpha);
    return lv_control;
}

int CMUIX_ResultDamageChartCreateLabel(int lp_panel, int lp_width, int lp_height, int lp_anchor, int lp_x, int lp_y, text lp_text, string lp_style, color lp_color) {
    int lv_control;

    lv_control = CMUIX_ResultDamageChartCreateControl(lp_panel, c_triggerControlTypeLabel, lp_width, lp_height, lp_anchor, lp_x, lp_y);
    if ((CMUIX_IsControlValid(lv_control) == false)) {
        return lv_control;
    }

    libNtve_gf_SetDialogItemText(lv_control, lp_text, PlayerGroupAll());
    libNtve_gf_SetDialogItemStyle(lv_control, lp_style, PlayerGroupAll());
    libNtve_gf_SetDialogItemColor(lv_control, lp_color, PlayerGroupAll());
    return lv_control;
}

void CMUIX_ResultDamageChartCreateLegend(int lp_panel, int lp_index, text lp_name, int lp_damage, int lp_total, color lp_color) {
    int lv_y;
    fixed lv_percent;

    lv_y = 105 + ((lp_index - 1) * 29);
    lv_percent = CMUIX_ResultDamageChartRatio(lp_damage, lp_total) * 100.0;
    CMUIX_ResultDamageChartCreateImage(lp_panel, 16, 16, c_anchorTopLeft, 342, lv_y + 4, "Assets\\Textures\\white.dds", lp_color, 220);
    CMUIX_ResultDamageChartCreateLabel(lp_panel, 220, 24, c_anchorTopLeft, 366, lv_y, lp_name, "AF_PieName", lp_color);
    CMUIX_ResultDamageChartCreateLabel(lp_panel, 72, 24, c_anchorTopLeft, 572, lv_y, FixedToText(lv_percent, 1) + StringToText("%"), "AF_PiePercent", lp_color);
}

void CMUIX_ResultDamageChartDrawSlices(int lp_panel, int lp_startSlice, int lp_endSlice, color lp_color) {
    int lv_slice;
    int lv_angle;
    int lv_x;
    int lv_y;
    int lv_control;

    lv_slice = lp_startSlice;
    lv_angle = 0;
    lv_x = 0;
    lv_y = 0;
    lv_control = c_invalidDialogControlId;
    while ((lv_slice <= lp_endSlice)) {
        lv_angle = lv_slice;
        lv_x = -150 + FixedToInt(CMUIX_RESULT_CHART_RADIUS * Sin(IntToFixed(lv_angle)));
        lv_y = 30 + FixedToInt(-CMUIX_RESULT_CHART_RADIUS * Cos(IntToFixed(lv_angle)));
        lv_control = CMUIX_ResultDamageChartCreateImage(lp_panel, 10, 144, c_anchorCenter, lv_x, lv_y, "AF_slice.dds", lp_color, CMUIX_RESULT_CHART_ALPHA);
        if ((CMUIX_IsControlValid(lv_control) == true)) {
            libNtve_gf_SetDialogItemRotation(lv_control, lv_angle, PlayerGroupAll());
        }

        lv_slice += 1;
    }
}

void CMUIX_ResultDamageChartCreate(int lp_context, int lp_player, int lp_colorShift) {
    int lv_parentPanel;
    int lv_panel;
    int lv_index;
    int lv_count;
    int lv_total;
    int lv_topTotal;
    int lv_chartTotal;
    int lv_other;
    int lv_startSlice;
    int lv_endSlice;
    int lv_damage;
    int lv_cumulativeDamage;
    text lv_name;
    text lv_totalText;
    color lv_color;

    lv_parentPanel = CMUIX_ResultDamageChartPanels[lp_player];
    lv_panel = c_invalidDialogControlId;
    lv_index = 1;
    lv_count = 0;
    lv_total = CMUIX_ResultDamageChartTotal(lp_player);
    lv_topTotal = 0;
    lv_chartTotal = 0;
    lv_other = 0;
    lv_startSlice = 0;
    lv_endSlice = 0;
    lv_damage = 0;
    lv_cumulativeDamage = 0;
    lv_name = StringToText("");
    lv_totalText = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageTotal") + StringToText(" ") + StringToText(libCOTF_gf_UT_FormatInteger(lv_total, " "));
    lv_color = Color(255, 255, 255);
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX) || (CMUIX_IsControlValid(lv_parentPanel) == false)) {
        return;
    }

    DialogControlCreateInPanel(lv_parentPanel, c_triggerControlTypePanel);
    lv_panel = DialogControlLastCreated();
    CMUIX_ResultDamageChartCanvas[lp_context][lp_player] = lv_panel;
    DialogControlSetSize(lv_panel, PlayerGroupAll(), 660, 550);
    DialogControlSetPosition(lv_panel, PlayerGroupAll(), c_anchorCenter, 0, 0);
    if ((lp_context != CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT)) {
        DialogControlSetVisible(lv_panel, PlayerGroupAll(), false);
        DialogControlSetVisible(lv_panel, PlayerGroupSingle(lp_context - CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE), true);
    }

    CMUIX_ResultDamageChartCreateLabel(lv_panel, 620, 42, c_anchorTop, 0, 10, StringToText(CMUIX_ResultPlayerName[lp_player]), "AF_PieTitle", libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lp_player, false)));
    CMUIX_ResultDamageChartCreateLabel(lv_panel, 620, 32, c_anchorTop, 0, 50, lv_totalText, "AF_PieSubtitle", Color(255, 255, 255));
    if ((lv_total <= 0)) {
        CMUIX_ResultDamageChartCreateLabel(lv_panel, 560, 60, c_anchorCenter, 0, 0, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageNoData"), "Coop_ScoreScreen_MessageLabel", Color(255, 255, 255));
        return;
    }

    CMUIX_ResultDamageChartCollect(lp_player);
    lv_count = CMUIX_ResultDamageChartCount;
    lv_index = 1;
    while ((lv_index <= lv_count)) {
        lv_topTotal += CMUIX_ResultDamageChartValues[lv_index];
        lv_index += 1;
    }

    lv_chartTotal = MaxI(lv_total, lv_topTotal);
    lv_other = MaxI(lv_total - lv_topTotal, 0);
    if ((lv_other > 0) && (lv_count < CMUIX_RESULT_CHART_UNIT_MAX)) {
        lv_count += 1;
        CMUIX_ResultDamageChartValues[lv_count] = lv_other;
        CMUIX_ResultDamageChartUnitTypes[lv_count] = "";
    }

    lv_index = 1;
    while ((lv_index <= lv_count)) {
        lv_damage = CMUIX_ResultDamageChartValues[lv_index];
        lv_cumulativeDamage += lv_damage;
        lv_endSlice = MinI(FixedToInt(CMUIX_ResultDamageChartRatio(lv_cumulativeDamage, lv_chartTotal) * 360.0) - 1, 359);
        if ((lv_index == lv_count)) {
            lv_endSlice = 359;
        }

        lv_color = libCOTF_gf_UT_NewColor(lp_colorShift + lv_index);
        if ((lv_endSlice >= lv_startSlice)) {
            CMUIX_ResultDamageChartDrawSlices(lv_panel, lv_startSlice, lv_endSlice, lv_color);
        }

        if ((CMUIX_ResultDamageChartUnitTypes[lv_index] == "")) {
            lv_name = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageOther");
        }
        else {
            lv_name = libCOTF_gf_UT_NameOfUnitType(CMUIX_ResultDamageChartUnitTypes[lv_index]);
        }

        CMUIX_ResultDamageChartCreateLegend(lv_panel, lv_index, lv_name, lv_damage, lv_chartTotal, lv_color);
        lv_startSlice = lv_endSlice + 1;
        lv_index += 1;
    }
}

void CMUIX_ResultDamageChartsInvalidate(int lp_context) {
    int lv_player;

    lv_player = 1;
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
        return;
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        if ((CMUIX_IsControlValid(CMUIX_ResultDamageChartCanvas[lp_context][lv_player]) == true)) {
            DialogControlDestroy(CMUIX_ResultDamageChartCanvas[lp_context][lv_player]);
        }

        CMUIX_ResultDamageChartCanvas[lp_context][lv_player] = c_invalidDialogControlId;
        lv_player += 1;
    }

    CMUIX_ResultDamageChartsBuilt[lp_context] = false;
}

void CMUIX_ResultDamageChartsEnsure(int lp_context) {
    bool lv_playerTwo;
    playergroup lv_players;

    lv_playerTwo = CMUIX_ResultPlayerPresent[2];
    lv_players = PlayerGroupAll();
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX) || (CMUIX_ResultDamageChartsBuilt[lp_context] == true)) {
        return;
    }

    if ((lp_context != CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT)) {
        lv_players = PlayerGroupSingle(lp_context - CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE);
    }

    if ((CMUIX_IsControlValid(CMUIX_ResultDamageChartPanels[1]) == true)) {
        DialogControlSetPosition(CMUIX_ResultDamageChartPanels[1], lv_players, c_anchorTop, (BoolToInt(lv_playerTwo) * -330), 0);
        CMUIX_ResultDamageChartCreate(lp_context, 1, 0);
    }

    if ((lv_playerTwo == true) && (CMUIX_IsControlValid(CMUIX_ResultDamageChartPanels[2]) == true)) {
        DialogControlSetPosition(CMUIX_ResultDamageChartPanels[2], lv_players, c_anchorTop, 330, 0);
        CMUIX_ResultDamageChartCreate(lp_context, 2, 8);
    }

    CMUIX_ResultDamageChartsBuilt[lp_context] = true;
}

void CMUIX_ResultDamageChartsSetVisible(int lp_player, bool lp_visible) {
    int lv_chartPlayer;
    int lv_context;
    int lv_visibleContext;
    bool lv_chartPresent;
    playergroup lv_players;

    lv_chartPlayer = 1;
    lv_context = 1;
    lv_visibleContext = CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT;
    lv_chartPresent = false;
    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_ResultHistoryViewActive[lp_player] == true)) {
        lv_visibleContext = CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE + lp_player;
    }

    if ((lp_visible == true)) {
        CMUIX_ResultDamageChartsEnsure(lv_visibleContext);
    }

    while ((lv_chartPlayer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_chartPresent = CMUIX_ResultPlayerPresent[lv_chartPlayer];
        if ((CMUIX_ResultHistoryViewActive[lp_player] == true)) {
            lv_chartPresent = CMUIX_ResultHistoryPlayerPresent[lp_player][lv_chartPlayer];
        }

        if ((CMUIX_IsControlValid(CMUIX_ResultDamageChartPanels[lv_chartPlayer]) == true)) {
            CMUIX_SetControlVisible(CMUIX_ResultDamageChartPanels[lv_chartPlayer], lv_players, (lp_visible == true) && (lv_chartPresent == true));
        }

        lv_context = 1;
        while ((lv_context <= CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
            if ((CMUIX_IsControlValid(CMUIX_ResultDamageChartCanvas[lv_context][lv_chartPlayer]) == true)) {
                CMUIX_SetControlVisible(CMUIX_ResultDamageChartCanvas[lv_context][lv_chartPlayer], lv_players, (lp_visible == true) && (lv_context == lv_visibleContext));
            }

            lv_context += 1;
        }

        lv_chartPlayer += 1;
    }
}

text CMUIX_ResultOverviewPlayerText(int lp_player) {
    text lv_name;
    text lv_commander;

    lv_name = StringToText(CMUIX_ResultPlayerName[lp_player]);
    lv_commander = libCOOC_gf_CC_CommanderName(CMUIX_ResultPlayerCommander[lp_player]);
    if ((TextToString(lv_name) == "")) {
        lv_name = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/PlayerFallback") + IntToText(lp_player);
    }

    if ((TextToString(lv_commander) == "")) {
        return lv_name;
    }

    return lv_name + StringToText("  |  ") + lv_commander;
}

text CMUIX_ResultOverviewMasteryText(int lp_player) {
    int lv_mastery;
    int lv_inLine;
    int lv_perLine;
    string lv_masteryId;
    text lv_result;
    text lv_entry;

    lv_mastery = 1;
    lv_inLine = 0;
    lv_perLine = 2;
    lv_masteryId = "";
    lv_result = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/MasteryAllocation");
    lv_entry = StringToText("");
    if ((CMUIX_ResultPlayerPresent[2] == false)) {
        lv_perLine = 3;
    }

    while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_masteryId = CMUIX_ResultPlayerMasteryId[lv_mastery][lp_player];
        if ((lv_masteryId != "") && (lv_masteryId != null)) {
            lv_entry = libCOOC_gf_CC_PlayerMasteryName(lv_masteryId) + StringToText(": ") + IntToText(CMUIX_ResultPlayerMasteryValue[lv_mastery][lp_player]);
            if ((lv_inLine == 0)) {
                lv_result = lv_result + StringToText("<n/>") + lv_entry;
            }
            else {
                lv_result = lv_result + StringToText("    ") + lv_entry;
            }

            lv_inLine += 1;
            if ((lv_inLine >= lv_perLine)) {
                lv_inLine = 0;
            }
        }

        lv_mastery += 1;
    }

    return lv_result;
}

void CMUIX_ResultOverviewInvalidateCharts(int lp_context) {
    int lv_player;

    lv_player = 1;
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
        return;
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        if ((CMUIX_IsControlValid(CMUIX_ResultOverviewChartCanvas[lp_context][lv_player]) == true)) {
            DialogControlDestroy(CMUIX_ResultOverviewChartCanvas[lp_context][lv_player]);
        }

        CMUIX_ResultOverviewChartCanvas[lp_context][lv_player] = c_invalidDialogControlId;
        lv_player += 1;
    }

    CMUIX_ResultOverviewChartsBuilt[lp_context] = false;
}

void CMUIX_ResultOverviewChartCreateLegend(int lp_canvas, int lp_index, text lp_name, int lp_damage, int lp_total, color lp_color, bool lp_singlePlayer) {
    int lv_column;
    int lv_row;
    int lv_x;
    int lv_y;
    int lv_nameLabel;
    fixed lv_percent;

    if ((lp_singlePlayer == true)) {
        lv_column = (lp_index - 1) / 5;
        lv_row = ModI(lp_index - 1, 5);
        lv_x = 240 + (lv_column * 240);
    }
    else {
        lv_column = (lp_index - 1) / 8;
        lv_row = ModI(lp_index - 1, 8);
        lv_x = 178 + (lv_column * 222);
    }

    lv_y = 8 + (lv_row * 28);
    lv_nameLabel = c_invalidDialogControlId;
    lv_percent = CMUIX_ResultDamageChartRatio(lp_damage, lp_total) * 100.0;
    CMUIX_ResultDamageChartCreateImage(lp_canvas, 12, 12, c_anchorTopLeft, lv_x, lv_y + 5, "Assets\\Textures\\white.dds", lp_color, 215);
    lv_nameLabel = CMUIX_ResultDamageChartCreateLabel(lp_canvas, 80, 23, c_anchorTopLeft, lv_x + 16, lv_y, lp_name, "CM_ResultOverviewLegendName", lp_color);
    CMUIX_SetControlTooltip(lv_nameLabel, PlayerGroupAll(), lp_name);
    CMUIX_ResultDamageChartCreateLabel(lp_canvas, 84, 23, c_anchorTopLeft, lv_x + 96, lv_y, StringToText(libCOTF_gf_UT_FormatInteger(lp_damage, " ")), "CM_ResultOverviewLegendValue", Color(220, 220, 220));
    CMUIX_ResultDamageChartCreateLabel(lp_canvas, 42, 23, c_anchorTopLeft, lv_x + 180, lv_y, FixedToText(lv_percent, 1) + StringToText("%"), "CM_ResultOverviewLegendValue", Color(255, 255, 255));
}

void CMUIX_ResultOverviewChartDrawSegments(int lp_canvas, int lp_startSegment, int lp_endSegment, color lp_color) {
    int lv_segment;
    int lv_angle;
    int lv_x;
    int lv_y;
    int lv_control;

    lv_segment = lp_startSegment;
    lv_angle = 0;
    lv_x = 0;
    lv_y = 0;
    lv_control = c_invalidDialogControlId;
    while ((lv_segment <= lp_endSegment)) {
        lv_angle = lv_segment * CMUIX_RESULT_OVERVIEW_CHART_ANGLE_STEP;
        lv_x = 96 + FixedToInt(CMUIX_RESULT_OVERVIEW_CHART_RADIUS * Sin(IntToFixed(lv_angle)));
        lv_y = -4 + FixedToInt(-CMUIX_RESULT_OVERVIEW_CHART_RADIUS * Cos(IntToFixed(lv_angle)));
        lv_control = CMUIX_ResultDamageChartCreateImage(lp_canvas, CMUIX_RESULT_OVERVIEW_CHART_SLICE_WIDTH, FixedToInt(CMUIX_RESULT_OVERVIEW_CHART_RADIUS * 2.0), c_anchorLeft, lv_x, lv_y, "AF_slice.dds", lp_color, CMUIX_RESULT_OVERVIEW_CHART_ALPHA);
        if ((CMUIX_IsControlValid(lv_control) == true)) {
            libNtve_gf_SetDialogItemRotation(lv_control, lv_angle, PlayerGroupAll());
        }

        lv_segment += 1;
    }
}

void CMUIX_ResultOverviewChartCreate(int lp_context, int lp_player, int lp_colorShift) {
    int lv_panel;
    int lv_canvas;
    int lv_canvasWidth;
    int lv_index;
    int lv_count;
    int lv_total;
    int lv_topTotal;
    int lv_chartTotal;
    int lv_other;
    int lv_displayCount;
    int lv_damage;
    int lv_cumulativeDamage;
    int lv_startSegment;
    int lv_endSegment;
    bool lv_singlePlayer;
    string lv_unitType;
    text lv_name;
    color lv_color;

    lv_panel = CMUIX_ResultOverviewChartPanels[lp_context][lp_player];
    lv_canvas = c_invalidDialogControlId;
    lv_canvasWidth = 634;
    lv_index = 1;
    lv_count = CMUIX_ResultDamageUnitCount[lp_player];
    lv_total = CMUIX_ResultDamageTotal[lp_player];
    lv_topTotal = 0;
    lv_chartTotal = 0;
    lv_other = 0;
    lv_displayCount = 0;
    lv_damage = 0;
    lv_cumulativeDamage = 0;
    lv_startSegment = 0;
    lv_endSegment = 0;
    lv_unitType = "";
    lv_name = StringToText("");
    lv_color = Color(255, 255, 255);
    lv_singlePlayer = (CMUIX_ResultPlayerPresent[2] == false);
    if ((lv_singlePlayer == true)) {
        lv_canvasWidth = 984;
    }

    if ((CMUIX_IsControlValid(lv_panel) == false)) {
        return;
    }

    DialogControlCreateInPanel(lv_panel, c_triggerControlTypePanel);
    lv_canvas = DialogControlLastCreated();
    CMUIX_ResultOverviewChartCanvas[lp_context][lp_player] = lv_canvas;
    DialogControlSetSize(lv_canvas, PlayerGroupAll(), lv_canvasWidth, 255);
    DialogControlSetPosition(lv_canvas, PlayerGroupAll(), c_anchorCenter, 0, 0);
    if ((lp_context != CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT)) {
        DialogControlSetVisible(lv_canvas, PlayerGroupAll(), false);
        DialogControlSetVisible(lv_canvas, PlayerGroupSingle(lp_context - CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE), true);
    }

    if ((lv_total <= 0)) {
        CMUIX_ResultDamageChartCreateLabel(lv_canvas, 560, 48, c_anchorCenter, 0, 0, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageNoData"), "Coop_ScoreScreen_MessageLabel", Color(255, 255, 255));
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_topTotal += CMUIX_ResultDamageUnitValues[lv_index][lp_player];
        lv_index += 1;
    }

    lv_chartTotal = MaxI(lv_total, lv_topTotal);
    lv_other = MaxI(lv_total - lv_topTotal, 0);
    lv_displayCount = lv_count + BoolToInt(lv_other > 0);
    lv_index = 1;
    while ((lv_index <= lv_displayCount)) {
        if ((lv_index <= lv_count)) {
            lv_damage = CMUIX_ResultDamageUnitValues[lv_index][lp_player];
            lv_unitType = CMUIX_ResultDamageUnitTypes[lv_index][lp_player];
            lv_name = libCOTF_gf_UT_NameOfUnitType(lv_unitType);
        }
        else {
            lv_damage = lv_other;
            lv_unitType = "";
            lv_name = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageOther");
        }

        lv_cumulativeDamage += lv_damage;
        lv_endSegment = MinI(FixedToInt(CMUIX_ResultDamageChartRatio(lv_cumulativeDamage, lv_chartTotal) * IntToFixed(CMUIX_RESULT_OVERVIEW_CHART_SEGMENTS)) - 1, CMUIX_RESULT_OVERVIEW_CHART_SEGMENTS - 1);
        if ((lv_index == lv_displayCount)) {
            lv_endSegment = CMUIX_RESULT_OVERVIEW_CHART_SEGMENTS - 1;
        }

        lv_color = libCOTF_gf_UT_NewColor(lp_colorShift + lv_index);
        if ((lv_endSegment >= lv_startSegment)) {
            CMUIX_ResultOverviewChartDrawSegments(lv_canvas, lv_startSegment, lv_endSegment, lv_color);
        }

        CMUIX_ResultOverviewChartCreateLegend(lv_canvas, lv_index, lv_name, lv_damage, lv_chartTotal, lv_color, lv_singlePlayer);
        lv_startSegment = lv_endSegment + 1;
        lv_index += 1;
    }
}

void CMUIX_ResultOverviewChartsEnsure(int lp_context) {
    int lv_player;

    lv_player = 1;
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX) || (CMUIX_ResultOverviewChartsBuilt[lp_context] == true)) {
        return;
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        if ((CMUIX_ResultPlayerPresent[lv_player] == true)) {
            CMUIX_ResultOverviewChartCreate(lp_context, lv_player, (lv_player - 1) * 8);
        }

        lv_player += 1;
    }

    CMUIX_ResultOverviewChartsBuilt[lp_context] = true;
}

void CMUIX_ResultOverviewChartsSetVisible(int lp_player, int lp_context, bool lp_visible) {
    int lv_chartPlayer;
    playergroup lv_players;

    lv_chartPlayer = 1;
    lv_players = PlayerGroupSingle(lp_player);
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
        return;
    }

    while ((lv_chartPlayer <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        if ((CMUIX_IsControlValid(CMUIX_ResultOverviewChartCanvas[lp_context][lv_chartPlayer]) == true)) {
            CMUIX_SetControlVisible(CMUIX_ResultOverviewChartCanvas[lp_context][lv_chartPlayer], lv_players, lp_visible);
        }

        lv_chartPlayer += 1;
    }
}

void CMUIX_ResultOverviewRefresh(int lp_context) {
    int lv_player;
    int lv_slot;
    int lv_historyIndex;
    int lv_historyStart;
    int lv_playerFrameWidth;
    string lv_mutator;
    text lv_chaosSummary;
    text lv_masteryText;
    bool lv_playerTwo;
    playergroup lv_players;

    lv_player = 1;
    lv_slot = 1;
    lv_historyIndex = 0;
    lv_historyStart = MaxI(CMUIX_ResultChaosHistoryCount - CMUIX_RESULT_OVERVIEW_CHAOS_MAX + 1, 1);
    lv_playerFrameWidth = 650;
    lv_mutator = "";
    lv_chaosSummary = StringToText("");
    lv_masteryText = StringToText("");
    lv_playerTwo = CMUIX_ResultPlayerPresent[2];
    lv_players = PlayerGroupAll();
    if ((lp_context < 1) || (lp_context > CMUIX_RESULT_OVERVIEW_CONTEXT_MAX) || (CMUIX_IsControlValid(CMUIX_ResultOverviewPanels[lp_context]) == false)) {
        return;
    }

    if ((lp_context != CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT)) {
        lv_players = PlayerGroupSingle(lp_context - CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE);
    }

    if ((lv_playerTwo == false)) {
        lv_playerFrameWidth = 1000;
    }

    if ((CMUIX_IsControlValid(CMUIX_ResultOverviewPlayerFrames[lp_context][1]) == true)) {
        DialogControlSetSize(CMUIX_ResultOverviewPlayerFrames[lp_context][1], lv_players, lv_playerFrameWidth, 460);
        DialogControlSetPosition(CMUIX_ResultOverviewPlayerFrames[lp_context][1], lv_players, c_anchorTop, BoolToInt(lv_playerTwo) * -330, 0);
    }

    if ((CMUIX_IsControlValid(CMUIX_ResultOverviewPlayerFrames[lp_context][2]) == true)) {
        DialogControlSetSize(CMUIX_ResultOverviewPlayerFrames[lp_context][2], lv_players, 650, 460);
        DialogControlSetPosition(CMUIX_ResultOverviewPlayerFrames[lp_context][2], lv_players, c_anchorTop, 330, 0);
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        CMUIX_SetControlVisible(CMUIX_ResultOverviewPlayerFrames[lp_context][lv_player], lv_players, CMUIX_ResultPlayerPresent[lv_player]);
        if ((CMUIX_ResultPlayerPresent[lv_player] == true)) {
            CMUIX_SetControlText(CMUIX_ResultOverviewPlayerLabels[lp_context][lv_player], lv_players, CMUIX_ResultOverviewPlayerText(lv_player));
            CMUIX_SetControlText(CMUIX_ResultOverviewPrestigeLabels[lp_context][lv_player], lv_players, CMUIX_PrestigeLabelText(lv_player, CMUIX_ResultPlayerCommander[lv_player], CMUIX_ResultPlayerPrestige[lv_player]));
            CMUIX_SetControlText(CMUIX_ResultOverviewKillsLabels[lp_context][lv_player], lv_players, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/Kills") + StringToText(": ") + StringToText(libCOTF_gf_UT_FormatInteger(CMUIX_ResultStatValues[1][lv_player], " ")));
            CMUIX_SetControlText(CMUIX_ResultOverviewDamageLabels[lp_context][lv_player], lv_players, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/DamageTotal") + StringToText(": ") + StringToText(libCOTF_gf_UT_FormatInteger(CMUIX_ResultDamageTotal[lv_player], " ")));
            lv_masteryText = CMUIX_ResultOverviewMasteryText(lv_player);
            CMUIX_SetControlText(CMUIX_ResultOverviewMasteryLabels[lp_context][lv_player], lv_players, lv_masteryText);
            CMUIX_SetControlTooltip(CMUIX_ResultOverviewMasteryLabels[lp_context][lv_player], lv_players, lv_masteryText);
        }

        lv_player += 1;
    }

    if ((CMUIX_ResultChaosSlotCount > 0) || (CMUIX_ResultChaosHistoryCount > 0)) {
        lv_chaosSummary = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ChaosActiveCount") + StringToText(" ") + IntToText(CMUIX_ResultChaosSlotCount) + StringToText("    ") + StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ChaosRecordedCount") + StringToText(" ") + IntToText(CMUIX_ResultChaosHistoryCount);
    }
    else {
        lv_chaosSummary = StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/ChaosHistoryEmpty");
    }

    CMUIX_SetControlText(CMUIX_ResultOverviewChaosSummaryLabels[lp_context], lv_players, lv_chaosSummary);
    while ((lv_slot <= CMUIX_RESULT_OVERVIEW_CHAOS_MAX)) {
        lv_historyIndex = lv_historyStart + lv_slot - 1;
        if ((lv_historyIndex <= CMUIX_ResultChaosHistoryCount)) {
            lv_mutator = CMUIX_ResultChaosHistoryMutators[lv_historyIndex];
            if ((CMUIX_IsControlValid(CMUIX_ResultOverviewChaosItems[lp_context][lv_slot]) == true)) {
                DialogControlSetAnimationState(CMUIX_ResultOverviewChaosItems[lp_context][lv_slot], lv_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lv_mutator, CMUIX_ResultChaosHistoryEnhanced[lv_historyIndex]));
                CMUIX_SetControlTooltip(CMUIX_ResultOverviewChaosItems[lp_context][lv_slot], lv_players, CMUIX_ResultMutatorTooltip(lv_mutator, CMUIX_ResultChaosHistoryEnhanced[lv_historyIndex]));
                CMUIX_SetControlVisible(CMUIX_ResultOverviewChaosItems[lp_context][lv_slot], lv_players, true);
            }

            if ((CMUIX_IsControlValid(CMUIX_ResultOverviewChaosIcons[lp_context][lv_slot]) == true)) {
                libNtve_gf_SetDialogItemImage(CMUIX_ResultOverviewChaosIcons[lp_context][lv_slot], libCOMU_gf_CT_MutatorIcon(lv_mutator), lv_players);
            }
        }
        else {
            CMUIX_SetControlVisible(CMUIX_ResultOverviewChaosItems[lp_context][lv_slot], lv_players, false);
        }

        lv_slot += 1;
    }
}

void CMUIX_ResultSetBackgroundContextForPlayers(playergroup lp_players, bool lp_history) {
    CMUIX_SetControlVisible(CMUIX_ResultBackgroundCutscene, lp_players, (lp_history == false));
    CMUIX_SetControlVisible(CMUIX_ResultHistoryBackgroundCutscene, lp_players, lp_history);
}

void CMUIX_ResultHistoryStatisticsShow(int lp_player, string lp_payload, bool lp_visible) {
    int lv_context;
    int lv_hideContext;
    int lv_snapshotPlayer;
    string lv_liveSnapshot;
    playergroup lv_players;

    lv_context = CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE + lp_player;
    lv_hideContext = 1;
    lv_snapshotPlayer = 1;
    lv_liveSnapshot = "";
    lv_players = PlayerGroupSingle(lp_player);
    if ((lp_player < 1) || (lp_player > CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        return;
    }

    if ((CMUIX_IsControlValid(CMUIX_ScorePanel) == false)) {
        return;
    }

    if ((lp_visible == false)) {
        CMUIX_ResultHistoryViewActive[lp_player] = false;
        CMUIX_ResultSetBackgroundContextForPlayers(lv_players, false);
        CMUIX_ResultDamageChartsSetVisible(lp_player, false);
        while ((lv_hideContext <= CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
            CMUIX_ResultOverviewChartsSetVisible(lp_player, lv_hideContext, false);
            lv_hideContext += 1;
        }

        CMUIX_SetControlVisible(CMUIX_ScorePanel, lv_players, false);
        CMUIX_SetControlVisible(CMUIX_ResultRestartButton, lv_players, true);
        CMUIX_SetControlVisible(CMUIX_ResultExitButton, lv_players, true);
        CMUIX_SetControlText(CMUIX_ResultCloseButton, lv_players, StringExternal("CMUI/ScreenCoopCampaign/ScorePanel/Close"));
        CMUIX_ResultSetUnderlyingLauncherVisibleForPlayers(lv_players, true);
        CMUIX_ResultSetNavigationVisibleForPlayers(lv_players, true);
        CMUIX_ResultSetCommanderCutscenesVisibleForPlayer(lp_player, true);
        return;
    }

    lv_liveSnapshot = CMUIX_ResultStatisticsPayloadBuild();
    if ((CMUIX_ResultStatisticsPayloadLoad(lp_payload) == false)) {
        return;
    }

    CMUIX_ResultHistoryViewActive[lp_player] = true;
    while ((lv_snapshotPlayer <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        CMUIX_ResultHistoryPlayerPresent[lp_player][lv_snapshotPlayer] = CMUIX_ResultPlayerPresent[lv_snapshotPlayer];
        lv_snapshotPlayer += 1;
    }

    CMUIX_ResultRefreshHeaderForPlayers(lv_players);
    CMUIX_ResultRefreshStatsForPlayers(lv_players);
    CMUIX_ResultRefreshPlayersForPlayers(lv_players);
    CMUIX_ResultDamageChartsInvalidate(lv_context);
    CMUIX_ResultDamageChartsEnsure(lv_context);
    CMUIX_ResultOverviewInvalidateCharts(lv_context);
    CMUIX_ResultOverviewRefresh(lv_context);
    CMUIX_ResultOverviewChartsEnsure(lv_context);
    CMUIX_SetControlVisible(CMUIX_ResultRestartButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_ResultExitButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_ResultCloseButton, lv_players, true);
    CMUIX_SetControlEnabled(CMUIX_ResultCloseButton, lv_players, true);
    CMUIX_SetControlText(CMUIX_ResultCloseButton, lv_players, StringExternal("CMUI/ScreenHistory/Statistics/Close"));
    CMUIX_ResultSetUnderlyingLauncherVisibleForPlayers(lv_players, false);
    CMUIX_ResultSetNavigationVisibleForPlayers(lv_players, false);
    CMUIX_ResultSetCommanderCutscenesVisibleForPlayer(lp_player, false);
    CMUIX_ResultSetBackgroundContextForPlayers(lv_players, true);
    CMUIX_SetControlVisible(CMUIX_ScorePanel, lv_players, true);
    DialogControlSendAnimationEvent(CMUIX_ScorePanel, lv_players, "Show");
    CMUIX_ResultSelectPage(lp_player, CMUIX_RESULT_PAGE_OVERVIEW);
    CMUIX_ResultStatisticsPayloadLoad(lv_liveSnapshot);
}

void CMUIX_ResultSelectPage(int lp_player, int lp_page) {
    int lv_context;
    int lv_hideContext;
    bool lv_viewVisible;
    playergroup lv_players;

    lv_context = CMUIX_RESULT_OVERVIEW_CONTEXT_RESULT;
    lv_hideContext = 1;
    lv_viewVisible = false;
    lv_players = PlayerGroupSingle(lp_player);
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_page < CMUIX_RESULT_PAGE_STATS) || (lp_page > CMUIX_RESULT_PAGE_OVERVIEW)) {
        lp_page = CMUIX_RESULT_PAGE_STATS;
    }

    CMUIX_ResultPageForPlayer[lp_player] = lp_page;
    if ((CMUIX_IsControlValid(CMUIX_ResultTabControl) == true)) {
        DialogControlSetPropertyAsInt(CMUIX_ResultTabControl, c_triggerControlPropertySelectionIndex, lv_players, lp_page - 1);
    }

    CMUIX_SetControlVisible(CMUIX_ResultStatsPanel, lv_players, (lp_page == CMUIX_RESULT_PAGE_STATS));
    CMUIX_SetControlVisible(CMUIX_ResultDamagePanel, lv_players, (lp_page == CMUIX_RESULT_PAGE_DAMAGE));
    CMUIX_SetControlVisible(CMUIX_ResultPlayersPanel, lv_players, (lp_page == CMUIX_RESULT_PAGE_PLAYERS));
    CMUIX_SetControlVisible(CMUIX_ResultOverviewPanel, lv_players, (lp_page == CMUIX_RESULT_PAGE_OVERVIEW));
    CMUIX_SetControlToggled(CMUIX_ResultStatsButton, lv_players, (lp_page == CMUIX_RESULT_PAGE_STATS));
    CMUIX_SetControlToggled(CMUIX_ResultDamageButton, lv_players, (lp_page == CMUIX_RESULT_PAGE_DAMAGE));
    CMUIX_SetControlToggled(CMUIX_ResultPlayersButton, lv_players, (lp_page == CMUIX_RESULT_PAGE_PLAYERS));
    CMUIX_SetControlToggled(CMUIX_ResultOverviewButton, lv_players, (lp_page == CMUIX_RESULT_PAGE_OVERVIEW));
    lv_viewVisible = ((CMUIX_ResultOverlayVisible == true) || (CMUIX_ResultHistoryViewActive[lp_player] == true));
    if ((CMUIX_ResultHistoryViewActive[lp_player] == true)) {
        lv_context = CMUIX_RESULT_OVERVIEW_CONTEXT_HISTORY_BASE + lp_player;
    }

    CMUIX_ResultDamageChartsSetVisible(lp_player, (lv_viewVisible == true) && (lp_page == CMUIX_RESULT_PAGE_DAMAGE));
    while ((lv_hideContext <= CMUIX_RESULT_OVERVIEW_CONTEXT_MAX)) {
        CMUIX_ResultOverviewChartsSetVisible(lp_player, lv_hideContext, false);
        lv_hideContext += 1;
    }

    if ((lv_viewVisible == true) && (lp_page == CMUIX_RESULT_PAGE_OVERVIEW)) {
        CMUIX_ResultOverviewChartsEnsure(lv_context);
        CMUIX_ResultOverviewChartsSetVisible(lp_player, lv_context, true);
    }
}

void CMUIX_ResultSetNavigationVisibleForPlayers(playergroup lp_players, bool lp_visible) {
    CMUIX_SetControlVisible(CMUIX_ResultMainNavigationContainer, lp_players, lp_visible);
    CMUIX_SetControlVisible(libCMUI_gv_screenCoopNavigationBar, lp_players, lp_visible);
}

void CMUIX_ResultSetNavigationVisible(bool lp_visible) {
    CMUIX_ResultSetNavigationVisibleForPlayers(PlayerGroupAll(), lp_visible);
}

void CMUIX_ResultSetUnderlyingLauncherVisibleForPlayers(playergroup lp_players, bool lp_visible) {
    if ((CMUIX_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == true)) {
        if ((lp_visible == true)) {
            DialogControlSendAnimationEvent(libCMUI_gv_screenCoopCommanderSelectionPanel, lp_players, "UISlideIn");
        }
        else {
            DialogControlSendAnimationEvent(libCMUI_gv_screenCoopCommanderSelectionPanel, lp_players, "UISlideOut");
        }
    }

    CMUIX_SetControlVisible(CMUIX_HistoryRoot, lp_players, lp_visible);
}

void CMUIX_ResultSetActionButtonsEnabled() {
    int lv_player;
    bool lv_enabled;
    playergroup lv_players;

    lv_player = 1;
    lv_enabled = false;
    lv_players = PlayerGroupEmpty();
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_players = PlayerGroupSingle(lv_player);
        lv_enabled = (lv_player == 1);
        CMUIX_SetControlEnabled(CMUIX_ResultCloseButton, lv_players, lv_enabled);
        CMUIX_SetControlEnabled(CMUIX_ResultRestartButton, lv_players, lv_enabled);
        CMUIX_SetControlEnabled(CMUIX_ResultExitButton, lv_players, lv_enabled);
        lv_player += 1;
    }
}

void CMUIX_ResultSetCommanderCutscenesVisible(bool lp_visible) {
    int lv_player;
    playergroup lv_players;

    lv_player = 1;
    lv_players = PlayerGroupAll();
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_IsControlValid(libCMUI_gv_foregroundCutscene[lv_player]) == true)) {
            DialogControlSetVisible(libCMUI_gv_foregroundCutscene[lv_player], lv_players, false);
            if ((lp_visible == true)) {
                DialogControlSetVisible(libCMUI_gv_foregroundCutscene[lv_player], PlayerGroupSingle(lv_player), true);
            }
        }

        lv_player += 1;
    }
}

void CMUIX_ResultSetCommanderCutscenesVisibleForPlayer(int lp_player, bool lp_visible) {
    int lv_commanderPlayer;
    playergroup lv_players;

    lv_commanderPlayer = 1;
    lv_players = PlayerGroupSingle(lp_player);
    while ((lv_commanderPlayer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_IsControlValid(libCMUI_gv_foregroundCutscene[lv_commanderPlayer]) == true)) {
            DialogControlSetVisible(libCMUI_gv_foregroundCutscene[lv_commanderPlayer], lv_players, false);
        }

        lv_commanderPlayer += 1;
    }

    if ((lp_visible == true) && (CMUIX_IsControlValid(libCMUI_gv_foregroundCutscene[lp_player]) == true)) {
        DialogControlSetVisible(libCMUI_gv_foregroundCutscene[lp_player], lv_players, true);
    }
}

void CMUIX_ResultSetOverlayVisible(bool lp_visible) {
    int lv_player;
    int lv_page;
    playergroup lv_players;

    lv_player = 1;
    lv_page = CMUIX_RESULT_PAGE_STATS;
    lv_players = PlayerGroupAll();
    CMUIX_ResultOverlayVisible = lp_visible;
    CMUIX_ResultSetUnderlyingLauncherVisibleForPlayers(lv_players, lp_visible == false);
    CMUIX_ResultSetNavigationVisible(lp_visible == false);
    CMUIX_ResultSetCommanderCutscenesVisible(lp_visible == false);
    CMUIX_ResultSetBackgroundContextForPlayers(lv_players, false);
    if ((CMUIX_IsControlValid(CMUIX_ScorePanel) == true)) {
        DialogControlSetVisible(CMUIX_ScorePanel, lv_players, lp_visible);
        if ((lp_visible == true)) {
            DialogControlSendAnimationEvent(CMUIX_ScorePanel, lv_players, "Show");
        }
        else {
            DialogControlSendAnimationEvent(CMUIX_ScorePanel, lv_players, "Hide");
        }
    }

    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_page = CMUIX_ResultPageForPlayer[lv_player];
        if ((lv_page < CMUIX_RESULT_PAGE_STATS) || (lv_page > CMUIX_RESULT_PAGE_OVERVIEW)) {
            lv_page = CMUIX_RESULT_PAGE_STATS;
        }

        CMUIX_ResultSelectPage(lv_player, lv_page);
        lv_player += 1;
    }

    CMUIX_ResultSetActionButtonsEnabled();
}

void CMUIX_ResultRefreshLauncherAfterAction() {
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_StartupRefreshControls();
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_ReadyRefreshDataControlsAll();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
}

void CMUIX_ResultClearConfigurationForFreeEdit() {
    int lv_player;
    bool lv_seedResolved;
    int lv_seed;

    lv_player = 0;
    lv_seedResolved = CMUIX_RandomSeedResolved;
    lv_seed = CMUIX_RandomSeed;
    CMUIX_ProfileConfigLocked = false;
    CMUIX_ProfileModeActive = false;
    CMUIX_ProfileOptimizationAllowed = true;
    CMUIX_ProfileApplyRestrictionsAndSeed("", false);
    CMUIX_ProfileRandomSeedExplicit = false;
    CMUIX_RandomSeedResolved = lv_seedResolved;
    CMUIX_RandomSeed = lv_seed;
    CMUIX_RandomSeedInputResetDraft();
    CMUIX_ProfileLaunchCounted = false;
    CMUIX_LaunchSource = CMUIX_LAUNCH_SOURCE_MANUAL;
    CMUIX_ProfileMasteryCapEnabled = false;
    CMUIX_ProfileMasteryCap = CMUIX_DefaultMasteryCap();
    CMUIX_ProfileRawConfig = "";
    CMUIX_ProfileChallengeName = "";
    CMUIX_ProfileChecksumValue = 0;
    CMUIX_ProfileCertified = false;
    CMUIX_ProfileSourceTemplateKey = "";
    CMUIX_ProfileSourceTemplatePlayer = 0;
    CMUIX_ProfileSourceHistoryKey = "";
    CMUIX_ProfileCancelSnapshotPayload = "";
    CMUIX_LaunchAttemptCount = 1;
    CMUIX_LaunchAttemptChecksum = 0;
    CMUIX_LaunchHistoryKey = "";
    CMUIX_LaunchLastResult = "";
    CMUIX_ResultStatisticsPayload = "";
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_LaunchHistoryKeys[lv_player] = "";
        lv_player += 1;
    }

    CMUIX_LaunchProfileClearAll();
    CMUIX_ProfileRuntimeLocksRefresh();
}

void CMUIX_ResultPrepareRetryConfiguration() {
    CMUIX_ResultStatisticsPayload = "";
    CMUIX_ProfileConfigLocked = true;
    CMUIX_ProfileModeActive = false;
    CMUIX_ProfileLaunchCounted = true;
    CMUIX_LaunchSource = CMUIX_LAUNCH_SOURCE_HISTORY;
    CMUIX_ProfileSourceTemplateKey = "";
    CMUIX_ProfileSourceTemplatePlayer = 0;
    CMUIX_ProfileSourceHistoryKey = CMUIX_LaunchHistoryKey;
    CMUIX_ProfileCancelSnapshotPayload = "";
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_LaunchProfileRefreshRetryAll();
}

void CMUIX_ResultExitGame() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        GameOver(lv_player, CMUIX_ResultValue, false, false);
    }

    if ((lv_seenPlayers == 0)) {
        GameOver(1, CMUIX_ResultValue, false, false);
    }
}

bool CMUIX_ResultHandleClick(int lp_player, int lp_control) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_control == CMUIX_ResultStatsButton)) {
        CMUIX_ResultSelectPage(lp_player, CMUIX_RESULT_PAGE_STATS);
        return true;
    }

    if ((lp_control == CMUIX_ResultDamageButton)) {
        CMUIX_ResultSelectPage(lp_player, CMUIX_RESULT_PAGE_DAMAGE);
        return true;
    }

    if ((lp_control == CMUIX_ResultPlayersButton)) {
        CMUIX_ResultSelectPage(lp_player, CMUIX_RESULT_PAGE_PLAYERS);
        return true;
    }

    if ((lp_control == CMUIX_ResultOverviewButton)) {
        CMUIX_ResultSelectPage(lp_player, CMUIX_RESULT_PAGE_OVERVIEW);
        return true;
    }

    if ((lp_control != CMUIX_ResultCloseButton) && (lp_control != CMUIX_ResultRestartButton) && (lp_control != CMUIX_ResultExitButton)) {
        return false;
    }

    if ((CMUIX_ResultHistoryViewActive[lp_player] == true)) {
        if ((lp_control == CMUIX_ResultCloseButton)) {
            CMUIX_ResultHistoryStatisticsShow(lp_player, "", false);
        }

        return true;
    }

    if ((lp_player != 1)) {
        return true;
    }

    if ((lp_control == CMUIX_ResultCloseButton)) {
        CMUIX_ResultSetOverlayVisible(false);
        CMUIX_ResultClearConfigurationForFreeEdit();
        CMUIX_ResultRefreshLauncherAfterAction();
        return true;
    }

    if ((lp_control == CMUIX_ResultRestartButton)) {
        CMUIX_ResultSetOverlayVisible(false);
        CMUIX_ResultPrepareRetryConfiguration();
        CMUIX_ResultRefreshLauncherAfterAction();
        return true;
    }

    CMUIX_ResultExitGame();
    return true;
}

void CMUIX_ResultRebuildLauncher() {
    CMUIX_DestroyLauncherUIInternal(false);
    CMUIX_ResetLauncherHookStateForRebuild();
    CMUIX_Init();
    CMUIX_StartupRefreshControls();
}

bool CMUIX_ResultTransmissionPlaying() {
    if ((TriggerActiveCount(libCOMI_gt_CM_TransmissionSend) > 0) || (libCOMI_gv_cM_TransmissionCurrentType != null)) {
        return true;
    }

    if ((libCOMI_gv_cM_SendTransmissionCampaignIndex != 0)) {
        return true;
    }

    return (libCOMI_gf_CM_PlayerHasTransmission(1) == true) || (libCOMI_gf_CM_PlayerHasTransmission(2) == true);
}

void CMUIX_ResultStopMissionActivity() {
    int lv_index;
    int lv_count;
    string lv_mutator;

    // Arbitrary map triggers cannot be enumerated; stop shared loops and registered mutator activity.
    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_mutator = "";
    if ((libCOTF_gt_RT_CycleRandom != null)) {
        TriggerStop(libCOTF_gt_RT_CycleRandom);
    }

    if ((libCOMU_gt_CT_CycleRandomMutators != null)) {
        TriggerStop(libCOMU_gt_CT_CycleRandomMutators);
    }

    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((lv_mutator != "") && (lv_mutator != null) && (libCOMU_gf_MutatorIsActived(lv_mutator) == true)) {
            libCOMU_gf_EnableDisableMutator(false, lv_mutator);
        }

        lv_index += 1;
    }

    TriggerSendEvent("CMUIX_ResultSessionEntered");
}

void CMUIX_ResultSessionEnter() {
    int lv_player;

    lv_player = 1;
    CMUIX_ResultPrepareWorld();
    CMUIX_ResultLauncherActive = true;
    CMUIX_ResultRebuildLauncher();
    CMUIX_ResultRefreshAll();
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ResultPageForPlayer[lv_player] = CMUIX_RESULT_PAGE_STATS;
        lv_player += 1;
    }

    CMUIX_ResultSetOverlayVisible(true);
    CMUIX_ResultStopMissionActivity();
    CMUIX_ResultOpening = false;
}

bool CMUIX_ResultOpenDeferred_Func(bool testConds, bool runActions) {
    int lv_clearChecks;

    lv_clearChecks = 0;
    if ((runActions == false)) {
        return true;
    }

    while ((lv_clearChecks < CMUIX_RESULT_TRANSMISSION_CLEAR_CHECKS)) {
        if ((CMUIX_ResultTransmissionPlaying() == true)) {
            lv_clearChecks = 0;
        }
        else {
            lv_clearChecks += 1;
        }

        Wait(0.25, c_timeReal);
    }

    CMUIX_ResultSessionEnter();
    return true;
}

void CMUIX_ResultSessionOpen(int lp_result) {
    if ((CMUIX_ResultOpening == true) || (CMUIX_ResultOverlayVisible == true) || (CMUIX_ResultLauncherActive == true)) {
        return;
    }

    CMUIX_GameHistoryAutosaveBlocked = true;
    CMUIX_ResultOpening = true;
    CMUIX_ResultSnapshotCapture(lp_result);
    CMUIX_ResultRecordOutcome();
    if ((CMUIX_ResultOpenTrigger == null)) {
        CMUIX_ResultOpenTrigger = TriggerCreate("CMUIX_ResultOpenDeferred_Func");
    }

    TriggerExecute(CMUIX_ResultOpenTrigger, false, false);
}
