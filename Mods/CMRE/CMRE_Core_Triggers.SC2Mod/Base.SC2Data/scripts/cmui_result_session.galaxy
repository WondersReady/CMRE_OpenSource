bool CMUIX_ConfigurationModeActsAsLauncher() {
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return true;
    }

    return CMUIX_ResultLauncherActive;
}

void CMUIX_ResultChaosHistoryRecord(string lp_mutator) {
    int lv_slot;

    lv_slot = 0;
    if ((lp_mutator == "") || (lp_mutator == null) || (CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true)) {
        return;
    }

    if ((CMUIX_ResultChaosHistoryCount >= CMUIX_RESULT_CHAOS_HISTORY_MAX)) {
        return;
    }

    lv_slot = CMUIX_ResultChaosHistoryCount + 1;
    CMUIX_ResultChaosHistoryCount = lv_slot;
    CMUIX_ResultChaosHistoryMutators[lv_slot] = lp_mutator;
    CMUIX_ResultChaosHistoryEnhanced[lv_slot] = libCOMU_gf_MutatorIsEnhanced(lp_mutator);
}

void CMUIX_ResultSnapshotClear() {
    int lv_index;
    int lv_player;
    int lv_mastery;
    int lv_damageIndex;

    lv_index = 0;
    lv_player = 0;
    lv_mastery = 0;
    lv_damageIndex = 0;
    CMUIX_ResultDirectMutatorCount = 0;
    CMUIX_ResultChaosSlotCount = 0;
    while ((lv_index <= CMUIX_RESULT_MUTATOR_MAX)) {
        CMUIX_ResultDirectMutators[lv_index] = "";
        CMUIX_ResultDirectMutatorsEnhanced[lv_index] = false;
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        CMUIX_ResultStatKeys[lv_index] = "";
        lv_player = 0;
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_ResultStatValues[lv_index][lv_player] = 0;
            lv_player += 1;
        }

        lv_index += 1;
    }

    lv_player = 0;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ResultPlayerPresent[lv_player] = false;
        CMUIX_ResultPlayerName[lv_player] = "";
        CMUIX_ResultPlayerCommander[lv_player] = "";
        CMUIX_ResultPlayerPrestige[lv_player] = 0;
        CMUIX_ResultDamageTotal[lv_player] = 0;
        CMUIX_ResultDamageUnitCount[lv_player] = 0;
        lv_damageIndex = 0;
        while ((lv_damageIndex <= CMUIX_RESULT_CHART_TOP_UNITS)) {
            CMUIX_ResultDamageUnitValues[lv_damageIndex][lv_player] = 0;
            CMUIX_ResultDamageUnitTypes[lv_damageIndex][lv_player] = "";
            lv_damageIndex += 1;
        }

        lv_mastery = 0;
        while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            CMUIX_ResultPlayerMasteryId[lv_mastery][lv_player] = "";
            CMUIX_ResultPlayerMasteryValue[lv_mastery][lv_player] = 0;
            lv_mastery += 1;
        }

        lv_player += 1;
    }
}

void CMUIX_ResultSnapshotAppendMutator(string lp_mutator, bool lp_enhanced) {
    int lv_slot;

    lv_slot = 0;
    if ((lp_mutator == "") || (lp_mutator == null) || (CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true)) {
        return;
    }

    if ((lp_mutator == "Chaos") || (UserDataGetInt("Mutators", lp_mutator, "Auto - Actived By Chaos", 1) >= 1) || (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lp_mutator) == true)) {
        return;
    }

    if ((CMUIX_ResultDirectMutatorCount >= CMUIX_RESULT_MUTATOR_MAX)) {
        return;
    }

    lv_slot = CMUIX_ResultDirectMutatorCount + 1;
    CMUIX_ResultDirectMutatorCount = lv_slot;
    CMUIX_ResultDirectMutators[lv_slot] = lp_mutator;
    CMUIX_ResultDirectMutatorsEnhanced[lv_slot] = lp_enhanced;
}

void CMUIX_ResultSnapshotCaptureMutators() {
    int lv_index;
    int lv_count;
    string lv_mutator;
    bool lv_enhanced;

    lv_index = 1;
    lv_count = 0;
    lv_mutator = "";
    lv_enhanced = false;
    CMUIX_ResultChaosSlotCount = CMUIX_ClampInt(libCOTF_gv_rT_ChaosCycleCount, 0, CMUIX_RESULT_MUTATOR_MAX);
    if (((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) || (CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) && (libCOMU_gv_cT_MAbomination_MutatorsCount > 0)) {
        lv_count = MinI(libCOMU_gv_cT_MAbomination_MutatorsCount, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
        while ((lv_index <= lv_count)) {
            CMUIX_ResultSnapshotAppendMutator(libCOMU_gv_cT_MAbomination_Mutators[lv_index], libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index]);
            lv_index += 1;
        }

        return;
    }

    lv_count = UserDataInstanceCount("Mutators");
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((lv_mutator != "") && (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1) == 0) && (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lv_mutator) == false)) {
            if ((UserDataGetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1) >= 1) || (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1) >= 1)) {
                lv_enhanced = (UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1);
                CMUIX_ResultSnapshotAppendMutator(lv_mutator, lv_enhanced);
            }
        }

        lv_index += 1;
    }
}

string CMUIX_ResultSnapshotCommander(int lp_player) {
    string lv_commander;

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if ((lv_commander == "") || (lv_commander == null)) {
        lv_commander = libCOTF_gv_sELECTED_Commander[lp_player];
    }

    if ((lv_commander == "") || (lv_commander == null)) {
        lv_commander = libCOUI_gv_cU_CommanderSelection[lp_player];
    }

    return lv_commander;
}

void CMUIX_ResultSnapshotCapturePlayers() {
    int lv_player;
    int lv_index;
    int lv_count;
    int lv_masteryIndex;
    string lv_commander;
    string lv_mastery;

    lv_player = 1;
    lv_index = 0;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryIndex = 0;
    lv_commander = "";
    lv_mastery = "";
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ResultPlayerPresent[lv_player] = ((PlayerStatus(lv_player) == c_playerStatusActive) && (PlayerType(lv_player) == c_playerTypeUser));
        CMUIX_ResultPlayerName[lv_player] = TextToString(PlayerName(lv_player));
        lv_commander = CMUIX_ResultSnapshotCommander(lv_player);
        CMUIX_ResultPlayerCommander[lv_player] = lv_commander;
        if ((lv_commander != "") && (lv_commander != null)) {
            CMUIX_ResultPlayerPrestige[lv_player] = CMUIX_ReadPrestigeForCommander(lv_player, lv_commander);
            lv_index = 1;
            while ((lv_index <= lv_count)) {
                lv_mastery = UserDataInstance("MasteryUpgrades", lv_index);
                if ((UserDataGetUserInstance("MasteryUpgrades", lv_mastery, "Commander", 1) == lv_commander)) {
                    lv_masteryIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lv_mastery);
                    if ((lv_masteryIndex >= 1) && (lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
                        CMUIX_ResultPlayerMasteryId[lv_masteryIndex][lv_player] = lv_mastery;
                        CMUIX_ResultPlayerMasteryValue[lv_masteryIndex][lv_player] = libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lv_player, lv_mastery);
                    }
                }

                lv_index += 1;
            }
        }

        lv_player += 1;
    }
}

void CMUIX_ResultSnapshotCaptureStats() {
    int lv_index;
    int lv_player;
    string lv_key;

    lv_index = 1;
    lv_player = 1;
    lv_key = "";
    CMUIX_ResultStatKeys[1] = "UnitsStructuresKilled";
    CMUIX_ResultStatKeys[2] = "UnitsProduced";
    CMUIX_ResultStatKeys[3] = "ResourcesGathered";
    CMUIX_ResultStatKeys[4] = libCOOC_gf_CC_MapScoreStatistic(libCOOC_gf_CC_CurrentMap());
    CMUIX_ResultStatKeys[5] = libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultPlayerCommander[1]);
    CMUIX_ResultStatKeys[6] = libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultPlayerCommander[1]);
    CMUIX_ResultStatKeys[7] = libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultPlayerCommander[2]);
    CMUIX_ResultStatKeys[8] = libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultPlayerCommander[2]);
    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        lv_key = CMUIX_ResultStatKeys[lv_index];
        lv_player = 1;
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            if ((lv_key != "") && (lv_key != null)) {
                CMUIX_ResultStatValues[lv_index][lv_player] = PlayerScoreValueGetAsInt(lv_player, lv_key);
            }

            lv_player += 1;
        }

        lv_index += 1;
    }
}

void CMUIX_ResultSnapshotInsertDamage(int lp_player, int lp_damage, string lp_unitType) {
    int lv_position;
    int lv_shift;

    lv_position = 1;
    lv_shift = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lp_damage <= 0) || (lp_unitType == "") || (lp_unitType == null)) {
        return;
    }

    while ((lv_position <= CMUIX_ResultDamageUnitCount[lp_player]) && (lp_damage <= CMUIX_ResultDamageUnitValues[lv_position][lp_player])) {
        lv_position += 1;
    }

    if ((lv_position > CMUIX_RESULT_CHART_TOP_UNITS)) {
        return;
    }

    lv_shift = MinI(CMUIX_ResultDamageUnitCount[lp_player] + 1, CMUIX_RESULT_CHART_TOP_UNITS);
    while ((lv_shift > lv_position)) {
        CMUIX_ResultDamageUnitValues[lv_shift][lp_player] = CMUIX_ResultDamageUnitValues[lv_shift - 1][lp_player];
        CMUIX_ResultDamageUnitTypes[lv_shift][lp_player] = CMUIX_ResultDamageUnitTypes[lv_shift - 1][lp_player];
        lv_shift -= 1;
    }

    CMUIX_ResultDamageUnitValues[lv_position][lp_player] = lp_damage;
    CMUIX_ResultDamageUnitTypes[lv_position][lp_player] = lp_unitType;
    if ((CMUIX_ResultDamageUnitCount[lp_player] < CMUIX_RESULT_CHART_TOP_UNITS)) {
        CMUIX_ResultDamageUnitCount[lp_player] += 1;
    }
}

void CMUIX_ResultSnapshotCaptureDamage() {
    int lv_player;
    int lv_index;
    int lv_damage;
    string lv_unitType;

    lv_player = 1;
    lv_index = 1;
    lv_damage = 0;
    lv_unitType = "";
    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        lv_index = 1;
        while ((lv_index <= libCOTF_gv_uT_DL_MaxUnits)) {
            lv_unitType = libCOTF_gv_uT_DL_Data[lv_index][0][lv_player].lv_unitType;
            if ((lv_unitType != "") && (lv_unitType != null)) {
                lv_damage = libCOTF_gf_UT_DL_SumHealingDamage(lv_index, 0, lv_player);
                if ((lv_damage > 0)) {
                    CMUIX_ResultDamageTotal[lv_player] += lv_damage;
                    CMUIX_ResultSnapshotInsertDamage(lv_player, lv_damage, lv_unitType);
                }
            }

            lv_index += 1;
        }

        lv_player += 1;
    }
}

void CMUIX_ResultSnapshotCapture(int lp_result) {
    int lv_index;

    lv_index = 1;
    CMUIX_ResultSnapshotClear();
    CMUIX_ResultValue = lp_result;
    CMUIX_ResultMapInstance = CMUIX_MapSelectionCurrentMapInstance();
    CMUIX_ResultEnemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    if ((CMUIX_ResultEnemy == "") || (CMUIX_ResultEnemy == null)) {
        CMUIX_ResultEnemy = libCOMI_gv_cM_CoopAIPlayer_Commander[3];
    }

    CMUIX_ResultEnemyRace = CMUIX_EnemySelectionRaceForEnemy(CMUIX_ResultEnemy);
    CMUIX_ResultSnapshotCaptureMutators();
    CMUIX_ResultSnapshotCapturePlayers();
    CMUIX_ResultSnapshotCaptureStats();
    CMUIX_ResultSnapshotCaptureDamage();
    if ((CMUIX_ResultChaosHistoryCount == 0) && (CMUIX_ResultChaosSlotCount > 0)) {
        while ((lv_index <= CMUIX_ResultChaosSlotCount)) {
            CMUIX_ResultChaosHistoryRecord(libCOTF_gv_rT_ChaosMutators[lv_index]);
            lv_index += 1;
        }
    }

    CMUIX_ResultStatisticsPayload = CMUIX_ResultStatisticsPayloadBuild();
}

string CMUIX_ResultStatisticsEscape(string lp_value) {
    string lv_value;

    lv_value = lp_value;
    if ((lv_value == null)) {
        return "";
    }

    lv_value = StringReplaceWord(lv_value, "%", "%25", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, ";", "%3B", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "=", "%3D", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\n", "%0A", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\r", "%0D", c_stringReplaceAll, c_stringCase);
    return lv_value;
}

string CMUIX_ResultStatisticsUnescape(string lp_value) {
    string lv_value;

    lv_value = lp_value;
    if ((lv_value == null)) {
        return "";
    }

    lv_value = StringReplaceWord(lv_value, "%0D", "\r", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "%0A", "\n", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "%3D", "=", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "%3B", ";", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "%25", "%", c_stringReplaceAll, c_stringCase);
    return lv_value;
}

string CMUIX_ResultStatisticsPayloadBody(string lp_payload) {
    int lv_hashPosition;

    lv_hashPosition = StringFind(lp_payload, ";hash=", c_stringNoCase);
    if ((lv_hashPosition <= 1)) {
        return "";
    }

    return StringSub(lp_payload, 1, lv_hashPosition - 1);
}

bool CMUIX_ResultStatisticsPayloadValid(string lp_payload) {
    string lv_body;
    string lv_hash;

    lv_body = CMUIX_ResultStatisticsPayloadBody(lp_payload);
    lv_hash = "";
    if ((StringLength(lv_body) < 3) || (StringSub(lv_body, 1, 3) != "RS1")) {
        return false;
    }

    lv_hash = CMUIX_ProfileConfigValue(lp_payload, "hash");
    if ((lv_hash == "") || (lv_hash == null)) {
        return false;
    }

    return (StringToInt(lv_hash) == CMUIX_ProfileChecksum(lv_body));
}

string CMUIX_ResultStatisticsPayloadCurrent() {
    return CMUIX_ResultStatisticsPayload;
}

string CMUIX_ResultStatisticsPayloadBuild() {
    int lv_index;
    int lv_player;
    int lv_mastery;
    string lv_body;
    string lv_key;

    lv_index = 1;
    lv_player = 1;
    lv_mastery = 1;
    lv_body = "RS1";
    lv_key = "";
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "rv", IntToString(CMUIX_ResultValue));
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "mp", CMUIX_ResultMapInstance);
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "ai", CMUIX_ResultEnemy);
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "ar", CMUIX_ResultEnemyRace);
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "dc", IntToString(CMUIX_ResultDirectMutatorCount));
    while ((lv_index <= CMUIX_ResultDirectMutatorCount)) {
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("d" + IntToString(lv_index)), CMUIX_ResultDirectMutators[lv_index]);
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("e" + IntToString(lv_index)), IntToString(BoolToInt(CMUIX_ResultDirectMutatorsEnhanced[lv_index])));
        lv_index += 1;
    }

    lv_body = CMUIX_ProfileAppendConfig(lv_body, "cs", IntToString(CMUIX_ResultChaosSlotCount));
    lv_body = CMUIX_ProfileAppendConfig(lv_body, "hc", IntToString(CMUIX_ResultChaosHistoryCount));
    lv_index = 1;
    while ((lv_index <= CMUIX_ResultChaosHistoryCount)) {
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("h" + IntToString(lv_index)), CMUIX_ResultChaosHistoryMutators[lv_index]);
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("he" + IntToString(lv_index)), IntToString(BoolToInt(CMUIX_ResultChaosHistoryEnhanced[lv_index])));
        lv_index += 1;
    }

    lv_body = CMUIX_ProfileAppendConfig(lv_body, "sc", IntToString(CMUIX_RESULT_STAT_MAX));
    lv_index = 1;
    while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("sk" + IntToString(lv_index)), CMUIX_ResultStatisticsEscape(CMUIX_ResultStatKeys[lv_index]));
        lv_index += 1;
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("p" + IntToString(lv_player)), IntToString(BoolToInt(CMUIX_ResultPlayerPresent[lv_player])));
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("n" + IntToString(lv_player)), CMUIX_ResultStatisticsEscape(CMUIX_ResultPlayerName[lv_player]));
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("c" + IntToString(lv_player)), CMUIX_ResultPlayerCommander[lv_player]);
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("r" + IntToString(lv_player)), IntToString(CMUIX_ResultPlayerPrestige[lv_player]));
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("t" + IntToString(lv_player)), IntToString(CMUIX_ResultDamageTotal[lv_player]));
        lv_body = CMUIX_ProfileAppendConfig(lv_body, ("dn" + IntToString(lv_player)), IntToString(CMUIX_ResultDamageUnitCount[lv_player]));
        lv_index = 1;
        while ((lv_index <= CMUIX_RESULT_STAT_MAX)) {
            lv_key = ("p" + IntToString(lv_player) + "s" + IntToString(lv_index));
            lv_body = CMUIX_ProfileAppendConfig(lv_body, lv_key, IntToString(CMUIX_ResultStatValues[lv_index][lv_player]));
            lv_index += 1;
        }

        lv_mastery = 1;
        while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            lv_key = ("p" + IntToString(lv_player) + "m" + IntToString(lv_mastery));
            lv_body = CMUIX_ProfileAppendConfig(lv_body, lv_key, CMUIX_ResultPlayerMasteryId[lv_mastery][lv_player]);
            lv_body = CMUIX_ProfileAppendConfig(lv_body, (lv_key + "v"), IntToString(CMUIX_ResultPlayerMasteryValue[lv_mastery][lv_player]));
            lv_mastery += 1;
        }

        lv_index = 1;
        while ((lv_index <= CMUIX_ResultDamageUnitCount[lv_player])) {
            lv_key = ("p" + IntToString(lv_player) + "u" + IntToString(lv_index));
            lv_body = CMUIX_ProfileAppendConfig(lv_body, lv_key, CMUIX_ResultDamageUnitTypes[lv_index][lv_player]);
            lv_body = CMUIX_ProfileAppendConfig(lv_body, (lv_key + "v"), IntToString(CMUIX_ResultDamageUnitValues[lv_index][lv_player]));
            lv_index += 1;
        }

        lv_player += 1;
    }

    return (lv_body + ";hash=" + IntToString(CMUIX_ProfileChecksum(lv_body)));
}

void CMUIX_ResultStatisticsClearForLoad() {
    int lv_index;

    lv_index = 0;
    CMUIX_ResultSnapshotClear();
    CMUIX_ResultChaosHistoryCount = 0;
    while ((lv_index <= CMUIX_RESULT_CHAOS_HISTORY_MAX)) {
        CMUIX_ResultChaosHistoryMutators[lv_index] = "";
        CMUIX_ResultChaosHistoryEnhanced[lv_index] = false;
        lv_index += 1;
    }
}

bool CMUIX_ResultStatisticsPayloadLoad(string lp_payload) {
    int lv_index;
    int lv_player;
    int lv_mastery;
    int lv_statCount;
    string lv_key;

    lv_index = 1;
    lv_player = 1;
    lv_mastery = 1;
    lv_statCount = 0;
    lv_key = "";
    if ((CMUIX_ResultStatisticsPayloadValid(lp_payload) == false)) {
        return false;
    }

    CMUIX_ResultStatisticsClearForLoad();
    CMUIX_ResultValue = StringToInt(CMUIX_ProfileConfigValue(lp_payload, "rv"));
    CMUIX_ResultMapInstance = CMUIX_ProfileConfigValue(lp_payload, "mp");
    CMUIX_ResultEnemy = CMUIX_ProfileConfigValue(lp_payload, "ai");
    CMUIX_ResultEnemyRace = CMUIX_ProfileConfigValue(lp_payload, "ar");
    if ((CMUIX_ResultEnemyRace == "") || (CMUIX_ResultEnemyRace == null)) {
        CMUIX_ResultEnemyRace = CMUIX_EnemySelectionRaceForEnemy(CMUIX_ResultEnemy);
    }

    CMUIX_ResultDirectMutatorCount = CMUIX_ClampInt(StringToInt(CMUIX_ProfileConfigValue(lp_payload, "dc")), 0, CMUIX_RESULT_MUTATOR_MAX);
    while ((lv_index <= CMUIX_ResultDirectMutatorCount)) {
        CMUIX_ResultDirectMutators[lv_index] = CMUIX_ProfileConfigValue(lp_payload, ("d" + IntToString(lv_index)));
        CMUIX_ResultDirectMutatorsEnhanced[lv_index] = (StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("e" + IntToString(lv_index)))) == 1);
        lv_index += 1;
    }

    CMUIX_ResultChaosSlotCount = CMUIX_ClampInt(StringToInt(CMUIX_ProfileConfigValue(lp_payload, "cs")), 0, CMUIX_RESULT_MUTATOR_MAX);
    CMUIX_ResultChaosHistoryCount = CMUIX_ClampInt(StringToInt(CMUIX_ProfileConfigValue(lp_payload, "hc")), 0, CMUIX_RESULT_CHAOS_HISTORY_MAX);
    lv_index = 1;
    while ((lv_index <= CMUIX_ResultChaosHistoryCount)) {
        CMUIX_ResultChaosHistoryMutators[lv_index] = CMUIX_ProfileConfigValue(lp_payload, ("h" + IntToString(lv_index)));
        CMUIX_ResultChaosHistoryEnhanced[lv_index] = (StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("he" + IntToString(lv_index)))) == 1);
        lv_index += 1;
    }

    lv_statCount = CMUIX_ClampInt(StringToInt(CMUIX_ProfileConfigValue(lp_payload, "sc")), 0, CMUIX_RESULT_STAT_MAX);
    if ((lv_statCount <= 0)) {
        CMUIX_ResultStatKeys[1] = "UnitsStructuresKilled";
    }
    else {
        lv_index = 1;
        while ((lv_index <= lv_statCount)) {
            CMUIX_ResultStatKeys[lv_index] = CMUIX_ResultStatisticsUnescape(CMUIX_ProfileConfigValue(lp_payload, ("sk" + IntToString(lv_index))));
            lv_index += 1;
        }
    }

    while ((lv_player <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
        CMUIX_ResultPlayerPresent[lv_player] = (StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("p" + IntToString(lv_player)))) == 1);
        CMUIX_ResultPlayerName[lv_player] = CMUIX_ResultStatisticsUnescape(CMUIX_ProfileConfigValue(lp_payload, ("n" + IntToString(lv_player))));
        CMUIX_ResultPlayerCommander[lv_player] = CMUIX_ProfileConfigValue(lp_payload, ("c" + IntToString(lv_player)));
        CMUIX_ResultPlayerPrestige[lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("r" + IntToString(lv_player))));
        if ((lv_statCount <= 0)) {
            CMUIX_ResultStatValues[1][lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("k" + IntToString(lv_player))));
        }
        else {
            lv_index = 1;
            while ((lv_index <= lv_statCount)) {
                lv_key = ("p" + IntToString(lv_player) + "s" + IntToString(lv_index));
                CMUIX_ResultStatValues[lv_index][lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, lv_key));
                lv_index += 1;
            }
        }

        CMUIX_ResultDamageTotal[lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("t" + IntToString(lv_player))));
        CMUIX_ResultDamageUnitCount[lv_player] = CMUIX_ClampInt(StringToInt(CMUIX_ProfileConfigValue(lp_payload, ("dn" + IntToString(lv_player)))), 0, CMUIX_RESULT_CHART_TOP_UNITS);
        lv_mastery = 1;
        while ((lv_mastery <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            lv_key = ("p" + IntToString(lv_player) + "m" + IntToString(lv_mastery));
            CMUIX_ResultPlayerMasteryId[lv_mastery][lv_player] = CMUIX_ProfileConfigValue(lp_payload, lv_key);
            CMUIX_ResultPlayerMasteryValue[lv_mastery][lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, (lv_key + "v")));
            lv_mastery += 1;
        }

        lv_index = 1;
        while ((lv_index <= CMUIX_ResultDamageUnitCount[lv_player])) {
            lv_key = ("p" + IntToString(lv_player) + "u" + IntToString(lv_index));
            CMUIX_ResultDamageUnitTypes[lv_index][lv_player] = CMUIX_ProfileConfigValue(lp_payload, lv_key);
            CMUIX_ResultDamageUnitValues[lv_index][lv_player] = StringToInt(CMUIX_ProfileConfigValue(lp_payload, (lv_key + "v")));
            lv_index += 1;
        }

        lv_player += 1;
    }

    return true;
}

void CMUIX_ResultRecordOutcome() {
    if ((CMUIX_ResultValue == c_gameOverVictory)) {
        CMUIX_GameHistoryRecordVictory();
        return;
    }

    CMUIX_GameHistoryRecordDefeat();
}

void CMUIX_ResultPrepareWorld() {
    int lv_allySupply;

    lv_allySupply = c_invalidDialogControlId;
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    UISetWorldVisible(PlayerGroupAll(), false);
    libCOOC_gf_MuteUnmuteAllSoundChannelsExcept(true, c_soundCategoryUI, PlayerGroupAll());
    GameSetMissionTimePaused(true);
    UnitPauseAll(true);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    TriggerEnable(libCOTF_gt_UT_Graph_Timer, false);
    libCOTF_gf_UT_Graph_HideAllGraphsExcept(0, 1);
    libCOTF_gf_UT_Graph_HideAllGraphsExcept(0, 2);
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/AllySupplyPanel");
    lv_allySupply = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(lv_allySupply) == true)) {
        DialogControlSetVisible(lv_allySupply, PlayerGroupAll(), false);
    }
}

void CMUIX_ResultResetHookState() {
    int lv_index;
    int lv_player;
    int lv_mastery;
    int lv_context;

    lv_index = 0;
    lv_player = 0;
    lv_mastery = 0;
    lv_context = 0;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ResultDamageChartPanels[lv_player] = c_invalidDialogControlId;
        CMUIX_ResultHistoryViewActive[lv_player] = false;
        lv_index = 0;
        while ((lv_index <= CMUIX_RESULT_PLAYER_DISPLAY_MAX)) {
            CMUIX_ResultHistoryPlayerPresent[lv_player][lv_index] = false;
            lv_index += 1;
        }

        CMUIX_ResultStatsPlayerFrames[lv_player] = c_invalidDialogControlId;
        CMUIX_ResultStatsPlayerNameLabels[lv_player] = c_invalidDialogControlId;
