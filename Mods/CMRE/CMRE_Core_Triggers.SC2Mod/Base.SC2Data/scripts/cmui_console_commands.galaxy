// Source: Base.SC2Data/LibCOTF.galaxy :: libCOTF_gt_AF_SlimUI_Func
bool CMUIX_Console_libCOTF_gt_AF_SlimUI_Func(int lp_player, string lp_message, bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libCOTF_gf_RT_UserPermissionStatus(libCOTF_ge_RT_UserTypes_VISU, lp_player) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((GameIsMissionTimePaused() == true)) {
        if ((PlayerGroupHasPlayer(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player) == false)) {
            PlayerGroupAdd(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player);
            TriggerEnable(libCOTF_gt_AF_SlimUI_Delayed, true);
        }
        else {
            PlayerGroupRemove(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player);
            TriggerEnable(libCOTF_gt_AF_SlimUI_Delayed, false);
        }
    }
    else {
        if ((GameGetMissionTime() < 5.0)) {
            PlayerGroupAdd(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player);
            TriggerExecute(libCOTF_gt_AF_SlimUI_Delayed, true, false);
        }
        else {
            DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsoleUIContainer");
            if ((PlayerGroupHasPlayer(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player) == false)) {
                PlayerGroupAdd(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player);
                UISetFrameVisible(PlayerGroupSingle(lp_player), c_syncFrameTypeConsolePanel, false);
                DialogControlSendAnimationEvent(DialogControlLastCreated(), PlayerGroupSingle(lp_player), "SlimUI_On");
            }
            else {
                PlayerGroupRemove(libCOTF_gv_aF_SlimUI_PlayerGroup, lp_player);
                UISetFrameVisible(PlayerGroupSingle(lp_player), c_syncFrameTypeConsolePanel, true);
                DialogControlSendAnimationEvent(DialogControlLastCreated(), PlayerGroupSingle(lp_player), "SlimUI_Off");
            }
        }
    }
    return true;
}

