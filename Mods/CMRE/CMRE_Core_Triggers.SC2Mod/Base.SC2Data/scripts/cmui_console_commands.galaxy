// Source: Base.SC2Data/LibCOUI.galaxy :: libCOUI_gt_CU_SelectCommanderForAlly_Func
bool CMUIX_Console_libCOUI_gt_CU_SelectCommanderForAlly_Func(int lp_player, string lp_message, bool testConds, bool runActions) {
    int lv_selection;
    int lv_count;
    string lv_commander;

    lv_selection = StringToInt(StringWord(lp_message, 2));
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_commander = "";
    // Conditions
    if ((testConds == true)) {
        if ((StringWord(lp_message, 2) == "")) {
            return false;
        }

        if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
            return false;
        }

        if ((PlayerType(2) == c_playerTypeUser)) {
            return false;
        }

        if ((lv_selection < 1) || (lv_selection > lv_count)) {
            return false;
        }

        lv_commander = UserDataInstance("PlayerCommanders", lv_selection);
        if ((lv_commander == "") || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
            return false;
        }
    }

    // Actions
    if ((runActions == false)) {
        return true;
    }

    CMUIX_SetCommanderSelectionForPlayer(2, lv_selection);
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_RefreshCommanderSelectionVisualsAll();
    CMUIX_CustomizationOnCommanderSelectedForTarget(lp_player, 2, lv_selection);
    CMUIX_CustomizationRefreshCurrentSelections();
    return true;
}

