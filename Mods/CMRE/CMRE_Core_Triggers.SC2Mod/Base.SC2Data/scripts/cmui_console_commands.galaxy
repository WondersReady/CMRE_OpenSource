fixed CMUIX_ConsoleDefaultCameraValue(int lp_cameraValue) {
    if ((lp_cameraValue == c_cameraValueYaw)) {
        return 90.0;
    }
    if ((lp_cameraValue == c_cameraValuePitch)) {
        return 56.0;
    }
    if ((lp_cameraValue == c_cameraValueDistance)) {
        return 31.0;
    }
    if ((lp_cameraValue == c_cameraValueDepthOfField)) {
        return 0.0;
    }
    if ((lp_cameraValue == c_cameraValueRoll)) {
        return 0.0;
    }
    if ((lp_cameraValue == c_cameraValueFieldOfView)) {
        return 27.0;
    }

    return 0.0;
}

