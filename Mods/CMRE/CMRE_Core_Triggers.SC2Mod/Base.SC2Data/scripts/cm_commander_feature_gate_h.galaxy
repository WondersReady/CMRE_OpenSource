// Public declarations for per-player commander feature gates.

string CMCT_FeaturePlayerKey(string lp_feature, int lp_player);
string CMCT_FeatureCountKey(string lp_feature);
string CMCT_FeatureTriggerKey(string lp_feature);
string CMCT_FeatureTriggerSlotKey(string lp_feature, int lp_slot);

bool CMCT_FeatureValid(string lp_feature);
bool CMCT_PlayerValid(int lp_player);
bool CMCT_FeaturePlayerValid(string lp_feature, int lp_player);
int CMCT_FeatureTriggerSlotValid(int lp_slot);

int CMCT_FeatureActiveCount(string lp_feature);
bool CMCT_FeatureTriggerRegistered(string lp_feature);
trigger CMCT_FeatureTrigger(string lp_feature);
trigger CMCT_FeatureTriggerAt(string lp_feature, int lp_slot);
string CMCT_FeatureForTrigger(trigger lp_trigger);
int CMCT_FeatureSlotForTrigger(trigger lp_trigger);
