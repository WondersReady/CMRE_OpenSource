int CMPE_PlayerEventType(string lp_eventType) {
    if ((lp_eventType == null)) {
        return 0;
    }

    if ((lp_eventType == "")) {
        return 0;
    }

    if ((lp_eventType == CMPE_EventCommanderTechBefore()) || (lp_eventType == "CommanderTechBefore") || (lp_eventType == "CommanderTech.Before")) {
        return CMPE_PLAYER_EVENT_COMMANDER_TECH_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderTech()) || (lp_eventType == "CommanderTech") || (lp_eventType == "CommanderTech.Main")) {
        return CMPE_PLAYER_EVENT_COMMANDER_TECH;
    }

    if ((lp_eventType == CMPE_EventCommanderTechAfter()) || (lp_eventType == "CommanderTechAfter") || (lp_eventType == "CommanderTech.After")) {
        return CMPE_PLAYER_EVENT_COMMANDER_TECH_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderInitialBefore()) || (lp_eventType == "CommanderInitialBefore") || (lp_eventType == "Event_CTI_Before") || (lp_eventType == "CTI.Before")) {
        return CMPE_PLAYER_EVENT_CTI_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderInitial()) || (lp_eventType == "CommanderInitial") || (lp_eventType == "Event_CTI") || (lp_eventType == "CTI")) {
        return CMPE_PLAYER_EVENT_CTI;
    }

    if ((lp_eventType == CMPE_EventCommanderInitialAfter()) || (lp_eventType == "CommanderInitialAfter") || (lp_eventType == "Event_CTI_After") || (lp_eventType == "CTI.After")) {
        return CMPE_PLAYER_EVENT_CTI_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderPrestigeBefore()) || (lp_eventType == "CommanderPrestigeBefore") || (lp_eventType == "Event_CTP_Before") || (lp_eventType == "CTP.Before")) {
        return CMPE_PLAYER_EVENT_CTP_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderPrestige()) || (lp_eventType == "CommanderPrestige") || (lp_eventType == "Event_CTP") || (lp_eventType == "CTP")) {
        return CMPE_PLAYER_EVENT_CTP;
    }

    if ((lp_eventType == CMPE_EventCommanderPrestigeAfter()) || (lp_eventType == "CommanderPrestigeAfter") || (lp_eventType == "Event_CTP_After") || (lp_eventType == "CTP.After")) {
        return CMPE_PLAYER_EVENT_CTP_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderGlobalPowerUIBefore()) || (lp_eventType == "CommanderGlobalPowerUIBefore") || (lp_eventType == "GlobalPowerUIBefore") || (lp_eventType == "Event_GPTUI_Before") || (lp_eventType == "GPTUI.Before")) {
        return CMPE_PLAYER_EVENT_GPTUI_BEFORE;
