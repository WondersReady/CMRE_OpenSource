// CM pointer event registry.
// Stores cross-library function references for commander and enemy-AI lifecycle dispatch.

include "scripts/cm_pointer_events_h"

const int CMPE_SLOT_MAX = 128;
const int CMPE_PLAYER_EVENT_MAX = 32;
const int CMPE_COMPONENT_MAX = 6;

const int CMPE_COMPONENT_COMMANDER = 1;
const int CMPE_COMPONENT_AI_COMMANDER = 2;
const int CMPE_COMPONENT_HERO = 3;
const int CMPE_COMPONENT_HERO_STRUCTURE = 4;
const int CMPE_COMPONENT_GLOBAL_POWER = 5;
const int CMPE_COMPONENT_PRESTIGE = 6;

const int CMPE_PLAYER_EVENT_COMMANDER_TECH_BEFORE = 1;
const int CMPE_PLAYER_EVENT_COMMANDER_TECH = 2;
const int CMPE_PLAYER_EVENT_COMMANDER_TECH_AFTER = 3;
const int CMPE_PLAYER_EVENT_CTI_BEFORE = 4;
const int CMPE_PLAYER_EVENT_CTI = 5;
const int CMPE_PLAYER_EVENT_CTI_AFTER = 6;
const int CMPE_PLAYER_EVENT_CTP_BEFORE = 7;
const int CMPE_PLAYER_EVENT_CTP = 8;
const int CMPE_PLAYER_EVENT_CTP_AFTER = 9;
const int CMPE_PLAYER_EVENT_GPTUI_BEFORE = 10;
const int CMPE_PLAYER_EVENT_GPTUI = 11;
const int CMPE_PLAYER_EVENT_GPTUI_AFTER = 12;
const int CMPE_PLAYER_EVENT_AITI_BEFORE = 13;
const int CMPE_PLAYER_EVENT_AITI = 14;
const int CMPE_PLAYER_EVENT_AITI_AFTER = 15;
const int CMPE_PLAYER_EVENT_COMMANDER_MASTERY_BEFORE = 16;
const int CMPE_PLAYER_EVENT_COMMANDER_MASTERY = 17;
const int CMPE_PLAYER_EVENT_COMMANDER_MASTERY_AFTER = 18;
const int CMPE_PLAYER_EVENT_HTAS_BEFORE = 19;
const int CMPE_PLAYER_EVENT_HTAS = 20;
const int CMPE_PLAYER_EVENT_HTAS_AFTER = 21;
const int CMPE_PLAYER_EVENT_HTAD = 22;
const int CMPE_PLAYER_EVENT_HERO_DEATH_AFTER = 23;
const int CMPE_PLAYER_EVENT_HERO_FIRST_BORN_AFTER = 24;
const int CMPE_PLAYER_EVENT_HSTAS_BEFORE = 25;
const int CMPE_PLAYER_EVENT_HSTAS = 26;
const int CMPE_PLAYER_EVENT_HSTAS_AFTER = 27;
const int CMPE_PLAYER_EVENT_HERO_STRUCTURE_FIRST_BORN_AFTER = 28;
const int CMPE_PLAYER_EVENT_GPTAS_BEFORE = 29;
const int CMPE_PLAYER_EVENT_GPTAS = 30;
const int CMPE_PLAYER_EVENT_GPTAS_AFTER = 31;
const int CMPE_PLAYER_EVENT_HERO_REVIVE_AFTER = 32;

bool CMPE_Initialized = false;
CMPE_PlayerEventFunc[7][33][129] CMPE_EventSlots;
bool[7][33][129] CMPE_EventSlotHasHandler;
bool CMPE_EventRegistryHasHandler = false;

void CMPE_PlayerEvent_Empty(int lp_player) {
}

int CMPE_ValidSlot(int lp_slot) {
    if ((lp_slot < 1)) {
        return 0;
    }

    if ((lp_slot > CMPE_SLOT_MAX)) {
        return 0;
    }

    return lp_slot;
}

int CMPE_ValidComponent(int lp_component) {
    if ((lp_component < 1)) {
        return 0;
    }

    if ((lp_component > CMPE_COMPONENT_MAX)) {
        return 0;
    }

    return lp_component;
}

int CMPE_ValidPlayerEventType(int lp_eventType) {
    if ((lp_eventType < 1)) {
        return 0;
    }

    if ((lp_eventType > CMPE_PLAYER_EVENT_MAX)) {
        return 0;
    }

    return lp_eventType;
}

void CMPE_Reset() {
    int lv_component;
    int lv_eventType;
    int lv_slot;

    lv_component = 0;
    while ((lv_component <= CMPE_COMPONENT_MAX)) {
        lv_eventType = 0;
        while ((lv_eventType <= CMPE_PLAYER_EVENT_MAX)) {
            lv_slot = 0;
            while ((lv_slot <= CMPE_SLOT_MAX)) {
                CMPE_EventSlots[lv_component][lv_eventType][lv_slot] = CMPE_PlayerEvent_Empty;
                CMPE_EventSlotHasHandler[lv_component][lv_eventType][lv_slot] = false;
                lv_slot = lv_slot + 1;
            }

            lv_eventType = lv_eventType + 1;
        }

        lv_component = lv_component + 1;
    }

    CMPE_EventRegistryHasHandler = false;
    CMPE_Initialized = true;
}

void CMPE_Init() {
    if ((CMPE_Initialized == true)) {
        return;
    }

    CMPE_Reset();
}

CMPE_PlayerEventFunc CMPE_NormalizePlayerFunc(CMPE_PlayerEventFunc lp_func) {
    if ((lp_func == null)) {
        return CMPE_PlayerEvent_Empty;
    }

    return lp_func;
}

void CMPE_RegisterEventSlot(int lp_component, int lp_eventType, int lp_slot, CMPE_PlayerEventFunc lp_func) {
    int lv_component;
    int lv_eventType;
    int lv_slot;

    CMPE_Init();
    lv_component = CMPE_ValidComponent(lp_component);
    lv_eventType = CMPE_ValidPlayerEventType(lp_eventType);
    lv_slot = CMPE_ValidSlot(lp_slot);
    if ((lv_component == 0) || (lv_eventType == 0) || (lv_slot == 0)) {
        return;
    }

    CMPE_EventSlots[lv_component][lv_eventType][lv_slot] = CMPE_NormalizePlayerFunc(lp_func);
    if ((lp_func == null)) {
        CMPE_EventSlotHasHandler[lv_component][lv_eventType][lv_slot] = false;
        return;
    }

    CMPE_EventSlotHasHandler[lv_component][lv_eventType][lv_slot] = true;
    CMPE_EventRegistryHasHandler = true;
}

void CMPE_RunEventSlot(int lp_component, int lp_eventType, int lp_slot, int lp_player) {
    int lv_component;
    int lv_eventType;
    int lv_slot;
    CMPE_PlayerEventFunc lv_func;

    CMPE_Init();
    lv_component = CMPE_ValidComponent(lp_component);
    lv_eventType = CMPE_ValidPlayerEventType(lp_eventType);
    lv_slot = CMPE_ValidSlot(lp_slot);
    if ((lv_component == 0) || (lv_eventType == 0) || (lv_slot == 0)) {
        CMPE_PlayerEvent_Empty(lp_player);
        return;
    }

    lv_func = CMPE_EventSlots[lv_component][lv_eventType][lv_slot];
    lv_func(lp_player);
}

void CMPE_RegisterPlayerEventSlot(int lp_eventType, int lp_slot, CMPE_PlayerEventFunc lp_func) {
    CMPE_RegisterEventSlot(CMPE_COMPONENT_COMMANDER, lp_eventType, lp_slot, lp_func);
}

void CMPE_RunPlayerEventSlot(int lp_eventType, int lp_slot, int lp_player) {
    CMPE_RunEventSlot(CMPE_COMPONENT_COMMANDER, lp_eventType, lp_slot, lp_player);
}

