    if ((lp_eventType == CMPE_EventCommanderMasteryBefore()) || (lp_eventType == "CommanderMasteryBefore") || (lp_eventType == "CommanderMastery.Before") || (lp_eventType == "Mastery.Before")) {
        return CMPE_PLAYER_EVENT_COMMANDER_MASTERY_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderMastery()) || (lp_eventType == "CommanderMastery") || (lp_eventType == "CommanderMastery.Main") || (lp_eventType == "Mastery")) {
