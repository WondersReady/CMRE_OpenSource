    }

    if ((lp_eventType == CMPE_EventCommanderHeroDeathAfter()) || (lp_eventType == "CommanderHeroDeathAfter") || (lp_eventType == "HeroDeathAfter") || (lp_eventType == "Event_HTAD_After") || (lp_eventType == "HTAD.After")) {
        return CMPE_PLAYER_EVENT_HERO_DEATH_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroReviveAfter()) || (lp_eventType == "CommanderHeroReviveAfter") || (lp_eventType == "HeroReviveAfter") || (lp_eventType == "Hero.Revive.After")) {
        return CMPE_PLAYER_EVENT_HERO_REVIVE_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroFirstBornAfter()) || (lp_eventType == "CommanderHeroFirstBornAfter") || (lp_eventType == "HeroFirstBornAfter") || (lp_eventType == "HeroFirstReviveAfter") || (lp_eventType == "FirstBorn.After")) {
        return CMPE_PLAYER_EVENT_HERO_FIRST_BORN_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroStructureSpawnBefore()) || (lp_eventType == "CommanderHeroStructureSpawnBefore") || (lp_eventType == "HeroStructureSpawnBefore") || (lp_eventType == "Event_HSTAS_Before") || (lp_eventType == "HSTAS.Before")) {
        return CMPE_PLAYER_EVENT_HSTAS_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroStructureAfterSpawn()) || (lp_eventType == "CommanderHeroStructureAfterSpawn") || (lp_eventType == "HeroStructureAfterSpawn") || (lp_eventType == "HeroStructure.Spawn.AfterCreate") || (lp_eventType == "Event_HSTAS") || (lp_eventType == "HSTAS")) {
        return CMPE_PLAYER_EVENT_HSTAS;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroStructureSpawnAfter()) || (lp_eventType == "CommanderHeroStructureSpawnAfter") || (lp_eventType == "HeroStructureSpawnAfter") || (lp_eventType == "Event_HSTAS_After") || (lp_eventType == "HSTAS.After")) {
        return CMPE_PLAYER_EVENT_HSTAS_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderHeroStructureFirstBornAfter()) || (lp_eventType == "CommanderHeroStructureFirstBornAfter") || (lp_eventType == "HeroStructureFirstBornAfter") || (lp_eventType == "HeroStructureFirstReviveAfter") || (lp_eventType == "HSFirstBorn.After")) {
        return CMPE_PLAYER_EVENT_HERO_STRUCTURE_FIRST_BORN_AFTER;
    }

    if ((lp_eventType == CMPE_EventCommanderGlobalCasterSpawnBefore()) || (lp_eventType == "CommanderGlobalCasterSpawnBefore") || (lp_eventType == "GlobalCasterSpawnBefore") || (lp_eventType == "Event_GPTAS_Before") || (lp_eventType == "GPTAS.Before")) {
        return CMPE_PLAYER_EVENT_GPTAS_BEFORE;
    }

    if ((lp_eventType == CMPE_EventCommanderGlobalPowerAfterSpawn()) || (lp_eventType == "CommanderGlobalPowerAfterSpawn") || (lp_eventType == "GlobalPowerAfterSpawn") || (lp_eventType == "GlobalPower.Caster.AfterCreate") || (lp_eventType == "Event_GPTAS") || (lp_eventType == "GPTAS")) {
        return CMPE_PLAYER_EVENT_GPTAS;
    }

    if ((lp_eventType == CMPE_EventCommanderGlobalCasterSpawnAfter()) || (lp_eventType == "CommanderGlobalCasterSpawnAfter") || (lp_eventType == "GlobalCasterSpawnAfter") || (lp_eventType == "Event_GPTAS_After") || (lp_eventType == "GPTAS.After")) {
        return CMPE_PLAYER_EVENT_GPTAS_AFTER;
    }

    return 0;
}

int CMPE_PlayerCommanderSlot(string lp_commander) {
    int lv_index;
    int lv_slot;
    int lv_instanceCount;
    string lv_instance;

    if ((lp_commander == null)) {
        return 0;
    }

    if ((lp_commander == "")) {
        return 0;
    }

    lv_index = 1;
    lv_slot = 0;
    lv_instanceCount = UserDataInstanceCount("PlayerCommanders") + 1;
    while ((lv_index < lv_instanceCount)) {
        lv_instance = UserDataInstance("PlayerCommanders", lv_index);
        if ((lv_instance != "[Default]") && (lv_instance != "None")) {
            lv_slot = lv_slot + 1;
            if ((lv_instance == lp_commander)) {
                return CMPE_ValidSlot(lv_slot);
            }
        }

        lv_index = lv_index + 1;
    }

    return 0;
}

int CMPE_AICommanderSlot(string lp_commander) {
    if ((lp_commander == null)) {
        return 0;
    }

    if ((lp_commander == "")) {
        return 0;
    }

    return CMPE_ValidSlot(UserDataGetInt("CoopAICommanders", lp_commander, "UniqueIndex", 1));
}

int CMPE_UserDataSlot(string lp_userType, string lp_instance) {
    int lv_index;
    int lv_slot;
    int lv_instanceCount;
    string lv_instance;

    if ((lp_userType == null) || (lp_userType == "")) {
        return 0;
    }

    if ((lp_instance == null) || (lp_instance == "")) {
        return 0;
    }

    lv_index = 1;
    lv_slot = 0;
    lv_instanceCount = UserDataInstanceCount(lp_userType) + 1;
    while ((lv_index < lv_instanceCount)) {
        lv_instance = UserDataInstance(lp_userType, lv_index);
        if ((lv_instance != "[Default]") && (lv_instance != "None")) {
            lv_slot = lv_slot + 1;
            if ((lv_instance == lp_instance)) {
                return CMPE_ValidSlot(lv_slot);
            }
        }

        lv_index = lv_index + 1;
    }

    return 0;
}

int CMPE_HeroSlot(string lp_hero) {
    return CMPE_UserDataSlot("PlayerHeros", lp_hero);
}

int CMPE_HeroStructureSlot(string lp_heroStructure) {
    return CMPE_UserDataSlot("PlayerHeroStructures", lp_heroStructure);
}

int CMPE_GlobalPowerSlot(string lp_globalPower) {
    return CMPE_UserDataSlot("PlayerGlobalPowers", lp_globalPower);
}

int CMPE_PrestigeSlot(string lp_prestige) {
    return CMPE_UserDataSlot("PlayerPrestige", lp_prestige);
}

int CMPE_ComponentSlot(int lp_component, string lp_instance) {
    int lv_component;

    lv_component = CMPE_ValidComponent(lp_component);
    if ((lv_component == CMPE_COMPONENT_COMMANDER)) {
        return CMPE_PlayerCommanderSlot(lp_instance);
    }

    if ((lv_component == CMPE_COMPONENT_AI_COMMANDER)) {
        return CMPE_AICommanderSlot(lp_instance);
    }

    if ((lv_component == CMPE_COMPONENT_HERO)) {
        return CMPE_HeroSlot(lp_instance);
    }

    if ((lv_component == CMPE_COMPONENT_HERO_STRUCTURE)) {
        return CMPE_HeroStructureSlot(lp_instance);
    }

    if ((lv_component == CMPE_COMPONENT_GLOBAL_POWER)) {
        return CMPE_GlobalPowerSlot(lp_instance);
    }

    if ((lv_component == CMPE_COMPONENT_PRESTIGE)) {
        return CMPE_PrestigeSlot(lp_instance);
    }

    return 0;
}

string CMPE_ComponentInstanceForPlayer(int lp_component, int lp_player) {
    int lv_component;

    lv_component = CMPE_ValidComponent(lp_component);
    if ((lv_component == CMPE_COMPONENT_COMMANDER)) {
        return libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    }

    if ((lv_component == CMPE_COMPONENT_HERO)) {
        return libCOOC_gf_CC_PlayerHeroLinks(lp_player);
    }

    if ((lv_component == CMPE_COMPONENT_HERO_STRUCTURE)) {
        return libCOOC_gf_CC_PlayerHeroStructureLinks(lp_player);
    }

    if ((lv_component == CMPE_COMPONENT_GLOBAL_POWER)) {
        return libCOOC_gf_CC_PlayerGlobalPowerLinks(lp_player);
    }

    if ((lv_component == CMPE_COMPONENT_PRESTIGE)) {
        return libCOOC_gf_CC_PlayerActivePrestigeInstance(lp_player);
    }

    return null;
}

void CMPE_RegisterComponentEvent(int lp_component, string lp_eventType, string lp_instance, CMPE_PlayerEventFunc lp_func) {
    CMPE_RegisterEventSlot(lp_component, CMPE_PlayerEventType(lp_eventType), CMPE_ComponentSlot(lp_component, lp_instance), lp_func);
}

void CMPE_InvokeComponentEvent(int lp_component, string lp_eventType, string lp_instance, int lp_player) {
    CMPE_RunEventSlot(lp_component, CMPE_PlayerEventType(lp_eventType), CMPE_ComponentSlot(lp_component, lp_instance), lp_player);
}

void CMPE_InvokePlayerComponentEvent(int lp_component, string lp_eventType, int lp_player) {
    CMPE_InvokeComponentEvent(lp_component, lp_eventType, CMPE_ComponentInstanceForPlayer(lp_component, lp_player), lp_player);
}

bool CMPE_EventRegistryHasAnyHandler() {
    CMPE_Init();
    return CMPE_EventRegistryHasHandler;
}

bool CMPE_ComponentEventHasHandler(int lp_component, string lp_eventType, string lp_instance) {
    int lv_component;
    int lv_eventType;
    int lv_slot;

    CMPE_Init();
    lv_component = CMPE_ValidComponent(lp_component);
    lv_eventType = CMPE_PlayerEventType(lp_eventType);
    lv_slot = CMPE_ComponentSlot(lp_component, lp_instance);
    if ((lv_component == 0) || (lv_eventType == 0) || (lv_slot == 0)) {
        return false;
    }

    return CMPE_EventSlotHasHandler[lv_component][lv_eventType][lv_slot];
}

bool CMPE_CommanderEventHasHandler(string lp_commander, string lp_eventType) {
    return CMPE_ComponentEventHasHandler(CMPE_COMPONENT_COMMANDER, lp_eventType, lp_commander);
}

