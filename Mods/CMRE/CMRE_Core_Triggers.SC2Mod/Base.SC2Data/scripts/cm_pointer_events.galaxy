    if ((lp_eventType == CMPE_EventCommanderHeroSpawnBefore()) || (lp_eventType == "CommanderHeroSpawnBefore") || (lp_eventType == "HeroSpawnBefore") || (lp_eventType == "Event_HTAS_Before") || (lp_eventType == "HTAS.Before")) {
