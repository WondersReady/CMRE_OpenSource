    }

    if ((lp_eventType == CMPE_EventCommanderHeroDeathToggle()) || (lp_eventType == "CommanderHeroDeathToggle") || (lp_eventType == "HeroDeathToggle") || (lp_eventType == "Event_HTAD") || (lp_eventType == "HTAD")) {
