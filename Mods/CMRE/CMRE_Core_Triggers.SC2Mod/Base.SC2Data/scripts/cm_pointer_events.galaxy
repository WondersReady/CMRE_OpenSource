    }

    if ((lp_eventType == CMPE_EventCommanderGlobalPowerUIAfter()) || (lp_eventType == "CommanderGlobalPowerUIAfter") || (lp_eventType == "GlobalPowerUIAfter") || (lp_eventType == "Event_GPTUI_After") || (lp_eventType == "GPTUI.After")) {
        return CMPE_PLAYER_EVENT_GPTUI_AFTER;
    }

    if ((lp_eventType == CMPE_EventAIInitialBefore()) || (lp_eventType == "AIInitialBefore") || (lp_eventType == "Event_AITI_Before") || (lp_eventType == "AITI.Before")) {
        return CMPE_PLAYER_EVENT_AITI_BEFORE;
    }

    if ((lp_eventType == CMPE_EventAIInitial()) || (lp_eventType == "AIInitial") || (lp_eventType == "Event_AITI") || (lp_eventType == "AITI")) {
