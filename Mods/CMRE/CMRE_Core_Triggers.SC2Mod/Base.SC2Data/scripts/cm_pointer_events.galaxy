    }

    if ((lp_eventType == CMPE_EventCommanderHeroSpawnAfter()) || (lp_eventType == "CommanderHeroSpawnAfter") || (lp_eventType == "HeroSpawnAfter") || (lp_eventType == "Event_HTAS_After") || (lp_eventType == "HTAS.After")) {
