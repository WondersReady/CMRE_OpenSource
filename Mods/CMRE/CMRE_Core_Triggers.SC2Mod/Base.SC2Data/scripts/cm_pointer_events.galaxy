    if ((lp_eventType == CMPE_EventCommanderGlobalPowerUI()) || (lp_eventType == "CommanderGlobalPowerUI") || (lp_eventType == "GlobalPowerUI") || (lp_eventType == "Event_GPTUI") || (lp_eventType == "GPTUI")) {
