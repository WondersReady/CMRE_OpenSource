    lv_category = 0;
    while ((lv_category <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        CMUIX_MasteryCategoryLabels[lv_category] = c_invalidDialogControlId;
        CMUIX_DetailsStatusMasteryGroups[lv_category] = c_invalidDialogControlId;
        CMUIX_AllianceStatusMasteryGroups[lv_category] = c_invalidDialogControlId;
        lv_category += 1;
    }

    lv_player = 0;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_MutatorInfoPageIndexByPlayer[lv_player] = 1;
        CMUIX_TargetPlayer[lv_player] = 0;
        CMUIX_TargetAllianceMode[lv_player] = false;
        CMUIX_AllianceStateExpanded[lv_player] = false;
        CMUIX_AllianceCommanderSelectionEnabled[lv_player] = false;
        CMUIX_TargetCommander[lv_player] = "";
        CMUIX_MasteryShiftPressed[lv_player] = false;
        CMUIX_MasteryLevelDraft[lv_player] = 0;
        CMUIX_PrestigeSelected[lv_player] = 0;
        CMUIX_PersonalizationVoicePackCount[lv_player] = 0;
        CMUIX_PersonalizationOptimizationCount[lv_player] = 0;
        CMUIX_PersonalizationOptimizationMasterDraft[lv_player] = false;
        CMUIX_VoicePackTemporaryActive[lv_player] = false;
        CMUIX_VoicePackTemporaryCommander[lv_player] = "";
        CMUIX_VoicePackTemporaryValue[lv_player] = "";
        CMUIX_OptimizationTemporaryActive[lv_player] = false;
        CMUIX_OptimizationTemporaryMasterEnabled[lv_player] = false;
        CMUIX_OptimizationTemporaryCount[lv_player] = 0;
        lv_itemIndex = 0;
        while ((lv_itemIndex <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
            CMUIX_PersonalizationOptimizationIds[lv_player][lv_itemIndex] = "";
            CMUIX_PersonalizationOptimizationDrafts[lv_player][lv_itemIndex] = false;
            CMUIX_OptimizationTemporaryIds[lv_player][lv_itemIndex] = "";
            CMUIX_OptimizationTemporaryValues[lv_player][lv_itemIndex] = false;
            lv_itemIndex += 1;
        }

        CMUIX_CustomizationClearDraft(lv_player);
        lv_player += 1;
    }
}

void CMUIX_CustomizationHookupMastery() {
    int lv_index;

    lv_index = 1;
    if ((CMUIX_IsControlValid(CMUIX_MasteryPanel) == false)) {
        return;
    }

    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        DialogControlHookup(CMUIX_MasteryPanel, c_triggerControlTypePanel, ("TalentFrame" + IntToString((lv_index - 1))));
        CMUIX_MasteryItemPanels[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeLabel, "NameLabel");
        CMUIX_MasteryNameLabels[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeLabel, "ValueLabel");
        CMUIX_MasteryValueLabels[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeLabel, "RankLabel");
        CMUIX_MasteryRankLabels[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeButton, "IncrementButton");
        CMUIX_MasteryPlusButtons[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeButton, "DecrementButton");
        CMUIX_MasteryMinusButtons[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypeLabel, "UnavailableLabel");
        CMUIX_MasteryUnavailableLabels[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MasteryItemPanels[lv_index], c_triggerControlTypePanel, "TooltipAnchorFrame");
        CMUIX_MasteryTooltipAnchors[lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        DialogControlHookup(CMUIX_MasteryPanel, c_triggerControlTypeLabel, ("RemainingRankLabel" + IntToString((lv_index - 1))));
        CMUIX_MasteryCategoryLabels[lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }

    DialogControlHookup(CMUIX_MasteryPanel, c_triggerControlTypeButton, "AcceptButton");
    CMUIX_MasteryAcceptButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MasteryPanel, c_triggerControlTypeButton, "CancelButton");
    CMUIX_MasteryCancelButton = DialogControlLastCreated();
}

void CMUIX_CustomizationHookupPrestige() {
    int lv_index;

    lv_index = 0;
    if ((CMUIX_IsControlValid(CMUIX_PrestigePanel) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_PrestigePanel, c_triggerControlTypePanel, "CommanderPrestigeTileList");
    CMUIX_PrestigeTileList = DialogControlLastCreated();
    DialogControlHookup(CMUIX_PrestigeTileList, c_triggerControlTypePanel, "ContainerFrame");
    CMUIX_PrestigeContainerFrame = DialogControlLastCreated();
    while ((lv_index <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
        DialogControlHookup(CMUIX_PrestigeContainerFrame, c_triggerControlTypeButton, ("Item" + IntToString(lv_index)));
        CMUIX_PrestigeItems[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_PrestigeItems[lv_index], c_triggerControlTypeLabel, "PrestigeTitleLabel");
        CMUIX_PrestigeLabels[lv_index] = DialogControlLastCreated();
        if ((lv_index < CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
            DialogControlHookup(CMUIX_PrestigeContainerFrame, c_triggerControlTypeImage, ("Divider" + IntToString(lv_index)));
            CMUIX_PrestigeDividers[lv_index] = DialogControlLastCreated();
        }

        lv_index += 1;
    }
}

void CMUIX_CustomizationHookupPersonalization() {
    int lv_index;

    lv_index = 1;
    if ((CMUIX_IsControlValid(CMUIX_CustomizationPanel) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_CustomizationPanel, c_triggerControlTypePanel, "PersonalizationSelectionPanel");
    CMUIX_PersonalizationPanel = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(CMUIX_PersonalizationPanel) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_PersonalizationPanel, c_triggerControlTypePulldown, "AnnouncerSelector/Pulldown");
    CMUIX_PersonalizationAnnouncerPulldown = DialogControlLastCreated();
    DialogControlHookup(CMUIX_PersonalizationPanel, c_triggerControlTypeCheckBox, "OptimizationHeader/MasterCheckBox");
    CMUIX_PersonalizationOptimizationMasterCheckBox = DialogControlLastCreated();
    while ((lv_index <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        DialogControlHookup(CMUIX_PersonalizationPanel, c_triggerControlTypePanel, ("OptimizationScrollFrame/ContainerFrame/Item" + IntToString(lv_index)));
        CMUIX_PersonalizationOptimizationRows[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_PersonalizationOptimizationRows[lv_index], c_triggerControlTypeCheckBox, "CheckBox");
        CMUIX_PersonalizationOptimizationCheckBoxes[lv_index] = DialogControlLastCreated();
        DialogControlHookup(CMUIX_PersonalizationOptimizationRows[lv_index], c_triggerControlTypeLabel, "NameLabel");
        CMUIX_PersonalizationOptimizationNameLabels[lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }
}

void CMUIX_PersonalizationClearOptimizationRow(int lp_slot, playergroup lp_players) {
    if ((lp_slot < 1) || (lp_slot > CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        return;
    }

    CMUIX_SetControlVisible(CMUIX_PersonalizationOptimizationRows[lp_slot], lp_players, false);
    CMUIX_SetControlEnabled(CMUIX_PersonalizationOptimizationCheckBoxes[lp_slot], lp_players, false);
    CMUIX_SetControlText(CMUIX_PersonalizationOptimizationNameLabels[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationRows[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationCheckBoxes[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationNameLabels[lp_slot], lp_players, StringToText(""));
    if ((CMUIX_IsControlValid(CMUIX_PersonalizationOptimizationCheckBoxes[lp_slot]) == true)) {
        libNtve_gf_SetDialogItemChecked(CMUIX_PersonalizationOptimizationCheckBoxes[lp_slot], false, lp_players);
    }
}

void CMUIX_PersonalizationLoadOptimizationDrafts(int lp_operator, int lp_targetPlayer, string lp_commander) {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_optimization;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CMUIOptimizations");
    lv_slot = 1;
    lv_optimization = "";
    if ((lp_operator < 1) || (lp_operator > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_PersonalizationOptimizationMasterDraft[lp_operator] = CMUIX_OptimizationMasterEnabled(lp_targetPlayer);
    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot] = "";
        CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot] = false;
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_index <= lv_count) && (lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        lv_optimization = UserDataInstance("CMUIOptimizations", lv_index);
        if ((CMUIX_OptimizationIsListInstance(lv_optimization) == true) && (CMUIX_OptimizationShouldShowForCommander(lv_optimization, lp_commander) == true)) {
            CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot] = lv_optimization;
            CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot] = CMUIX_OptimizationRawEnabled(lp_targetPlayer, lp_commander, lv_optimization);
            if ((lv_optimization == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionForced(lp_commander) == true)) {
                CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot] = true;
            }
            lv_slot += 1;
        }

        lv_index += 1;
    }
}

void CMUIX_PersonalizationRefreshOptimizations(int lp_operator, int lp_targetPlayer, string lp_commander) {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_optimization;
    bool lv_masterEnabled;
    bool lv_canEdit;
    bool lv_forcedEnabled;
    playergroup lv_group;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CMUIOptimizations");
    lv_slot = 1;
    lv_optimization = "";
    lv_masterEnabled = CMUIX_PersonalizationOptimizationMasterDraft[lp_operator];
    lv_canEdit = CMUIX_ReadyCanEditData(lp_operator);
    lv_forcedEnabled = false;
    lv_group = PlayerGroupSingle(lp_operator);
    if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
        lv_masterEnabled = false;
        lv_canEdit = false;
    }

    if ((CMUIX_IsControlValid(CMUIX_PersonalizationOptimizationMasterCheckBox) == false)) {
        return;
    }

    libNtve_gf_SetDialogItemChecked(CMUIX_PersonalizationOptimizationMasterCheckBox, lv_masterEnabled, lv_group);
    CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationMasterCheckBox, lv_group, StringToText(""));
    CMUIX_ReadySetEnabledForPlayer(CMUIX_PersonalizationOptimizationMasterCheckBox, lp_operator, lv_canEdit);
    CMUIX_PersonalizationOptimizationCount[lp_operator] = 0;
    while ((lv_index <= lv_count) && (lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        lv_optimization = UserDataInstance("CMUIOptimizations", lv_index);
        if ((CMUIX_OptimizationIsListInstance(lv_optimization) == true) && (CMUIX_OptimizationShouldShowForCommander(lv_optimization, lp_commander) == true)) {
            CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot] = lv_optimization;
            lv_forcedEnabled = false;
            if ((lv_optimization == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionForced(lp_commander) == true)) {
                lv_forcedEnabled = true;
                CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot] = true;
            }
            CMUIX_SetControlVisible(CMUIX_PersonalizationOptimizationRows[lv_slot], lv_group, true);
            CMUIX_SetControlText(CMUIX_PersonalizationOptimizationNameLabels[lv_slot], lv_group, CMUIX_OptimizationName(lv_optimization));
            CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationRows[lv_slot], lv_group, StringToText(""));
            CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot], lv_group, StringToText(""));
            CMUIX_SetControlTooltip(CMUIX_PersonalizationOptimizationNameLabels[lv_slot], lv_group, CMUIX_OptimizationDescription(lv_optimization));
            libNtve_gf_SetDialogItemChecked(CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot], CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot], lv_group);
            CMUIX_ReadySetEnabledForPlayer(CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot], lp_operator, (lv_canEdit == true) && (lv_masterEnabled == true) && (lv_forcedEnabled == false));
            lv_slot += 1;
        }

        lv_index += 1;
    }

    CMUIX_PersonalizationOptimizationCount[lp_operator] = (lv_slot - 1);
    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot] = "";
        CMUIX_PersonalizationClearOptimizationRow(lv_slot, lv_group);
        lv_slot += 1;
    }
}

text CMUIX_PersonalizationDefaultVoicePackLabel(int lp_player, string lp_commander) {
    string lv_defaultVoicePack;

    lv_defaultVoicePack = "";
    if ((lp_commander != "") && (lp_commander != null)) {
        lv_defaultVoicePack = CMUIX_VoicePackDefaultForCommander(lp_commander);
    }

    if ((lv_defaultVoicePack == "") || (lv_defaultVoicePack == null)) {
        return StringExternal("CMUI/CommanderCustomizationSelectionPanel/AnnouncerDefault");
    }

    return (StringExternal("CMUI/CommanderCustomizationSelectionPanel/AnnouncerDefaultPrefix") + StringToText(" ") + CMUIX_VoicePackDisplayName(lv_defaultVoicePack, lp_player));
}

void CMUIX_PersonalizationRefresh(int lp_operator, int lp_targetPlayer, string lp_commander) {
    int lv_catalogIndex;
    int lv_catalogCount;
    int lv_optionIndex;
    int lv_selectedIndex;
    string lv_voicePack;
    string lv_selectedVoicePack;
    playergroup lv_group;

    lv_catalogIndex = 1;
    lv_catalogCount = CatalogEntryCount(c_gameCatalogVoicePack);
    lv_optionIndex = 1;
    lv_selectedIndex = 1;
    lv_voicePack = "";
    lv_selectedVoicePack = "";
    lv_group = PlayerGroupSingle(lp_operator);
    if ((CMUIX_IsControlValid(CMUIX_PersonalizationAnnouncerPulldown) == false)) {
        return;
    }

    CMUIX_PersonalizationRefreshing = true;
    DialogControlRemoveAllItems(CMUIX_PersonalizationAnnouncerPulldown, lv_group);
    CMUIX_PersonalizationVoicePackCount[lp_operator] = 1;
    CMUIX_PersonalizationVoicePacks[lp_operator][1] = "";
    DialogControlAddItem(CMUIX_PersonalizationAnnouncerPulldown, lv_group, CMUIX_PersonalizationDefaultVoicePackLabel(lp_operator, lp_commander));
    if ((lp_commander == "") || (lp_commander == null)) {
        DialogControlSelectItem(CMUIX_PersonalizationAnnouncerPulldown, lv_group, 1);
        CMUIX_SetControlEnabled(CMUIX_PersonalizationAnnouncerPulldown, lv_group, false);
        CMUIX_PersonalizationRefreshOptimizations(lp_operator, lp_targetPlayer, lp_commander);
        CMUIX_PersonalizationRefreshing = false;
        return;
    }

    lv_selectedVoicePack = CMUIX_VoicePackRuntimeForPlayerCommander(lp_targetPlayer, lp_commander);
    while ((lv_catalogIndex <= lv_catalogCount) && (lv_optionIndex < CMUIX_PERSONALIZATION_VOICEPACK_MAX)) {
        lv_voicePack = CatalogEntryGet(c_gameCatalogVoicePack, lv_catalogIndex);
        if ((CMUIX_VoicePackAllowedForPersonalization(lv_voicePack) == true)) {
            lv_optionIndex += 1;
            CMUIX_PersonalizationVoicePacks[lp_operator][lv_optionIndex] = lv_voicePack;
            DialogControlAddItem(CMUIX_PersonalizationAnnouncerPulldown, lv_group, CMUIX_VoicePackDisplayName(lv_voicePack, lp_operator));
            if ((lv_selectedVoicePack != "") && (lv_selectedVoicePack == lv_voicePack)) {
                lv_selectedIndex = lv_optionIndex;
            }
        }

        lv_catalogIndex += 1;
    }

    CMUIX_PersonalizationVoicePackCount[lp_operator] = lv_optionIndex;
    DialogControlSelectItem(CMUIX_PersonalizationAnnouncerPulldown, lv_group, lv_selectedIndex);
    CMUIX_SetControlEnabled(CMUIX_PersonalizationAnnouncerPulldown, lv_group, CMUIX_ReadyCanEditData(lp_operator));
    CMUIX_PersonalizationRefreshOptimizations(lp_operator, lp_targetPlayer, lp_commander);
    CMUIX_PersonalizationRefreshing = false;
}

bool CMUIX_PersonalizationCommitVoicePackSelection(int lp_operator, int lp_targetPlayer, string lp_commander) {
    int lv_selectedIndex;
    string lv_voicePack;

    lv_selectedIndex = 1;
    lv_voicePack = "";
    if ((lp_operator < 1) || (lp_operator > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_targetPlayer < 1) || (lp_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_PersonalizationAnnouncerPulldown) == false)) {
        return false;
    }

    lv_selectedIndex = DialogControlGetSelectedItem(CMUIX_PersonalizationAnnouncerPulldown, lp_operator);
    if ((lv_selectedIndex < 1) || (lv_selectedIndex > CMUIX_PersonalizationVoicePackCount[lp_operator])) {
        return false;
    }

    lv_voicePack = CMUIX_PersonalizationVoicePacks[lp_operator][lv_selectedIndex];
    if ((CMUIX_CustomizationShouldPersistToPlayerData() == true)) {
        CMUIX_VoicePackClearTemporaryForPlayer(lp_targetPlayer);
        CMUIX_VoicePackSetForPlayerCommander(lp_targetPlayer, lp_commander, lv_voicePack);
    }
    else {
        CMUIX_VoicePackSetTemporaryForPlayerCommander(lp_targetPlayer, lp_commander, lv_voicePack);
    }

    return true;
}

bool CMUIX_PersonalizationCommitOptimizations(int lp_operator, int lp_targetPlayer, string lp_commander) {
    int lv_slot;
    string lv_optimization;

    lv_slot = 1;
    lv_optimization = "";
    if ((lp_operator < 1) || (lp_operator > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_targetPlayer < 1) || (lp_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
        return false;
    }

    if ((CMUIX_CustomizationShouldPersistToPlayerData() == true)) {
        CMUIX_OptimizationClearTemporaryForPlayer(lp_targetPlayer);
        CMUIX_OptimizationSetMasterEnabled(lp_targetPlayer, CMUIX_PersonalizationOptimizationMasterDraft[lp_operator]);
        while ((lv_slot <= CMUIX_PersonalizationOptimizationCount[lp_operator])) {
            lv_optimization = CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot];
            if ((lv_optimization != "") && (lv_optimization != null)) {
                CMUIX_OptimizationSetRawEnabled(lp_targetPlayer, lp_commander, lv_optimization, CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot]);
            }

            lv_slot += 1;
        }
    }
    else {
        CMUIX_OptimizationSetTemporaryFromDrafts(lp_operator, lp_targetPlayer);
    }

    CMUIX_ApplyOptimizationStateForPlayer(lp_targetPlayer);
    return true;
}

bool CMUIX_PersonalizationHandleControlEvent(int lp_player, int lp_control) {
    int lv_targetPlayer;
    int lv_slot;
    int lv_eventType;
    string lv_commander;
    string lv_optimization;
    bool lv_checked;

    lv_targetPlayer = CMUIX_TargetForOperator(lp_player);
    lv_slot = 1;
    lv_eventType = EventDialogControlEventType();
    lv_commander = CMUIX_TargetCommander[lp_player];
    lv_optimization = "";
    lv_checked = false;

    if ((CMUIX_PersonalizationRefreshing == true)) {
        return true;
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return true;
    }

    if ((lp_control == CMUIX_PersonalizationOptimizationMasterCheckBox)) {
        if ((lv_eventType == c_triggerControlEventTypeClick)) {
            return true;
        }

        if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
            CMUIX_PersonalizationRefresh(lp_player, lv_targetPlayer, lv_commander);
            return true;
        }

        lv_checked = libNtve_gf_DialogItemIsChecked(lp_control, lp_player);
        CMUIX_PersonalizationOptimizationMasterDraft[lp_player] = lv_checked;
        CMUIX_PersonalizationRefreshing = true;
        CMUIX_PersonalizationRefreshOptimizations(lp_player, lv_targetPlayer, lv_commander);
        CMUIX_PersonalizationRefreshing = false;
        CMUIX_MapSelectionResetReadyStatus();
        return true;
    }

    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        if ((lp_control == CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot])) {
            if ((lv_eventType == c_triggerControlEventTypeClick)) {
                return true;
            }

            if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
                CMUIX_PersonalizationRefresh(lp_player, lv_targetPlayer, lv_commander);
                return true;
            }

            lv_optimization = CMUIX_PersonalizationOptimizationIds[lp_player][lv_slot];
            if ((lv_optimization != "") && (lv_optimization != null)) {
                if ((lv_optimization == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionForced(lv_commander) == true)) {
                    CMUIX_PersonalizationOptimizationDrafts[lp_player][lv_slot] = true;
                    CMUIX_PersonalizationRefresh(lp_player, lv_targetPlayer, lv_commander);
                    return true;
                }

                lv_checked = libNtve_gf_DialogItemIsChecked(lp_control, lp_player);
                CMUIX_PersonalizationOptimizationDrafts[lp_player][lv_slot] = lv_checked;
                CMUIX_MapSelectionResetReadyStatus();
            }

            return true;
        }

        lv_slot += 1;
    }

    if ((lp_control != CMUIX_PersonalizationAnnouncerPulldown)) {
        return false;
    }

    CMUIX_MapSelectionResetReadyStatus();
    return true;
}

void CMUIX_CustomizationHookupStatusRows(int lp_parent, bool lp_allianceMode) {
    int lv_groupIndex;
    int lv_rowIndex;
    int lv_itemIndex;
    string lv_basePath;

    lv_groupIndex = 0;
    lv_rowIndex = 0;
    lv_itemIndex = 0;
    lv_basePath = "";
    if ((CMUIX_IsControlValid(lp_parent) == false)) {
        return;
    }

    DialogControlHookup(lp_parent, c_triggerControlTypeLabel, "StatusContainer/HeaderLabel");
    if ((lp_allianceMode == true)) {
        CMUIX_AllianceStatusHeaderLabel = DialogControlLastCreated();
    }
    else {
        CMUIX_DetailsStatusHeaderLabel = DialogControlLastCreated();
    }

    DialogControlHookup(lp_parent, c_triggerControlTypePanel, "StatusContainer/TableHeader");
    if ((lp_allianceMode == true)) {
        CMUIX_AllianceStatusTableHeader = DialogControlLastCreated();
    }
    else {
        CMUIX_DetailsStatusTableHeader = DialogControlLastCreated();
    }

    DialogControlHookup(lp_parent, c_triggerControlTypePanel, "StatusContainer/StatusTableGrid");
    if ((lp_allianceMode == true)) {
        CMUIX_AllianceStatusTableGrid = DialogControlLastCreated();
    }
    else {
        CMUIX_DetailsStatusTableGrid = DialogControlLastCreated();
    }

    while ((lv_groupIndex < libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        lv_basePath = ("StatusContainer/MasteryGroup" + IntToString(lv_groupIndex));
        DialogControlHookup(lp_parent, c_triggerControlTypePanel, lv_basePath);
        if ((lp_allianceMode == true)) {
            CMUIX_AllianceStatusMasteryGroups[lv_groupIndex] = DialogControlLastCreated();
        }
        else {
            CMUIX_DetailsStatusMasteryGroups[lv_groupIndex] = DialogControlLastCreated();
        }

        lv_rowIndex = 0;
        while ((lv_rowIndex < 2)) {
            lv_itemIndex = ((lv_groupIndex * 2) + lv_rowIndex + 1);
            if ((lv_itemIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
                lv_basePath = ("StatusContainer/MasteryGroup" + IntToString(lv_groupIndex) + "/Row" + IntToString(lv_rowIndex));
                DialogControlHookup(lp_parent, c_triggerControlTypeLabel, (lv_basePath + "/NameLabel"));
                if ((lp_allianceMode == true)) {
                    CMUIX_AllianceStatusMasteryNameLabels[lv_itemIndex] = DialogControlLastCreated();
                }
                else {
                    CMUIX_DetailsStatusMasteryNameLabels[lv_itemIndex] = DialogControlLastCreated();
                }

                DialogControlHookup(lp_parent, c_triggerControlTypeLabel, (lv_basePath + "/ValueLabel"));
                if ((lp_allianceMode == true)) {
                    CMUIX_AllianceStatusMasteryValueLabels[lv_itemIndex] = DialogControlLastCreated();
                }
                else {
                    CMUIX_DetailsStatusMasteryValueLabels[lv_itemIndex] = DialogControlLastCreated();
                }
            }

            lv_rowIndex += 1;
        }

        lv_groupIndex += 1;
    }
}

