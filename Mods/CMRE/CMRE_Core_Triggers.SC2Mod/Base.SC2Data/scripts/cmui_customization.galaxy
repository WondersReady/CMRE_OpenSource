    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeButton, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeButtonLabel, lp_text, lp_players);
}

void CMUIX_MutatorChallengeRefreshButton() {
    CMUIX_MutatorChallengeEnsureSelection();
    CMUIX_MutatorChallengeSetButtonText(CMUIX_MutatorChallengeDisplayName(CMUIX_MutatorChallengeCurrentType, CMUIX_MutatorChallengeCurrentSelected()), PlayerGroupAll());
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_mutatorChallengeButton, true);
}

void CMUIX_MutatorChallengeRefreshDetails(int lp_player, string lp_challenge) {
    string lv_image;
    playergroup lv_playerGroup;

    lv_image = "";
    lv_playerGroup = PlayerGroupSingle(lp_player);
    if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeContainer) == false)) {
        return;
    }

    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeRandomImage, true, lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeImageFrame, false, lv_playerGroup);
        CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeDescriptionLabel, CMUIX_MutatorChallengeRandomDescription(), lv_playerGroup);
        CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyDescriptionLabel, CMUIX_EnemySelectionDescription(CMUIX_EnemySelectionDraft), lv_playerGroup);
        CMUIX_MutatorChallengeClearMutatorItems(lv_playerGroup);
        return;
    }

    lv_image = CMUIX_MutatorChallengeImagePath(CMUIX_MutatorChallengeCurrentType, lp_challenge);
    if ((lv_image == "")) {
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeRandomImage, true, lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeImageFrame, false, lv_playerGroup);
    }
    else {
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeRandomImage, false, lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeImageFrame, true, lv_playerGroup);
        libNtve_gf_SetDialogItemImage(libCMUI_gv_mutatorChallengeImage, lv_image, lv_playerGroup);
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeDescriptionLabel, CMUIX_MutatorChallengeDescription(CMUIX_MutatorChallengeCurrentType, lp_challenge), lv_playerGroup);
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyDescriptionLabel, CMUIX_EnemySelectionDescription(CMUIX_EnemySelectionDraft), lv_playerGroup);
    CMUIX_MutatorChallengeRefreshMutatorItems(lp_player, lp_challenge);
}

void CMUIX_MutatorChallengeClearList(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        libCMUI_gv_mutatorChallengeItemChallenges[lv_index] = "";
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeItems[lv_index], false, lp_players);
        if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeItems[lv_index], false, lp_players);
        }

        lv_index += 1;
    }
}

void CMUIX_MutatorChallengeSetListItem(int lp_index, string lp_challenge, playergroup lp_players) {
    text lv_name;
    string lv_draft;

    lv_name = CMUIX_MutatorChallengeDisplayName(CMUIX_MutatorChallengeCurrentType, lp_challenge);
    lv_draft = CMUIX_MutatorChallengeCurrentDraft();
    if ((lp_index < 0) || (lp_index >= libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        return;
    }

    libCMUI_gv_mutatorChallengeItemChallenges[lp_index] = lp_challenge;
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeItems[lp_index], StringToText(""), lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeItemLabels[lp_index], lv_name, lp_players);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeItems[lp_index], true, lp_players);
    if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeItems[lp_index]) == true)) {
        libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeItems[lp_index], (lp_challenge == lv_draft), lp_players);
    }
}

void CMUIX_MutatorChallengeRefreshList(int lp_player) {
    int lv_slot;
    int lv_typeIndex;
