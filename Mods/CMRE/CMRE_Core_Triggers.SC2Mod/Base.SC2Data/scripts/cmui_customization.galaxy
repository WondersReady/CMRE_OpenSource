    lv_enabled = false;
    if ((CMUIX_ConsoleCommandToggleStateKnown(lp_index) == true)) {
        lv_enabled = CMUIX_ConsoleCommandToggleStateEnabled(lp_index, lp_player);
    }

    CMUIX_ConsoleSetToggleButtonVisualState(lp_index, lv_enabled, PlayerGroupSingle(lp_player));
}

bool CMUIX_ConsoleArgumentTokenProvided(string lp_value) {
    return ((lp_value != null) && (lp_value != ""));
}

text CMUIX_ConsoleReplaceResultArgumentTokens(text lp_text, string lp_message) {
    text lv_result;
    string lv_arg1;
    string lv_arg2;
    string lv_arg3;

    lv_result = lp_text;
    lv_arg1 = StringWord(lp_message, 2);
    lv_arg2 = StringWord(lp_message, 3);
    lv_arg3 = StringWord(lp_message, 4);
    if ((CMUIX_ConsoleArgumentTokenProvided(lv_arg1) == true)) {
        lv_result = TextReplaceWord(lv_result, StringToText("X"), StringToText(lv_arg1), c_stringReplaceAll, c_stringCase);
    }

    if ((CMUIX_ConsoleArgumentTokenProvided(lv_arg2) == true)) {
        lv_result = TextReplaceWord(lv_result, StringToText("Y"), StringToText(lv_arg2), c_stringReplaceAll, c_stringCase);
    }

    if ((CMUIX_ConsoleArgumentTokenProvided(lv_arg3) == true)) {
        lv_result = TextReplaceWord(lv_result, StringToText("Z"), StringToText(lv_arg3), c_stringReplaceAll, c_stringCase);
    }

    return lv_result;
}

text CMUIX_ConsoleResultTextBase(int lp_player, int lp_index, string lp_message) {
    if ((lp_index == 3)) {
        if ((StringEqual(StringWord(lp_message, 1), "-groundbeh", c_stringNoCase) == true) || (StringEqual(StringWord(lp_message, 2), "ground", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandUserDataText(lp_index, "ResultGround", "CMUI/Console/Command/003/ResultGround");
        }

        return CMUIX_ConsoleCommandUserDataText(lp_index, "ResultAir", "CMUI/Console/Command/003/ResultAir");
    }

    if ((lp_index == 9) && (StringEqual(StringWord(lp_message, 2), "clear", c_stringNoCase) == true)) {
        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultReset");
    }

    if ((lp_index == 21)) {
        if ((StringEqual(StringWord(lp_message, 2), "reset", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandUserDataText(lp_index, "ResultReset", "CMUI/Console/Command/021/ResultReset");
        }

        if ((StringEqual(StringWord(lp_message, 2), "top", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandUserDataText(lp_index, "ResultTop", "CMUI/Console/Command/021/ResultTop");
        }

        return CMUIX_ConsoleCommandToggleResultText(lp_player, lp_index);
    }

    if ((lp_index == 27)) {
        if ((StringEqual(StringWord(lp_message, 2), "1", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOn");
        }

        if ((StringEqual(StringWord(lp_message, 2), "0", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOff");
        }
    }

    if ((lp_index == 38)) {
        if ((StringEqual(StringWord(lp_message, 2), "stop", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOff");
        }

        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOn");
    }

    if ((lp_index == 77)) {
        if ((StringEqual(StringWord(lp_message, 2), "clear", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultReset");
        }

        if ((StringEqual(StringWord(lp_message, 2), "stop", c_stringNoCase) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOff");
        }

        if ((DialogIsVisible(libCOTF_gv_uT_DL_LogDialog, lp_player) == true)) {
            return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOn");
        }

        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOff");
    }

    if ((lp_index == 80) && (StringEqual(StringWord(lp_message, 2), "clear", c_stringNoCase) == true)) {
        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultReset");
    }

    if ((lp_index == 150) && (StringEqual(StringWord(lp_message, 2), "clear", c_stringNoCase) == true)) {
        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultReset");
    }

    if ((CMUIX_ConsoleCommandToggleStateKnown(lp_index) == true)) {
        return CMUIX_ConsoleCommandToggleResultText(lp_player, lp_index);
    }

    return CMUIX_ConsoleCommandUserDataText(lp_index, "Result", CMUIX_ConsoleCommandResultKey(lp_index));
}

text CMUIX_ConsoleResultText(int lp_player, int lp_index, string lp_message) {
    return CMUIX_ConsoleReplaceResultArgumentTokens(CMUIX_ConsoleResultTextBase(lp_player, lp_index, lp_message), lp_message);
}

void CMUIX_ConsoleDisplayColoredLine(playergroup lp_players, text lp_message, string lp_color) {
    UIDisplayMessage(lp_players, c_messageAreaChat, CMUIX_ConsoleColorText(lp_message, lp_color));
}

void CMUIX_ConsoleDisplaySystemLine(int lp_player, text lp_message, bool lp_success) {
    string lv_color;

    lv_color = CMUIX_CONSOLE_COLOR_FAILURE;
    if ((lp_success == true)) {
        lv_color = CMUIX_CONSOLE_COLOR_SUCCESS;
    }

    CMUIX_ConsoleDisplayColoredLine(PlayerGroupSingle(lp_player), StringExternal("CMUI/Console/SystemPrefix") + lp_message, lv_color);
}

void CMUIX_ConsoleDisplayCommandNote(playergroup lp_players, int lp_index) {
    CMUIX_ConsoleDisplayColoredLine(lp_players, StringExternal("CMUI/Console/NotesPrefix") + CMUIX_ConsoleDescriptionText(lp_index), CMUIX_CONSOLE_COLOR_DESCRIPTION);
}

text CMUIX_ConsolePermissionRequirementText(int lp_permissionType) {
    if ((lp_permissionType == libCOTF_ge_RT_UserTypes_DEV)) {
        return StringExternal("CMUI/Console/Permission/Developer");
    }

    if ((lp_permissionType == libCOTF_ge_RT_UserTypes_TEST)) {
        return StringExternal("CMUI/Console/Permission/Test");
    }

    if ((lp_permissionType == libCOTF_ge_RT_UserTypes_COMMAND)) {
        return StringExternal("CMUI/Console/Permission/Command");
    }

    if ((lp_permissionType == libCOTF_ge_RT_UserTypes_VISU)) {
        return StringExternal("CMUI/Console/Permission/Visual");
    }

    return StringExternal("CMUI/Console/Permission/Unknown");
}

string CMUIX_ConsoleFailureReasonKey(int lp_player, int lp_index) {
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return "CMUI/Console/FailureInvalidCommand";
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return "CMUI/Console/FailureInvalidPlayer";
    }

    if ((CMUIX_ConsoleCommandOptionOnly(lp_index) == true)) {
        return "CMUI/Console/FailureOptionOnly";
    }

    if ((CMUIX_ConsoleCommandMapVisible(lp_index) == false)) {
        return "CMUI/Console/FailureWrongMap";
    }

    if ((CMUIX_AuthPermissionStatus(CMUIX_ConsoleCommandPermissionTypes[lp_index], lp_player) == false)) {
        return "CMUI/Console/FailurePermission";
    }

    if ((CMUIX_ConsoleDisplayOnlyCommands[lp_index] == true)) {
        return "CMUI/Console/FailureDisplayOnly";
    }

    return "CMUI/Console/FailurePrerequisite";
}

void CMUIX_ConsoleDisplayFailureWithReason(int lp_player, int lp_index, string lp_reasonKey) {
    text lv_reason;
    playergroup lv_players;

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_reason = StringExternal("CMUI/Console/Failure");
    lv_players = PlayerGroupSingle(lp_player);
    if ((lp_reasonKey == "")) {
        lp_reasonKey = CMUIX_ConsoleFailureReasonKey(lp_player, lp_index);
    }

    if ((lp_reasonKey == "CMUI/Console/FailurePermission") && (lp_index >= 1) && (lp_index <= CMUIX_ConsoleCommandCount)) {
        lv_reason = StringExternal("CMUI/Console/FailurePermission") + CMUIX_ConsolePermissionRequirementText(CMUIX_ConsoleCommandPermissionTypes[lp_index]);
    }
    else {
        lv_reason = StringExternal(lp_reasonKey);
    }

    CMUIX_ConsoleDisplayColoredLine(lv_players, StringExternal("CMUI/Console/SystemPrefix") + lv_reason, CMUIX_CONSOLE_COLOR_FAILURE);
    CMUIX_ConsoleDisplayCommandNote(lv_players, lp_index);
}

void CMUIX_ConsoleDisplayFailure(int lp_player, int lp_index) {
    CMUIX_ConsoleDisplayFailureWithReason(lp_player, lp_index, "");
}

void CMUIX_ConsoleDisplaySuccess(int lp_player, int lp_index, string lp_message) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_ConsoleDisplayColoredLine(lv_players, StringExternal("CMUI/Console/SystemPrefix") + CMUIX_ConsoleResultText(lp_player, lp_index, lp_message), CMUIX_CONSOLE_COLOR_SUCCESS);
}

void CMUIX_ConsoleDisplayShortcutFailure(int lp_player, string lp_reasonKey) {
    if ((lp_reasonKey == "")) {
        lp_reasonKey = "CMUI/Console/FailureShortcut";
    }

    CMUIX_ConsoleDisplaySystemLine(lp_player, StringExternal(lp_reasonKey), false);
}

bool CMUIX_ConsoleChatCommandHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_index;
    string lv_message;
    bool lv_result;

    lv_player = EventPlayer();
    lv_index = 0;
    lv_message = "";
    lv_result = false;
    if ((runActions == false)) {
        return true;
    }

    CMUIX_ConsoleCatalogInitialize();
    lv_message = EventChatMessage(false);
    lv_index = CMUIX_ConsoleCommandIndexForChatMessage(lv_message);
    if ((lv_index <= 0)) {
        return true;
    }

    if ((CMUIX_ConsoleCommandVisibleForPlayer(lv_index, lv_player) == false)) {
        CMUIX_ConsoleDisplayFailure(lv_player, lv_index);
        return true;
    }

    if ((CMUIX_ConsoleDisplayOnlyCommands[lv_index] == true)) {
        CMUIX_ConsoleDisplayFailureWithReason(lv_player, lv_index, "CMUI/Console/FailureDisplayOnly");
        return true;
    }

    lv_result = CMUIX_ConsoleCommandExecute(lv_index, lv_player, lv_message);
    if ((lv_result == false)) {
        CMUIX_ConsoleDisplayFailure(lv_player, lv_index);
    }
    else {
        CMUIX_ConsoleDisplaySuccess(lv_player, lv_index, lv_message);
        if ((CMUIX_ConsoleHooked == true)) {
            CMUIX_ConsoleApplyStateForPlayer(lv_player);
        }
    }

    return true;
}

void CMUIX_ConsoleCreateChatCommandTrigger() {
    if ((CMUIX_ConsoleChatCommandTrigger != null)) {
        return;
    }

    CMUIX_ConsoleCatalogInitialize();
    CMUIX_ConsoleChatCommandTrigger = TriggerCreate("CMUIX_ConsoleChatCommandHandler");
    CMUIX_ConsoleRegisterChatCommandEvents(CMUIX_ConsoleChatCommandTrigger);
}

bool CMUIX_ConsoleControlEventHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_control;

    lv_player = EventPlayer();
    lv_control = EventDialogControl();
    if ((runActions == false)) {
        return true;
    }

    if ((lv_player < 1) || (lv_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return true;
    }

    CMUIX_ConsoleHookupEntryButton();
    if ((CMUIX_IsControlValid(CMUIX_ConsoleEntryButton) == true) && (lv_control == CMUIX_ConsoleEntryButton)) {
        CMUIX_ConsoleToggle(lv_player);
        return true;
    }

    if ((CMUIX_ConsoleHooked == true)) {
        if ((CMUIX_ConsoleHandleControlEvent(lv_player, lv_control) == true)) {
            return true;
        }
    }

    return true;
}

void CMUIX_ConsoleCreateControlTrigger() {
    if ((CMUIX_ConsoleControlTrigger != null)) {
        return;
    }

    CMUIX_ConsoleControlTrigger = TriggerCreate("CMUIX_ConsoleControlEventHandler");
    TriggerAddEventDialogControl(CMUIX_ConsoleControlTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(CMUIX_ConsoleControlTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(CMUIX_ConsoleControlTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeSelectionChanged);
    TriggerAddEventDialogControl(CMUIX_ConsoleControlTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeTextChanged);
    TriggerAddEventDialogControl(CMUIX_ConsoleControlTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeValueChanged);
}

string CMUIX_ConsoleCopyKey(int lp_player, string lp_suffix) {
    return (CMUIX_CONSOLE_COPY_PREFIX + IntToString(lp_player) + "_" + lp_suffix);
}

bool CMUIX_ConsoleCopyShouldStoreBehavior(string lp_behavior) {
    return ((lp_behavior == "BiomassBuff1") || (lp_behavior == "BiomassBuff10") || (lp_behavior == "BiomassBuff100") || (lp_behavior == "BiomassBuff100PlusLife") || (lp_behavior == "BiomassBuff10PlusLife") || (lp_behavior == "AscendantSacrificeSelfBuff") || (lp_behavior == "DehakaEssenceDropPickupBuff") || (lp_behavior == "EssenceBuff1") || (lp_behavior == "EssenceBuff10") || (lp_behavior == "EssenceBuff100") || (lp_behavior == "EssenceBuff100PlusLife") || (lp_behavior == "EssenceBuff10PlusLife") || (lp_behavior == "DehakaGene4Creepers") || (lp_behavior == "DehakaGeneAttackSpeed") || (lp_behavior == "DehakaGeneCarapace") || (lp_behavior == "DehakaGeneCreeperHostGeneApply") || (lp_behavior == "DehakaGeneFireRoachGeneApply") || (lp_behavior == "DehakaGeneGuardianGeneApply") || (lp_behavior == "DehakaGeneImpalerGeneApply") || (lp_behavior == "DehakaGeneLifeLeech") || (lp_behavior == "DehakaGeneMutaliskGeneApply") || (lp_behavior == "DehakaGeneRavasaurGeneApply") || (lp_behavior == "DehakaGeneThorns") || (lp_behavior == "DehakaGeneTyrannosaurGeneApply"));
}

bool CMUIX_ConsoleSpawnMatchesSearch(string lp_unit, string lp_search) {
    text lv_name;
    string lv_searchBody;

    lv_name = StringToText("");
    lv_searchBody = "";
    if ((CatalogEntryIsValid(c_gameCatalogUnit, lp_unit) == false)) {
        return false;
    }

    if ((lp_search == "")) {
        return true;
    }

    lv_name = UnitTypeGetName(lp_unit);
    lv_searchBody = lp_unit + " " + TextToString(lv_name);
    return (StringFind(lv_searchBody, lp_search, c_stringNoCase) != c_stringNotFound);
}

void CMUIX_ConsoleSpawnSetSelected(int lp_player, string lp_unit) {
    text lv_label;
    playergroup lv_players;
    int lv_slot;
    bool lv_selected;

    lv_label = StringExternal("CMUI/Console/SpawnPanel/SelectedNone");
    lv_players = PlayerGroupSingle(lp_player);
    lv_slot = 1;
    lv_selected = false;
    CMUIX_ConsoleSpawnSelectedUnits[lp_player] = lp_unit;
    if ((lp_unit != "")) {
        lv_label = StringExternal("CMUI/Console/SpawnPanel/SelectedPrefix") + StringToText(" ") + UnitTypeGetName(lp_unit) + StringToText(" (" + lp_unit + ")");
    }

    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSelectedLabel) == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnSelectedLabel, lv_label, lv_players);
    }

    while ((lv_slot <= CMUIX_CONSOLE_SPAWN_RESULT_MAX)) {
        lv_selected = false;
        if ((lp_unit != "") && (CMUIX_ConsoleSpawnResultUnits[lp_player][lv_slot] == lp_unit)) {
            lv_selected = true;
        }
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultSelectedImages[lv_slot]) == true)) {
            DialogControlSetVisible(CMUIX_ConsoleSpawnResultSelectedImages[lv_slot], lv_players, lv_selected);
        }

        lv_slot += 1;
    }
}

void CMUIX_ConsoleSpawnRefresh(int lp_player) {
    int lv_slot;
    int lv_catalogIndex;
    int lv_catalogCount;
    string lv_search;
    string lv_unit;
    playergroup lv_players;

    lv_slot = 1;
    lv_catalogIndex = 1;
    lv_catalogCount = 0;
    lv_search = "";
    lv_unit = "";
    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchBox) == false) || (CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultsContainer) == false)) {
        return;
    }

    lv_search = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleSpawnSearchBox, lp_player);
    while ((lv_slot <= CMUIX_CONSOLE_SPAWN_RESULT_MAX)) {
        CMUIX_ConsoleSpawnResultUnits[lp_player][lv_slot] = "";
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultButtons[lv_slot]) == true)) {
            DialogControlSetVisible(CMUIX_ConsoleSpawnResultButtons[lv_slot], lv_players, false);
        }
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultNameLabels[lv_slot]) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnResultNameLabels[lv_slot], StringToText(""), lv_players);
        }
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultIdLabels[lv_slot]) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnResultIdLabels[lv_slot], StringToText(""), lv_players);
        }
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultSelectedImages[lv_slot]) == true)) {
            DialogControlSetVisible(CMUIX_ConsoleSpawnResultSelectedImages[lv_slot], lv_players, false);
        }

        lv_slot += 1;
    }

    lv_slot = 1;
    lv_catalogCount = CatalogEntryCount(c_gameCatalogUnit);
    while ((lv_catalogIndex <= lv_catalogCount) && (lv_slot <= CMUIX_CONSOLE_SPAWN_RESULT_MAX)) {
        lv_unit = CatalogEntryGet(c_gameCatalogUnit, lv_catalogIndex);
        if ((CMUIX_ConsoleSpawnMatchesSearch(lv_unit, lv_search) == true)) {
            CMUIX_ConsoleSpawnResultUnits[lp_player][lv_slot] = lv_unit;
            if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultNameLabels[lv_slot]) == true)) {
                libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnResultNameLabels[lv_slot], UnitTypeGetName(lv_unit), lv_players);
            }
            if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultIdLabels[lv_slot]) == true)) {
                libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnResultIdLabels[lv_slot], StringToText(lv_unit), lv_players);
            }
            if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultButtons[lv_slot]) == true)) {
                DialogControlSetVisible(CMUIX_ConsoleSpawnResultButtons[lv_slot], lv_players, true);
            }

            lv_slot += 1;
        }

        lv_catalogIndex += 1;
    }

    CMUIX_ConsoleSpawnSetSelected(lp_player, CMUIX_ConsoleSpawnSelectedUnits[lp_player]);
}

bool CMUIX_ConsoleSpawnSearchChangedHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_index;

    lv_player = EventPlayer();
    lv_index = 1;
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_ConsoleHooked == false)) {
        return true;
    }

    if ((EventDialogControl() == CMUIX_ConsoleSpawnSearchClearButton) && (CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchBox) == true) && (lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        libNtve_gf_SetDialogItemEditorValue(CMUIX_ConsoleSpawnSearchBox, "", PlayerGroupSingle(lv_player));
    }

    if ((lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ConsoleSpawnRefresh(lv_player);
        return true;
    }

    while ((lv_index <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ConsoleSpawnRefresh(lv_index);
        lv_index += 1;
    }

    return true;
}

void CMUIX_ConsoleCreateSpawnSearchTrigger() {
    if ((CMUIX_ConsoleSpawnSearchTrigger != null)) {
        return;
    }

    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchBox) == false)) {
        return;
    }

    CMUIX_ConsoleSpawnSearchTrigger = TriggerCreate("CMUIX_ConsoleSpawnSearchChangedHandler");
    TriggerAddEventDialogControl(CMUIX_ConsoleSpawnSearchTrigger, c_playerAny, CMUIX_ConsoleSpawnSearchBox, c_triggerControlEventTypeTextChanged);
    TriggerAddEventDialogControl(CMUIX_ConsoleSpawnSearchTrigger, c_playerAny, CMUIX_ConsoleSpawnSearchBox, c_triggerControlEventTypeValueChanged);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchClearButton) == true)) {
        TriggerAddEventDialogControl(CMUIX_ConsoleSpawnSearchTrigger, c_playerAny, CMUIX_ConsoleSpawnSearchClearButton, c_triggerControlEventTypeClick);
    }
}

void CMUIX_ConsoleSpawnToggle(int lp_player) {
    bool lv_visible;
    playergroup lv_players;

    lv_visible = false;
    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnPanel) == false)) {
        return;
    }

    lv_visible = DialogControlIsVisible(CMUIX_ConsoleSpawnPanel, lp_player);
    if ((lv_visible == false)) {
        CMUIX_ConsoleSpawnRefresh(lp_player);
        CMUIX_ConsoleSpawnApplyStateForPlayer(lp_player);
    }

    DialogControlSetVisible(CMUIX_ConsoleSpawnPanel, lv_players, (lv_visible == false));
}

void CMUIX_ConsoleAuthRefresh(int lp_player, string lp_statusKey) {
    playergroup lv_players;
    text lv_handleText;
    text lv_statusText;
    string lv_code;
    bool lv_valid;

    lv_players = PlayerGroupSingle(lp_player);
    lv_handleText = StringExternal("CMUI/Console/AuthPanel/HandlePrefix") + StringToText(" " + PlayerHandle(lp_player));
    lv_statusText = StringExternal("CMUI/Console/AuthPanel/StatusNoSaved");
    lv_code = "";
    lv_valid = false;
    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthHandleLabel) == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleAuthHandleLabel, lv_handleText, lv_players);
    }

    lv_code = CMUIX_AuthLoadSavedLicenseCode(lp_player);
    if ((lv_code != "")) {
        lv_valid = CMUIX_AuthVerifySavedUidLicense(lp_player, PlayerHandle(lp_player), CurrentDateTimeGet());
        if ((lv_valid == true)) {
            lv_statusText = StringExternal("CMUI/Console/AuthPanel/StatusSaved") + StringToText(" " + CMUIX_AuthGetLastLicenseTierName() + " / " + CMUIX_AuthGetLastLicenseExpireDateString());
        }
        else {
            lv_statusText = StringExternal("CMUI/Console/AuthPanel/StatusInvalid");
        }
    }

    if ((lp_statusKey != "")) {
        lv_statusText = StringExternal(lp_statusKey) + StringToText(" ") + lv_statusText;
    }

    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthStatusLabel) == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleAuthStatusLabel, lv_statusText, lv_players);
    }
}

void CMUIX_ConsoleAuthToggle(int lp_player) {
    bool lv_visible;
    playergroup lv_players;

    lv_visible = false;
    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthPanel) == false)) {
        return;
    }

    lv_visible = DialogControlIsVisible(CMUIX_ConsoleAuthPanel, lp_player);
    if ((lv_visible == false)) {
        CMUIX_ConsoleAuthRefresh(lp_player, "");
        CMUIX_ConsoleAuthApplyStateForPlayer(lp_player);
    }

    DialogControlSetVisible(CMUIX_ConsoleAuthPanel, lv_players, (lv_visible == false));
}

bool CMUIX_ConsoleAuthApply(int lp_player) {
    string lv_code;
    bool lv_ok;

    lv_code = "";
    lv_ok = false;
    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthCodeBox) == false)) {
        CMUIX_ConsoleAuthRefresh(lp_player, "CMUI/Console/AuthPanel/StatusApplyFailed");
        return false;
    }

    lv_code = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleAuthCodeBox, lp_player);
    if ((lv_code == "")) {
        CMUIX_ConsoleAuthRefresh(lp_player, "CMUI/Console/AuthPanel/StatusEmpty");
        return false;
    }

    lv_ok = CMUIX_AuthVerifyUidLicenseSaveAndApply(lp_player, PlayerHandle(lp_player), lv_code, CurrentDateTimeGet());
    if ((lv_ok == false)) {
        CMUIX_ConsoleAuthRefresh(lp_player, "CMUI/Console/AuthPanel/StatusApplyFailed");
        return false;
    }

    libNtve_gf_SetDialogItemEditorValue(CMUIX_ConsoleAuthCodeBox, "", PlayerGroupSingle(lp_player));
    CMUIX_ConsoleAuthRefresh(lp_player, "CMUI/Console/AuthPanel/StatusApplySuccess");
    CMUIX_AccessRefreshAfterPermissionChange(lp_player);
    return true;
}

bool CMUIX_ConsoleAuthClear(int lp_player) {
    CMUIX_AuthClearSavedLicenseCode(lp_player);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthCodeBox) == true)) {
        libNtve_gf_SetDialogItemEditorValue(CMUIX_ConsoleAuthCodeBox, "", PlayerGroupSingle(lp_player));
    }

    CMUIX_ConsoleAuthRefresh(lp_player, "CMUI/Console/AuthPanel/StatusCleared");
    return true;
}

bool CMUIX_ConsoleSpawnExecute(int lp_player) {
    string lv_unit;
    string lv_amountText;
    string lv_playerText;
    int lv_amount;
    int lv_targetPlayer;

    lv_unit = CMUIX_ConsoleSpawnSelectedUnits[lp_player];
    lv_amountText = "";
    lv_playerText = "";
    lv_amount = 1;
    lv_targetPlayer = lp_player;
    if ((CatalogEntryIsValid(c_gameCatalogUnit, lv_unit) == false)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutNoSpawnUnit");
        return false;
    }

    if ((CMUIX_AuthPermissionStatus(libCOTF_ge_RT_UserTypes_COMMAND, lp_player) == false)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutPermission");
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnAmountBox) == true)) {
        lv_amountText = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleSpawnAmountBox, lp_player);
    }
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnPlayerBox) == true)) {
        lv_playerText = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleSpawnPlayerBox, lp_player);
    }

    if ((lv_amountText != "")) {
        if ((CMUIX_ConsoleIsInteger(lv_amountText) == false) || (StringToInt(lv_amountText) <= 0)) {
            CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutInvalidAmount");
            return false;
        }

        lv_amount = StringToInt(lv_amountText);
    }

    if ((lv_playerText != "")) {
        if ((CMUIX_ConsoleIsInteger(lv_playerText) == false) || (StringToInt(lv_playerText) < 0) || (StringToInt(lv_playerText) > c_maxPlayers)) {
            CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutInvalidPlayer");
            return false;
        }

        lv_targetPlayer = StringToInt(lv_playerText);
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(lv_amount, UnitTypeFromString(lv_unit), 0, lv_targetPlayer, CameraGetTarget(lp_player));
    libCOTF_gf_UT_Cheat();
    return true;
}

bool CMUIX_ConsoleTeleportShortcut(int lp_player) {
    unitgroup lv_units;
    int lv_index;
    unit lv_unit;
    point lv_target;

    lv_units = UnitGroupEmpty();
    lv_index = 0;
    lv_unit = null;
    lv_target = null;
    if ((CMUIX_AuthPermissionStatus(libCOTF_ge_RT_UserTypes_COMMAND, lp_player) == false)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutPermission");
        return false;
    }

    lv_units = UnitGroupSelected(lp_player);
    lv_index = UnitGroupCount(lv_units, c_unitCountAll);
    if ((lv_index <= 0)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutNoSelection");
        return false;
    }

    lv_target = CameraGetTarget(lp_player);
    while ((lv_index > 0)) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_index);
        if ((lv_unit != null)) {
            UnitSetPosition(lv_unit, lv_target, true);
        }

        lv_index -= 1;
    }

    libCOTF_gf_UT_Cheat();
    return true;
}

bool CMUIX_ConsoleCopyShortcut(int lp_player) {
    unitgroup lv_units;
    point lv_center;
    int lv_groupIndex;
    int lv_unitIndex;
    int lv_behaviorIndex;
    int lv_behaviorCount;
    int lv_storedBehaviorCount;
    int lv_cargoIndex;
    int lv_cargoCount;
    int lv_storedCargoCount;
    int lv_cargoBehaviorIndex;
    int lv_cargoBehaviorCount;
    int lv_storedCargoBehaviorCount;
    unit lv_unit;
    unit lv_cargoUnit;
    string lv_behavior;
    string lv_prefix;
    string lv_cargoPrefix;

    lv_units = UnitGroupEmpty();
    lv_center = null;
    lv_groupIndex = 0;
    lv_unitIndex = 0;
    lv_behaviorIndex = 0;
    lv_behaviorCount = 0;
    lv_storedBehaviorCount = 0;
    lv_cargoIndex = 0;
    lv_cargoCount = 0;
    lv_storedCargoCount = 0;
    lv_cargoBehaviorIndex = 0;
    lv_cargoBehaviorCount = 0;
    lv_storedCargoBehaviorCount = 0;
    lv_unit = null;
    lv_cargoUnit = null;
    lv_behavior = "";
    lv_prefix = "";
    lv_cargoPrefix = "";
    if ((CMUIX_AuthPermissionStatus(libCOTF_ge_RT_UserTypes_COMMAND, lp_player) == false)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutPermission");
        return false;
    }

    lv_units = UnitGroupSelected(lp_player);
    lv_groupIndex = UnitGroupCount(lv_units, c_unitCountAll);
    if ((lv_groupIndex <= 0)) {
        DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "UnitCount"), 0);
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutNoSelection");
        return false;
    }

    lv_center = UnitGroupCenterOfGroup(lv_units);
    while ((lv_groupIndex > 0)) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_groupIndex);
        if ((lv_unit != null)) {
            lv_unitIndex += 1;
            lv_prefix = IntToString(lv_unitIndex);
            DataTableSetString(true, CMUIX_ConsoleCopyKey(lp_player, "UnitType_" + lv_prefix), UnitGetType(lv_unit));
            DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Owner_" + lv_prefix), UnitGetOwner(lv_unit));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Facing_" + lv_prefix), UnitGetFacing(lv_unit));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "PositionAngle_" + lv_prefix), AngleBetweenPoints(lv_center, UnitGetPosition(lv_unit)));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "PositionDistance_" + lv_prefix), DistanceBetweenPoints(UnitGetPosition(lv_unit), lv_center));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Life_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxLife_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Energy_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropEnergy, c_unitPropCurrent));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxEnergy_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropEnergyMax, c_unitPropCurrent));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Shields_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent));
            DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxShields_" + lv_prefix), UnitGetPropertyFixed(lv_unit, c_unitPropShieldsMax, c_unitPropCurrent));
            lv_behaviorIndex = 0;
            lv_behaviorCount = UnitBehaviorCountAll(lv_unit);
            lv_storedBehaviorCount = 0;
            while ((lv_behaviorIndex <= lv_behaviorCount)) {
                lv_behavior = UnitBehaviorGet(lv_unit, lv_behaviorIndex);
                if ((CMUIX_ConsoleCopyShouldStoreBehavior(lv_behavior) == true)) {
                    lv_storedBehaviorCount += 1;
                    DataTableSetString(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_prefix + "_" + IntToString(lv_storedBehaviorCount)), lv_behavior);
                    DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_prefix + "_" + IntToString(lv_storedBehaviorCount) + "_s"), UnitBehaviorCount(lv_unit, lv_behavior));
                }

                lv_behaviorIndex += 1;
            }
            DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "BehCount_" + lv_prefix), lv_storedBehaviorCount);
            lv_cargoIndex = 1;
            lv_cargoCount = UnitCargoValue(lv_unit, c_unitCargoUnitCount);
            lv_storedCargoCount = 0;
            while ((lv_cargoIndex <= lv_cargoCount)) {
                lv_cargoUnit = UnitCargo(lv_unit, lv_cargoIndex);
                if ((lv_cargoUnit != null)) {
                    lv_storedCargoCount += 1;
                    lv_cargoPrefix = lv_prefix + "_" + IntToString(lv_storedCargoCount);
                    DataTableSetString(true, CMUIX_ConsoleCopyKey(lp_player, "CargoUnit_" + lv_cargoPrefix), UnitGetType(lv_cargoUnit));
                    DataTableSetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Life_" + lv_cargoPrefix), UnitGetPropertyFixed(lv_cargoUnit, c_unitPropLifePercent, c_unitPropCurrent));
                    lv_cargoBehaviorIndex = 0;
                    lv_cargoBehaviorCount = UnitBehaviorCountAll(lv_cargoUnit);
                    lv_storedCargoBehaviorCount = 0;
                    while ((lv_cargoBehaviorIndex <= lv_cargoBehaviorCount)) {
                        lv_behavior = UnitBehaviorGet(lv_cargoUnit, lv_cargoBehaviorIndex);
                        if ((lv_behavior != "")) {
                            lv_storedCargoBehaviorCount += 1;
                            DataTableSetString(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_cargoPrefix + "_" + IntToString(lv_storedCargoBehaviorCount)), lv_behavior);
                            DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_cargoPrefix + "_" + IntToString(lv_storedCargoBehaviorCount) + "_s"), UnitBehaviorCount(lv_cargoUnit, lv_behavior));
                        }

                        lv_cargoBehaviorIndex += 1;
                    }
                    DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "BehCount_" + lv_cargoPrefix), lv_storedCargoBehaviorCount);
                }

                lv_cargoIndex += 1;
            }
            DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "CargoCount_" + lv_prefix), lv_storedCargoCount);
        }

        lv_groupIndex -= 1;
    }

    DataTableSetInt(true, CMUIX_ConsoleCopyKey(lp_player, "UnitCount"), lv_unitIndex);
    CMUIX_ConsoleDisplaySystemLine(lp_player, StringExternal("CMUI/Console/CopySuccess") + StringToText(" ") + IntToText(lv_unitIndex), true);
    libCOTF_gf_UT_Cheat();
    return true;
}

bool CMUIX_ConsolePasteShortcut(int lp_player) {
    point lv_center;
    int lv_unitCount;
    int lv_unitIndex;
    int lv_behaviorIndex;
    int lv_behaviorCount;
    int lv_cargoIndex;
    int lv_cargoCount;
    int lv_cargoBehaviorIndex;
    int lv_cargoBehaviorCount;
    int lv_pasteCount;
    string lv_prefix;
    string lv_cargoPrefix;
    string lv_unitType;
    string lv_behavior;
    unit lv_createdUnit;

    lv_center = null;
    lv_unitCount = 0;
    lv_unitIndex = 1;
    lv_behaviorIndex = 1;
    lv_behaviorCount = 0;
    lv_cargoIndex = 1;
    lv_cargoCount = 0;
    lv_cargoBehaviorIndex = 1;
    lv_cargoBehaviorCount = 0;
    lv_pasteCount = 0;
    lv_prefix = "";
    lv_cargoPrefix = "";
    lv_unitType = "";
    lv_behavior = "";
    lv_createdUnit = null;
    if ((CMUIX_AuthPermissionStatus(libCOTF_ge_RT_UserTypes_COMMAND, lp_player) == false)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutPermission");
        return false;
    }

    lv_unitCount = DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "UnitCount"));
    if ((lv_unitCount <= 0)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutNoCopiedUnits");
        return false;
    }

    lv_center = CameraGetTarget(lp_player);
    while ((lv_unitIndex <= lv_unitCount)) {
        lv_prefix = IntToString(lv_unitIndex);
        lv_unitType = DataTableGetString(true, CMUIX_ConsoleCopyKey(lp_player, "UnitType_" + lv_prefix));
        if ((CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == true)) {
            UnitCreate(1, UnitTypeFromString(lv_unitType), 0, DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Owner_" + lv_prefix)), PointWithOffsetPolar(lv_center, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "PositionDistance_" + lv_prefix)), DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "PositionAngle_" + lv_prefix))), DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Facing_" + lv_prefix)));
            lv_createdUnit = UnitLastCreated();
            lv_behaviorCount = DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "BehCount_" + lv_prefix));
            lv_behaviorIndex = 1;
            while ((lv_behaviorIndex <= lv_behaviorCount)) {
                lv_behavior = DataTableGetString(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_prefix + "_" + IntToString(lv_behaviorIndex)));
                if ((lv_behavior != "")) {
                    UnitBehaviorAddPlayer(lv_createdUnit, lv_behavior, UnitGetOwner(lv_createdUnit), DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_prefix + "_" + IntToString(lv_behaviorIndex) + "_s")));
                }

                lv_behaviorIndex += 1;
            }
            lv_cargoCount = DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "CargoCount_" + lv_prefix));
            lv_cargoIndex = 1;
            while ((lv_cargoIndex <= lv_cargoCount)) {
                lv_cargoPrefix = lv_prefix + "_" + IntToString(lv_cargoIndex);
                lv_unitType = DataTableGetString(true, CMUIX_ConsoleCopyKey(lp_player, "CargoUnit_" + lv_cargoPrefix));
                if ((CatalogEntryIsValid(c_gameCatalogUnit, lv_unitType) == true)) {
                    UnitCargoCreate(lv_createdUnit, UnitTypeFromString(lv_unitType), 1);
                    lv_cargoBehaviorCount = DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "BehCount_" + lv_cargoPrefix));
                    lv_cargoBehaviorIndex = 1;
                    while ((lv_cargoBehaviorIndex <= lv_cargoBehaviorCount)) {
                        lv_behavior = DataTableGetString(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_cargoPrefix + "_" + IntToString(lv_cargoBehaviorIndex)));
                        if ((lv_behavior != "")) {
                            UnitBehaviorAddPlayer(UnitCargoLastCreated(), lv_behavior, UnitGetOwner(UnitCargoLastCreated()), DataTableGetInt(true, CMUIX_ConsoleCopyKey(lp_player, "Beh_" + lv_cargoPrefix + "_" + IntToString(lv_cargoBehaviorIndex) + "_s")));
                        }

                        lv_cargoBehaviorIndex += 1;
                    }
                    UnitSetPropertyFixed(UnitCargoLastCreated(), c_unitPropLifePercent, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Life_" + lv_cargoPrefix)));
                }

                lv_cargoIndex += 1;
            }
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropLife, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Life_" + lv_prefix)));
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropLifeMax, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxLife_" + lv_prefix)));
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropShields, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Shields_" + lv_prefix)));
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropShieldsMax, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxShields_" + lv_prefix)));
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropEnergy, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "Energy_" + lv_prefix)));
            UnitSetPropertyFixed(lv_createdUnit, c_unitPropEnergyMax, DataTableGetFixed(true, CMUIX_ConsoleCopyKey(lp_player, "MaxEnergy_" + lv_prefix)));
            lv_pasteCount += 1;
        }

        lv_unitIndex += 1;
    }

    if ((lv_pasteCount <= 0)) {
        CMUIX_ConsoleDisplayShortcutFailure(lp_player, "CMUI/Console/FailureShortcutInvalidCopiedUnits");
        return false;
    }

    CMUIX_ConsoleDisplaySystemLine(lp_player, StringExternal("CMUI/Console/PasteSuccess") + StringToText(" ") + IntToText(lv_pasteCount), true);
    libCOTF_gf_UT_Cheat();
    return true;
}

bool CMUIX_ConsoleExecute(int lp_index, int lp_player) {
    bool lv_result;
    string lv_arg1;
    string lv_arg2;
    string lv_arg3;
    string lv_message;

    lv_result = false;
    lv_arg1 = "";
    lv_arg2 = "";
    lv_arg3 = "";
    lv_message = "";
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return false;
    }

    if ((CMUIX_ConsoleCommandVisibleForPlayer(lp_index, lp_player) == false)) {
        CMUIX_ConsoleDisplayFailure(lp_player, lp_index);
        return false;
    }

    if ((CMUIX_ConsoleDisplayOnlyCommands[lp_index] == true)) {
        CMUIX_ConsoleDisplayFailureWithReason(lp_player, lp_index, "CMUI/Console/FailureDisplayOnly");
        return false;
    }

    if ((CMUIX_ConsoleArgumentCounts[lp_index] >= 1)) {
        lv_arg1 = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleArgumentBoxes[1][lp_index], lp_player);
    }
    if ((CMUIX_ConsoleArgumentCounts[lp_index] >= 2)) {
        lv_arg2 = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleArgumentBoxes[2][lp_index], lp_player);
    }
    if ((CMUIX_ConsoleArgumentCounts[lp_index] >= 3)) {
        lv_arg3 = libNtve_gf_DialogItemEditValue(CMUIX_ConsoleArgumentBoxes[3][lp_index], lp_player);
    }

    if ((CMUIX_ConsoleValidate(lp_index, lp_player, lv_arg1, lv_arg2, lv_arg3) == false)) {
        CMUIX_ConsoleDisplayFailureWithReason(lp_player, lp_index, "CMUI/Console/FailureInvalidArgument");
        return false;
    }

    lv_message = CMUIX_ConsoleBuildMessage(lp_index, lv_arg1, lv_arg2, lv_arg3);
    lv_result = CMUIX_ConsoleCommandExecute(lp_index, lp_player, lv_message);
    if ((lv_result == false)) {
        CMUIX_ConsoleDisplayFailureWithReason(lp_player, lp_index, "CMUI/Console/FailurePrerequisite");
    }
    else {
        CMUIX_ConsoleDisplaySuccess(lp_player, lp_index, lv_message);
    }

    return lv_result;
}

void CMUIX_ConsoleHookupSpawnResultRow(int lp_slot) {
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultsContainer) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_ConsoleSpawnResultsContainer, c_triggerControlTypeButton, ("Item" + IntToString(lp_slot)));
    CMUIX_ConsoleSpawnResultButtons[lp_slot] = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnResultButtons[lp_slot]) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_ConsoleSpawnResultButtons[lp_slot], c_triggerControlTypeLabel, "NameLabel");
    CMUIX_ConsoleSpawnResultNameLabels[lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleSpawnResultButtons[lp_slot], c_triggerControlTypeLabel, "IdLabel");
    CMUIX_ConsoleSpawnResultIdLabels[lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleSpawnResultButtons[lp_slot], c_triggerControlTypeImage, "SelectedImage");
    CMUIX_ConsoleSpawnResultSelectedImages[lp_slot] = DialogControlLastCreated();
}

bool CMUIX_ConsoleCommandMapVisible(int lp_index) {
    string lv_mapToken;
    string lv_mapPath;
    string lv_mapName;

    lv_mapToken = "";
    lv_mapPath = "";
    lv_mapName = "";
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return false;
    }

    lv_mapToken = CMUIX_ConsoleCommandMapTokens[lp_index];
    if ((lv_mapToken == "")) {
        return true;
    }

    lv_mapPath = GameMapPath();
    lv_mapName = TextToString(GameMapName());
    return ((StringFind(lv_mapPath, lv_mapToken, c_stringNoCase) != c_stringNotFound) || (StringFind(lv_mapName, lv_mapToken, c_stringNoCase) != c_stringNotFound));
}

bool CMUIX_ConsoleCommandVisibleForPlayer(int lp_index, int lp_player) {
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return false;
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_ConsoleCommands[lp_index] == "")) {
        return false;
    }

    if ((CMUIX_ConsoleCommandOptionOnly(lp_index) == true)) {
        return false;
    }

    if ((CMUIX_ConsoleCommandMapVisible(lp_index) == false)) {
        return false;
    }

    if ((lp_index == 154) && (CMUIX_LauncherUICommandAvailable(lp_player) == false)) {
        return false;
    }
    if ((lp_index == 155) && (CMUIX_RuntimePermissionShareCommandAvailable(lp_player) == false)) {
        return false;
    }

    return CMUIX_AuthPermissionStatus(CMUIX_ConsoleCommandPermissionTypes[lp_index], lp_player);
}

void CMUIX_ConsoleHookupRow(int lp_index) {
    int lv_argument;
    bool lv_valid;
    playergroup lv_allPlayers;

    lv_argument = 1;
    lv_valid = false;
    lv_allPlayers = PlayerGroupAll();
    if ((lp_index < 1) || (lp_index > CMUIX_CONSOLE_COMMAND_MAX)) {
        return;
    }

    lv_valid = (lp_index <= CMUIX_ConsoleCommandCount);
    DialogControlHookup(CMUIX_ConsoleContainer, c_triggerControlTypePanel, ("Item" + IntToString(lp_index)));
    CMUIX_ConsoleRows[lp_index] = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(CMUIX_ConsoleRows[lp_index]) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_ConsoleRows[lp_index], c_triggerControlTypeLabel, "CommandLabel");
    CMUIX_ConsoleCommandLabels[lp_index] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleRows[lp_index], c_triggerControlTypeButton, "ToggleButton");
    CMUIX_ConsoleToggleButtons[lp_index] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleToggleButtons[lp_index], c_triggerControlTypeLabel, "Label");
    CMUIX_ConsoleToggleButtonLabels[lp_index] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleRows[lp_index], c_triggerControlTypeButton, "ExecuteButton");
    CMUIX_ConsoleExecuteButtons[lp_index] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_ConsoleRows[lp_index], c_triggerControlTypeLabel, "DescriptionLabel");
    CMUIX_ConsoleDescriptionLabels[lp_index] = DialogControlLastCreated();
    while ((lv_argument <= CMUIX_CONSOLE_ARGUMENT_MAX)) {
        DialogControlHookup(CMUIX_ConsoleRows[lp_index], c_triggerControlTypeEditBox, ("Arg" + IntToString(lv_argument)));
        CMUIX_ConsoleArgumentBoxes[lv_argument][lp_index] = DialogControlLastCreated();
        DialogControlSetVisible(CMUIX_ConsoleArgumentBoxes[lv_argument][lp_index], lv_allPlayers, false);
        lv_argument += 1;
    }

    if ((lv_valid == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleCommandLabels[lp_index], StringToText(CMUIX_ConsoleCommandDisplayString(lp_index)), lv_allPlayers);
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleDescriptionLabels[lp_index], CMUIX_ConsoleDescriptionText(lp_index), lv_allPlayers);
    } else {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleCommandLabels[lp_index], StringToText(""), lv_allPlayers);
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleDescriptionLabels[lp_index], StringToText(""), lv_allPlayers);
    }

    DialogControlSetVisible(CMUIX_ConsoleToggleButtons[lp_index], lv_allPlayers, false);
    CMUIX_ConsoleSetToggleButtonVisualState(lp_index, false, lv_allPlayers);
    DialogControlSetVisible(CMUIX_ConsoleExecuteButtons[lp_index], lv_allPlayers, false);
    DialogControlSetVisible(CMUIX_ConsoleRows[lp_index], lv_allPlayers, false);
}

void CMUIX_ConsoleLayoutRowsForPlayer(int lp_player) {
    int lv_index;
    int lv_argument;
    bool lv_valid;
    playergroup lv_players;

    lv_index = 1;
    lv_argument = 1;
    lv_valid = false;
    lv_players = PlayerGroupSingle(lp_player);
    while ((lv_index <= CMUIX_CONSOLE_COMMAND_MAX)) {
        lv_argument = 1;
        lv_valid = CMUIX_ConsoleCommandVisibleForPlayer(lv_index, lp_player);
        DialogControlSetVisible(CMUIX_ConsoleRows[lv_index], lv_players, lv_valid);
        while ((lv_argument <= CMUIX_CONSOLE_ARGUMENT_MAX)) {
            DialogControlSetVisible(CMUIX_ConsoleArgumentBoxes[lv_argument][lv_index], lv_players, ((lv_valid == true) && (CMUIX_ConsoleDisplayOnlyCommands[lv_index] == false) && (lv_argument <= CMUIX_ConsoleArgumentCounts[lv_index])));
            lv_argument += 1;
        }

        DialogControlSetVisible(CMUIX_ConsoleToggleButtons[lv_index], lv_players, ((lv_valid == true) && (CMUIX_ConsoleDisplayOnlyCommands[lv_index] == false) && (CMUIX_ConsoleToggleCommands[lv_index] == true)));
        DialogControlSetVisible(CMUIX_ConsoleExecuteButtons[lv_index], lv_players, ((lv_valid == true) && (CMUIX_ConsoleDisplayOnlyCommands[lv_index] == false) && (CMUIX_ConsoleToggleCommands[lv_index] == false)));
        if ((lv_valid == true) && (CMUIX_ConsoleToggleCommands[lv_index] == true) && (CMUIX_ConsoleCommandToggleStateKnown(lv_index) == true)) {
            CMUIX_ConsoleSyncToggleButtonState(lv_index, lp_player);
        }

        lv_index += 1;
    }
}

int CMUIX_ConsoleClampOpacityPercent(int lp_percent) {
    int lv_percent;

    lv_percent = lp_percent;
    if ((lv_percent < CMUIX_CONSOLE_OPACITY_MIN)) {
        lv_percent = CMUIX_CONSOLE_OPACITY_MIN;
    }

    if ((lv_percent > CMUIX_CONSOLE_OPACITY_MAX)) {
        lv_percent = CMUIX_CONSOLE_OPACITY_MAX;
    }

    return lv_percent;
}

int CMUIX_ConsoleOpacityAlpha(int lp_percent) {
    int lv_percent;
    int lv_alpha;

    lv_percent = CMUIX_ConsoleClampOpacityPercent(lp_percent);
    lv_alpha = RoundI((IntToFixed(lv_percent) * 255.0) / 100.0);
    if ((lv_alpha < 0)) {
        lv_alpha = 0;
    }

    if ((lv_alpha > 255)) {
        lv_alpha = 255;
    }

    return lv_alpha;
}

void CMUIX_ConsoleSetControlAlpha(int lp_control, playergroup lp_players, int lp_alpha) {
    if ((CMUIX_IsControlValid(lp_control) == true)) {
        DialogControlSetPropertyAsInt(lp_control, c_triggerControlPropertyAlpha, lp_players, lp_alpha);
    }
}

void CMUIX_ConsoleSetOpacityPercent(int lp_player, int lp_percent, bool lp_syncSlider) {
    playergroup lv_players;
    int lv_percent;
    int lv_alpha;

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    lv_percent = CMUIX_ConsoleClampOpacityPercent(lp_percent);
    lv_alpha = CMUIX_ConsoleOpacityAlpha(lv_percent);
    CMUIX_ConsoleOpacityPercent[lp_player] = lv_percent;
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsolePanel, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleBackground, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleInnerBackground, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleSpawnPanel, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleSpawnBackground, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleAuthPanel, lv_players, lv_alpha);
    CMUIX_ConsoleSetControlAlpha(CMUIX_ConsoleAuthBackground, lv_players, lv_alpha);

    if ((CMUIX_IsControlValid(CMUIX_ConsoleOpacityValueLabel) == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleOpacityValueLabel, IntToText(lv_percent) + StringToText("%"), lv_players);
    }

    if ((lp_syncSlider == true) && (CMUIX_IsControlValid(CMUIX_ConsoleOpacitySlider) == true)) {
        libNtve_gf_SetDialogItemCurrentValue(CMUIX_ConsoleOpacitySlider, IntToFixed(lv_percent), lv_players);
    }
}

bool CMUIX_ConsoleOpacityChangedHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_value;
    int lv_index;

    lv_player = EventPlayer();
    lv_value = CMUIX_CONSOLE_OPACITY_DEFAULT;
    lv_index = 1;
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_ConsoleHooked == false) || (CMUIX_IsControlValid(CMUIX_ConsoleOpacitySlider) == false)) {
        return true;
    }

    if ((lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_value = RoundI(libNtve_gf_DialogItemValue(CMUIX_ConsoleOpacitySlider, lv_player));
        CMUIX_ConsoleSetOpacityPercent(lv_player, lv_value, false);
        return true;
    }

    while ((lv_index <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_value = RoundI(libNtve_gf_DialogItemValue(CMUIX_ConsoleOpacitySlider, lv_index));
        CMUIX_ConsoleSetOpacityPercent(lv_index, lv_value, false);
        lv_index += 1;
    }

    return true;
}

void CMUIX_ConsoleCreateOpacityTrigger() {
    if ((CMUIX_ConsoleOpacityTrigger != null)) {
        return;
    }

    if ((CMUIX_IsControlValid(CMUIX_ConsoleOpacitySlider) == false)) {
        return;
    }

    CMUIX_ConsoleOpacityTrigger = TriggerCreate("CMUIX_ConsoleOpacityChangedHandler");
    TriggerAddEventDialogControl(CMUIX_ConsoleOpacityTrigger, c_playerAny, CMUIX_ConsoleOpacitySlider, c_triggerControlEventTypeValueChanged);
}

void CMUIX_ConsoleSpawnApplyStateForPlayer(int lp_player) {
    playergroup lv_players;
    bool lv_expanded;
    int lv_height;

    lv_players = PlayerGroupSingle(lp_player);
    lv_expanded = (CMUIX_ConsoleSpawnMinimized[lp_player] == false);
    lv_height = CMUIX_CONSOLE_SPAWN_PANEL_HEIGHT_EXPANDED;
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnPanel) == false)) {
        return;
    }

    if ((lv_expanded == false)) {
        lv_height = CMUIX_CONSOLE_POPUP_HEIGHT_MINIMIZED;
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnMinimizeButton, StringToText("+"), lv_players);
    } else {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleSpawnMinimizeButton, StringToText("-"), lv_players);
    }

    DialogControlSetVisible(CMUIX_ConsoleSpawnSearchLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnSearchBox, lv_players, lv_expanded);
    if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchClearButton) == true)) {
        DialogControlSetVisible(CMUIX_ConsoleSpawnSearchClearButton, lv_players, lv_expanded);
    }

    DialogControlSetVisible(CMUIX_ConsoleSpawnResultsContainer, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnSelectedLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnAmountLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnAmountBox, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnPlayerLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnPlayerBox, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleSpawnExecuteButton, lv_players, lv_expanded);
    DialogControlSetSize(CMUIX_ConsoleSpawnPanel, lv_players, CMUIX_CONSOLE_POPUP_WIDTH, lv_height);
    CMUIX_ConsoleSetOpacityPercent(lp_player, CMUIX_ConsoleOpacityPercent[lp_player], true);
}

void CMUIX_ConsoleAuthApplyStateForPlayer(int lp_player) {
    playergroup lv_players;
    bool lv_expanded;
    int lv_height;

    lv_players = PlayerGroupSingle(lp_player);
    lv_expanded = (CMUIX_ConsoleAuthMinimized[lp_player] == false);
    lv_height = CMUIX_CONSOLE_AUTH_PANEL_HEIGHT_EXPANDED;
    if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthPanel) == false)) {
        return;
    }

    if ((lv_expanded == false)) {
        lv_height = CMUIX_CONSOLE_POPUP_HEIGHT_MINIMIZED;
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleAuthMinimizeButton, StringToText("+"), lv_players);
    } else {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleAuthMinimizeButton, StringToText("-"), lv_players);
    }

    DialogControlSetVisible(CMUIX_ConsoleAuthHandleLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthCodeLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthCodeBox, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthApplyButton, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthClearButton, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthStatusLabel, lv_players, lv_expanded);
    DialogControlSetVisible(CMUIX_ConsoleAuthHelpLabel, lv_players, lv_expanded);
    DialogControlSetSize(CMUIX_ConsoleAuthPanel, lv_players, CMUIX_CONSOLE_POPUP_WIDTH, lv_height);
    CMUIX_ConsoleSetOpacityPercent(lp_player, CMUIX_ConsoleOpacityPercent[lp_player], true);
}

void CMUIX_ConsoleApplyStateForPlayer(int lp_player) {
    playergroup lv_players;
    int lv_height;
    text lv_handleText;

    lv_players = PlayerGroupSingle(lp_player);
    lv_height = CMUIX_CONSOLE_PANEL_HEIGHT_EXPANDED;
    lv_handleText = StringExternal("CMUI/Console/HandlePrefix") + StringToText(" " + PlayerHandle(lp_player));
    if ((CMUIX_IsControlValid(CMUIX_ConsoleHandleLabel) == true)) {
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleHandleLabel, lv_handleText, lv_players);
    }

    if ((CMUIX_ConsoleMinimized[lp_player] == true)) {
        lv_height = CMUIX_CONSOLE_PANEL_HEIGHT_MINIMIZED;
        DialogControlSetVisible(CMUIX_ConsoleInnerBackground, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleOpacityLabel, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleOpacitySlider, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleOpacityValueLabel, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleHandleLabel, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleHintLabel, lv_players, false);
        DialogControlSetVisible(CMUIX_ConsoleScrollFrame, lv_players, false);
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleMinimizeButton, StringToText("+"), lv_players);
    } else {
        CMUIX_ConsoleLayoutRowsForPlayer(lp_player);
        DialogControlSetVisible(CMUIX_ConsoleInnerBackground, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleOpacityLabel, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleOpacitySlider, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleOpacityValueLabel, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleHandleLabel, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleHintLabel, lv_players, true);
        DialogControlSetVisible(CMUIX_ConsoleScrollFrame, lv_players, true);
        libNtve_gf_SetDialogItemText(CMUIX_ConsoleMinimizeButton, StringToText("-"), lv_players);
    }

    DialogControlSetSize(CMUIX_ConsolePanel, lv_players, CMUIX_CONSOLE_PANEL_WIDTH, lv_height);
    CMUIX_ConsoleSetOpacityPercent(lp_player, CMUIX_ConsoleOpacityPercent[lp_player], true);
}

void CMUIX_ConsoleToggleMinimized(int lp_player) {
    if ((CMUIX_ConsoleHooked == false)) {
        return;
    }

    if ((DialogControlIsVisible(CMUIX_ConsolePanel, lp_player) == false)) {
        CMUIX_ConsoleMinimized[lp_player] = (CMUIX_ConsoleMinimized[lp_player] == false);
        return;
    }

    CMUIX_ConsoleMinimized[lp_player] = (CMUIX_ConsoleMinimized[lp_player] == false);
    CMUIX_ConsoleApplyStateForPlayer(lp_player);
}

void CMUIX_ConsoleSpawnToggleMinimized(int lp_player) {
    if ((CMUIX_ConsoleHooked == false)) {
        return;
    }

    CMUIX_ConsoleSpawnMinimized[lp_player] = (CMUIX_ConsoleSpawnMinimized[lp_player] == false);
    if ((DialogControlIsVisible(CMUIX_ConsoleSpawnPanel, lp_player) == true)) {
        CMUIX_ConsoleSpawnApplyStateForPlayer(lp_player);
    }
}

void CMUIX_ConsoleAuthToggleMinimized(int lp_player) {
    if ((CMUIX_ConsoleHooked == false)) {
        return;
    }

    CMUIX_ConsoleAuthMinimized[lp_player] = (CMUIX_ConsoleAuthMinimized[lp_player] == false);
    if ((DialogControlIsVisible(CMUIX_ConsoleAuthPanel, lp_player) == true)) {
        CMUIX_ConsoleAuthApplyStateForPlayer(lp_player);
    }
}

