    lv_player = 0;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomMutatorPickerPlayerPageIndex[lv_player] = 1;
        CMUIX_CustomMutatorPickerPlayerVisibleCount[lv_player] = 0;
        CMUIX_CustomMutatorPickerPlayerSearchText[lv_player] = "";
        lv_index = 0;
        while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
            CMUIX_CustomMutatorPickerPlayerItemMutators[lv_player][lv_index] = "";
            lv_index += 1;
        }

        lv_index = 0;
        while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
            CMUIX_CustomMutatorPickerPlayerVisibleMutators[lv_player][lv_index] = "";
            lv_index += 1;
        }

        lv_player += 1;
    }
}

