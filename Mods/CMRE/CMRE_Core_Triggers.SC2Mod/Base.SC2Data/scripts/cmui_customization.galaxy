text CMUIX_HistoryCommanderConfigLine(string lp_body, int lp_player) {
    string lv_commander;
    string lv_mastery;
    string lv_prestige;
    text lv_result;

    lv_commander = CMUIX_ProfileConfigValue(lp_body, ("p" + IntToString(lp_player) + "Commander"));
    lv_mastery = CMUIX_ProfileConfigValue(lp_body, ("p" + IntToString(lp_player) + "Mastery"));
    lv_prestige = CMUIX_ProfileConfigValue(lp_body, ("p" + IntToString(lp_player) + "Prestige"));
    lv_result = StringToText("");
    if ((lv_commander == "") && (lv_mastery == "") && (lv_prestige == "")) {
        return lv_result;
    }

    if ((lp_player == 1)) {
        lv_result = StringExternal("CMUI/ScreenHistory/Details/PlayerOne") + StringToText(" ");
    }
    else {
        lv_result = StringExternal("CMUI/ScreenHistory/Details/PlayerTwo") + StringToText(" ");
    }

    if ((lv_commander != "")) {
        lv_result = lv_result + CMUIX_HistoryCommanderText(lv_commander);
    }
    else {
        lv_result = lv_result + StringExternal("CMUI/ScreenHistory/Details/Unset");
    }

    if ((lv_prestige != "")) {
        lv_result = lv_result + StringExternal("CMUI/ScreenHistory/Details/Prestige") + StringToText(" ") + StringToText(lv_prestige);
    }

    if ((lv_mastery != "")) {
        lv_result = lv_result + StringExternal("CMUI/ScreenHistory/Details/Mastery") + StringToText(" ") + StringToText(lv_mastery);
    }

    return lv_result;
}

