    DialogControlHookup(libCMUI_gv_infoContainer, c_triggerControlTypeLabel, "DetailsLabel");
    libCMUI_gv_detailsLabel = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_detailsContainer, c_triggerControlTypePanel, "UnitsContainer");
    libCMUI_gv_unitsContainer = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_unitsContainer, c_triggerControlTypePanel, "UnitTileList");
    libCMUI_gv_unitTileList = DialogControlLastCreated();
    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_Units_Count_Max)) {
        DialogControlHookup(libCMUI_gv_unitTileList, c_triggerControlTypeButton, ("Item" + IntToString(lv_index)));
        libCMUI_gv_unitTileListItems[lv_index] = DialogControlLastCreated();
        DialogControlHookup(libCMUI_gv_unitTileListItems[lv_index], c_triggerControlTypeImage, "Icon");
        libCMUI_gv_unitTileListImage[lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }

    DialogControlHookup(libCMUI_gv_detailsContainer, c_triggerControlTypePanel, "UpgradesContainer");
    libCMUI_gv_upgradesContainer = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_upgradesContainer, c_triggerControlTypePanel, "TalentTileList");
    libCMUI_gv_talentTileList = DialogControlLastCreated();
    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_Commander_Level_Max)) {
        DialogControlHookup(libCMUI_gv_talentTileList, c_triggerControlTypeButton, ("Item" + IntToString(lv_index)));
        libCMUI_gv_talentTileListItems[lv_index] = DialogControlLastCreated();
        DialogControlHookup(libCMUI_gv_talentTileListItems[lv_index], c_triggerControlTypeImage, "Icon");
        libCMUI_gv_talentTileListImage[lv_index] = DialogControlLastCreated();
        DialogControlHookup(libCMUI_gv_talentTileListItems[lv_index], c_triggerControlTypeLabel, "LevelLabel");
        libCMUI_gv_talentTileListLevelLabel[lv_index] = DialogControlLastCreated();
        lv_index += 1;
    }

    DialogControlHookup(libCMUI_gv_detailsContainer, c_triggerControlTypePanel, "DetailsBackground");
    libCMUI_gv_detailsBackground = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_detailsBackground, c_triggerControlTypeImage, "CommanderDetailsBackground");
    libCMUI_gv_commanderDetailsBackground = DialogControlLastCreated();
    CMUIX_ProfileRefreshModeVisualsDeferred();
    CMUIX_PreloadForegroundCommanderModels();
    CMUIX_CoreSetSelectionTriggersEnabled(true);
}

void libCMUI_gf_ScreenCoopCommanderInitFromData() {
    int lv_index;
    int lv_columns;
    int lv_player;
    string lv_commander;
    string lv_accessState;

    lv_index = 0;
    lv_columns = 14;
    lv_player = 1;
    lv_commander = "";
    lv_accessState = "Normal";
    if ((CMUICore_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == false) || (CMUICore_IsControlValid(libCMUI_gv_commanderTileList) == false)) {
        libCMUI_gf_ScreenCoopUIHookup();
    }

    DialogControlSetAnimationState(libCMUI_gv_screenCoopCommanderSelectionPanel, PlayerGroupAll(), "CommanderTileList", "ListEnabled");
    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        DialogControlSetVisible(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), false);
        DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), "LockState", "Normal");
        DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), "RandomState", "NotRandom");
        DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), "SelectionState", "None");
        DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), "ReadyInputState", "Enabled");
        DialogControlSetAnimationState(libCMUI_gv_commanderItemsPortrait[lv_index], PlayerGroupAll(), "ReadyInputState", "Enabled");
        libNtve_gf_SetDialogItemToggled(libCMUI_gv_commanderItems[lv_index], false, PlayerGroupAll());
        if ((lv_index >= UserDataInstanceCount("PlayerCommanders"))) {
            DialogControlSetVisible(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), true);
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), "RandomState", "Random");
            break;
        }

        lv_commander = UserDataInstance("PlayerCommanders", (lv_index + 1));
        libNtve_gf_SetDialogItemImage(libCMUI_gv_commanderItemsPortrait[lv_index], libCMUI_gf_CAPortraitImage(lv_commander), PlayerGroupAll());
        lv_player = 1;
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            lv_accessState = CMUIX_CommanderAccessStateForPlayer(lv_player, lv_commander);
            DialogControlSetVisible(libCMUI_gv_commanderItems[lv_index], PlayerGroupSingle(lv_player), CMUIX_CommanderVisibleForPlayer(lv_player, lv_commander));
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], PlayerGroupSingle(lv_player), "LockState", lv_accessState);
            lv_player += 1;
        }

        lv_index += 1;
    }

    lv_columns = ((lv_index + 2) / 2);
    if ((lv_columns < 10)) {
        lv_columns = 10;
    }

    if ((lv_columns > 10)) {
        lv_columns = 14;
    }

    DialogControlSetAnimationState(libCMUI_gv_commanderTileList, PlayerGroupAll(), "CommanderGridColumnsState", ("Columns" + IntToString(lv_columns)));
    lv_index += 1;
    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        DialogControlSetVisible(libCMUI_gv_commanderItems[lv_index], PlayerGroupAll(), false);
        lv_index += 1;
    }

    CMUIX_CoreSetSelectionTriggersEnabled(true);
    CMUIX_CommanderDataReady = true;
    CMUIX_EnsureInitialCommanderSelections();
    CMUIX_RefreshCommanderSelectionVisualsAll();
}

void CMUIX_ProfileEnforceCommanderSelections() {
    int lv_player;
    int lv_selection;
    int lv_newSelection;
    string lv_commander;

    lv_player = 1;
    lv_selection = 0;
    lv_newSelection = 0;
    lv_commander = "";
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_selection = libCMUI_gv_selectedCommanderIndex[lv_player];
        if ((lv_selection >= 1) && (lv_selection <= UserDataInstanceCount("PlayerCommanders"))) {
            lv_commander = UserDataInstance("PlayerCommanders", lv_selection);
            if ((CMUIX_CommanderAccessibleForPlayer(lv_player, lv_commander) == false)) {
                lv_newSelection = CMUIX_InitialCommanderSelectionForPlayer(lv_player);
                if ((lv_newSelection != 0)) {
                    CMUIX_SetCommanderSelectionForPlayer(lv_player, lv_newSelection);
                }
            }
        }

        lv_player += 1;
    }
}

// Core event handlers are broad dialog-click listeners. They only consume
// controls owned by commander or map selection.
bool libCMUI_gt_ScreenCoopInitial_Func(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    CMUIX_Init();
    CMUIX_StartupInitializeData();
    CMUIX_StartupRefreshControls();
    return true;
}

void libCMUI_gt_ScreenCoopInitial_Init() {
    libCMUI_gt_ScreenCoopInitial = TriggerCreate("libCMUI_gt_ScreenCoopInitial_Func");
}

bool libCMUI_gt_ScreenCoopCommanderClicked_Func(bool testConds, bool runActions) {
    int lv_viewer;
    int lv_targetPlayer;
    int lv_index;
    int lv_thisSelection;
    int lv_lastSelection;
    int lv_checkMark;

    lv_viewer = EventPlayer();
    lv_targetPlayer = CMUIX_CommanderClickTargetPlayer(lv_viewer);
    lv_index = 0;
    lv_thisSelection = 0;
    lv_lastSelection = libCMUI_gv_selectedCommanderIndex[lv_targetPlayer];
    lv_checkMark = 0;
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_ReadyInputLocked(lv_viewer, EventDialogControl()) == true)) {
        return true;
    }

    if ((CMUIX_CommanderLevelHandleClick(lv_viewer, EventDialogControl()) == true)) {
        return true;
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        if ((EventDialogControl() == libCMUI_gv_commanderItems[lv_index])) {
            if ((lv_index < UserDataInstanceCount("PlayerCommanders"))) {
                if (CMUIX_CommanderAccessibleForOperatorTarget(lv_viewer, lv_targetPlayer, UserDataInstance("PlayerCommanders", (lv_index + 1))) == false) {
                    return true;
                }
            }

            lv_checkMark += 1;
            if ((lv_lastSelection == (lv_index + 1))) {
                CMUIX_RefreshCommanderSelectionVisualsAll();
                CMUIX_CustomizationOnCommanderSelectedForTarget(lv_viewer, lv_targetPlayer, (lv_index + 1));
                return true;
            }

            libCMUI_gv_selectedCommanderIndex[lv_targetPlayer] = (lv_index + 1);
        }

        lv_index += 1;
    }

    if ((lv_checkMark == 0)) {
        return true;
    }

    lv_thisSelection = libCMUI_gv_selectedCommanderIndex[lv_targetPlayer];
    if ((lv_lastSelection != 0) && (libCMUI_gv_commanderSelectedCount[lv_lastSelection] > 0)) {
        libCMUI_gv_commanderSelectedCount[lv_lastSelection] -= 1;
        if ((lv_targetPlayer == lv_viewer)) {
            CutsceneRemoveFilter(libCMUI_gv_foregroundCutsceneFilm[lv_viewer], libCOOC_gf_CC_CommanderAvatarFilter(UserDataInstance("PlayerCommanders", lv_lastSelection)));
        }
    }

    libCMUI_gv_commanderSelectedCount[lv_thisSelection] += 1;
    CMUIX_RecordCommanderSelection(lv_targetPlayer, lv_thisSelection);
    CMUIX_MapSelectionResetReadyStatus();
    if ((lv_targetPlayer == lv_viewer)) {
        libCMUI_gf_ScreenCoopCommanderSelect(lv_viewer, lv_thisSelection);
    }

    CMUIX_RefreshCommanderSelectionVisualsAll();
    CMUIX_CustomizationOnCommanderSelectedForTarget(lv_viewer, lv_targetPlayer, lv_thisSelection);
    return true;
}

bool CMUIX_ScorePanelHandleClick(int lp_player, int lp_control) {
    if ((CMUICore_IsControlValid(CMUIX_ScoreRetryButton) == false)) {
        return false;
    }

    if ((lp_control != CMUIX_ScoreRetryButton)) {
        return false;
    }

    CMUIX_LaunchProfileRefreshRetryAll();
    return true;
}

bool libCMUI_gt_MapSelectionClicked_Func(bool testConds, bool runActions) {
    int lv_player;
    int lv_index;
    int lv_clicked;
    int lv_control;

    lv_player = EventPlayer();
    lv_index = 0;
    lv_clicked = 0;
    lv_control = EventDialogControl();
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_FinalConfigurationHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_ScorePanelHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((lv_control == CMUIX_ProfileCancelButton)) {
        CMUIX_ProfileCancelActiveConfiguration(lv_player);
        return true;
    }

    if ((CMUIX_ReadyInputLocked(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_HomeHandleControlEvent(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_CustomMutatorPickerHandleControlEvent(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_MutatorInfoHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_PlayerCanControlSharedSetup(lv_player) == false)) {
        return true;
    }

    if ((CMUIX_RandomSeedInputHandleEvent(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_DifficultyHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_NavigationHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_SpecialDifficultyHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_MutatorPoolHandleControlEvent(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUIX_MutatorChallengeHandleClick(lv_player, lv_control) == true)) {
        return true;
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_mapSelectionButton) == false)) {
        return true;
    }

    if ((lv_control == libCMUI_gv_mapSelectionButton)) {
        CMUIX_StartupRefreshControls();
        CMUIX_RandomSeedInputResetDraft();
        if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
            CMUIX_MapSelectionDraft = CMUIX_MapSelectionSelected;
        }
        else {
            CMUIX_MapSelectionDraft = CMUIX_MapSelectionCurrentMapInstance();
        }

        CMUIX_EnemySelectionDraft = CMUIX_EnemySelectionSelected;
        CMUIX_MapSelectionRefreshButton();
        CMUIX_MapSelectionRefreshListSelection(lv_player);
        CMUIX_EnemySelectionRefreshListSelection(lv_player);
        return true;
    }

    if ((lv_control == libCMUI_gv_mapSelectionAcceptButton)) {
        CMUIX_RandomSeedInputAccept(lv_player);
        if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
            CMUIX_MapSelectionAccept(lv_player);
        }

        CMUIX_EnemySelectionAccept(lv_player);
        return true;
    }

    if ((lv_control == libCMUI_gv_mapSelectionCloseButton)) {
        CMUIX_MapSelectionCancel();
        CMUIX_EnemySelectionCancel();
        CMUIX_RandomSeedInputCancel();
        return true;
    }

    while ((lv_index < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        if ((lv_control == libCMUI_gv_mapSelectionItems[lv_index])) {
            lv_clicked = 1;
            if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
                CMUIX_MapSelectionDraft = libCMUI_gv_mapSelectionItemMaps[lv_index];
            }
        }

        lv_index += 1;
    }

    if ((lv_clicked == 1)) {
        if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
            return true;
        }

        if ((CMUIX_MapSelectionDraft == "")) {
            return true;
        }

        CMUIX_MapSelectionRefreshListSelection(lv_player);
        return true;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        if ((lv_control == libCMUI_gv_enemySelectionItems[lv_index])) {
            if ((CMUIX_MutatorChallengeSelectedLockedAI() != "")) {
                return true;
            }

            lv_clicked = 1;
            CMUIX_EnemySelectionDraft = libCMUI_gv_enemySelectionItemEnemies[lv_index];
        }

        lv_index += 1;
    }

    if ((lv_clicked == 0)) {
        return true;
    }

    if ((CMUIX_EnemySelectionDraft == "")) {
        return true;
    }

    CMUIX_EnemySelectionRefreshListSelection(lv_player);
    return true;
}

void libCMUI_gt_ScreenCoopCommanderClicked_Init() {
    libCMUI_gt_ScreenCoopCommanderClicked = TriggerCreate("libCMUI_gt_ScreenCoopCommanderClicked_Func");
    TriggerEnable(libCMUI_gt_ScreenCoopCommanderClicked, false);
    TriggerAddEventDialogControl(libCMUI_gt_ScreenCoopCommanderClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

void libCMUI_gt_MapSelectionClicked_Init() {
    libCMUI_gt_MapSelectionClicked = TriggerCreate("libCMUI_gt_MapSelectionClicked_Func");
    TriggerEnable(libCMUI_gt_MapSelectionClicked, false);
    TriggerAddEventDialogControl(libCMUI_gt_MapSelectionClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(libCMUI_gt_MapSelectionClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(libCMUI_gt_MapSelectionClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeSelectionChanged);
    TriggerAddEventDialogControl(libCMUI_gt_MapSelectionClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeTextChanged);
    TriggerAddEventDialogControl(libCMUI_gt_MapSelectionClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeValueChanged);
}

void CMUIX_CoreSetSelectionTriggersEnabled(bool lp_enabled) {
    if ((libCMUI_gt_ScreenCoopCommanderClicked != null)) {
        TriggerEnable(libCMUI_gt_ScreenCoopCommanderClicked, lp_enabled);
    }

    if ((libCMUI_gt_MapSelectionClicked != null)) {
        TriggerEnable(libCMUI_gt_MapSelectionClicked, lp_enabled);
    }
}

void CMUIX_CoreInitTriggers() {
    libCMUI_gt_ScreenCoopInitial_Init();
    libCMUI_gt_ScreenCoopCommanderClicked_Init();
    libCMUI_gt_MapSelectionClicked_Init();
    CMUIX_ReadyCountdownTrigger = TriggerCreate("CMUIX_ReadyCountdownFinishHandler");
    CMUIX_OptimizationCreateTriggers();
    CMUIX_GameHistoryCreateCheatEventTrigger();
    CMUIX_ConsoleCreateChatCommandTrigger();
    CMUIX_ConsoleCreateControlTrigger();
}

void CMUIX_CoreInit() {
    if ((CMUIX_CoreReady == true)) {
        return;
    }

    CMUIX_CoreReady = true;
    CMUIX_CoreInitLibraries();
    CMUIX_CoreInitVariables();
    CMUIX_AuthApplySavedLicensesForAllPlayers(CurrentDateTimeGet());
    CMUIX_AccessRuntimeUnlockRefreshAll();
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_CoreInitTriggers();
}

// -----------------------------------------------------------------------------
// Customization Helpers, Draft State, And Panel Refresh
// -----------------------------------------------------------------------------

bool CMUIX_IsControlValid(int lp_control) {
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }

    return true;
}

int CMUIX_ClampInt(int lp_value, int lp_min, int lp_max) {
    if ((lp_value < lp_min)) {
        return lp_min;
    }

    if ((lp_value > lp_max)) {
        return lp_max;
    }

    return lp_value;
}

int CMUIX_MutatorChallengeCycleEndTimestamp(string lp_type) {
    int lv_periodHours;
    int lv_periodSeconds;
    int lv_startTimestamp;
    int lv_elapsedSeconds;
    int lv_cycleIndex;
    string lv_type;
    string lv_startTime;

    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_periodHours = UserDataGetInt("MutatorChallengesType", lv_type, "MC - Cycle Period", 1);
    lv_startTime = UserDataGetString("MutatorChallengesType", lv_type, "MC - Cycle Start Time", 1);
    lv_periodSeconds = 0;
    lv_startTimestamp = 0;
    lv_elapsedSeconds = 0;
    lv_cycleIndex = 0;
    if ((lv_periodHours <= 0) || (lv_startTime == "")) {
        return 0;
    }

    lv_periodSeconds = lv_periodHours * 3600;
    lv_startTimestamp = DateTimeToInt(StringToDateTime(lv_startTime));
    lv_elapsedSeconds = DateTimeToInt(CurrentDateTimeGet()) - lv_startTimestamp;
    if ((lv_elapsedSeconds < 0)) {
        lv_elapsedSeconds = 0;
    }

    lv_cycleIndex = lv_elapsedSeconds / lv_periodSeconds;
    return (lv_startTimestamp + ((lv_cycleIndex + 1) * lv_periodSeconds));
}

text CMUIX_HomeChallengeTitleText(string lp_type, string lp_challenge) {
    text lv_prefix;
    text lv_name;

    lv_prefix = StringExternal("CMUI/ScreenHome/WeeklyMutationTask");
    lv_name = StringExternal("CMUI/ScreenHome/NoMutation");
    if ((CMUIX_MutatorChallengeNormalizeType(lp_type) == CMUIX_MutatorChallenge_Type_CM)) {
        lv_prefix = StringExternal("CMUI/ScreenHome/CMMutationTask");
    }

    if ((lp_challenge != "") && (lp_challenge != null)) {
        lv_name = CMUIX_MutatorChallengeDisplayName(lp_type, lp_challenge);
    }

    return (lv_prefix + StringToText(": ") + lv_name);
}

text CMUIX_HomeChallengeEndText(string lp_type) {
    int lv_endTimestamp;

    lv_endTimestamp = CMUIX_MutatorChallengeCycleEndTimestamp(lp_type);
    return (StringExternal("CMUI/ScreenHome/EndsAt") + StringToText(CMUIX_HistoryDateString(lv_endTimestamp)));
}

void CMUIX_HomeSetWidget(int lp_slot, bool lp_visible, text lp_title, text lp_subtitle) {
    playergroup lv_players;

    lv_players = PlayerGroupAll();
    if ((lp_slot < 0) || (lp_slot >= CMUIX_HOME_WIDGET_MAX)) {
        return;
    }

    CMUIX_SetControlVisible(CMUIX_HomeWidgetItems[lp_slot], lv_players, lp_visible);
    CMUIX_SetControlText(CMUIX_HomeWidgetTitleLabels[lp_slot], lv_players, lp_title);
    CMUIX_SetControlText(CMUIX_HomeWidgetSubLabels[lp_slot], lv_players, lp_subtitle);
}

void CMUIX_HomeResetLatestUpdateCache() {
    int lv_slot;

    lv_slot = 0;
    while ((lv_slot < CMUIX_HOME_LATEST_UPDATE_MAX)) {
        CMUIX_HomeLatestUpdateInstances[lv_slot] = "";
        CMUIX_HomeLatestUpdateTimes[lv_slot] = 0;
        lv_slot += 1;
    }
}

void CMUIX_HomeResetHookState() {
    int lv_slot;

    lv_slot = 0;
    CMUIX_HomeHooked = false;
    CMUIX_HomeRoot = c_invalidDialogControlId;
    while ((lv_slot < CMUIX_HOME_WIDGET_MAX)) {
        CMUIX_HomeWidgetItems[lv_slot] = c_invalidDialogControlId;
        CMUIX_HomeWidgetTitleLabels[lv_slot] = c_invalidDialogControlId;
        CMUIX_HomeWidgetSubLabels[lv_slot] = c_invalidDialogControlId;
        lv_slot += 1;
    }
}

void CMUIX_HomeLatestUpdateTryInsert(string lp_instance, int lp_time) {
    int lv_slot;
    int lv_shift;

    lv_slot = 0;
    lv_shift = 0;
    if ((lp_instance == "") || (lp_instance == "[Default]") || (lp_time <= 0)) {
        return;
    }

    while ((lv_slot < CMUIX_HOME_LATEST_UPDATE_MAX)) {
        if ((lp_time > CMUIX_HomeLatestUpdateTimes[lv_slot])) {
            lv_shift = CMUIX_HOME_LATEST_UPDATE_MAX - 1;
            while ((lv_shift > lv_slot)) {
                CMUIX_HomeLatestUpdateInstances[lv_shift] = CMUIX_HomeLatestUpdateInstances[lv_shift - 1];
                CMUIX_HomeLatestUpdateTimes[lv_shift] = CMUIX_HomeLatestUpdateTimes[lv_shift - 1];
                lv_shift -= 1;
            }

            CMUIX_HomeLatestUpdateInstances[lv_slot] = lp_instance;
            CMUIX_HomeLatestUpdateTimes[lv_slot] = lp_time;
            return;
        }

        lv_slot += 1;
    }
}

void CMUIX_HomeScanLatestUpdates() {
    int lv_index;
    int lv_count;
    int lv_time;
    string lv_instance;
    string lv_timeString;
    text lv_title;

    lv_index = 1;
    lv_count = UserDataInstanceCount(CMUIX_HOME_LATEST_UPDATE_USERDATA);
    lv_time = 0;
    lv_instance = "";
    lv_timeString = "";
    lv_title = StringToText("");
    CMUIX_HomeResetLatestUpdateCache();
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance(CMUIX_HOME_LATEST_UPDATE_USERDATA, lv_index);
        lv_title = UserDataGetText(CMUIX_HOME_LATEST_UPDATE_USERDATA, lv_instance, "Title", 1);
        lv_timeString = UserDataGetString(CMUIX_HOME_LATEST_UPDATE_USERDATA, lv_instance, "DateTime", 1);
        if ((TextToString(lv_title) != "") && (lv_timeString != "")) {
            lv_time = DateTimeToInt(StringToDateTime(lv_timeString));
            CMUIX_HomeLatestUpdateTryInsert(lv_instance, lv_time);
        }

        lv_index += 1;
    }
}

void CMUIX_HomeRefreshChallengeWidget(int lp_slot, string lp_type) {
    string lv_challenge;

    lv_challenge = CMUIX_MutatorChallengeDefaultForType(lp_type);
    CMUIX_HomeSetWidget(lp_slot, true, CMUIX_HomeChallengeTitleText(lp_type, lv_challenge), CMUIX_HomeChallengeEndText(lp_type));
}

void CMUIX_HomeRefreshLatestUpdates() {
    int lv_slot;
    int lv_widgetSlot;
    string lv_instance;
    text lv_title;
    text lv_subtitle;

    lv_slot = 0;
    lv_widgetSlot = 2;
    lv_instance = "";
    lv_title = StringToText("");
    lv_subtitle = StringToText("");
    CMUIX_HomeScanLatestUpdates();
    while ((lv_slot < CMUIX_HOME_LATEST_UPDATE_MAX)) {
        lv_widgetSlot = lv_slot + 2;
        lv_instance = CMUIX_HomeLatestUpdateInstances[lv_slot];
        if ((lv_instance != "")) {
            lv_title = UserDataGetText(CMUIX_HOME_LATEST_UPDATE_USERDATA, lv_instance, "Title", 1);
            lv_subtitle = StringToText(CMUIX_HistoryDateString(CMUIX_HomeLatestUpdateTimes[lv_slot]));
            CMUIX_HomeSetWidget(lv_widgetSlot, true, lv_title, lv_subtitle);
        }
        else {
            CMUIX_HomeSetWidget(lv_widgetSlot, false, StringToText(""), StringToText(""));
        }

        lv_slot += 1;
    }
}

void CMUIX_HomeRefreshAll() {
    if ((CMUIX_HomeHooked == false)) {
        CMUIX_HomeHookup();
    }

    if ((CMUIX_HomeHooked == false)) {
        return;
    }

    CMUIX_MutatorChallengeInitializeAllTypes();
    CMUIX_HomeRefreshChallengeWidget(0, CMUIX_MutatorChallenge_Type_Official);
    CMUIX_HomeRefreshChallengeWidget(1, CMUIX_MutatorChallenge_Type_CM);
    CMUIX_HomeRefreshLatestUpdates();
}

bool CMUIX_HomeControlAffectsData(int lp_control) {
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }

    if ((lp_control == CMUIX_HomeWidgetItems[0]) || (lp_control == CMUIX_HomeWidgetItems[1])) {
        return true;
    }

    return false;
}

bool CMUIX_HomeHandleControlEvent(int lp_player, int lp_control) {
    int lv_navigationControl;

    lv_navigationControl = c_invalidDialogControlId;
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }

    if ((lp_control == CMUIX_HomeWidgetItems[0])) {
        lv_navigationControl = libCMUI_gv_screenCoopNavigationMutatorButton;
    }
    else {
        if ((lp_control == CMUIX_HomeWidgetItems[1])) {
            lv_navigationControl = libCMUI_gv_screenCoopNavigationCMMutatorButton;
        }
    }

    if ((lv_navigationControl == c_invalidDialogControlId)) {
        return false;
    }

    if ((CMUIX_ReadyCanEditSharedData(lp_player) == false)) {
        return true;
    }

    CMUIX_ProfileShowCoopCommanderSelection(lp_player);
    CMUIX_NavigationHandleClick(lp_player, lv_navigationControl);
    return true;
}

void CMUIX_HomeHookup() {
    int lv_slot;
    int lv_controlType;
    string lv_itemPath;

    lv_slot = 0;
    lv_controlType = c_triggerControlTypeButton;
    lv_itemPath = "";
    if ((CMUIX_HomeHooked == true)) {
        return;
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_screenNavigationMain) == false)) {
        return;
    }

    DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "ScreenHomePanel");
    CMUIX_HomeRoot = DialogControlLastCreated();
    if ((CMUICore_IsControlValid(CMUIX_HomeRoot) == false)) {
        return;
    }

    while ((lv_slot < CMUIX_HOME_WIDGET_MAX)) {
        lv_itemPath = "HomeContent/LandingScreen/WidgetFrame/Item" + IntToString(lv_slot);
        lv_controlType = c_triggerControlTypeButton;
        if ((lv_slot >= 2)) {
            lv_controlType = c_triggerControlTypePanel;
        }

        DialogControlHookup(CMUIX_HomeRoot, lv_controlType, lv_itemPath);
        CMUIX_HomeWidgetItems[lv_slot] = DialogControlLastCreated();
        if ((CMUICore_IsControlValid(CMUIX_HomeWidgetItems[lv_slot]) == true)) {
            DialogControlHookup(CMUIX_HomeWidgetItems[lv_slot], c_triggerControlTypeLabel, "DescriptionLabel");
            CMUIX_HomeWidgetTitleLabels[lv_slot] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_HomeWidgetItems[lv_slot], c_triggerControlTypeLabel, "DescriptionSubLabel");
            CMUIX_HomeWidgetSubLabels[lv_slot] = DialogControlLastCreated();
        }
        else {
            CMUIX_HomeWidgetTitleLabels[lv_slot] = c_invalidDialogControlId;
            CMUIX_HomeWidgetSubLabels[lv_slot] = c_invalidDialogControlId;
        }

        lv_slot += 1;
    }

    CMUIX_HomeHooked = true;
}

// Button/control helpers translate UI slots into commander instances and into
// the target player currently controlled by the viewer.
int CMUIX_CommanderSelectionIndexForPlayer(int lp_player) {
    if ((lp_player < 0) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return 0;
    }

    return libCMUI_gv_selectedCommanderIndex[lp_player];
}

string CMUIX_CommanderForSelection(int lp_selection) {
    if ((lp_selection >= 1) && (lp_selection <= UserDataInstanceCount("PlayerCommanders"))) {
        return UserDataInstance("PlayerCommanders", lp_selection);
    }

    return "";
}

bool CMUIX_CommanderSelectionIsRandom(int lp_selection) {
    if ((lp_selection == (UserDataInstanceCount("PlayerCommanders") + 1))) {
        return true;
    }

    return false;
}

bool CMUIX_PlayerCommanderSelectionIsRandom(int lp_player) {
    return CMUIX_CommanderSelectionIsRandom(CMUIX_CommanderSelectionIndexForPlayer(lp_player));
}

string CMUIX_CommanderForPlayer(int lp_player) {
    int lv_index;
    string lv_commander;

    lv_index = CMUIX_CommanderSelectionIndexForPlayer(lp_player);
    lv_commander = "";
    if ((lv_index >= 1)) {
        return CMUIX_CommanderForSelection(lv_index);
    }

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if ((lv_commander != "")) {
        return lv_commander;
    }

    return "";
}

string CMUIX_OptimizationCommanderForApply(int lp_player) {
    string lv_commander;

    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return "";
    }

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if ((lv_commander != "") && (lv_commander != null)) {
        return lv_commander;
    }

    return CMUIX_CommanderForPlayer(lp_player);
}

int CMUIX_TargetForOperator(int lp_operator) {
    if ((lp_operator < 0) || (lp_operator > libCOOC_gv_cCC_MAXPLAYERS)) {
        return lp_operator;
    }

    if ((CMUIX_TargetPlayer[lp_operator] >= 0) && (CMUIX_TargetPlayer[lp_operator] <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_TargetPlayer[lp_operator] != 0)) {
            return CMUIX_TargetPlayer[lp_operator];
        }
    }

    return lp_operator;
}

int CMUIX_CommanderSelectionForControl(int lp_control) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        if ((lp_control == libCMUI_gv_commanderItems[lv_index])) {
            return (lv_index + 1);
        }

        lv_index += 1;
    }

    return 0;
}

bool CMUIX_CommanderButtonWasClicked(int lp_control) {
    if ((CMUIX_CommanderSelectionForControl(lp_control) != 0)) {
        return true;
    }

    return false;
}

bool CMUIX_PlayerIsUser(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((PlayerType(lp_player) == c_playerTypeUser)) {
        return true;
    }

    return false;
}

bool CMUIX_PlayerShouldUseDefaultAIMastery(int lp_player) {
    if ((lp_player == 2) && (PlayerType(2) != c_playerTypeUser)) {
        return true;
    }

    return false;
}

int CMUIX_DefaultMasteryUpgradeLevel(int lp_player, string lp_masteryUpgrade) {
    int lv_category;
    int lv_categoryPoints;
    int lv_internalIndex;

    lv_category = libCOOC_gf_CC_PlayerMasteryCategory(lp_masteryUpgrade);
    lv_categoryPoints = 0;
    lv_internalIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lp_masteryUpgrade);
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lv_category < 1) || (lv_category > libCOOC_gv_cCC_MASTERY_CATEGORIES) || (lv_internalIndex < 1)) {
        return 0;
    }

    lv_categoryPoints = libCOOC_gf_CC_PlayerMasteryCategoryPointsAtLevel(lp_player, lv_category, CMUIX_MasteryPointsCurrentDefault());
    if ((ModI((lv_internalIndex - 1), 2) == 0)) {
        return CMUIX_ClampInt(lv_categoryPoints, 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL);
    }

    return CMUIX_ClampInt((lv_categoryPoints - libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL), 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL);
}

void CMUIX_PlayerMasteryUpgradesSetDefault(int lp_player) {
    string lv_masteryUpgrade;
    int lv_index;
    int lv_count;

    lv_masteryUpgrade = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((lv_masteryUpgrade != "") && (lv_masteryUpgrade != null)) {
            libCOOC_gf_CC_PlayerMasteryUpgradeLevelSet(lp_player, lv_masteryUpgrade, CMUIX_DefaultMasteryUpgradeLevel(lp_player, lv_masteryUpgrade));
        }

        lv_index += 1;
    }
}

void CMUIX_EnsureDefaultAIMastery(int lp_player) {
    int lv_cap;
    string lv_commander;

    lv_cap = CMUIX_MasteryPointsCurrentDefault();
    lv_commander = "";
    if ((CMUIX_PlayerShouldUseDefaultAIMastery(lp_player) == false)) {
        return;
    }

    lv_commander = CMUIX_CommanderForPlayer(lp_player);
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == false)) {
        lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    }

    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true) && (CMUIX_CommanderMasteryUnlocked(lp_player, lv_commander) == false)) {
        CMUIX_ApplyCommanderMasteryGate(lp_player, lv_commander);
        return;
    }

    libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_player, true);
    libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, lv_cap);
    CMUIX_PlayerMasteryUpgradesSetDefault(lp_player);
}

bool CMUIX_AllianceCustomizationButtonShouldShow(int lp_viewer, int lp_targetPlayer) {
    if ((lp_viewer == 1) && (lp_targetPlayer == 2) && (PlayerType(2) == c_playerTypeUser)) {
        return false;
    }

    if ((CMUIX_PlayerCommanderSelectionIsRandom(lp_targetPlayer) == true)) {
        return false;
    }

    return true;
}

void CMUIX_CustomizationSetAllianceRandomState(int lp_viewer, bool lp_random) {
    playergroup lv_group;
    string lv_state;

    lv_group = PlayerGroupSingle(lp_viewer);
    lv_state = "NotRandom";
    if ((lp_random == true)) {
        lv_state = "Random";
    }

    if ((CMUIX_IsControlValid(CMUIX_AllianceStatePanel) == true)) {
        DialogControlSetAnimationState(CMUIX_AllianceStatePanel, lv_group, "RandomState", lv_state);
    }

    if ((CMUIX_IsControlValid(CMUIX_AllianceDetailsBackground) == true)) {
        DialogControlSetAnimationState(CMUIX_AllianceDetailsBackground, lv_group, "RandomState", lv_state);
    }

    CMUIX_SetControlVisible(CMUIX_AllianceMasterySpentLabel, lv_group, (lp_random == false));
}

void CMUIX_CustomizationRefreshAllianceControls(int lp_viewer, int lp_targetPlayer) {
    playergroup lv_group;
    bool lv_visible;
    bool lv_enabled;

    lv_group = PlayerGroupSingle(lp_viewer);
    lv_visible = CMUIX_AllianceCustomizationButtonShouldShow(lp_viewer, lp_targetPlayer);
    lv_enabled = false;
    if ((lv_visible == true) && (CMUIX_ReadyCanEditData(lp_viewer) == true)) {
        lv_enabled = true;
    }

    CMUIX_SetControlVisible(CMUIX_AllianceCustomizationButton, lv_group, lv_visible);
    CMUIX_SetControlEnabled(CMUIX_AllianceCustomizationButton, lv_group, lv_enabled);
}

int CMUIX_DefaultAllianceTarget(int lp_operator) {
    int lv_target;

    if ((lp_operator == 1) && (PlayerType(2) != c_playerTypeUser)) {
        return 2;
    }

    lv_target = libCOOC_gf_CC_PlayerAlly(lp_operator);
    if ((lv_target >= 1) && (lv_target <= libCOOC_gv_cCC_MAXPLAYERS)) {
        return lv_target;
    }

    if ((lp_operator == 1)) {
        return 2;
    }

    return 1;
}

bool CMUIX_AllianceStateIsExpanded(int lp_viewer) {
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    return CMUIX_AllianceStateExpanded[lp_viewer];
}

bool CMUIX_AllianceCommanderTargetButtonShouldShow(int lp_viewer) {
    int lv_targetPlayer;

    lv_targetPlayer = 0;
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_AllianceStateIsExpanded(lp_viewer) == false)) {
        return false;
    }

    lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
    if ((CMUIX_PlayerIsUser(lv_targetPlayer) == true)) {
        return false;
    }

    return true;
}

void CMUIX_CustomizationRefreshAllianceCommanderTargetButton(int lp_viewer) {
    bool lv_enabled;
    bool lv_visible;
    playergroup lv_playerGroup;
    text lv_label;

    lv_enabled = false;
    lv_visible = false;
    lv_label = StringExternal("CMUI/ScreenCoopCampaign/AllianceState/CommanderTargetSelf");
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_visible = CMUIX_AllianceCommanderTargetButtonShouldShow(lp_viewer);
    if ((lv_visible == false)) {
        CMUIX_AllianceCommanderSelectionEnabled[lp_viewer] = false;
    }

    if ((CMUIX_AllianceCommanderSelectionEnabled[lp_viewer] == true)) {
        lv_enabled = true;
        lv_label = StringExternal("CMUI/ScreenCoopCampaign/AllianceState/CommanderTargetAlly");
    }

    lv_playerGroup = PlayerGroupSingle(lp_viewer);
    if ((CMUIX_IsControlValid(CMUIX_AllianceCommanderTargetButton) == true)) {
        CMUIX_SetControlVisible(CMUIX_AllianceCommanderTargetButton, lv_playerGroup, lv_visible);
        CMUIX_SetControlEnabled(CMUIX_AllianceCommanderTargetButton, lv_playerGroup, lv_visible);
        libNtve_gf_SetDialogItemToggled(CMUIX_AllianceCommanderTargetButton, lv_enabled, lv_playerGroup);
        libNtve_gf_SetDialogItemText(CMUIX_AllianceCommanderTargetButton, lv_label, lv_playerGroup);
    }
}

bool CMUIX_AllianceCommanderClickTargetsAlly(int lp_viewer) {
    int lv_targetPlayer;

    lv_targetPlayer = 0;
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_AllianceStateIsExpanded(lp_viewer) == false)) {
        return false;
    }

    if ((CMUIX_AllianceCommanderSelectionEnabled[lp_viewer] == false)) {
        return false;
    }

    if ((lp_viewer == 1) && (PlayerType(2) != c_playerTypeUser)) {
        return true;
    }

    lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
    if ((lv_targetPlayer < 1) || (lv_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS) || (lv_targetPlayer == lp_viewer)) {
        return false;
    }

    if ((CMUIX_PlayerIsUser(lv_targetPlayer) == true)) {
        return false;
    }

    return true;
}

int CMUIX_CommanderClickTargetPlayer(int lp_viewer) {
    if ((CMUIX_AllianceCommanderClickTargetsAlly(lp_viewer) == true)) {
        return CMUIX_DefaultAllianceTarget(lp_viewer);
    }

    return lp_viewer;
}

// Committed mastery/prestige values are read here. The customization dialog
// copies them into draft arrays and only writes back when Accept is clicked.
int CMUIX_MasterySpentForCommander(int lp_player, string lp_commander) {
    int lv_index;
    int lv_end;
    int lv_spent;
    string lv_masteryUpgrade;

    lv_index = 1;
    lv_end = UserDataInstanceCount("MasteryUpgrades");
    lv_spent = 0;
    lv_masteryUpgrade = "";
    if ((lp_commander == "")) {
        return 0;
    }

    while ((lv_index <= lv_end)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((UserDataGetUserInstance("MasteryUpgrades", lv_masteryUpgrade, "Commander", 1) == lp_commander)) {
            lv_spent += libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lp_player, lv_masteryUpgrade);
        }

        lv_index += 1;
    }

    return lv_spent;
}

string CMUIX_CommanderMasteryDisplayMode(int lp_spent) {
    if ((lp_spent >= libCOOC_gv_cCC_MASTERY_MAX_LEVEL)) {
        return "PrestigeMax";
    }

    if ((lp_spent > 0)) {
        return "Prestige";
    }

    return "Basic";
}

void CMUIX_RefreshCommanderMasteryVisualsForViewer(int lp_viewer) {
    int lv_index;
    int lv_commanderCount;
    int lv_selfSelection;
    int lv_allyPlayer;
    int lv_allySelection;
    int lv_selfSpent;
    int lv_allySpent;
    int lv_selfLevel;
    int lv_allyLevel;
    string lv_commander;
    string lv_selfState;
    string lv_allyState;
    string lv_levelState;
    playergroup lv_group;

    lv_index = 0;
    lv_commanderCount = UserDataInstanceCount("PlayerCommanders");
    lv_selfSelection = 0;
    lv_allyPlayer = 0;
    lv_allySelection = 0;
    lv_selfSpent = 0;
    lv_allySpent = 0;
    lv_selfLevel = 0;
    lv_allyLevel = 0;
    lv_commander = "";
    lv_selfState = "Hidden";
    lv_allyState = "Hidden";
    lv_levelState = "Basic";
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_group = PlayerGroupSingle(lp_viewer);
    lv_selfSelection = libCMUI_gv_selectedCommanderIndex[lp_viewer];
    lv_allyPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
    if ((lv_allyPlayer >= 1) && (lv_allyPlayer <= libCOOC_gv_cCC_MAXPLAYERS) && (lv_allyPlayer != lp_viewer)) {
        lv_allySelection = libCMUI_gv_selectedCommanderIndex[lv_allyPlayer];
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        lv_selfSpent = 0;
        lv_allySpent = 0;
        lv_selfLevel = 0;
        lv_allyLevel = 0;
        lv_commander = "";
        lv_selfState = "Hidden";
        lv_allyState = "Hidden";
        lv_levelState = "Basic";
        if ((lv_index < lv_commanderCount)) {
            lv_commander = UserDataInstance("PlayerCommanders", (lv_index + 1));
            if ((lv_selfSelection == (lv_index + 1))) {
                if ((CMUIX_CommanderMasteryUnlocked(lp_viewer, lv_commander) == true)) {
                    lv_selfSpent = CMUIX_MasterySpentForCommander(lp_viewer, lv_commander);
                    lv_selfState = CMUIX_CommanderMasteryDisplayMode(lv_selfSpent);
                    lv_levelState = lv_selfState;
                }
                else {
                    lv_selfLevel = libCOOC_gf_CC_CommanderLevel(lp_viewer, lv_commander);
                    lv_selfSpent = lv_selfLevel;
                    lv_selfState = "Hidden";
                    lv_levelState = "Basic";
                }
            }

            if ((lv_allySelection == (lv_index + 1))) {
                if ((CMUIX_CommanderMasteryUnlocked(lv_allyPlayer, lv_commander) == true)) {
                    lv_allySpent = CMUIX_MasterySpentForCommander(lv_allyPlayer, lv_commander);
                    lv_allyState = "Basic";
                }
                else {
                    lv_allyLevel = libCOOC_gf_CC_CommanderLevel(lv_allyPlayer, lv_commander);
                    lv_allySpent = lv_allyLevel;
                    lv_allyState = "Hidden";
                }
            }
        }

        if ((CMUIX_IsControlValid(CMUIX_CommanderItemLevelLabels[lv_index]) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_CommanderItemLevelLabels[lv_index], IntToText(lv_selfSpent), lv_group);
        }

        if ((CMUIX_IsControlValid(CMUIX_CommanderItemAllyLevelLabels[lv_index]) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_CommanderItemAllyLevelLabels[lv_index], IntToText(lv_allySpent), lv_group);
        }

        if ((CMUIX_IsControlValid(libCMUI_gv_commanderItems[lv_index]) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_group, "SelfMasteryDisplayState", lv_selfState);
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_group, "AllyMasteryDisplayState", lv_allyState);
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_group, "LevelState", lv_levelState);
        }

        lv_index += 1;
    }
}

void CMUIX_RefreshCommanderMasteryVisualsAll() {
    int lv_viewer;

    lv_viewer = 1;
    while ((lv_viewer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_RefreshCommanderMasteryVisualsForViewer(lv_viewer);
        lv_viewer += 1;
    }
}

int CMUIX_MasteryDraftSpentForTarget(int lp_targetPlayer) {
    int lv_index;
    int lv_spent;

    lv_index = 1;
    lv_spent = 0;
    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_spent += CMUIX_MasteryPointsSpent[lv_index][lp_targetPlayer];
        lv_index += 1;
    }

    return lv_spent;
}

text CMUIX_MasterySpentTextFromValues(int lp_spent, int lp_level) {
    return StringToText((IntToString(lp_spent) + " / " + IntToString(lp_level)));
}

string CMUIX_MasteryDisplayModeForSpent(int lp_spent) {
    if ((lp_spent == libCOOC_gv_cCC_MASTERY_MAX_LEVEL)) {
        return "PrestigeMax";
    }

    return "Prestige";
}

text CMUIX_MasterySpentText(int lp_player, string lp_commander) {
    int lv_spent;
    int lv_level;

    lv_spent = CMUIX_MasterySpentForCommander(lp_player, lp_commander);
    lv_level = libCOOC_gf_CC_PlayerMasteryLevel(lp_player);
    return CMUIX_MasterySpentTextFromValues(lv_spent, lv_level);
}

void CMUIX_CustomizationRefreshLevelLabel(int lp_viewer, int lp_spent, bool lp_allianceMode) {
    playergroup lv_group;

    lv_group = PlayerGroupSingle(lp_viewer);
    if ((lp_allianceMode == true)) {
        if ((CMUIX_IsControlValid(CMUIX_AllianceLevelLabel) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_AllianceLevelLabel, IntToText(lp_spent), lv_group);
        }
    }
    else {
        if ((CMUIX_IsControlValid(CMUIX_DetailsLevelLabel) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_DetailsLevelLabel, IntToText(lp_spent), lv_group);
        }
    }
}

void CMUIX_CustomizationRefreshSpentLabelWithValues(int lp_viewer, int lp_spent, int lp_level, bool lp_allianceMode) {
    playergroup lv_group;
    text lv_text;
    string lv_mode;

    lv_group = PlayerGroupSingle(lp_viewer);
    lv_text = CMUIX_MasterySpentTextFromValues(lp_spent, lp_level);
    lv_mode = CMUIX_MasteryDisplayModeForSpent(lp_spent);
    CMUIX_CustomizationRefreshLevelLabel(lp_viewer, lp_spent, lp_allianceMode);
    CMUIX_CustomizationSetLevelDisplayMode(lp_viewer, lp_allianceMode, lv_mode);
    if ((lp_allianceMode == true)) {
        if ((CMUIX_IsControlValid(CMUIX_AllianceMasterySpentLabel) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_AllianceMasterySpentLabel, lv_text, lv_group);
        }
    }
    else {
        if ((CMUIX_IsControlValid(CMUIX_DetailsMasterySpentLabel) == true)) {
            libNtve_gf_SetDialogItemText(CMUIX_DetailsMasterySpentLabel, lv_text, lv_group);
        }
    }
}

void CMUIX_CustomizationRefreshSpentLabel(int lp_viewer, int lp_targetPlayer, string lp_commander, bool lp_allianceMode) {
    int lv_spent;
    int lv_level;
    playergroup lv_group;
    int lv_label;

    if ((lp_commander == "")) {
        return;
    }

    lv_group = PlayerGroupSingle(lp_viewer);
    lv_label = CMUIX_DetailsMasterySpentLabel;
    if ((lp_allianceMode == true)) {
        lv_label = CMUIX_AllianceMasterySpentLabel;
    }

    if ((CMUIX_CommanderMasteryUnlocked(lp_targetPlayer, lp_commander) == false)) {
        lv_level = libCOOC_gf_CC_CommanderLevel(lp_targetPlayer, lp_commander);
        CMUIX_CustomizationRefreshLevelLabel(lp_viewer, lv_level, lp_allianceMode);
        CMUIX_CustomizationSetLevelDisplayMode(lp_viewer, lp_allianceMode, "Normal");
        CMUIX_SetControlText(lv_label, lv_group, StringToText("Basic"));
        CMUIX_CustomizationRefreshBasicStatus(lp_viewer, lp_targetPlayer, lp_commander, lp_allianceMode);
        return;
    }

    lv_spent = CMUIX_MasterySpentForCommander(lp_targetPlayer, lp_commander);
    lv_level = libCOOC_gf_CC_PlayerMasteryLevel(lp_targetPlayer);
    CMUIX_CustomizationSetStatusTableVisible(lp_viewer, lp_allianceMode, true);
    CMUIX_CustomizationRefreshSpentLabelWithValues(lp_viewer, lv_spent, lv_level, lp_allianceMode);
}

void CMUIX_CustomizationRefreshOuterLabelsForPlayer(int lp_player) {
    string lv_commander;

    CMUIX_CustomizationHookup();
    lv_commander = CMUIX_CommanderForPlayer(lp_player);
    CMUIX_CustomizationRefreshExternalFromData(lp_player, lp_player, lv_commander, false);
}

void CMUIX_CustomizationOnCommanderSelected(int lp_player, int lp_selection) {
    string lv_commander;

    lv_commander = CMUIX_CommanderForSelection(lp_selection);
    CMUIX_CustomizationHookup();
    CMUIX_CustomizationRefreshExternalFromData(lp_player, lp_player, lv_commander, false);
    if ((CMUIX_TargetAllianceMode[lp_player] == false)) {
        CMUIX_CustomizationInitFromData(lp_player, lp_player, lv_commander, false);
    }
}

void CMUIX_CustomizationOnCommanderSelectedForTarget(int lp_viewer, int lp_targetPlayer, int lp_selection) {
    string lv_commander;

    lv_commander = "";
    if ((lp_targetPlayer == lp_viewer) || (lp_targetPlayer < 1) || (lp_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomizationOnCommanderSelected(lp_viewer, lp_selection);
        return;
    }

    lv_commander = CMUIX_CommanderForSelection(lp_selection);
    CMUIX_CustomizationHookup();
    CMUIX_CustomizationRefreshExternalFromData(lp_viewer, lp_targetPlayer, lv_commander, true);
    if ((CMUIX_TargetAllianceMode[lp_viewer] == true) && (CMUIX_TargetForOperator(lp_viewer) == lp_targetPlayer)) {
        CMUIX_CustomizationInitFromData(lp_viewer, lp_targetPlayer, lv_commander, true);
    }
}

void CMUIX_CustomizationRefreshAllianceLabelForPlayer(int lp_viewer, int lp_targetPlayer) {
    int lv_targetPlayer;
    string lv_commander;

    lv_targetPlayer = lp_targetPlayer;
    lv_commander = "";
    CMUIX_CustomizationHookup();
    if ((lv_targetPlayer <= 0)) {
        lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
    }

    lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
    CMUIX_CustomizationRefreshExternalFromData(lp_viewer, lv_targetPlayer, lv_commander, true);
}

void CMUIX_CustomizationRefreshCurrentSelectionForPlayer(int lp_player) {
    int lv_selection;
    int lv_targetPlayer;
    string lv_commander;

    lv_selection = CMUIX_CommanderSelectionIndexForPlayer(lp_player);
    lv_targetPlayer = 0;
    lv_commander = "";
    if ((lv_selection == 0)) {
        return;
    }

    CMUIX_CustomizationOnCommanderSelected(lp_player, lv_selection);
    lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_player);
    if ((lv_targetPlayer >= 1) && (lv_targetPlayer <= libCOOC_gv_cCC_MAXPLAYERS) && (lv_targetPlayer != lp_player)) {
        lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
        CMUIX_CustomizationRefreshExternalFromData(lp_player, lv_targetPlayer, lv_commander, true);
    }
}

void CMUIX_CustomizationRefreshCurrentSelections() {
    int lv_player;

    lv_player = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomizationRefreshCurrentSelectionForPlayer(lv_player);
        lv_player += 1;
    }

    CMUIX_RefreshCommanderMasteryVisualsAll();
}

int CMUIX_ReadPrestigeForCommander(int lp_player, string lp_commander) {
    int lv_index;
    string lv_key;
    string lv_prestige;

    lv_index = 0;
    lv_key = "";
    lv_prestige = "";
    if ((lp_commander == "")) {
        return 0;
    }

    lv_key = libCOOC_gf_CC_PrestigeCommanderTableKey(lp_commander, lp_player);
    if ((DataTableValueExists(true, lv_key) == true)) {
        lv_index = DataTableGetInt(true, lv_key);
    }
    else {
        if ((libCOOC_gf_ActiveCommanderForPlayer(lp_player) == lp_commander)) {
            lv_index = libCOOC_gf_CC_PlayerActivePrestigeIndex(lp_player);
        }
    }

    if ((lv_index <= 0)) {
        return 0;
    }

    lv_prestige = libCOOC_gf_CC_PlayerActivePrestigeInstance2(lp_commander, lv_index);
    if ((CMUIX_PrestigeAccessibleForPlayer(lp_player, lv_prestige) == false)) {
        return 0;
    }

    return lv_index;
}

void CMUIX_WritePrestigeForCommander(int lp_player, string lp_commander, int lp_index) {
    int lv_maxRank;
    int lv_index;
    string lv_key;
    string lv_prestige;

    lv_maxRank = 0;
    lv_index = 0;
    lv_key = "";
    lv_prestige = "";
    if ((lp_commander == "")) {
        return;
    }

    lv_maxRank = libCOOC_gf_CC_PlayerPrestigeMaxRank(lp_commander);
    lv_index = CMUIX_ClampInt(lp_index, 0, lv_maxRank);
    if ((lv_index > 0)) {
        lv_prestige = libCOOC_gf_CC_PlayerActivePrestigeInstance2(lp_commander, lv_index);
        if (CMUIX_PrestigeAccessibleForPlayer(lp_player, lv_prestige) == false) {
            lv_index = 0;
        }
    }

    lv_key = libCOOC_gf_CC_PrestigeCommanderTableKey(lp_commander, lp_player);
    DataTableSetInt(true, lv_key, lv_index);
    if ((libCOOC_gf_ActiveCommanderForPlayer(lp_player) == lp_commander)) {
        libCOOC_gf_CC_SetPlayerPrestigeIndex(lp_player, lv_index);
    }
}

void CMUIX_ApplyStoredPrestigeForCommander(int lp_player, string lp_commander) {
    int lv_index;

    lv_index = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return;
    }

    if ((libCOOC_gf_ActiveCommanderForPlayer(lp_player) != lp_commander)) {
        return;
    }

    lv_index = CMUIX_ReadPrestigeForCommander(lp_player, lp_commander);
    libCOOC_gf_CC_SetPlayerPrestigeIndex(lp_player, lv_index);
}

