    CMUIX_MutatorInfoChaosCostLabel = c_invalidDialogControlId;
    CMUIX_MutatorInfoChaosIncreaseButton = c_invalidDialogControlId;
    CMUIX_MutatorInfoChaosDecreaseButton = c_invalidDialogControlId;
