    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoContainer) == true)) {
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeLabel, "SummaryTitleLabel");
        CMUIX_MutatorInfoSummaryTitleLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeLabel, "SummaryBodyScrollFrame/ContainerFrame/SummaryBodyLabel");
        CMUIX_MutatorInfoSummaryBodyLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeLabel, "RandomSeedLabel");
        CMUIX_MutatorInfoRandomSeedLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeLabel, "SummaryStatusLabel");
        CMUIX_MutatorInfoSummaryStatusLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypePanel, "MutatorIconGroup");
        CMUIX_MutatorInfoIconGroup = DialogControlLastCreated();
        while ((lv_index < CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE)) {
            DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypePanel, ("Icon" + IntToString(lv_index)));
            CMUIX_MutatorInfoIcons[lv_index] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_MutatorInfoIcons[lv_index], c_triggerControlTypePanel, "IconImage");
            CMUIX_MutatorInfoIconImageFrames[lv_index] = DialogControlLastCreated();
            DialogControlHookup(CMUIX_MutatorInfoIconImageFrames[lv_index], c_triggerControlTypeImage, "Image");
            CMUIX_MutatorInfoIconImages[lv_index] = DialogControlLastCreated();
            lv_index += 1;
        }

        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypePanel, "MutatorIconPageSelector");
        CMUIX_MutatorInfoIconPageSelector = DialogControlLastCreated();
        if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIconPageSelector) == true)) {
            DialogControlHookup(CMUIX_MutatorInfoIconPageSelector, c_triggerControlTypeButton, "DecrementButton");
            CMUIX_MutatorInfoPrevPageButton = DialogControlLastCreated();
            DialogControlHookup(CMUIX_MutatorInfoIconPageSelector, c_triggerControlTypeButton, "IncrementButton");
            CMUIX_MutatorInfoNextPageButton = DialogControlLastCreated();
            lv_index = 0;
            while ((lv_index < CMUIX_MUTATOR_INFO_PAGE_BUTTON_MAX)) {
                DialogControlHookup(CMUIX_MutatorInfoIconPageSelector, c_triggerControlTypeButton, ("PageButton" + IntToString(lv_index)));
                CMUIX_MutatorInfoPageButtons[lv_index] = DialogControlLastCreated();
                lv_index += 1;
            }
        }

        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypePanel, "MutatorQuickControlPanel/MutatorRandomIcon");
        CMUIX_MutatorInfoRandomIcon = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoRandomIcon, c_triggerControlTypeLabel, "Cost");
        CMUIX_MutatorInfoRandomCostLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeButton, "MutatorQuickControlPanel/MutatorRandomIncress");
        CMUIX_MutatorInfoRandomIncreaseButton = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeButton, "MutatorQuickControlPanel/MutatorRandomDecress");
        CMUIX_MutatorInfoRandomDecreaseButton = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypePanel, "MutatorQuickControlPanel/MutatorChaosIcon");
        CMUIX_MutatorInfoChaosIcon = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoChaosIcon, c_triggerControlTypeLabel, "Cost");
        CMUIX_MutatorInfoChaosCostLabel = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeButton, "MutatorQuickControlPanel/MutatorChaosIncress");
        CMUIX_MutatorInfoChaosIncreaseButton = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeButton, "MutatorQuickControlPanel/MutatorChaosDecress");
        CMUIX_MutatorInfoChaosDecreaseButton = DialogControlLastCreated();
        DialogControlHookup(CMUIX_MutatorInfoContainer, c_triggerControlTypeButton, "RerollButton");
        CMUIX_MutatorInfoRerollButton = DialogControlLastCreated();
    }
}

// Ally panel state is script-owned. Layout animation is still responsible for
// visuals, but targeting logic must pass through this setter.
void CMUIX_CustomizationSetAllianceStateExpanded(int lp_player, bool lp_expanded) {
    int lv_targetPlayer;

    lv_targetPlayer = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    // This is the single script-owned source of truth for ally-control mode.
    // Layout animations may close the panel visually, but script callers that
    // close it must also route through this function to keep clicks targeted.
    CMUIX_AllianceStateExpanded[lp_player] = lp_expanded;
    if ((lp_expanded == false)) {
        CMUIX_AllianceCommanderSelectionEnabled[lp_player] = false;
        CMUIX_CustomizationRefreshAllianceCommanderTargetButton(lp_player);
        return;
    }

    if ((lp_expanded == true)) {
        lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_player);
        CMUIX_CustomizationRefreshAllianceCommanderTargetButton(lp_player);
        CMUIX_CustomizationRefreshAllianceLabelForPlayer(lp_player, lv_targetPlayer);
    }
}

void CMUIX_CustomizationToggleAllianceState(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_AllianceStateExpanded[lp_player] == true)) {
        CMUIX_CustomizationSetAllianceStateExpanded(lp_player, false);
    }
    else {
        CMUIX_CustomizationSetAllianceStateExpanded(lp_player, true);
    }
}

// One generic click handler owns customization controls. Core commander/map
// handlers run beside it, so this function only handles extra UI state and drafts.
bool CMUIX_CustomizationClickHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_targetPlayer;
    int lv_index;
    int lv_category;
    int lv_delta;
    int lv_commanderSelection;
    string lv_commander;
    string lv_prestige;

    lv_player = EventPlayer();
    lv_targetPlayer = CMUIX_TargetForOperator(lv_player);
    lv_index = 1;
    lv_category = 0;
    lv_delta = 1;
    lv_commanderSelection = 0;
    lv_commander = "";
    lv_prestige = "";
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_HistoryHandleControlEvent(lv_player, EventDialogControl()) == true)) {
        return true;
    }

    if ((CMUIX_ReadyInputLocked(lv_player, EventDialogControl()) == true)) {
        return true;
    }

    if ((CMUIX_HomeHandleControlEvent(lv_player, EventDialogControl()) == true)) {
        return true;
    }

    if ((CMUIX_PersonalizationHandleControlEvent(lv_player, EventDialogControl()) == true)) {
        return true;
    }

    if ((EventDialogControl() == CMUIX_AllianceStateButton)) {
        CMUIX_CustomizationToggleAllianceState(lv_player);
        return true;
    }

    if ((EventDialogControl() == CMUIX_AllianceStateCloseButton)) {
        CMUIX_CustomizationSetAllianceStateExpanded(lv_player, false);
        return true;
    }

    if ((EventDialogControl() == CMUIX_MutatorInfoButton)) {
        CMUIX_CustomizationSetAllianceStateExpanded(lv_player, false);
        CMUIX_MutatorInfoRefreshForPlayer(lv_player);
        return true;
    }

    if ((EventDialogControl() == CMUIX_AllianceCommanderTargetButton)) {
        if ((CMUIX_AllianceCommanderTargetButtonShouldShow(lv_player) == false)) {
            CMUIX_AllianceCommanderSelectionEnabled[lv_player] = false;
            CMUIX_CustomizationRefreshAllianceCommanderTargetButton(lv_player);
            return true;
        }

        if ((CMUIX_AllianceCommanderSelectionEnabled[lv_player] == true)) {
            CMUIX_AllianceCommanderSelectionEnabled[lv_player] = false;
        }
        else {
            CMUIX_AllianceCommanderSelectionEnabled[lv_player] = true;
        }

        CMUIX_CustomizationRefreshAllianceCommanderTargetButton(lv_player);
        return true;
    }

    if ((EventDialogControl() == CMUIX_SelfMasteryButton)) {
        CMUIX_CustomizationOpenSelf(lv_player);
        return true;
    }

    if ((EventDialogControl() == CMUIX_AllianceCustomizationButton)) {
        if ((CMUIX_AllianceCustomizationButtonShouldShow(lv_player, CMUIX_DefaultAllianceTarget(lv_player)) == false)) {
            return true;
        }

        CMUIX_CustomizationOpenAlliance(lv_player, 0);
        return true;
    }

    if ((EventDialogControl() == CMUIX_MasteryAcceptButton)) {
        CMUIX_CustomizationAccept(lv_player);
        return true;
    }

    if ((EventDialogControl() == CMUIX_MasteryCancelButton)) {
        CMUIX_CustomizationInitFromData(lv_player, lv_targetPlayer, CMUIX_TargetCommander[lv_player], CMUIX_TargetAllianceMode[lv_player]);
        return true;
    }

    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        if ((EventDialogControl() == CMUIX_MasteryPlusButtons[lv_index])) {
            if ((CMUIX_MasteryUpgrades[lv_index][lv_targetPlayer] != "")) {
                lv_category = libCOOC_gf_CC_PlayerMasteryCategory(CMUIX_MasteryUpgrades[lv_index][lv_targetPlayer]);
                lv_delta = 1;
                if ((CMUIX_MasteryShiftPressed[lv_player] == true)) {
                    lv_delta = 10;
                }

                if ((lv_category >= 1) && (lv_category <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
                    lv_delta = MinI(lv_delta, CMUIX_MasteryCategoryPointsLeft[lv_category][lv_targetPlayer]);
                    CMUIX_MasteryPointsSpent[lv_index][lv_targetPlayer] = CMUIX_ClampInt((CMUIX_MasteryPointsSpent[lv_index][lv_targetPlayer] + lv_delta), 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL);
                    CMUIX_CustomizationRefresh(lv_player);
                }
            }

            return true;
        }

        if ((EventDialogControl() == CMUIX_MasteryMinusButtons[lv_index])) {
            if ((CMUIX_MasteryUpgrades[lv_index][lv_targetPlayer] != "")) {
                lv_delta = 1;
                if ((CMUIX_MasteryShiftPressed[lv_player] == true)) {
                    lv_delta = 10;
                }

                CMUIX_MasteryPointsSpent[lv_index][lv_targetPlayer] = CMUIX_ClampInt((CMUIX_MasteryPointsSpent[lv_index][lv_targetPlayer] - lv_delta), 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL);
                CMUIX_CustomizationRefresh(lv_player);
            }

            return true;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
        if ((EventDialogControl() == CMUIX_PrestigeItems[lv_index])) {
            if ((lv_index > 0)) {
                lv_commander = CMUIX_TargetCommander[lv_player];
                lv_prestige = libCOOC_gf_CC_PlayerActivePrestigeInstance2(lv_commander, lv_index);
                if ((CMUIX_PrestigeAccessibleForPlayer(lv_player, lv_prestige) == false) || (CMUIX_PrestigeAccessibleForPlayer(lv_targetPlayer, lv_prestige) == false)) {
                    return true;
                }
            }

            CMUIX_PrestigeSelected[lv_targetPlayer] = lv_index;
            CMUIX_CustomizationUpdatePrestigeDisplay(lv_player, lv_targetPlayer);
            return true;
        }

        lv_index += 1;
    }

    lv_commanderSelection = CMUIX_CommanderSelectionForControl(EventDialogControl());
    if ((lv_commanderSelection != 0)) {
        return true;
    }

    return true;
}

bool CMUIX_CustomizationShiftDownHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    CMUIX_MasteryShiftPressed[EventPlayer()] = true;
    return true;
}

bool CMUIX_CustomizationShiftUpHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    CMUIX_MasteryShiftPressed[EventPlayer()] = false;
    return true;
}

void CMUIX_CustomizationCreateTriggers() {
    if ((CMUIX_CustomizationTriggersReady == true)) {
        return;
    }

    CMUIX_CustomizationTriggersReady = true;
    CMUIX_CustomizationClickTrigger = TriggerCreate("CMUIX_CustomizationClickHandler");
    TriggerEnable(CMUIX_CustomizationClickTrigger, false);
    TriggerAddEventDialogControl(CMUIX_CustomizationClickTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(CMUIX_CustomizationClickTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeChecked);
    TriggerAddEventDialogControl(CMUIX_CustomizationClickTrigger, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeValueChanged);
    CMUIX_CustomizationShiftDownTrigger = TriggerCreate("CMUIX_CustomizationShiftDownHandler");
    TriggerEnable(CMUIX_CustomizationShiftDownTrigger, false);
    TriggerAddEventKeyPressed(CMUIX_CustomizationShiftDownTrigger, c_playerAny, c_keyShift, true, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
    CMUIX_CustomizationShiftUpTrigger = TriggerCreate("CMUIX_CustomizationShiftUpHandler");
    TriggerEnable(CMUIX_CustomizationShiftUpTrigger, false);
    TriggerAddEventKeyPressed(CMUIX_CustomizationShiftUpTrigger, c_playerAny, c_keyShift, false, c_keyModifierStateIgnore, c_keyModifierStateIgnore, c_keyModifierStateIgnore);
}

void CMUIX_CustomizationSetTriggersEnabled(bool lp_enabled) {
    if ((CMUIX_CustomizationClickTrigger != null)) {
        TriggerEnable(CMUIX_CustomizationClickTrigger, lp_enabled);
    }

    if ((CMUIX_CustomizationShiftDownTrigger != null)) {
        TriggerEnable(CMUIX_CustomizationShiftDownTrigger, lp_enabled);
    }

    if ((CMUIX_CustomizationShiftUpTrigger != null)) {
        TriggerEnable(CMUIX_CustomizationShiftUpTrigger, lp_enabled);
    }
}

void CMUIX_SetCommanderSelectionUIActive(bool lp_enabled) {
    CMUIX_CoreSetSelectionTriggersEnabled(lp_enabled);
    CMUIX_CustomizationSetTriggersEnabled(lp_enabled);
}

void CMUIX_DestroyLauncherUIInternal(bool lp_resetConsole) {
    int lv_player;

    lv_player = 0;
    CMUIX_ReadyCountdownRunning = false;
    if ((libCMUI_gv_screenCoopDialog != c_invalidDialogId)) {
        DialogSetVisible(libCMUI_gv_screenCoopDialog, PlayerGroupAll(), false);
    }

    CMUIX_SetCommanderSelectionUIActive(false);
    CMUIX_CustomMutatorPickerClearChatForAll();
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomMutatorPickerOpenStates[lv_player] = false;
        CMUIX_MutatorPoolPageOpen[lv_player] = false;
        lv_player += 1;
    }

    if ((libCMUI_gv_screenCoopDialog != c_invalidDialogId)) {
        DialogDestroy(libCMUI_gv_screenCoopDialog);
    }

    if ((lp_resetConsole == true) && (CMUIX_ConsoleHooked == true)) {
        if ((CMUIX_IsControlValid(CMUIX_ConsolePanel) == true)) {
            DialogControlSetVisible(CMUIX_ConsolePanel, PlayerGroupAll(), false);
        }

        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnPanel) == true)) {
            DialogControlSetVisible(CMUIX_ConsoleSpawnPanel, PlayerGroupAll(), false);
        }

        if ((CMUIX_IsControlValid(CMUIX_ConsoleAuthPanel) == true)) {
            DialogControlSetVisible(CMUIX_ConsoleAuthPanel, PlayerGroupAll(), false);
        }
    }

    libCMUI_gv_screenCoopDialog = c_invalidDialogId;
    libCMUI_gv_screenNavigationMain = c_invalidDialogControlId;
    libCMUI_gv_screenCoopMain = c_invalidDialogControlId;
    libCMUI_gv_screenCoopCommanderSelectionPanel = c_invalidDialogControlId;
    libCMUI_gv_screenCoopNavigationBar = c_invalidDialogControlId;
    CMUIX_ReadyButton = c_invalidDialogControlId;
    CMUIX_ReadyCancelButton = c_invalidDialogControlId;
    CMUIX_ReadyStatusPanel = c_invalidDialogControlId;
    CMUIX_ReadyStatusCancelButton = c_invalidDialogControlId;
    CMUIX_RandomSeedEditBox = c_invalidDialogControlId;
    CMUIX_RandomSeedRefreshButton = c_invalidDialogControlId;
    CMUIX_RandomSeedInputRefreshing = false;
    CMUIX_RandomSeedDraftExplicit = false;
    CMUIX_RandomSeedDraft = 0;
    CMUIX_MutatorInfoRandomSeedLabel = c_invalidDialogControlId;
    CMUIX_ScorePanel = c_invalidDialogControlId;
    CMUIX_ScoreRetryButton = c_invalidDialogControlId;
    CMUIX_HomeResetHookState();
    CMUIX_CustomMutatorPickerHooked = false;
    CMUIX_MutatorPoolHooked = false;
    CMUIX_CustomMutatorPickerFullscreenUpperContainer = c_invalidDialogControlId;
    if ((lp_resetConsole == true)) {
        CMUIX_ConsoleRootContainer = c_invalidDialogControlId;
        CMUIX_ConsoleEntryButton = c_invalidDialogControlId;
        CMUIX_ConsoleHooked = false;
    }
}

void CMUIX_DestroyLauncherUI() {
    CMUIX_DestroyLauncherUIInternal(true);
}

bool CMUIX_LauncherUICommandAvailable(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_CurrentStartupPath() != CMUIX_STARTUP_PATH_DIRECT)) {
        return false;
    }
    if (CMUIX_RuntimePermissionShareUsed == true) {
        return false;
    }

    return true;
}

void CMUIX_ResetLauncherHookStateForRebuild() {
    int lv_player;
    int lv_view;

    lv_player = 0;
    lv_view = 0;
    CMUIX_HomeResetHookState();
    CMUIX_HistoryHooked = false;
    CMUIX_CustomizationHooked = false;
    CMUIX_CustomMutatorPickerHooked = false;
    CMUIX_MutatorPoolHooked = false;
    CMUIX_CommanderDataReady = false;
    CMUIX_StartupListsReady = false;
    CMUIX_CustomMutatorPickerRefreshing = false;
    CMUIX_MutatorPoolRefreshing = false;
    CMUIX_PersonalizationRefreshing = false;
    CMUIX_CustomMutatorPickerPageIndex = 1;
    CMUIX_CustomMutatorPickerVisibleCount = 0;
    CMUIX_CustomMutatorPickerSearchText = "";
    CMUIX_MutatorPoolCurrentView = 1;
    CMUIX_MutatorInfoResetPages();
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomMutatorPickerOpenStates[lv_player] = false;
        CMUIX_CustomMutatorPickerPlayerPageIndex[lv_player] = 1;
        CMUIX_CustomMutatorPickerPlayerVisibleCount[lv_player] = 0;
        CMUIX_CustomMutatorPickerPlayerSearchText[lv_player] = "";
        CMUIX_MutatorPoolPageOpen[lv_player] = false;
        CMUIX_TargetPlayer[lv_player] = 0;
        CMUIX_TargetAllianceMode[lv_player] = false;
        CMUIX_TargetCommander[lv_player] = "";
        CMUIX_AllianceStateExpanded[lv_player] = false;
        CMUIX_AllianceCommanderSelectionEnabled[lv_player] = false;
        CMUIX_MasteryShiftPressed[lv_player] = false;
        lv_player += 1;
    }

    while ((lv_view <= CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        CMUIX_MutatorPoolPageIndex[lv_view] = 1;
        CMUIX_MutatorPoolVisibleCount[lv_view] = 0;
        CMUIX_MutatorPoolSearchText[lv_view] = "";
        lv_view += 1;
    }
}

bool CMUIX_RebuildLauncherUIForPlayer(int lp_player) {
    if ((CMUIX_LauncherUICommandAvailable(lp_player) == false)) {
        return false;
    }

    CMUIX_DestroyLauncherUIInternal(false);
    CMUIX_ResetLauncherHookStateForRebuild();
    CMUIX_Init();
    CMUIX_StartupRefreshControls();
    return CMUIX_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel);
}

void CMUIX_Shutdown() {
    CMUIX_DestroyLauncherUI();
}

void CMUIX_CustomizationHookup() {
    bool lv_needCommanderInit;

    lv_needCommanderInit = (CMUIX_CommanderDataReady == false);
    CMUIX_CoreInit();
    CMUIX_CustomizationVariablesInit();
    if ((CMUIX_CustomizationHooked == true)) {
        CMUIX_SetCommanderSelectionUIActive(true);
        return;
    }

    if ((CMUIX_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == false)) {
        libCMUI_gf_ScreenCoopUIHookup();
    }

    DialogControlHookup(libCMUI_gv_screenCoopCommanderSelectionPanel, c_triggerControlTypeButton, "MasteryButton");
    CMUIX_SelfMasteryButton = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "CustomizationSelectionPanel");
    CMUIX_CustomizationPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomizationPanel, c_triggerControlTypePanel, "MasterySelectionPanel");
    CMUIX_MasteryPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomizationPanel, c_triggerControlTypePanel, "CommanderPrestigePanel");
    CMUIX_PrestigePanel = DialogControlLastCreated();
    CMUIX_CustomizationHookupMastery();
    CMUIX_CustomizationHookupPrestige();
    CMUIX_CustomizationHookupPersonalization();
    CMUIX_CustomizationHookupDetails();
    CMUIX_CustomizationCreateTriggers();
    CMUIX_CustomizationHooked = true;
    CMUIX_SetCommanderSelectionUIActive(true);
    if ((lv_needCommanderInit == true)) {
        libCMUI_gf_ScreenCoopCommanderInitFromData();
    }

    CMUIX_CustomizationRefreshCurrentSelections();
    CMUIX_MutatorInfoRefreshAll();
}

// Public entry point exposed to the editor. Call once after the rebuilt coop
// screen exists; repeated calls are safe and re-enable the UI triggers.
void CMUIX_Init() {
    CMUIX_CustomizationHookup();
    CMUIX_SetCommanderSelectionUIActive(true);
}

include "scripts/cmui_console_commands"
