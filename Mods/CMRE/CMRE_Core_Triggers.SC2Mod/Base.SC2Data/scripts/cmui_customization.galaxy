void CMUIX_CreateScreenCoopDialog() {
    if ((libCMUI_gv_screenCoopDialog != c_invalidDialogId)) {
        if ((CMUICore_IsControlValid(libCMUI_gv_screenCoopMain) == false) && (CMUICore_IsControlValid(libCMUI_gv_screenNavigationMain) == true)) {
            DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "ScreenCoopPanel/ScreenCoopCampaign");
            libCMUI_gv_screenCoopMain = DialogControlLastCreated();
        }
        return;
    }

    DialogCreate(500, 400, c_anchorCenter, 0, 0, true);
    DialogSetFullscreen(DialogLastCreated(), true);
    DialogSetRenderPriority(DialogLastCreated(), 550);
    DialogSetImageVisible(DialogLastCreated(), false);
    libCMUI_gv_screenCoopDialog = DialogLastCreated();
    DialogControlCreateFromTemplate(libCMUI_gv_screenCoopDialog, c_triggerControlTypePanel, "CM_ScreenNavigationSC2/CM_ScreenNavigationSC2Template");
    libCMUI_gv_screenNavigationMain = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "ScreenCoopPanel/ScreenCoopCampaign");
    libCMUI_gv_screenCoopMain = DialogControlLastCreated();
    DialogSetVisible(libCMUI_gv_screenCoopDialog, PlayerGroupAll(), true);
}

void libCMUI_gf_ScreenCoopUIHookup() {
    int lv_index;

    lv_index = 0;
    if ((CMUIX_CoreReady == false)) {
        CMUIX_CoreInit();
    }

    CMUIX_CreateScreenCoopDialog();
    CMUIX_HomeHookup();
    CMUIX_HomeRefreshAll();
    CMUIX_HistoryHookup();
    DialogControlHookup(libCMUI_gv_screenCoopMain, c_triggerControlTypePanel, "CommanderSelectionPanel");
