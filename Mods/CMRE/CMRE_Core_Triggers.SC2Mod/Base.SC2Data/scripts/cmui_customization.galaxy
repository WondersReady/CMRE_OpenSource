}

text CMUIX_ConsoleCommandToggleResultText(int lp_player, int lp_index) {
    if ((CMUIX_ConsoleCommandToggleStateEnabled(lp_index, lp_player) == true)) {
        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOn");
    }

    if ((lp_index == 151) && (libCOOC_gf_ActiveCommanderForPlayer(lp_player) != "TerranNova") && (libCOOC_gf_ActiveCommanderForPlayer(lp_player) != "TerranHorner")) {
        return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultToggle");
    }

    return CMUIX_ConsoleCommandResultVariantText(lp_index, "ResultOff");
}

text CMUIX_ConsoleToggleButtonStateText(bool lp_enabled) {
    if ((lp_enabled == true)) {
        return StringExternal("CMUI/Console/ToggleStateOn");
    }

    return StringExternal("CMUI/Console/ToggleStateOff");
}

void CMUIX_ConsoleSetToggleButtonVisualState(int lp_index, bool lp_enabled, playergroup lp_players) {
    text lv_label;

    lv_label = CMUIX_ConsoleToggleButtonStateText(lp_enabled);
    if ((lp_index < 1) || (lp_index > CMUIX_CONSOLE_COMMAND_MAX)) {
