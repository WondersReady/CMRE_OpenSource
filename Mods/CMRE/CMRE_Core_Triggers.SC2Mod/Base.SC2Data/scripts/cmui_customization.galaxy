bool CMUIX_HistoryHandleControlEvent(int lp_player, int lp_control) {
    int lv_slot;
    int lv_source;
    string lv_payload;
    string lv_key;
    string lv_sourceProfileKey;
    string lv_sourceHistoryKey;

    lv_slot = 1;
    lv_source = CMUIX_LAUNCH_SOURCE_PROFILE;
    lv_payload = "";
    lv_key = "";
    lv_sourceProfileKey = "";
    lv_sourceHistoryKey = "";
    if ((CMUIX_HistoryHooked == false) || (lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_control == CMUIX_MainNavigationRebuildButton)) {
        CMUIX_RebuildLauncherUIForPlayer(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MainNavigationCoopButton)) {
        CMUIX_ProfileRefreshModeVisualsDeferred();
        CMUIX_MutatorPoolRefreshOpenButtons();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    if ((lp_control == CMUIX_MainNavigationHomeButton)) {
        CMUIX_HomeRefreshAll();
        return true;
    }

    if ((lp_control == CMUIX_MainNavigationHistoryButton)) {
        CMUIX_HistoryRefreshForPlayer(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_HistoryGameHistoryButton)) {
        CMUIX_HistoryViewingProfiles[lp_player] = false;
        CMUIX_HistoryRefreshForPlayer(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_HistoryProfileTemplatesButton)) {
        CMUIX_HistoryViewingProfiles[lp_player] = true;
        CMUIX_HistoryRefreshForPlayer(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_HistoryRecordsPreviousPageButton)) {
        if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
            CMUIX_HistoryProfilesPageIndex[lp_player] -= 1;
        }
        else {
            CMUIX_HistoryRecordsPageIndex[lp_player] -= 1;
        }

        CMUIX_HistoryRefreshForPlayer(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_HistoryRecordsNextPageButton)) {
        if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
            CMUIX_HistoryProfilesPageIndex[lp_player] += 1;
        }
        else {
            CMUIX_HistoryRecordsPageIndex[lp_player] += 1;
        }

        CMUIX_HistoryRefreshForPlayer(lp_player);
        return true;
    }

    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        if ((lp_control == CMUIX_HistoryRecordItems[lv_slot])) {
            if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
                lv_key = CMUIX_HistoryProfileRowKeys[lp_player][lv_slot];
                if ((lv_key != "")) {
                    CMUIX_HistoryProfileSelectedKey[lp_player] = lv_key;
                    CMUIX_HistoryRenderProfileDetails(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
                }
            }
            else {
                lv_key = CMUIX_HistoryRecordRowKeys[lp_player][lv_slot];
                if ((lv_key != "")) {
                    CMUIX_HistoryRecordSelectedKey[lp_player] = lv_key;
                    CMUIX_HistoryRenderRecordDetails(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
                }
            }

            return true;
        }

        lv_slot += 1;
    }

    if ((lp_control == CMUIX_HistoryRecordApplyButton)) {
        if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
            lv_payload = CMUIX_HistoryProfilePayloadForKey(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
        }
        else {
            lv_payload = CMUIX_HistoryRecordPayloadForKey(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
        }

        if ((CMUIX_HistoryCanApplyPayloadForPlayer(lp_player, lv_payload) == false)) {
            CMUIX_ProfileMessage(lp_player, TextToString(CMUIX_HistoryApplyTooltipForPayload(lp_player, lv_payload)));
            CMUIX_HistoryRefreshActionButtons(lp_player);
            return true;
        }

        if ((lv_payload != "")) {
            lv_source = CMUIX_LAUNCH_SOURCE_PROFILE;
            if ((CMUIX_HistoryViewingProfiles[lp_player] == false)) {
                lv_source = CMUIX_LAUNCH_SOURCE_HISTORY;
                lv_sourceHistoryKey = CMUIX_HistoryRecordSelectedKey[lp_player];
                if ((CMUIX_HistoryRecordIsProfileSource(lv_payload) == true)) {
                    lv_source = CMUIX_LAUNCH_SOURCE_PROFILE;
                }
            }
            else {
                lv_sourceProfileKey = CMUIX_HistoryProfileSelectedKey[lp_player];
            }

            if ((CMUIX_ProfileApplyPayloadWithSource(lp_player, lv_payload, lv_source, lv_sourceProfileKey, lv_sourceHistoryKey) == true)) {
                CMUIX_ProfileShowCoopCommanderSelection(lp_player);
            }
        }

        return true;
    }

    if ((lp_control == CMUIX_HistoryProfileDeleteButton)) {
        if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
            lv_key = CMUIX_HistoryProfileSelectedKey[lp_player];
            CMUIX_HistoryDeleteProfileTemplate(lp_player, lv_key);
        }
        else {
            lv_key = CMUIX_HistoryRecordSelectedKey[lp_player];
            CMUIX_HistoryDeleteRecord(lp_player, lv_key);
        }

        return true;
    }

    if ((lp_control == CMUIX_HistorySaveRecordTemplateButton)) {
        CMUIX_HistoryShowSaveRecordTemplatePopup(lp_player, true);
        return true;
    }

    if ((lp_control == CMUIX_HistorySuggestTemplateButton)) {
        if ((CMUIX_HistorySuggestionPendingForPlayer(lp_player) == true)) {
            CMUIX_HistoryAcceptSuggestedTemplate(lp_player);
        }
        else {
            CMUIX_HistorySuggestSelectedTemplate(lp_player);
        }

        return true;
    }

    if ((lp_control == CMUIX_HistoryNewProfileButton)) {
        CMUIX_HistoryViewingProfiles[lp_player] = true;
        CMUIX_HistoryRefreshForPlayer(lp_player);
        CMUIX_HistoryShowNewProfilePopup(lp_player, true);
        return true;
    }

    if ((lp_control == CMUIX_HistoryNewProfileCancelButton)) {
        CMUIX_HistoryShowNewProfilePopup(lp_player, false);
        return true;
    }

    if ((lp_control == CMUIX_HistoryNewProfileAcceptButton)) {
        if ((CMUIX_HistoryImportProfileTemplateFromControl(lp_player) == true)) {
            CMUIX_HistoryShowNewProfilePopup(lp_player, false);
        }

        return true;
    }

    if ((lp_control == CMUIX_HistorySaveRecordTemplateCancelButton)) {
        CMUIX_HistoryShowSaveRecordTemplatePopup(lp_player, false);
        return true;
    }

    if ((lp_control == CMUIX_HistorySaveRecordTemplateAcceptButton)) {
        if ((CMUIX_HistorySaveSelectedRecordAsTemplateFromControl(lp_player) == true)) {
            CMUIX_HistoryShowSaveRecordTemplatePopup(lp_player, false);
        }

        return true;
    }

    return false;
}

// Draft refresh keeps category budgets, row values, and plus/minus availability
// synchronized after every temporary mastery edit.
void CMUIX_CustomizationUpdatePoints(int lp_targetPlayer) {
    int lv_categoryIndex;
    int lv_itemIndex;
    int lv_category;

    lv_categoryIndex = 1;
    lv_itemIndex = 1;
    lv_category = 0;
    while ((lv_categoryIndex <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        CMUIX_MasteryCategoryPointsLeft[lv_categoryIndex][lp_targetPlayer] = libCOOC_gf_CC_PlayerMasteryCategoryPointsAtLevel(lp_targetPlayer, lv_categoryIndex, CMUIX_MasteryLevelDraft[lp_targetPlayer]);
        lv_categoryIndex += 1;
    }

    while ((lv_itemIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        if ((CMUIX_MasteryUpgrades[lv_itemIndex][lp_targetPlayer] != "")) {
            lv_category = libCOOC_gf_CC_PlayerMasteryCategory(CMUIX_MasteryUpgrades[lv_itemIndex][lp_targetPlayer]);
            if ((lv_category >= 1) && (lv_category <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
                CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer] -= CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer];
                if ((CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer] < 0)) {
                    CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer] += CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer];
                    if ((CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer] < 0)) {
                        CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer] = 0;
                    }

                    CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer] = 0;
                }
            }
        }

        lv_itemIndex += 1;
    }
}

text CMUIX_MasteryValueText(string lp_masteryUpgrade, int lp_points) {
    string lv_expressionId;

    lv_expressionId = "";
    if ((lp_masteryUpgrade == "")) {
        return StringToText("");
    }

    lv_expressionId = ("UserData/MasteryUpgrades/" + lp_masteryUpgrade + "_ValueFormat");
    TextExpressionSetToken(lv_expressionId, "A", FixedToText((libCOOC_gf_CC_PlayerMasteryValueIncrement(lp_masteryUpgrade, 1) * lp_points), 0));
    TextExpressionSetToken(lv_expressionId, "B", FixedToText((libCOOC_gf_CC_PlayerMasteryValueIncrement(lp_masteryUpgrade, 2) * lp_points), 0));
    return TextExpressionAssemble(lv_expressionId);
}

text CMUIX_MasteryRankText(int lp_points) {
    return StringToText((IntToString(lp_points) + " / " + IntToString(libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL)));
}

text CMUIX_StatusUnsetText() {
    return StringToText("--");
}

void CMUIX_CustomizationSetStatusTableVisible(int lp_viewer, bool lp_allianceMode, bool lp_visible) {
    int lv_category;
    playergroup lv_group;
    int lv_headerLabel;
    int lv_tableHeader;
    int lv_tableGrid;

    lv_category = 0;
    lv_group = PlayerGroupSingle(lp_viewer);
    lv_headerLabel = CMUIX_DetailsStatusHeaderLabel;
    lv_tableHeader = CMUIX_DetailsStatusTableHeader;
    lv_tableGrid = CMUIX_DetailsStatusTableGrid;
    if ((lp_allianceMode == true)) {
        lv_headerLabel = CMUIX_AllianceStatusHeaderLabel;
        lv_tableHeader = CMUIX_AllianceStatusTableHeader;
        lv_tableGrid = CMUIX_AllianceStatusTableGrid;
    }

    CMUIX_SetControlVisible(lv_headerLabel, lv_group, (lp_visible == false));
    CMUIX_SetControlVisible(lv_tableHeader, lv_group, lp_visible);
    CMUIX_SetControlVisible(lv_tableGrid, lv_group, lp_visible);
    while ((lv_category < libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        if ((lp_allianceMode == true)) {
            CMUIX_SetControlVisible(CMUIX_AllianceStatusMasteryGroups[lv_category], lv_group, lp_visible);
        }
        else {
            CMUIX_SetControlVisible(CMUIX_DetailsStatusMasteryGroups[lv_category], lv_group, lp_visible);
        }

        lv_category += 1;
    }
}

void CMUIX_CustomizationSetStatusSummaryText(int lp_viewer, bool lp_allianceMode, text lp_text) {
    int lv_headerLabel;
    playergroup lv_group;

    lv_headerLabel = CMUIX_DetailsStatusHeaderLabel;
    lv_group = PlayerGroupSingle(lp_viewer);
    if ((lp_allianceMode == true)) {
        lv_headerLabel = CMUIX_AllianceStatusHeaderLabel;
    }

    CMUIX_SetControlText(lv_headerLabel, lv_group, lp_text);
    CMUIX_SetControlTooltip(lv_headerLabel, lv_group, StringToText(""));
}

void CMUIX_CustomizationRefreshBasicStatus(int lp_viewer, int lp_targetPlayer, string lp_commander, bool lp_allianceMode) {
    int lv_commanderLevel;
    string lv_commander;

    lv_commanderLevel = 0;
    lv_commander = lp_commander;
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == false) && (lp_targetPlayer >= 1) && (lp_targetPlayer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_commander = CMUIX_CommanderForPlayer(lp_targetPlayer);
    }

    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true) && (lp_targetPlayer >= 1) && (lp_targetPlayer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_commanderLevel = libCOOC_gf_CC_CommanderLevel(lp_targetPlayer, lv_commander);
    }

    CMUIX_CustomizationSetStatusTableVisible(lp_viewer, lp_allianceMode, false);
    CMUIX_CustomizationSetStatusSummaryText(lp_viewer, lp_allianceMode, StringExternal("CMUI/ScreenCoopCampaign/StatusCommanderLevel") + IntToText(lv_commanderLevel));
}

text CMUIX_MasteryTooltipWithValue(text lp_tooltipText, text lp_valueText) {
    return (lp_tooltipText + StringToText("<n/><n/><n/>") + lp_valueText);
}

text CMUIX_PrestigeLabelText(int lp_targetPlayer, string lp_commander, int lp_index) {
    int lv_maxRank;
    int lv_index;
    string lv_prestige;
    string lv_face;

    lv_maxRank = 0;
    lv_index = 0;
    lv_prestige = "";
    lv_face = "";
    if ((lp_commander == "")) {
        return StringToText("");
    }

    lv_maxRank = libCOOC_gf_CC_PlayerPrestigeMaxRank(lp_commander);
    lv_index = CMUIX_ClampInt(lp_index, 0, lv_maxRank);
    if ((lv_index == 0)) {
        return StringExternal(CatalogFieldValueGet(c_gameCatalogCommander, libCOOC_gf_CC_CommanderData(lp_commander), "Description", lp_targetPlayer));
    }

    lv_prestige = libCOOC_gf_CC_PlayerActivePrestigeInstance2(lp_commander, lv_index);
    if ((lv_prestige == "")) {
        return StringToText("");
    }

    lv_face = libCOOC_gf_CC_CommanderPrestigeIndexFace2(lv_prestige);
    return StringExternal(CatalogFieldValueGet(c_gameCatalogButton, lv_face, "Name", lp_targetPlayer));
}

void CMUIX_CustomizationRefreshInfoLabels(int lp_viewer, int lp_targetPlayer, string lp_commander, bool lp_allianceMode, int lp_prestigeIndex) {
    int lv_nameControl;
    int lv_prestigeControl;
    int lv_selection;
    playergroup lv_group;
    text lv_nameText;
    text lv_prestigeText;

    lv_nameControl = c_invalidDialogControlId;
    lv_prestigeControl = c_invalidDialogControlId;
    lv_selection = CMUIX_CommanderSelectionIndexForPlayer(lp_targetPlayer);
    lv_group = PlayerGroupSingle(lp_viewer);
    lv_nameText = CMUIX_StatusUnsetText();
    lv_prestigeText = StringToText("");
    if ((lp_allianceMode == true)) {
        lv_nameControl = CMUIX_CommanderInfoAllianceNameLabel;
        lv_prestigeControl = CMUIX_CommanderInfoAlliancePrestigeLabel;
    }
    else {
        lv_nameControl = CMUIX_CommanderInfoNameLabel;
        lv_prestigeControl = CMUIX_CommanderInfoPrestigeLabel;
    }

    if ((lp_commander != "")) {
        lv_nameText = libCOOC_gf_CC_CommanderName(lp_commander);
        lv_prestigeText = CMUIX_PrestigeLabelText(lp_targetPlayer, lp_commander, lp_prestigeIndex);
    }
    else {
        if ((CMUIX_CommanderSelectionIsRandom(lv_selection) == true)) {
            lv_nameText = StringExternal("CMUI/ScreenCoopCampaign/RandomCommanderName");
        }
    }

    CMUIX_SetControlText(lv_nameControl, lv_group, lv_nameText);
    CMUIX_SetControlText(lv_prestigeControl, lv_group, lv_prestigeText);
    CMUIX_SetControlTooltip(lv_nameControl, lv_group, StringToText(""));
}

void CMUIX_CustomizationRefreshExternalFromData(int lp_viewer, int lp_targetPlayer, string lp_commander, bool lp_allianceMode) {
    int lv_prestigeIndex;
    bool lv_random;

    lv_random = CMUIX_PlayerCommanderSelectionIsRandom(lp_targetPlayer);
    CMUIX_EnsureDefaultAIMastery(lp_targetPlayer);
    lv_prestigeIndex = CMUIX_ReadPrestigeForCommander(lp_targetPlayer, lp_commander);
    CMUIX_CustomizationRefreshSpentLabel(lp_viewer, lp_targetPlayer, lp_commander, lp_allianceMode);
    CMUIX_CustomizationRefreshStatusRowsFromData(lp_viewer, lp_targetPlayer, lp_commander, lp_allianceMode);
    CMUIX_CustomizationRefreshInfoLabels(lp_viewer, lp_targetPlayer, lp_commander, lp_allianceMode, lv_prestigeIndex);
    if ((lp_allianceMode == true)) {
        CMUIX_CustomizationSetAllianceRandomState(lp_viewer, lv_random);
        CMUIX_CustomizationRefreshAllianceBackground(lp_viewer, lp_commander);
        CMUIX_CustomizationRefreshAllianceControls(lp_viewer, lp_targetPlayer);
    }
}

void CMUIX_CustomizationSetStatusRow(int lp_viewer, int lp_index, bool lp_allianceMode, text lp_nameText, text lp_valueText, text lp_tooltipText) {
    int lv_nameControl;
    int lv_valueControl;
    playergroup lv_group;

    lv_nameControl = c_invalidDialogControlId;
    lv_valueControl = c_invalidDialogControlId;
    lv_group = PlayerGroupSingle(lp_viewer);
    if ((lp_index < 1) || (lp_index > libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        return;
    }

    if ((lp_allianceMode == true)) {
        lv_nameControl = CMUIX_AllianceStatusMasteryNameLabels[lp_index];
        lv_valueControl = CMUIX_AllianceStatusMasteryValueLabels[lp_index];
    }
    else {
        lv_nameControl = CMUIX_DetailsStatusMasteryNameLabels[lp_index];
        lv_valueControl = CMUIX_DetailsStatusMasteryValueLabels[lp_index];
    }

    CMUIX_SetControlText(lv_nameControl, lv_group, lp_nameText);
    CMUIX_SetControlText(lv_valueControl, lv_group, lp_valueText);
    CMUIX_SetControlTooltip(lv_nameControl, lv_group, StringToText(""));
    CMUIX_SetControlTooltip(lv_valueControl, lv_group, StringToText(""));
}

void CMUIX_CustomizationRefreshStatusRows(int lp_viewer, int lp_targetPlayer, bool lp_allianceMode) {
    int lv_index;
    int lv_points;
    string lv_masteryUpgrade;
    string lv_commander;
    text lv_nameText;
    text lv_valueText;
    text lv_tooltipText;

    lv_index = 1;
    lv_points = 0;
    lv_masteryUpgrade = "";
    lv_commander = CMUIX_TargetCommander[lp_viewer];
    lv_nameText = CMUIX_StatusUnsetText();
    lv_valueText = CMUIX_StatusUnsetText();
    lv_tooltipText = StringToText("");
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true) && (CMUIX_CommanderMasteryUnlocked(lp_targetPlayer, lv_commander) == false)) {
        CMUIX_CustomizationRefreshBasicStatus(lp_viewer, lp_targetPlayer, lv_commander, lp_allianceMode);
        return;
    }

    CMUIX_CustomizationSetStatusTableVisible(lp_viewer, lp_allianceMode, true);
    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_masteryUpgrade = CMUIX_MasteryUpgrades[lv_index][lp_targetPlayer];
        lv_points = CMUIX_MasteryPointsSpent[lv_index][lp_targetPlayer];
        if ((lv_masteryUpgrade == "")) {
            lv_nameText = CMUIX_StatusUnsetText();
            lv_valueText = CMUIX_StatusUnsetText();
            lv_tooltipText = StringToText("");
        }
        else {
            lv_nameText = libCOOC_gf_CC_PlayerMasteryName(lv_masteryUpgrade);
            lv_valueText = IntToText(lv_points);
            lv_tooltipText = libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade);
        }

        CMUIX_CustomizationSetStatusRow(lp_viewer, lv_index, lp_allianceMode, lv_nameText, lv_valueText, lv_tooltipText);
        lv_index += 1;
    }
}

void CMUIX_CustomizationRefreshStatusRowsFromData(int lp_viewer, int lp_targetPlayer, string lp_commander, bool lp_allianceMode) {
    int lv_index;
    int lv_end;
    int lv_masteryIndex;
    int lv_points;
    string lv_masteryUpgrade;

    lv_index = 1;
    lv_end = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryIndex = 0;
    lv_points = 0;
    lv_masteryUpgrade = "";
    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        CMUIX_CustomizationSetStatusRow(lp_viewer, lv_index, lp_allianceMode, CMUIX_StatusUnsetText(), CMUIX_StatusUnsetText(), StringToText(""));
        lv_index += 1;
    }

    if ((lp_commander == "")) {
        return;
    }

    if ((CMUIX_CommanderMasteryUnlocked(lp_targetPlayer, lp_commander) == false)) {
        CMUIX_CustomizationRefreshBasicStatus(lp_viewer, lp_targetPlayer, lp_commander, lp_allianceMode);
        return;
    }

    CMUIX_CustomizationSetStatusTableVisible(lp_viewer, lp_allianceMode, true);
    lv_index = 1;
    while ((lv_index <= lv_end)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((UserDataGetUserInstance("MasteryUpgrades", lv_masteryUpgrade, "Commander", 1) == lp_commander)) {
            lv_masteryIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lv_masteryUpgrade);
            if ((lv_masteryIndex >= 1) && (lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
                lv_points = libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lp_targetPlayer, lv_masteryUpgrade);
                CMUIX_CustomizationSetStatusRow(lp_viewer, lv_masteryIndex, lp_allianceMode, libCOOC_gf_CC_PlayerMasteryName(lv_masteryUpgrade), IntToText(lv_points), libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade));
            }
        }

        lv_index += 1;
    }
}

void CMUIX_CustomizationUpdateMasteryDisplay(int lp_operator, int lp_targetPlayer) {
    int lv_itemIndex;
    int lv_categoryIndex;
    int lv_points;
    int lv_category;
    bool lv_plusEnabled;
    bool lv_minusEnabled;
    bool lv_masteryUnlocked;
    playergroup lv_group;
    string lv_masteryUpgrade;
    string lv_commander;
    text lv_valueText;
    text lv_tooltipText;

    lv_itemIndex = 1;
    lv_categoryIndex = 1;
    lv_points = 0;
    lv_category = 0;
    lv_plusEnabled = false;
    lv_minusEnabled = false;
    lv_masteryUnlocked = true;
    lv_group = PlayerGroupSingle(lp_operator);
    lv_masteryUpgrade = "";
    lv_commander = CMUIX_TargetCommander[lp_operator];
    lv_valueText = StringToText("");
    lv_tooltipText = StringToText("");
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        lv_masteryUnlocked = CMUIX_CommanderMasteryUnlocked(lp_targetPlayer, lv_commander);
    }

    CMUIX_CustomizationUpdatePoints(lp_targetPlayer);
    while ((lv_itemIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_masteryUpgrade = CMUIX_MasteryUpgrades[lv_itemIndex][lp_targetPlayer];
        if ((lv_masteryUpgrade == "")) {
            CMUIX_SetControlVisible(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, false);
        }
        else {
            lv_points = CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer];
            lv_category = libCOOC_gf_CC_PlayerMasteryCategory(lv_masteryUpgrade);
            lv_plusEnabled = true;
            lv_minusEnabled = true;
            if ((lv_category < 1) || (lv_category > libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
                lv_plusEnabled = false;
            }
            else {
                if ((CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer] <= 0)) {
                    lv_plusEnabled = false;
                }
                else {
                    if ((lv_points >= libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL)) {
                        lv_plusEnabled = false;
                    }
                }
            }

            if ((lv_points <= 0)) {
                lv_minusEnabled = false;
            }

            if ((CMUIX_ReadyCanEditData(lp_operator) == false)) {
                lv_plusEnabled = false;
                lv_minusEnabled = false;
            }

            if ((lv_masteryUnlocked == false)) {
                lv_plusEnabled = false;
                lv_minusEnabled = false;
            }

            CMUIX_SetControlVisible(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, true);
            CMUIX_SetControlVisible(CMUIX_MasteryValueLabels[lv_itemIndex], lv_group, false);
            CMUIX_SetControlVisible(CMUIX_MasteryRankLabels[lv_itemIndex], lv_group, true);
            CMUIX_SetControlVisible(CMUIX_MasteryPlusButtons[lv_itemIndex], lv_group, true);
            CMUIX_SetControlVisible(CMUIX_MasteryMinusButtons[lv_itemIndex], lv_group, true);
            CMUIX_SetControlVisible(CMUIX_MasteryUnavailableLabels[lv_itemIndex], lv_group, false);
            lv_valueText = CMUIX_MasteryValueText(lv_masteryUpgrade, lv_points);
            lv_tooltipText = CMUIX_MasteryTooltipWithValue(libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade), lv_valueText);
            CMUIX_SetControlTooltip(CMUIX_MasteryNameLabels[lv_itemIndex], lv_group, lv_tooltipText);
            CMUIX_SetControlTooltip(CMUIX_MasteryTooltipAnchors[lv_itemIndex], lv_group, lv_tooltipText);
            CMUIX_SetControlTooltip(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, lv_tooltipText);
            CMUIX_SetControlText(CMUIX_MasteryRankLabels[lv_itemIndex], lv_group, CMUIX_MasteryRankText(lv_points));
            CMUIX_SetControlEnabled(CMUIX_MasteryPlusButtons[lv_itemIndex], lv_group, lv_plusEnabled);
            CMUIX_SetControlEnabled(CMUIX_MasteryMinusButtons[lv_itemIndex], lv_group, lv_minusEnabled);
            if ((lv_points <= 0)) {
                DialogControlSetAnimationState(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, "RankState", "MinRank");
            }
            else {
                if ((lv_points >= libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL)) {
                    DialogControlSetAnimationState(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, "RankState", "MaxRank");
                }
                else {
                    DialogControlSetAnimationState(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, "RankState", "MidRank");
                }
            }

            if ((lv_category >= 1) && (lv_category <= libCOOC_gv_cCC_MASTERY_CATEGORIES) && (CMUIX_MasteryCategoryPointsLeft[lv_category][lp_targetPlayer] <= 0)) {
                DialogControlSetAnimationState(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, "BucketState", "AllSpent");
            }
            else {
                DialogControlSetAnimationState(CMUIX_MasteryItemPanels[lv_itemIndex], lv_group, "BucketState", "NotAllSpent");
            }
        }

        lv_itemIndex += 1;
    }

    while ((lv_categoryIndex <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        CMUIX_SetControlText(CMUIX_MasteryCategoryLabels[lv_categoryIndex], lv_group, IntToText(CMUIX_MasteryCategoryPointsLeft[lv_categoryIndex][lp_targetPlayer]));
        lv_categoryIndex += 1;
    }
}

void CMUIX_CustomizationUpdatePrestigeDisplay(int lp_operator, int lp_targetPlayer) {
    int lv_itemIndex;
    int lv_maxRank;
    bool lv_enabled;
    bool lv_developingUnlocked;
    playergroup lv_group;
    string lv_commander;
    string lv_commanderData;
    string lv_prestige;
    string lv_face;

    lv_itemIndex = 0;
    lv_maxRank = 0;
    lv_enabled = false;
    lv_developingUnlocked = false;
    lv_group = PlayerGroupSingle(lp_operator);
    lv_commander = CMUIX_TargetCommander[lp_operator];
    lv_commanderData = "";
    lv_prestige = "";
    lv_face = "";
    if ((lv_commander == "")) {
        while ((lv_itemIndex <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
            CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, false);
            CMUIX_SetControlVisible(CMUIX_PrestigeDividers[lv_itemIndex], lv_group, false);
            lv_itemIndex += 1;
        }

        return;
    }

    lv_commanderData = libCOOC_gf_CC_CommanderData(lv_commander);
    if ((lv_commanderData == "")) {
        while ((lv_itemIndex <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
            CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, false);
            CMUIX_SetControlVisible(CMUIX_PrestigeDividers[lv_itemIndex], lv_group, false);
            lv_itemIndex += 1;
        }

        return;
    }

    lv_maxRank = libCOOC_gf_CC_PlayerPrestigeMaxRank(lv_commander);
    while ((lv_itemIndex <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
        if ((lv_itemIndex == 0)) {
            CMUIX_SetControlText(CMUIX_PrestigeLabels[lv_itemIndex], lv_group, StringExternal(CatalogFieldValueGet(c_gameCatalogCommander, lv_commanderData, "Description", lp_targetPlayer)));
            CMUIX_SetControlTooltip(CMUIX_PrestigeItems[lv_itemIndex], lv_group, StringExternal(CatalogFieldValueGet(c_gameCatalogCommander, lv_commanderData, "FeaturedDescription", lp_targetPlayer)));
            CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, true);
            CMUIX_SetControlEnabled(CMUIX_PrestigeItems[lv_itemIndex], lv_group, CMUIX_ReadyCanEditData(lp_operator));
        }
        else {
            if ((lv_itemIndex <= lv_maxRank)) {
                lv_prestige = libCOOC_gf_CC_PlayerActivePrestigeInstance2(lv_commander, lv_itemIndex);
                lv_face = libCOOC_gf_CC_CommanderPrestigeIndexFace2(lv_prestige);
                if ((lv_prestige == "") || (lv_face == "")) {
                    CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, false);
                    CMUIX_SetControlVisible(CMUIX_PrestigeDividers[(lv_itemIndex - 1)], lv_group, false);
                }
                else {
                    CMUIX_SetControlTooltip(CMUIX_PrestigeItems[lv_itemIndex], lv_group, StringExternal(CatalogFieldValueGet(c_gameCatalogButton, lv_face, "Tooltip", lp_targetPlayer)));
                    CMUIX_SetControlText(CMUIX_PrestigeLabels[lv_itemIndex], lv_group, StringExternal(CatalogFieldValueGet(c_gameCatalogButton, lv_face, "Name", lp_targetPlayer)));
                    CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, true);
                    CMUIX_SetControlVisible(CMUIX_PrestigeDividers[(lv_itemIndex - 1)], lv_group, true);
                    lv_enabled = ((CMUIX_PrestigeAccessibleForPlayer(lp_operator, lv_prestige) == true) && (CMUIX_PrestigeAccessibleForPlayer(lp_targetPlayer, lv_prestige) == true));
                    lv_developingUnlocked = false;
                    if ((libCOOC_gf_CC_PrestigeIsDeveloping(lv_prestige) == true) && (lv_enabled == true)) {
                        lv_developingUnlocked = true;
                    }

                    if ((CMUIX_ReadyCanEditData(lp_operator) == false)) {
                        lv_enabled = false;
                    }

                    CMUIX_SetControlEnabled(CMUIX_PrestigeItems[lv_itemIndex], lv_group, lv_enabled);
                    if ((lv_developingUnlocked == true)) {
                        DialogControlSetAnimationState(CMUIX_PrestigeItems[lv_itemIndex], lv_group, "LockState", "Dev");
                    }
                    else {
                        DialogControlSetAnimationState(CMUIX_PrestigeItems[lv_itemIndex], lv_group, "LockState", "None");
                    }
                }
            }
            else {
                CMUIX_SetControlVisible(CMUIX_PrestigeItems[lv_itemIndex], lv_group, false);
                if ((lv_itemIndex > 0)) {
                    CMUIX_SetControlVisible(CMUIX_PrestigeDividers[(lv_itemIndex - 1)], lv_group, false);
                }
            }
        }

        if ((lv_itemIndex <= lv_maxRank)) {
            if ((CMUIX_PrestigeSelected[lp_targetPlayer] == lv_itemIndex)) {
                CMUIX_SetControlToggled(CMUIX_PrestigeItems[lv_itemIndex], lv_group, true);
            }
            else {
                CMUIX_SetControlToggled(CMUIX_PrestigeItems[lv_itemIndex], lv_group, false);
            }
        }

        lv_itemIndex += 1;
    }
}

void CMUIX_CustomizationRefresh(int lp_operator) {
    int lv_targetPlayer;

    lv_targetPlayer = CMUIX_TargetForOperator(lp_operator);
    CMUIX_CustomizationUpdateMasteryDisplay(lp_operator, lv_targetPlayer);
    CMUIX_CustomizationUpdatePrestigeDisplay(lp_operator, lv_targetPlayer);
}

void CMUIX_CustomizationClearDraft(int lp_targetPlayer) {
    int lv_itemIndex;
    int lv_categoryIndex;

    lv_itemIndex = 1;
    lv_categoryIndex = 1;
    while ((lv_itemIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        CMUIX_MasteryUpgrades[lv_itemIndex][lp_targetPlayer] = "";
        CMUIX_MasteryPointsSpent[lv_itemIndex][lp_targetPlayer] = 0;
        lv_itemIndex += 1;
    }

    while ((lv_categoryIndex <= libCOOC_gv_cCC_MASTERY_CATEGORIES)) {
        CMUIX_MasteryCategoryPointsLeft[lv_categoryIndex][lp_targetPlayer] = 0;
        lv_categoryIndex += 1;
    }
}

void CMUIX_CustomizationInitFromData(int lp_operator, int lp_targetPlayer, string lp_commander, bool lp_allianceMode) {
    int lv_index;
    int lv_end;
    int lv_masteryIndex;
    string lv_masteryUpgrade;
    playergroup lv_group;

    lv_index = 1;
    lv_end = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryIndex = 0;
    lv_masteryUpgrade = "";
    lv_group = PlayerGroupSingle(lp_operator);
    CMUIX_EnsureDefaultAIMastery(lp_targetPlayer);
    CMUIX_TargetPlayer[lp_operator] = lp_targetPlayer;
    CMUIX_TargetAllianceMode[lp_operator] = lp_allianceMode;
    CMUIX_TargetCommander[lp_operator] = lp_commander;
    CMUIX_MasteryShiftPressed[lp_operator] = false;
    if ((CMUIX_CoopProgressCommanderValid(lp_commander) == true) && (CMUIX_CommanderMasteryUnlocked(lp_targetPlayer, lp_commander) == true)) {
        libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_targetPlayer, true);
        if ((libCOOC_gf_CC_PlayerMasteryLevel(lp_targetPlayer) <= 0)) {
            libCOOC_gf_CC_PlayerMasteryLevelSet(lp_targetPlayer, CMUIX_MasteryPointsCurrentDefault());
        }
        else {
            if ((libCOOC_gf_CC_PlayerMasteryLevel(lp_targetPlayer) > CMUIX_ProfileMasteryCapCurrent())) {
                libCOOC_gf_CC_PlayerMasteryLevelSet(lp_targetPlayer, CMUIX_ProfileMasteryCapCurrent());
            }
        }
    }
    else {
        CMUIX_ApplyCommanderMasteryGate(lp_targetPlayer, lp_commander);
    }

    CMUIX_MasteryLevelDraft[lp_targetPlayer] = libCOOC_gf_CC_PlayerMasteryLevel(lp_targetPlayer);
    CMUIX_CustomizationClearDraft(lp_targetPlayer);
    CMUIX_PersonalizationLoadOptimizationDrafts(lp_operator, lp_targetPlayer, lp_commander);
    if ((lp_commander == "")) {
        CMUIX_PersonalizationRefresh(lp_operator, lp_targetPlayer, lp_commander);
        CMUIX_CustomizationRefreshInfoLabels(lp_operator, lp_targetPlayer, lp_commander, lp_allianceMode, 0);
        CMUIX_CustomizationRefresh(lp_operator);
        return;
    }

    while ((lv_index <= lv_end)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((UserDataGetUserInstance("MasteryUpgrades", lv_masteryUpgrade, "Commander", 1) == lp_commander)) {
            lv_masteryIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lv_masteryUpgrade);
            if ((lv_masteryIndex >= 1) && (lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
                CMUIX_MasteryUpgrades[lv_masteryIndex][lp_targetPlayer] = lv_masteryUpgrade;
                CMUIX_MasteryPointsSpent[lv_masteryIndex][lp_targetPlayer] = libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lp_targetPlayer, lv_masteryUpgrade);
                CMUIX_SetControlText(CMUIX_MasteryNameLabels[lv_masteryIndex], lv_group, libCOOC_gf_CC_PlayerMasteryName(lv_masteryUpgrade));
                CMUIX_SetControlTooltip(CMUIX_MasteryNameLabels[lv_masteryIndex], lv_group, libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade));
                CMUIX_SetControlTooltip(CMUIX_MasteryTooltipAnchors[lv_masteryIndex], lv_group, libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade));
                CMUIX_SetControlTooltip(CMUIX_MasteryItemPanels[lv_masteryIndex], lv_group, libCOOC_gf_CC_PlayerMasteryTooltip(lv_masteryUpgrade));
            }
        }

        lv_index += 1;
    }

    CMUIX_PrestigeSelected[lp_targetPlayer] = CMUIX_ReadPrestigeForCommander(lp_targetPlayer, lp_commander);
    CMUIX_PersonalizationRefresh(lp_operator, lp_targetPlayer, lp_commander);
    CMUIX_CustomizationRefreshExternalFromData(lp_operator, lp_targetPlayer, lp_commander, lp_allianceMode);
    CMUIX_CustomizationRefresh(lp_operator);
}

void CMUIX_CustomizationAccept(int lp_operator) {
    int lv_targetPlayer;
    int lv_itemIndex;
    string lv_commander;
    bool lv_masteryUnlocked;

    lv_targetPlayer = CMUIX_TargetForOperator(lp_operator);
    lv_itemIndex = 1;
    lv_commander = CMUIX_TargetCommander[lp_operator];
    lv_masteryUnlocked = CMUIX_CommanderMasteryUnlocked(lv_targetPlayer, lv_commander);
    if ((lv_masteryUnlocked == true)) {
        CMUIX_MasteryLevelDraft[lv_targetPlayer] = CMUIX_ClampInt(CMUIX_MasteryLevelDraft[lv_targetPlayer], 0, CMUIX_ProfileMasteryCapCurrent());
        libCOOC_gf_CC_PlayerMasteryEnabledSet(lv_targetPlayer, true);
        libCOOC_gf_CC_PlayerMasteryLevelSet(lv_targetPlayer, CMUIX_MasteryLevelDraft[lv_targetPlayer]);
        while ((lv_itemIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            if ((CMUIX_MasteryUpgrades[lv_itemIndex][lv_targetPlayer] != "")) {
                libCOOC_gf_CC_PlayerMasteryUpgradeLevelSet(lv_targetPlayer, CMUIX_MasteryUpgrades[lv_itemIndex][lv_targetPlayer], CMUIX_MasteryPointsSpent[lv_itemIndex][lv_targetPlayer]);
            }

            lv_itemIndex += 1;
        }
    }
    else {
        CMUIX_MasteryLevelDraft[lv_targetPlayer] = 0;
        CMUIX_ApplyCommanderMasteryGate(lv_targetPlayer, lv_commander);
    }


    CMUIX_WritePrestigeForCommander(lv_targetPlayer, lv_commander, CMUIX_PrestigeSelected[lv_targetPlayer]);
    CMUIX_PersonalizationCommitVoicePackSelection(lp_operator, lv_targetPlayer, lv_commander);
    CMUIX_PersonalizationCommitOptimizations(lp_operator, lv_targetPlayer, lv_commander);
    libCOOC_gf_CC_UpdateTechStates(lv_targetPlayer);
    if ((lv_commander != "")) {
        CMUIX_CustomizationRefreshSpentLabel(lp_operator, lv_targetPlayer, lv_commander, CMUIX_TargetAllianceMode[lp_operator]);
        CMUIX_CustomizationRefreshStatusRowsFromData(lp_operator, lv_targetPlayer, lv_commander, CMUIX_TargetAllianceMode[lp_operator]);
        CMUIX_CustomizationRefreshInfoLabels(lp_operator, lv_targetPlayer, lv_commander, CMUIX_TargetAllianceMode[lp_operator], CMUIX_PrestigeSelected[lv_targetPlayer]);
    }

    if ((CMUIX_CustomizationShouldPersistToPlayerData() == true)) {
        CMUIX_CoopProgressSaveForPlayer(lv_targetPlayer);
    }

    CMUIX_RefreshCommanderMasteryVisualsAll();
}

void CMUIX_CustomizationOpenSelf(int lp_operator) {
    string lv_commander;

    lv_commander = CMUIX_CommanderForPlayer(lp_operator);
    CMUIX_CustomizationHookup();
    CMUIX_CustomizationInitFromData(lp_operator, lp_operator, lv_commander, false);
    if ((CMUIX_IsControlValid(CMUIX_CustomizationPanel) == true)) {
        DialogControlSendAnimationEvent(CMUIX_CustomizationPanel, PlayerGroupSingle(lp_operator), "OpenSelf");
    }
}

void CMUIX_CustomizationOpenAlliance(int lp_operator, int lp_targetPlayer) {
    int lv_targetPlayer;
    string lv_commander;

    lv_targetPlayer = lp_targetPlayer;
    lv_commander = "";
    if ((lv_targetPlayer <= 0)) {
        lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_operator);
    }

    if ((CMUIX_AllianceCustomizationButtonShouldShow(lp_operator, lv_targetPlayer) == false)) {
        return;
    }

    CMUIX_CustomizationSetAllianceStateExpanded(lp_operator, true);
    lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
    CMUIX_CustomizationHookup();
    CMUIX_CustomizationInitFromData(lp_operator, lv_targetPlayer, lv_commander, true);
    if ((CMUIX_IsControlValid(CMUIX_CustomizationPanel) == true)) {
        DialogControlSendAnimationEvent(CMUIX_CustomizationPanel, PlayerGroupSingle(lp_operator), "OpenAlliance");
    }
}

void CMUIX_CustomizationSetLevelDisplayMode(int lp_player, bool lp_allianceMode, string lp_mode) {
    playergroup lv_group;

    lv_group = PlayerGroupSingle(lp_player);
    CMUIX_CustomizationHookup();
    if ((lp_allianceMode == true)) {
        if ((CMUIX_IsControlValid(CMUIX_AllianceStatePanel) == true)) {
            DialogControlSetAnimationState(CMUIX_AllianceStatePanel, lv_group, "LevelDisplayMode", lp_mode);
        }
    }
    else {
        if ((CMUIX_IsControlValid(libCMUI_gv_detailsContainer) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_detailsContainer, lv_group, "LevelDisplayMode", lp_mode);
        }
    }
}

// Runtime initialization mirrors Hookup order: reset handles, then reset
// per-player target/draft state, then let refresh code fill concrete values.
