void CMUIX_HistoryFinalizeAbandonedRecordsForPlayer(int lp_player) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    string lv_key;
    string lv_payload;
    string lv_body;
    string lv_name;
    string lv_activeKey;
    bool lv_changed;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_key = "";
    lv_payload = "";
    lv_body = "";
    lv_name = "";
    lv_activeKey = "";
    lv_changed = false;
    if ((lv_bank == null) || (CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        return;
    }

    lv_activeKey = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey", "");
    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    while ((lv_index < lv_nextIndex)) {
        lv_key = CMUIX_HistoryRecordKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lv_key) == true)) {
            lv_payload = BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lv_key);
            if ((CMUIX_HistoryRecordIntegrityForPayload(lv_payload) == CMUIX_HISTORY_INTEGRITY_VALID)) {
                lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
                if ((StringEqual(CMUIX_HistoryResultValueFromBody(lv_body), "InProgress", c_stringNoCase) == true)) {
                    lv_body = CMUIX_ProfileSetConfigValue(lv_body, "result", "Defeat");
                    lv_name = CMUIX_ProfileConfigValue(lv_body, "name");
                    if ((StringEqual(lv_name, "History_InProgress", c_stringNoCase) == true)) {
                        lv_body = CMUIX_ProfileSetConfigValue(lv_body, "name", "History_Defeat");
                    }

                    BankValueSetFromString(lv_bank, CMUIX_HISTORY_SECTION, lv_key, CMUIX_ProfileCompactPayloadWithChecksum(lv_body));
                    if ((lv_activeKey == lv_key)) {
                        BankKeyRemove(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey");
                        lv_activeKey = "";
                    }

                    lv_changed = true;
                }
            }
        }

        lv_index = lv_index + 1;
    }

    if ((lv_changed == true)) {
        CMUIX_GameHistorySaveBank(lp_player);
    }
}

void CMUIX_HistoryFinalizeAbandonedRecordsAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers = lv_seenPlayers + 1;
        CMUIX_HistoryFinalizeAbandonedRecordsForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_HistoryFinalizeAbandonedRecordsForPlayer(1);
        if ((libCOOC_gv_cCC_MAXPLAYERS >= 2)) {
            CMUIX_HistoryFinalizeAbandonedRecordsForPlayer(2);
        }
    }
}

