    lv_index = 0;
    lv_draft = CMUIX_MutatorChallengeCurrentDraft();
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        if ((libCMUI_gv_mutatorChallengeItemChallenges[lv_index] != "") && (CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeItems[lv_index], (libCMUI_gv_mutatorChallengeItemChallenges[lv_index] == lv_draft), lv_playerGroup);
        }

        lv_index += 1;
    }

    CMUIX_MutatorChallengeRefreshDetails(lp_player, lv_draft);
}

void CMUIX_MutatorChallengeEnemyClearList(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        libCMUI_gv_mutatorChallengeEnemyItemEnemies[lv_index] = "";
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeEnemyItems[lv_index], false, lp_players);
        if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeEnemyItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeEnemyItems[lv_index], false, lp_players);
            DialogControlSetAnimationState(libCMUI_gv_mutatorChallengeEnemyItems[lv_index], lp_players, "RaceState", "None");
        }

        if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeEnemyItemRaceIcons[lv_index]) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_mutatorChallengeEnemyItemRaceIcons[lv_index], lp_players, "RaceState", "None");
        }

        lv_index += 1;
    }
}

bool CMUIX_MutatorChallengeEnemyAlreadyListed(string lp_enemyInstance, int lp_count) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < lp_count)) {
        if ((libCMUI_gv_mutatorChallengeEnemyItemEnemies[lv_index] == lp_enemyInstance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

string CMUIX_MutatorChallengeFirstAllowedEnemyForChallenge(string lp_type, string lp_challenge, string lp_raceFilter) {
    int lv_index;
    string lv_allowedEnemy;

    lv_index = 1;
    lv_allowedEnemy = "";
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max)) {
        lv_allowedEnemy = CMUIX_MutatorChallengeAIAt(lp_type, lp_challenge, lv_index);
        if ((lv_allowedEnemy != "") && (CMUIX_EnemySelectionEnemyIsValidForRace(lv_allowedEnemy, lp_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_allowedEnemy) == true)) {
            return lv_allowedEnemy;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_MutatorChallengeNormalizeEnemyForChallenge(string lp_type, string lp_challenge, string lp_enemyInstance) {
    string lv_raceFilter;
    string lv_lockedAI;

    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    lv_lockedAI = CMUIX_MutatorChallengeLockedAI(lp_type, lp_challenge);
    if ((lv_lockedAI != "")) {
        if ((CMUIX_EnemySelectionEnemyIsValidForRace(lv_lockedAI, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_lockedAI) == true)) {
            return lv_lockedAI;
        }

        return "";
    }

    if ((CMUIX_MutatorChallengeHasAIRestriction(lp_type, lp_challenge) == false)) {
        return CMUIX_EnemySelectionNormalizeSelection(lp_enemyInstance);
    }

    if ((lp_enemyInstance == CMUIX_EnemySelection_Random)) {
        return CMUIX_EnemySelection_Random;
    }

    if ((CMUIX_MutatorChallengeAllowsEnemyInstance(lp_type, lp_challenge, lp_enemyInstance) == true) && (CMUIX_EnemySelectionEnemyIsValidForRace(lp_enemyInstance, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_enemyInstance) == true)) {
        return lp_enemyInstance;
    }

    return CMUIX_EnemySelection_Random;
}

string CMUIX_MutatorChallengeNormalizeEnemyForCurrent(string lp_enemyInstance) {
    return CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, CMUIX_MutatorChallengeCurrentDraft(), lp_enemyInstance);
}

void CMUIX_MutatorChallengeEnemySetListItem(int lp_index, string lp_enemyInstance, playergroup lp_players) {
    text lv_name;
    string lv_raceState;

    lv_name = CMUIX_EnemySelectionDisplayName(lp_enemyInstance);
    lv_raceState = CMUIX_EnemySelectionRaceState(lp_enemyInstance);
    if ((lp_index < 0) || (lp_index >= libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        return;
    }

    libCMUI_gv_mutatorChallengeEnemyItemEnemies[lp_index] = lp_enemyInstance;
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyItems[lp_index], StringToText(""), lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyItemLabels[lp_index], lv_name, lp_players);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeEnemyItems[lp_index], true, lp_players);
    if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeEnemyItems[lp_index]) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_mutatorChallengeEnemyItems[lp_index], lp_players, "RaceState", lv_raceState);
        libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeEnemyItems[lp_index], (lp_enemyInstance == CMUIX_EnemySelectionDraft), lp_players);
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeEnemyItemRaceIcons[lp_index]) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_mutatorChallengeEnemyItemRaceIcons[lp_index], lp_players, "RaceState", lv_raceState);
    }
}

void CMUIX_MutatorChallengeEnemyRefreshList(int lp_player) {
    int lv_factionIndex;
    int lv_factionCount;
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_faction;
    string lv_instance;
    string lv_challenge;
    string lv_raceFilter;
    string lv_allowedEnemy;
    string lv_randomEnemy;
    string lv_lockedAI;
    bool lv_restricted;
    playergroup lv_playerGroup;

    CMUIX_ProfileRuntimeLocksRefresh();
    lv_factionIndex = 1;
    lv_factionCount = UserDataInstanceCount("CoopAIFactions");
    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    lv_slot = 0;
    lv_faction = "";
    lv_instance = "";
    lv_challenge = CMUIX_MutatorChallengeCurrentDraft();
    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    lv_allowedEnemy = "";
    lv_randomEnemy = "";
    lv_lockedAI = CMUIX_MutatorChallengeLockedAI(CMUIX_MutatorChallengeCurrentType, lv_challenge);
    lv_restricted = CMUIX_MutatorChallengeHasAIRestriction(CMUIX_MutatorChallengeCurrentType, lv_challenge);
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_EnemySelectionEnsureSelection();
    CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, lv_challenge, CMUIX_EnemySelectionDraft);
    CMUIX_MutatorChallengeEnemyClearList(lv_playerGroup);
    if ((lv_lockedAI != "")) {
        if ((CMUIX_EnemySelectionEnemyIsValidForRace(lv_lockedAI, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_lockedAI) == true)) {
            CMUIX_MutatorChallengeEnemySetListItem(lv_slot, lv_lockedAI, lv_playerGroup);
        }

        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeEnemyTileList, lp_player, false);
        CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyDescriptionLabel, CMUIX_EnemySelectionDescription(CMUIX_EnemySelectionDraft), lv_playerGroup);
        return;
    }

    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeEnemyTileList, lp_player, CMUIX_ReadyCanEditSharedData(lp_player));
    if ((lv_restricted == true)) {
        CMUIX_MutatorChallengeEnemySetListItem(lv_slot, CMUIX_EnemySelection_Random, lv_playerGroup);
        lv_slot += 1;
        lv_index = 1;
        while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
            lv_allowedEnemy = CMUIX_MutatorChallengeAIAt(CMUIX_MutatorChallengeCurrentType, lv_challenge, lv_index);
            if ((lv_allowedEnemy != "") && (CMUIX_EnemySelectionEnemyIsValidForRace(lv_allowedEnemy, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_allowedEnemy) == true) && (CMUIX_MutatorChallengeEnemyAlreadyListed(lv_allowedEnemy, lv_slot) == false)) {
                CMUIX_MutatorChallengeEnemySetListItem(lv_slot, lv_allowedEnemy, lv_playerGroup);
                lv_slot += 1;
            }

            lv_index += 1;
        }
    }
    else {
        if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomOfficial, lv_raceFilter) == true)) {
            CMUIX_MutatorChallengeEnemySetListItem(lv_slot, CMUIX_EnemySelection_RandomOfficial, lv_playerGroup);
            lv_slot += 1;
        }

        if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomUnofficial, lv_raceFilter) == true)) {
            CMUIX_MutatorChallengeEnemySetListItem(lv_slot, CMUIX_EnemySelection_RandomUnofficial, lv_playerGroup);
            lv_slot += 1;
        }

        while ((lv_factionIndex <= lv_factionCount) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
            lv_faction = UserDataInstance("CoopAIFactions", lv_factionIndex);
            lv_randomEnemy = CMUIX_EnemySelectionRandomFaction(lv_faction);
            if ((lv_randomEnemy != "") && (CMUIX_EnemySelectionRandomHasCandidate(lv_randomEnemy, lv_raceFilter) == true)) {
                CMUIX_MutatorChallengeEnemySetListItem(lv_slot, lv_randomEnemy, lv_playerGroup);
                lv_slot += 1;
            }

            lv_factionIndex += 1;
        }

        lv_index = 1;
        while ((lv_index <= lv_count) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
            lv_instance = UserDataInstance("CoopAICommanders", lv_index);
            if ((CMUIX_EnemySelectionEnemyShouldShowForRace(lv_instance, lv_raceFilter) == true) && (CMUIX_EnemySelectionIsRandom(lv_instance) == false)) {
                CMUIX_MutatorChallengeEnemySetListItem(lv_slot, lv_instance, lv_playerGroup);
                lv_slot += 1;
            }

            lv_index += 1;
        }
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyDescriptionLabel, CMUIX_EnemySelectionDescription(CMUIX_EnemySelectionDraft), lv_playerGroup);
}

void CMUIX_MutatorChallengeEnemyRefreshListSelection(int lp_player) {
    int lv_index;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        if ((libCMUI_gv_mutatorChallengeEnemyItemEnemies[lv_index] != "") && (CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeEnemyItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mutatorChallengeEnemyItems[lv_index], (libCMUI_gv_mutatorChallengeEnemyItemEnemies[lv_index] == CMUIX_EnemySelectionDraft), lv_playerGroup);
        }

        lv_index += 1;
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeEnemyDescriptionLabel, CMUIX_EnemySelectionDescription(CMUIX_EnemySelectionDraft), lv_playerGroup);
}

string CMUIX_MutatorChallengeRandomVisibleChallenge(string lp_type) {
    int lv_slot;
    int lv_typeIndex;
    int lv_candidateCount;
    string lv_challenge;
    string lv_selected;

    lv_slot = 1;
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lp_type);
    lv_candidateCount = 0;
    lv_challenge = "";
    lv_selected = "";
    CMUIX_MutatorChallengeInitializeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lp_type);
    while ((lv_slot < CMUIX_MutatorChallengeVisibleCount[lv_typeIndex]) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        lv_challenge = CMUIX_MutatorChallengeVisibleChallenges[lv_typeIndex][lv_slot];
        if ((lv_challenge != "") && (CMUIX_MutatorChallengeIsRandom(lv_challenge) == false)) {
            lv_candidateCount += 1;
            if ((RandomInt(1, lv_candidateCount) == 1)) {
                lv_selected = lv_challenge;
            }
        }

        lv_slot += 1;
    }

    if ((lv_selected == "")) {
        lv_selected = CMUIX_MutatorChallengeDefault[lv_typeIndex];
    }

    return lv_selected;
}

void CMUIX_MutatorChallengeAccept(int lp_player) {
    int lv_typeIndex;
    string lv_type;
    string lv_draft;
    string lv_challenge;

    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    lv_draft = CMUIX_MutatorChallengeDraft[lv_typeIndex];
    lv_challenge = CMUIX_MutatorChallengeNormalizeSelection(lv_type, lv_draft);
    if ((lv_challenge == "")) {
        lv_challenge = CMUIX_MutatorChallengeDefault[lv_typeIndex];
    }

    if ((lv_challenge == "")) {
        lv_challenge = CMUIX_MutatorChallenge_Random;
    }

    CMUIX_MutatorChallengeSelected[lv_typeIndex] = lv_challenge;
    CMUIX_MutatorChallengeDraft[lv_typeIndex] = lv_challenge;
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_ProfileEnforceCommanderSelections();
    libCMUI_gf_ScreenCoopCommanderInitFromData();
    if ((CMUIX_MutatorChallengeIsRandom(lv_challenge) == false)) {
        CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(lv_type, lv_challenge, CMUIX_EnemySelectionDraft);
    }

    CMUIX_DifficultyRefreshAll();
    CMUIX_MutatorChallengeRefreshButton();
    CMUIX_MutatorChallengeRefreshListSelection(lp_player);
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_MutatorInfoRefreshAll();
}

void CMUIX_MutatorChallengeCancel() {
    int lv_typeIndex;

    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
    CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    CMUIX_ProfileRuntimeLocksRefresh();
}

void CMUIX_MutatorChallengeSetCurrentType(string lp_type) {
    CMUIX_MutatorChallengeCurrentType = CMUIX_MutatorChallengeNormalizeType(lp_type);
    CMUIX_MutatorChallengeEnsureSelection();
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_MutatorChallengeRefreshButton();
}

void CMUIX_MutatorChallengeRefreshAll() {
    CMUIX_MutatorChallengeEnsureSelection();
    CMUIX_MutatorChallengeRefreshButton();
}

bool CMUIX_MutatorChallengeHandleClick(int lp_player, int lp_control) {
    int lv_index;
    int lv_typeIndex;

    lv_index = 0;
    lv_typeIndex = 0;
    if ((lp_control == libCMUI_gv_screenCoopNavigationMutatorButton)) {
        CMUIX_MutatorChallengeSetCurrentType(CMUIX_MutatorChallenge_Type_Official);
        CMUIX_MutatorChallengeRefreshList(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
        return true;
    }

    if ((lp_control == libCMUI_gv_screenCoopNavigationCMMutatorButton)) {
        CMUIX_MutatorChallengeSetCurrentType(CMUIX_MutatorChallenge_Type_CM);
        CMUIX_MutatorChallengeRefreshList(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
        return true;
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeButton) == false)) {
        return false;
    }

    if ((lp_control == libCMUI_gv_mutatorChallengeButton)) {
        CMUIX_StartupRefreshControls();
        CMUIX_MutatorChallengeEnsureSelection();
        lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
        CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeSelected[lv_typeIndex];
        CMUIX_EnemySelectionDraft = CMUIX_EnemySelectionSelected;
        CMUIX_MutatorChallengeRefreshButton();
        CMUIX_MutatorChallengeRefreshListSelection(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshListSelection(lp_player);
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_mutatorChallengeContainer, lp_player, "CMUIXShow");
        return true;
    }

    if ((lp_control == libCMUI_gv_mutatorChallengeAcceptButton)) {
        CMUIX_MutatorChallengeAccept(lp_player);
        CMUIX_EnemySelectionAccept(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_mutatorChallengeContainer, lp_player, "CMUIXHide");
        return true;
    }

    if ((lp_control == libCMUI_gv_mutatorChallengeCloseButton)) {
        CMUIX_MutatorChallengeCancel();
        CMUIX_EnemySelectionCancel();
        CMUIX_MutatorChallengeRefreshListSelection(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshListSelection(lp_player);
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_mutatorChallengeContainer, lp_player, "CMUIXHide");
        return true;
    }

    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        if ((lp_control == libCMUI_gv_mutatorChallengeItems[lv_index])) {
            lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
            CMUIX_MutatorChallengeDraft[lv_typeIndex] = libCMUI_gv_mutatorChallengeItemChallenges[lv_index];
            if ((CMUIX_MutatorChallengeDraft[lv_typeIndex] != "")) {
                CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForCurrent(CMUIX_EnemySelectionDraft);
                CMUIX_MutatorChallengeRefreshListSelection(lp_player);
                CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
            }

            return true;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        if ((lp_control == libCMUI_gv_mutatorChallengeEnemyItems[lv_index])) {
            if ((CMUIX_MutatorChallengeDraftLockedAI() != "")) {
                return true;
            }

            CMUIX_EnemySelectionDraft = libCMUI_gv_mutatorChallengeEnemyItemEnemies[lv_index];
            if ((CMUIX_EnemySelectionDraft != "")) {
                CMUIX_MutatorChallengeEnemyRefreshListSelection(lp_player);
                CMUIX_MutatorChallengeRefreshDetails(lp_player, CMUIX_MutatorChallengeCurrentDraft());
            }

            return true;
        }

        lv_index += 1;
    }

    return false;
}

int libCMUI_gf_PlayerLevelValueOrZero(string lp_playerLevelInstance) {
    if ((lp_playerLevelInstance == "")) {
        return 0;
    }

    return libCOOC_gf_CC_PlayerLevelValue(lp_playerLevelInstance);
}

// Detail tiles only render display data. Gameplay unlock state stays in COOC
// and CCommander; these functions avoid writing progression-related fields.
void libCMUI_gf_ClearUpgradeTiles(int lp_player) {
    int lv_index;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_Commander_Level_Max)) {
        DialogControlSetVisible(libCMUI_gv_talentTileListItems[lv_index], lv_playerGroup, false);
        DialogControlSetAnimationState(libCMUI_gv_talentTileListItems[lv_index], lv_playerGroup, "LockState", "Locked");
        lv_index += 1;
    }
}

void libCMUI_gf_RefreshUpgradeTiles(int lp_player, string lp_commander) {
    playergroup lv_playerGroup;
    int lv_index;
    int lv_level;
    int lv_slot;
    int lv_commanderLevel;
    int lv_perkCount;
    string lv_campaignPerkInstance;
    string lv_playerLevelInstance;

    lv_playerGroup = PlayerGroupSingle(lp_player);
    lv_index = 0;
    lv_level = 0;
    lv_slot = 0;
    lv_commanderLevel = libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander);
    lv_perkCount = UserDataInstanceCount("CoopCampaignPerk");
    lv_campaignPerkInstance = "";
    lv_playerLevelInstance = "";
    libCMUI_gf_ClearUpgradeTiles(lp_player);

    while ((lv_index < libCMUI_gv_cMUI_Commander_Level_Max)) {
        libCMUI_gv_talentTileListItemsSetted[lv_index] = false;
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= lv_perkCount)) {
        lv_campaignPerkInstance = UserDataInstance("CoopCampaignPerk", lv_index);
        lv_playerLevelInstance = libCOOC_gf_CC_PerkLevel(lv_campaignPerkInstance);
        if ((libCOOC_gf_CC_PlayerLevelCommander(lv_playerLevelInstance) == lp_commander)) {
            lv_level = libCMUI_gf_PlayerLevelValueOrZero(lv_playerLevelInstance);
            lv_slot = (lv_level - 1);
            if ((lv_level > 0) && (lv_slot >= 0) && (lv_slot < libCMUI_gv_cMUI_Commander_Level_Max)) {
                libNtve_gf_SetDialogItemImage(libCMUI_gv_talentTileListImage[lv_slot], libCOOC_gf_CC_PerkIcon(lv_campaignPerkInstance), lv_playerGroup);
                libNtve_gf_SetDialogItemTooltip(libCMUI_gv_talentTileListItems[lv_slot], libCOOC_gf_CC_PerkTooltip(lv_campaignPerkInstance), lv_playerGroup);
                libNtve_gf_SetDialogItemText(libCMUI_gv_talentTileListLevelLabel[lv_slot], IntToText(lv_level), lv_playerGroup);
                if ((lv_commanderLevel >= lv_level)) {
                    DialogControlSetAnimationState(libCMUI_gv_talentTileListItems[lv_slot], lv_playerGroup, "EarnedState", "Earned");
                }
                else {
                    DialogControlSetAnimationState(libCMUI_gv_talentTileListItems[lv_slot], lv_playerGroup, "EarnedState", "Unearned");
                }

                libCMUI_gv_talentTileListItemsSetted[lv_slot] = true;
            }
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_Commander_Level_Max)) {
        if ((libCMUI_gv_talentTileListItemsSetted[lv_index] == true)) {
            DialogControlSetVisible(libCMUI_gv_talentTileListItems[lv_index], lv_playerGroup, true);
        }
        else {
            DialogControlSetVisible(libCMUI_gv_talentTileListItems[lv_index], lv_playerGroup, false);
        }

        lv_index += 1;
    }
}

bool libCMUI_gf_CampaignPerkUnitCommanderMatches(string lp_commander, string lp_unitEntry) {
    string lv_commanderEntry;

    lv_commanderEntry = UserDataGetUserInstance("CampaignPerkUnit", lp_unitEntry, "Commander", 1);
    if ((lp_commander == lv_commanderEntry)) {
        return true;
    }

    return false;
}

int libCMUI_gf_CampaignPerkUnitLevelValue(string lp_unitEntry, string lp_field) {
    string lv_levelInstance;

    lv_levelInstance = UserDataGetUserInstance("CampaignPerkUnit", lp_unitEntry, lp_field, 1);
    return libCMUI_gf_PlayerLevelValueOrZero(lv_levelInstance);
}

bool libCMUI_gf_CampaignPerkUnitShouldShow(int lp_player, string lp_commander, string lp_unitEntry) {
    int lv_slot;
    int lv_commanderLevel;
    int lv_minLevel;
    int lv_maxLevel;
    string lv_unit;

    lv_slot = UserDataGetInt("CampaignPerkUnit", lp_unitEntry, "Slot", 1);
    lv_commanderLevel = libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander);
    lv_minLevel = libCMUI_gf_CampaignPerkUnitLevelValue(lp_unitEntry, "Level");
    lv_maxLevel = libCMUI_gf_CampaignPerkUnitLevelValue(lp_unitEntry, "MaxLevel");
    lv_unit = UserDataGetGameLink("CampaignPerkUnit", lp_unitEntry, "Unit", 1);
    if ((lp_unitEntry == "") || (UserDataGetInt("CampaignPerkUnit", lp_unitEntry, "Hidden", 1) != 0) || (libCMUI_gf_CampaignPerkUnitCommanderMatches(lp_commander, lp_unitEntry) == false) || (lv_unit == "") || (lv_slot < 0) || (lv_slot >= libCMUI_gv_cMUI_Units_Count_Max) || ((lv_minLevel > 0) && (lv_commanderLevel < lv_minLevel)) || ((lv_maxLevel > 0) && (lv_commanderLevel > lv_maxLevel))) {
        return false;
    }

    return true;
}

bool libCMUI_gf_CampaignPerkUnitUnlockForLevel(int lp_player, string lp_commander, string lp_unitEntry) {
    int lv_commanderLevel;
    int lv_unlockLevel;

    lv_commanderLevel = libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander);
    lv_unlockLevel = libCMUI_gf_CampaignPerkUnitLevelValue(lp_unitEntry, "UnlockLevel");
    if ((lv_commanderLevel >= lv_unlockLevel) || (lv_unlockLevel <= 0)) {
        return true;
    }

    return false;
}

string libCMUI_gf_CampaignPerkUnitIcon(string lp_unitEntry) {
    string lv_icon;
    string lv_unit;

    lv_icon = UserDataGetImagePath("CampaignPerkUnit", lp_unitEntry, "IconOverride", 1);
    lv_unit = UserDataGetGameLink("CampaignPerkUnit", lp_unitEntry, "Unit", 1);
    if ((lv_icon != "")) {
        return lv_icon;
    }

    if ((lv_unit != "")) {
        lv_icon = CatalogFieldValueGet(c_gameCatalogActor, lv_unit, "UnitIcon", c_playerAny);
        if ((lv_icon != "")) {
            return lv_icon;
        }
    }

    return "Assets\\Textures\\btn-missing-kaeo.dds";
}

text libCMUI_gf_CampaignPerkUnitDescription(string lp_unitEntry) {
    string lv_perkUnit;

    lv_perkUnit = UserDataGetGameLink("CampaignPerkUnit", lp_unitEntry, "Unit", 1);
    if ((lv_perkUnit == "")) {
        return StringExternal("Param/Value/lib_CMUI_D4B78EE0");
    }

    return StringExternal(CatalogFieldValueGet(c_gameCatalogUnit, lv_perkUnit, "Description", c_playerAny));
}

text libCMUI_gf_CampaignPerkUnitName(string lp_unitEntry) {
    string lv_perkUnit;

    lv_perkUnit = UserDataGetGameLink("CampaignPerkUnit", lp_unitEntry, "Unit", 1);
    if ((lv_perkUnit == "")) {
        return StringExternal("Param/Value/lib_CMUI_9EDA9CBF");
    }

    return StringExternal(CatalogFieldValueGet(c_gameCatalogUnit, lv_perkUnit, "Name", c_playerAny));
}

text libCMUI_gf_CampaignPerkUnitTooltip(string lp_unitEntry) {
    TextExpressionSetToken("Param/Expression/lib_CMUI_AF2CEF05", "NAME", libCMUI_gf_CampaignPerkUnitName(lp_unitEntry));
    TextExpressionSetToken("Param/Expression/lib_CMUI_AF2CEF05", "DESCRIPTION", libCMUI_gf_CampaignPerkUnitDescription(lp_unitEntry));
    return TextExpressionAssemble("Param/Expression/lib_CMUI_AF2CEF05");
}

void libCMUI_gf_ClearUnitTiles(int lp_player) {
    int lv_index;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_Units_Count_Max)) {
        DialogControlSetVisible(libCMUI_gv_unitTileListItems[lv_index], lv_playerGroup, false);
        DialogControlSetAnimationState(libCMUI_gv_unitTileListItems[lv_index], lv_playerGroup, "LockState", "Locked");
        lv_index += 1;
    }
}

void libCMUI_gf_RefreshUnitTiles(int lp_player, string lp_commander) {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_unitEntry;
    string lv_icon;
    playergroup lv_playerGroup;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CampaignPerkUnit");
    lv_slot = 0;
    lv_unitEntry = "";
    lv_icon = "";
    lv_playerGroup = PlayerGroupSingle(lp_player);
    libCMUI_gf_ClearUnitTiles(lp_player);
    while ((lv_index <= lv_count)) {
        lv_unitEntry = UserDataInstance("CampaignPerkUnit", lv_index);
        if ((libCMUI_gf_CampaignPerkUnitShouldShow(lp_player, lp_commander, lv_unitEntry) == true)) {
            lv_slot = UserDataGetInt("CampaignPerkUnit", lv_unitEntry, "Slot", 1);
            lv_icon = libCMUI_gf_CampaignPerkUnitIcon(lv_unitEntry);
            libNtve_gf_SetDialogItemImage(libCMUI_gv_unitTileListImage[lv_slot], lv_icon, lv_playerGroup);
            libNtve_gf_SetDialogItemTooltip(libCMUI_gv_unitTileListItems[lv_slot], libCMUI_gf_CampaignPerkUnitTooltip(lv_unitEntry), lv_playerGroup);
            libNtve_gf_SetDialogItemImage(libCMUI_gv_unitTileListItems[lv_slot], lv_icon, lv_playerGroup);
            if ((libCMUI_gf_CampaignPerkUnitUnlockForLevel(lp_player, lp_commander, lv_unitEntry) == true)) {
                DialogControlSetAnimationState(libCMUI_gv_unitTileListItems[lv_slot], lv_playerGroup, "LockState", "Unlocked");
            }
            else {
                DialogControlSetAnimationState(libCMUI_gv_unitTileListItems[lv_slot], lv_playerGroup, "LockState", "Locked");
            }

            DialogControlSetVisible(libCMUI_gv_unitTileListItems[lv_slot], lv_playerGroup, true);
        }

        lv_index += 1;
    }
}

void libCMUI_gf_ApplyCommanderSelectionVisuals(int lp_player, int lp_commander) {
    int lv_index;
    int lv_selfSelection;
    int lv_allyPlayer;
    int lv_allySelection;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_selfSelection = lp_commander;
    lv_allyPlayer = 0;
    lv_allySelection = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    if ((lv_selfSelection == 0) && (lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_selfSelection = libCMUI_gv_selectedCommanderIndex[lp_player];
    }

    lv_allyPlayer = CMUIX_DefaultAllianceTarget(lp_player);
    if ((lv_allyPlayer >= 1) && (lv_allyPlayer <= libCOOC_gv_cCC_MAXPLAYERS) && (lv_allyPlayer != lp_player)) {
        lv_allySelection = libCMUI_gv_selectedCommanderIndex[lv_allyPlayer];
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        if ((lv_selfSelection == (lv_index + 1))) {
            if ((lv_allySelection == (lv_index + 1))) {
                DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_playerGroup, "SelectionState", "Both");
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_commanderItems[lv_index], true, lv_playerGroup);
            }
            else {
                DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_playerGroup, "SelectionState", "Self");
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_commanderItems[lv_index], true, lv_playerGroup);
            }
        }
        else {
            if ((lv_allySelection == (lv_index + 1))) {
                DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_playerGroup, "SelectionState", "Ally");
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_commanderItems[lv_index], true, lv_playerGroup);
            }
            else {
                DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_playerGroup, "SelectionState", "None");
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_commanderItems[lv_index], false, lv_playerGroup);
            }
        }

        lv_index += 1;
    }

    CMUIX_RefreshCommanderMasteryVisualsForViewer(lp_player);
}

// Selection is stored by target player. A viewer can temporarily target an ally,
// but the selected slot and cutscene still belong to that target player.
void libCMUI_gf_PlayCommanderCutscene(int lp_player, string lp_commander) {
    if ((lp_player < 0) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CutsceneAddFilter(libCMUI_gv_foregroundCutsceneFilm[lp_player], libCOOC_gf_CC_CommanderAvatarFilter(lp_commander));
    CutsceneGoToBookmark(libCMUI_gv_foregroundCutsceneFilm[lp_player], "CharacterBirthStart");
    CutscenePlay(libCMUI_gv_foregroundCutsceneFilm[lp_player]);
}

void libCMUI_gf_ScreenCoopCommanderSelect(int lp_player, int lp_commander) {
    playergroup lv_playerGroup;
    string lv_indexCommander;

    lv_playerGroup = PlayerGroupSingle(lp_player);
    lv_indexCommander = UserDataInstance("PlayerCommanders", lp_commander);
    if ((lp_commander < 1) || (lp_commander > (UserDataInstanceCount("PlayerCommanders") + 1))) {
        TriggerDebugOutput(1, StringExternal("Param/Value/lib_CMUI_BD1EF8C0"), true);
        return;
    }

    libCMUI_gf_ApplyCommanderSelectionVisuals(lp_player, lp_commander);
    if ((lp_commander > UserDataInstanceCount("PlayerCommanders"))) {
        DialogControlSetAnimationState(libCMUI_gv_detailsContainer, lv_playerGroup, "RandomState", "Random");
        libCMUI_gf_PlayCommanderCutscene(lp_player, lv_indexCommander);
        libNtve_gf_SetDialogItemText(libCMUI_gv_detailsLabel, StringExternal("Commander/Details/Random"), lv_playerGroup);
        libNtve_gf_SetDialogItemText(libCMUI_gv_descriptionLabel, StringExternal("Commander/Description/Random"), lv_playerGroup);
        libNtve_gf_SetDialogItemImage(libCMUI_gv_commanderDetailsBackground, "Assets\\Textures\\sc2_ui_versus_detail_iconbackground_random.dds", lv_playerGroup);
        return;
    }

    DialogControlSetAnimationState(libCMUI_gv_detailsContainer, lv_playerGroup, "RandomState", "NotRandom");
    libCMUI_gf_PlayCommanderCutscene(lp_player, lv_indexCommander);
    libCMUI_gf_RefreshUpgradeTiles(lp_player, lv_indexCommander);
    libCMUI_gf_RefreshUnitTiles(lp_player, lv_indexCommander);
    libNtve_gf_SetDialogItemText(libCMUI_gv_detailsLabel, libCOOC_gf_CC_CommanderStory(lv_indexCommander), lv_playerGroup);
    libNtve_gf_SetDialogItemText(libCMUI_gv_descriptionLabel, libCOOC_gf_CC_CommanderStoryTitle(lv_indexCommander), lv_playerGroup);
    libNtve_gf_SetDialogItemImage(libCMUI_gv_commanderDetailsBackground, libCOOC_gf_CC_CmmanderTraitIcon(lv_indexCommander), lv_playerGroup);
}

int CMUIX_CommanderSelectionIndexForInstance(string lp_commander) {
    int lv_index;
    int lv_count;
    string lv_instance;

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_instance = "";
    if ((lp_commander == "") || (lp_commander == "Random")) {
        return 0;
    }

    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("PlayerCommanders", lv_index);
        if ((lv_instance == lp_commander)) {
            return lv_index;
        }

        lv_index += 1;
    }

    return 0;
}

string CMUIX_DefaultCommanderForPlayer(int lp_player) {
    int lv_index;
    int lv_count;
    string lv_commander;

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_commander = "TerranRaynor";
    if ((lp_player == 2)) {
        lv_commander = "TerranMengsk";
    }

    if ((CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == true)) {
        return lv_commander;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == true)) {
            return lv_commander;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_LoadSavedCommanderForPlayer(int lp_player) {
    bank lv_bank;
    string lv_commander;

    lv_bank = null;
    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return "";
    }

    if ((BankExists(CMUIX_PROFILE_BANK, lp_player) == false)) {
        return "";
    }

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return "";
    }

    lv_commander = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "ActiveCommander", "");
    if ((lv_commander == "") || (lv_commander == null)) {
        return "";
    }

    if ((CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0)) {
        return "";
    }
    if (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false) {
        return "";
    }

    return lv_commander;
}

void CMUIX_RecordCommanderSelection(int lp_player, int lp_selection) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_selection >= 1) && (lp_selection <= UserDataInstanceCount("PlayerCommanders"))) {
        libCOTF_gv_sELECTED_Commander[lp_player] = UserDataInstance("PlayerCommanders", lp_selection);
        libCOTF_gv_sELECTED_Commander_Random[lp_player] = false;
    }
    else {
        libCOTF_gv_sELECTED_Commander[lp_player] = "";
        libCOTF_gv_sELECTED_Commander_Random[lp_player] = true;
    }
}

void CMUIX_SetCommanderSelectionForPlayer(int lp_player, int lp_selection) {
    int lv_previousSelection;
    string lv_commander;

    lv_previousSelection = 0;
    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_selection < 1) || (lp_selection > (UserDataInstanceCount("PlayerCommanders") + 1))) {
        return;
    }

    if ((lp_selection <= UserDataInstanceCount("PlayerCommanders"))) {
        lv_commander = UserDataInstance("PlayerCommanders", lp_selection);
        if ((CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
            return;
        }
    }

    lv_previousSelection = libCMUI_gv_selectedCommanderIndex[lp_player];
    if ((lv_previousSelection == lp_selection)) {
        CMUIX_RecordCommanderSelection(lp_player, lp_selection);
        return;
    }

    if ((lv_previousSelection >= 1) && (lv_previousSelection <= (UserDataInstanceCount("PlayerCommanders") + 1)) && (libCMUI_gv_commanderSelectedCount[lv_previousSelection] > 0)) {
        libCMUI_gv_commanderSelectedCount[lv_previousSelection] -= 1;
    }

    libCMUI_gv_selectedCommanderIndex[lp_player] = lp_selection;
    libCMUI_gv_commanderSelectedCount[lp_selection] += 1;
    CMUIX_RecordCommanderSelection(lp_player, lp_selection);
}

int CMUIX_InitialCommanderSelectionForPlayer(int lp_player) {
    string lv_commander;
    int lv_selection;
    int lv_index;
    int lv_count;

    lv_commander = CMUIX_LoadSavedCommanderForPlayer(lp_player);
    lv_selection = CMUIX_CommanderSelectionIndexForInstance(lv_commander);
    if ((lv_selection != 0)) {
        return lv_selection;
    }

    lv_commander = CMUIX_DefaultCommanderForPlayer(lp_player);
    lv_selection = CMUIX_CommanderSelectionIndexForInstance(lv_commander);
    if ((lv_selection != 0) && (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == true)) {
        return lv_selection;
    }

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == true) {
            return lv_index;
        }

        lv_index += 1;
    }

    return 0;
}

void CMUIX_EnsureInitialCommanderSelectionForPlayer(int lp_player) {
    int lv_selection;

    lv_selection = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((libCMUI_gv_selectedCommanderIndex[lp_player] != 0)) {
        CMUIX_RecordCommanderSelection(lp_player, libCMUI_gv_selectedCommanderIndex[lp_player]);
        return;
    }

    lv_selection = CMUIX_InitialCommanderSelectionForPlayer(lp_player);
    if ((lv_selection != 0)) {
        CMUIX_SetCommanderSelectionForPlayer(lp_player, lv_selection);
    }
}

void CMUIX_RefreshCommanderSelectionForPlayer(int lp_player) {
    int lv_selection;

    lv_selection = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_selection = libCMUI_gv_selectedCommanderIndex[lp_player];
    if ((lv_selection != 0)) {
        libCMUI_gf_ScreenCoopCommanderSelect(lp_player, lv_selection);
    }
}

void CMUIX_EnsureInitialCommanderSelections() {
    CMUIX_EnsureInitialCommanderSelectionForPlayer(1);
    CMUIX_EnsureInitialCommanderSelectionForPlayer(2);
    CMUIX_RefreshCommanderSelectionForPlayer(1);
    CMUIX_RefreshCommanderSelectionForPlayer(2);
}

void CMUIX_RefreshCommanderSelectionVisualsForViewer(int lp_viewer) {
    int lv_selection;

    lv_selection = 0;
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_selection = libCMUI_gv_selectedCommanderIndex[lp_viewer];
    libCMUI_gf_ApplyCommanderSelectionVisuals(lp_viewer, lv_selection);
}

void CMUIX_RefreshCommanderSelectionVisualsAll() {
    int lv_viewer;

    lv_viewer = 1;
    while ((lv_viewer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_RefreshCommanderSelectionVisualsForViewer(lv_viewer);
        lv_viewer += 1;
    }
}

