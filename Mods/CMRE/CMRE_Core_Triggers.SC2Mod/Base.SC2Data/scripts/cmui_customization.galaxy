    DialogControlHookup(CMUIX_ConsoleRootContainer, c_triggerControlTypeButton, "ChatBar/ChatDebugButton");
    CMUIX_ConsoleEntryButton = DialogControlLastCreated();
    if ((lv_oldRoot != CMUIX_ConsoleRootContainer) || (lv_oldEntry != CMUIX_ConsoleEntryButton)) {
        CMUIX_ConsoleHooked = false;
    }
}

