    DialogControlSetVisible(CMUIX_ConsoleAuthPanel, PlayerGroupAll(), false);
    CMUIX_ConsoleHooked = true;
}

void CMUIX_ConsoleToggle(int lp_player) {
    bool lv_visible;

    lv_visible = false;
    CMUIX_ConsoleHookupEntryButton();
    if ((CMUIX_ConsoleHooked == false)) {
        CMUIX_ConsoleHookup();
        if ((CMUIX_ConsoleHooked == false)) {
            return;
        }
    }

    lv_visible = DialogControlIsVisible(CMUIX_ConsolePanel, lp_player);
    if ((lv_visible == false)) {
        CMUIX_ConsoleApplyStateForPlayer(lp_player);
    }

    DialogControlSetVisible(CMUIX_ConsolePanel, PlayerGroupSingle(lp_player), (lv_visible == false));
}

void CMUIX_ConsoleOpen(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_ConsoleHookupEntryButton();
    if ((CMUIX_ConsoleHooked == false)) {
        CMUIX_ConsoleHookup();
        if ((CMUIX_ConsoleHooked == false)) {
            return;
        }
    }

    CMUIX_ConsoleMinimized[lp_player] = false;
    CMUIX_ConsoleApplyStateForPlayer(lp_player);
    DialogControlSetVisible(CMUIX_ConsolePanel, PlayerGroupSingle(lp_player), true);
}

bool CMUIX_ConsoleHandleControlEvent(int lp_player, int lp_control) {
    int lv_index;

    lv_index = 1;
    if ((CMUIX_ConsoleHooked == false)) {
        return false;
    }

    if ((lp_control == CMUIX_ConsoleAuthButton)) {
        CMUIX_ConsoleAuthToggle(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnButton)) {
        CMUIX_ConsoleSpawnToggle(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleTeleportButton)) {
        CMUIX_ConsoleTeleportShortcut(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleCopyButton)) {
        CMUIX_ConsoleCopyShortcut(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsolePasteButton)) {
        CMUIX_ConsolePasteShortcut(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleOpacitySlider)) {
        CMUIX_ConsoleSetOpacityPercent(lp_player, RoundI(libNtve_gf_DialogItemValue(CMUIX_ConsoleOpacitySlider, lp_player)), false);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleAuthCloseButton)) {
        DialogControlSetVisible(CMUIX_ConsoleAuthPanel, PlayerGroupSingle(lp_player), false);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleAuthMinimizeButton)) {
        CMUIX_ConsoleAuthToggleMinimized(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleAuthApplyButton)) {
        CMUIX_ConsoleAuthApply(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleAuthClearButton)) {
        CMUIX_ConsoleAuthClear(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleAuthCodeBox)) {
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnCloseButton)) {
        DialogControlSetVisible(CMUIX_ConsoleSpawnPanel, PlayerGroupSingle(lp_player), false);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnMinimizeButton)) {
        CMUIX_ConsoleSpawnToggleMinimized(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnSearchBox)) {
        CMUIX_ConsoleSpawnRefresh(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnSearchClearButton)) {
        if ((CMUIX_IsControlValid(CMUIX_ConsoleSpawnSearchBox) == true)) {
            libNtve_gf_SetDialogItemEditorValue(CMUIX_ConsoleSpawnSearchBox, "", PlayerGroupSingle(lp_player));
        }

        CMUIX_ConsoleSpawnRefresh(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleSpawnExecuteButton)) {
        CMUIX_ConsoleSpawnExecute(lp_player);
        return true;
    }

    while ((lv_index <= CMUIX_CONSOLE_SPAWN_RESULT_MAX)) {
        if ((lp_control == CMUIX_ConsoleSpawnResultButtons[lv_index])) {
            if ((CMUIX_ConsoleSpawnResultUnits[lp_player][lv_index] != "")) {
                CMUIX_ConsoleSpawnSetSelected(lp_player, CMUIX_ConsoleSpawnResultUnits[lp_player][lv_index]);
            }

            return true;
        }

        lv_index += 1;
    }

    lv_index = 1;
    if ((lp_control == CMUIX_ConsoleMinimizeButton)) {
        CMUIX_ConsoleToggleMinimized(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_ConsoleCloseButton)) {
        DialogControlSetVisible(CMUIX_ConsolePanel, PlayerGroupSingle(lp_player), false);
        return true;
    }

    while ((lv_index <= CMUIX_ConsoleCommandCount)) {
        if ((lp_control == CMUIX_ConsoleExecuteButtons[lv_index])) {
            if ((CMUIX_ConsoleCommandVisibleForPlayer(lv_index, lp_player) == true)) {
                CMUIX_ConsoleExecute(lv_index, lp_player);
            }

            return true;
        }

        if ((lp_control == CMUIX_ConsoleToggleButtons[lv_index])) {
            if ((CMUIX_ConsoleCommandVisibleForPlayer(lv_index, lp_player) == true)) {
                if ((CMUIX_ConsoleExecute(lv_index, lp_player) == false)) {
                    CMUIX_ConsoleSyncToggleButtonState(lv_index, lp_player);
                }
                else {
                    if ((CMUIX_ConsoleCommandToggleStateKnown(lv_index) == true)) {
                        CMUIX_ConsoleSyncToggleButtonState(lv_index, lp_player);
                    }
                }
            }

            return true;
        }

        lv_index += 1;
    }

    return false;
}

void CMUIX_CustomMutatorPickerHookupAvailableItem(int lp_slot) {
