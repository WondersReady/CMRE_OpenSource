    if ((TextToString(lv_playerOne) == "") && (TextToString(lv_playerTwo) == "")) {
        return StringExternal("CMUI/ScreenHistory/Details/Unset");
    }

    if ((TextToString(lv_playerOne) == "")) {
        return lv_playerTwo;
    }

    if ((TextToString(lv_playerTwo) == "")) {
        return lv_playerOne;
    }

    return (lv_playerOne + StringToText("<n/>") + lv_playerTwo);
}

