// CMUIX_Init enters through customization hookup. Core bootstrap runs first so
// shared handles and triggers exist before any commander/map/customization refresh.
void CMUIX_CoreInitLibraries() {
    libNtve_InitVariables();
    libCOOC_InitVariables();
}

void CMUIX_CoreInitVariables() {
    int lv_index;
    int lv_player;
    int lv_view;
    int lv_pool;
    int lv_type;

    lv_index = 0;
    lv_player = 0;
    lv_view = 0;
    lv_type = 0;
    if ((CMUIX_CoreVariablesReady == true)) {
        return;
    }

    CMUIX_CoreVariablesReady = true;
    CMUIX_CommanderDataReady = false;
    CMUIX_ForegroundCommanderModelsPreloaded = false;
    libCMUI_gv_screenCoopDialog = c_invalidDialogId;
    libCMUI_gv_screenNavigationMain = c_invalidDialogControlId;
    CMUIX_MainNavigationHomeButton = c_invalidDialogControlId;
    CMUIX_MainNavigationCoopButton = c_invalidDialogControlId;
    CMUIX_MainNavigationHistoryButton = c_invalidDialogControlId;
    CMUIX_MainNavigationRebuildButton = c_invalidDialogControlId;
