bool CMUIX_KerriganNydusTopbarTargetHandler(bool testConds, bool runActions) {
    unit lv_visual;
    unit lv_network;
    point lv_point;
    int lv_player;

    lv_visual = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    lv_network = null;
    lv_point = null;
    lv_player = UnitGetOwner(lv_visual);
    if ((testConds == true)) {
        if ((UnitIsValid(lv_visual) == false)) {
            return false;
        }

        if ((UnitGetType(lv_visual) != "GreaterNydusWormVisual")) {
            return false;
        }

        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == false)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    CMUIX_KerriganNydusTopbarRefresh(lv_player);
    lv_point = UnitGetPosition(lv_visual);
    UnitRemove(lv_visual);
    if ((CMUIX_KerriganNydusNetworkReadyCount[lv_player] <= 0)) {
        return true;
    }

    lv_network = UnitGroupRandomUnit(CMUIX_KerriganNydusNetworkReady[lv_player], c_unitCountAlive);
    if ((UnitIsValid(lv_network) == true)) {
        if ((UnitGetType(lv_network) == "NydusNetworkAlly")) {
            UnitIssueOrder(lv_network, OrderTargetingPoint(AbilityCommand("BuildNydusCanal", 1), lv_point), c_orderQueueReplace);
        }
        else {
            UnitIssueOrder(lv_network, OrderTargetingPoint(AbilityCommand("BuildNydusCanal", 0), lv_point), c_orderQueueReplace);
        }
    }

    CMUIX_KerriganNydusTopbarRefreshAfterDelay(lv_player);
    if ((UnitAbilityChargeInfo(libCOMI_gv_cM_GlobalCasterUnit[lv_player], AbilityCommand("KerriganNydusTopBar", 0), c_unitAbilChargeCountLeft) > 0.0)) {
        UISetTargetingOrder(PlayerGroupSingle(lv_player), libCOMI_gv_cM_GlobalCasterUnitGroup[lv_player], OrderTargetingPoint(AbilityCommand("KerriganNydusTopBar", 0), UnitGetPosition(libCOMI_gv_cM_GlobalCasterUnit[lv_player])), false);
    }

    return true;
}

bool CMUIX_KerriganNydusNetworkBuildStartHandler(bool testConds, bool runActions) {
    unit lv_network;
    int lv_player;

    lv_network = EventUnit();
    lv_player = UnitGetOwner(lv_network);
    if ((testConds == true)) {
        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == false)) {
            return false;
        }

        if ((CMUIX_KerriganNydusTopbarUnitIsNetwork(lv_network) == false)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    if ((UnitHasBehavior2(lv_network, "KerriganNydusNetworkReady") == false)) {
        UnitBehaviorAdd(lv_network, "KerriganNydusNetworkReady", lv_network, 1);
    }

    CMUIX_KerriganNydusTopbarRefresh(lv_player);
    return true;
}

bool CMUIX_KerriganNydusNetworkReadyExpiredHandler(bool testConds, bool runActions) {
    unit lv_network;
    int lv_player;

    lv_network = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    lv_player = UnitGetOwner(lv_network);
    if ((testConds == true)) {
        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == false)) {
            return false;
        }

        if ((CMUIX_KerriganNydusTopbarUnitIsNetwork(lv_network) == false)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    CMUIX_KerriganNydusTopbarRefreshAfterDelay(lv_player);
    return true;
}

bool CMUIX_KerriganNydusNetworkUnloadHeroicHandler(bool testConds, bool runActions) {
    unit lv_target;
    unit lv_passenger;
    int lv_player;
    int lv_index;
    int lv_count;
    order lv_order;

    lv_order = Order(AbilityCommand("NydusCanalTransport", 3));
    lv_target = EventPlayerEffectUsedUnit(c_effectUnitTarget);
    lv_passenger = null;
    lv_player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    lv_index = 1;
    lv_count = 0;
    if ((testConds == true)) {
        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == false)) {
            return false;
        }

        if ((UnitIsValid(lv_target) == false)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    lv_count = UnitCargoValue(lv_target, c_unitCargoUnitCount);
    while ((lv_index <= lv_count)) {
        lv_passenger = UnitCargo(lv_target, lv_index);
        if ((UnitIsValid(lv_passenger) == true) && (UnitTypeTestAttribute(UnitGetType(lv_passenger), c_unitAttributeHeroic) == true)) {
            OrderSetTargetPassenger(lv_order, lv_passenger);
            UnitIssueOrder(lv_target, lv_order, c_orderQueueReplace);
        }

        lv_index += 1;
    }

    return true;
}

void CMUIX_KerriganNydusTopbarCreateTriggers() {
    if ((CMUIX_KerriganNydusNetworkBirthTrigger == null)) {
        CMUIX_KerriganNydusNetworkBirthTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkBirthHandler");
        TriggerAddEventPlayerEffectUsed(CMUIX_KerriganNydusNetworkBirthTrigger, c_playerAny, "NydusNetworkBirth");
        TriggerEnable(CMUIX_KerriganNydusNetworkBirthTrigger, false);
    }

    if ((CMUIX_KerriganNydusNetworkConstructionTrigger == null)) {
        CMUIX_KerriganNydusNetworkConstructionTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkConstructionHandler");
        TriggerAddEventUnitConstructProgress(CMUIX_KerriganNydusNetworkConstructionTrigger, null, c_unitProgressStageComplete);
        TriggerEnable(CMUIX_KerriganNydusNetworkConstructionTrigger, false);
    }

    if ((CMUIX_KerriganNydusNetworkDeathTrigger == null)) {
        CMUIX_KerriganNydusNetworkDeathTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkDeathHandler");
        TriggerAddEventUnitDied(CMUIX_KerriganNydusNetworkDeathTrigger, null);
        TriggerEnable(CMUIX_KerriganNydusNetworkDeathTrigger, false);
    }

    if ((CMUIX_KerriganNydusTopbarTargetTrigger == null)) {
        CMUIX_KerriganNydusTopbarTargetTrigger = TriggerCreate("CMUIX_KerriganNydusTopbarTargetHandler");
        TriggerAddEventPlayerEffectUsed(CMUIX_KerriganNydusTopbarTargetTrigger, c_playerAny, "NydusBirth");
        TriggerEnable(CMUIX_KerriganNydusTopbarTargetTrigger, false);
    }

    if ((CMUIX_KerriganNydusNetworkBuildStartTrigger == null)) {
        CMUIX_KerriganNydusNetworkBuildStartTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkBuildStartHandler");
        TriggerAddEventUnitAbility(CMUIX_KerriganNydusNetworkBuildStartTrigger, null, AbilityCommand("BuildNydusCanal", 0), c_unitAbilStageExecute, false);
        TriggerAddEventUnitAbility(CMUIX_KerriganNydusNetworkBuildStartTrigger, null, AbilityCommand("BuildNydusCanal", 1), c_unitAbilStageExecute, false);
        TriggerEnable(CMUIX_KerriganNydusNetworkBuildStartTrigger, false);
    }

    if ((CMUIX_KerriganNydusNetworkReadyExpiredTrigger == null)) {
        CMUIX_KerriganNydusNetworkReadyExpiredTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkReadyExpiredHandler");
        TriggerAddEventPlayerEffectUsed(CMUIX_KerriganNydusNetworkReadyExpiredTrigger, c_playerAny, "KerriganNydusNetworkReadyDummy");
        TriggerEnable(CMUIX_KerriganNydusNetworkReadyExpiredTrigger, false);
    }

    if ((CMUIX_KerriganNydusNetworkUnloadHeroicTrigger == null)) {
        CMUIX_KerriganNydusNetworkUnloadHeroicTrigger = TriggerCreate("CMUIX_KerriganNydusNetworkUnloadHeroicHandler");
        TriggerAddEventPlayerEffectUsed(CMUIX_KerriganNydusNetworkUnloadHeroicTrigger, c_playerAny, "NydusNetworkUnloadKerriganDummy");
        TriggerEnable(CMUIX_KerriganNydusNetworkUnloadHeroicTrigger, false);
    }
}

void CMUIX_OptimizationSetKerriganTopbar(int lp_player, bool lp_enabled) {
    string lv_commander;

    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_commander = CMUIX_OptimizationCommanderForApply(lp_player);
    if ((CMUIX_OptimizationShouldShowForCommander(CMUIX_OPTIMIZATION_KERRIGAN_TOPBAR, lv_commander) == false)) {
        if ((CMUIX_OptimizationKerriganNydusTopBarState[lp_player] != 0)) {
            libCOUI_gf_CU_GPShowHide(false, lp_player, c_transitionDurationImmediate);
        }

        CMUIX_OptimizationKerriganNydusTopBarState[lp_player] = 0;
        if ((CMUIX_OptimizationKerriganNydusTopBarCreated[lp_player] == true)) {
            libCOOC_gf_CC_SetPlayerGlobalPowerLink(lp_player, "");
        }

        CMUIX_KerriganNydusTopbarRefreshTriggerState();
        return;
    }

    if ((lp_enabled == true)) {
        CMUIX_KerriganNydusTopbarCreateTriggers();
        libCOOC_gf_CC_SetPlayerGlobalPowerLink(lp_player, "ZergKerrigan");
        if ((CMUIX_OptimizationKerriganNydusTopBarCreated[lp_player] == false)) {
            CMUIX_OptimizationCreateKerriganTopbar(lp_player);
            Wait(0.5, c_timeGame);
            libCOUI_gf_CU_GPShowHide(true, lp_player, c_transitionDurationImmediate);
        }
        else {
            libCOUI_gf_CU_GPShowHide(true, lp_player, c_transitionDurationImmediate);
        }

        CMUIX_OptimizationKerriganNydusTopBarState[lp_player] = 1;
        CMUIX_KerriganNydusTopbarRefreshTriggerState();
        CMUIX_KerriganNydusTopbarRefresh(lp_player);
        return;
    }

    if ((CMUIX_OptimizationKerriganNydusTopBarState[lp_player] != 0)) {
        libCOUI_gf_CU_GPShowHide(false, lp_player, c_transitionDurationImmediate);
    }

    CMUIX_OptimizationKerriganNydusTopBarState[lp_player] = 0;
    libCOOC_gf_CC_SetPlayerGlobalPowerLink(lp_player, "");
    CMUIX_KerriganNydusTopbarRefreshTriggerState();
}

bool CMUIX_OptimizationWarpButtonWatchHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    UISetFrameVisible(CMUIX_OptimizationWarpButtonHiddenPlayers, c_syncFrameTypePylonButton, false);
    return true;
}

unitgroup CMUIX_OptimizationAutoCreepTumorsNear(int lp_player, point lp_point, fixed lp_range) {
    unitgroup lv_group;
    unitfilter lv_filter;
    region lv_region;

    lv_group = UnitGroupEmpty();
    lv_filter = UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    lv_region = RegionCircle(lp_point, lp_range);
    UnitGroupAddUnitGroup(lv_group, UnitGroup("CreepTumorBurrowed", lp_player, lv_region, lv_filter, 0));
    UnitGroupAddUnitGroup(lv_group, UnitGroup("CreepTumorUsed", lp_player, lv_region, lv_filter, 0));
    return lv_group;
}

int CMUIX_OptimizationAutoCreepTumorCountNearGroup(unitgroup lp_tumors, point lp_point, fixed lp_range) {
    unitgroup lv_group;

    lv_group = UnitGroupEmpty();
    if ((lp_tumors == null)) {
        return 0;
    }

    lv_group = UnitGroupFilterRegion(lp_tumors, RegionCircle(lp_point, lp_range), 0);
    return UnitGroupCount(lv_group, c_unitCountAlive);
}

fixed CMUIX_OptimizationAutoCreepNearestTumorDistance(unitgroup lp_tumors, point lp_point, fixed lp_fallback) {
    unit lv_unit;

    lv_unit = null;
    if ((lp_tumors == null)) {
        return lp_fallback;
    }

    if ((UnitGroupCount(lp_tumors, c_unitCountAlive) <= 0)) {
        return lp_fallback;
    }

    lv_unit = UnitGroupClosestToPoint(lp_tumors, lp_point);
    if ((lv_unit == null)) {
        return lp_fallback;
    }

    return DistanceBetweenPoints(lp_point, UnitGetPosition(lv_unit));
}

int CMUIX_OptimizationAutoCreepFrontierScore(point lp_point, fixed lp_distance) {
    int lv_score;

    lv_score = 0;
    if ((CreepIsPresent(PointWithOffsetPolar(lp_point, lp_distance, 0.0)) == false)) {
        lv_score += 1;
    }

    if ((CreepIsPresent(PointWithOffsetPolar(lp_point, lp_distance, 90.0)) == false)) {
        lv_score += 1;
    }

    if ((CreepIsPresent(PointWithOffsetPolar(lp_point, lp_distance, 180.0)) == false)) {
        lv_score += 1;
    }

    if ((CreepIsPresent(PointWithOffsetPolar(lp_point, lp_distance, 270.0)) == false)) {
        lv_score += 1;
    }

    return lv_score;
}

fixed CMUIX_OptimizationAutoCreepCandidateScore(unitgroup lp_tumors, point lp_point, fixed lp_radius, fixed lp_maxRange) {
    int lv_closeCount;
    int lv_midCount;
    int lv_wideCount;
    int lv_frontierScore;
    fixed lv_nearestDistance;
    fixed lv_score;

    lv_closeCount = CMUIX_OptimizationAutoCreepTumorCountNearGroup(lp_tumors, lp_point, 4.0);
    lv_midCount = CMUIX_OptimizationAutoCreepTumorCountNearGroup(lp_tumors, lp_point, 8.0);
    lv_wideCount = CMUIX_OptimizationAutoCreepTumorCountNearGroup(lp_tumors, lp_point, 12.0);
    lv_frontierScore = CMUIX_OptimizationAutoCreepFrontierScore(lp_point, 3.0);
    lv_nearestDistance = CMUIX_OptimizationAutoCreepNearestTumorDistance(lp_tumors, lp_point, (lp_maxRange + 12.0));
    lv_score = 0.0;
    lv_score += (lp_radius * 8.0);
    lv_score += (lv_nearestDistance * 4.0);
    lv_score += (IntToFixed(lv_frontierScore) * 12.0);
    lv_score -= (IntToFixed(lv_closeCount) * 30.0);
    lv_score -= (IntToFixed(lv_midCount) * 8.0);
    lv_score -= (IntToFixed(lv_wideCount) * 2.0);
    lv_score += RandomFixed(0.0, 0.5);
    return lv_score;
}

bool CMUIX_OptimizationAutoCreepPointInMap(point lp_point, region lp_mapSize) {
    fixed lv_x;
    fixed lv_y;

    lv_x = PointGetX(lp_point);
    lv_y = PointGetY(lp_point);
    return ((lv_x > 1.0) && (lv_y > 1.0) && (lv_x < libNtve_gf_WidthOfRegion(lp_mapSize)) && (lv_y < libNtve_gf_HeightOfRegion(lp_mapSize)));
}

bool CMUIX_OptimizationAutoCreepTryBuildOrder(int lp_player, unit lp_tumor, point lp_point, bool lp_issueOrder) {
    order lv_order;

    lv_order = null;
    if ((lp_tumor == null) || (UnitIsAlive(lp_tumor) == false)) {
        return false;
    }

    if ((libCOOC_gf_ActiveCommanderForPlayer(lp_player) == "ZergZagara")) {
        lv_order = OrderTargetingPoint(AbilityCommand("CreepTumorBuild", 1), lp_point);
        if ((UnitOrderIsValid(lp_tumor, lv_order) == true)) {
            if ((lp_issueOrder == true)) {
                UnitIssueOrder(lp_tumor, lv_order, c_orderQueueReplace);
            }

            return true;
        }
    }

    lv_order = OrderTargetingPoint(AbilityCommand("CreepTumorBuild", 0), lp_point);
    if ((UnitOrderIsValid(lp_tumor, lv_order) == true)) {
        if ((lp_issueOrder == true)) {
            UnitIssueOrder(lp_tumor, lv_order, c_orderQueueReplace);
        }

        return true;
    }

    lv_order = OrderTargetingPoint(AbilityCommand("CreepTumorBuild", 1), lp_point);
    if ((UnitOrderIsValid(lp_tumor, lv_order) == true)) {
        if ((lp_issueOrder == true)) {
            UnitIssueOrder(lp_tumor, lv_order, c_orderQueueReplace);
        }

        return true;
    }

    return false;
}

bool CMUIX_OptimizationAutoCreepIssueBuildOrder(int lp_player, unit lp_tumor, point lp_point) {
    if ((CMUIX_OptimizationAutoCreepTryBuildOrder(lp_player, lp_tumor, lp_point, true) == true)) {
        UnitBehaviorRemove(lp_tumor, "AutoCreepTumorSpread", 1);
        return true;
    }

    return false;
}

bool CMUIX_OptimizationAutoCreepTumorHandler(bool testConds, bool runActions) {
    int lv_player;
    int lv_i;
    int lv_radiusStep;
    fixed lv_angle;
    fixed lv_baseAngle;
    unit lv_tumor;
    point lv_targetPoint;
    int lv_count;
    fixed lv_angleIncrement;
    fixed lv_range;
    fixed lv_radius;
    fixed lv_score;
    fixed lv_bestScore;
    point lv_bestPoint;
    point lv_tumorPoint;
    unitgroup lv_nearbyTumors;
    region lv_mapSize;

    lv_player = 0;
    lv_i = 1;
    lv_radiusStep = 0;
    lv_angle = 0.0;
    lv_baseAngle = libNtve_gf_RandomAngle();
    lv_tumor = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    if ((lv_tumor != null)) {
        lv_player = UnitGetOwner(lv_tumor);
    }

    lv_targetPoint = null;
    lv_mapSize = RegionEntireMap();
    lv_count = 30;
    lv_angleIncrement = 12.0;
    lv_range = 6.0;
    lv_radius = 0.0;
    lv_score = 0.0;
    lv_bestScore = -99999.0;
    lv_bestPoint = null;
    lv_tumorPoint = null;
    lv_nearbyTumors = UnitGroupEmpty();
    if ((testConds == true)) {
        if ((lv_player < 1) || (lv_player > libCOOC_gv_cCC_MAXPLAYERS)) {
            return false;
        }

        if ((lv_tumor == null) || (UnitIsAlive(lv_tumor) == false)) {
            return false;
        }

        if ((TechTreeUpgradeCount(lv_player, "AutoCreep", c_techCountCompleteOnly) <= 0)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    if ((TechTreeUpgradeCount(lv_player, "KerriganCreepBonusesCoop", c_techCountCompleteOnly) > 0)) {
        lv_range = 9.0;
    }

    lv_tumorPoint = UnitGetPosition(lv_tumor);
    lv_nearbyTumors = CMUIX_OptimizationAutoCreepTumorsNear(lv_player, lv_tumorPoint, (lv_range + 12.0));
    while ((lv_radiusStep < 4)) {
        lv_radius = (lv_range - (IntToFixed(lv_radiusStep) * 1.5));
        if ((lv_radius < 4.5)) {
            lv_radius = 4.5;
        }

        lv_i = 1;
        lv_angle = (lv_baseAngle + (IntToFixed(lv_radiusStep) * 6.0));
        while ((lv_i <= lv_count)) {
            lv_targetPoint = PointWithOffsetPolar(lv_tumorPoint, lv_radius, lv_angle);
            if ((CMUIX_OptimizationAutoCreepPointInMap(lv_targetPoint, lv_mapSize) == true)) {
                if ((CreepIsPresent(lv_targetPoint) == true)) {
                    if ((CMUIX_OptimizationAutoCreepTumorCountNearGroup(lv_nearbyTumors, lv_targetPoint, 3.0) == 0)) {
                        if ((CMUIX_OptimizationAutoCreepTryBuildOrder(lv_player, lv_tumor, lv_targetPoint, false) == true)) {
                            lv_score = CMUIX_OptimizationAutoCreepCandidateScore(lv_nearbyTumors, lv_targetPoint, lv_radius, lv_range);
                            if ((lv_bestPoint == null) || (lv_score > lv_bestScore)) {
                                lv_bestPoint = lv_targetPoint;
                                lv_bestScore = lv_score;
                            }
                        }
                    }
                }
            }

            lv_angle += lv_angleIncrement;
            lv_i += 1;
        }

        lv_radiusStep += 1;
    }

    if ((lv_bestPoint != null)) {
        CMUIX_OptimizationAutoCreepIssueBuildOrder(lv_player, lv_tumor, lv_bestPoint);
    }

    return true;
}

bool CMUIX_MapSelectionMapShouldShow(string lp_mapInstance) {
    return CMUIX_MapSelectionMapShouldShowForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_mapInstance);
}

void CMUIX_OptimizationCreateTriggers() {
    CMUIX_KerriganNydusTopbarCreateTriggers();

    if ((CMUIX_OptimizationWarpButtonWatchTrigger == null)) {
        CMUIX_OptimizationWarpButtonWatchTrigger = TriggerCreate("CMUIX_OptimizationWarpButtonWatchHandler");
        TriggerAddEventTimePeriodic(CMUIX_OptimizationWarpButtonWatchTrigger, 0.1, c_timeGame);
        TriggerEnable(CMUIX_OptimizationWarpButtonWatchTrigger, false);
        CMUIX_OptimizationRefreshWarpButtonWatchState();
    }

    if ((CMUIX_OptimizationAutoCreepTumorTrigger == null)) {
        CMUIX_OptimizationAutoCreepTumorTrigger = TriggerCreate("CMUIX_OptimizationAutoCreepTumorHandler");
        TriggerAddEventPlayerEffectUsed(CMUIX_OptimizationAutoCreepTumorTrigger, c_playerAny, "AutoCreepTumorSpreadRB");
        TriggerEnable(CMUIX_OptimizationAutoCreepTumorTrigger, false);
        CMUIX_OptimizationRefreshAutoCreepTriggerState();
    }

    CMUIX_KerriganNydusTopbarRefreshTriggerState();
}

void CMUIX_OptimizationApplyStartupEntry() {
    if ((CMUIX_CoreReady == false)) {
        CMUIX_CoreInit();
    }

    CMUIX_OptimizationRuntimeReady = true;
    CMUIX_OptimizationOneKeyTurn();
    CMUIX_RandomSeedApply();
}

void CMUIX_OptimizationOneKeyTurn() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = PlayerGroupAll();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        if ((lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_ApplyOptimizationStateForPlayer(lv_player);
        }
    }
}

void CMUIX_OptimizationApplyHigherVision(int lp_player, bool lp_enabled) {
    playergroup lv_players;

    lv_players = PlayerGroupEmpty();
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    if ((lp_enabled == true)) {
        libCOMI_gv_cM_SoAPlayerCameraDefault[lp_player] = "High";
        CameraSetData(lv_players, "High");
        return;
    }

    libCOMI_gv_cM_SoAPlayerCameraDefault[lp_player] = "Dflt";
    CameraSetData(lv_players, "Dflt");
}

void CMUIX_OptimizationApplyGlobalQueue(int lp_player, bool lp_enabled) {
    CMUIX_OptimizationSetProductionPanel(lp_player, lp_enabled);
}

void CMUIX_OptimizationApplyAutoCreep(int lp_player, string lp_commander, bool lp_enabled) {
    if ((CMUIX_OptimizationAutoCreepSupportedCommander(lp_commander) == false)) {
        CMUIX_OptimizationSetAutoCreep(lp_player, false);
        return;
    }

    CMUIX_OptimizationSetAutoCreep(lp_player, lp_enabled);
}

void CMUIX_OptimizationApplyBiomassCount(int lp_player, string lp_commander, bool lp_enabled) {
    CMUIX_OptimizationSetAbathurBiomassCount(lp_player, lp_enabled);
}

void CMUIX_OptimizationApplyWarpButton(int lp_player, string lp_commander, bool lp_enabled) {
    CMUIX_OptimizationSetWarpButton(lp_player, lp_enabled);
}

void CMUIX_OptimizationApplyKerriganTopbar(int lp_player, string lp_commander, bool lp_enabled) {
    if ((CMUIX_OptimizationShouldShowForCommander(CMUIX_OPTIMIZATION_KERRIGAN_TOPBAR, lp_commander) == false)) {
        CMUIX_OptimizationSetKerriganTopbar(lp_player, false);
        return;
    }

    CMUIX_OptimizationSetKerriganTopbar(lp_player, lp_enabled);
}

void CMUIX_OptimizationApplyRaceDefaultTransmission(int lp_player, string lp_commander, bool lp_enabled, bool lp_forcedEnabled) {
    bool lv_effectiveEnabled;

    lv_effectiveEnabled = lp_enabled;
    if ((lp_forcedEnabled == true)) {
        lv_effectiveEnabled = true;
    }

    CMVO_SetRaceDefaultTransmissionFallbackForPlayer(lp_player, lv_effectiveEnabled, lp_forcedEnabled);
    CMVO_EnsureRaceDefaultTransmissionFallbackForPlayer(lp_player);
}

void CMUIX_ApplyOptimizationStateForPlayer(int lp_player) {
    string lv_commander;

    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    // Launcher changes only update preferences. Runtime effects begin after commander selection.
    if ((CMUIX_OptimizationRuntimeReady == false)) {
        return;
    }

    lv_commander = CMUIX_OptimizationCommanderForApply(lp_player);
    CMUIX_OptimizationApplyHigherVision(lp_player, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_HIGHER_VISION));
    CMUIX_OptimizationApplyGlobalQueue(lp_player, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_GLOBAL_QUEUE));
    CMUIX_OptimizationApplyAutoCreep(lp_player, lv_commander, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_AUTO_CREEP));
    CMUIX_OptimizationApplyBiomassCount(lp_player, lv_commander, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_BIOMASS_COUNT));
    CMUIX_OptimizationApplyWarpButton(lp_player, lv_commander, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_WARP_BUTTON));
    CMUIX_OptimizationApplyKerriganTopbar(lp_player, lv_commander, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_KERRIGAN_TOPBAR));
    CMUIX_OptimizationApplyRaceDefaultTransmission(lp_player, lv_commander, CMUIX_OptimizationEnabled(lp_player, lv_commander, CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION), CMUIX_OptimizationRaceDefaultTransmissionForced(lv_commander));
}

void CMUIX_ApplyOptimizationStateForAllPlayers() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_ApplyOptimizationStateForPlayer(lv_player);
    }
}

void CMUIX_PlayerProfileLoadMutatorPoolsToUserData(int lp_player) {
    bank lv_bank;
    string lv_mutator;
    string lv_keyPrefix;
    int lv_index;
    int lv_count;
    int lv_pool;
    int lv_value;
    int lv_defaultValue;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_mutator = "";
    lv_keyPrefix = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_pool = 1;
    lv_value = 0;
    lv_defaultValue = 0;
    if ((lv_bank == null)) {
        return;
    }

    libCOMU_gf_CT_InitMutatorUserPoolsFromDefaults();
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            lv_keyPrefix = CMUIX_ProfileMutatorPoolKey(lv_mutator, "");
            lv_pool = CMUIX_MUTATOR_POOL_RANDOM;
            while ((lv_pool <= CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
                lv_defaultValue = CMUIX_MutatorPoolDefaultNormalValue(lv_pool, lv_mutator);
                lv_value = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, (lv_keyPrefix + CMUIX_MutatorPoolStateName(lv_pool) + "|Normal"), lv_defaultValue);
                UserDataSetInt("Mutators", lv_mutator, CMUIX_MutatorPoolNormalField(lv_pool), 1, lv_value);
                lv_defaultValue = CMUIX_MutatorPoolDefaultEnhanceValue(lv_pool, lv_mutator);
                lv_value = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, (lv_keyPrefix + CMUIX_MutatorPoolStateName(lv_pool) + "|Enhance"), lv_defaultValue);
                UserDataSetInt("Mutators", lv_mutator, CMUIX_MutatorPoolEnhanceField(lv_pool), 1, lv_value);
                lv_pool += 1;
            }

            lv_defaultValue = CMUIX_MutatorPoolDefaultFirstValue(lv_mutator);
            lv_value = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, (lv_keyPrefix + "Cycle|First"), lv_defaultValue);
            UserDataSetInt("Mutators", lv_mutator, "Pool Cycle - First Allowed", 1, lv_value);
        }

        lv_index += 1;
    }

    CMUIX_MutatorPoolClearAllPlaceholderRuntimeFields();
    CMUIX_MutatorPoolDefaultsChecked = true;
    CMUIX_MutatorPoolDraftReady = false;
}

void CMUIX_PlayerProfileSaveMutatorPoolsFromUserData(int lp_player) {
    bank lv_bank;
    string lv_mutator;
    string lv_keyPrefix;
    int lv_index;
    int lv_count;
    int lv_pool;
    int lv_value;
    int lv_defaultValue;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_mutator = "";
    lv_keyPrefix = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_pool = 1;
    lv_value = 0;
    lv_defaultValue = 0;
    if ((lv_bank == null)) {
        return;
    }

    CMUIX_MutatorPoolEnsureRuntimeDefaults();
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            lv_keyPrefix = CMUIX_ProfileMutatorPoolKey(lv_mutator, "");
            lv_pool = CMUIX_MUTATOR_POOL_RANDOM;
            while ((lv_pool <= CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
                lv_value = UserDataGetInt("Mutators", lv_mutator, CMUIX_MutatorPoolNormalField(lv_pool), 1);
                lv_defaultValue = CMUIX_MutatorPoolDefaultNormalValue(lv_pool, lv_mutator);
                CMUIX_PlayerProfileSetMutatorPoolDeltaInt(lv_bank, (lv_keyPrefix + CMUIX_MutatorPoolStateName(lv_pool) + "|Normal"), lv_value, lv_defaultValue);
                lv_value = UserDataGetInt("Mutators", lv_mutator, CMUIX_MutatorPoolEnhanceField(lv_pool), 1);
                lv_defaultValue = CMUIX_MutatorPoolDefaultEnhanceValue(lv_pool, lv_mutator);
                CMUIX_PlayerProfileSetMutatorPoolDeltaInt(lv_bank, (lv_keyPrefix + CMUIX_MutatorPoolStateName(lv_pool) + "|Enhance"), lv_value, lv_defaultValue);
                lv_pool += 1;
            }

            lv_value = UserDataGetInt("Mutators", lv_mutator, "Pool Cycle - First Allowed", 1);
            lv_defaultValue = CMUIX_MutatorPoolDefaultFirstValue(lv_mutator);
            CMUIX_PlayerProfileSetMutatorPoolDeltaInt(lv_bank, (lv_keyPrefix + "Cycle|First"), lv_value, lv_defaultValue);
        }

        lv_index += 1;
    }

    if ((BankKeyCount(lv_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS) == 0)) {
        BankSectionRemove(lv_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS);
    }

    CMUIX_PlayerProfileSaveBank(lp_player);
}

string CMUIX_CoopProgressCommanderKey(string lp_commander, string lp_key) {
    return ("Commander|" + lp_commander + "|" + lp_key);
}

bool CMUIX_CoopProgressCommanderValid(string lp_commander) {
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    return (CMUIX_CommanderSelectionIndexForInstance(lp_commander) != 0);
}

void CMUIX_CoopProgressSetCommanderLevel(int lp_player, string lp_commander, int lp_level) {
    int lv_level;

    lv_level = CMUIX_ClampInt(lp_level, 0, libCOOC_gv_cCC_PLAYERLEVELMAX);
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }
    if ((CMUIX_CoopProgressCommanderValid(lp_commander) == false)) {
        return;
    }

    libCOOC_gf_CC_PlayerExperienceSetToLevel(lp_player, lv_level, lp_commander);
    libCOOC_gf_CC_PlayerLevelSet(lp_player, lv_level, lp_commander);
}

bool CMUIX_CommanderMasteryUnlocked(int lp_player, string lp_commander) {
    int lv_level;

    lv_level = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_CoopProgressCommanderValid(lp_commander) == false)) {
        return false;
    }

    lv_level = libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander);
    if ((lv_level >= CMUIX_COMMANDER_MASTERY_UNLOCK_LEVEL)) {
        return true;
    }

    return false;
}

void CMUIX_ApplyCommanderMasteryGate(int lp_player, string lp_commander) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_CoopProgressCommanderValid(lp_commander) == false)) {
        return;
    }

    if ((CMUIX_CommanderMasteryUnlocked(lp_player, lp_commander) == true)) {
        libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_player, true);
        if ((libCOOC_gf_CC_PlayerMasteryLevel(lp_player) <= 0)) {
            libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, CMUIX_MasteryPointsCurrentDefault());
        }
    }
    else {
        libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_player, false);
        libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, 0);
    }
}

void CMUIX_ApplyCommanderMasteryGateForPlayer(int lp_player) {
    string lv_commander;

    lv_commander = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_commander = CMUIX_CommanderForPlayer(lp_player);
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == false)) {
        lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    }

    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        CMUIX_ApplyCommanderMasteryGate(lp_player, lv_commander);
    }
}

void CMUIX_ApplyCommanderMasteryGateAllPlayers() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_ApplyCommanderMasteryGateForPlayer(lv_player);
    }
}

int CMUIX_CommanderSelfLevelSelectionForControl(int lp_control) {
    int lv_index;

    lv_index = 0;
    if ((lp_control == c_invalidDialogControlId)) {
        return 0;
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        if ((lp_control == CMUIX_CommanderItemLevelLabels[lv_index])) {
            return (lv_index + 1);
        }

        lv_index += 1;
    }

    return 0;
}

int CMUIX_CommanderAllyLevelSelectionForControl(int lp_control) {
    int lv_index;

    lv_index = 0;
    if ((lp_control == c_invalidDialogControlId)) {
        return 0;
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        if ((lp_control == CMUIX_CommanderItemAllyLevelLabels[lv_index])) {
            return (lv_index + 1);
        }

        lv_index += 1;
    }

    return 0;
}

int CMUIX_CommanderTalentLevelSelectionForControl(int lp_control) {
    int lv_index;

    lv_index = 0;
    if ((lp_control == c_invalidDialogControlId)) {
        return 0;
    }

    while ((lv_index < libCMUI_gv_cMUI_Commander_Level_Max)) {
        if ((lp_control == libCMUI_gv_talentTileListItems[lv_index])) {
            return CMUIX_ClampInt((lv_index + 1), 1, libCOOC_gv_cCC_PLAYERLEVELMAX);
        }

        if ((lp_control == libCMUI_gv_talentTileListImage[lv_index])) {
            return CMUIX_ClampInt((lv_index + 1), 1, libCOOC_gv_cCC_PLAYERLEVELMAX);
        }

        if ((lp_control == libCMUI_gv_talentTileListLevelLabel[lv_index])) {
            return CMUIX_ClampInt((lv_index + 1), 1, libCOOC_gv_cCC_PLAYERLEVELMAX);
        }

        lv_index += 1;
    }

    return 0;
}

bool CMUIX_CommanderLevelControlAffectsData(int lp_control) {
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }

    if ((CMUIX_CommanderSelfLevelSelectionForControl(lp_control) != 0)) {
        return true;
    }

    if ((CMUIX_CommanderAllyLevelSelectionForControl(lp_control) != 0)) {
        return true;
    }

    if ((CMUIX_CommanderTalentLevelSelectionForControl(lp_control) != 0)) {
        return true;
    }

    if ((lp_control == CMUIX_DetailsLevelLabel) || (lp_control == CMUIX_DetailsLevelRingFrame) || (lp_control == CMUIX_DetailsMaxLevelIcon) || (lp_control == CMUIX_DetailsMasterySpentLabel)) {
        return true;
    }

    if ((lp_control == CMUIX_AllianceLevelLabel) || (lp_control == CMUIX_AllianceLevelRingFrame) || (lp_control == CMUIX_AllianceMaxLevelIcon) || (lp_control == CMUIX_AllianceMasterySpentLabel)) {
        return true;
    }

    return false;
}

void CMUIX_CommanderLevelRefreshAfterClick(int lp_viewer, int lp_targetPlayer, string lp_commander) {
    if ((CMUIX_CoopProgressCommanderValid(lp_commander) == false)) {
        return;
    }

    if ((lp_targetPlayer == lp_viewer)) {
        libCMUI_gf_RefreshUpgradeTiles(lp_viewer, lp_commander);
        libCMUI_gf_RefreshUnitTiles(lp_viewer, lp_commander);
    }

    if ((CMUIX_TargetForOperator(lp_viewer) == lp_targetPlayer) && (CMUIX_TargetCommander[lp_viewer] == lp_commander)) {
        CMUIX_CustomizationInitFromData(lp_viewer, lp_targetPlayer, lp_commander, CMUIX_TargetAllianceMode[lp_viewer]);
    }
    else {
        CMUIX_CustomizationRefreshExternalFromData(lp_viewer, lp_targetPlayer, lp_commander, (lp_targetPlayer != lp_viewer));
    }

    CMUIX_RefreshCommanderSelectionVisualsAll();
    CMUIX_ReadyRefreshDataControlsAll();
    CMUIX_MapSelectionResetReadyStatus();
}

bool CMUIX_CommanderLevelHandleClick(int lp_viewer, int lp_control) {
    int lv_selection;
    int lv_talentLevel;
    int lv_targetPlayer;
    int lv_currentLevel;
    int lv_newLevel;
    string lv_commander;

    lv_selection = 0;
    lv_talentLevel = 0;
    lv_targetPlayer = 0;
    lv_currentLevel = 0;
    lv_newLevel = CMUIX_COMMANDER_MASTERY_UNLOCK_LEVEL;
    lv_commander = "";
    if ((lp_viewer < 1) || (lp_viewer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    lv_talentLevel = CMUIX_CommanderTalentLevelSelectionForControl(lp_control);
    if ((lv_talentLevel != 0)) {
        lv_targetPlayer = CMUIX_TargetForOperator(lp_viewer);
        lv_commander = CMUIX_TargetCommander[lp_viewer];
        lv_newLevel = lv_talentLevel;
        if ((lv_commander == "")) {
            lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
        }
    }
    else {
        lv_selection = CMUIX_CommanderSelfLevelSelectionForControl(lp_control);
        if ((lv_selection != 0)) {
            lv_targetPlayer = lp_viewer;
            lv_commander = CMUIX_CommanderForSelection(lv_selection);
        }
        else {
            lv_selection = CMUIX_CommanderAllyLevelSelectionForControl(lp_control);
            if ((lv_selection != 0)) {
                lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
                if ((CMUIX_PlayerIsUser(lv_targetPlayer) == true)) {
                    return true;
                }

                lv_commander = CMUIX_CommanderForSelection(lv_selection);
            }
            else {
                if ((lp_control == CMUIX_DetailsLevelLabel) || (lp_control == CMUIX_DetailsLevelRingFrame) || (lp_control == CMUIX_DetailsMaxLevelIcon) || (lp_control == CMUIX_DetailsMasterySpentLabel)) {
                    lv_targetPlayer = lp_viewer;
                    lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
                }
                else {
                    if ((lp_control == CMUIX_AllianceLevelLabel) || (lp_control == CMUIX_AllianceLevelRingFrame) || (lp_control == CMUIX_AllianceMaxLevelIcon) || (lp_control == CMUIX_AllianceMasterySpentLabel)) {
                        lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_viewer);
                        if ((CMUIX_PlayerIsUser(lv_targetPlayer) == true)) {
                            return true;
                        }

                        lv_commander = CMUIX_CommanderForPlayer(lv_targetPlayer);
                    }
                }
            }
        }
    }

    if ((lv_targetPlayer < 1) || (lv_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == false)) {
        return false;
    }

    if ((lv_talentLevel == 0)) {
        lv_currentLevel = libCOOC_gf_CC_CommanderLevel(lv_targetPlayer, lv_commander);
        if ((lv_currentLevel >= CMUIX_COMMANDER_MASTERY_UNLOCK_LEVEL)) {
            lv_newLevel = CMUIX_COMMANDER_LEVEL_CLICK_LOW_LEVEL;
        }
    }

    CMUIX_CoopProgressSetCommanderLevel(lv_targetPlayer, lv_commander, lv_newLevel);
    CMUIX_ApplyCommanderMasteryGate(lv_targetPlayer, lv_commander);
    libCOOC_gf_CC_UpdateTechStates(lv_targetPlayer);
    CMUIX_CommanderLevelRefreshAfterClick(lp_viewer, lv_targetPlayer, lv_commander);
    if ((CMUIX_CustomizationShouldPersistToPlayerData() == true)) {
        CMUIX_CoopProgressSaveForPlayer(lv_targetPlayer);
    }

    return true;
}

void CMUIX_CoopProgressSetAllCommanderLevelsMax(int lp_player) {
    string lv_commander;
    int lv_index;
    int lv_count;

    lv_commander = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            CMUIX_CoopProgressSetCommanderLevel(lp_player, lv_commander, libCOOC_gv_cCC_PLAYERLEVELMAX);
        }

        lv_index += 1;
    }
}

string CMUIX_CoopProgressActiveCommanderForSave(int lp_player) {
    string lv_commander;

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        return lv_commander;
    }

    lv_commander = libCOTF_gv_sELECTED_Commander[lp_player];
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        return lv_commander;
    }

    lv_commander = libCOUI_gv_cU_CommanderSelection[lp_player];
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        return lv_commander;
    }

    lv_commander = CMUIX_DefaultCommanderForPlayer(lp_player);
    if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
        return lv_commander;
    }

    return CMUIX_DefaultCommanderForPlayer(lp_player);
}

void CMUIX_CoopProgressResetPlayer(int lp_player) {
    libCOOC_gv_cCX_PlayerBankVersion[lp_player] = libCOOC_gv_cCC_BankVersion;
    libCOOC_gf_ResetCampaignData(lp_player);
    CMUIX_CoopProgressSetAllCommanderLevelsMax(lp_player);
    libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, CMUIX_MasteryPointsCurrentDefault());
    CMUIX_PlayerMasteryUpgradesSetDefault(lp_player);
    libCOOC_gf_CC_UpdateTechStates(lp_player);
}

void CMUIX_PlayerProfileClearManagedData(bank lp_bank) {
    string lv_commander;
    int lv_index;
    int lv_count;

    lv_commander = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    if ((lp_bank == null)) {
        return;
    }

    BankSectionRemove(lp_bank, "CMUI|Profile");
    BankSectionRemove(lp_bank, CMUIX_PROFILE_SECTION_OPTIMIZATIONS);
    BankSectionRemove(lp_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS);
    BankSectionRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_CORE);
    BankSectionRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS);
    BankSectionRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_PERKS);
    BankSectionRemove(lp_bank, "CCampaign|CampaignSetting");
    BankSectionRemove(lp_bank, "CCampaign|CampaignCurrency");
    BankSectionRemove(lp_bank, "CCampaign|CoopCampaignPerks");
    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((lv_commander != "") && (lv_commander != null)) {
            BankSectionRemove(lp_bank, CMUIX_PlayerProfileCommanderSection(lv_commander));
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressResetPrestige(int lp_player) {
    string lv_commander;
    int lv_index;
    int lv_count;

    lv_commander = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            CMUIX_WritePrestigeForCommander(lp_player, lv_commander, 0);
        }

        lv_index += 1;
    }
}

void CMUIX_PlayerProfileRebuildData(int lp_player, bank lp_bank) {
    if ((lp_bank == null)) {
        return;
    }

    CMUIX_PlayerProfileClearManagedData(lp_bank);
    CMUIX_CoopProgressResetPlayer(lp_player);
    CMUIX_CoopProgressResetPrestige(lp_player);
    libCOOC_gf_CC_UpdateTechStates(lp_player);
    CMUIX_PlayerProfileSaveCoopCampaignData(lp_player);
    BankSave(lp_bank);
}

void CMUIX_CoopProgressLoadCommanders(int lp_player, bank lp_bank) {
    string lv_commander;
    string lv_activeCommander;
    int lv_index;
    int lv_count;
    int lv_level;
    string lv_levelKey;

    lv_commander = "";
    lv_activeCommander = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_level = 0;
    lv_levelKey = "";
    if ((lp_bank == null)) {
        return;
    }

    lv_activeCommander = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "ActiveCommander", "");
    if ((CMUIX_CoopProgressCommanderValid(lv_activeCommander) == true)) {
        libCOOC_gv_cCX_PlayerCommander[lp_player] = lv_activeCommander;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            lv_levelKey = CMUIX_CoopProgressCommanderKey(lv_commander, "Level");
            lv_level = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_levelKey, libCOOC_gv_cCC_PLAYERLEVELMAX);
            CMUIX_CoopProgressSetCommanderLevel(lp_player, lv_commander, lv_level);
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressSaveCommanders(int lp_player, bank lp_bank) {
    string lv_commander;
    string lv_levelKey;
    int lv_index;
    int lv_count;
    int lv_level;

    lv_commander = "";
    lv_levelKey = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_level = 0;
    if ((lp_bank == null)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            lv_levelKey = CMUIX_CoopProgressCommanderKey(lv_commander, "Level");
            lv_level = libCOOC_gf_CC_CommanderLevel(lp_player, lv_commander);
            if ((lv_level == libCOOC_gv_cCC_PLAYERLEVELMAX)) {
                BankKeyRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_levelKey);
            }
            else {
                BankValueSetFromInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_levelKey, lv_level);
            }
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressLoadPrestige(int lp_player, bank lp_bank) {
    string lv_commander;
    int lv_index;
    int lv_count;
    int lv_prestige;

    lv_commander = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_prestige = 0;
    if ((lp_bank == null)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            lv_prestige = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, CMUIX_CoopProgressCommanderKey(lv_commander, "Prestige"), 0);
            CMUIX_WritePrestigeForCommander(lp_player, lv_commander, lv_prestige);
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressSavePrestige(int lp_player, bank lp_bank) {
    string lv_commander;
    string lv_prestigeKey;
    int lv_index;
    int lv_count;
    int lv_prestige;

    lv_commander = "";
    lv_prestigeKey = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_prestige = 0;
    if ((lp_bank == null)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_CoopProgressCommanderValid(lv_commander) == true)) {
            lv_prestigeKey = CMUIX_CoopProgressCommanderKey(lv_commander, "Prestige");
            lv_prestige = CMUIX_ReadPrestigeForCommander(lp_player, lv_commander);
            if ((lv_prestige == 0)) {
                BankKeyRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_prestigeKey);
            }
            else {
                BankValueSetFromInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_prestigeKey, lv_prestige);
            }
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressLoadMastery(int lp_player, bank lp_bank) {
    string lv_masteryUpgrade;
    int lv_index;
    int lv_count;
    int lv_masteryValue;

    lv_masteryUpgrade = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryValue = 0;
    if ((lp_bank == null)) {
        return;
    }

    libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, CMUIX_MasteryPointsCurrentDefault());
    while ((lv_index <= lv_count)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((lv_masteryUpgrade != "") && (lv_masteryUpgrade != null)) {
            lv_masteryValue = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, CMUIX_ProfileMasteryKey(lv_masteryUpgrade), CMUIX_DefaultMasteryUpgradeLevel(lp_player, lv_masteryUpgrade));
            libCOOC_gf_CC_PlayerMasteryUpgradeLevelSet(lp_player, lv_masteryUpgrade, CMUIX_ClampInt(lv_masteryValue, 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL));
        }

        lv_index += 1;
    }
}

void CMUIX_CoopProgressSaveMastery(int lp_player, bank lp_bank) {
    string lv_masteryUpgrade;
    string lv_masteryKey;
    int lv_index;
    int lv_count;
    int lv_masteryValue;

    lv_masteryUpgrade = "";
    lv_masteryKey = "";
    lv_index = 1;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryValue = 0;
    if ((lp_bank == null)) {
        return;
    }

    while ((lv_index <= lv_count)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((lv_masteryUpgrade != "") && (lv_masteryUpgrade != null)) {
            lv_masteryKey = CMUIX_ProfileMasteryKey(lv_masteryUpgrade);
            lv_masteryValue = libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lp_player, lv_masteryUpgrade);
            if ((lv_masteryValue == CMUIX_DefaultMasteryUpgradeLevel(lp_player, lv_masteryUpgrade))) {
                BankKeyRemove(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_masteryKey);
            }
            else {
                BankValueSetFromInt(lp_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS, lv_masteryKey, lv_masteryValue);
            }
        }

        lv_index += 1;
    }
}

void CMUIX_PlayerProfileLoadCoopCampaignData(int lp_player) {
    bank lv_bank;
    bool lv_bankExists;
    int lv_profileVersion;
    int lv_bankVersion;

    lv_bank = null;
    lv_bankExists = false;
    lv_profileVersion = 0;
    lv_bankVersion = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_bankExists = BankExists(CMUIX_PROFILE_BANK, lp_player);
    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    if ((lv_bankExists == false)) {
        CMUIX_PlayerProfileRebuildData(lp_player, lv_bank);
        return;
    }

    lv_profileVersion = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "Version", 0);
    lv_bankVersion = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "COOCBankVersion", 0);
    libCOOC_gv_cCX_PlayerBankVersion[lp_player] = lv_bankVersion;
    if ((lv_profileVersion != CMUIX_PROFILE_VERSION) || (lv_bankVersion != libCOOC_gv_cCC_BankVersion)) {
        CMUIX_PlayerProfileRebuildData(lp_player, lv_bank);
        return;
    }

    CMUIX_CoopProgressLoadCommanders(lp_player, lv_bank);
    CMUIX_CoopProgressLoadPrestige(lp_player, lv_bank);
    CMUIX_CoopProgressLoadMastery(lp_player, lv_bank);
    CMUIX_ApplyCommanderMasteryGateForPlayer(lp_player);
    libCOOC_gf_CC_UpdateTechStates(lp_player);
}

void CMUIX_PlayerProfileSaveCoopCampaignData(int lp_player) {
    bank lv_bank;
    string lv_activeCommander;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_activeCommander = "";
    if ((lv_bank == null)) {
        return;
    }

    libCOOC_gv_cCX_PlayerBankVersion[lp_player] = libCOOC_gv_cCC_BankVersion;
    lv_activeCommander = CMUIX_CoopProgressActiveCommanderForSave(lp_player);
    BankSectionRemove(lv_bank, CMUIX_PROFILE_SECTION_COOP_PERKS);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "Version", CMUIX_PROFILE_VERSION);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "COOCBankVersion", libCOOC_gv_cCX_PlayerBankVersion[lp_player]);
    BankValueSetFromString(lv_bank, CMUIX_PROFILE_SECTION_COOP_CORE, "ActiveCommander", lv_activeCommander);
    CMUIX_CoopProgressSaveCommanders(lp_player, lv_bank);
    CMUIX_CoopProgressSavePrestige(lp_player, lv_bank);
    CMUIX_CoopProgressSaveMastery(lp_player, lv_bank);
    if ((BankKeyCount(lv_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS) == 0)) {
        BankSectionRemove(lv_bank, CMUIX_PROFILE_SECTION_COOP_COMMANDERS);
    }
}

void CMUIX_CoopProgressLoadForPlayer(int lp_player) {
    CMUIX_PlayerProfileLoadCoopCampaignData(lp_player);
}

void CMUIX_CoopProgressSaveForPlayer(int lp_player) {
    CMUIX_PlayerProfileSaveCoopCampaignData(lp_player);
    CMUIX_PlayerProfileSaveBank(lp_player);
}

void CMUIX_CoopProgressLoadForAllPlayers() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_CoopProgressLoadForPlayer(lv_player);
    }
}

void CMUIX_CoopProgressSaveForAllPlayers() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    if ((CMUIX_ProfileConfigLocked == true)) {
        return;
    }

    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_CoopProgressSaveForPlayer(lv_player);
    }
}

void CMUIX_PlayerProfileLoadAllToUserData(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_PlayerProfileLoadCoopCampaignData(lp_player);
    if ((lp_player == CMUIX_PlayerProfileMutatorPoolBankPlayer())) {
        CMUIX_PlayerProfileLoadMutatorPoolsToUserData(lp_player);
    }

    CMUIX_ApplyCommanderMasteryGateForPlayer(lp_player);
    CMUIX_PlayerProfileLoaded[lp_player] = true;
}

void CMUIX_PlayerProfileSaveAllFromUserData(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    CMUIX_PlayerProfileSaveCoopCampaignData(lp_player);
    if ((lp_player == CMUIX_PlayerProfileMutatorPoolBankPlayer())) {
        CMUIX_PlayerProfileSaveMutatorPoolsFromUserData(lp_player);
    }
    else {
        CMUIX_PlayerProfileSaveBank(lp_player);
    }

    CMUIX_PlayerProfileLoaded[lp_player] = true;
}

bank CMUIX_LaunchProfileOpenBank(int lp_player) {
    bank lv_bank;

    lv_bank = null;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return null;
    }

    if ((CMUIX_LaunchProfileBank[lp_player] != null)) {
        return CMUIX_LaunchProfileBank[lp_player];
    }

    BankLoad(CMUIX_LAUNCH_PROFILE_BANK, lp_player);
    lv_bank = BankLastCreated();
    if ((lv_bank != null)) {
        BankWait(lv_bank);
        CMUIX_LaunchProfileBank[lp_player] = lv_bank;
    }

    return lv_bank;
}

void CMUIX_LaunchProfileSaveBank(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_LaunchProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    BankSave(lv_bank);
}

string CMUIX_LaunchProfilePlayerKey(int lp_player, string lp_key) {
    return ("Player|" + IntToString(lp_player) + "|" + lp_key);
}

string CMUIX_LaunchProfilePlayerSlotKey(int lp_player, string lp_prefix, int lp_slot, string lp_key) {
    return ("Player|" + IntToString(lp_player) + "|" + lp_prefix + "|" + IntToString(lp_slot) + "|" + lp_key);
}

string CMUIX_LaunchProfileMutatorKey(int lp_slot, string lp_key) {
    return ("Mutator|" + IntToString(lp_slot) + "|" + lp_key);
}

string CMUIX_LaunchProfileChaosKey(int lp_slot, string lp_key) {
    return ("Chaos|" + IntToString(lp_slot) + "|" + lp_key);
}

int CMUIX_LaunchProfileModeIndex(string lp_modeInstance) {
    if ((lp_modeInstance == "MutatorChallenges")) {
        return CMUIX_MODE_MUTATOR;
    }

    if ((lp_modeInstance == "CustomMutators")) {
        return CMUIX_MODE_CUSTOM;
    }

    return CMUIX_MODE_STANDARD;
}

string CMUIX_LaunchProfileModeInstance(int lp_mode) {
    if ((lp_mode == CMUIX_MODE_MUTATOR)) {
        return "MutatorChallenges";
    }

    if ((lp_mode == CMUIX_MODE_CUSTOM)) {
        return "CustomMutators";
    }

    return "Standard";
}

bool CMUIX_LaunchProfileMutatorActiveForSave(string lp_mutator) {
    if ((lp_mutator == "") || (lp_mutator == null)) {
        return false;
    }

    if ((CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true)) {
        return false;
    }

    if ((UserDataGetInt("Mutators", lp_mutator, "Auto - Selected By Player", 1) >= 1)) {
        return true;
    }

    if ((UserDataGetInt("Mutators", lp_mutator, "Auto - Actived By Random", 1) >= 1)) {
        return true;
    }

    if ((UserDataGetInt("Mutators", lp_mutator, "Auto - Actived By Chaos", 1) >= 1)) {
        return true;
    }

    return false;
}

bool CMUIX_LaunchProfileModeUsesFinalMutatorArray(int lp_mode) {
    if ((lp_mode == CMUIX_MODE_STANDARD) || (lp_mode == CMUIX_MODE_MUTATOR)) {
        return true;
    }

    return false;
}

int CMUIX_LaunchProfileSaveMutatorSlot(bank lp_bank, int lp_slot, string lp_mutator, bool lp_enhanced) {
    if ((lp_bank == null) || (lp_slot > CMUIX_LAUNCH_PROFILE_MUTATOR_MAX)) {
        return lp_slot;
    }

    if ((lp_mutator == "") || (lp_mutator == null)) {
        return lp_slot;
    }

    if ((CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true)) {
        return lp_slot;
    }

    BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileMutatorKey(lp_slot, "Id"), lp_mutator);
    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileMutatorKey(lp_slot, "Enhanced"), BoolToInt(lp_enhanced));
    return (lp_slot + 1);
}

void CMUIX_LaunchProfileSaveActiveMutators(bank lp_bank) {
    int lv_slot;
    int lv_index;
    int lv_count;
    string lv_mutator;
    bool lv_enhanced;

    lv_slot = 1;
    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_mutator = "";
    lv_enhanced = false;
    if ((lp_bank == null)) {
        return;
    }

    if ((CMUIX_LaunchProfileModeUsesFinalMutatorArray(CMUIX_CurrentMode) == true) && (libCOMU_gv_cT_MAbomination_MutatorsCount > 0)) {
        while ((lv_index <= libCOMU_gv_cT_MAbomination_MutatorsCount) && (lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max) && (lv_slot <= CMUIX_LAUNCH_PROFILE_MUTATOR_MAX)) {
            lv_slot = CMUIX_LaunchProfileSaveMutatorSlot(lp_bank, lv_slot, libCOMU_gv_cT_MAbomination_Mutators[lv_index], libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index]);
            lv_index += 1;
        }

        BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "MutatorCount", (lv_slot - 1));
        return;
    }

    while ((lv_index <= lv_count) && (lv_slot <= CMUIX_LAUNCH_PROFILE_MUTATOR_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_LaunchProfileMutatorActiveForSave(lv_mutator) == true)) {
            lv_enhanced = (UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1);
            lv_slot = CMUIX_LaunchProfileSaveMutatorSlot(lp_bank, lv_slot, lv_mutator, lv_enhanced);
        }

        lv_index += 1;
    }

    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "MutatorCount", (lv_slot - 1));
}

void CMUIX_LaunchProfileSaveChaosRuntime(bank lp_bank) {
    int lv_slot;
    int lv_count;
    int lv_saved;
    string lv_mutator;

    lv_slot = 1;
    lv_count = 0;
    lv_saved = 0;
    lv_mutator = "";
    if ((lp_bank == null)) {
        return;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        lv_count = CMUIX_ClampInt(libCOTF_gv_rT_ChaosCycleCount, 0, CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX);
    }

    while ((lv_slot <= lv_count)) {
        lv_mutator = libCOTF_gv_rT_ChaosMutators[lv_slot];
        if ((lv_mutator != "") && (lv_mutator != null) && (CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            lv_saved = lv_saved + 1;
            BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileChaosKey(lv_saved, "Id"), lv_mutator);
        }

        lv_slot = lv_slot + 1;
    }

    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChaosCount", lv_saved);
}

void CMUIX_LaunchProfileSaveCommanderCustomization(bank lp_bank, int lp_player, string lp_commander) {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_masteryUpgrade;
    string lv_optimization;

    lv_index = 1;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_slot = 1;
    lv_masteryUpgrade = "";
    lv_optimization = "";
    if ((lp_bank == null) || (lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return;
    }

    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "CustomizationSaved"), 1);
    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "CommanderLevel"), libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander));
    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "MasteryLevel"), libCOOC_gf_CC_PlayerMasteryLevel(lp_player));
    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "Prestige"), CMUIX_ReadPrestigeForCommander(lp_player, lp_commander));
    BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "VoicePack"), CMUIX_VoicePackRuntimeForPlayerCommander(lp_player, lp_commander));
    while ((lv_index <= lv_count) && (lv_slot <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_masteryUpgrade = UserDataInstance("MasteryUpgrades", lv_index);
        if ((UserDataGetUserInstance("MasteryUpgrades", lv_masteryUpgrade, "Commander", 1) == lp_commander)) {
            BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Mastery", lv_slot, "Id"), lv_masteryUpgrade);
            BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Mastery", lv_slot, "Value"), libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lp_player, lv_masteryUpgrade));
            lv_slot += 1;
        }

        lv_index += 1;
    }

    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "MasteryCount"), (lv_slot - 1));
    lv_index = 1;
    lv_count = UserDataInstanceCount("CMUIOptimizations");
    lv_slot = 1;
    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "OptimizationMaster"), BoolToInt(CMUIX_OptimizationMasterEnabled(lp_player)));
    while ((lv_index <= lv_count) && (lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        lv_optimization = UserDataInstance("CMUIOptimizations", lv_index);
        if ((CMUIX_OptimizationIsListInstance(lv_optimization) == true) && (CMUIX_OptimizationShouldShowForCommander(lv_optimization, lp_commander) == true)) {
            BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Optimization", lv_slot, "Id"), lv_optimization);
            BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Optimization", lv_slot, "Value"), BoolToInt(CMUIX_OptimizationRawEnabled(lp_player, lp_commander, lv_optimization)));
            lv_slot += 1;
        }

        lv_index += 1;
    }

    BankValueSetFromInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "OptimizationCount"), (lv_slot - 1));
}

void CMUIX_LaunchProfileSaveCommander(bank lp_bank, int lp_player) {
    string lv_commander;

    lv_commander = "";
    if ((lp_bank == null)) {
        return;
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_commander = libCOTF_gv_sELECTED_Commander[lp_player];
    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0)) {
        lv_commander = libCOUI_gv_cU_CommanderSelection[lp_player];
    }

    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0)) {
        lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    }

    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0)) {
        lv_commander = CMUIX_DefaultCommanderForPlayer(lp_player);
    }

    BankValueSetFromString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "Commander"), lv_commander);
    if ((lv_commander != "") && (CMUIX_CommanderSelectionIndexForInstance(lv_commander) != 0)) {
        CMUIX_LaunchProfileSaveCommanderCustomization(lp_bank, lp_player, lv_commander);
    }
}

void CMUIX_LaunchProfileSaveCommanders(bank lp_bank) {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_LaunchProfileSaveCommander(lp_bank, lv_player);
        if ((CMUIX_ProfileConfigLocked == false)) {
            CMUIX_CoopProgressSaveForPlayer(lv_player);
        }
    }
}

int CMUIX_ProfileCharValue(string lp_char) {
    int lv_position;
    string lv_alphabet;

    lv_position = 0;
    lv_alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-;=,+|:.";
    if ((lp_char == "") || (lp_char == null)) {
        return 0;
    }

    lv_position = StringFind(lv_alphabet, lp_char, c_stringCase);
    if ((lv_position < 0)) {
        return 7;
    }

    return lv_position;
}

int CMUIX_ProfileChecksum(string lp_payload) {
    int lv_index;
    int lv_length;
    int lv_hash;
    string lv_char;

    lv_index = 1;
    lv_length = StringLength(lp_payload);
    lv_hash = 17;
    lv_char = "";
    while ((lv_index <= lv_length)) {
        lv_char = StringSub(lp_payload, lv_index, lv_index);
        lv_hash = ModI(((lv_hash * 33) + CMUIX_ProfileCharValue(lv_char) + lv_index), CMUIX_PROFILE_CHECKSUM_MODULO);
        lv_index += 1;
    }

    return lv_hash;
}

string CMUIX_ProfilePayloadWithoutChecksum(string lp_payload) {
    int lv_codePosition;
    int lv_crcPosition;
    int lv_checkPosition;
    int lv_resultCodePosition;
    int lv_matchCodePosition;
    int lv_position;

    lv_codePosition = StringFind(lp_payload, ";code=", c_stringNoCase);
    lv_crcPosition = StringFind(lp_payload, ";crc=", c_stringNoCase);
    lv_checkPosition = StringFind(lp_payload, ";check=", c_stringNoCase);
    lv_resultCodePosition = StringFind(lp_payload, ";resultCode=", c_stringNoCase);
    lv_matchCodePosition = StringFind(lp_payload, ";matchCode=", c_stringNoCase);
    lv_position = lv_codePosition;
    if ((lv_position < 0) || ((lv_crcPosition > 0) && (lv_crcPosition < lv_position))) {
        lv_position = lv_crcPosition;
    }

    if ((lv_position < 0) || ((lv_checkPosition > 0) && (lv_checkPosition < lv_position))) {
        lv_position = lv_checkPosition;
    }

    if ((lv_position < 0) || ((lv_resultCodePosition > 0) && (lv_resultCodePosition < lv_position))) {
        lv_position = lv_resultCodePosition;
    }

    if ((lv_position < 0) || ((lv_matchCodePosition > 0) && (lv_matchCodePosition < lv_position))) {
        lv_position = lv_matchCodePosition;
    }

    if ((lv_position < 0)) {
        return lp_payload;
    }

    if ((lv_position <= 1)) {
        return "";
    }

    return StringSub(lp_payload, 1, (lv_position - 1));
}

string CMUIX_ProfileConfigValue(string lp_payload, string lp_key) {
    int lv_position;
    int lv_start;
    int lv_endRelative;
    string lv_source;
    string lv_pattern;
    string lv_tail;

    lv_position = 0;
    lv_start = 0;
    lv_endRelative = 0;
    lv_source = (";" + lp_payload + ";");
    lv_pattern = (";" + lp_key + "=");
    lv_tail = "";
    if ((lp_key == "") || (lp_key == null)) {
        return "";
    }

    lv_position = StringFind(lv_source, lv_pattern, c_stringNoCase);
    if ((lv_position < 0)) {
        return "";
    }

    lv_start = lv_position + StringLength(lv_pattern);
    if ((lv_start > StringLength(lv_source))) {
        return "";
    }

    lv_tail = StringSub(lv_source, lv_start, StringLength(lv_source));
    lv_endRelative = StringFind(lv_tail, ";", c_stringCase);
    if ((lv_endRelative < 0)) {
        return lv_tail;
    }

    if ((lv_endRelative <= 1)) {
        return "";
    }

    return StringSub(lv_tail, 1, (lv_endRelative - 1));
}

string CMUIX_ProfileChecksumCodeValue(string lp_payload) {
    string lv_code;

    lv_code = CMUIX_ProfileConfigValue(lp_payload, "code");
    if ((lv_code == "")) {
        lv_code = CMUIX_ProfileConfigValue(lp_payload, "crc");
    }

    if ((lv_code == "")) {
        lv_code = CMUIX_ProfileConfigValue(lp_payload, "check");
    }

    return lv_code;
}

bool CMUIX_ProfilePayloadHasChecksum(string lp_payload) {
    return (CMUIX_ProfileChecksumCodeValue(lp_payload) != "");
}

string CMUIX_ProfilePayloadWithChecksum(string lp_body) {
    return (lp_body + ";certified=1;code=" + IntToString(CMUIX_ProfileChecksumForBody(lp_body)));
}

string CMUIX_LaunchSourceName(int lp_source) {
    if ((lp_source == CMUIX_LAUNCH_SOURCE_PROFILE)) {
        return "Profile";
    }

    if ((lp_source == CMUIX_LAUNCH_SOURCE_HISTORY)) {
        return "History";
    }

    return "Manual";
}

bool CMUIX_ProfileSharedConfigLocked() {
    return CMUIX_ProfileConfigLocked;
}

bool CMUIX_ProfileOptimizationAllowedFromBody(string lp_body) {
    string lv_value;

    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimization");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimizations");
    }

    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "cmOptimization");
    }

    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "cmOptimizations");
    }

    if ((lv_value == "")) {
        return true;
    }

    if ((lv_value == "0") || (lv_value == "false") || (lv_value == "False") || (lv_value == "FALSE") || (lv_value == "no") || (lv_value == "No") || (lv_value == "NO")) {
        return false;
    }

    return true;
}

void CMUIX_ProfileApplyRestrictionsAndSeed(string lp_body, bool lp_enabled) {
    string lv_value;

    lv_value = "";
    CMUIX_ProfileDisabledCommanders = "";
    CMUIX_ProfileDisabledPrestiges = "";
    CMUIX_ProfileDisabledAIs = "";
    CMUIX_ProfileAllowedAIs = "";
    CMUIX_ProfileRandomSeedExplicit = false;
    CMUIX_RandomSeedResolved = false;
    CMUIX_RandomSeed = 0;
    if ((lp_enabled == false)) {
        CMUIX_ProfileRuntimeLocksRefresh();
        CMUIX_RandomSeedInputResetDraft();
        return;
    }

    CMUIX_ProfileDisabledCommanders = CMUIX_ProfileConfigValue(lp_body, "disabledCommanders");
    if ((CMUIX_ProfileDisabledCommanders == "")) {
        CMUIX_ProfileDisabledCommanders = CMUIX_ProfileConfigValue(lp_body, "disabledCommander");
    }

    CMUIX_ProfileDisabledPrestiges = CMUIX_ProfileConfigValue(lp_body, "disabledPrestiges");
    if ((CMUIX_ProfileDisabledPrestiges == "")) {
        CMUIX_ProfileDisabledPrestiges = CMUIX_ProfileConfigValue(lp_body, "disabledPrestige");
    }

    CMUIX_ProfileDisabledAIs = CMUIX_ProfileConfigValue(lp_body, "disabledAIs");
    if ((CMUIX_ProfileDisabledAIs == "")) {
        CMUIX_ProfileDisabledAIs = CMUIX_ProfileConfigValue(lp_body, "disabledAI");
    }

    CMUIX_ProfileAllowedAIs = CMUIX_ProfileConfigValue(lp_body, "allowedAIs");
    if ((CMUIX_ProfileAllowedAIs == "")) {
        CMUIX_ProfileAllowedAIs = CMUIX_ProfileConfigValue(lp_body, "allowedAI");
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "seed");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "randomSeed");
    }

    if ((lv_value != "")) {
        CMUIX_ProfileRandomSeedExplicit = true;
        CMUIX_RandomSeedResolved = true;
        CMUIX_RandomSeed = StringToInt(lv_value);
    }

    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_RandomSeedInputResetDraft();
}

void CMUIX_RandomSeedResolve() {
    string lv_material;

    lv_material = "";
    if ((CMUIX_RandomSeedResolved == true)) {
        return;
    }

    lv_material = PlayerHandle(1) + "|" + PlayerHandle(2) + "|" + IntToString(DateTimeToInt(CurrentDateTimeGet()));
    CMUIX_RandomSeed = CMUIX_ProfileChecksum(lv_material);
    CMUIX_RandomSeedResolved = true;
}

void CMUIX_RandomSeedApply() {
    CMUIX_RandomSeedResolve();
    GameSetSeed(CMUIX_RandomSeed);
}

void CMUIX_ProfileMessage(int lp_player, string lp_message) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(lp_message));
        return;
    }

    UIDisplayMessage(PlayerGroupSingle(lp_player), c_messageAreaChat, StringToText(lp_message));
}

int CMUIX_DefaultMasteryPoints() {
    return CMUIX_ClampInt(UserDataGetInt(CMUIX_DEFAULTS_USERDATA, "[Default]", "Default Mastery Points", 1), 0, libCOOC_gv_cCC_MASTERY_MAX_LEVEL);
}

int CMUIX_DefaultMasteryCap() {
    return CMUIX_ClampInt(UserDataGetInt(CMUIX_DEFAULTS_USERDATA, "[Default]", "Default Mastery Cap", 1), 0, libCOOC_gv_cCC_MASTERY_MAX_LEVEL);
}

int CMUIX_DefaultOptimizationMasterEnabled() {
    if ((UserDataGetInt(CMUIX_DEFAULTS_USERDATA, "[Default]", "Default Optimization Master Enabled", 1) != 0)) {
        return 1;
    }

    return 0;
}

int CMUIX_ProfileMasteryCapCurrent() {
    if ((CMUIX_ProfileMasteryCapEnabled == true)) {
        return CMUIX_ClampInt(CMUIX_ProfileMasteryCap, 0, libCOOC_gv_cCC_MASTERY_MAX_LEVEL);
    }

    return CMUIX_DefaultMasteryCap();
}

int CMUIX_MasteryPointsCurrentDefault() {
    if ((CMUIX_ProfileMasteryCapEnabled == true)) {
        return CMUIX_ProfileMasteryCapCurrent();
    }

    return MinI(CMUIX_DefaultMasteryPoints(), CMUIX_ProfileMasteryCapCurrent());
}

void CMUIX_ProfileApplyMasteryCapForPlayer(int lp_player) {
    int lv_cap;

    lv_cap = CMUIX_MasteryPointsCurrentDefault();
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_player, true);
    libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, lv_cap);
    CMUIX_ApplyCommanderMasteryGateForPlayer(lp_player);
}

void CMUIX_ProfileApplyMasteryCapAll() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_ProfileApplyMasteryCapForPlayer(lv_player);
    }
}

int CMUIX_LaunchAttemptChecksumFor(int lp_attemptCount, string lp_historyKey, string lp_challengeName) {
    return CMUIX_ProfileChecksum((IntToString(lp_attemptCount) + "|" + lp_historyKey + "|" + lp_challengeName));
}

void CMUIX_LaunchAttemptNormalize() {
    if ((CMUIX_LaunchAttemptCount < 1)) {
        CMUIX_LaunchAttemptCount = 1;
    }

    CMUIX_LaunchAttemptChecksum = CMUIX_LaunchAttemptChecksumFor(CMUIX_LaunchAttemptCount, CMUIX_LaunchHistoryKey, CMUIX_ProfileChallengeName);
}

bank CMUIX_GameHistoryOpenBank(int lp_player) {
    bank lv_bank;
    int lv_version;

    lv_bank = null;
    lv_version = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return null;
    }

    if ((CMUIX_GameHistoryBank[lp_player] != null)) {
        return CMUIX_GameHistoryBank[lp_player];
    }

    BankLoad(CMUIX_HISTORY_BANK, lp_player);
    lv_bank = BankLastCreated();
    if ((lv_bank != null)) {
        BankWait(lv_bank);
        lv_version = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "Version", 0);
        if ((lv_version != CMUIX_HISTORY_VERSION)) {
            BankSectionRemove(lv_bank, CMUIX_HISTORY_SECTION);
            BankValueSetFromInt(lv_bank, CMUIX_HISTORY_SECTION, "Version", CMUIX_HISTORY_VERSION);
            BankValueSetFromInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
            BankSave(lv_bank);
        }

        CMUIX_GameHistoryBank[lp_player] = lv_bank;
    }

    return lv_bank;
}

void CMUIX_GameHistorySaveBank(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    BankSave(lv_bank);
}

void CMUIX_GameHistoryEnsureNextIndexForKey(int lp_player, string lp_key) {
    bank lv_bank;
    int lv_keyIndex;
    int lv_nextIndex;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_keyIndex = CMUIX_HistoryRecordIndexFromKey(lp_key);
    lv_nextIndex = 1;
    if ((lv_bank == null) || (lv_keyIndex < 1)) {
        return;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    if ((lv_nextIndex <= lv_keyIndex)) {
        BankValueSetFromInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", (lv_keyIndex + 1));
        CMUIX_GameHistorySaveBank(lp_player);
    }
}

string CMUIX_GameHistoryEnsureRuntimeKey(int lp_player) {
    bank lv_bank;
    int lv_nextIndex;
    string lv_key;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_key = "";
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_LaunchHistoryKeys[lp_player] != "")) {
            CMUIX_GameHistoryEnsureNextIndexForKey(lp_player, CMUIX_LaunchHistoryKeys[lp_player]);
            CMUIX_LaunchHistoryKey = CMUIX_LaunchHistoryKeys[lp_player];
            return CMUIX_LaunchHistoryKeys[lp_player];
        }
    }

    if ((lv_bank == null)) {
        lv_key = CMUIX_HistoryRecordKey(1);
        if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_LaunchHistoryKeys[lp_player] = lv_key;
        }

        CMUIX_LaunchHistoryKey = lv_key;
        return lv_key;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    if ((lv_nextIndex < 1)) {
        lv_nextIndex = 1;
    }

    lv_key = CMUIX_HistoryRecordKey(lv_nextIndex);
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_LaunchHistoryKeys[lp_player] = lv_key;
    }

    CMUIX_LaunchHistoryKey = lv_key;
    CMUIX_GameHistoryEnsureNextIndexForKey(lp_player, lv_key);
    return lv_key;
}

string CMUIX_GameHistoryCommanderFragment(int lp_player) {
    string lv_commander;

    lv_commander = libCOTF_gv_sELECTED_Commander[lp_player];
    if ((lv_commander == "") || (lv_commander == null)) {
        lv_commander = libCOUI_gv_cU_CommanderSelection[lp_player];
    }

    if ((lv_commander == "") || (lv_commander == null)) {
        lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    }

    if ((lv_commander == "") || (lv_commander == null)) {
        lv_commander = CMUIX_DefaultCommanderForPlayer(lp_player);
    }

    return ("p" + IntToString(lp_player) + "Commander=" + lv_commander + ";p" + IntToString(lp_player) + "Mastery=" + IntToString(libCOOC_gf_CC_PlayerMasteryLevel(lp_player)) + ";p" + IntToString(lp_player) + "Prestige=" + IntToString(CMUIX_ReadPrestigeForCommander(lp_player, lv_commander)));
}

string CMUIX_GameHistoryMutatorsFragment() {
    int lv_index;
    int lv_count;
    string lv_mutator;
    string lv_result;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_mutator = "";
    lv_result = "";
    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) && (libCOMU_gv_cT_MAbomination_MutatorsCount > 0)) {
        while ((lv_index <= libCOMU_gv_cT_MAbomination_MutatorsCount) && (lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
            lv_mutator = libCOMU_gv_cT_MAbomination_Mutators[lv_index];
            if ((lv_mutator != "") && (CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
                if ((lv_result != "")) {
                    lv_result += ",";
                }

                lv_result += lv_mutator;
                if ((libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index] == true)) {
                    lv_result += "+";
                }
            }

            lv_index += 1;
        }

        return lv_result;
    }

    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_LaunchProfileMutatorActiveForSave(lv_mutator) == true)) {
            if ((lv_result != "")) {
                lv_result += ",";
            }

            lv_result += lv_mutator;
            if ((UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1)) {
                lv_result += "+";
            }
        }

        lv_index += 1;
    }

    return lv_result;
}

string CMUIX_GameHistoryModeSettingsFragment() {
    string lv_result;

    lv_result = ("mode=" + CMUIX_LaunchProfileModeInstance(CMUIX_CurrentMode) + ";difficultyBase=" + IntToString(CMUIX_DifficultySelectedBase) + ";difficultyPlus=" + IntToString(CMUIX_DifficultySelectedPlus));
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_result += (";challengeType=" + CMUIX_MutatorChallengeCurrentType + ";challenge=" + libCOMU_gv_cT_MutatorChallengesCurrentChallenge);
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        lv_result += (";mutators=" + CMUIX_GameHistoryMutatorsFragment());
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) && (CMUIX_DifficultySelectedPlus > 0)) {
        lv_result += (";mutators=" + CMUIX_GameHistoryMutatorsFragment());
    }

    return lv_result;
}

string CMUIX_GameHistoryNormalizeOutcome(string lp_outcome) {
    if ((StringEqual(lp_outcome, "Victory", c_stringNoCase) == true)) {
        return "Victory";
    }

    if ((StringEqual(lp_outcome, "Defeat", c_stringNoCase) == true)) {
        return "Defeat";
    }

    if ((StringEqual(lp_outcome, "Retry", c_stringNoCase) == true)) {
        return "Retry";
    }

    if ((StringEqual(lp_outcome, "InProgress", c_stringNoCase) == true)) {
        return "InProgress";
    }

    return "InProgress";
}

int CMUIX_HistoryObjectiveStateValue(string lp_objective) {
    int lv_objectiveId;
    int lv_objectiveState;
    string lv_instance;

    lv_objectiveId = c_invalidObjectiveId;
    lv_objectiveState = c_objectiveStateHidden;
    lv_instance = "";
    if ((lp_objective == "") || (lp_objective == null)) {
        return libCOOC_ge_MissionObjectiveState_Undiscovered;
    }

    lv_instance = libCOOC_gf_CS_ObjectiveUserDataInstance(lp_objective);
    if ((lv_instance == "") || (lv_instance == null)) {
        return libCOOC_ge_MissionObjectiveState_Undiscovered;
    }

    if ((UserDataGetInt("CoopMissionObjective", lv_instance, "Complete", 1) == 1)) {
        return libCOOC_ge_MissionObjectiveState_Completed;
    }

    lv_objectiveId = libCOOC_gf_CS_GetObjectiveForData(lp_objective);
    if ((lv_objectiveId != c_invalidObjectiveId)) {
        lv_objectiveState = ObjectiveGetState(lv_objectiveId);
        if ((lv_objectiveState == c_objectiveStateFailed)) {
            return libCOOC_ge_MissionObjectiveState_Failed;
        }

        if ((lv_objectiveState == c_objectiveStateCompleted)) {
            return libCOOC_ge_MissionObjectiveState_Completed;
        }

        if ((lv_objectiveState == c_objectiveStateActive)) {
            return libCOOC_ge_MissionObjectiveState_Available;
        }
    }

    if ((UserDataGetInt("CoopMissionObjective", lv_instance, "Available", 1) == 1)) {
        return libCOOC_ge_MissionObjectiveState_Available;
    }

    return libCOOC_ge_MissionObjectiveState_Undiscovered;
}

string CMUIX_HistoryObjectiveSnapshotEntry(string lp_objective) {
    int lv_progress;
    int lv_required;
    int lv_state;
    int lv_primary;

    lv_progress = 0;
    lv_required = 0;
    lv_state = libCOOC_ge_MissionObjectiveState_Undiscovered;
    lv_primary = 0;
    if ((lp_objective == "") || (lp_objective == null)) {
        return "";
    }

    lv_progress = libCOOC_gf_CoopMissionObjectiveProgress(lp_objective);
    lv_required = libCOMI_gf_MissionObjectiveItemCountCoop(lp_objective);
    if ((lv_required <= 0)) {
        lv_required = libCOOC_gf_CoopMissionObjectiveItemCount(lp_objective);
    }

    lv_state = CMUIX_HistoryObjectiveStateValue(lp_objective);
    if ((libCOOC_gf_CoopMissionObjectiveIsPrimary(lp_objective) == true)) {
        lv_primary = 1;
    }

    return (lp_objective + "|" + IntToString(lv_progress) + "|" + IntToString(lv_required) + "|" + IntToString(lv_state) + "|" + IntToString(lv_primary));
}

string CMUIX_HistoryObjectiveSnapshotFragment() {
    int lv_index;
    int lv_count;
    string lv_objective;
    string lv_entry;
    string lv_entries;

    lv_index = 1;
    lv_count = 0;
    lv_objective = "";
    lv_entry = "";
    lv_entries = "";
    while ((lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_index];
        if ((lv_objective != "") && (lv_objective != null)) {
            lv_entry = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
            if ((lv_entry != "")) {
                lv_count += 1;
                lv_entries += (";objective" + IntToString(lv_count) + "=" + lv_entry);
            }
        }

        lv_index += 1;
    }

    if ((lv_count <= 0)) {
        return "";
    }

    return (";objectiveCount=" + IntToString(lv_count) + lv_entries);
}

bool CMUIX_GameHistoryCreatedPrimaryObjectivesComplete() {
    int lv_index;
    int lv_primaryCount;
    string lv_objective;

    lv_index = 1;
    lv_primaryCount = 0;
    lv_objective = "";
    while ((lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_index];
        if ((lv_objective != "") && (lv_objective != null) && (libCOOC_gf_CoopMissionObjectiveIsPrimary(lv_objective) == true)) {
            lv_primaryCount += 1;
            if ((CMUIX_HistoryObjectiveStateValue(lv_objective) != libCOOC_ge_MissionObjectiveState_Completed)) {
                return false;
            }
        }

        lv_index += 1;
    }

    return (lv_primaryCount > 0);
}

string CMUIX_GameHistoryProfileBodyForOutcome(string lp_outcome) {
    string lv_result;
    string lv_outcome;
    string lv_mission;
    string lv_mapLink;
    string lv_enemy;
    string lv_mutators;
    string lv_note;

    lv_outcome = CMUIX_GameHistoryNormalizeOutcome(lp_outcome);
    lv_mission = libCOTF_gv_sELECTED_Mission;
    lv_mapLink = libCOTF_gv_sELECTED_Map;
    lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    lv_mutators = CMUIX_GameHistoryMutatorsFragment();
    lv_note = "";

    if ((lv_mission == null)) {
        lv_mission = "";
    }

    if ((lv_mapLink == null)) {
        lv_mapLink = "";
    }

    if ((lv_enemy == null)) {
        lv_enemy = "";
    }

    if ((lv_mutators == null)) {
        lv_mutators = "";
    }

    lv_result = ("name=History_" + lv_outcome);
    if ((lv_mission != "")) {
        lv_result += (";mission=" + lv_mission);
    }
    else {
        if ((lv_mapLink != "")) {
            lv_result += (";map=" + lv_mapLink);
        }
    }

    if ((lv_enemy != "")) {
        lv_result += (";enemy=" + lv_enemy);
    }

    lv_result += (";base=" + IntToString(CMUIX_DifficultySelectedBase));
    lv_result += (";plus=" + IntToString(CMUIX_DifficultySelectedPlus));
    lv_result += (";mutators=" + lv_mutators);
    lv_result += (";source=" + CMUIX_LaunchSourceName(CMUIX_LaunchSource));
    lv_result += (";allowOptimization=" + IntToString(BoolToInt(CMUIX_ProfileOptimizationAllowed)));
    if ((CMUIX_ProfileDisabledCommanders != "")) {
        lv_result += (";disabledCommanders=" + CMUIX_ProfileDisabledCommanders);
    }

    if ((CMUIX_ProfileDisabledPrestiges != "")) {
        lv_result += (";disabledPrestiges=" + CMUIX_ProfileDisabledPrestiges);
    }

    if ((CMUIX_ProfileDisabledAIs != "")) {
        lv_result += (";disabledAIs=" + CMUIX_ProfileDisabledAIs);
    }

    if ((CMUIX_ProfileAllowedAIs != "")) {
        lv_result += (";allowedAIs=" + CMUIX_ProfileAllowedAIs);
    }

    CMUIX_RandomSeedResolve();
    lv_result += (";seed=" + IntToString(CMUIX_RandomSeed));
    if ((CMUIX_ProfileMasteryCapEnabled == true)) {
        lv_result += (";mastery=" + IntToString(CMUIX_ProfileMasteryCapCurrent()));
    }

    lv_result += (";history=1;time=" + IntToString(DateTimeToInt(CurrentDateTimeGet())) + ";result=" + lv_outcome + ";attempts=" + IntToString(CMUIX_LaunchAttemptCount));
    lv_result += (";" + CMUIX_GameHistoryCommanderFragment(1));
    lv_result += (";" + CMUIX_GameHistoryCommanderFragment(2));
    lv_result += (";mapLink=" + lv_mapLink);
    lv_result += (";" + CMUIX_GameHistoryModeSettingsFragment());
    lv_result += CMUIX_HistoryObjectiveSnapshotFragment();
    if ((CMUIX_ProfileModeActive == true) || (CMUIX_LaunchSource == CMUIX_LAUNCH_SOURCE_PROFILE)) {
        lv_note = CMUIX_ProfileConfigValue(CMUIX_ProfilePayloadWithoutChecksum(CMUIX_ProfileRawConfig), "note");
        lv_result += (";profile=1;profileName=" + CMUIX_ProfileChallengeName + ";profileChecksum=" + IntToString(CMUIX_ProfileChecksumValue) + ";profileCertified=" + IntToString(BoolToInt(CMUIX_ProfileCertified)));
        if ((lv_note != "")) {
            lv_result += (";note=" + lv_note);
        }
    }
    else {
        lv_result += ";profile=0";
    }

    return lv_result;
}

string CMUIX_GameHistoryProfileBody(bool lp_victory) {
    if ((lp_victory == true)) {
        return CMUIX_GameHistoryProfileBodyForOutcome("Victory");
    }

    return CMUIX_GameHistoryProfileBodyForOutcome("Defeat");
}

string CMUIX_GameHistoryBuildRecordForOutcome(string lp_outcome) {
    string lv_body;

    lv_body = CMUIX_GameHistoryProfileBodyForOutcome(lp_outcome);
    CMUIX_GameResultChecksumValue = CMUIX_ProfileResultChecksumForBody(lv_body);
    return CMUIX_ProfileCompactPayloadWithChecksum(lv_body);
}

string CMUIX_GameHistoryBuildRecord(bool lp_victory) {
    if ((lp_victory == true)) {
        return CMUIX_GameHistoryBuildRecordForOutcome("Victory");
    }

    return CMUIX_GameHistoryBuildRecordForOutcome("Defeat");
}

void CMUIX_GameHistoryMarkCheatedForPlayer(int lp_player) {
    bank lv_bank;
    string lv_key;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_key = "";
    if ((lv_bank == null) || (lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_LaunchHistoryKeys[lp_player] != "")) {
        lv_key = CMUIX_LaunchHistoryKeys[lp_player];
    }

    if ((lv_key == "") && (CMUIX_LaunchHistoryKey != "")) {
        lv_key = CMUIX_LaunchHistoryKey;
    }

    if ((lv_key == "")) {
        lv_key = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey", "");
    }

    if ((lv_key == "")) {
        return;
    }

    CMUIX_GameHistoryEnsureNextIndexForKey(lp_player, lv_key);
    BankValueSetFromInt(lv_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lv_key), 1);
    CMUIX_GameHistorySaveBank(lp_player);
}

void CMUIX_GameHistoryMarkCheatedAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return;
    }

    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_GameHistoryMarkCheatedForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_GameHistoryMarkCheatedForPlayer(1);
        CMUIX_GameHistoryMarkCheatedForPlayer(2);
    }
}

bool CMUIX_GameHistoryCheatEventHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    CMUIX_GameHistoryMarkCheatedAll();
    return true;
}

void CMUIX_GameHistoryCreateCheatEventTrigger() {
    if ((CMUIX_GameHistoryCheatEventTrigger != null)) {
        return;
    }

    CMUIX_GameHistoryCheatEventTrigger = TriggerCreate("CMUIX_GameHistoryCheatEventHandler");
    TriggerAddEventGeneric(CMUIX_GameHistoryCheatEventTrigger, "UT_CheatUsed");
}

bool CMUIX_GameHistoryVictoryRecordAlreadySaved(bank lp_bank, string lp_key) {
    string lv_payload;
    string lv_body;
    string lv_result;

    lv_payload = "";
    lv_body = "";
    lv_result = "";
    if ((lp_bank == null) || (lp_key == "") || (lp_key == null)) {
        return false;
    }

    if ((BankKeyExists(lp_bank, CMUIX_HISTORY_SECTION, lp_key) == false)) {
        return false;
    }

    lv_payload = BankValueGetAsString(lp_bank, CMUIX_HISTORY_SECTION, lp_key);
    if ((CMUIX_HistoryRecordIntegrityForPayload(lv_payload) != CMUIX_HISTORY_INTEGRITY_VALID)) {
        return false;
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lv_payload);
    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
    if ((CMUIX_ProfilePayloadIsCompact(lv_body) == true)) {
        lv_body = CMUIX_ProfileCompactExpandBody(lv_body);
    }

    lv_result = CMUIX_ProfileConfigValue(lv_body, "result");
    return (StringEqual(lv_result, "Victory", c_stringNoCase) == true);
}

void CMUIX_GameHistoryRecordOutcomeForPlayer(int lp_player, string lp_outcome, bool lp_refresh) {
    bank lv_bank;
    string lv_key;
    string lv_outcome;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_key = CMUIX_GameHistoryEnsureRuntimeKey(lp_player);
    lv_outcome = CMUIX_GameHistoryNormalizeOutcome(lp_outcome);
    if ((lv_bank == null) || (lv_key == "")) {
        return;
    }

    if ((StringEqual(lv_outcome, "Victory", c_stringNoCase) == true) && (CMUIX_GameHistoryVictoryRecordAlreadySaved(lv_bank, lv_key) == true)) {
        CMUIX_LaunchLastResult = "Victory";
        return;
    }

    CMUIX_LaunchLastResult = lv_outcome;
    BankValueSetFromString(lv_bank, CMUIX_HISTORY_SECTION, lv_key, CMUIX_GameHistoryBuildRecordForOutcome(lv_outcome));
    if ((libCOTF_gv_rT_CheatUsed == true)) {
        BankValueSetFromInt(lv_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lv_key), 1);
    }

    BankValueSetFromString(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey", lv_key);
    CMUIX_GameHistorySaveBank(lp_player);
    if ((lp_refresh == true)) {
        CMUIX_HistoryRefreshForPlayer(lp_player);
    }
}

void CMUIX_GameHistoryRecordResultForPlayer(int lp_player, bool lp_victory) {
    if ((lp_victory == true)) {
        CMUIX_GameHistoryRecordOutcomeForPlayer(lp_player, "Victory", true);
        return;
    }

    CMUIX_GameHistoryRecordOutcomeForPlayer(lp_player, "Defeat", true);
}

void CMUIX_GameHistoryRecordResultAll(bool lp_victory) {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_GameHistoryRecordResultForPlayer(lv_player, lp_victory);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_GameHistoryRecordResultForPlayer(1, lp_victory);
        if ((libCOOC_gv_cCC_MAXPLAYERS >= 2)) {
            CMUIX_GameHistoryRecordResultForPlayer(2, lp_victory);
        }
    }
}

void CMUIX_GameHistoryRecordVictory() {
    CMUIX_GameHistoryRecordResultAll(true);
}

void CMUIX_GameHistoryRecordDefeat() {
    CMUIX_GameHistoryRecordResultAll(false);
}

void CMUIX_GameHistoryAutosaveProgressForPlayer(int lp_player, string lp_outcome) {
    CMUIX_GameHistoryRecordOutcomeForPlayer(lp_player, lp_outcome, false);
}

void CMUIX_GameHistoryAutosaveProgressAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;
    string lv_outcome;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    lv_outcome = "InProgress";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return;
    }

    if ((CMUIX_GameHistoryCreatedPrimaryObjectivesComplete() == true)) {
        lv_outcome = "Victory";
    }

    if ((libCOMI_gf_GameIsOver() == true) && (lv_outcome != "Victory")) {
        return;
    }

    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_GameHistoryAutosaveProgressForPlayer(lv_player, lv_outcome);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_GameHistoryAutosaveProgressForPlayer(1, lv_outcome);
        CMUIX_GameHistoryAutosaveProgressForPlayer(2, lv_outcome);
    }
}

void CMUIX_LaunchProfileSaveSnapshot(int lp_player) {
    bank lv_bank;
    int lv_typeIndex;
    string lv_targetMission;
    string lv_targetMap;
    string lv_enemy;
    string lv_challengeType;
    string lv_challengeSelected;
    string lv_challengeFinal;
    string lv_historyKey;
    int lv_attemptChecksum;

    lv_bank = CMUIX_LaunchProfileOpenBank(lp_player);
    lv_typeIndex = 0;
    lv_targetMission = libCOTF_gv_sELECTED_Mission;
    lv_targetMap = libCOTF_gv_sELECTED_Map;
    lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    lv_challengeType = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_challengeSelected = "";
    lv_challengeFinal = libCOMU_gv_cT_MutatorChallengesCurrentChallenge;
    lv_historyKey = "";
    lv_attemptChecksum = 0;
    if ((lv_bank == null)) {
        return;
    }

    CMUIX_RandomSeedResolve();

    if ((lv_targetMission == "") && (lv_targetMap != "")) {
        lv_targetMission = CMUIX_MapSelectionInstanceForMapLink(lv_targetMap);
    }

    if ((lv_targetMap == "") && (lv_targetMission != "")) {
        lv_targetMap = UserDataGetGameLink("CoopMaps", lv_targetMission, "MA - Map Link", 1);
    }

    if ((lv_targetMission == null)) {
        lv_targetMission = "";
    }

    if ((lv_targetMap == null)) {
        lv_targetMap = "";
    }

    if ((lv_enemy == null)) {
        lv_enemy = "";
    }

    if ((lv_challengeType == null)) {
        lv_challengeType = "";
    }

    if ((lv_challengeSelected == null)) {
        lv_challengeSelected = "";
    }

    if ((lv_challengeFinal == null)) {
        lv_challengeFinal = "";
    }

    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_challengeType);
    if ((lv_typeIndex > 0) && (lv_typeIndex <= CMUIX_MUTATOR_CHALLENGE_TYPE_MAX)) {
        lv_challengeSelected = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    }

    if ((lv_challengeSelected == null)) {
        lv_challengeSelected = "";
    }

    lv_historyKey = CMUIX_GameHistoryEnsureRuntimeKey(lp_player);
    if ((CMUIX_LaunchAttemptCount < 1)) {
        CMUIX_LaunchAttemptCount = 1;
    }

    lv_attemptChecksum = CMUIX_LaunchAttemptChecksumFor(CMUIX_LaunchAttemptCount, lv_historyKey, CMUIX_ProfileChallengeName);
    CMUIX_LaunchAttemptChecksum = lv_attemptChecksum;
    BankSectionRemove(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Valid", 1);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Version", CMUIX_LAUNCH_PROFILE_VERSION);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "CreatedAt", DateTimeToInt(CurrentDateTimeGet()));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TimeoutSeconds", CMUIX_LAUNCH_PROFILE_TIMEOUT_SECONDS);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Mode", CMUIX_CurrentMode);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "DifficultyBase", CMUIX_DifficultySelectedBase);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "DifficultyPlus", CMUIX_DifficultySelectedPlus);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TargetMission", lv_targetMission);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TargetMap", lv_targetMap);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Enemy", lv_enemy);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeType", lv_challengeType);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeSelected", lv_challengeSelected);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeFinal", lv_challengeFinal);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "LaunchSource", CMUIX_LaunchSource);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileConfigLocked", BoolToInt(CMUIX_ProfileConfigLocked));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileOptimizationAllowed", BoolToInt(CMUIX_ProfileOptimizationAllowed));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileActive", BoolToInt(CMUIX_ProfileModeActive));
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileRaw", CMUIX_ProfileRawConfig);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileChallengeName", CMUIX_ProfileChallengeName);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileChecksum", CMUIX_ProfileChecksumValue);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileCertified", BoolToInt(CMUIX_ProfileCertified));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileMasteryCapEnabled", BoolToInt(CMUIX_ProfileMasteryCapEnabled));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileMasteryCap", CMUIX_ProfileMasteryCap);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledCommanders", CMUIX_ProfileDisabledCommanders);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledPrestiges", CMUIX_ProfileDisabledPrestiges);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledAIs", CMUIX_ProfileDisabledAIs);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileAllowedAIs", CMUIX_ProfileAllowedAIs);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileRandomSeedExplicit", BoolToInt(CMUIX_ProfileRandomSeedExplicit));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "RandomSeedResolved", BoolToInt(CMUIX_RandomSeedResolved));
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "RandomSeed", CMUIX_RandomSeed);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptCount", CMUIX_LaunchAttemptCount);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptChecksum", lv_attemptChecksum);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "HistoryKey", lv_historyKey);
    BankValueSetFromString(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "SourceProfileKey", CMUIX_ProfileSourceTemplateKey);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "SourceProfilePlayer", CMUIX_ProfileSourceTemplatePlayer);
    CMUIX_LaunchProfileSaveActiveMutators(lv_bank);
    CMUIX_LaunchProfileSaveChaosRuntime(lv_bank);
    CMUIX_LaunchProfileSaveCommanders(lv_bank);
    CMUIX_LaunchProfileSaveBank(lp_player);
}

void CMUIX_LaunchProfileSaveForTransition(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_FinalApplyLocalLaunchConfiguration();
    CMUIX_ProfileCountLaunchStartAll();
    CMUIX_LaunchProfileSaveSnapshot(lp_player);
}

void CMUIX_LaunchProfileSaveForTransitionAll() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_HumanPlayers();
    CMUIX_FinalApplyLocalLaunchConfiguration();
    CMUIX_ProfileCountLaunchStartAll();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_LaunchProfileSaveSnapshot(lv_player);
    }
}

void CMUIX_LaunchProfileRefreshRetryForPlayer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_LaunchAttemptCount < 1)) {
        CMUIX_LaunchAttemptCount = 1;
    }

    CMUIX_LaunchAttemptCount += 1;
    CMUIX_LaunchLastResult = "Retry";
    CMUIX_LaunchProfileSaveSnapshot(lp_player);
}

void CMUIX_LaunchProfileRefreshRetryAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    if ((CMUIX_LaunchAttemptCount < 1)) {
        CMUIX_LaunchAttemptCount = 1;
    }

    CMUIX_LaunchAttemptCount += 1;
    CMUIX_LaunchLastResult = "Retry";
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_LaunchProfileSaveSnapshot(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_LaunchProfileSaveSnapshot(1);
    }
}

void CMUIX_OnRetryButtonClicked() {
    CMUIX_LaunchProfileRefreshRetryAll();
}

void CMUIX_LaunchProfileClear(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_LaunchProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    BankSectionRemove(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Valid", 0);
    BankValueSetFromInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Version", CMUIX_LAUNCH_PROFILE_VERSION);
    CMUIX_LaunchProfileSaveBank(lp_player);
}

void CMUIX_LaunchProfileClearAll() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_LaunchProfileClear(lv_player);
    }
}

bool CMUIX_LaunchProfileBankExpired(bank lp_bank) {
    int lv_createdAt;
    int lv_timeout;
    int lv_now;

    lv_createdAt = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "CreatedAt", 0);
    lv_timeout = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TimeoutSeconds", CMUIX_LAUNCH_PROFILE_TIMEOUT_SECONDS);
    lv_now = DateTimeToInt(CurrentDateTimeGet());
    if ((lv_createdAt <= 0)) {
        return true;
    }

    if ((lv_timeout <= 0)) {
        lv_timeout = CMUIX_LAUNCH_PROFILE_TIMEOUT_SECONDS;
    }

    return ((lv_now - lv_createdAt) > lv_timeout);
}

bool CMUIX_LaunchProfileMatchesCurrentMap(bank lp_bank) {
    string lv_targetMission;
    string lv_currentMission;

    lv_targetMission = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TargetMission", "");
    lv_currentMission = CMUIX_MapSelectionCurrentMapInstance();
    if ((lv_targetMission == "") || (lv_currentMission == "")) {
        return false;
    }

    return (lv_targetMission == lv_currentMission);
}

bool CMUIX_LaunchProfileValidForStartup(bank lp_bank) {
    if ((lp_bank == null)) {
        return false;
    }

    if ((CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Valid", 0) != 1)) {
        return false;
    }

    if ((CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Version", 0) != CMUIX_LAUNCH_PROFILE_VERSION)) {
        return false;
    }

    if ((CMUIX_LaunchProfileBankExpired(lp_bank) == true)) {
        return false;
    }

    return CMUIX_LaunchProfileMatchesCurrentMap(lp_bank);
}

void CMUIX_LaunchProfileClearMutatorRuntimeForLoad() {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_slot = 1;
    lv_mutator = "";
    CMUIX_StandardBrutalPlusClearRuntime();
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((lv_mutator != "")) {
            libCOMU_gf_CT_DisableMutatorVariant(lv_mutator);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1, 0);
            lv_slot = 1;
            while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
                UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Slot", lv_slot, 0);
                lv_slot += 1;
            }
        }

        lv_index += 1;
    }
}

void CMUIX_LaunchProfileApplyMutatorSlot(bank lp_bank, int lp_slot, int lp_mode) {
    string lv_mutator;
    bool lv_enhanced;

    lv_mutator = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileMutatorKey(lp_slot, "Id"), "");
    lv_enhanced = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileMutatorKey(lp_slot, "Enhanced"), 0) == 1);
    if ((lv_mutator == "") || (CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
        return;
    }

    libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, lv_enhanced);
    UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 1);
    UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, BoolToInt(lv_enhanced));
    if ((CMUIX_LaunchProfileModeUsesFinalMutatorArray(lp_mode) == true) && (lp_slot <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        libCOMU_gv_cT_MAbomination_Mutators[lp_slot] = lv_mutator;
        libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lp_slot] = lv_enhanced;
    }
}

void CMUIX_LaunchProfileApplyChaosRuntime(bank lp_bank, int lp_mode) {
    int lv_slot;
    int lv_count;
    int lv_loaded;
    string lv_mutator;

    lv_slot = 1;
    lv_count = 0;
    lv_loaded = 0;
    lv_mutator = "";
    if ((lp_bank == null) || (lp_mode != CMUIX_MODE_CUSTOM)) {
        return;
    }

    lv_count = CMUIX_ClampInt(CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChaosCount", 0), 0, CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX);
    while ((lv_slot <= lv_count)) {
        lv_mutator = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfileChaosKey(lv_slot, "Id"), "");
        if ((lv_mutator != "") && (lv_mutator != null) && (CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            lv_loaded = lv_loaded + 1;
            libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, false);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1, 1);
            libCOTF_gv_rT_ChaosMutators[lv_loaded] = lv_mutator;
            if ((lv_loaded <= 3)) {
                libCOMU_gv_cT_RandomMutators[lv_loaded] = lv_mutator;
                libCOMU_gv_cT_RandomMutatorsEnhanced[lv_loaded] = false;
            }
        }

        lv_slot = lv_slot + 1;
    }

    libCOTF_gv_rT_ChaosCycleCount = lv_loaded;
}

void CMUIX_LaunchProfileApplyMutators(bank lp_bank, int lp_mode) {
    int lv_slot;
    int lv_count;
    string lv_difficultyLevel;

    lv_slot = 1;
    lv_count = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "MutatorCount", 0);
    lv_difficultyLevel = "";
    CMUIX_LaunchProfileClearMutatorRuntimeForLoad();

    if ((lp_mode == CMUIX_MODE_STANDARD) && (CMUIX_DifficultySelectedPlus > 0)) {
        lv_difficultyLevel = CMUIX_StandardBrutalPlusDifficultyLevel(CMUIX_DifficultySelectedPlus);
        libCOMU_gv_cT_MAbomination_DifficultyLevel = lv_difficultyLevel;
        libCOMU_gv_cT_MAbomination_MutatorsCount = CMUIX_ClampInt(lv_count, 0, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
    }
    else {
        if ((lp_mode == CMUIX_MODE_MUTATOR)) {
            libCOMU_gv_cT_MAbomination_MutatorsCount = CMUIX_ClampInt(lv_count, 0, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
        }
    }

    while ((lv_slot <= lv_count) && (lv_slot <= CMUIX_LAUNCH_PROFILE_MUTATOR_MAX)) {
        CMUIX_LaunchProfileApplyMutatorSlot(lp_bank, lv_slot, lp_mode);
        lv_slot += 1;
    }

    CMUIX_LaunchProfileApplyChaosRuntime(lp_bank, lp_mode);
}

void CMUIX_LaunchProfileApplyMapEnemyAndMode(bank lp_bank) {
    int lv_mode;
    int lv_typeIndex;
    int lv_attemptChecksum;
    string lv_modeInstance;
    string lv_mission;
    string lv_mapLink;
    string lv_enemy;
    string lv_challengeType;
    string lv_challengeSelected;
    string lv_challengeFinal;

    lv_mode = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Mode", CMUIX_MODE_STANDARD);
    lv_typeIndex = 0;
    lv_attemptChecksum = 0;
    lv_modeInstance = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ModeInstance", CMUIX_LaunchProfileModeInstance(lv_mode));
    lv_mission = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TargetMission", "");
    lv_mapLink = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "TargetMap", "");
    lv_enemy = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Enemy", "");
    lv_challengeType = CMUIX_MutatorChallengeNormalizeType(CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeType", CMUIX_MutatorChallenge_Type_Official));
    lv_challengeSelected = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeSelected", "");
    lv_challengeFinal = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ChallengeFinal", "");
    if ((lv_mode < CMUIX_MODE_STANDARD) || (lv_mode > CMUIX_MODE_CUSTOM)) {
        lv_mode = CMUIX_LaunchProfileModeIndex(lv_modeInstance);
    }

    CMUIX_CurrentMode = lv_mode;
    libCOTF_gv_sELECTED_Mode = CMUIX_LaunchProfileModeInstance(lv_mode);
    CMUIX_DifficultySelectedBase = CMUIX_DifficultyClampBase(CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "DifficultyBase", CMUIX_DifficultySelectedBase));
    CMUIX_DifficultySelectedPlus = CMUIX_DifficultyClampPlus(CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "DifficultyPlus", CMUIX_DifficultySelectedPlus));
    CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
    CMUIX_DifficultyDraftPlus = CMUIX_DifficultySelectedPlus;
    CMUIX_LaunchSource = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "LaunchSource", CMUIX_LAUNCH_SOURCE_MANUAL);
    if ((CMUIX_LaunchSource < CMUIX_LAUNCH_SOURCE_MANUAL) || (CMUIX_LaunchSource > CMUIX_LAUNCH_SOURCE_HISTORY)) {
        CMUIX_LaunchSource = CMUIX_LAUNCH_SOURCE_MANUAL;
    }

    CMUIX_ProfileConfigLocked = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileConfigLocked", 0) == 1);
    CMUIX_ProfileOptimizationAllowed = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileOptimizationAllowed", 1) == 1);
    CMUIX_ProfileModeActive = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileActive", 0) == 1);
    CMUIX_ProfileRawConfig = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileRaw", "");
    CMUIX_ProfileChallengeName = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileChallengeName", "");
    CMUIX_ProfileChecksumValue = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileChecksum", 0);
    CMUIX_ProfileCertified = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileCertified", 0) == 1);
    CMUIX_ProfileMasteryCapEnabled = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileMasteryCapEnabled", 0) == 1);
    CMUIX_ProfileMasteryCap = CMUIX_ClampInt(CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileMasteryCap", CMUIX_DefaultMasteryCap()), 0, libCOOC_gv_cCC_MASTERY_MAX_LEVEL);
    CMUIX_ProfileDisabledCommanders = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledCommanders", "");
    CMUIX_ProfileDisabledPrestiges = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledPrestiges", "");
    CMUIX_ProfileDisabledAIs = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileDisabledAIs", "");
    CMUIX_ProfileAllowedAIs = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileAllowedAIs", "");
    if ((CMUIX_ProfileConfigLocked == false)) {
        CMUIX_ProfileDisabledCommanders = "";
        CMUIX_ProfileDisabledPrestiges = "";
        CMUIX_ProfileDisabledAIs = "";
        CMUIX_ProfileAllowedAIs = "";
    }

    CMUIX_ProfileRandomSeedExplicit = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileRandomSeedExplicit", 0) == 1);
    CMUIX_RandomSeedResolved = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "RandomSeedResolved", 0) == 1);
    CMUIX_RandomSeed = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "RandomSeed", 0);
    CMUIX_RandomSeedInputResetDraft();
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_LaunchAttemptCount = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptCount", 1);
    CMUIX_LaunchAttemptChecksum = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptChecksum", 0);
    CMUIX_LaunchHistoryKey = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "HistoryKey", "");
    CMUIX_ProfileSourceTemplateKey = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "SourceProfileKey", "");
    CMUIX_ProfileSourceTemplatePlayer = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "SourceProfilePlayer", 0);
    if ((CMUIX_ProfileSourceTemplatePlayer < 1) || (CMUIX_ProfileSourceTemplatePlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ProfileSourceTemplatePlayer = 0;
    }

    CMUIX_ProfileSourceHistoryKey = "";
    CMUIX_LaunchLastResult = "";
    lv_attemptChecksum = CMUIX_LaunchAttemptChecksumFor(CMUIX_LaunchAttemptCount, CMUIX_LaunchHistoryKey, CMUIX_ProfileChallengeName);
    if ((CMUIX_LaunchAttemptChecksum != lv_attemptChecksum)) {
        CMUIX_LaunchAttemptCount = 1;
        CMUIX_LaunchAttemptNormalize();
    }
    if ((lv_mission != "")) {
        libCOTF_gv_sELECTED_Mission = lv_mission;
        libCOTF_gv_mapSelect_Mission = lv_mission;
    }

    if ((lv_mapLink == "") && (lv_mission != "")) {
        lv_mapLink = UserDataGetGameLink("CoopMaps", lv_mission, "MA - Map Link", 1);
    }

    if ((lv_mapLink != "")) {
        libCOTF_gv_sELECTED_Map = lv_mapLink;
    }

    if ((lv_enemy != "")) {
        CMUIX_EnemySelectionSelected = lv_enemy;
        CMUIX_EnemySelectionDraft = lv_enemy;
        libCOMI_gf_CM_CoopAIPersonalitySet(lv_enemy);
    }

    if ((lv_mode == CMUIX_MODE_MUTATOR)) {
        CMUIX_MutatorChallengeCurrentType = lv_challengeType;
        lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_challengeType);
        if ((lv_typeIndex > 0) && (lv_typeIndex <= CMUIX_MUTATOR_CHALLENGE_TYPE_MAX)) {
            if ((lv_challengeSelected != "")) {
                CMUIX_MutatorChallengeSelected[lv_typeIndex] = lv_challengeSelected;
                CMUIX_MutatorChallengeDraft[lv_typeIndex] = lv_challengeSelected;
            }

            if ((lv_challengeFinal != "")) {
                libCOMU_gf_CT_MutatorChallengesSet(lv_challengeType);
                libCOMU_gv_cT_MutatorChallengesCurrentChallenge = lv_challengeFinal;
            }
        }
    }

    CMUIX_LaunchProfileApplyMutators(lp_bank, lv_mode);
    if ((lv_mode == CMUIX_MODE_MUTATOR)) {
        if ((lv_challengeFinal == "") || (lv_challengeFinal == null)) {
            lv_challengeFinal = lv_challengeSelected;
        }

        CMUIX_MutatorChallengeApplyRuntime(lv_challengeType, lv_challengeFinal);
    }

    CMUIX_ProfileApplyMasteryCapAll();
}

void CMUIX_PrepareConsoleSkinRefreshForCommander(int lp_player, string lp_commander) {
    string lv_targetRace;
    string lv_refreshRace;
    string lv_commanderData;

    lv_targetRace = "";
    lv_refreshRace = "Zerg";
    lv_commanderData = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lp_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lp_commander) == 0)) {
        return;
    }

    lv_targetRace = libCOOC_gf_CC_CommanderRace(lp_commander);
    lv_commanderData = libCOOC_gf_CC_CommanderData(lp_commander);
    if ((lv_targetRace == "") || (lv_targetRace == null) || (lv_commanderData == "") || (lv_commanderData == null)) {
        return;
    }

    if ((lv_targetRace == "Zerg")) {
        lv_refreshRace = "Terr";
    }

    PlayerSetRace(lp_player, lv_refreshRace);
    Wait(0.0625, c_timeGame);
    PlayerSetRace(lp_player, lv_targetRace);
    PlayerSetCommander(lp_player, lv_commanderData);
}

void CMUIX_LaunchProfileApplyCommanderCustomization(bank lp_bank, int lp_player, string lp_commander) {
    int lv_slot;
    int lv_count;
    int lv_commanderLevel;
    int lv_masteryLevel;
    int lv_value;
    string lv_masteryUpgrade;
    string lv_voicePack;
    string lv_optimization;

    lv_slot = 1;
    lv_count = 0;
    lv_commanderLevel = libCOOC_gf_CC_CommanderLevel(lp_player, lp_commander);
    lv_masteryLevel = 0;
    lv_value = 0;
    lv_masteryUpgrade = "";
    lv_voicePack = "";
    lv_optimization = "";
    if ((lp_bank == null) || (lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return;
    }

    if ((CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "CustomizationSaved"), 0) != 1)) {
        return;
    }

    lv_commanderLevel = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "CommanderLevel"), lv_commanderLevel);
    CMUIX_CoopProgressSetCommanderLevel(lp_player, lp_commander, lv_commanderLevel);
    lv_masteryLevel = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "MasteryLevel"), CMUIX_MasteryPointsCurrentDefault());
    lv_masteryLevel = CMUIX_ClampInt(lv_masteryLevel, 0, CMUIX_ProfileMasteryCapCurrent());
    libCOOC_gf_CC_PlayerMasteryEnabledSet(lp_player, true);
    libCOOC_gf_CC_PlayerMasteryLevelSet(lp_player, lv_masteryLevel);
    lv_count = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "MasteryCount"), 0);
    while ((lv_slot <= lv_count) && (lv_slot <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        lv_masteryUpgrade = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Mastery", lv_slot, "Id"), "");
        if ((lv_masteryUpgrade != "") && (lv_masteryUpgrade != null)) {
            lv_value = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Mastery", lv_slot, "Value"), 0);
            libCOOC_gf_CC_PlayerMasteryUpgradeLevelSet(lp_player, lv_masteryUpgrade, CMUIX_ClampInt(lv_value, 0, libCOOC_gv_cCC_MASTERY_UPGRADE_MAX_LEVEL));
        }

        lv_slot += 1;
    }

    CMUIX_WritePrestigeForCommander(lp_player, lp_commander, CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "Prestige"), CMUIX_ReadPrestigeForCommander(lp_player, lp_commander)));
    if ((CMUIX_ProfileConfigLocked == true)) {
        lv_voicePack = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "VoicePack"), "");
        CMUIX_VoicePackSetTemporaryForPlayerCommander(lp_player, lp_commander, lv_voicePack);
        CMUIX_OptimizationClearTemporaryForPlayer(lp_player);
        if ((CMUIX_ProfileOptimizationAllowed == true)) {
            CMUIX_OptimizationTemporaryActive[lp_player] = true;
            CMUIX_OptimizationTemporaryMasterEnabled[lp_player] = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "OptimizationMaster"), CMUIX_DefaultOptimizationMasterEnabled()) != 0);
            lv_count = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "OptimizationCount"), 0);
            if ((lv_count > CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
                lv_count = CMUIX_PERSONALIZATION_OPTIMIZATION_MAX;
            }

            CMUIX_OptimizationTemporaryCount[lp_player] = lv_count;
            lv_slot = 1;
            while ((lv_slot <= lv_count)) {
                lv_optimization = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Optimization", lv_slot, "Id"), "");
                CMUIX_OptimizationTemporaryIds[lp_player][lv_slot] = lv_optimization;
                CMUIX_OptimizationTemporaryValues[lp_player][lv_slot] = (CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerSlotKey(lp_player, "Optimization", lv_slot, "Value"), CMUIX_OptimizationDefaultEnabled(lv_optimization)) != 0);
                lv_slot += 1;
            }
        }
    }
    else {
        CMUIX_VoicePackClearTemporaryForPlayer(lp_player);
        CMUIX_OptimizationClearTemporaryForPlayer(lp_player);
    }

    CMUIX_ApplyCommanderMasteryGate(lp_player, lp_commander);
}

void CMUIX_LaunchProfileApplyCommander(bank lp_bank, int lp_player) {
    string lv_commander;
    int lv_selection;

    lv_selection = 0;
    lv_commander = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, CMUIX_LaunchProfilePlayerKey(lp_player, "Commander"), "");
    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
        lv_commander = CMUIX_DefaultCommanderForPlayer(lp_player);
    }

    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
        lv_selection = CMUIX_InitialCommanderSelectionForPlayer(lp_player);
        lv_commander = CMUIX_CommanderForSelection(lv_selection);
    }

    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
        return;
    }

    libCOTF_gv_sELECTED_Commander[lp_player] = lv_commander;
    libCOTF_gv_sELECTED_Commander_Random[lp_player] = false;
    libCOUI_gv_cU_CommanderSelection[lp_player] = lv_commander;
    libCOUI_gv_cU_CommanderSelect_PlayerReady[lp_player] = true;
    CMUIX_LaunchProfileApplyCommanderCustomization(lp_bank, lp_player, lv_commander);
    CMUIX_VoicePackApplyRuntimeForCommander(lv_commander, CMUIX_VoicePackRuntimeForPlayerCommander(lp_player, lv_commander));
    CMUIX_PrepareConsoleSkinRefreshForCommander(lp_player, lv_commander);
    libCOUI_gf_CU_CommanderFinalizeStates(lp_player);
    CMUIX_ApplyStoredPrestigeForCommander(lp_player, lv_commander);
    CMUIX_EnsureDefaultAIMastery(lp_player);
    CMUIX_ApplyCommanderMasteryGate(lp_player, lv_commander);
    libCOOC_gf_CC_UpdateTechStates(lp_player);
    if ((CMUIX_ProfileConfigLocked == false)) {
        CMUIX_CoopProgressSaveForPlayer(lp_player);
    }
}

void CMUIX_LaunchProfileApplyCommanders(bank lp_bank) {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_LaunchProfileApplyCommander(lp_bank, lv_player);
    }
}

void CMUIX_LaunchProfileApply(bank lp_bank) {
    CMUIX_LaunchProfileApplyMapEnemyAndMode(lp_bank);
    CMUIX_LaunchProfileApplyCommanders(lp_bank);
}

void CMUIX_LaunchProfileLoadRuntimeHistoryForPlayer(int lp_player, bank lp_bank) {
    string lv_historyKey;
    string lv_challengeName;
    int lv_attemptCount;
    int lv_attemptChecksum;
    int lv_expectedChecksum;

    lv_historyKey = "";
    lv_challengeName = "";
    lv_attemptCount = 1;
    lv_attemptChecksum = 0;
    lv_expectedChecksum = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lp_bank == null)) {
        return;
    }

    lv_historyKey = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "HistoryKey", "");
    if ((lv_historyKey == "") || (lv_historyKey == null)) {
        return;
    }

    lv_challengeName = CMUIX_PlayerProfileGetString(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "ProfileChallengeName", "");
    lv_attemptCount = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptCount", 1);
    lv_attemptChecksum = CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_LAUNCH_PROFILE_SECTION, "AttemptChecksum", 0);
    if ((lv_attemptCount < 1)) {
        lv_attemptCount = 1;
    }

    lv_expectedChecksum = CMUIX_LaunchAttemptChecksumFor(lv_attemptCount, lv_historyKey, lv_challengeName);
    if ((lv_attemptChecksum != lv_expectedChecksum)) {
        return;
    }

    CMUIX_LaunchHistoryKeys[lp_player] = lv_historyKey;
    CMUIX_GameHistoryEnsureNextIndexForKey(lp_player, lv_historyKey);
}

bool CMUIX_LaunchProfileTryLoadForStartup(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_LaunchProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return false;
    }

    if ((CMUIX_LaunchProfileValidForStartup(lv_bank) == false)) {
        if ((CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Valid", 0) == 1) && (CMUIX_LaunchProfileBankExpired(lv_bank) == true)) {
            CMUIX_LaunchProfileClear(lp_player);
        }

        return false;
    }

    CMUIX_LaunchProfileLoadRuntimeHistoryForPlayer(lp_player, lv_bank);
    CMUIX_LaunchProfileApply(lv_bank);
    CMUIX_LaunchProfileClear(lp_player);
    return true;
}

bool CMUIX_LaunchProfileTryLoadForStartupAll() {
    int lv_player;
    bool lv_loadedTransition;
    bank lv_bank;
    playergroup lv_players;

    lv_player = -1;
    lv_loadedTransition = false;
    lv_bank = null;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_bank = CMUIX_LaunchProfileOpenBank(lv_player);
        if ((lv_bank != null) && (CMUIX_LaunchProfileValidForStartup(lv_bank) == true)) {
            CMUIX_LaunchProfileLoadRuntimeHistoryForPlayer(lv_player, lv_bank);
            if ((lv_loadedTransition == false)) {
                CMUIX_LaunchProfileApply(lv_bank);
                lv_loadedTransition = true;
            }
        }
        else {
            if ((lv_bank != null) && (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_LAUNCH_PROFILE_SECTION, "Valid", 0) == 1) && (CMUIX_LaunchProfileBankExpired(lv_bank) == true)) {
                CMUIX_LaunchProfileClear(lv_player);
            }
        }
    }

    if ((lv_loadedTransition == true)) {
        CMUIX_LaunchProfileClearAll();
        return true;
    }

    return false;
}

void CMUIX_StartupLoadPersistentProfiles() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        if ((lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_PlayerProfileLoadAllToUserData(lv_player);
            lv_seenPlayers += 1;
        }
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_PlayerProfileLoadAllToUserData(1);
        CMUIX_PlayerProfileLoadAllToUserData(2);
    }

    CMUIX_StartupInvalidateAllCachedData();
}

bool CMUIX_StartupApplySavedConfiguration() {
    bool lv_loadedTransition;
    int lv_difficulty;
    int lv_player;
    playergroup lv_players;

    lv_loadedTransition = false;
    if ((CMUIX_CoreReady == false)) {
        CMUIX_CoreInit();
    }

    CMUIX_StartupLoadPersistentProfiles();
    CMUIX_HistoryPrunePendingRecordsAll();
    lv_loadedTransition = CMUIX_LaunchProfileTryLoadForStartupAll();
    if ((lv_loadedTransition == true)) {
        CMUIX_StartupPathState = CMUIX_STARTUP_PATH_TRANSITION;
        CMUIX_StartupInvalidateAllCachedData();

        lv_difficulty = CMUIX_DifficultyBaseIndexValue(CMUIX_DifficultySelectedBase);
        lv_player = -1;
        lv_players = PlayerGroupAll();
        while ((true == true)) {
            lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
            if ((lv_player < 0)) {
                break;
            }

            PlayerSetDifficulty(lv_player, lv_difficulty);
        }

        return true;
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        if ((CMUIX_StartupPathState != CMUIX_STARTUP_PATH_TRANSITION)) {
            CMUIX_StartupPathState = CMUIX_STARTUP_PATH_DIRECT;
        }

        libCOTF_gf_RunTriggerByNameEasy(UserDataGetString("GlobalOptions", "CommanderSelectionScreen", "TriggerString", 1), false, false);
        return false;
    }

    if ((CMUIX_StartupPathState != CMUIX_STARTUP_PATH_TRANSITION)) {
        CMUIX_StartupPathState = CMUIX_STARTUP_PATH_LAUNCHER;
    }

    CMUIX_HistoryFinalizeAbandonedRecordsAll();
    return false;
}

string CMUIX_CurrentStartupPath() {
    return CMUIX_StartupPathState;
}

bool CMUIX_CustomizationShouldPersistToPlayerData() {
    if ((CMUIX_ProfileConfigLocked == true)) {
        return false;
    }

    return true;
}

int CMUIX_MutatorPoolBoolToInt(bool lp_value) {
    if ((lp_value == true)) {
        return 1;
    }

    return 0;
}

bool CMUIX_MutatorPoolIntIsEnabled(int lp_value) {
    if ((lp_value == 1)) {
        return true;
    }

    return false;
}

bool CMUIX_MutatorPoolMutatorIsCommonEligible(string lp_mutator) {
    if ((lp_mutator == "")) {
        return false;
    }

    if ((CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true)) {
        return false;
    }

    if (CMUIX_MutatorAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_mutator) == false) {
        return false;
    }

    if ((UserDataGetInt("Mutators", lp_mutator, "MA - Custom Allowed", 1) != 1)) {
        return false;
    }

    return true;
}

string CMUIX_SearchNormalize(string lp_value) {
    string lv_value;

    if ((lp_value == "")) {
        return "";
    }

    lv_value = lp_value;
    lv_value = StringReplaceWord(lv_value, " ", "", c_stringReplaceAll, c_stringNoCase);
    lv_value = StringReplaceWord(lv_value, "\n", "", c_stringReplaceAll, c_stringNoCase);
    lv_value = StringReplaceWord(lv_value, "\r", "", c_stringReplaceAll, c_stringNoCase);
    lv_value = StringReplaceWord(lv_value, "\t", "", c_stringReplaceAll, c_stringNoCase);
    return lv_value;
}

bool CMUIX_SearchSimpleFuzzyMatch(string lp_haystack, string lp_needle) {
    string lv_haystack;
    string lv_needle;

    lv_haystack = CMUIX_SearchNormalize(lp_haystack);
    lv_needle = CMUIX_SearchNormalize(lp_needle);
    if ((lv_needle == "")) {
        return true;
    }

    return StringContains(lv_haystack, lv_needle, c_stringAnywhere, c_stringNoCase);
}

bool CMUIX_MutatorPoolMatchesSearch(int lp_view, string lp_mutator) {
    string lv_searchText;
    string lv_searchBody;

    lv_searchText = CMUIX_MutatorPoolSearchText[lp_view];
    if ((lv_searchText == "")) {
        return true;
    }

    lv_searchBody = lp_mutator + " " + TextToString(libCOMU_gf_CT_MutatorName(lp_mutator)) + " " + TextToString(libCOMU_gf_CT_MutatorDescription(lp_mutator));
    return CMUIX_SearchSimpleFuzzyMatch(lv_searchBody, lv_searchText);
}

bool CMUIX_CustomMutatorPickerIsPlaceholder(string lp_mutator) {
    if ((lp_mutator == CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM) || (lp_mutator == CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS)) {
        return true;
    }

    return false;
}

bool CMUIX_CustomMutatorPickerSelectable(string lp_mutator) {
    if ((lp_mutator == "") || (lp_mutator == "None")) {
        return false;
    }

    if (CMUIX_MutatorAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_mutator) == false) {
        return false;
    }

    if ((libCOMU_gf_CT_MutatorCustomAllowed(lp_mutator) == false)) {
        return false;
    }

    return true;
}

bool CMUIX_CustomMutatorPickerMultipleAllowed(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return false;
    }

    return libCOMU_gf_CT_MutatorCustomMultipleAllowed(lp_mutator);
}

bool CMUIX_CustomMutatorPickerSettingsAllowed(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return false;
    }

    if ((UserDataGetInt("Mutators", lp_mutator, "MA - Custom Settings Allowed", 1) == 1)) {
        return true;
    }

    return false;
}

bool CMUIX_CustomMutatorPickerEnhanceAllowed(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerIsPlaceholder(lp_mutator) == true)) {
        return false;
    }

    return libCOMU_gf_MutatorHasEnhancement(lp_mutator);
}

text CMUIX_CustomMutatorPickerTooltip(string lp_mutator) {
    if ((lp_mutator == "")) {
        return StringToText("");
    }

    return libCOMU_gf_CT_MutatorDescription(lp_mutator);
}

text CMUIX_CustomMutatorPickerVariantTooltip(string lp_mutator, int lp_enhanced) {
    if ((lp_mutator == "")) {
        return StringToText("");
    }

    if ((lp_enhanced == 1) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lp_mutator) == true)) {
        return libCOMU_gf_CT_MutatorEnhanceDescription(lp_mutator);
    }

    return libCOMU_gf_CT_MutatorDescription(lp_mutator);
}

bool CMUIX_CustomMutatorPickerMatchesSearch(string lp_mutator) {
    string lv_searchBody;
    string lv_searchText;

    lv_searchText = CMUIX_CustomMutatorPickerSearchText;
    if ((lv_searchText == "")) {
        return true;
    }

    lv_searchBody = lp_mutator + " " + TextToString(libCOMU_gf_CT_MutatorName(lp_mutator)) + " " + TextToString(libCOMU_gf_CT_MutatorDescription(lp_mutator)) + " " + libCOMU_gf_CT_MutatorSearchString(lp_mutator);
    return CMUIX_SearchSimpleFuzzyMatch(lv_searchBody, lv_searchText);
}

int CMUIX_CustomMutatorPickerSelectedOccurrences(string lp_mutator) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = 0;
    while ((lv_index <= CMUIX_CustomMutatorPickerDraftCount) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((CMUIX_CustomMutatorPickerDraftMutators[lv_index] == lp_mutator)) {
            lv_count += 1;
        }

        lv_index += 1;
    }

    return lv_count;
}

bool CMUIX_CustomMutatorPickerDraftEnhancedForMutator(string lp_mutator) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((lv_index <= 0) || (lv_index > CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerDraftEnhanceMarks[lv_index] == 1)) {
        return true;
    }

    return false;
}

bool CMUIX_CustomMutatorPickerAcceptedEnhancedForMutator(string lp_mutator) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((lv_index <= 0) || (lv_index > CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] == 1)) {
        return true;
    }

    return false;
}

void CMUIX_CustomMutatorPickerSetDraftEnhanced(string lp_mutator, bool lp_enhanced) {
    int lv_index;
    int lv_slot;
    int lv_state;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    lv_slot = 1;
    lv_state = 0;
    if ((lv_index <= 0) || (lv_index > CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        return;
    }

    if ((lp_enhanced == true) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lp_mutator) == true)) {
        lv_state = 1;
    }

    CMUIX_CustomMutatorPickerDraftEnhanceMarks[lv_index] = lv_state;
    while ((lv_slot <= CMUIX_CustomMutatorPickerDraftCount) && (lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((CMUIX_CustomMutatorPickerDraftMutators[lv_slot] == lp_mutator)) {
            CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot] = lv_state;
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerToggleDraftEnhanced(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerEnhanceAllowed(lp_mutator) == false)) {
        CMUIX_CustomMutatorPickerSetDraftEnhanced(lp_mutator, false);
        return;
    }

    if ((CMUIX_CustomMutatorPickerDraftEnhancedForMutator(lp_mutator) == true)) {
        CMUIX_CustomMutatorPickerSetDraftEnhanced(lp_mutator, false);
    }
    else {
        CMUIX_CustomMutatorPickerSetDraftEnhanced(lp_mutator, true);
    }
}

bool CMUIX_CustomMutatorPickerCanAdd(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerDraftCount >= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerMultipleAllowed(lp_mutator) == true)) {
        return true;
    }

    if ((CMUIX_CustomMutatorPickerSelectedOccurrences(lp_mutator) == 0)) {
        return true;
    }

    return false;
}

int CMUIX_CustomMutatorPickerMaxPage() {
    if ((CMUIX_CustomMutatorPickerVisibleCount <= 0)) {
        return 1;
    }

    return (((CMUIX_CustomMutatorPickerVisibleCount - 1) / CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX) + 1);
}

void CMUIX_CustomMutatorPickerClampPage() {
    int lv_maxPage;

    lv_maxPage = CMUIX_CustomMutatorPickerMaxPage();
    if ((CMUIX_CustomMutatorPickerPageIndex < 1)) {
        CMUIX_CustomMutatorPickerPageIndex = 1;
    }

    if ((CMUIX_CustomMutatorPickerPageIndex > lv_maxPage)) {
        CMUIX_CustomMutatorPickerPageIndex = lv_maxPage;
    }
}

void CMUIX_CustomMutatorPickerAddVisible(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerVisibleCount >= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        return;
    }

    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return;
    }

    if ((CMUIX_CustomMutatorPickerMatchesSearch(lp_mutator) == false)) {
        return;
    }

    CMUIX_CustomMutatorPickerVisibleCount += 1;
    CMUIX_CustomMutatorPickerVisibleMutators[CMUIX_CustomMutatorPickerVisibleCount] = lp_mutator;
}

void CMUIX_CustomMutatorPickerBuildVisibleList() {
    int lv_index;
    int lv_count;
    int lv_clearIndex;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_clearIndex = 0;
    lv_mutator = "";
    CMUIX_CustomMutatorPickerVisibleCount = 0;
    while ((lv_clearIndex <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerVisibleMutators[lv_clearIndex] = "";
        lv_clearIndex += 1;
    }

    if ((CMUIX_CustomMutatorPickerSearchText == "")) {
        CMUIX_CustomMutatorPickerAddVisible(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
        CMUIX_CustomMutatorPickerAddVisible(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
    }

    while ((lv_index <= lv_count) && (CMUIX_CustomMutatorPickerVisibleCount < CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false) && (CMUIX_CustomMutatorPickerSelectable(lv_mutator) == true) && (CMUIX_CustomMutatorPickerMatchesSearch(lv_mutator) == true)) {
            CMUIX_CustomMutatorPickerVisibleCount += 1;
            CMUIX_CustomMutatorPickerVisibleMutators[CMUIX_CustomMutatorPickerVisibleCount] = lv_mutator;
        }

        lv_index += 1;
    }

    CMUIX_CustomMutatorPickerClampPage();
}

void CMUIX_CustomMutatorPickerRefreshPageControls(playergroup lp_players) {
    int lv_page;
    int lv_maxPage;

    CMUIX_CustomMutatorPickerClampPage();
    lv_page = CMUIX_CustomMutatorPickerPageIndex;
    lv_maxPage = CMUIX_CustomMutatorPickerMaxPage();
    CMUIX_SetControlText(CMUIX_CustomMutatorPickerPageLabel, lp_players, StringToText(IntToString(lv_page) + " / " + IntToString(lv_maxPage)));
    CMUIX_SetControlEnabled(CMUIX_CustomMutatorPickerPrevPageButton, lp_players, (lv_page > 1));
    CMUIX_SetControlEnabled(CMUIX_CustomMutatorPickerNextPageButton, lp_players, (lv_page < lv_maxPage));
}

void CMUIX_CustomMutatorPickerHideAvailableItem(int lp_slot, playergroup lp_players) {
    if ((lp_slot < 1) || (lp_slot > CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        return;
    }

    CMUIX_CustomMutatorPickerItemMutators[lp_slot] = "";
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerItemButtons[lp_slot]) == true)) {
        DialogControlSetAnimationState(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, "SelectionState", "Empty");
        DialogControlSetAnimationState(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, "EnabledState", "Disabled");
    }

    CMUIX_SetControlText(CMUIX_CustomMutatorPickerItemLabels[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, StringToText(""));
    CMUIX_SetControlVisible(CMUIX_CustomMutatorPickerItemSettingsButtons[lp_slot], lp_players, false);
    CMUIX_SetControlVisible(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, false);
    CMUIX_SetControlToggled(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, false);
}

void CMUIX_CustomMutatorPickerRefreshAvailableItem(int lp_slot, string lp_mutator, playergroup lp_players) {
    string lv_state;
    bool lv_settingsAllowed;
    bool lv_enhanceAllowed;

    lv_state = "Normal";
    lv_settingsAllowed = false;
    lv_enhanceAllowed = false;
    if ((lp_slot < 1) || (lp_slot > CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        return;
    }

    if ((lp_mutator == "")) {
        CMUIX_CustomMutatorPickerHideAvailableItem(lp_slot, lp_players);
        return;
    }

    if ((lp_mutator == CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM)) {
        lv_state = "Random";
    }
    else {
        if ((lp_mutator == CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS)) {
            lv_state = "Chaos";
        }
        else {
            if ((CMUIX_CustomMutatorPickerSelectedOccurrences(lp_mutator) > 0)) {
                lv_state = "Toggled";
            }
        }
    }

    CMUIX_CustomMutatorPickerItemMutators[lp_slot] = lp_mutator;
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerItemButtons[lp_slot]) == true)) {
        DialogControlSetAnimationState(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, "SelectionState", lv_state);
        DialogControlSetAnimationState(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, "EnabledState", "Normal");
    }

    CMUIX_SetControlText(CMUIX_CustomMutatorPickerItemLabels[lp_slot], lp_players, libCOMU_gf_CT_MutatorName(lp_mutator));
    CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerItemButtons[lp_slot], lp_players, CMUIX_CustomMutatorPickerTooltip(lp_mutator));
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerItemIcons[lp_slot]) == true) && (CMUIX_CustomMutatorPickerIsPlaceholder(lp_mutator) == false)) {
        libNtve_gf_SetDialogItemImage(CMUIX_CustomMutatorPickerItemIcons[lp_slot], libCOMU_gf_CT_MutatorIcon(lp_mutator), lp_players);
    }

    lv_settingsAllowed = CMUIX_CustomMutatorPickerSettingsAllowed(lp_mutator);
    lv_enhanceAllowed = CMUIX_CustomMutatorPickerEnhanceAllowed(lp_mutator);
    CMUIX_SetControlVisible(CMUIX_CustomMutatorPickerItemSettingsButtons[lp_slot], lp_players, lv_settingsAllowed);
    CMUIX_SetControlVisible(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, lv_enhanceAllowed);
    CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, libCOMU_gf_CT_MutatorEnhanceDescription(lp_mutator));
    CMUIX_SetControlToggled(CMUIX_CustomMutatorPickerItemEnhanceButtons[lp_slot], lp_players, CMUIX_CustomMutatorPickerDraftEnhancedForMutator(lp_mutator));
}

void CMUIX_CustomMutatorPickerRefreshSelectedItems(playergroup lp_players) {
    int lv_slot;
    int lv_maskAlpha;
    string lv_mutator;

    lv_slot = 1;
    lv_maskAlpha = 0;
    lv_mutator = "";
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = CMUIX_CustomMutatorPickerDraftMutators[lv_slot];
        if ((lv_slot <= CMUIX_CustomMutatorPickerDraftCount) && (lv_mutator != "")) {
            if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot]) == true)) {
                DialogControlSetAnimationState(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot], lp_players, "SelectedState", "Active");
            }

            CMUIX_SetControlText(CMUIX_CustomMutatorPickerSelectedLabels[lv_slot], lp_players, libCOMU_gf_CT_MutatorName(lv_mutator));
            CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot], lp_players, CMUIX_CustomMutatorPickerVariantTooltip(lv_mutator, CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot]));
            lv_maskAlpha = 0;
            if ((CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot] == 1) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
                lv_maskAlpha = 255;
            }

            if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSelectedMasks[lv_slot]) == true)) {
                DialogControlSetPropertyAsInt(CMUIX_CustomMutatorPickerSelectedMasks[lv_slot], c_triggerControlPropertyAlpha, lp_players, lv_maskAlpha);
            }
        }
        else {
            if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot]) == true)) {
                DialogControlSetAnimationState(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot], lp_players, "SelectedState", "Empty");
            }

            CMUIX_SetControlText(CMUIX_CustomMutatorPickerSelectedLabels[lv_slot], lp_players, StringToText(""));
            CMUIX_SetControlTooltip(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot], lp_players, StringToText(""));
            if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSelectedMasks[lv_slot]) == true)) {
                DialogControlSetPropertyAsInt(CMUIX_CustomMutatorPickerSelectedMasks[lv_slot], c_triggerControlPropertyAlpha, lp_players, 0);
            }
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerRefreshAll(int lp_player) {
    int lv_slot;
    int lv_visibleIndex;
    int lv_player;
    int lv_seenPlayers;
    string lv_mutator;
    playergroup lv_players;
    playergroup lv_humans;

    lv_slot = 1;
    lv_visibleIndex = 0;
    lv_player = -1;
    lv_seenPlayers = 0;
    lv_mutator = "";
    lv_humans = libCOOC_gf_HumanPlayers();
    lv_players = PlayerGroupAll();
    if ((lp_player == 0)) {
        while ((true == true)) {
            lv_player = PlayerGroupNextPlayer(lv_humans, lv_player);
            if ((lv_player < 0)) {
                break;
            }

            lv_seenPlayers += 1;
            CMUIX_CustomMutatorPickerRefreshAll(lv_player);
        }

        if ((lv_seenPlayers == 0)) {
            CMUIX_CustomMutatorPickerRefreshAll(1);
        }

        return;
    }

    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_players = PlayerGroupSingle(lp_player);
    }

    if ((CMUIX_CustomMutatorPickerHooked == false)) {
        return;
    }

    CMUIX_CustomMutatorPickerLoadViewerState(lp_player);
    CMUIX_CustomMutatorPickerRefreshing = true;
    CMUIX_SetControlText(CMUIX_CustomMutatorPickerOpenButtonLabel, PlayerGroupAll(), StringExternal("CMUI/CustomMutators/MutatorButton"));
    CMUIX_SetControlText(CMUIX_CustomMutatorPickerOpenButton, PlayerGroupAll(), StringExternal("CMUI/CustomMutators/MutatorButton"));
    CMUIX_CustomMutatorPickerBuildVisibleList();
    CMUIX_CustomMutatorPickerRefreshPageControls(lv_players);

    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        lv_visibleIndex = ((CMUIX_CustomMutatorPickerPageIndex - 1) * CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX) + lv_slot;
        if ((lv_visibleIndex >= 1) && (lv_visibleIndex <= CMUIX_CustomMutatorPickerVisibleCount)) {
            lv_mutator = CMUIX_CustomMutatorPickerVisibleMutators[lv_visibleIndex];
            CMUIX_CustomMutatorPickerRefreshAvailableItem(lv_slot, lv_mutator, lv_players);
        }
        else {
            CMUIX_CustomMutatorPickerHideAvailableItem(lv_slot, lv_players);
        }

        lv_slot += 1;
    }

    CMUIX_CustomMutatorPickerRefreshSelectedItems(lv_players);
    CMUIX_CustomMutatorPickerStoreViewerState(lp_player);
    CMUIX_CustomMutatorPickerRefreshing = false;
    CMUIX_ReadyRefreshDataControlsForPlayer(lp_player);
}

void CMUIX_CustomMutatorPickerRefreshOpenViewers(int lp_sourcePlayer) {
    int lv_player;
    bool lv_refreshedSource;
    playergroup lv_humans;

    lv_player = -1;
    lv_refreshedSource = false;
    lv_humans = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_humans, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        if ((lv_player >= 1) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            if ((CMUIX_CustomMutatorPickerOpenStates[lv_player] == true) || (lv_player == lp_sourcePlayer)) {
                CMUIX_CustomMutatorPickerRefreshAll(lv_player);
                if ((lv_player == lp_sourcePlayer)) {
                    lv_refreshedSource = true;
                }
            }
        }
    }

    if ((lv_refreshedSource == false) && (lp_sourcePlayer >= 1) && (lp_sourcePlayer <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomMutatorPickerRefreshAll(lp_sourcePlayer);
    }
}

void CMUIX_AccessRefreshAfterPermissionChange(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_AccessRuntimeUnlockRefreshForPlayer(lp_player);
    libCMUI_gf_ScreenCoopCommanderInitFromData();
    CMUIX_MapSelectionRefreshAll();
    CMUIX_MutatorChallengeRefreshList(lp_player);
    CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
    CMUIX_CustomMutatorPickerRefreshAll(0);
    CMUIX_MutatorPoolRefreshAll();
    CMUIX_RefreshCommanderSelectionVisualsAll();
    CMUIX_ReadyRefreshDataControlsAll();
    if ((CMUIX_ConsoleHooked == true)) {
        CMUIX_ConsoleApplyStateForPlayer(lp_player);
    }
}

int CMUIX_RuntimePermissionShareTarget(int lp_sourcePlayer) {
    int lv_targetPlayer;

    lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_sourcePlayer);
    if ((lv_targetPlayer < 1) || (lv_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return 0;
    }
    if ((lv_targetPlayer == lp_sourcePlayer) || (PlayerType(lv_targetPlayer) != c_playerTypeUser)) {
        return 0;
    }

    return lv_targetPlayer;
}

bool CMUIX_RuntimePermissionShareCommandAvailable(int lp_sourcePlayer) {
    int lv_sourceTier;
    int lv_targetPlayer;
    int lv_targetTier;

    lv_sourceTier = CMUIX_AuthRuntimeTierForPlayer(lp_sourcePlayer);
    lv_targetPlayer = CMUIX_RuntimePermissionShareTarget(lp_sourcePlayer);
    lv_targetTier = CMUIX_AuthRuntimeTierForPlayer(lv_targetPlayer);
    if ((lp_sourcePlayer < 1) || (lp_sourcePlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if (CMUIX_MapSelectionCurrentMapIsLauncher() == true) {
        return false;
    }
    if ((CMUIX_AuthTierIsValid(lv_sourceTier) == false) || (lv_targetPlayer == 0)) {
        return false;
    }
    if (CMUIX_AuthTierRank(lv_targetTier) >= CMUIX_AuthTierRank(lv_sourceTier)) {
        return false;
    }

    return true;
}

bool CMUIX_RuntimePermissionShareExecute(int lp_sourcePlayer) {
    int lv_sourceTier;
    int lv_targetPlayer;

    lv_sourceTier = CMUIX_AuthRuntimeTierForPlayer(lp_sourcePlayer);
    lv_targetPlayer = CMUIX_RuntimePermissionShareTarget(lp_sourcePlayer);
    if (CMUIX_RuntimePermissionShareCommandAvailable(lp_sourcePlayer) == false) {
        return false;
    }
    if (CMUIX_AuthShareRuntimeTier(lp_sourcePlayer, lv_targetPlayer, lv_sourceTier) == false) {
        return false;
    }

    CMUIX_RuntimePermissionShareUsed = true;
    if (CMUIX_IsControlValid(CMUIX_MainNavigationRebuildButton) == true) {
        DialogControlSetVisible(CMUIX_MainNavigationRebuildButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(CMUIX_MainNavigationRebuildButton, PlayerGroupAll(), false);
    }

    if (CMUIX_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == true) {
        CMUIX_AccessRefreshAfterPermissionChange(lv_targetPlayer);
    }
    else {
        if (CMUIX_ConsoleHooked == true) {
            CMUIX_ConsoleApplyStateForPlayer(lv_targetPlayer);
        }
    }

    UIDisplayMessage(PlayerGroupSingle(lv_targetPlayer), c_messageAreaChat, StringExternal("CMUI/Auth/Share/Received"));
    return true;
}

void CMUIX_CustomMutatorPickerSetChatStateForPlayers(playergroup lp_players, string lp_state) {
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerFullscreenUpperContainer) == true)) {
        DialogControlSetAnimationState(CMUIX_CustomMutatorPickerFullscreenUpperContainer, lp_players, "MutatorSelectionState", lp_state);
    }
}

void CMUIX_CustomMutatorPickerSetChatState(int lp_player, string lp_state) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_CustomMutatorPickerSetChatStateForPlayers(lv_players, lp_state);
}

void CMUIX_CustomMutatorPickerSetLauncherChatForAll() {
    CMUIX_CustomMutatorPickerSetChatStateForPlayers(PlayerGroupAll(), "Launcher");
}

void CMUIX_CustomMutatorPickerClearChatForAll() {
    CMUIX_CustomMutatorPickerSetChatStateForPlayers(PlayerGroupAll(), "Inactive");
}

void CMUIX_CustomMutatorPickerSetChatTakeover(int lp_player, bool lp_active) {
    string lv_state;

    lv_state = "Launcher";
    if ((lp_active == true)) {
        lv_state = "Active";
    }

    CMUIX_CustomMutatorPickerSetChatState(lp_player, lv_state);
}

void CMUIX_CustomMutatorPickerCopyAcceptedToDraft() {
    int lv_index;
    int lv_slot;

    lv_index = 0;
    lv_slot = 1;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerDraftEnhanceMarks[lv_index] = CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index];
        lv_index += 1;
    }

    CMUIX_CustomMutatorPickerDraftCount = CMUIX_CustomMutatorPickerAcceptedCount;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerDraftMutators[lv_slot] = CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot];
        CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot] = 0;
        if ((CMUIX_CustomMutatorPickerDraftEnhancedForMutator(CMUIX_CustomMutatorPickerDraftMutators[lv_slot]) == true)) {
            CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot] = 1;
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerCopyDraftToAccepted() {
    int lv_index;
    int lv_slot;

    lv_index = 0;
    lv_slot = 1;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] = CMUIX_CustomMutatorPickerDraftEnhanceMarks[lv_index];
        lv_index += 1;
    }

    CMUIX_CustomMutatorPickerAcceptedCount = CMUIX_CustomMutatorPickerDraftCount;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot] = CMUIX_CustomMutatorPickerDraftMutators[lv_slot];
        CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] = 0;
        if ((CMUIX_CustomMutatorPickerAcceptedEnhancedForMutator(CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot]) == true)) {
            CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] = 1;
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerClearRuntimeForMutator(string lp_mutator) {
    int lv_slot;

    lv_slot = 1;
    if ((lp_mutator == "")) {
        return;
    }

    UserDataSetInt("Mutators", lp_mutator, "Auto - Custom Selected Count", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Auto - Actived", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Auto - Selected By Player", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Auto - Enhanced", 1, 0);
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        UserDataSetInt("Mutators", lp_mutator, "Auto - Custom Selected Slot", lv_slot, 0);
        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerApplyDraftToUserData() {
    int lv_index;
    int lv_count;
    int lv_slot;
    int lv_selectedCount;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_slot = 1;
    lv_selectedCount = 0;
    lv_mutator = "";
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        CMUIX_CustomMutatorPickerClearRuntimeForMutator(lv_mutator);
        if ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX) && (CMUIX_CustomMutatorPickerDraftEnhanceMarks[lv_index] == 1) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
            UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, 1);
        }

        lv_index += 1;
    }

    while ((lv_slot <= CMUIX_CustomMutatorPickerDraftCount) && (lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = CMUIX_CustomMutatorPickerDraftMutators[lv_slot];
        if ((lv_mutator != "")) {
            lv_selectedCount = UserDataGetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1) + 1;
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1, lv_selectedCount);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Slot", lv_slot, 1);
            if ((CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false)) {
                UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 1);
            }
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerApplyAcceptedToUserData() {
    int lv_index;
    int lv_count;
    int lv_slot;
    int lv_selectedCount;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_slot = 1;
    lv_selectedCount = 0;
    lv_mutator = "";
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        CMUIX_CustomMutatorPickerClearRuntimeForMutator(lv_mutator);
        if ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX) && (CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] == 1) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
            UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, 1);
        }

        lv_index += 1;
    }

    while ((lv_slot <= CMUIX_CustomMutatorPickerAcceptedCount) && (lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot];
        if ((lv_mutator != "")) {
            lv_selectedCount = UserDataGetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1) + 1;
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1, lv_selectedCount);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Slot", lv_slot, 1);
            if ((CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false)) {
                UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 1);
            }
        }

        lv_slot += 1;
    }
}

void CMUIX_CustomMutatorPickerLoadAcceptedFromUserData() {
    int lv_slot;
    int lv_index;
    int lv_count;
    int lv_repeat;
    int lv_selectedCount;
    bool lv_foundSlot;
    string lv_mutator;

    lv_slot = 1;
    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_repeat = 0;
    lv_selectedCount = 0;
    lv_foundSlot = false;
    lv_mutator = "";
    CMUIX_CustomMutatorPickerAcceptedCount = 0;
    lv_index = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] = 0;
        lv_index += 1;
    }

    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot] = "";
        CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] = 0;
        lv_slot += 1;
    }

    lv_index = 1;
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true) && (UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1)) {
            CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] = 1;
        }

        lv_index += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_index = 1;
        lv_foundSlot = false;
        while ((lv_index <= lv_count) && (lv_foundSlot == false)) {
            lv_mutator = UserDataInstance("Mutators", lv_index);
            if ((UserDataGetInt("Mutators", lv_mutator, "Auto - Custom Selected Slot", lv_slot) == 1) && (CMUIX_CustomMutatorPickerSelectable(lv_mutator) == true)) {
                CMUIX_CustomMutatorPickerAcceptedCount += 1;
                CMUIX_CustomMutatorPickerAcceptedMutators[CMUIX_CustomMutatorPickerAcceptedCount] = lv_mutator;
                CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 0;
                if ((CMUIX_CustomMutatorPickerAcceptedEnhancedForMutator(lv_mutator) == true)) {
                    CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 1;
                }
                lv_foundSlot = true;
            }

            lv_index += 1;
        }

        lv_slot += 1;
    }

    if ((CMUIX_CustomMutatorPickerAcceptedCount > 0)) {
        CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
        return;
    }

    lv_index = 1;
    while ((lv_index <= lv_count) && (CMUIX_CustomMutatorPickerAcceptedCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        lv_selectedCount = UserDataGetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1);
        if ((lv_selectedCount <= 0) && (CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false) && (UserDataGetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1) == 1)) {
            lv_selectedCount = 1;
        }

        lv_repeat = 1;
        while ((lv_repeat <= lv_selectedCount) && (CMUIX_CustomMutatorPickerAcceptedCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX) && (CMUIX_CustomMutatorPickerSelectable(lv_mutator) == true)) {
            CMUIX_CustomMutatorPickerAcceptedCount += 1;
            CMUIX_CustomMutatorPickerAcceptedMutators[CMUIX_CustomMutatorPickerAcceptedCount] = lv_mutator;
            CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 0;
            if ((CMUIX_CustomMutatorPickerAcceptedEnhancedForMutator(lv_mutator) == true)) {
                CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 1;
            }
            lv_repeat += 1;
        }

        lv_index += 1;
    }

    CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
}

void CMUIX_StartupInvalidateChallengeLists() {
    int lv_type;
    int lv_slot;

    lv_type = 0;
    lv_slot = 0;
    while ((lv_type <= CMUIX_MUTATOR_CHALLENGE_TYPE_MAX)) {
        CMUIX_MutatorChallengeDefault[lv_type] = "";
        CMUIX_MutatorChallengeTypeReady[lv_type] = false;
        CMUIX_MutatorChallengeVisibleCount[lv_type] = 0;
        lv_slot = 0;
        while ((lv_slot <= libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
            CMUIX_MutatorChallengeVisibleChallenges[lv_type][lv_slot] = "";
            lv_slot += 1;
        }

        lv_type += 1;
    }
}

void CMUIX_StartupInvalidateMutatorPoolDraft() {
    CMUIX_MutatorPoolDraftReady = false;
}

void CMUIX_StartupInvalidateCachedData() {
    CMUIX_StartupDataReady = false;
    CMUIX_StartupListsReady = false;
    CMUIX_StartupInvalidateMutatorPoolDraft();
    CMUIX_StartupInvalidateChallengeLists();
}

void CMUIX_StartupInvalidateAllCachedData() {
    CMUIX_StartupInvalidateCachedData();
}

void CMUIX_StartupInitializeData() {
    if ((CMUIX_StartupDataReady == true)) {
        return;
    }

    CMUIX_DifficultyEnsureSelection();
    CMUIX_MapSelectionEnsureSelection();
    CMUIX_EnemySelectionEnsureSelection();
    CMUIX_MutatorChallengeInitializeAllTypes();
    CMUIX_MutatorChallengeEnsureSelection();
    CMUIX_MutatorPoolEnsureRuntimeDefaults();
    CMUIX_MutatorPoolEnsureDraft();
    CMUIX_CustomMutatorPickerLoadAcceptedFromUserData();
    CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_StartupDataReady = true;
}

void CMUIX_StartupRefreshControlsForPlayer(int lp_player) {
    CMUIX_MapSelectionRefreshList(lp_player);
    CMUIX_EnemySelectionRefreshList(lp_player);
    CMUIX_MutatorChallengeRefreshList(lp_player);
    CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
}

void CMUIX_StartupRefreshSelectionListsAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_humans;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_humans = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_humans, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_StartupRefreshControlsForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_StartupRefreshControlsForPlayer(1);
    }
}

void CMUIX_StartupRefreshControls() {
    if ((CMUIX_StartupListsReady == true)) {
        return;
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == false)) {
        return;
    }

    CMUIX_StartupInitializeData();
    CMUIX_DifficultyRefreshAll();
    CMUIX_SpecialDifficultyRefreshAll();
    CMUIX_MapSelectionRefreshAll();
    CMUIX_NavigationRefreshEnabled();
    CMUIX_MutatorChallengeRefreshAll();
    CMUIX_HomeRefreshAll();
    CMUIX_CustomMutatorPickerRefreshAll(0);
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_StartupRefreshSelectionListsAll();
    CMUIX_MutatorPoolRefreshAll();
    CMUIX_MutatorInfoRefreshAll();
    CMUIX_ReadyRefreshDataControlsAll();
    CMUIX_StartupListsReady = true;
}

void CMUIX_CustomMutatorPickerAddDraftMutator(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerCanAdd(lp_mutator) == false)) {
        return;
    }

    CMUIX_CustomMutatorPickerDraftCount += 1;
    CMUIX_CustomMutatorPickerDraftMutators[CMUIX_CustomMutatorPickerDraftCount] = lp_mutator;
    CMUIX_CustomMutatorPickerDraftEnhanced[CMUIX_CustomMutatorPickerDraftCount] = 0;
    if ((CMUIX_CustomMutatorPickerDraftEnhancedForMutator(lp_mutator) == true)) {
        CMUIX_CustomMutatorPickerDraftEnhanced[CMUIX_CustomMutatorPickerDraftCount] = 1;
    }
}

void CMUIX_CustomMutatorPickerRemoveDraftAt(int lp_slot) {
    int lv_slot;

    lv_slot = lp_slot;
    if ((lp_slot < 1) || (lp_slot > CMUIX_CustomMutatorPickerDraftCount)) {
        return;
    }

    while ((lv_slot < CMUIX_CustomMutatorPickerDraftCount) && (lv_slot < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerDraftMutators[lv_slot] = CMUIX_CustomMutatorPickerDraftMutators[lv_slot + 1];
        CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot] = CMUIX_CustomMutatorPickerDraftEnhanced[lv_slot + 1];
        lv_slot += 1;
    }

    CMUIX_CustomMutatorPickerDraftMutators[CMUIX_CustomMutatorPickerDraftCount] = "";
    CMUIX_CustomMutatorPickerDraftEnhanced[CMUIX_CustomMutatorPickerDraftCount] = 0;
    CMUIX_CustomMutatorPickerDraftCount -= 1;
}

void CMUIX_CustomMutatorPickerRemoveFirstDraftMutator(string lp_mutator) {
    int lv_slot;

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CustomMutatorPickerDraftCount)) {
        if ((CMUIX_CustomMutatorPickerDraftMutators[lv_slot] == lp_mutator)) {
            CMUIX_CustomMutatorPickerRemoveDraftAt(lv_slot);
            return;
        }

        lv_slot += 1;
    }
}

int CMUIX_CustomMutatorPickerViewer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return 1;
    }

    return lp_player;
}

void CMUIX_CustomMutatorPickerLoadViewerState(int lp_player) {
    int lv_index;
    int lv_player;

    lv_index = 0;
    lv_player = CMUIX_CustomMutatorPickerViewer(lp_player);
    CMUIX_CustomMutatorPickerPageIndex = CMUIX_CustomMutatorPickerPlayerPageIndex[lv_player];
    if ((CMUIX_CustomMutatorPickerPageIndex < 1)) {
        CMUIX_CustomMutatorPickerPageIndex = 1;
    }

    CMUIX_CustomMutatorPickerVisibleCount = CMUIX_CustomMutatorPickerPlayerVisibleCount[lv_player];
    CMUIX_CustomMutatorPickerSearchText = CMUIX_CustomMutatorPickerPlayerSearchText[lv_player];
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        CMUIX_CustomMutatorPickerItemMutators[lv_index] = CMUIX_CustomMutatorPickerPlayerItemMutators[lv_player][lv_index];
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerVisibleMutators[lv_index] = CMUIX_CustomMutatorPickerPlayerVisibleMutators[lv_player][lv_index];
        lv_index += 1;
    }
}

void CMUIX_CustomMutatorPickerStoreViewerState(int lp_player) {
    int lv_index;
    int lv_player;

    lv_index = 0;
    lv_player = CMUIX_CustomMutatorPickerViewer(lp_player);
    CMUIX_CustomMutatorPickerPlayerPageIndex[lv_player] = CMUIX_CustomMutatorPickerPageIndex;
    CMUIX_CustomMutatorPickerPlayerVisibleCount[lv_player] = CMUIX_CustomMutatorPickerVisibleCount;
    CMUIX_CustomMutatorPickerPlayerSearchText[lv_player] = CMUIX_CustomMutatorPickerSearchText;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        CMUIX_CustomMutatorPickerPlayerItemMutators[lv_player][lv_index] = CMUIX_CustomMutatorPickerItemMutators[lv_index];
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerPlayerVisibleMutators[lv_player][lv_index] = CMUIX_CustomMutatorPickerVisibleMutators[lv_index];
        lv_index += 1;
    }
}

void CMUIX_CustomMutatorPickerSuggestMutator(int lp_player, string lp_mutator, int lp_slot, bool lp_enhanced) {
    int lv_column;
    int lv_row;
    text lv_message;

    lv_column = 1;
    lv_row = lp_slot;
    lv_message = StringToText("");
    if ((lp_mutator == "")) {
        return;
    }

    while ((lv_row > CMUIX_CUSTOM_MUTATOR_PICKER_ROWS_PER_COLUMN)) {
        lv_row = (lv_row - CMUIX_CUSTOM_MUTATOR_PICKER_ROWS_PER_COLUMN);
        lv_column += 1;
    }

    lv_message = StringToText("[建议] 玩家 " + IntToString(lp_player) + " 建议突变因子：") + libCOMU_gf_CT_MutatorName(lp_mutator);
    if ((lp_enhanced == true)) {
        lv_message = lv_message + StringToText("（强化版）");
    }

    lv_message = lv_message + StringToText("（第 " + IntToString(CMUIX_CustomMutatorPickerPageIndex) + " 页，第 " + IntToString(lv_row) + " 行，第 " + IntToString(lv_column) + " 列）");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, lv_message);
}

void CMUIX_CustomMutatorPickerOpen(int lp_player) {
    int lv_player;
    bool lv_sendShow;

    lv_player = CMUIX_CustomMutatorPickerViewer(lp_player);
    lv_sendShow = false;
    if ((CMUIX_CustomMutatorPickerHooked == false)) {
        return;
    }

    CMUIX_StartupInitializeData();
    CMUIX_CustomMutatorPickerLoadViewerState(lv_player);
    if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == true)) {
        CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
    }

    CMUIX_CustomMutatorPickerSetChatTakeover(lp_player, true);
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSearchBox) == true)) {
        libNtve_gf_SetDialogItemEditorValue(CMUIX_CustomMutatorPickerSearchBox, CMUIX_CustomMutatorPickerSearchText, PlayerGroupSingle(lp_player));
    }

    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_sendShow = (CMUIX_CustomMutatorPickerOpenStates[lv_player] == false);
        CMUIX_CustomMutatorPickerOpenStates[lv_player] = true;
    }
    else {
        lv_sendShow = true;
    }

    if ((lv_sendShow == true) && (CMUIX_IsControlValid(CMUIX_CustomMutatorPickerFullscreen) == true)) {
        DialogControlSendAnimationEvent(CMUIX_CustomMutatorPickerFullscreen, PlayerGroupSingle(lp_player), "CMUIXShow");
    }

    CMUIX_CustomMutatorPickerRefreshAll(lp_player);
}

void CMUIX_CustomMutatorPickerClose(int lp_player) {
    int lv_player;
    bool lv_sendHide;

    lv_player = CMUIX_CustomMutatorPickerViewer(lp_player);
    lv_sendHide = false;
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_sendHide = (CMUIX_CustomMutatorPickerOpenStates[lv_player] == true);
        CMUIX_CustomMutatorPickerOpenStates[lv_player] = false;
    }
    else {
        lv_sendHide = true;
    }

    if ((lv_sendHide == true) && (CMUIX_IsControlValid(CMUIX_CustomMutatorPickerFullscreen) == true)) {
        DialogControlSendAnimationEvent(CMUIX_CustomMutatorPickerFullscreen, PlayerGroupSingle(lp_player), "CMUIXHide");
    }

    CMUIX_CustomMutatorPickerSetChatTakeover(lp_player, false);
}

bool CMUIX_ConsoleIsInteger(string lp_value) {
    int lv_index;
    int lv_length;
    string lv_character;

    lv_index = 1;
    lv_length = StringLength(lp_value);
    lv_character = "";
    if ((lv_length == 0)) {
        return false;
    }

    if ((StringSub(lp_value, 1, 1) == "-")) {
        if ((lv_length == 1)) {
            return false;
        }

        lv_index = 2;
    }

    while ((lv_index <= lv_length)) {
        lv_character = StringSub(lp_value, lv_index, lv_index);
        if ((StringFind("0123456789", lv_character, c_stringCase) == c_stringNotFound)) {
            return false;
        }

        lv_index += 1;
    }

    return true;
}

bool CMUIX_ConsoleIsFixed(string lp_value) {
    int lv_index;
    int lv_length;
    int lv_decimalCount;
    int lv_digitCount;
    string lv_character;

    lv_index = 1;
    lv_length = StringLength(lp_value);
    lv_decimalCount = 0;
    lv_digitCount = 0;
    lv_character = "";
    if ((lv_length == 0)) {
        return false;
    }

    if ((StringSub(lp_value, 1, 1) == "-")) {
        if ((lv_length == 1)) {
            return false;
        }

        lv_index = 2;
    }

    while ((lv_index <= lv_length)) {
        lv_character = StringSub(lp_value, lv_index, lv_index);
        if ((lv_character == ".")) {
            lv_decimalCount += 1;
            if ((lv_decimalCount > 1)) {
                return false;
            }
        }
        else {
            if ((StringFind("0123456789", lv_character, c_stringCase) == c_stringNotFound)) {
                return false;
            }

            lv_digitCount += 1;
        }

        lv_index += 1;
    }

    return (lv_digitCount > 0);
}

bool CMUIX_ConsoleIsColor(string lp_value) {
    int lv_index;
    int lv_length;
    int lv_partCount;
    int lv_value;
    string lv_character;
    string lv_part;

    lv_index = 1;
    lv_length = StringLength(lp_value);
    lv_partCount = 1;
    lv_value = 0;
    lv_character = "";
    lv_part = "";
    if ((lv_length == 0)) {
        return false;
    }

    while ((lv_index <= (lv_length + 1))) {
        if ((lv_index <= lv_length)) {
            lv_character = StringSub(lp_value, lv_index, lv_index);
        }
        else {
            lv_character = ",";
        }

        if ((lv_character == ",")) {
            if ((CMUIX_ConsoleIsInteger(lv_part) == false)) {
                return false;
            }

            lv_value = StringToInt(lv_part);
            if ((lv_value < 0) || (lv_value > 255)) {
                return false;
            }

            lv_part = "";
            lv_partCount += 1;
        }
        else {
            lv_part = lv_part + lv_character;
        }

        lv_index += 1;
    }

    return (lv_partCount == 4);
}

string CMUIX_ConsoleArgumentValue(int lp_argument, string lp_arg1, string lp_arg2, string lp_arg3) {
    if ((lp_argument == 1)) {
        return lp_arg1;
    }

    if ((lp_argument == 2)) {
        return lp_arg2;
    }

    return lp_arg3;
}

bool CMUIX_ConsoleValidateArgument(int lp_index, int lp_argument, string lp_value) {
    int lv_kind;
    string lv_command;

    lv_kind = CMUIX_ConsoleArgumentKinds[lp_argument][lp_index];
    lv_command = CMUIX_ConsoleCommands[lp_index];
    if ((lp_value == "")) {
        return CMUIX_ConsoleArgumentAllowEmpty[lp_argument][lp_index];
    }

    if ((StringLength(lp_value) > 256) && (lv_command != "-Profile") && (lv_command != "-profile")) {
        return false;
    }

    if ((StringLength(lp_value) > 2048)) {
        return false;
    }

    if ((lv_command != "-actorsend") && (lv_command != "-Profile") && (lv_command != "-profile")) {
        if ((StringFind(lp_value, " ", c_stringCase) != c_stringNotFound)) {
            return false;
        }
    }

    if ((lv_kind == CMUIX_CONSOLE_ARGUMENT_INTEGER)) {
        return CMUIX_ConsoleIsInteger(lp_value);
    }

    if ((lv_kind == CMUIX_CONSOLE_ARGUMENT_FIXED)) {
        return CMUIX_ConsoleIsFixed(lp_value);
    }

    if ((lv_kind == CMUIX_CONSOLE_ARGUMENT_COLOR)) {
        return CMUIX_ConsoleIsColor(lp_value);
    }

    if ((lv_kind == CMUIX_CONSOLE_ARGUMENT_PLAYER)) {
        if ((CMUIX_ConsoleIsInteger(lp_value) == false)) {
            return false;
        }

        return ((StringToInt(lp_value) >= 0) && (StringToInt(lp_value) <= c_maxPlayers));
    }

    if ((lv_kind == CMUIX_CONSOLE_ARGUMENT_NUMBER_OR_KEYWORD)) {
        if ((lv_command == "-log")) {
            if ((lp_value == "clear")) {
                return true;
            }

            return ((CMUIX_ConsoleIsInteger(lp_value) == true) && (StringToInt(lp_value) >= 1) && (StringToInt(lp_value) <= c_maxPlayers));
        }

        if ((lv_command == "-mm")) {
            if ((lp_value == "clear")) {
                return true;
            }

            return ((CMUIX_ConsoleIsFixed(lp_value) == true) && (StringToFixed(lp_value) > 0.0));
        }

        if ((lv_command == "-voidrift")) {
            if ((lp_value == "clear")) {
                return true;
            }

            return ((CMUIX_ConsoleIsFixed(lp_value) == true) && (StringToFixed(lp_value) >= 1.0) && (StringToFixed(lp_value) <= 30.0));
        }
    }

    if ((lv_command == "-speed")) {
        return ((lp_value == "slower") || (lp_value == "slow") || (lp_value == "normal") || (lp_value == "fast") || (lp_value == "faster"));
    }

    if ((lv_command == "-screenmode")) {
        return ((lp_value == "full") || (lp_value == "normal") || (lp_value == "letter"));
    }

    if ((lv_command == "-cinmode")) {
        return ((lp_value == "0") || (lp_value == "1"));
    }

    if ((lv_command == "-alarakcdr")) {
        return ((CMUIX_ConsoleIsFixed(lp_value) == true) && (StringToFixed(lp_value) >= 15.0));
    }

    if ((lv_command == "-diff")) {
        return ((lp_value == "casual") || (lp_value == "normal") || (lp_value == "hard") || (lp_value == "brutal") || (lp_value == "extreme") || (lp_value == "unlikely"));
    }

    if ((lv_command == "-TargetSpawners")) {
        return ((lp_value == "on") || (lp_value == "off") || (lp_value == "random"));
    }

    if ((lv_command == "-cam")) {
        return ((lp_value == "reset") || (lp_value == "top"));
    }

    if ((lv_command == "-airbeh/-groundbeh")) {
        return ((lp_value == "air") || (lp_value == "ground"));
    }

    if ((lv_command == "-spawn") && (lp_argument == 1)) {
        return CatalogEntryIsValid(c_gameCatalogUnit, lp_value);
    }

    if ((lv_command == "-spawn") && (lp_argument == 2)) {
        return ((CMUIX_ConsoleIsInteger(lp_value) == true) && (StringToInt(lp_value) > 0));
    }

    if ((lv_command == "-replace") && (lp_argument == 1)) {
        return CatalogEntryIsValid(c_gameCatalogUnit, lp_value);
    }

    if ((lv_command == "-behavior") && (lp_argument == 1)) {
        return CatalogEntryIsValid(c_gameCatalogBehavior, lp_value);
    }

    if ((lv_command == "-skin") && (lp_argument == 1)) {
        return CatalogEntryIsValid(c_gameCatalogSkin, lp_value);
    }

    if ((lv_command == "-hotkey") && (lp_argument == 1)) {
        return CatalogEntryIsValid(c_gameCatalogButton, lp_value);
    }

    if ((lv_command == "-supply") && (lp_argument == 1)) {
        return ((CMUIX_ConsoleIsInteger(lp_value) == true) && (StringToInt(lp_value) >= 0) && (StringToInt(lp_value) <= 200));
    }

    return true;
}

bool CMUIX_ConsoleValidate(int lp_index, int lp_player, string lp_arg1, string lp_arg2, string lp_arg3) {
    int lv_argument;
    bool lv_emptyFound;
    string lv_value;

    lv_argument = 1;
    lv_emptyFound = false;
    lv_value = "";
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return false;
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_ConsoleCommandVisibleForPlayer(lp_index, lp_player) == false)) {
        return false;
    }

    if ((CMUIX_ConsoleDisplayOnlyCommands[lp_index] == true)) {
        return false;
    }

    while ((lv_argument <= CMUIX_ConsoleArgumentCounts[lp_index])) {
        lv_value = CMUIX_ConsoleArgumentValue(lv_argument, lp_arg1, lp_arg2, lp_arg3);
        if ((lv_value == "")) {
            lv_emptyFound = true;
        }
        else {
            if ((lv_emptyFound == true)) {
                return false;
            }
        }

        if ((CMUIX_ConsoleValidateArgument(lp_index, lv_argument, lv_value) == false)) {
            return false;
        }

        lv_argument += 1;
    }

    return true;
}

string CMUIX_ConsoleBuildMessage(int lp_index, string lp_arg1, string lp_arg2, string lp_arg3) {
    int lv_argument;
    string lv_message;
    string lv_value;

    lv_argument = 1;
    lv_message = CMUIX_ConsoleCommands[lp_index];
    lv_value = "";
    while ((lv_argument <= CMUIX_ConsoleArgumentCounts[lp_index])) {
        lv_value = CMUIX_ConsoleArgumentValue(lv_argument, lp_arg1, lp_arg2, lp_arg3);
        if ((lv_value != "")) {
            lv_message = lv_message + " " + lv_value;
        }

        lv_argument += 1;
    }

    return lv_message;
}

string CMUIX_ConsoleCommandKeySuffix(int lp_index) {
    if ((lp_index < 10)) {
        return "00" + IntToString(lp_index);
    }

    if ((lp_index < 100)) {
        return "0" + IntToString(lp_index);
    }

    return IntToString(lp_index);
}

string CMUIX_ConsoleCommandUserDataInstance(int lp_index) {
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return "";
    }
    if ((lp_index > 154)) {
        return "";
    }

    return "Command" + CMUIX_ConsoleCommandKeySuffix(lp_index);
}

text CMUIX_ConsoleCommandUserDataText(int lp_index, string lp_field, string lp_fallbackKey) {
    string lv_instance;

    lv_instance = CMUIX_ConsoleCommandUserDataInstance(lp_index);
    if ((lv_instance == "")) {
        return StringExternal(lp_fallbackKey);
    }

    return UserDataGetText(CMUIX_CONSOLE_USERDATA_TYPE, lv_instance, lp_field, 1);
}

bool CMUIX_ConsoleCommandOptionOnly(int lp_index) {
    string lv_command;

    lv_command = "";
    if ((lp_index < 1) || (lp_index > CMUIX_CONSOLE_COMMAND_MAX)) {
        return false;
    }

    lv_command = CMUIX_ConsoleCommands[lp_index];
    if ((StringEqual(lv_command, "-autocreep", c_stringNoCase) == true) || (StringEqual(lv_command, "-biomasscount", c_stringNoCase) == true) || (StringEqual(lv_command, "-kerrigantopbar", c_stringNoCase) == true) || (StringEqual(lv_command, "-productionpanel", c_stringNoCase) == true) || (StringEqual(lv_command, "-warpbutton", c_stringNoCase) == true)) {
        return true;
    }

    return false;
}

string CMUIX_ConsoleCommandDisplayString(int lp_index) {
    string lv_instance;
    string lv_command;

    lv_instance = CMUIX_ConsoleCommandUserDataInstance(lp_index);
    lv_command = "";
    if ((lv_instance != "")) {
        lv_command = UserDataGetString(CMUIX_CONSOLE_USERDATA_TYPE, lv_instance, "Command", 1);
    }

    if ((lv_command == "") && (lp_index >= 1) && (lp_index <= CMUIX_ConsoleCommandCount)) {
        return CMUIX_ConsoleCommands[lp_index];
    }

    return lv_command;
}

string CMUIX_ConsoleCommandResultKey(int lp_index) {
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return "CMUI/Console/Result/Applied";
    }

    return "CMUI/Console/Command/" + CMUIX_ConsoleCommandKeySuffix(lp_index) + "/Result";
}

text CMUIX_ConsoleColorText(text lp_text, string lp_color) {
    return StringToText("<c val=\"" + lp_color + "\">") + lp_text + StringToText("</c>");
}

text CMUIX_ConsoleDescriptionText(int lp_index) {
    if ((lp_index >= 1) && (lp_index <= CMUIX_ConsoleCommandCount) && (CMUIX_ConsoleDescriptionKeys[lp_index] != "")) {
        return CMUIX_ConsoleCommandUserDataText(lp_index, "Description", CMUIX_ConsoleDescriptionKeys[lp_index]);
    }

    return StringExternal("CMUI/Console/DescriptionUnavailable");
}

string CMUIX_ConsoleCommandResultVariantKey(int lp_index, string lp_variant) {
    if ((lp_index < 1) || (lp_index > CMUIX_ConsoleCommandCount)) {
        return "CMUI/Console/Result/Applied";
    }

    return "CMUI/Console/Command/" + CMUIX_ConsoleCommandKeySuffix(lp_index) + "/" + lp_variant;
}

bool CMUIX_ConsoleCommandToggleStateKnown(int lp_index) {
