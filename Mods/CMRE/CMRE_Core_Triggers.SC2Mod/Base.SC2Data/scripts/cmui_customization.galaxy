text CMUIX_HistoryMutatorTokenText(string lp_token) {
    string lv_token;
    int lv_length;
    bool lv_enhanced;
    text lv_result;

    lv_token = StringReplaceWord(lp_token, " ", "", c_stringReplaceAll, c_stringNoCase);
    lv_length = StringLength(lv_token);
    lv_enhanced = false;
    lv_result = StringToText("");
    if ((lv_token == "") || (lv_token == null)) {
        return lv_result;
    }

    if ((lv_length >= 2) && (StringSub(lv_token, lv_length, lv_length) == "+")) {
        lv_enhanced = true;
        lv_token = StringSub(lv_token, 1, (lv_length - 1));
    }

    if ((CMUIX_HistoryMutatorInstanceExists(lv_token) == true)) {
        lv_result = libCOMU_gf_CT_MutatorName(lv_token);
    }
    else {
        lv_result = StringToText(lv_token);
    }

    if ((lv_enhanced == true)) {
        lv_result = lv_result + StringToText("+");
    }

    return lv_result;
}

text CMUIX_HistoryMutatorsTextFromBody(string lp_body) {
    string lv_remaining;
    string lv_token;
    string lv_mutators;
    int lv_separator;
    text lv_tokenText;
    text lv_result;

    lv_remaining = CMUIX_HistoryMutatorsValueFromBody(lp_body);
    lv_token = "";
    lv_mutators = "";
    lv_separator = 0;
    lv_tokenText = StringToText("");
    lv_result = StringToText("");
    if ((lv_remaining == "") || (lv_remaining == null) || (lv_remaining == "-")) {
        return lv_result;
    }

    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_tokenText = CMUIX_HistoryMutatorTokenText(lv_token);
        if ((TextToString(lv_tokenText) != "")) {
            if ((TextToString(lv_result) != "")) {
                lv_result = lv_result + StringToText(", ");
            }

            lv_result = lv_result + lv_tokenText;
        }
    }

    return lv_result;
}

string CMUIX_HistoryMutatorTokenBase(string lp_token) {
    string lv_token;
    int lv_length;

    lv_token = StringReplaceWord(lp_token, " ", "", c_stringReplaceAll, c_stringNoCase);
    lv_length = StringLength(lv_token);
    if ((lv_token == "") || (lv_token == null)) {
        return "";
    }

    if ((lv_length >= 2) && (StringSub(lv_token, lv_length, lv_length) == "+")) {
        return StringSub(lv_token, 1, (lv_length - 1));
    }

    return lv_token;
}

bool CMUIX_HistoryMutatorTokenEnhanced(string lp_token) {
    string lv_token;
    int lv_length;

    lv_token = StringReplaceWord(lp_token, " ", "", c_stringReplaceAll, c_stringNoCase);
    lv_length = StringLength(lv_token);
    if ((lv_token == "") || (lv_token == null)) {
        return false;
    }

    if ((lv_length >= 2) && (StringSub(lv_token, lv_length, lv_length) == "+")) {
        return true;
    }

    return false;
}

void CMUIX_HistoryClearMutatorDetails(playergroup lp_players) {
    int lv_slot;

    lv_slot = 0;
    CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorEmptyLabel, lp_players, true);
    CMUIX_SetControlText(CMUIX_HistoryDetailMutatorEmptyLabel, lp_players, StringExternal("CMUI/ScreenHistory/Details/Unset"));
    while ((lv_slot < CMUIX_HISTORY_DETAIL_MUTATOR_MAX)) {
        CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorItems[lv_slot], lp_players, false);
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorTitleLabels[lv_slot], lp_players, StringToText(""));
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorDescriptionLabels[lv_slot], lp_players, StringToText(""));
        if ((CMUIX_IsControlValid(CMUIX_HistoryDetailMutatorIconBoxes[lv_slot]) == true)) {
            DialogControlSetAnimationState(CMUIX_HistoryDetailMutatorIconBoxes[lv_slot], lp_players, "SourceState", "Official");
        }

        lv_slot += 1;
    }
}

void CMUIX_HistorySetMutatorDetailItem(int lp_slot, string lp_mutator, bool lp_enhanced, playergroup lp_players) {
    bool lv_exists;

    lv_exists = CMUIX_HistoryMutatorInstanceExists(lp_mutator);
    if ((lp_slot < 0) || (lp_slot >= CMUIX_HISTORY_DETAIL_MUTATOR_MAX) || (lp_mutator == "") || (lp_mutator == null)) {
        return;
    }

    if ((lv_exists == true)) {
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorTitleLabels[lp_slot], lp_players, libCOMU_gf_CT_MutatorName(lp_mutator));
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorDescriptionLabels[lp_slot], lp_players, CMUIX_MutatorChallengeMutatorDescription(lp_mutator, lp_enhanced));
        CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorIconBoxes[lp_slot], lp_players, true);
        if ((CMUIX_IsControlValid(CMUIX_HistoryDetailMutatorIconBoxes[lp_slot]) == true)) {
            DialogControlSetAnimationState(CMUIX_HistoryDetailMutatorIconBoxes[lp_slot], lp_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lp_mutator, lp_enhanced));
        }

        if ((CMUIX_IsControlValid(CMUIX_HistoryDetailMutatorIcons[lp_slot]) == true)) {
            libNtve_gf_SetDialogItemImage(CMUIX_HistoryDetailMutatorIcons[lp_slot], libCOMU_gf_CT_MutatorIcon(lp_mutator), lp_players);
        }
    }
    else {
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorTitleLabels[lp_slot], lp_players, StringToText(lp_mutator));
        CMUIX_SetControlText(CMUIX_HistoryDetailMutatorDescriptionLabels[lp_slot], lp_players, StringToText(""));
        CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorIconBoxes[lp_slot], lp_players, false);
    }

    CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorItems[lp_slot], lp_players, true);
}

void CMUIX_HistoryRefreshMutatorDetailsFromBody(int lp_player, string lp_body) {
    playergroup lv_players;
    string lv_remaining;
    string lv_token;
    string lv_mutator;
    int lv_separator;
    int lv_slot;
    bool lv_enhanced;

    lv_players = PlayerGroupSingle(lp_player);
    lv_remaining = CMUIX_HistoryMutatorsValueFromBody(lp_body);
    lv_token = "";
    lv_mutator = "";
    lv_separator = 0;
    lv_slot = 0;
    lv_enhanced = false;
    CMUIX_HistoryClearMutatorDetails(lv_players);
    if ((lv_remaining == "") || (lv_remaining == null) || (lv_remaining == "-")) {
        return;
    }

    while ((lv_remaining != "") && (lv_remaining != null) && (lv_slot < CMUIX_HISTORY_DETAIL_MUTATOR_MAX)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_mutator = CMUIX_HistoryMutatorTokenBase(lv_token);
        if ((lv_mutator != "") && (lv_mutator != null)) {
            lv_enhanced = CMUIX_HistoryMutatorTokenEnhanced(lv_token);
            CMUIX_SetControlVisible(CMUIX_HistoryDetailMutatorEmptyLabel, lv_players, false);
            CMUIX_HistorySetMutatorDetailItem(lv_slot, lv_mutator, lv_enhanced, lv_players);
            lv_slot += 1;
        }
    }
}

text CMUIX_HistoryRatingTextFromBody(string lp_body) {
    string lv_base;
    string lv_plus;

    lv_base = CMUIX_ProfileConfigValue(lp_body, "base");
    lv_plus = CMUIX_ProfileConfigValue(lp_body, "plus");
    if ((lv_base == "")) {
        lv_base = CMUIX_ProfileConfigValue(lp_body, "difficulty");
    }

    if ((lv_base == "")) {
        lv_base = CMUIX_ProfileConfigValue(lp_body, "difficultyBase");
    }

    if ((lv_plus == "")) {
        lv_plus = CMUIX_ProfileConfigValue(lp_body, "difficultyPlus");
    }

    if ((lv_base == "")) {
        return StringToText("");
    }

    if ((lv_plus == "")) {
        lv_plus = "0";
    }

    return CMUIX_DifficultyRatingText(StringToInt(lv_base), StringToInt(lv_plus));
}

text CMUIX_HistoryNoteTextFromBody(string lp_body) {
    string lv_note;

    lv_note = CMUIX_ProfileConfigValue(lp_body, "note");
    if ((lv_note == "")) {
        lv_note = CMUIX_ProfileConfigValue(lp_body, "remarks");
    }

    if ((lv_note == "")) {
        lv_note = CMUIX_ProfileConfigValue(lp_body, "comment");
    }

    if ((lv_note == "") || (lv_note == null)) {
        return StringToText("");
    }

    return StringToText(lv_note);
}

text CMUIX_HistoryConfigTextFromBody(string lp_body) {
    string lv_base;
    string lv_plus;
    string lv_mastery;
    string lv_mutators;
    text lv_result;
    bool lv_hasLine;

    lv_base = CMUIX_ProfileConfigValue(lp_body, "base");
    lv_plus = CMUIX_ProfileConfigValue(lp_body, "plus");
    lv_mastery = CMUIX_ProfileConfigValue(lp_body, "mastery");
    lv_mutators = CMUIX_HistoryMutatorsValueFromBody(lp_body);
    lv_result = StringExternal("CMUI/ScreenHistory/Details/Unset");
    lv_hasLine = false;
    if ((lv_base == "")) {
        lv_base = CMUIX_ProfileConfigValue(lp_body, "difficulty");
    }

    if ((lv_mastery == "")) {
        lv_mastery = CMUIX_ProfileConfigValue(lp_body, "masterycap");
    }

    if ((lv_base != "")) {
        if ((lv_plus == "")) {
            lv_plus = "0";
        }

        lv_result = CMUIX_DifficultyRatingText(StringToInt(lv_base), StringToInt(lv_plus));
        lv_hasLine = true;
    }

    if ((lv_mastery != "")) {
        if ((lv_hasLine == false)) {
            lv_result = StringExternal("CMUI/ScreenHistory/Config/MasteryCap") + StringToText(lv_mastery);
        }
        else {
            lv_result = lv_result + StringToText("<n/>") + StringExternal("CMUI/ScreenHistory/Config/MasteryCap") + StringToText(lv_mastery);
        }

        lv_hasLine = true;
    }

    if ((lv_mutators != "-")) {
        if ((lv_hasLine == false)) {
            lv_result = StringExternal("CMUI/ScreenHistory/Config/Mutators") + StringToText(lv_mutators);
        }
        else {
            lv_result = lv_result + StringToText("<n/>") + StringExternal("CMUI/ScreenHistory/Config/Mutators") + StringToText(lv_mutators);
        }

        lv_hasLine = true;
    }

    return lv_result;
}

string CMUIX_HistoryObjectiveTokenField(string lp_token, int lp_field) {
    int lv_index;
    int lv_separator;
    string lv_remaining;

    lv_index = 1;
    lv_separator = 0;
    lv_remaining = lp_token;
    if ((lp_token == "") || (lp_token == null) || (lp_field <= 0)) {
        return "";
    }

    while ((lv_index <= lp_field)) {
        lv_separator = StringFind(lv_remaining, "|", c_stringCase);
        if ((lv_index == lp_field)) {
            if ((lv_separator < 0)) {
                return lv_remaining;
            }

            if ((lv_separator <= 1)) {
                return "";
            }

            return StringSub(lv_remaining, 1, (lv_separator - 1));
        }

        if ((lv_separator < 0)) {
            return "";
        }

        if ((lv_separator >= StringLength(lv_remaining))) {
            return "";
        }

        lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
        lv_index += 1;
    }

    return "";
}

text CMUIX_HistoryObjectiveNameText(string lp_objective) {
    text lv_name;

    lv_name = StringToText("");
    if ((lp_objective == "") || (lp_objective == null)) {
        return StringExternal("CMUI/ScreenHistory/Details/Unset");
    }

    lv_name = libCOOC_gf_CoopMissionObjectiveName(lp_objective);
    if ((TextToString(lv_name) != "")) {
        return lv_name;
    }

    return StringToText(lp_objective);
}

text CMUIX_HistoryObjectiveTypeText(string lp_primary) {
    if ((StringEqual(lp_primary, "1", c_stringNoCase) == true)) {
        return StringExternal("CMUI/ScreenHistory/Objective/Primary");
    }

    return StringExternal("CMUI/ScreenHistory/Objective/Bonus");
}

text CMUIX_HistoryObjectiveStateText(int lp_state) {
    if ((lp_state == libCOOC_ge_MissionObjectiveState_Completed)) {
        return StringExternal("CMUI/ScreenHistory/Objective/Completed");
    }

    if ((lp_state == libCOOC_ge_MissionObjectiveState_Failed)) {
        return StringExternal("CMUI/ScreenHistory/Objective/Failed");
    }

    if ((lp_state == libCOOC_ge_MissionObjectiveState_Undiscovered)) {
        return StringExternal("CMUI/ScreenHistory/Objective/Undiscovered");
    }

    return StringExternal("CMUI/ScreenHistory/Objective/InProgress");
}

text CMUIX_HistoryObjectiveSnapshotLineText(string lp_entry) {
    string lv_objective;
    string lv_progress;
    string lv_required;
    string lv_state;
    string lv_primary;
    text lv_result;

    lv_objective = CMUIX_HistoryObjectiveTokenField(lp_entry, 1);
    lv_progress = CMUIX_HistoryObjectiveTokenField(lp_entry, 2);
    lv_required = CMUIX_HistoryObjectiveTokenField(lp_entry, 3);
    lv_state = CMUIX_HistoryObjectiveTokenField(lp_entry, 4);
    lv_primary = CMUIX_HistoryObjectiveTokenField(lp_entry, 5);
    lv_result = StringToText("");
    if ((lv_objective == "")) {
        return lv_result;
    }

    lv_result = CMUIX_HistoryObjectiveTypeText(lv_primary) + StringToText(": ") + CMUIX_HistoryObjectiveNameText(lv_objective);
    if ((StringToInt(lv_required) > 0)) {
        lv_result = lv_result + StringToText(" ") + StringToText(lv_progress + "/" + lv_required);
    }

    lv_result = lv_result + StringToText(" (") + CMUIX_HistoryObjectiveStateText(StringToInt(lv_state)) + StringToText(")");
    return lv_result;
}

text CMUIX_HistoryObjectiveSnapshotTextFromBody(string lp_body) {
    int lv_index;
    int lv_count;
    string lv_entry;
    text lv_line;
    text lv_result;
    bool lv_hasLine;

    lv_index = 1;
    lv_count = StringToInt(CMUIX_ProfileConfigValue(lp_body, "objectiveCount"));
    lv_entry = "";
    lv_line = StringToText("");
    lv_result = StringToText("");
    lv_hasLine = false;
    if ((lv_count <= 0)) {
        return lv_result;
    }

    while ((lv_index <= lv_count) && (lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
        lv_entry = CMUIX_ProfileConfigValue(lp_body, ("objective" + IntToString(lv_index)));
        lv_line = CMUIX_HistoryObjectiveSnapshotLineText(lv_entry);
        if ((TextToString(lv_line) != "")) {
            if ((lv_hasLine == false)) {
                lv_result = StringExternal("CMUI/ScreenHistory/Details/Objectives") + StringToText("<n/>") + lv_line;
                lv_hasLine = true;
            }
            else {
                lv_result = lv_result + StringToText("<n/>") + lv_line;
            }
        }

        lv_index += 1;
    }

    return lv_result;
}

text CMUIX_HistoryCompatibilityText(int lp_player, string lp_body) {
    string lv_requestedMapRaw;

    lv_requestedMapRaw = CMUIX_ProfileConfigValue(lp_body, "mission");
    if ((lv_requestedMapRaw == "")) {
        lv_requestedMapRaw = CMUIX_ProfileConfigValue(lp_body, "map");
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        return StringExternal("CMUI/ScreenHistory/Compatibility/LauncherOnly");
    }

    if ((CMUIX_ReadyCanEditData(lp_player) == false)) {
        return StringExternal("CMUI/ScreenHistory/Compatibility/BeforeGameOnly");
    }

    if ((lv_requestedMapRaw == "") || (lv_requestedMapRaw == null)) {
        return StringExternal("CMUI/ScreenHistory/Compatibility/Ready");
    }

    if ((CMUIX_ProfileRequestedMapUsableForSharedSetup(lp_body) == false)) {
        return StringExternal("CMUI/ScreenHistory/Compatibility/InvalidMap");
    }

    return StringExternal("CMUI/ScreenHistory/Compatibility/Ready");
}

void CMUIX_HistorySetProfileCode(int lp_player, string lp_payload) {
    string lv_payload;

    lv_payload = lp_payload;
    if ((lv_payload == null)) {
        lv_payload = "";
    }

    if ((CMUIX_IsControlValid(CMUIX_HistoryProfileCodeEditBox) == true)) {
        libNtve_gf_SetDialogItemEditorValue(CMUIX_HistoryProfileCodeEditBox, lv_payload, PlayerGroupSingle(lp_player));
    }
}

void CMUIX_HistoryShowNewProfilePopup(int lp_player, bool lp_visible) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_SetControlVisible(CMUIX_HistoryNewProfilePopup, lv_players, lp_visible);
    if ((lp_visible == true)) {
        CMUIX_SetControlVisible(CMUIX_HistorySaveRecordTemplatePopup, lv_players, false);
        if ((CMUIX_IsControlValid(CMUIX_HistoryNewProfileCodeEditBox) == true)) {
            libNtve_gf_SetDialogItemEditorValue(CMUIX_HistoryNewProfileCodeEditBox, "", lv_players);
        }

        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusIdle"));
    }
}

void CMUIX_HistoryShowSaveRecordTemplatePopup(int lp_player, bool lp_visible) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_SetControlVisible(CMUIX_HistorySaveRecordTemplatePopup, lv_players, lp_visible);
    if ((lp_visible == true)) {
        CMUIX_SetControlVisible(CMUIX_HistoryNewProfilePopup, lv_players, false);
        if ((CMUIX_IsControlValid(CMUIX_HistorySaveRecordTemplateNameEditBox) == true)) {
            libNtve_gf_SetDialogItemEditorValue(CMUIX_HistorySaveRecordTemplateNameEditBox, "", lv_players);
        }

        CMUIX_SetControlText(CMUIX_HistorySaveRecordTemplateStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/SaveRecordTemplate/StatusIdle"));
    }
}

string CMUIX_HistoryPayloadFromInputCode(string lp_code) {
    string lv_word;

    lv_word = StringWord(lp_code, 1);
    if ((StringEqual(lv_word, CMUIX_PROFILE_COMMAND_CANONICAL, c_stringNoCase) == true) ||
        (StringEqual(lv_word, CMUIX_PROFILE_COMMAND_LOWER, c_stringNoCase) == true)) {
        return CMUIX_ProfileCommandPayload(lp_code);
    }

    return lp_code;
}

bool CMUIX_HistoryImportProfileTemplateFromControl(int lp_player) {
    playergroup lv_players;
    string lv_input;
    string lv_payload;
    string lv_body;
    string lv_name;

    lv_players = PlayerGroupSingle(lp_player);
    lv_input = "";
    lv_payload = "";
    lv_body = "";
    lv_name = "";
    if ((CMUIX_IsControlValid(CMUIX_HistoryNewProfileCodeEditBox) == false)) {
        return false;
    }

    lv_input = libNtve_gf_DialogItemEditValue(CMUIX_HistoryNewProfileCodeEditBox, lp_player);
    lv_payload = CMUIX_HistoryPayloadFromInputCode(lv_input);
    if ((lv_payload == "") || (lv_payload == null)) {
        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusEmpty"));
        return false;
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lv_payload);
    if ((lv_payload == "")) {
        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusInvalid"));
        return false;
    }

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
    if ((lv_body == "")) {
        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusInvalid"));
        return false;
    }

    lv_name = CMUIX_HistoryNameValueFromBody(lv_body);
    CMUIX_ProfileTemplateRecord(lp_player, lv_name, lv_payload, "Imported");
    if ((CMUIX_HistoryProfileTemplateKeyExists(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]) == false)) {
        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusInvalid"));
        return false;
    }

    CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusImported"));
    if ((CMUIX_HistoryLastProfileTemplateCreated == false)) {
        CMUIX_SetControlText(CMUIX_HistoryNewProfileStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/NewProfile/StatusDuplicate"));
    }

    return true;
}

int CMUIX_HistoryRecordCount(int lp_player) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    int lv_count;
    string lv_key;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_count = 0;
    lv_key = "";
    if ((lv_bank == null)) {
        return 0;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    while ((lv_index < lv_nextIndex)) {
        lv_key = CMUIX_HistoryRecordKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lv_key) == true)) {
            lv_count += 1;
        }

        lv_index += 1;
    }

    return lv_count;
}

bool CMUIX_HistoryRecordKeyExists(int lp_player, string lp_key) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return false;
    }

    return BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lp_key);
}

int CMUIX_HistoryProfileTemplateCount(int lp_player) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    int lv_count;
    string lv_key;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_count = 0;
    lv_key = "";
    if ((lv_bank == null)) {
        return 0;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", 1);
    while ((lv_index < lv_nextIndex)) {
        lv_key = CMUIX_HistoryProfileTemplateKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload")) == true)) {
            lv_count += 1;
        }

        lv_index += 1;
    }

    return lv_count;
}

bool CMUIX_HistoryProfileTemplateKeyExists(int lp_player, string lp_key) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return false;
    }

    return BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload"));
}

bool CMUIX_HistoryPlayerTwoShouldSuggest(int lp_player) {
    if ((lp_player == 2) && (PlayerStatus(1) == c_playerStatusActive)) {
        return true;
    }

    return false;
}

string CMUIX_HistorySelectedApplyPayloadForPlayer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return "";
    }

    if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
        return CMUIX_HistoryProfilePayloadForKey(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
    }

    return CMUIX_HistoryRecordPayloadForKey(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
}

string CMUIX_HistoryApplyBlockReasonKeyForPayload(int lp_player, string lp_payload) {
    string lv_payload;
    string lv_body;
    string lv_requestedMapRaw;
    int lv_integrity;

    lv_payload = "";
    lv_body = "";
    lv_requestedMapRaw = "";
    lv_integrity = CMUIX_HISTORY_INTEGRITY_VALID;
    if ((lp_payload == "") || (lp_payload == null)) {
        return "CMUI/ScreenHistory/Compatibility/NoSelection";
    }

    if ((CMUIX_HistoryPlayerTwoShouldSuggest(lp_player) == true)) {
        return "CMUI/ScreenHistory/Compatibility/PlayerTwoSuggestOnly";
    }

    if ((CMUIX_HistoryViewingProfiles[lp_player] == false)) {
        lv_integrity = CMUIX_HistoryRecordIntegrityForPayload(lp_payload);
        if ((lv_integrity != CMUIX_HISTORY_INTEGRITY_VALID)) {
            return "CMUI/ScreenHistory/Compatibility/InvalidProfile";
        }
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lp_payload);
    if ((lv_payload == "")) {
        return "CMUI/ScreenHistory/Compatibility/InvalidProfile";
    }

    lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
    if ((lv_body == "")) {
        return "CMUI/ScreenHistory/Compatibility/InvalidProfile";
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        return "CMUI/ScreenHistory/Compatibility/LauncherOnly";
    }

    if ((CMUIX_ReadyCanEditData(lp_player) == false)) {
        return "CMUI/ScreenHistory/Compatibility/BeforeGameOnly";
    }

    lv_requestedMapRaw = CMUIX_ProfileConfigValue(lv_body, "mission");
    if ((lv_requestedMapRaw == "")) {
        lv_requestedMapRaw = CMUIX_ProfileConfigValue(lv_body, "map");
    }

    if ((lv_requestedMapRaw == "") || (lv_requestedMapRaw == null)) {
        return "";
    }

    if ((CMUIX_ProfileRequestedMapUsableForSharedSetup(lv_body) == false)) {
        return "CMUI/ScreenHistory/Compatibility/InvalidMap";
    }

    return "";
}

bool CMUIX_HistoryCanApplyPayloadForPlayer(int lp_player, string lp_payload) {
    return (CMUIX_HistoryApplyBlockReasonKeyForPayload(lp_player, lp_payload) == "");
}

text CMUIX_HistoryApplyTooltipForPayload(int lp_player, string lp_payload) {
    string lv_reason;

    lv_reason = CMUIX_HistoryApplyBlockReasonKeyForPayload(lp_player, lp_payload);
    if ((lv_reason == "")) {
        return StringToText("");
    }

    return StringExternal(lv_reason);
}

bool CMUIX_HistoryCanApplyForPlayer(int lp_player) {
    return CMUIX_HistoryCanApplyPayloadForPlayer(lp_player, CMUIX_HistorySelectedApplyPayloadForPlayer(lp_player));
}

bool CMUIX_HistorySuggestionPendingForPlayer(int lp_player) {
    if ((lp_player == 1) && (CMUIX_HistorySuggestedTemplatePayload != "") && (CMUIX_HistorySuggestedTemplatePlayer == 2)) {
        return true;
    }

    return false;
}

int CMUIX_HistoryOrdinalPage(int lp_ordinal) {
    if ((lp_ordinal <= 0)) {
        return 1;
    }

    return (((lp_ordinal - 1) / CMUIX_HISTORY_ROW_MAX) + 1);
}

int CMUIX_HistoryOrdinalSlot(int lp_ordinal) {
    if ((lp_ordinal <= 0)) {
        return 1;
    }

    return (((lp_ordinal - 1) % CMUIX_HISTORY_ROW_MAX) + 1);
}

int CMUIX_HistoryProfileTemplateOrdinalForKey(int lp_player, string lp_key) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    int lv_ordinal;
    string lv_key;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_ordinal = 0;
    lv_key = "";
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return 0;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", 1);
    lv_index = (lv_nextIndex - 1);
    while ((lv_index >= 1)) {
        lv_key = CMUIX_HistoryProfileTemplateKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload")) == true)) {
            lv_ordinal += 1;
            if ((lv_key == lp_key)) {
                return lv_ordinal;
            }
        }

        lv_index -= 1;
    }

    return 0;
}

string CMUIX_HistoryProfileTemplateKeyForPayload(int lp_player, string lp_payload) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    string lv_key;
    string lv_targetBody;
    string lv_payload;
    string lv_body;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_key = "";
    lv_targetBody = CMUIX_HistoryBodyFromPayload(lp_payload);
    lv_payload = "";
    lv_body = "";
    if ((lv_bank == null) || (lv_targetBody == "") || (lv_targetBody == null)) {
        return "";
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", 1);
    lv_index = (lv_nextIndex - 1);
    while ((lv_index >= 1)) {
        lv_key = CMUIX_HistoryProfileTemplateKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload")) == true)) {
            lv_payload = BankValueGetAsString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload"));
            lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
            if ((lv_body == lv_targetBody)) {
                return lv_key;
            }
        }

        lv_index -= 1;
    }

    return "";
}

void CMUIX_HistorySelectProfileTemplate(int lp_player, string lp_key) {
    int lv_ordinal;

    lv_ordinal = CMUIX_HistoryProfileTemplateOrdinalForKey(lp_player, lp_key);
    CMUIX_HistoryProfileSelectedKey[lp_player] = lp_key;
    CMUIX_HistoryProfilesPageIndex[lp_player] = CMUIX_HistoryOrdinalPage(lv_ordinal);
    CMUIX_HistoryViewingProfiles[lp_player] = true;
}

void CMUIX_HistoryNotifyProfileTemplatePosition(int lp_player, string lp_name, string lp_key, bool lp_created) {
    int lv_ordinal;
    int lv_page;
    int lv_slot;
    string lv_name;
    string lv_prefix;

    lv_ordinal = CMUIX_HistoryProfileTemplateOrdinalForKey(lp_player, lp_key);
    lv_page = CMUIX_HistoryOrdinalPage(lv_ordinal);
    lv_slot = CMUIX_HistoryOrdinalSlot(lv_ordinal);
    lv_name = lp_name;
    lv_prefix = "Profile 模板已存在";
    if ((lv_name == "") || (lv_name == null)) {
        lv_name = "Profile";
    }

    if ((lp_created == true)) {
        lv_prefix = "Profile 模板已保存";
    }

    CMUIX_ProfileMessage(lp_player, (lv_prefix + "：" + lv_name + "（第 " + IntToString(lv_page) + " 页第 " + IntToString(lv_slot) + " 个）。"));
}

void CMUIX_HistoryRefreshActionButtons(int lp_player) {
    playergroup lv_players;
    bool lv_viewingProfiles;
    bool lv_hasRecord;
    bool lv_hasProfile;
    bool lv_canApply;
    bool lv_suggestVisible;
    bool lv_acceptVisible;
    string lv_applyPayload;

    lv_players = PlayerGroupSingle(lp_player);
    lv_viewingProfiles = CMUIX_HistoryViewingProfiles[lp_player];
    lv_hasRecord = CMUIX_HistoryRecordKeyExists(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
    lv_hasProfile = CMUIX_HistoryProfileTemplateKeyExists(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
    lv_applyPayload = CMUIX_HistorySelectedApplyPayloadForPlayer(lp_player);
    lv_canApply = CMUIX_HistoryCanApplyPayloadForPlayer(lp_player, lv_applyPayload);
    lv_suggestVisible = ((lv_viewingProfiles == true) && (CMUIX_HistoryPlayerTwoShouldSuggest(lp_player) == true));
    lv_acceptVisible = CMUIX_HistorySuggestionPendingForPlayer(lp_player);

    if ((lv_viewingProfiles == true)) {
        CMUIX_SetControlEnabled(CMUIX_HistoryRecordApplyButton, lv_players, ((lv_hasProfile == true) && (lv_canApply == true)));
    }
    else {
        CMUIX_SetControlEnabled(CMUIX_HistoryRecordApplyButton, lv_players, ((lv_hasRecord == true) && (lv_canApply == true)));
    }

    if (((lv_viewingProfiles == true) && (lv_hasProfile == true)) || ((lv_viewingProfiles == false) && (lv_hasRecord == true))) {
        CMUIX_SetControlTooltip(CMUIX_HistoryRecordApplyButton, lv_players, CMUIX_HistoryApplyTooltipForPayload(lp_player, lv_applyPayload));
    }
    else {
        CMUIX_SetControlTooltip(CMUIX_HistoryRecordApplyButton, lv_players, StringExternal("CMUI/ScreenHistory/Compatibility/NoSelection"));
    }

    CMUIX_SetControlVisible(CMUIX_HistoryProfileDeleteButton, lv_players, true);
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, (((lv_viewingProfiles == true) && (lv_hasProfile == true)) || ((lv_viewingProfiles == false) && (lv_hasRecord == true))));
    CMUIX_SetControlVisible(CMUIX_HistoryNewProfileButton, lv_players, lv_viewingProfiles);
    CMUIX_SetControlEnabled(CMUIX_HistoryNewProfileButton, lv_players, true);
    CMUIX_SetControlVisible(CMUIX_HistorySaveRecordTemplateButton, lv_players, (lv_viewingProfiles == false));
    CMUIX_SetControlEnabled(CMUIX_HistorySaveRecordTemplateButton, lv_players, lv_hasRecord);

    if ((lv_acceptVisible == true)) {
        CMUIX_SetControlVisible(CMUIX_HistorySuggestTemplateButton, lv_players, true);
        CMUIX_SetControlEnabled(CMUIX_HistorySuggestTemplateButton, lv_players, true);
        CMUIX_SetControlText(CMUIX_HistorySuggestTemplateButton, lv_players, StringExternal("CMUI/ScreenHistory/Action/AcceptSuggestion"));
    }
    else {
        CMUIX_SetControlVisible(CMUIX_HistorySuggestTemplateButton, lv_players, lv_suggestVisible);
        CMUIX_SetControlEnabled(CMUIX_HistorySuggestTemplateButton, lv_players, ((lv_suggestVisible == true) && (lv_hasProfile == true)));
        CMUIX_SetControlText(CMUIX_HistorySuggestTemplateButton, lv_players, StringExternal("CMUI/ScreenHistory/Action/SuggestTemplate"));
    }
}

void CMUIX_HistorySetListEmptyVisuals(int lp_player, bool lp_empty) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_SetControlVisible(CMUIX_HistoryListEmptyLabel, lv_players, lp_empty);
    CMUIX_SetControlVisible(CMUIX_HistoryDetailsTitleLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryListDateHeaderLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryListNameHeaderLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryListModeHeaderLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryListResultHeaderLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryListAttemptsHeaderLabel, lv_players, (lp_empty == false));
    CMUIX_SetControlVisible(CMUIX_HistoryResultHeadingLabel, lv_players, (lp_empty == false));
}

string CMUIX_HistoryDisplayStateFromResult(string lp_result) {
    if ((StringEqual(lp_result, "Victory", c_stringNoCase) == true)) {
        return "NormalVictory";
    }

    if ((StringEqual(lp_result, "Defeat", c_stringNoCase) == true)) {
        return "NormalDefeat";
    }

    if ((CMUIX_HistoryResultIsDraw(lp_result) == true)) {
        return "NormalDraw";
    }

    return "Normal";
}

string CMUIX_HistoryDisplayStateForRow(int lp_player, int lp_slot, bool lp_selected) {
    bank lv_bank;
    string lv_key;
    string lv_payload;
    string lv_body;
    string lv_result;

    lv_bank = null;
    lv_key = "";
    lv_payload = "";
    lv_body = "";
    lv_result = "";

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lp_slot < 1) || (lp_slot > CMUIX_HISTORY_ROW_MAX)) {
        return "Normal";
    }

    if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
        if ((lp_selected == true)) {
            return "Selected";
        }

        return "Normal";
    }

    lv_key = CMUIX_HistoryRecordRowKeys[lp_player][lp_slot];
    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lv_key == "") || (BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lv_key) == false)) {
        return "Normal";
    }

    lv_payload = BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lv_key);
    lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
    lv_result = CMUIX_HistoryResultValueFromBody(lv_body);
    if ((lp_selected == true)) {
        if ((StringEqual(lv_result, "Victory", c_stringNoCase) == true)) {
            return "SelectedVictory";
        }

        if ((StringEqual(lv_result, "Defeat", c_stringNoCase) == true)) {
            return "SelectedDefeat";
        }

        if ((CMUIX_HistoryResultIsDraw(lv_result) == true)) {
            return "SelectedDraw";
        }

        return "Selected";
    }

    return CMUIX_HistoryDisplayStateFromResult(lv_result);
}

void CMUIX_HistoryRefreshRowToggles(int lp_player) {
    playergroup lv_players;
    int lv_slot;
    bool lv_toggled;
    string lv_displayState;

    lv_slot = 1;
    lv_toggled = false;
    lv_displayState = "Normal";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        lv_toggled = false;
        if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
            if ((CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] != "") && (CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] == CMUIX_HistoryProfileSelectedKey[lp_player])) {
                lv_toggled = true;
            }
        }
        else {
            if ((CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] != "") && (CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] == CMUIX_HistoryRecordSelectedKey[lp_player])) {
                lv_toggled = true;
            }
        }

        CMUIX_SetControlToggled(CMUIX_HistoryRecordItems[lv_slot], lv_players, lv_toggled);
        lv_displayState = CMUIX_HistoryDisplayStateForRow(lp_player, lv_slot, lv_toggled);
        if ((CMUIX_IsControlValid(CMUIX_HistoryRecordItems[lv_slot]) == true)) {
            DialogControlSetAnimationState(CMUIX_HistoryRecordItems[lv_slot], lv_players, "DisplayState", lv_displayState);
        }

        lv_slot += 1;
    }
}

void CMUIX_HistoryRenderEmptyRecordRow(int lp_player) {
    playergroup lv_players;
    int lv_slot;

    lv_players = PlayerGroupSingle(lp_player);
    lv_slot = 1;
    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] = "";
        CMUIX_SetControlVisible(CMUIX_HistoryRecordItems[lv_slot], lv_players, false);
        CMUIX_SetControlEnabled(CMUIX_HistoryRecordItems[lv_slot], lv_players, false);
        CMUIX_SetControlText(CMUIX_HistoryRecordDateLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordModeLabels[lv_slot], lv_players, StringToText(""));
        CMUIX_SetControlText(CMUIX_HistoryRecordResultLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordAttemptLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordNameLabels[lv_slot], lv_players, StringToText(""));

        lv_slot += 1;
    }

    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, StringExternal("CMUI/ScreenHistory/NoRecords"));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedResultLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedDurationLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedCommanderLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistorySelectedConfigurationLabel, lv_players, StringToText("-"));
    CMUIX_HistoryRefreshMutatorDetailsFromBody(lp_player, "");
    CMUIX_SetControlText(CMUIX_HistorySelectedCompatibilityLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistorySelectedNoteLabel, lv_players, StringToText(""));
    CMUIX_HistorySetProfileCode(lp_player, "");
    CMUIX_HistorySetThumbnailForMap(lp_player, "");
    CMUIX_SetControlEnabled(CMUIX_HistoryRecordApplyButton, lv_players, false);
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, false);
    CMUIX_HistoryRefreshActionButtons(lp_player);
    CMUIX_HistoryRefreshRowToggles(lp_player);
}

string CMUIX_HistoryRecordPayloadForKey(int lp_player, string lp_key) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lp_key == "") || (BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lp_key) == false)) {
        return "";
    }

    return BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lp_key);
}

void CMUIX_HistoryRenderRecordDetails(int lp_player, string lp_key) {
    bank lv_bank;
    playergroup lv_players;
    string lv_payload;
    string lv_body;
    string lv_map;
    int lv_time;
    int lv_integrity;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_players = PlayerGroupSingle(lp_player);
    lv_payload = "";
    lv_body = "";
    lv_map = "";
    lv_time = 0;
    lv_integrity = CMUIX_HISTORY_INTEGRITY_INVALID;
    if ((lv_bank == null) || (lp_key == "") || (BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lp_key) == false)) {
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, StringExternal("CMUI/ScreenHistory/NoRecords"));
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedResultLabel, lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedDurationLabel, lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedCommanderLabel, lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistorySelectedConfigurationLabel, lv_players, StringToText("-"));
        CMUIX_HistoryRefreshMutatorDetailsFromBody(lp_player, "");
        CMUIX_SetControlText(CMUIX_HistorySelectedCompatibilityLabel, lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistorySelectedNoteLabel, lv_players, StringToText(""));
        CMUIX_HistorySetProfileCode(lp_player, "");
        CMUIX_HistorySetThumbnailForMap(lp_player, "");
        CMUIX_SetControlEnabled(CMUIX_HistoryRecordApplyButton, lv_players, false);
        CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, false);
        CMUIX_HistoryRefreshActionButtons(lp_player);
        CMUIX_HistoryRefreshRowToggles(lp_player);
        return;
    }

    lv_payload = BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lp_key);
    lv_integrity = CMUIX_HistoryRecordIntegrityForPayload(lv_payload);
    lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
    lv_map = CMUIX_HistoryMapValueFromBody(lv_body);
    lv_time = StringToInt(CMUIX_ProfileConfigValue(lv_body, "time"));

    if ((lv_integrity == CMUIX_HISTORY_INTEGRITY_TAMPERED) || (lv_integrity == CMUIX_HISTORY_INTEGRITY_INVALID)) {
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, StringToText("失效/遭篡改：") + CMUIX_HistoryMapText(lv_map));
    }
    else {
        CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, CMUIX_HistoryMapText(lv_map));
    }

    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedResultLabel, lv_players, CMUIX_HistoryMissionNameTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedDurationLabel, lv_players, StringToText(CMUIX_HistoryDateHourString(lv_time)));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedCommanderLabel, lv_players, CMUIX_HistoryCommanderConfigTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistorySelectedConfigurationLabel, lv_players, CMUIX_HistoryObjectiveSnapshotTextFromBody(lv_body));
    CMUIX_HistoryRefreshMutatorDetailsFromBody(lp_player, lv_body);
    CMUIX_SetControlText(CMUIX_HistorySelectedCompatibilityLabel, lv_players, CMUIX_HistoryRatingTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistorySelectedNoteLabel, lv_players, CMUIX_HistoryNoteTextFromBody(lv_body));
    CMUIX_HistorySetProfileCode(lp_player, lv_payload);
    CMUIX_HistorySetThumbnailForMap(lp_player, lv_map);
    CMUIX_SetControlEnabled(CMUIX_HistoryRecordApplyButton, lv_players, (lv_integrity == CMUIX_HISTORY_INTEGRITY_VALID));
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, false);
    CMUIX_HistoryRefreshActionButtons(lp_player);
    CMUIX_HistoryRefreshRowToggles(lp_player);
}

void CMUIX_HistoryPrunePendingRecordsForPlayer(int lp_player) {
    bank lv_bank;
    int lv_nextIndex;
    int lv_index;
    string lv_key;
    string lv_payload;
    string lv_activeKey;
    bool lv_recordExists;
    bool lv_markedCheated;
    bool lv_changed;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_key = "";
    lv_payload = "";
    lv_activeKey = "";
    lv_recordExists = false;
    lv_markedCheated = false;
    lv_changed = false;
    if ((lv_bank == null) || (CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        return;
    }

    lv_activeKey = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey", "");
    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    while ((lv_index < lv_nextIndex)) {
        lv_key = CMUIX_HistoryRecordKey(lv_index);
        lv_payload = "";
        lv_recordExists = (BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lv_key) == true);
        if ((lv_recordExists == true)) {
            lv_payload = BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lv_key);
            lv_markedCheated = CMUIX_HistoryRecordMarkedCheated(lv_bank, lv_key, lv_payload);
            if ((CMUIX_HistoryRecordIntegrityForPayload(lv_payload) == CMUIX_HISTORY_INTEGRITY_PENDING) || (lv_markedCheated == true)) {
                CMUIX_HistoryRemoveRecordBankKeys(lv_bank, lv_key);
                if ((lv_activeKey == lv_key)) {
                    BankKeyRemove(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey");
                }

                if ((CMUIX_HistoryRecordSelectedKey[lp_player] == lv_key)) {
                    CMUIX_HistoryRecordSelectedKey[lp_player] = "";
                }

                lv_changed = true;
            }
        }
        else {
            if ((BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lv_key)) == true)) {
                BankKeyRemove(lv_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lv_key));
                lv_changed = true;
            }
        }

        lv_index += 1;
    }

    if ((lv_changed == true)) {
        CMUIX_GameHistorySaveBank(lp_player);
    }
}

void CMUIX_HistoryPrunePendingRecordsAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_HistoryPrunePendingRecordsForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_HistoryPrunePendingRecordsForPlayer(1);
        CMUIX_HistoryPrunePendingRecordsForPlayer(2);
    }
}

void CMUIX_HistoryRefreshRecordsForPlayer(int lp_player) {
    bank lv_bank;
    playergroup lv_players;
    int lv_nextIndex;
    int lv_index;
    int lv_count;
    int lv_page;
    int lv_maxPage;
    int lv_firstOrdinal;
    int lv_lastOrdinal;
    int lv_ordinal;
    int lv_slot;
    int lv_time;
    string lv_key;
    string lv_firstKey;
    string lv_payload;
    string lv_body;
    int lv_integrity;
    bool lv_selectedVisible;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_players = PlayerGroupSingle(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_count = CMUIX_HistoryRecordCount(lp_player);
    lv_page = CMUIX_HistoryRecordsPageIndex[lp_player];
    lv_maxPage = CMUIX_HistoryPageCount(lv_count);
    lv_firstOrdinal = 0;
    lv_lastOrdinal = 0;
    lv_ordinal = 0;
    lv_slot = 1;
    lv_time = 0;
    lv_key = "";
    lv_firstKey = "";
    lv_payload = "";
    lv_body = "";
    lv_integrity = CMUIX_HISTORY_INTEGRITY_VALID;
    lv_selectedVisible = false;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lv_bank == null)) {
        return;
    }

    CMUIX_HistoryPrunePendingRecordsForPlayer(lp_player);
    lv_count = CMUIX_HistoryRecordCount(lp_player);
    lv_maxPage = CMUIX_HistoryPageCount(lv_count);

    if ((lv_page < 1)) {
        lv_page = 1;
    }

    if ((lv_page > lv_maxPage)) {
        lv_page = lv_maxPage;
    }

    CMUIX_HistoryRecordsPageIndex[lp_player] = lv_page;
    CMUIX_SetControlText(CMUIX_HistoryRecordsPageLabel, lv_players, StringToText(IntToString(lv_page) + " / " + IntToString(lv_maxPage)));
    CMUIX_SetControlEnabled(CMUIX_HistoryRecordsPreviousPageButton, lv_players, (lv_page > 1));
    CMUIX_SetControlEnabled(CMUIX_HistoryRecordsNextPageButton, lv_players, (lv_page < lv_maxPage));
    CMUIX_HistorySetListEmptyVisuals(lp_player, (lv_count <= 0));
    if ((lv_count <= 0)) {
        CMUIX_HistoryRecordSelectedKey[lp_player] = "";
        CMUIX_HistoryRenderEmptyRecordRow(lp_player);
        return;
    }

    lv_firstOrdinal = (((lv_page - 1) * CMUIX_HISTORY_ROW_MAX) + 1);
    lv_lastOrdinal = (lv_firstOrdinal + CMUIX_HISTORY_ROW_MAX - 1);
    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_HISTORY_SECTION, "NextIndex", 1);
    lv_index = (lv_nextIndex - 1);
    while ((lv_index >= 1) && (lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        lv_key = CMUIX_HistoryRecordKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lv_key) == true)) {
            lv_ordinal += 1;
            if ((lv_ordinal >= lv_firstOrdinal) && (lv_ordinal <= lv_lastOrdinal)) {
                lv_payload = BankValueGetAsString(lv_bank, CMUIX_HISTORY_SECTION, lv_key);
                lv_integrity = CMUIX_HistoryRecordIntegrityForPayload(lv_payload);
                lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
                lv_time = StringToInt(CMUIX_ProfileConfigValue(lv_body, "time"));
                CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] = lv_key;
                if ((lv_firstKey == "")) {
                    lv_firstKey = lv_key;
                }

                CMUIX_SetControlVisible(CMUIX_HistoryRecordItems[lv_slot], lv_players, true);
                CMUIX_SetControlEnabled(CMUIX_HistoryRecordItems[lv_slot], lv_players, true);
                CMUIX_SetControlText(CMUIX_HistoryRecordDateLabels[lv_slot], lv_players, CMUIX_HistoryDateText(lv_time));
                if ((lv_integrity == CMUIX_HISTORY_INTEGRITY_TAMPERED) || (lv_integrity == CMUIX_HISTORY_INTEGRITY_INVALID)) {
                    CMUIX_SetControlText(CMUIX_HistoryRecordNameLabels[lv_slot], lv_players, StringToText("失效/遭篡改：") + CMUIX_HistoryMapText(CMUIX_HistoryMapValueFromBody(lv_body)));
                }
                else {
                    CMUIX_SetControlText(CMUIX_HistoryRecordNameLabels[lv_slot], lv_players, CMUIX_HistoryMapText(CMUIX_HistoryMapValueFromBody(lv_body)));
                }

                CMUIX_SetControlText(CMUIX_HistoryRecordModeLabels[lv_slot], lv_players, CMUIX_HistoryModeTextFromBody(lv_body));
                CMUIX_SetControlText(CMUIX_HistoryRecordResultLabels[lv_slot], lv_players, CMUIX_HistoryResultListText(CMUIX_HistoryResultValueFromBody(lv_body)));
                CMUIX_SetControlText(CMUIX_HistoryRecordAttemptLabels[lv_slot], lv_players, CMUIX_HistoryAttemptsText(lv_body));
                lv_slot += 1;
            }
        }

        lv_index -= 1;
    }

    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] = "";
        CMUIX_SetControlVisible(CMUIX_HistoryRecordItems[lv_slot], lv_players, false);
        CMUIX_SetControlEnabled(CMUIX_HistoryRecordItems[lv_slot], lv_players, false);
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        if ((CMUIX_HistoryRecordRowKeys[lp_player][lv_slot] == CMUIX_HistoryRecordSelectedKey[lp_player]) && (CMUIX_HistoryRecordSelectedKey[lp_player] != "")) {
            lv_selectedVisible = true;
        }

        lv_slot += 1;
    }

    if ((CMUIX_HistoryRecordKeyExists(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]) == false) || (lv_selectedVisible == false)) {
        CMUIX_HistoryRecordSelectedKey[lp_player] = lv_firstKey;
    }

    CMUIX_HistoryRenderRecordDetails(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
}

void CMUIX_HistoryRenderEmptyProfileRows(int lp_player) {
    playergroup lv_players;
    int lv_slot;

    lv_players = PlayerGroupSingle(lp_player);
    lv_slot = 1;
    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] = "";
        CMUIX_SetControlVisible(CMUIX_HistoryProfileItems[lv_slot], lv_players, false);
        CMUIX_SetControlEnabled(CMUIX_HistoryProfileItems[lv_slot], lv_players, false);
        CMUIX_SetControlText(CMUIX_HistoryProfileUpdatedLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryProfileMapLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordResultLabels[lv_slot], lv_players, StringToText("-"));
        CMUIX_SetControlText(CMUIX_HistoryRecordAttemptLabels[lv_slot], lv_players, StringToText(""));
        CMUIX_SetControlText(CMUIX_HistoryProfileNameLabels[lv_slot], lv_players, StringToText(""));

        lv_slot += 1;
    }

    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, StringExternal("CMUI/ScreenHistory/ProfileTemplates/NoRecords"));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedResultLabel, lv_players, StringToText(""));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedDurationLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedCommanderLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistorySelectedConfigurationLabel, lv_players, StringToText("-"));
    CMUIX_HistoryRefreshMutatorDetailsFromBody(lp_player, "");
    CMUIX_SetControlText(CMUIX_HistorySelectedCompatibilityLabel, lv_players, StringToText("-"));
    CMUIX_SetControlText(CMUIX_HistorySelectedNoteLabel, lv_players, StringToText(""));
    CMUIX_HistorySetProfileCode(lp_player, "");
    CMUIX_HistorySetThumbnailForMap(lp_player, "");
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileApplyButton, lv_players, false);
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, false);
    CMUIX_SetControlEnabled(CMUIX_HistoryNewProfileButton, lv_players, true);
    CMUIX_HistoryRefreshActionButtons(lp_player);
    CMUIX_HistoryRefreshRowToggles(lp_player);
}

string CMUIX_HistoryProfilePayloadForKey(int lp_player, string lp_key) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lp_key == "") || (BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload")) == false)) {
        return "";
    }

    return BankValueGetAsString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload"));
}

void CMUIX_HistoryRenderProfileDetails(int lp_player, string lp_key) {
    bank lv_bank;
    playergroup lv_players;
    string lv_payload;
    string lv_body;
    string lv_map;
    string lv_source;
    int lv_time;
    int lv_updated;
    bool lv_certified;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_players = PlayerGroupSingle(lp_player);
    lv_payload = "";
    lv_body = "";
    lv_map = "";
    lv_source = "";
    lv_time = 0;
    lv_updated = 0;
    lv_certified = false;
    if ((lv_bank == null) || (lp_key == "") || (BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload")) == false)) {
        CMUIX_HistoryRenderEmptyProfileRows(lp_player);
        return;
    }

    lv_payload = BankValueGetAsString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload"));
    lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
    lv_map = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Map"), "-");
    lv_source = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Source"), "-");
    lv_certified = (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Certified"), 0) == 1);
    lv_updated = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Updated"), 0);
    lv_time = StringToInt(CMUIX_ProfileConfigValue(lv_body, "time"));
    if ((lv_time <= 0)) {
        lv_time = lv_updated;
    }

    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedTitleLabel, lv_players, CMUIX_HistoryMapText(lv_map));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedResultLabel, lv_players, CMUIX_HistoryMissionNameTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedDurationLabel, lv_players, StringToText(CMUIX_HistoryDateHourString(lv_time)));
    CMUIX_SetControlText(CMUIX_HistoryRecordSelectedCommanderLabel, lv_players, CMUIX_HistoryCommanderConfigTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistorySelectedConfigurationLabel, lv_players, CMUIX_HistoryProfileSourceCertifiedText(lv_source, lv_certified));
    CMUIX_HistoryRefreshMutatorDetailsFromBody(lp_player, lv_body);
    CMUIX_SetControlText(CMUIX_HistorySelectedCompatibilityLabel, lv_players, CMUIX_HistoryRatingTextFromBody(lv_body));
    CMUIX_SetControlText(CMUIX_HistorySelectedNoteLabel, lv_players, CMUIX_HistoryNoteTextFromBody(lv_body));
    CMUIX_HistorySetProfileCode(lp_player, lv_payload);
    CMUIX_HistorySetThumbnailForMap(lp_player, lv_map);
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileApplyButton, lv_players, true);
    CMUIX_SetControlEnabled(CMUIX_HistoryProfileDeleteButton, lv_players, true);
    CMUIX_SetControlEnabled(CMUIX_HistoryNewProfileButton, lv_players, true);
    CMUIX_HistoryRefreshActionButtons(lp_player);
    CMUIX_HistoryRefreshRowToggles(lp_player);
}

void CMUIX_HistoryRefreshProfilesForPlayer(int lp_player) {
    bank lv_bank;
    playergroup lv_players;
    int lv_nextIndex;
    int lv_index;
    int lv_count;
    int lv_page;
    int lv_maxPage;
    int lv_firstOrdinal;
    int lv_lastOrdinal;
    int lv_ordinal;
    int lv_slot;
    int lv_updated;
    string lv_key;
    string lv_firstKey;
    string lv_name;
    string lv_map;
    string lv_source;
    int lv_playCount;
    bool lv_certified;
    bool lv_selectedVisible;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_players = PlayerGroupSingle(lp_player);
    lv_nextIndex = 1;
    lv_index = 1;
    lv_count = CMUIX_HistoryProfileTemplateCount(lp_player);
    lv_page = CMUIX_HistoryProfilesPageIndex[lp_player];
    lv_maxPage = CMUIX_HistoryPageCount(lv_count);
    lv_firstOrdinal = 0;
    lv_lastOrdinal = 0;
    lv_ordinal = 0;
    lv_slot = 1;
    lv_updated = 0;
    lv_key = "";
    lv_firstKey = "";
    lv_name = "";
    lv_map = "";
    lv_source = "";
    lv_playCount = 0;
    lv_certified = false;
    lv_selectedVisible = false;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS) || (lv_bank == null)) {
        return;
    }

    if ((lv_page < 1)) {
        lv_page = 1;
    }

    if ((lv_page > lv_maxPage)) {
        lv_page = lv_maxPage;
    }

    CMUIX_HistoryProfilesPageIndex[lp_player] = lv_page;
    CMUIX_SetControlText(CMUIX_HistoryProfilesPageLabel, lv_players, StringToText(IntToString(lv_page) + " / " + IntToString(lv_maxPage)));
    CMUIX_SetControlEnabled(CMUIX_HistoryProfilesPreviousPageButton, lv_players, (lv_page > 1));
    CMUIX_SetControlEnabled(CMUIX_HistoryProfilesNextPageButton, lv_players, (lv_page < lv_maxPage));
    CMUIX_HistorySetListEmptyVisuals(lp_player, (lv_count <= 0));
    if ((lv_count <= 0)) {
        CMUIX_HistoryProfileSelectedKey[lp_player] = "";
        CMUIX_HistoryRenderEmptyProfileRows(lp_player);
        return;
    }

    lv_firstOrdinal = (((lv_page - 1) * CMUIX_HISTORY_ROW_MAX) + 1);
    lv_lastOrdinal = (lv_firstOrdinal + CMUIX_HISTORY_ROW_MAX - 1);
    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", 1);
    lv_index = (lv_nextIndex - 1);
    while ((lv_index >= 1) && (lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        lv_key = CMUIX_HistoryProfileTemplateKey(lv_index);
        if ((BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload")) == true)) {
            lv_ordinal += 1;
            if ((lv_ordinal >= lv_firstOrdinal) && (lv_ordinal <= lv_lastOrdinal)) {
                lv_name = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Name"), "Profile");
                lv_map = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Map"), "-");
                lv_source = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Source"), "-");
                lv_playCount = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|PlayCount"), 0);
                lv_certified = (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Certified"), 0) == 1);
                lv_updated = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Updated"), 0);
                CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] = lv_key;
                if ((lv_firstKey == "")) {
                    lv_firstKey = lv_key;
                }

                CMUIX_SetControlVisible(CMUIX_HistoryProfileItems[lv_slot], lv_players, true);
                CMUIX_SetControlEnabled(CMUIX_HistoryProfileItems[lv_slot], lv_players, true);
                CMUIX_SetControlText(CMUIX_HistoryProfileUpdatedLabels[lv_slot], lv_players, CMUIX_HistoryDateText(lv_updated));
                CMUIX_SetControlText(CMUIX_HistoryProfileNameLabels[lv_slot], lv_players, StringToText(lv_name));
                CMUIX_SetControlText(CMUIX_HistoryProfileMapLabels[lv_slot], lv_players, CMUIX_HistoryMapText(lv_map));
                CMUIX_SetControlText(CMUIX_HistoryRecordResultLabels[lv_slot], lv_players, CMUIX_HistoryProfileSourceCertifiedText(lv_source, lv_certified));
                CMUIX_SetControlText(CMUIX_HistoryRecordAttemptLabels[lv_slot], lv_players, StringToText(IntToString(lv_playCount)));
                lv_slot += 1;
            }
        }

        lv_index -= 1;
    }

    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] = "";
        CMUIX_SetControlVisible(CMUIX_HistoryProfileItems[lv_slot], lv_players, false);
        CMUIX_SetControlEnabled(CMUIX_HistoryProfileItems[lv_slot], lv_players, false);
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_HISTORY_ROW_MAX)) {
        if ((CMUIX_HistoryProfileRowKeys[lp_player][lv_slot] == CMUIX_HistoryProfileSelectedKey[lp_player]) && (CMUIX_HistoryProfileSelectedKey[lp_player] != "")) {
            lv_selectedVisible = true;
        }

        lv_slot += 1;
    }

    if ((CMUIX_HistoryProfileTemplateKeyExists(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]) == false) || (lv_selectedVisible == false)) {
        CMUIX_HistoryProfileSelectedKey[lp_player] = lv_firstKey;
    }

    CMUIX_HistoryRenderProfileDetails(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
}

void CMUIX_HistoryRefreshModeText(int lp_player) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
        CMUIX_SetControlText(CMUIX_HistoryDetailsTitleLabel, lv_players, StringExternal("CMUI/ScreenHistory/ProfileTemplates/DetailsHeader"));
        CMUIX_SetControlText(CMUIX_HistoryListDateHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Updated"));
        CMUIX_SetControlText(CMUIX_HistoryListNameHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Name"));
        CMUIX_SetControlText(CMUIX_HistoryListModeHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Map"));
        CMUIX_SetControlText(CMUIX_HistoryListResultHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/ProfileTemplates/Source"));
        CMUIX_SetControlText(CMUIX_HistoryListAttemptsHeaderLabel, lv_players, StringToText("次数"));
        CMUIX_SetControlText(CMUIX_HistoryListEmptyLabel, lv_players, StringExternal("CMUI/ScreenHistory/ProfileTemplates/NoRecords"));
        CMUIX_SetControlText(CMUIX_HistoryResultHeadingLabel, lv_players, StringExternal("CMUI/ScreenHistory/Details/MissionName"));
    }
    else {
        CMUIX_SetControlText(CMUIX_HistoryDetailsTitleLabel, lv_players, StringExternal("CMUI/ScreenHistory/DetailsHeader"));
        CMUIX_SetControlText(CMUIX_HistoryListDateHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Date"));
        CMUIX_SetControlText(CMUIX_HistoryListNameHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Map"));
        CMUIX_SetControlText(CMUIX_HistoryListModeHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Mode"));
        CMUIX_SetControlText(CMUIX_HistoryListResultHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Result"));
        CMUIX_SetControlText(CMUIX_HistoryListAttemptsHeaderLabel, lv_players, StringExternal("CMUI/ScreenHistory/Column/Attempts"));
        CMUIX_SetControlText(CMUIX_HistoryListEmptyLabel, lv_players, StringExternal("CMUI/ScreenHistory/NoRecords"));
        CMUIX_SetControlText(CMUIX_HistoryResultHeadingLabel, lv_players, StringExternal("CMUI/ScreenHistory/Details/MissionName"));
    }

    CMUIX_HistoryRefreshActionButtons(lp_player);
}

void CMUIX_HistoryRefreshForPlayer(int lp_player) {
    playergroup lv_players;

    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_HistoryHooked == false) || (lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_SetControlToggled(CMUIX_HistoryGameHistoryButton, lv_players, (CMUIX_HistoryViewingProfiles[lp_player] == false));
    CMUIX_SetControlToggled(CMUIX_HistoryProfileTemplatesButton, lv_players, CMUIX_HistoryViewingProfiles[lp_player]);
    CMUIX_HistoryRefreshModeText(lp_player);
    if ((CMUIX_HistoryViewingProfiles[lp_player] == true)) {
        CMUIX_HistoryRefreshProfilesForPlayer(lp_player);
    }
    else {
        CMUIX_HistoryRefreshRecordsForPlayer(lp_player);
    }
}

void CMUIX_HistoryRefreshAll() {
    int lv_player;

    lv_player = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_HistoryRefreshForPlayer(lv_player);
        lv_player += 1;
    }
}

void CMUIX_ProfileTemplateRecord(int lp_player, string lp_name, string lp_payload, string lp_source) {
    bank lv_bank;
    int lv_nextIndex;
    string lv_key;
    string lv_existingKey;
    string lv_body;
    string lv_name;
    string lv_map;
    bool lv_certified;
    bool lv_existingCertified;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_nextIndex = 1;
    lv_key = "";
    lv_existingKey = "";
    lv_body = "";
    lv_name = lp_name;
    lv_map = "-";
    lv_certified = false;
    lv_existingCertified = false;
    CMUIX_HistoryLastProfileTemplateKey = "";
    CMUIX_HistoryLastProfileTemplateCreated = false;
    if ((lv_bank == null) || (lp_payload == "") || (lp_payload == null)) {
        return;
    }

    lv_body = CMUIX_HistoryBodyFromPayload(lp_payload);
    if ((lv_body == "") || (lv_body == null)) {
        return;
    }

    if ((lv_name == "") || (lv_name == null)) {
        lv_name = CMUIX_HistoryNameValueFromBody(lv_body);
    }

    if ((lv_name == "") || (lv_name == null)) {
        lv_name = "Profile";
    }

    lv_map = CMUIX_HistoryMapValueFromBody(lv_body);
    lv_certified = CMUIX_ProfilePayloadCertified(lp_payload);
    lv_existingKey = CMUIX_HistoryProfileTemplateKeyForPayload(lp_player, lp_payload);
    if ((lv_existingKey != "")) {
        if ((lv_name == "") || (lv_name == null)) {
            lv_name = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Name"), "Profile");
        }

        lv_existingCertified = (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Certified"), 0) == 1);
        if ((lv_certified == true) && (lv_existingCertified == false)) {
            BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Payload"), lp_payload);
            BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Source"), lp_source);
            BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Certified"), 1);
            BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_existingKey + "|Updated"), DateTimeToInt(CurrentDateTimeGet()));
            CMUIX_GameHistorySaveBank(lp_player);
        }

        CMUIX_HistoryLastProfileTemplateKey = lv_existingKey;
        CMUIX_HistoryLastProfileTemplateCreated = false;
        CMUIX_HistorySelectProfileTemplate(lp_player, lv_existingKey);
        CMUIX_HistoryRefreshForPlayer(lp_player);
        CMUIX_HistoryNotifyProfileTemplatePosition(lp_player, lv_name, lv_existingKey, false);
        return;
    }

    lv_nextIndex = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", 1);
    if ((lv_nextIndex < 1)) {
        lv_nextIndex = 1;
    }

    lv_key = CMUIX_HistoryProfileTemplateKey(lv_nextIndex);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, "NextIndex", (lv_nextIndex + 1));
    BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Payload"), lp_payload);
    BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Name"), lv_name);
    BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Map"), lv_map);
    BankValueSetFromString(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Source"), lp_source);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Certified"), BoolToInt(lv_certified));
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|PlayCount"), 0);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lv_key + "|Updated"), DateTimeToInt(CurrentDateTimeGet()));
    CMUIX_GameHistorySaveBank(lp_player);
    CMUIX_HistoryLastProfileTemplateKey = lv_key;
    CMUIX_HistoryLastProfileTemplateCreated = true;
    CMUIX_HistorySelectProfileTemplate(lp_player, lv_key);
    CMUIX_HistoryRefreshForPlayer(lp_player);
    CMUIX_HistoryNotifyProfileTemplatePosition(lp_player, lv_name, lv_key, true);
}

string CMUIX_ProfileTemplateKeyForPayload(int lp_player, string lp_payload) {
    return CMUIX_HistoryProfileTemplateKeyForPayload(lp_player, lp_payload);
}

void CMUIX_ProfileTemplateIncrementPlayCount(int lp_player, string lp_key) {
    bank lv_bank;
    int lv_count;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_count = 0;
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return;
    }

    if ((BankKeyExists(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload")) == false)) {
        return;
    }

    lv_count = CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|PlayCount"), 0);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|PlayCount"), (lv_count + 1));
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Updated"), DateTimeToInt(CurrentDateTimeGet()));
    CMUIX_GameHistorySaveBank(lp_player);
}

void CMUIX_ProfileCountLaunchStartAll() {
    int lv_player;
    string lv_name;
    string lv_key;

    lv_player = 1;
    lv_name = CMUIX_ProfileChallengeName;
    lv_key = "";
    if ((CMUIX_LaunchSource != CMUIX_LAUNCH_SOURCE_PROFILE) || (CMUIX_ProfileLaunchCounted == true) || (CMUIX_ProfileRawConfig == "")) {
        return;
    }

    if ((lv_name == "")) {
        lv_name = "Profile";
    }

    while ((lv_player <= 2) && (lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_key = "";
        if ((lv_player == CMUIX_ProfileSourceTemplatePlayer) && (CMUIX_HistoryProfileTemplateKeyExists(lv_player, CMUIX_ProfileSourceTemplateKey) == true)) {
            lv_key = CMUIX_ProfileSourceTemplateKey;
        }

        if ((lv_key == "")) {
            CMUIX_ProfileTemplateRecord(lv_player, lv_name, CMUIX_ProfileRawConfig, "Synced");
            lv_key = CMUIX_HistoryLastProfileTemplateKey;
        }

        if ((lv_key != "")) {
            CMUIX_ProfileTemplateIncrementPlayCount(lv_player, lv_key);
        }

        lv_player += 1;
    }

    CMUIX_ProfileLaunchCounted = true;
}

void CMUIX_HistoryDeleteProfileTemplate(int lp_player, string lp_key) {
    bank lv_bank;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return;
    }

    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Payload"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Name"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Map"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Source"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Certified"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|PlayCount"));
    BankKeyRemove(lv_bank, CMUIX_PROFILE_TEMPLATE_SECTION, (lp_key + "|Updated"));
    CMUIX_GameHistorySaveBank(lp_player);
    CMUIX_HistoryProfileSelectedKey[lp_player] = "";
    CMUIX_HistoryRefreshForPlayer(lp_player);
}

void CMUIX_HistoryDeleteRecord(int lp_player, string lp_key) {
    bank lv_bank;
    string lv_activeKey;

    lv_bank = CMUIX_GameHistoryOpenBank(lp_player);
    lv_activeKey = "";
    if ((lv_bank == null) || (lp_key == "") || (lp_key == null)) {
        return;
    }

    if ((BankKeyExists(lv_bank, CMUIX_HISTORY_SECTION, lp_key) == false)) {
        return;
    }

    lv_activeKey = CMUIX_PlayerProfileGetString(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey", "");
    CMUIX_HistoryRemoveRecordBankKeys(lv_bank, lp_key);
    if ((lv_activeKey == lp_key)) {
        BankKeyRemove(lv_bank, CMUIX_HISTORY_SECTION, "ActiveKey");
    }

    CMUIX_GameHistorySaveBank(lp_player);
    CMUIX_HistoryRecordSelectedKey[lp_player] = "";
    CMUIX_ProfileMessage(lp_player, "历史记录已删除。");
    CMUIX_HistoryRefreshForPlayer(lp_player);
}

bool CMUIX_HistorySaveSelectedRecordAsTemplateWithName(int lp_player, string lp_name) {
    string lv_payload;
    string lv_name;

    lv_payload = CMUIX_HistoryRecordPayloadForKey(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]);
    lv_name = lp_name;
    if ((lv_payload == "") || (lv_payload == null)) {
        CMUIX_ProfileMessage(lp_player, "请先选择一条历史记录。");
        return false;
    }

    CMUIX_ProfileTemplateRecord(lp_player, lv_name, lv_payload, "History");
    return true;
}

bool CMUIX_HistorySaveSelectedRecordAsTemplate(int lp_player) {
    return CMUIX_HistorySaveSelectedRecordAsTemplateWithName(lp_player, "");
}

bool CMUIX_HistorySaveSelectedRecordAsTemplateFromControl(int lp_player) {
    playergroup lv_players;
    string lv_name;

    lv_players = PlayerGroupSingle(lp_player);
    lv_name = "";
    if ((CMUIX_HistoryRecordPayloadForKey(lp_player, CMUIX_HistoryRecordSelectedKey[lp_player]) == "")) {
        CMUIX_SetControlText(CMUIX_HistorySaveRecordTemplateStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/SaveRecordTemplate/StatusNoSelection"));
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_HistorySaveRecordTemplateNameEditBox) == true)) {
        lv_name = libNtve_gf_DialogItemEditValue(CMUIX_HistorySaveRecordTemplateNameEditBox, lp_player);
    }

    if ((CMUIX_HistorySaveSelectedRecordAsTemplateWithName(lp_player, lv_name) == false)) {
        CMUIX_SetControlText(CMUIX_HistorySaveRecordTemplateStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/SaveRecordTemplate/StatusNoSelection"));
        return false;
    }

    if ((CMUIX_HistoryLastProfileTemplateCreated == false)) {
        CMUIX_SetControlText(CMUIX_HistorySaveRecordTemplateStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/SaveRecordTemplate/StatusDuplicate"));
    }
    else {
        CMUIX_SetControlText(CMUIX_HistorySaveRecordTemplateStatusLabel, lv_players, StringExternal("CMUI/ScreenHistory/SaveRecordTemplate/StatusSaved"));
    }

    return true;
}

bool CMUIX_HistorySuggestSelectedTemplate(int lp_player) {
    string lv_payload;
    string lv_body;
    string lv_name;

    lv_payload = "";
    lv_body = "";
    lv_name = "";
    if ((CMUIX_HistoryPlayerTwoShouldSuggest(lp_player) == false)) {
        CMUIX_ProfileMessage(lp_player, "当前没有可接收建议的玩家1。");
        return false;
    }

    if ((CMUIX_HistoryViewingProfiles[lp_player] == false)) {
        CMUIX_ProfileMessage(lp_player, "请先切换到模板记录页面。");
        return false;
    }

    lv_payload = CMUIX_HistoryProfilePayloadForKey(lp_player, CMUIX_HistoryProfileSelectedKey[lp_player]);
    if ((lv_payload == "") || (lv_payload == null)) {
        CMUIX_ProfileMessage(lp_player, "请先选择一个模板。");
        return false;
    }

    lv_body = CMUIX_HistoryBodyFromPayload(lv_payload);
    lv_name = CMUIX_HistoryNameValueFromBody(lv_body);
    if ((lv_name == "") || (lv_name == null)) {
        lv_name = "Profile";
    }

    CMUIX_HistorySuggestedTemplatePlayer = lp_player;
    CMUIX_HistorySuggestedTemplateName = lv_name;
    CMUIX_HistorySuggestedTemplatePayload = lv_payload;
    CMUIX_ProfileMessage(lp_player, ("模板建议已发送给玩家1：" + lv_name + "。"));
    CMUIX_ProfileMessage(1, ("玩家2建议模板：" + lv_name + "。请在历史记录界面点击“接受建议”。"));
    CMUIX_HistoryRefreshForPlayer(lp_player);
    CMUIX_HistoryRefreshForPlayer(1);
    return true;
}

bool CMUIX_HistoryAcceptSuggestedTemplate(int lp_player) {
    string lv_payload;
    string lv_name;

    lv_payload = CMUIX_HistorySuggestedTemplatePayload;
    lv_name = CMUIX_HistorySuggestedTemplateName;
    if ((lp_player != 1)) {
        return false;
    }

    if ((lv_payload == "") || (lv_payload == null) || (CMUIX_HistorySuggestedTemplatePlayer != 2)) {
        CMUIX_ProfileMessage(lp_player, "当前没有待接受的模板建议。");
        return false;
    }

    if ((lv_name == "") || (lv_name == null)) {
        lv_name = "Profile";
    }

    CMUIX_ProfileTemplateRecord(lp_player, lv_name, lv_payload, "Suggested");
    CMUIX_HistorySuggestedTemplatePlayer = 0;
    CMUIX_HistorySuggestedTemplateName = "";
    CMUIX_HistorySuggestedTemplatePayload = "";
    if ((PlayerStatus(2) == c_playerStatusActive)) {
        CMUIX_ProfileMessage(2, ("玩家1已接受模板建议：" + lv_name + "。"));
    }

    CMUIX_HistoryRefreshAll();
    return true;
}

