    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer");
    CMUIX_ConsoleRootContainer = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(CMUIX_ConsoleRootContainer) == false)) {
        CMUIX_ConsoleEntryButton = c_invalidDialogControlId;
        if ((lv_oldRoot != CMUIX_ConsoleRootContainer) || (lv_oldEntry != CMUIX_ConsoleEntryButton)) {
