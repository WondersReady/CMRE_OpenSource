bool CMUICore_IsControlValid(int lp_control) {
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }

    return true;
}

void CMUIX_PreloadForegroundCommanderModels() {
    if ((CMUIX_ForegroundCommanderModelsPreloaded == true)) {
        return;
    }

    CMUIX_ForegroundCommanderModelsPreloaded = true;
    PreloadModel("Assets\\StoryModeCharacters\\Protoss\\SMX2_Artanis_T1\\SMX2_Artanis_T1.m3", false);
    PreloadModel("Assets\\StoryModeCharacters\\Protoss\\SMX2_Artanis_T1_RequiredAnims\\SMX2_Artanis_T1_RequiredAnims.m3a", false);
    PreloadModel("Assets\\StoryModeCharacters\\Protoss\\SMX2_Artanis_T1_FacialAnims\\SMX2_Artanis_T1_FacialAnims.m3a", false);
    PreloadModel("Assets\\StoryModeCharacters\\Protoss\\SMX2_Artanis_T1_InteractiveAnims\\SMX2_Artanis_T1_InteractiveAnims.m3a", false);
    PreloadModel("Assets\\Units\\Test\\InvisibleUnit\\InvisibleUnit.m3", false);
