// Custom mutator pool UI edits draft arrays first. Accept writes the draft back
// to runtime UserData and persists only differences from the default pools.
int CMUIX_MutatorPoolClampPool(int lp_pool) {
    if ((lp_pool < CMUIX_MUTATOR_POOL_RANDOM)) {
        return CMUIX_MUTATOR_POOL_RANDOM;
    }

    if ((lp_pool > CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return CMUIX_MUTATOR_POOL_BRUTAL_PLUS;
    }

    return lp_pool;
}

int CMUIX_MutatorPoolPoolForView(int lp_view) {
    if ((lp_view == 2)) {
        return CMUIX_MUTATOR_POOL_CYCLE;
    }

    if ((lp_view == 3)) {
        return CMUIX_MUTATOR_POOL_BRUTAL_PLUS;
    }

    return CMUIX_MUTATOR_POOL_RANDOM;
}

int CMUIX_MutatorPoolViewForPool(int lp_pool) {
    int lv_pool;

    lv_pool = CMUIX_MutatorPoolClampPool(lp_pool);
    if ((lv_pool == CMUIX_MUTATOR_POOL_CYCLE)) {
        return 2;
    }

    if ((lv_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return 3;
    }

    return 1;
}

string CMUIX_MutatorPoolStateName(int lp_pool) {
    if ((lp_pool == CMUIX_MUTATOR_POOL_CYCLE)) {
        return "Cycle";
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return "BrutalPlus";
    }

    return "Random";
}

string CMUIX_MutatorPoolNormalField(int lp_pool) {
    if ((lp_pool == CMUIX_MUTATOR_POOL_CYCLE)) {
        return "Pool Cycle - Allowed";
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return "Pool Brutal Plus - Allowed";
    }

    return "Pool Random - Allowed";
}

string CMUIX_MutatorPoolEnhanceField(int lp_pool) {
    if ((lp_pool == CMUIX_MUTATOR_POOL_CYCLE)) {
        return "Pool Cycle - Enhance Allowed";
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return "Pool Brutal Plus - Enhance Allowed";
    }

    return "Pool Random - Enhance Allowed";
}

string CMUIX_MutatorPoolDefaultNormalField(int lp_pool) {
    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return "Pool Brutal Plus - Default Allowed";
    }

    return "Pool Random - Default Allowed";
}

bool CMUIX_MutatorPoolIsPlaceholder(string lp_mutator) {
    if ((lp_mutator == CMUIX_MUTATOR_POOL_PLACEHOLDER_RANDOM)) {
        return true;
    }

    if ((lp_mutator == CMUIX_MUTATOR_POOL_PLACEHOLDER_CHAOS)) {
        return true;
    }

    return false;
}

void CMUIX_MutatorPoolClearPlaceholderRuntimeFields(string lp_mutator) {
    if ((CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == false)) {
        return;
    }

    UserDataSetInt("Mutators", lp_mutator, "Pool Random - Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Cycle - Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Cycle - First Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Brutal Plus - Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Random - Enhance Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Cycle - Enhance Allowed", 1, 0);
    UserDataSetInt("Mutators", lp_mutator, "Pool Brutal Plus - Enhance Allowed", 1, 0);
}

void CMUIX_MutatorPoolClearAllPlaceholderRuntimeFields() {
    CMUIX_MutatorPoolClearPlaceholderRuntimeFields(CMUIX_MUTATOR_POOL_PLACEHOLDER_RANDOM);
    CMUIX_MutatorPoolClearPlaceholderRuntimeFields(CMUIX_MUTATOR_POOL_PLACEHOLDER_CHAOS);
}

bool CMUIX_MutatorPoolRuntimeFieldsHaveValues() {
    int lv_index;
    int lv_count;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_mutator = "";
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            if ((UserDataGetInt("Mutators", lv_mutator, "Pool Random - Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Cycle - Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Cycle - First Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Brutal Plus - Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Random - Enhance Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Cycle - Enhance Allowed", 1) != 0) ||
                (UserDataGetInt("Mutators", lv_mutator, "Pool Brutal Plus - Enhance Allowed", 1) != 0)) {
                return true;
            }
        }

        lv_index += 1;
    }

    return false;
}

void CMUIX_MutatorPoolEnsureRuntimeDefaults() {
    if ((CMUIX_MutatorPoolDefaultsChecked == true)) {
        return;
    }

    CMUIX_MutatorPoolDefaultsChecked = true;
    if ((CMUIX_MutatorPoolRuntimeFieldsHaveValues() == false)) {
        libCOMU_gf_CT_InitMutatorUserPoolsFromDefaults();
    }

    CMUIX_MutatorPoolClearAllPlaceholderRuntimeFields();
}

int CMUIX_MutatorPoolIndexForMutator(string lp_mutator) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        if ((UserDataInstance("Mutators", lv_index) == lp_mutator)) {
            return lv_index;
        }

        lv_index += 1;
    }

    return 0;
}

void CMUIX_MutatorPoolLoadDraftFromUserData() {
    int lv_index;
    int lv_count;
    int lv_pool;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_pool = 1;
    lv_mutator = "";
    CMUIX_MutatorPoolEnsureRuntimeDefaults();
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        lv_pool = CMUIX_MUTATOR_POOL_RANDOM;
        while ((lv_pool <= CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
            if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
                CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index] = 0;
                CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index] = 0;
            }
            else {
                CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index] = UserDataGetInt("Mutators", lv_mutator, CMUIX_MutatorPoolNormalField(lv_pool), 1);
                CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index] = UserDataGetInt("Mutators", lv_mutator, CMUIX_MutatorPoolEnhanceField(lv_pool), 1);
            }

            CMUIX_MutatorPoolDraftFirst[lv_pool][lv_index] = 0;
            lv_pool += 1;
        }

        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
            CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = 0;
        }
        else {
            CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = UserDataGetInt("Mutators", lv_mutator, "Pool Cycle - First Allowed", 1);
        }

        lv_index += 1;
    }

    CMUIX_MutatorPoolDraftReady = true;
}

void CMUIX_MutatorPoolEnsureDraft() {
    if ((CMUIX_MutatorPoolDraftReady == false)) {
        CMUIX_MutatorPoolLoadDraftFromUserData();
    }
}

void CMUIX_MutatorPoolApplyDraftToUserData() {
    int lv_index;
    int lv_count;
    int lv_pool;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_pool = 1;
    lv_mutator = "";
    CMUIX_MutatorPoolEnsureDraft();
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        lv_pool = CMUIX_MUTATOR_POOL_RANDOM;
        while ((lv_pool <= CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
            if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
                CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index] = 0;
                CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index] = 0;
            }

            UserDataSetInt("Mutators", lv_mutator, CMUIX_MutatorPoolNormalField(lv_pool), 1, CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index]);
            UserDataSetInt("Mutators", lv_mutator, CMUIX_MutatorPoolEnhanceField(lv_pool), 1, CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index]);
            lv_pool += 1;
        }

        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
            CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = 0;
        }

        UserDataSetInt("Mutators", lv_mutator, "Pool Cycle - First Allowed", 1, CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index]);
        lv_index += 1;
    }
}

bank CMUIX_PlayerProfileOpenBank(int lp_player) {
    bank lv_bank;

    lv_bank = null;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return null;
    }

    if ((CMUIX_PlayerProfileBank[lp_player] != null)) {
        return CMUIX_PlayerProfileBank[lp_player];
    }

    BankLoad(CMUIX_PROFILE_BANK, lp_player);
    lv_bank = BankLastCreated();
    if ((lv_bank != null)) {
        BankWait(lv_bank);
        CMUIX_PlayerProfileBank[lp_player] = lv_bank;
    }

    return lv_bank;
}

void CMUIX_PlayerProfileSaveBank(int lp_player) {
    bank lv_bank;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    BankSave(lv_bank);
}

int CMUIX_PlayerProfileGetInt(bank lp_bank, string lp_section, string lp_key, int lp_default) {
    if ((lp_bank == null)) {
        return lp_default;
    }

    if ((BankKeyExists(lp_bank, lp_section, lp_key) == false)) {
        return lp_default;
    }

    return BankValueGetAsInt(lp_bank, lp_section, lp_key);
}

string CMUIX_PlayerProfileGetString(bank lp_bank, string lp_section, string lp_key, string lp_default) {
    if ((lp_bank == null)) {
        return lp_default;
    }

    if ((BankKeyExists(lp_bank, lp_section, lp_key) == false)) {
        return lp_default;
    }

    return BankValueGetAsString(lp_bank, lp_section, lp_key);
}

string CMUIX_PlayerProfileCommanderSection(string lp_commander) {
    return (CMUIX_PROFILE_SECTION_COMMANDER_PREFIX + lp_commander);
}

string CMUIX_ProfileMasteryKey(string lp_masteryUpgrade) {
    return ("Mastery|" + lp_masteryUpgrade);
}

string CMUIX_ProfileMutatorPoolKey(string lp_mutator, string lp_suffix) {
    return ("Mutator|" + lp_mutator + "|" + lp_suffix);
}

int CMUIX_PlayerProfileMutatorPoolBankPlayer() {
    return CMUIX_AccessSharedSetupPlayer();
}

int CMUIX_MutatorPoolDefaultNormalValue(int lp_pool, string lp_mutator) {
    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        return UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Default Allowed", 1);
    }

    return UserDataGetInt("Mutators", lp_mutator, "Pool Random - Default Allowed", 1);
}

int CMUIX_MutatorPoolDefaultEnhanceValue(int lp_pool, string lp_mutator) {
    return 0;
}

int CMUIX_MutatorPoolDefaultFirstValue(string lp_mutator) {
    return UserDataGetInt("Mutators", lp_mutator, "Pool Cycle - Default First Allowed", 1);
}

void CMUIX_PlayerProfileSetMutatorPoolDeltaInt(bank lp_bank, string lp_key, int lp_value, int lp_default) {
    if ((lp_bank == null) || (lp_key == "") || (lp_key == null)) {
        return;
    }

    if ((lp_value == lp_default)) {
        if ((BankKeyExists(lp_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, lp_key) == true)) {
            BankKeyRemove(lp_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, lp_key);
        }

        return;
    }

    BankValueSetFromInt(lp_bank, CMUIX_PROFILE_SECTION_MUTATOR_POOLS, lp_key, lp_value);
}

string CMUIX_VoicePackNameKey(string lp_voicePack, int lp_player) {
    if ((lp_voicePack == "") || (lp_voicePack == null)) {
        return "";
    }

    if ((CatalogEntryIsValid(c_gameCatalogVoicePack, lp_voicePack) == false)) {
        return "";
    }

    return ("VoicePack/Name/" + lp_voicePack);
}

text CMUIX_VoicePackDisplayName(string lp_voicePack, int lp_player) {
    string lv_nameKey;

    lv_nameKey = CMUIX_VoicePackNameKey(lp_voicePack, lp_player);
    if ((lv_nameKey == "") || (lv_nameKey == null)) {
        if ((lp_voicePack == "") || (lp_voicePack == null)) {
            return StringExternal("CMUI/CommanderCustomizationSelectionPanel/AnnouncerDefault");
        }

        return StringToText(lp_voicePack);
    }

    return (StringExternal(lv_nameKey) + StringExternal("CMUI/CommanderCustomizationSelectionPanel/VoicePackSuffix"));
}

string CMUIX_VoicePackNormalize(string lp_voicePack) {
    string lv_voicePack;

    lv_voicePack = lp_voicePack;
    if ((lv_voicePack == null)) {
        return "";
    }

    if ((lv_voicePack == "eSports")) {
        return "";
    }

    if ((lv_voicePack != "") && (CatalogEntryIsValid(c_gameCatalogVoicePack, lv_voicePack) == false)) {
        return "";
    }

    return lv_voicePack;
}

string CMUIX_VoicePackDefaultForCommander(string lp_commander) {
    string lv_voicePack;

    lv_voicePack = "";
    if ((lp_commander == "") || (lp_commander == null)) {
        return "";
    }

    lv_voicePack = UserDataGetGameLink("PlayerCommanders", lp_commander, "CA - Voice Pack", 1);
    return CMUIX_VoicePackNormalize(lv_voicePack);
}

void CMUIX_VoicePackApplyRuntimeForCommander(string lp_commander, string lp_voicePack) {
    string lv_voicePack;

    lv_voicePack = CMUIX_VoicePackNormalize(lp_voicePack);
    if ((lp_commander == "") || (lp_commander == null)) {
        return;
    }

    UserDataSetGameLink("PlayerCommanders", lp_commander, "User - Voice Pack", 1, lv_voicePack);
}

string CMUIX_VoicePackForPlayerCommander(int lp_player, string lp_commander) {
    bank lv_bank;
    string lv_section;
    string lv_voicePack;

    lv_bank = null;
    lv_section = "";
    lv_voicePack = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return "";
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return "";
    }

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return "";
    }

    lv_section = CMUIX_PlayerProfileCommanderSection(lp_commander);
    lv_voicePack = CMUIX_PlayerProfileGetString(lv_bank, lv_section, "VoicePack", "");
    return CMUIX_VoicePackNormalize(lv_voicePack);
}

string CMUIX_VoicePackRuntimeForPlayerCommander(int lp_player, string lp_commander) {
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_VoicePackTemporaryActive[lp_player] == true) && (CMUIX_VoicePackTemporaryCommander[lp_player] == lp_commander)) {
            return CMUIX_VoicePackTemporaryValue[lp_player];
        }
    }

    return CMUIX_VoicePackForPlayerCommander(lp_player, lp_commander);
}

string CMUIX_VoicePackEffectiveForPlayerCommander(int lp_player, string lp_commander) {
    string lv_voicePack;

    lv_voicePack = CMUIX_VoicePackRuntimeForPlayerCommander(lp_player, lp_commander);
    if ((lv_voicePack != "")) {
        return lv_voicePack;
    }

    return CMUIX_VoicePackDefaultForCommander(lp_commander);
}

void CMUIX_VoicePackSetTemporaryForPlayerCommander(int lp_player, string lp_commander, string lp_voicePack) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_VoicePackTemporaryActive[lp_player] = true;
    CMUIX_VoicePackTemporaryCommander[lp_player] = lp_commander;
    CMUIX_VoicePackTemporaryValue[lp_player] = CMUIX_VoicePackNormalize(lp_voicePack);
    CMUIX_VoicePackApplyRuntimeForCommander(lp_commander, CMUIX_VoicePackTemporaryValue[lp_player]);
}

void CMUIX_VoicePackClearTemporaryForPlayer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_VoicePackTemporaryActive[lp_player] = false;
    CMUIX_VoicePackTemporaryCommander[lp_player] = "";
    CMUIX_VoicePackTemporaryValue[lp_player] = "";
}

void CMUIX_VoicePackSetForPlayerCommander(int lp_player, string lp_commander, string lp_voicePack) {
    bank lv_bank;
    string lv_section;
    string lv_voicePack;

    lv_bank = null;
    lv_section = "";
    lv_voicePack = CMUIX_VoicePackNormalize(lp_voicePack);
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_commander == "") || (lp_commander == null)) {
        return;
    }

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return;
    }

    lv_section = CMUIX_PlayerProfileCommanderSection(lp_commander);
    BankSectionRemove(lv_bank, lv_section);
    if ((lv_voicePack != "")) {
        BankValueSetFromString(lv_bank, lv_section, "VoicePack", lv_voicePack);
    }

    CMUIX_VoicePackApplyRuntimeForCommander(lp_commander, lv_voicePack);
    CMUIX_PlayerProfileSaveBank(lp_player);
}

string CMUIX_VoicePackUserForCommander(string lp_commander) {
    return CMUIX_VoicePackForPlayerCommander(1, lp_commander);
}

void CMUIX_VoicePackSetForCommander(string lp_commander, string lp_voicePack) {
    CMUIX_VoicePackSetForPlayerCommander(1, lp_commander, lp_voicePack);
}

bool CMUIX_VoicePackAllowedForPersonalization(string lp_voicePack) {
    if ((lp_voicePack == "") || (lp_voicePack == null)) {
        return false;
    }

    if ((lp_voicePack == "eSports")) {
        return false;
    }

    return CatalogEntryIsValid(c_gameCatalogVoicePack, lp_voicePack);
}

bool CMUIX_OptimizationExists(string lp_optimization) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CMUIOptimizations");
    if ((lp_optimization == "") || (lp_optimization == null)) {
        return false;
    }

    if ((lp_optimization == "[Default]")) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        if ((UserDataInstance("CMUIOptimizations", lv_index) == lp_optimization)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

bool CMUIX_OptimizationIsListInstance(string lp_optimization) {
    if ((lp_optimization == "") || (lp_optimization == null)) {
        return false;
    }

    if ((lp_optimization == "[Default]")) {
        return false;
    }

    return true;
}

string CMUIX_OptimizationScope(string lp_optimization) {
    string lv_scope;

    lv_scope = "";
    if ((CMUIX_OptimizationExists(lp_optimization) == false)) {
        return "";
    }

    lv_scope = UserDataGetString("CMUIOptimizations", lp_optimization, "Scope", 1);
    if ((lv_scope == "") || (lv_scope == null) || (lv_scope == "[Default]")) {
        return CMUIX_OPTIMIZATION_SCOPE_GLOBAL;
    }

    return lv_scope;
}

string CMUIX_OptimizationCommander(string lp_optimization) {
    if ((CMUIX_OptimizationExists(lp_optimization) == false)) {
        return "";
    }

    return UserDataGetUserInstance("CMUIOptimizations", lp_optimization, "Commander", 1);
}

bool CMUIX_OptimizationCommanderMatches(string lp_optimization, string lp_commander) {
    int lv_index;
    int lv_count;
    string lv_commander;

    lv_index = 1;
    lv_count = UserDataFieldValueCount("CMUIOptimizations", "Commander");
    lv_commander = "";
    if ((CMUIX_OptimizationExists(lp_optimization) == false) || (lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        lv_commander = UserDataGetUserInstance("CMUIOptimizations", lp_optimization, "Commander", lv_index);
        if ((lv_commander != "") && (lv_commander != null) && (lv_commander != "[Default]") && (lv_commander == lp_commander)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

int CMUIX_OptimizationDefaultEnabled(string lp_optimization) {
    int lv_value;

    if ((CMUIX_OptimizationExists(lp_optimization) == false)) {
        return 0;
    }

    lv_value = UserDataGetInt("CMUIOptimizations", lp_optimization, "Default Enabled", 1);
    if ((lv_value != 0)) {
        return lv_value;
    }

    return UserDataGetInt("CMUIOptimizations", "[Default]", "Default Enabled", 1);
}

bool CMUIX_OptimizationRaceDefaultTransmissionForced(string lp_commander) {
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((CMPE_EventRegistryHasAnyHandler() == false)) {
        return false;
    }

    if ((CMPE_CommanderEventHasHandler(lp_commander, "Commander.Initial.After") == true)) {
        return false;
    }

    return true;
}

bool CMUIX_OptimizationRaceDefaultTransmissionShouldShow(string lp_commander) {
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((CMPE_EventRegistryHasAnyHandler() == false)) {
        return false;
    }

    return (CMPE_CommanderEventHasHandler(lp_commander, "Commander.Initial.After") == false);
}

bool CMUIX_OptimizationShouldShowForCommander(string lp_optimization, string lp_commander) {
    string lv_scope;

    lv_scope = CMUIX_OptimizationScope(lp_optimization);
    if ((lv_scope == "")) {
        return false;
    }

    if ((lp_optimization == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionShouldShow(lp_commander) == false)) {
        return false;
    }

    if ((lv_scope == CMUIX_OPTIMIZATION_SCOPE_GLOBAL)) {
        return true;
    }

    if ((lv_scope == CMUIX_OPTIMIZATION_SCOPE_COMMANDER)) {
        if ((CMUIX_OptimizationCommanderMatches(lp_optimization, lp_commander) == true)) {
            return true;
        }
    }

    return false;
}

text CMUIX_OptimizationName(string lp_optimization) {
    if ((CMUIX_OptimizationExists(lp_optimization) == false)) {
        return StringToText(lp_optimization);
    }

    return UserDataGetText("CMUIOptimizations", lp_optimization, "Name", 1);
}

text CMUIX_OptimizationDescription(string lp_optimization) {
    if ((CMUIX_OptimizationExists(lp_optimization) == false)) {
        return StringToText("");
    }

    return UserDataGetText("CMUIOptimizations", lp_optimization, "Description", 1);
}

string CMUIX_ProfileOptimizationKey(string lp_commander, string lp_optimization) {
    if ((CMUIX_OptimizationScope(lp_optimization) == CMUIX_OPTIMIZATION_SCOPE_COMMANDER)) {
        return ("Commander|" + lp_commander + "|" + lp_optimization);
    }

    return ("Global|" + lp_optimization);
}

bool CMUIX_OptimizationMasterEnabled(int lp_player) {
    bank lv_bank;

    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_OptimizationTemporaryActive[lp_player] == true)) {
            return CMUIX_OptimizationTemporaryMasterEnabled[lp_player];
        }
    }

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    if ((lv_bank == null)) {
        return (CMUIX_DefaultOptimizationMasterEnabled() != 0);
    }

    return (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_OPTIMIZATIONS, "MasterEnabled", CMUIX_DefaultOptimizationMasterEnabled()) != 0);
}

void CMUIX_OptimizationSetMasterEnabled(int lp_player, bool lp_enabled) {
    bank lv_bank;
    int lv_value;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_value = 0;
    if ((lp_enabled == true)) {
        lv_value = 1;
    }

    if ((lv_bank == null)) {
        return;
    }

    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_SECTION_OPTIMIZATIONS, "MasterEnabled", lv_value);
    BankSave(lv_bank);
}

bool CMUIX_OptimizationRawEnabled(int lp_player, string lp_commander, string lp_optimization) {
    bank lv_bank;
    string lv_key;
    int lv_default;
    int lv_slot;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_key = "";
    lv_default = CMUIX_OptimizationDefaultEnabled(lp_optimization);
    lv_slot = 1;
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_OptimizationTemporaryActive[lp_player] == true)) {
            while ((lv_slot <= CMUIX_OptimizationTemporaryCount[lp_player]) && (lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
                if ((CMUIX_OptimizationTemporaryIds[lp_player][lv_slot] == lp_optimization)) {
                    return CMUIX_OptimizationTemporaryValues[lp_player][lv_slot];
                }

                lv_slot += 1;
            }

            return (lv_default != 0);
        }
    }

    if ((lv_bank == null)) {
        return (lv_default != 0);
    }

    lv_key = CMUIX_ProfileOptimizationKey(lp_commander, lp_optimization);
    return (CMUIX_PlayerProfileGetInt(lv_bank, CMUIX_PROFILE_SECTION_OPTIMIZATIONS, lv_key, lv_default) != 0);
}

void CMUIX_OptimizationSetRawEnabled(int lp_player, string lp_commander, string lp_optimization, bool lp_enabled) {
    bank lv_bank;
    string lv_key;
    int lv_value;

    lv_bank = CMUIX_PlayerProfileOpenBank(lp_player);
    lv_key = "";
    lv_value = 0;
    if ((lp_enabled == true)) {
        lv_value = 1;
    }

    if ((lv_bank == null)) {
        return;
    }

    lv_key = CMUIX_ProfileOptimizationKey(lp_commander, lp_optimization);
    BankValueSetFromInt(lv_bank, CMUIX_PROFILE_SECTION_OPTIMIZATIONS, lv_key, lv_value);
    BankSave(lv_bank);
}

void CMUIX_OptimizationClearTemporaryForPlayer(int lp_player) {
    int lv_slot;

    lv_slot = 1;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_OptimizationTemporaryActive[lp_player] = false;
    CMUIX_OptimizationTemporaryMasterEnabled[lp_player] = false;
    CMUIX_OptimizationTemporaryCount[lp_player] = 0;
    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        CMUIX_OptimizationTemporaryIds[lp_player][lv_slot] = "";
        CMUIX_OptimizationTemporaryValues[lp_player][lv_slot] = false;
        lv_slot += 1;
    }
}

void CMUIX_OptimizationSetTemporaryFromDrafts(int lp_operator, int lp_targetPlayer) {
    int lv_slot;
    int lv_count;

    lv_slot = 1;
    lv_count = CMUIX_PersonalizationOptimizationCount[lp_operator];
    if ((lp_operator < 1) || (lp_operator > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lp_targetPlayer < 1) || (lp_targetPlayer > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_OptimizationClearTemporaryForPlayer(lp_targetPlayer);
    CMUIX_OptimizationTemporaryActive[lp_targetPlayer] = true;
    CMUIX_OptimizationTemporaryMasterEnabled[lp_targetPlayer] = CMUIX_PersonalizationOptimizationMasterDraft[lp_operator];
    if ((lv_count > CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        lv_count = CMUIX_PERSONALIZATION_OPTIMIZATION_MAX;
    }

    CMUIX_OptimizationTemporaryCount[lp_targetPlayer] = lv_count;
    while ((lv_slot <= lv_count)) {
        CMUIX_OptimizationTemporaryIds[lp_targetPlayer][lv_slot] = CMUIX_PersonalizationOptimizationIds[lp_operator][lv_slot];
        CMUIX_OptimizationTemporaryValues[lp_targetPlayer][lv_slot] = CMUIX_PersonalizationOptimizationDrafts[lp_operator][lv_slot];
        lv_slot += 1;
    }
}

void CMUIX_CustomizationClearTemporaryForPlayer(int lp_player) {
    CMUIX_VoicePackClearTemporaryForPlayer(lp_player);
    CMUIX_OptimizationClearTemporaryForPlayer(lp_player);
}

void CMUIX_CustomizationClearTemporaryAll() {
    int lv_player;

    lv_player = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_CustomizationClearTemporaryForPlayer(lv_player);
        lv_player += 1;
    }
}

bool CMUIX_OptimizationEnabled(int lp_player, string lp_commander, string lp_optimization) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((lp_optimization == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionForced(lp_commander) == true)) {
        return true;
    }

    if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
        return false;
    }

    if ((CMUIX_OptimizationShouldShowForCommander(lp_optimization, lp_commander) == false)) {
        return false;
    }

    if ((CMUIX_OptimizationMasterEnabled(lp_player) == false)) {
        return false;
    }

    return CMUIX_OptimizationRawEnabled(lp_player, lp_commander, lp_optimization);
}

bool CMUIX_OptimizationAutoCreepSupportedCommander(string lp_commander) {
    if ((lp_commander == "ZergKerrigan") || (lp_commander == "ZergZagara")) {
        return true;
    }

    return false;
}

void CMUIX_OptimizationRefreshAutoCreepTriggerState() {
    int lv_player;
    bool lv_enabled;

    lv_player = 1;
    lv_enabled = false;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((TechTreeAbilityIsAllowed(lv_player, AbilityCommand("AutoCreepOn", 0)) == true)) {
            lv_enabled = true;
        }

        lv_player += 1;
    }

    if ((CMUIX_OptimizationAutoCreepTumorTrigger != null)) {
        TriggerEnable(CMUIX_OptimizationAutoCreepTumorTrigger, lv_enabled);
    }
}

void CMUIX_OptimizationSetAutoCreep(int lp_player, bool lp_enabled) {
    int lv_upgradeLevel;
    bool lv_effectiveEnabled;

    lv_upgradeLevel = 0;
    lv_effectiveEnabled = lp_enabled;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((lv_effectiveEnabled == true)) {
        lv_upgradeLevel = 1;
    }

    TechTreeAbilityAllow(lp_player, AbilityCommand("AutoCreepOn", 0), lv_effectiveEnabled);
    TechTreeAbilityAllow(lp_player, AbilityCommand("AutoCreepOff", 0), lv_effectiveEnabled);
    libNtve_gf_SetUpgradeLevelForPlayer(lp_player, "AutoCreep", lv_upgradeLevel);
    CMUIX_OptimizationRefreshAutoCreepTriggerState();
}

void CMUIX_OptimizationRefreshBiomassCountState() {
    int lv_player;
    bool lv_enabled;

    lv_player = 1;
    lv_enabled = false;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_OptimizationAbathurBiomassCountState[lv_player] == true)) {
            lv_enabled = true;
        }

        lv_player += 1;
    }

    CMUIX_OptimizationAbathurBiomassCountEnabled = lv_enabled;
}

void CMUIX_OptimizationSetAbathurBiomassCount(int lp_player, bool lp_enabled) {
    string lv_frame;

    lv_frame = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_OptimizationAbathurBiomassCountState[lp_player] = lp_enabled;
    CMUIX_OptimizationRefreshBiomassCountState();
    if ((lp_enabled == true)) {
        lv_frame = "Coop_UnitStatus/BiomassUnitStatusFrameRoach";
    }

    CatalogFieldValueSet(c_gameCatalogActor, "Roach", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "RoachVile", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "Mutalisk", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "Devourer", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "GuardianMP", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "RavagerAbathur", "CustomUnitStatusFrame", lp_player, lv_frame);
    CatalogFieldValueSet(c_gameCatalogActor, "SwarmHost", "CustomUnitStatusFrame", lp_player, lv_frame);
}

void CMUIX_OptimizationSetProductionPanel(int lp_player, bool lp_enabled) {
    int lv_control;
    string lv_playerString;
    playergroup lv_players;

    lv_control = c_invalidDialogControlId;
    lv_playerString = "";
    lv_players = PlayerGroupEmpty();
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    lv_playerString = "UIContainer/ConsoleUIContainer/PlayerBoxes_" + IntToString(lp_player);
    DialogControlHookupStandard(c_triggerControlTypePanel, lv_playerString);
    lv_control = DialogControlLastCreated();
    if ((lp_enabled == true)) {
        CMUIX_OptimizationProductionPanel[lp_player] = 1;
    }
    else {
        CMUIX_OptimizationProductionPanel[lp_player] = 0;
    }

    if ((CMUIX_IsControlValid(lv_control) == true)) {
        DialogControlSetVisible(lv_control, lv_players, lp_enabled);
    }
}

void CMUIX_OptimizationRefreshWarpButtonWatchState() {
    int lv_player;
    bool lv_anyEnabled;
    bool lv_anyHidden;
    string lv_commander;

    lv_player = 1;
    lv_anyEnabled = false;
    lv_anyHidden = false;
    lv_commander = "";
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_commander = CMUIX_OptimizationCommanderForApply(lv_player);
        if ((CMUIX_OptimizationShouldShowForCommander(CMUIX_OPTIMIZATION_WARP_BUTTON, lv_commander) == true)) {
            if ((CMUIX_OptimizationWarpButton[lv_player] != 0)) {
                lv_anyEnabled = true;
            }

            if ((PlayerGroupHasPlayer(CMUIX_OptimizationWarpButtonHiddenPlayers, lv_player) == true)) {
                lv_anyHidden = true;
            }
        }

        lv_player += 1;
    }

    if ((CMUIX_OptimizationWarpButtonWatchTrigger != null)) {
        TriggerEnable(CMUIX_OptimizationWarpButtonWatchTrigger, ((lv_anyEnabled == false) && (lv_anyHidden == true)));
    }
}

void CMUIX_OptimizationSetWarpButton(int lp_player, bool lp_enabled) {
    playergroup lv_players;
    string lv_commander;
    bool lv_supportedCommander;

    lv_players = PlayerGroupEmpty();
    lv_commander = "";
    lv_supportedCommander = false;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    lv_commander = CMUIX_OptimizationCommanderForApply(lp_player);
    lv_supportedCommander = CMUIX_OptimizationShouldShowForCommander(CMUIX_OPTIMIZATION_WARP_BUTTON, lv_commander);
    if ((lv_supportedCommander == false)) {
        CMUIX_OptimizationWarpButton[lp_player] = 0;
        PlayerGroupRemove(CMUIX_OptimizationWarpButtonHiddenPlayers, lp_player);
        CMUIX_OptimizationRefreshWarpButtonWatchState();
        return;
    }

    if ((lp_enabled == true)) {
        CMUIX_OptimizationWarpButton[lp_player] = 1;
        PlayerGroupRemove(CMUIX_OptimizationWarpButtonHiddenPlayers, lp_player);
        UISetFrameVisible(lv_players, c_syncFrameTypePylonButton, true);
        CMUIX_OptimizationRefreshWarpButtonWatchState();
        return;
    }

    CMUIX_OptimizationWarpButton[lp_player] = 0;
    PlayerGroupAdd(CMUIX_OptimizationWarpButtonHiddenPlayers, lp_player);
    UISetFrameVisible(lv_players, c_syncFrameTypePylonButton, false);
    CMUIX_OptimizationRefreshWarpButtonWatchState();
}

void CMUIX_OptimizationCreateKerriganTopbar(int lp_player) {
    unit lv_caster;

    lv_caster = null;
    libCOOC_gf_CC_SetPlayerGlobalPowerLink(lp_player, "ZergKerrigan");
    libCOUI_gv_cU_GPInitialized[lp_player] = false;
    libCOUI_gf_CU_GPInit(lp_player);
    libCOUI_gf_CU_Kerrigan_GlobalPower_UI(lp_player);
    lv_caster = libCOMI_gf_CM_PlayerGetGlobalCaster(lp_player);
    if ((UnitIsValid(lv_caster) == true)) {
        libCOUI_gf_CU_GPSetUnit(lv_caster, lp_player);
    }
    else {
        libCOMI_gf_CM_GlobalCasterCreateUnit(lp_player);
    }

    CMUIX_OptimizationKerriganNydusTopBarCreated[lp_player] = true;
}

bool CMUIX_KerriganNydusTopbarPlayerEnabled(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_OptimizationKerriganNydusTopBarState[lp_player] == 0)) {
        return false;
    }

    if ((CMUIX_OptimizationCommanderForApply(lp_player) != "ZergKerrigan")) {
        return false;
    }

    return true;
}

void CMUIX_KerriganNydusTopbarSetTriggersEnabled(bool lp_enabled) {
    if ((CMUIX_KerriganNydusNetworkBirthTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkBirthTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusNetworkConstructionTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkConstructionTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusNetworkDeathTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkDeathTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusTopbarTargetTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusTopbarTargetTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusNetworkBuildStartTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkBuildStartTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusNetworkReadyExpiredTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkReadyExpiredTrigger, lp_enabled);
    }

    if ((CMUIX_KerriganNydusNetworkUnloadHeroicTrigger != null)) {
        TriggerEnable(CMUIX_KerriganNydusNetworkUnloadHeroicTrigger, lp_enabled);
    }
}

void CMUIX_KerriganNydusTopbarRefreshTriggerState() {
    int lv_player;
    bool lv_enabled;

    lv_player = 1;
    lv_enabled = false;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == true)) {
            lv_enabled = true;
        }

        lv_player += 1;
    }

    CMUIX_KerriganNydusTopbarSetTriggersEnabled(lv_enabled);
}

void CMUIX_KerriganNydusTopbarForceChargeCount(int lp_player, int lp_charges) {
    unit lv_caster;
    fixed lv_currentCharges;
    fixed lv_targetCharges;

    lv_caster = libCOMI_gv_cM_GlobalCasterUnit[lp_player];
    lv_currentCharges = 0.0;
    lv_targetCharges = IntToFixed(lp_charges);
    if ((UnitIsValid(lv_caster) == false)) {
        return;
    }

    lv_currentCharges = UnitAbilityChargeInfo(lv_caster, AbilityCommand("KerriganNydusTopBar", 0), c_unitAbilChargeCountLeft);
    if ((lv_currentCharges != lv_targetCharges)) {
        PlayerAddChargeUsed(lp_player, "Abil/KerriganNydusTopBar", (lv_currentCharges - lv_targetCharges));
    }
}

bool CMUIX_KerriganNydusTopbarUnitIsNetwork(unit lp_unit) {
    string lv_unitType;

    lv_unitType = "";
    if ((UnitIsValid(lp_unit) == false)) {
        return false;
    }

    lv_unitType = UnitGetType(lp_unit);
    if ((lv_unitType == "NydusNetwork") || (lv_unitType == "NydusNetworkAlly")) {
        return true;
    }

    return false;
}

void CMUIX_KerriganNydusTopbarRefresh(int lp_player) {
    unit lv_caster;
    unit lv_unit;
    unitgroup lv_scanGroup;
    int lv_index;
    int lv_readyCount;
    int lv_totalCount;
    int lv_cooldownCount;
    fixed lv_smallestCooldown;
    unitfilter lv_filter;

    lv_caster = null;
    lv_unit = null;
    lv_scanGroup = UnitGroupEmpty();
    lv_filter = UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterUnderConstruction - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)));
    lv_index = 0;
    lv_readyCount = 0;
    lv_totalCount = 0;
    lv_cooldownCount = 0;
    lv_smallestCooldown = CMUIX_KERRIGAN_NYDUS_TOPBAR_COOLDOWN_MAX;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    UnitGroupClear(CMUIX_KerriganNydusNetwork[lp_player]);
    UnitGroupClear(CMUIX_KerriganNydusNetworkReady[lp_player]);
    UnitGroupAddUnitGroup(lv_scanGroup, UnitGroup("NydusNetwork", lp_player, RegionEntireMap(), lv_filter, 0));
    UnitGroupAddUnitGroup(lv_scanGroup, UnitGroup("NydusNetworkAlly", lp_player, RegionEntireMap(), lv_filter, 0));
    lv_index = UnitGroupCount(lv_scanGroup, c_unitCountAll);
    while ((true == true)) {
        lv_unit = UnitGroupUnitFromEnd(lv_scanGroup, lv_index);
        if ((lv_unit == null)) {
            break;
        }

        if ((UnitIsAlive(lv_unit) == true) && (UnitHasBehavior2(lv_unit, "UnderConstruction") == false)) {
            UnitGroupAdd(CMUIX_KerriganNydusNetwork[lp_player], lv_unit);
            lv_totalCount += 1;
            if ((UnitHasBehavior2(lv_unit, "KerriganNydusNetworkReady") == true)) {
                lv_cooldownCount += 1;
                if ((UnitBehaviorDuration(lv_unit, "KerriganNydusNetworkReady") < lv_smallestCooldown)) {
                    lv_smallestCooldown = UnitBehaviorDuration(lv_unit, "KerriganNydusNetworkReady");
                }
            }
            else {
                UnitGroupAdd(CMUIX_KerriganNydusNetworkReady[lp_player], lv_unit);
                lv_readyCount += 1;
            }
        }

        lv_index -= 1;
    }

    CMUIX_KerriganNydusNetworkTotalCount[lp_player] = lv_totalCount;
    CMUIX_KerriganNydusNetworkReadyCount[lp_player] = lv_readyCount;
    lv_caster = libCOMI_gv_cM_GlobalCasterUnit[lp_player];
    if ((UnitIsValid(lv_caster) == false)) {
        return;
    }

    UnitAbilityReset(lv_caster, AbilityCommand("KerriganNydusTopBar", 0), c_spendLocationAbility);
    if ((lv_readyCount <= 0) && (lv_cooldownCount > 0) && (lv_smallestCooldown > 0.0)) {
        UnitAbilityAddCooldown(lv_caster, "KerriganNydusTopBar", "Abil/KerriganNydusTopBarCooldown", CMUIX_KERRIGAN_NYDUS_TOPBAR_COOLDOWN_MAX);
        UnitAbilityAddCooldown(lv_caster, "KerriganNydusTopBar", "Abil/KerriganNydusTopBarCooldown", (-1.0 * (CMUIX_KERRIGAN_NYDUS_TOPBAR_COOLDOWN_MAX - lv_smallestCooldown)));
        UnitAbilityReset(lv_caster, AbilityCommand("KerriganNydusTopBarDummyTimer", 0), c_spendLocationAbility);
        UnitAbilityAddCooldown(lv_caster, "KerriganNydusTopBarDummyTimer", "Abil/KerriganNydusTopBarDummyTimer", CMUIX_KERRIGAN_NYDUS_TOPBAR_COOLDOWN_MAX);
        UnitAbilityAddCooldown(lv_caster, "KerriganNydusTopBarDummyTimer", "Abil/KerriganNydusTopBarDummyTimer", (-1.0 * (CMUIX_KERRIGAN_NYDUS_TOPBAR_COOLDOWN_MAX - lv_smallestCooldown)));
        UnitBehaviorAdd(lv_caster, "KerriganNydusTopBarDummyTimer", lv_caster, 1);
        UnitBehaviorSetDurationRemaining(lv_caster, "KerriganNydusTopBarDummyTimer", lv_smallestCooldown);
    }
    else {
        UnitBehaviorRemove(lv_caster, "KerriganNydusTopBarDummyTimer", 1);
    }

    CMUIX_KerriganNydusTopbarForceChargeCount(lp_player, lv_readyCount);
}

void CMUIX_KerriganNydusTopbarRefreshAfterDelay(int lp_player) {
    Wait(0.0625, c_timeGame);
    CMUIX_KerriganNydusTopbarRefresh(lp_player);
}

bool CMUIX_KerriganNydusNetworkBirthHandler(bool testConds, bool runActions) {
    unit lv_network;
    int lv_player;

    lv_network = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    lv_player = UnitGetOwner(lv_network);
    if ((testConds == true)) {
        if ((CMUIX_KerriganNydusTopbarPlayerEnabled(lv_player) == false)) {
            return false;
        }

        if ((CMUIX_KerriganNydusTopbarUnitIsNetwork(lv_network) == false)) {
            return false;
        }
    }

    if ((runActions == false)) {
        return true;
    }

    CMUIX_KerriganNydusTopbarRefreshAfterDelay(lv_player);
    return true;
}

