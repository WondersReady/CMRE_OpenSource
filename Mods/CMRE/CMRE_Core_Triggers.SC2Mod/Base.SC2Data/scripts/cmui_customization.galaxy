bool CMUIX_ProfileListContains(string lp_list, string lp_value) {
    int lv_separator;
    int lv_tokenLength;
    string lv_remaining;
    string lv_token;

    lv_separator = 0;
    lv_tokenLength = 0;
    lv_remaining = lp_list;
    lv_token = "";
    if ((lp_list == "") || (lp_list == null) || (lp_value == "") || (lp_value == null)) {
        return false;
    }

    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_tokenLength = StringLength(lv_token);
        while ((lv_tokenLength > 0) && (StringSub(lv_token, 1, 1) == " ")) {
            if ((lv_tokenLength == 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_token, 2, lv_tokenLength);
            }

            lv_tokenLength = StringLength(lv_token);
        }

        while ((lv_tokenLength > 0) && (StringSub(lv_token, lv_tokenLength, lv_tokenLength) == " ")) {
            if ((lv_tokenLength == 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_token, 1, (lv_tokenLength - 1));
            }

            lv_tokenLength = StringLength(lv_token);
        }

        if ((StringEqual(lv_token, lp_value, c_stringNoCase) == true)) {
            return true;
        }
    }

    return false;
}

bool CMUIX_ProfileCommanderDisabled(string lp_commander) {
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    return (UserDataGetInt("PlayerCommanders", lp_commander, "Auto - Locked", 1) != 0);
}

bool CMUIX_ProfilePrestigeDisabled(string lp_prestige) {
    if ((lp_prestige == "") || (lp_prestige == null)) {
        return false;
    }

    return (UserDataGetInt("PlayerPrestige", lp_prestige, "Auto - Locked", 1) != 0);
}

bool CMUIX_ProfileAIDisabled(string lp_ai) {
    if ((lp_ai == "") || (lp_ai == null)) {
        return false;
    }

    return (UserDataGetInt("CoopAICommanders", lp_ai, "Auto - Locked", 1) != 0);
}

bool CMUIX_ProfileAIAllowed(string lp_ai) {
    if ((lp_ai == "") || (lp_ai == null)) {
        return false;
    }

    if ((CMUIX_ProfileAllowedAIs == "") || (CMUIX_ProfileAllowedAIs == null)) {
        return true;
    }

    return CMUIX_ProfileListContains(CMUIX_ProfileAllowedAIs, lp_ai);
}

bool CMUIX_MutatorChallengeRestrictionContains(string lp_type, string lp_challenge, string lp_field, string lp_instance, int lp_max) {
    int lv_index;
    string lv_userType;

    lv_index = 1;
    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lp_field == "") || (lp_instance == "") || (lp_max <= 0) || (lv_userType == "")) {
        return false;
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return false;
    }

    while ((lv_index <= lp_max)) {
        if ((UserDataGetUserInstance(lv_userType, lp_challenge, lp_field, lv_index) == lp_instance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

void CMUIX_ProfileRuntimeLocksRefresh() {
    int lv_index;
    int lv_count;
    bool lv_challengeActive;
    bool lv_locked;
    string lv_challengeType;
    string lv_challenge;
    string lv_instance;

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_challengeActive = false;
    lv_locked = false;
    lv_challengeType = CMUIX_MutatorChallengeCurrentType;
    lv_challenge = "";
    lv_instance = "";
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_challenge = CMUIX_MutatorChallengeCurrentDraft();
        lv_challengeActive = CMUIX_MutatorChallengeInstanceExists(lv_challengeType, lv_challenge);
    }

    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("PlayerCommanders", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            lv_locked = CMUIX_ProfileListContains(CMUIX_ProfileDisabledCommanders, lv_instance);
            if ((lv_challengeActive == true) && (CMUIX_MutatorChallengeRestrictionContains(lv_challengeType, lv_challenge, "Disabled Commanders", lv_instance, CMUIX_MUTATOR_CHALLENGE_DISABLED_COMMANDER_MAX) == true)) {
                lv_locked = true;
            }

            UserDataSetInt("PlayerCommanders", lv_instance, "Auto - Locked", 1, BoolToInt(lv_locked));
        }

        lv_index += 1;
    }

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerPrestige");
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("PlayerPrestige", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            lv_locked = CMUIX_ProfileListContains(CMUIX_ProfileDisabledPrestiges, lv_instance);
            if ((lv_challengeActive == true) && (CMUIX_MutatorChallengeRestrictionContains(lv_challengeType, lv_challenge, "Disabled Prestiges", lv_instance, CMUIX_MUTATOR_CHALLENGE_DISABLED_PRESTIGE_MAX) == true)) {
                lv_locked = true;
            }

            UserDataSetInt("PlayerPrestige", lv_instance, "Auto - Locked", 1, BoolToInt(lv_locked));
        }

        lv_index += 1;
    }

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopAICommanders", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            lv_locked = CMUIX_ProfileListContains(CMUIX_ProfileDisabledAIs, lv_instance);
            if ((CMUIX_ProfileAllowedAIs != "") && (CMUIX_ProfileAIAllowed(lv_instance) == false)) {
                lv_locked = true;
            }
            if ((lv_challengeActive == true) && (CMUIX_MutatorChallengeHasAIRestriction(lv_challengeType, lv_challenge) == true) && (CMUIX_MutatorChallengeAllowsEnemyInstance(lv_challengeType, lv_challenge, lv_instance) == false)) {
                lv_locked = true;
            }

            UserDataSetInt("CoopAICommanders", lv_instance, "Auto - Locked", 1, BoolToInt(lv_locked));
        }

        lv_index += 1;
    }
}

void CMUIX_AccessRuntimeUnlockRefreshForPlayer(int lp_player) {
    int lv_index;
    int lv_count;
    bool lv_developerUnlocked;
    string lv_instance;

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_developerUnlocked = false;
    lv_instance = "";
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_developerUnlocked = CMUIX_AccessPlayerCanUseDevelopingContent(lp_player);

    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("PlayerCommanders", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            UserDataSetInt("PlayerCommanders", lv_instance, "Auto - Unlocked", lp_player, BoolToInt((lv_developerUnlocked == true) && (libCOOC_gf_CC_CommanderIsDeveloping(lv_instance) == true)));
        }

        lv_index += 1;
    }

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerPrestige");
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("PlayerPrestige", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            UserDataSetInt("PlayerPrestige", lv_instance, "Auto - Unlocked", lp_player, BoolToInt((lv_developerUnlocked == true) && (libCOOC_gf_CC_PrestigeIsDeveloping(lv_instance) == true)));
        }

        lv_index += 1;
    }

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopAICommanders", lv_index);
        if ((lv_instance != "") && (lv_instance != null)) {
            UserDataSetInt("CoopAICommanders", lv_instance, "Auto - Unlocked", lp_player, BoolToInt((lv_developerUnlocked == true) && (UserDataGetInt("CoopAICommanders", lv_instance, "Dev - Developing", 1) == 1)));
        }

        lv_index += 1;
    }
}

void CMUIX_AccessRuntimeUnlockRefreshAll() {
    int lv_player;

    lv_player = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_AccessRuntimeUnlockRefreshForPlayer(lv_player);
        lv_player += 1;
    }
}

bool CMUIX_CommanderShowInUI(string lp_commander) {
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if (libCOOC_gf_CC_CommanderShowInUI(lp_commander) == true) {
        return true;
    }

    if (UserDataGetInt("PlayerCommanders", lp_commander, "State - Show In UI", 1) == 1) {
        return true;
    }

    return false;
}

bool CMUIX_CommanderVisibleForPlayer(int lp_player, string lp_commander) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((UserDataGetInt("PlayerCommanders", lp_commander, "Auto - Unlocked", lp_player) != 0)) {
        return true;
    }

    if (libCOOC_gf_CC_CommanderIsDeveloping(lp_commander) == true) {
        return true;
    }

    return CMUIX_CommanderShowInUI(lp_commander);
}

bool CMUIX_CommanderAccessibleForPlayer(int lp_player, string lp_commander) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((CMUIX_ProfileCommanderDisabled(lp_commander) == true)) {
        return false;
    }

    if ((UserDataGetInt("PlayerCommanders", lp_commander, "Auto - Unlocked", lp_player) != 0)) {
        return true;
    }

    if (libCOOC_gf_CC_CommanderIsDeveloping(lp_commander) == true) {
        return false;
    }

    return CMUIX_CommanderShowInUI(lp_commander);
}

bool CMUIX_CommanderAccessibleForOperatorTarget(int lp_operator, int lp_targetPlayer, string lp_commander) {
    if (CMUIX_CommanderAccessibleForPlayer(lp_operator, lp_commander) == false) {
        return false;
    }
    if (CMUIX_CommanderAccessibleForPlayer(lp_targetPlayer, lp_commander) == false) {
        return false;
    }

    return true;
}

string CMUIX_CommanderAccessStateForPlayer(int lp_player, string lp_commander) {
    if ((CMUIX_ProfileCommanderDisabled(lp_commander) == true)) {
        return "Locked";
    }

    if (libCOOC_gf_CC_CommanderIsDeveloping(lp_commander) == false) {
        return "Normal";
    }
    if (CMUIX_CommanderAccessibleForPlayer(lp_player, lp_commander) == true) {
        return "Dev";
    }

    return "Locked";
}

bool CMUIX_PrestigeAccessibleForPlayer(int lp_player, string lp_prestige) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if ((lp_prestige == "") || (lp_prestige == null)) {
        return false;
    }
    if ((CMUIX_ProfilePrestigeDisabled(lp_prestige) == true)) {
        return false;
    }
    if ((UserDataGetInt("PlayerPrestige", lp_prestige, "Auto - Unlocked", lp_player) != 0)) {
        return true;
    }
    if (libCOOC_gf_CC_PrestigeIsDeveloping(lp_prestige) == true) {
        return false;
    }
    if (UserDataGetInt("PlayerPrestige", lp_prestige, "State - Show In UI", 1) != 1) {
        return false;
    }

    return true;
}

bool CMUIX_MutatorAccessibleForPlayer(int lp_player, string lp_mutator) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if ((lp_mutator == "") || (lp_mutator == null)) {
        return false;
    }
    if (UserDataGetInt("Mutators", lp_mutator, "Dev - Developing", 1) == 1) {
        return CMUIX_AccessPlayerCanUseDevelopingContent(lp_player);
    }

    return true;
}

bool CMUIX_MapAccessibleForPlayer(int lp_player, string lp_mapInstance) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }
    if ((lp_mapInstance == "") || (lp_mapInstance == null)) {
        return false;
    }
    if (UserDataGetInt("CoopMaps", lp_mapInstance, "MA - Show In UI", 1) == 1) {
        return true;
    }

    return CMUIX_AccessPlayerCanUseDevelopingContent(lp_player);
}

void CMUIX_SetSharedSetupControlEnabled(int lp_control, bool lp_enabled) {
    bool lv_enabled;
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_players;

    lv_enabled = false;
    lv_player = -1;
    lv_seenPlayers = 0;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        lv_enabled = false;
        if ((lp_enabled == true) && (CMUIX_ProfileSharedConfigLocked() == false) && (CMUIX_PlayerCanControlSharedSetup(lv_player) == true)) {
            lv_enabled = true;
        }

        CMUIX_MapSelectionSetEnabled(lp_control, lv_enabled, PlayerGroupSingle(lv_player));
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_MapSelectionSetEnabled(lp_control, ((lp_enabled == true) && (CMUIX_ProfileSharedConfigLocked() == false)), PlayerGroupSingle(1));
    }
}

void CMUIX_NavigationRefreshEnabled() {
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_screenCoopNavigationStandardButton, true);
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_screenCoopNavigationMutatorButton, true);
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_screenCoopNavigationCMMutatorButton, true);
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_screenCoopNavigationCustomButton, true);
}

// Difficulty selection is CM-owned data. Launcher maps can edit it; normal
// mission maps can only mirror the base difficulty chosen before map startup.
int CMUIX_DifficultyBaseCount() {
    int lv_count;

    lv_count = UserDataInstanceCount("CoopDifficultySettings");
    if ((lv_count < 1)) {
        return 1;
    }

    if ((lv_count > libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        return libCMUI_gv_cMUI_Difficulty_Base_Count;
    }

    return lv_count;
}

int CMUIX_DifficultyClampBase(int lp_base) {
    int lv_count;

    lv_count = CMUIX_DifficultyBaseCount();
    if ((lp_base < 1)) {
        return 1;
    }

    if ((lp_base > lv_count)) {
        return lv_count;
    }

    return lp_base;
}

int CMUIX_DifficultyClampPlus(int lp_plus) {
    if ((lp_plus < 0)) {
        return 0;
    }

    if ((lp_plus > libCMUI_gv_cMUI_Difficulty_Plus_Max)) {
        return libCMUI_gv_cMUI_Difficulty_Plus_Max;
    }

    return lp_plus;
}

string CMUIX_DifficultyBaseKey(int lp_base) {
    string lv_instance;

    lv_instance = UserDataInstance("CoopDifficultySettings", CMUIX_DifficultyClampBase(lp_base));
    if ((lv_instance == "") || (lv_instance == null)) {
        return "Brutal";
    }

    return lv_instance;
}

bool CMUIX_DifficultyBaseShouldShow(int lp_base) {
    string lv_mapInstance;

    lv_mapInstance = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
            lv_mapInstance = CMUIX_MutatorChallengeMapInstance(CMUIX_MutatorChallengeCurrentType, CMUIX_MutatorChallengeCurrentSelected());
        }

        if ((lv_mapInstance == "") || (lv_mapInstance == null)) {
            lv_mapInstance = CMUIX_MapSelectionSelected;
        }
    }
    else {
        lv_mapInstance = CMUIX_MapSelectionCurrentMapInstance();
    }

    if ((lv_mapInstance == "") || (lv_mapInstance == null) || (lv_mapInstance == CMUIX_MapSelection_Random)) {
        lv_mapInstance = "[Default]";
    }

    if ((UserDataGetInt("CoopMaps", lv_mapInstance, "MA - Difficulty Allowed", CMUIX_DifficultyClampBase(lp_base)) == 1)) {
        return true;
    }

    return false;
}

int CMUIX_DifficultyFirstVisibleBase() {
    int lv_base;
    int lv_count;

    lv_base = 1;
    lv_count = CMUIX_DifficultyBaseCount();
    while ((lv_base <= lv_count)) {
        if ((CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
            return lv_base;
        }

        lv_base += 1;
    }

    return CMUIX_DifficultyClampBase(4);
}

int CMUIX_DifficultyNormalizeVisibleBase(int lp_base) {
    int lv_base;

    lv_base = CMUIX_DifficultyClampBase(lp_base);
    if ((CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
        return lv_base;
    }

    return CMUIX_DifficultyFirstVisibleBase();
}

int CMUIX_DifficultyBaseIndexValue(int lp_base) {
    int lv_index;

    lv_index = UserDataGetInt("CoopDifficultySettings", CMUIX_DifficultyBaseKey(lp_base), "DifficultyIndex", 1);
    if ((lv_index <= 0)) {
        return CMUIX_DifficultyClampBase(lp_base);
    }

    return lv_index;
}

int CMUIX_DifficultyBaseForDifficultyIndex(int lp_difficultyIndex) {
    int lv_base;
    int lv_count;
    string lv_instance;
    int lv_indexValue;

    lv_base = 1;
    lv_count = CMUIX_DifficultyBaseCount();
    lv_instance = "";
    lv_indexValue = 0;
    while ((lv_base <= lv_count)) {
        lv_instance = UserDataInstance("CoopDifficultySettings", lv_base);
        if ((lv_instance != "") && (lv_instance != null)) {
            lv_indexValue = UserDataGetInt("CoopDifficultySettings", lv_instance, "DifficultyIndex", 1);
            if ((lv_indexValue == lp_difficultyIndex)) {
                return lv_base;
            }
        }

        lv_base += 1;
    }

    return CMUIX_DifficultyClampBase(lp_difficultyIndex);
}

bool CMUIX_DifficultySelectionCanChange() {
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return true;
    }

    return false;
}

bool CMUIX_DifficultyBaseCanChange(int lp_player) {
    if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
        return false;
    }

    return CMUIX_DifficultySelectionCanChange();
}

bool CMUIX_DifficultyPlusCanChange(int lp_player) {
    return CMUIX_PlayerCanControlSharedSetup(lp_player);
}

bool CMUIX_SpecialDifficultyCanChange(int lp_player) {
    return CMUIX_DifficultyBaseCanChange(lp_player);
}

void CMUIX_DifficultySyncLockedSelection() {
    int lv_base;
    int lv_difficultyIndex;

    if ((CMUIX_DifficultySelectionCanChange() == true)) {
        return;
    }

    lv_difficultyIndex = libCOOC_gf_CC_DifficultyIndex(libCOMI_gf_DifficultyLevelForPlayerCoop(1));
    if ((lv_difficultyIndex <= 0)) {
        lv_difficultyIndex = 4;
    }

    lv_base = CMUIX_DifficultyBaseForDifficultyIndex(lv_difficultyIndex);
    CMUIX_DifficultySelectedBase = lv_base;
    CMUIX_DifficultyDraftBase = lv_base;
}

text CMUIX_DifficultyBaseName(int lp_base) {
    return UserDataGetText("CoopDifficultySettings", CMUIX_DifficultyBaseKey(CMUIX_DifficultyClampBase(lp_base)), "Name", 1);
}

text CMUIX_DifficultyBaseDescription(int lp_base) {
    return UserDataGetText("CoopDifficultySettings", CMUIX_DifficultyBaseKey(CMUIX_DifficultyClampBase(lp_base)), "Description", 1);
}

fixed CMUIX_DifficultyBaseModifier(int lp_base) {
    fixed lv_modifier;

    lv_modifier = UserDataGetFixed("CoopDifficultySettings", CMUIX_DifficultyBaseKey(CMUIX_DifficultyClampBase(lp_base)), "DifficultyModifier", 1);
    if ((lv_modifier <= 0.0)) {
        return 1.0;
    }

    return lv_modifier;
}

text CMUIX_DifficultyPlusName(int lp_base, int lp_plus) {
    if ((lp_plus == 0)) {
        return StringExternal("CMUI/ScreenCoopCampaign/Difficulty/NoExtra");
    }

    TextExpressionSetToken("Param/Expression/CMUIX_DifficultyPlusName", "A", CMUIX_DifficultyBaseName(lp_base));
    TextExpressionSetToken("Param/Expression/CMUIX_DifficultyPlusName", "B", IntToText(lp_plus));
    return TextExpressionAssemble("Param/Expression/CMUIX_DifficultyPlusName");
}

text CMUIX_DifficultyDisplayName(int lp_base, int lp_plus) {
    if ((lp_plus == 0)) {
        return CMUIX_DifficultyBaseName(lp_base);
    }

    return CMUIX_DifficultyPlusName(lp_base, lp_plus);
}

text CMUIX_DifficultyPlusDescription(int lp_plus) {
    if ((lp_plus <= 0)) {
        return StringToText("");
    }

    return StringExternal(("CMUI/ScreenCoopCampaign/Difficulty/PlusDescription/" + IntToString(CMUIX_DifficultyClampPlus(lp_plus))));
}

int CMUIX_DifficultyRatingValue(int lp_base, int lp_plus) {
    fixed lv_rawRating;
    int lv_rating;

    lv_rawRating = CMUIX_DifficultyRatingRawValue(lp_base, lp_plus);
    lv_rating = FixedToInt(Ceiling(lv_rawRating));
    if ((lv_rating < libCMUI_gv_cMUI_Difficulty_Rating_Min)) {
        return libCMUI_gv_cMUI_Difficulty_Rating_Min;
    }

    if ((lv_rating > libCMUI_gv_cMUI_Difficulty_Rating_Max)) {
        return libCMUI_gv_cMUI_Difficulty_Rating_Max;
    }

    return lv_rating;
}

fixed CMUIX_DifficultyRatingRawValue(int lp_base, int lp_plus) {
    fixed lv_modifier;
    fixed lv_plusScale;
    int lv_plus;

    lv_plus = CMUIX_DifficultyClampPlus(lp_plus);
    lv_modifier = CMUIX_DifficultyBaseModifier(lp_base);
    lv_plusScale = (((lv_modifier * lv_modifier * libCMUI_gv_cMUI_Difficulty_Plus_Scale_Quadratic_Numerator) / libCMUI_gv_cMUI_Difficulty_Plus_Scale_Quadratic_Divisor) + (libCMUI_gv_cMUI_Difficulty_Plus_Scale_Base_Numerator / libCMUI_gv_cMUI_Difficulty_Plus_Scale_Base_Divisor));
    return (lv_modifier + (IntToFixed(lv_plus) * lv_plusScale));
}

bool CMUIX_DifficultyRatingIsUnassessable(int lp_base, int lp_plus) {
    fixed lv_rawRating;

    lv_rawRating = CMUIX_DifficultyRatingRawValue(lp_base, lp_plus);
    if ((lv_rawRating > IntToFixed(libCMUI_gv_cMUI_Difficulty_Rating_Max))) {
        return true;
    }

    return false;
}

text CMUIX_DifficultyRatingValueText(int lp_rating, bool lp_unassessable) {
    if ((lp_unassessable == true)) {
        return StringToText("！！！");
    }

    return IntToText(lp_rating);
}

text CMUIX_DifficultyRatingText(int lp_base, int lp_plus) {
    bool lv_unassessable;
    int lv_rating;

    lv_rating = CMUIX_DifficultyRatingValue(lp_base, lp_plus);
    lv_unassessable = CMUIX_DifficultyRatingIsUnassessable(lp_base, lp_plus);
    return (StringToText("综合难度评级：") + CMUIX_DifficultyRatingValueText(lv_rating, lv_unassessable));
}

text CMUIX_DifficultyWarningText() {
    return StringToText("严重警告：该组合已超过可评估量表，通常视为难以通过。");
}

int CMUIX_DifficultyNeedleRotation(int lp_rating) {
    int lv_rating;
    fixed lv_scaled;

    lv_rating = lp_rating;
    lv_scaled = 0.0;
    if ((lv_rating <= libCMUI_gv_cMUI_Difficulty_Rating_Min)) {
        return libCMUI_gv_cMUI_Difficulty_Needle_Rotation_Min;
    }

    if ((lv_rating >= libCMUI_gv_cMUI_Difficulty_Rating_Max)) {
        return libCMUI_gv_cMUI_Difficulty_Needle_Rotation_Max;
    }

    lv_scaled = IntToFixed(libCMUI_gv_cMUI_Difficulty_Needle_Rotation_Min);
    lv_scaled += ((IntToFixed(lv_rating - libCMUI_gv_cMUI_Difficulty_Rating_Min) * IntToFixed(libCMUI_gv_cMUI_Difficulty_Needle_Rotation_Max - libCMUI_gv_cMUI_Difficulty_Needle_Rotation_Min)) / IntToFixed(libCMUI_gv_cMUI_Difficulty_Rating_Max - libCMUI_gv_cMUI_Difficulty_Rating_Min));
    return FixedToInt(lv_scaled);
}

text CMUIX_DifficultyDescription(int lp_base, int lp_plus) {
    if ((lp_plus == 0)) {
        return CMUIX_DifficultyBaseDescription(lp_base);
    }

    return CMUIX_DifficultyPlusDescription(lp_plus);
}

void CMUIX_DifficultyEnsureSelection() {
    CMUIX_DifficultySyncLockedSelection();
    CMUIX_DifficultySelectedBase = CMUIX_DifficultyClampBase(CMUIX_DifficultySelectedBase);
    CMUIX_DifficultySelectedPlus = CMUIX_DifficultyClampPlus(CMUIX_DifficultySelectedPlus);
    CMUIX_DifficultyDraftBase = CMUIX_DifficultyClampBase(CMUIX_DifficultyDraftBase);
    CMUIX_DifficultyDraftPlus = CMUIX_DifficultyClampPlus(CMUIX_DifficultyDraftPlus);
    if ((CMUIX_DifficultySelectionCanChange() == true)) {
        CMUIX_DifficultySelectedBase = CMUIX_DifficultyNormalizeVisibleBase(CMUIX_DifficultySelectedBase);
        CMUIX_DifficultyDraftBase = CMUIX_DifficultyNormalizeVisibleBase(CMUIX_DifficultyDraftBase);
    }
}

void CMUIX_DifficultySetButtonText(text lp_text, playergroup lp_players) {
    CMUIX_MapSelectionSetText(libCMUI_gv_difficultyButton, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_difficultyButtonLabel, lp_text, lp_players);
}

void CMUIX_DifficultyRefreshButton() {
    CMUIX_DifficultyEnsureSelection();
    CMUIX_DifficultySetButtonText(CMUIX_DifficultyDisplayName(CMUIX_DifficultySelectedBase, CMUIX_DifficultySelectedPlus), PlayerGroupAll());
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_difficultyButton, true);
}

void CMUIX_DifficultyRefreshBaseList(int lp_player) {
    int lv_index;
    int lv_base;
    int lv_count;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_base = 0;
    lv_count = CMUIX_DifficultyBaseCount();
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_DifficultyEnsureSelection();
    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        CMUIX_DifficultyBaseItemBases[lv_index] = 0;
        CMUIX_MapSelectionSetVisible(libCMUI_gv_difficultyBaseItems[lv_index], false, lv_playerGroup);
        lv_index += 1;
    }

    lv_index = 0;
    lv_base = 1;
    while ((lv_base <= lv_count) && (lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        if ((CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
            CMUIX_DifficultyBaseItemBases[lv_index] = lv_base;
            CMUIX_MapSelectionSetText(libCMUI_gv_difficultyBaseItems[lv_index], StringToText(""), lv_playerGroup);
            CMUIX_MapSelectionSetText(libCMUI_gv_difficultyBaseItemLabels[lv_index], CMUIX_DifficultyBaseName(lv_base), lv_playerGroup);
            CMUIX_MapSelectionSetVisible(libCMUI_gv_difficultyBaseItems[lv_index], true, lv_playerGroup);
            if ((CMUICore_IsControlValid(libCMUI_gv_difficultyBaseItems[lv_index]) == true)) {
                CMUIX_MapSelectionSetEnabled(libCMUI_gv_difficultyBaseItems[lv_index], CMUIX_DifficultyBaseCanChange(lp_player), lv_playerGroup);
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_difficultyBaseItems[lv_index], (lv_base == CMUIX_DifficultyDraftBase), lv_playerGroup);
            }

            lv_index += 1;
        }

        lv_base += 1;
    }
}

void CMUIX_DifficultyRefreshPlusList(int lp_player) {
    int lv_index;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_DifficultyEnsureSelection();
    while ((lv_index <= libCMUI_gv_cMUI_Difficulty_Plus_Max)) {
        CMUIX_MapSelectionSetText(libCMUI_gv_difficultyPlusItems[lv_index], StringToText(""), lv_playerGroup);
        CMUIX_MapSelectionSetText(libCMUI_gv_difficultyPlusItemLabels[lv_index], CMUIX_DifficultyPlusName(CMUIX_DifficultyDraftBase, lv_index), lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_difficultyPlusItems[lv_index], true, lv_playerGroup);
        if ((CMUICore_IsControlValid(libCMUI_gv_difficultyPlusItems[lv_index]) == true)) {
            CMUIX_MapSelectionSetEnabled(libCMUI_gv_difficultyPlusItems[lv_index], CMUIX_DifficultyPlusCanChange(lp_player), lv_playerGroup);
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_difficultyPlusItems[lv_index], (lv_index == CMUIX_DifficultyDraftPlus), lv_playerGroup);
        }

        lv_index += 1;
    }
}

void CMUIX_DifficultyRefreshDetails(int lp_player) {
    int lv_rating;
    int lv_rotation;
    bool lv_unassessable;
    playergroup lv_playerGroup;

    lv_rating = CMUIX_DifficultyRatingValue(CMUIX_DifficultyDraftBase, CMUIX_DifficultyDraftPlus);
    lv_unassessable = CMUIX_DifficultyRatingIsUnassessable(CMUIX_DifficultyDraftBase, CMUIX_DifficultyDraftPlus);
    if ((lv_unassessable == true)) {
        lv_rotation = 100;
    }
    else {
        lv_rotation = CMUIX_DifficultyNeedleRotation(lv_rating);
    }

    lv_playerGroup = PlayerGroupSingle(lp_player);

    CMUIX_MapSelectionSetText(libCMUI_gv_difficultyNameLabel, CMUIX_DifficultyDisplayName(CMUIX_DifficultyDraftBase, CMUIX_DifficultyDraftPlus), lv_playerGroup);
    CMUIX_MapSelectionSetText(libCMUI_gv_difficultyRatingLabel, CMUIX_DifficultyRatingText(CMUIX_DifficultyDraftBase, CMUIX_DifficultyDraftPlus), lv_playerGroup);
    if ((lv_unassessable == true)) {
        CMUIX_MapSelectionSetText(libCMUI_gv_difficultyWarningLabel, CMUIX_DifficultyWarningText(), lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_difficultyWarningLabel, true, lv_playerGroup);
    }
    else {
        CMUIX_MapSelectionSetText(libCMUI_gv_difficultyWarningLabel, StringToText(""), lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_difficultyWarningLabel, false, lv_playerGroup);
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_difficultyDescriptionLabel, CMUIX_DifficultyDescription(CMUIX_DifficultyDraftBase, CMUIX_DifficultyDraftPlus), lv_playerGroup);
    if ((CMUICore_IsControlValid(libCMUI_gv_difficultyNeedle) == true)) {
        libNtve_gf_SetDialogItemRotation(libCMUI_gv_difficultyNeedle, lv_rotation, lv_playerGroup);
    }
}

void CMUIX_DifficultyRefreshPopup(int lp_player) {
    CMUIX_DifficultyRefreshBaseList(lp_player);
    CMUIX_DifficultyRefreshPlusList(lp_player);
    CMUIX_DifficultyRefreshDetails(lp_player);
}

// Standard mode owns the Brutal+ runtime state. The old COMU abomination
// generator enumerates every valid combination, which becomes explosive once
// enhanced variants are also candidates. This path uses bounded random attempts
// and still writes COMU's runtime arrays before enabling the selected variants.
string CMUIX_StandardBrutalPlusDifficultyLevel(int lp_plus) {
    int lv_plus;

    lv_plus = CMUIX_DifficultyClampPlus(lp_plus);
    if ((lv_plus <= 0)) {
        return "";
    }

    return UserDataInstance("MutationDifficultyLevels", lv_plus);
}

void CMUIX_StandardBrutalPlusClearRuntime() {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_slot = 1;
    lv_mutator = "";
    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((lv_mutator != "")) {
            libCOMU_gf_CT_DisableMutatorVariant(lv_mutator);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Count", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1, 0);
            lv_slot = 1;
            while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
                UserDataSetInt("Mutators", lv_mutator, "Auto - Custom Selected Slot", lv_slot, 0);
                lv_slot += 1;
            }
        }

        lv_index += 1;
    }

    libCOMU_gv_cT_MAbomination_DifficultyLevel = null;
    libCOMU_gv_cT_MAbomination_MutatorsCount = 0;
    libCOMU_gv_cT_MAbomination_CombosCounted = 0;
    libCOMU_gv_cT_MAbomination_CountSnapshot = 0;
    libCOMU_gv_cT_MAbomination_PointsSnapshot = 0;
    lv_index = 1;
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        libCOMU_gv_cT_MAbomination_Mutators[lv_index] = "";
        libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index] = false;
        lv_index += 1;
    }

    libCOTF_gv_rT_ChaosCycleCount = 0;
    lv_index = 1;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        libCOTF_gv_rT_ChaosMutators[lv_index] = "";
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= 3)) {
        libCOMU_gv_cT_RandomMutators[lv_index] = "";
        libCOMU_gv_cT_RandomMutatorsEnhanced[lv_index] = false;
        lv_index += 1;
    }
}

int CMUIX_StandardBrutalPlusVariantPoints(string lp_mutator, bool lp_enhanced) {
    if ((lp_mutator == "") || (lp_mutator == null)) {
        return 0;
    }

    if ((lp_enhanced == true)) {
        return UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Enhance Points", 1);
    }

    return UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Points", 1);
}

bool CMUIX_StandardBrutalPlusVariantAllowed(string lp_mutator, bool lp_enhanced) {
    if ((lp_mutator == "") || (lp_mutator == null)) {
        return false;
    }

    if ((lp_enhanced == true)) {
        if ((UserDataGetInt("Mutators", lp_mutator, "MA - Has Enhancement", 1) != 1)) {
            return false;
        }

        return (UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Enhance Allowed", 1) == 1) && (CMUIX_StandardBrutalPlusVariantPoints(lp_mutator, true) > 0);
    }

    return (UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Allowed", 1) == 1) && (CMUIX_StandardBrutalPlusVariantPoints(lp_mutator, false) > 0);
}

void CMUIX_StandardBrutalPlusAddCandidate(string lp_mutator, bool lp_enhanced) {
    if ((CMUIX_StandardBPCandidateCount >= CMUIX_STANDARD_BP_CANDIDATE_MAX)) {
        return;
    }

    CMUIX_StandardBPCandidateCount += 1;
    CMUIX_StandardBPCandidateMutators[CMUIX_StandardBPCandidateCount] = lp_mutator;
    CMUIX_StandardBPCandidateEnhanced[CMUIX_StandardBPCandidateCount] = 0;
    if ((lp_enhanced == true)) {
        CMUIX_StandardBPCandidateEnhanced[CMUIX_StandardBPCandidateCount] = 1;
    }

    CMUIX_StandardBPCandidatePoints[CMUIX_StandardBPCandidateCount] = CMUIX_StandardBrutalPlusVariantPoints(lp_mutator, lp_enhanced);
}

int CMUIX_StandardBrutalPlusBuildCandidates() {
    int lv_index;
    int lv_count;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_mutator = "";
    CMUIX_StandardBPCandidateCount = 0;
    while ((lv_index <= lv_count) && (CMUIX_StandardBPCandidateCount < CMUIX_STANDARD_BP_CANDIDATE_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_StandardBrutalPlusVariantAllowed(lv_mutator, false) == true)) {
            CMUIX_StandardBrutalPlusAddCandidate(lv_mutator, false);
        }

        if ((CMUIX_StandardBrutalPlusVariantAllowed(lv_mutator, true) == true)) {
            CMUIX_StandardBrutalPlusAddCandidate(lv_mutator, true);
        }

        lv_index += 1;
    }

    return CMUIX_StandardBPCandidateCount;
}

bool CMUIX_StandardBrutalPlusMutatorAlreadyPicked(string lp_mutator, int lp_count) {
    int lv_index;

    lv_index = 1;
    while ((lv_index <= lp_count)) {
        if ((libCOMU_gv_cT_MAbomination_ConsideredMutators[lv_index] == lp_mutator)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

int CMUIX_StandardBrutalPlusPointDistance(int lp_points, int lp_minPoints, int lp_maxPoints) {
    if ((lp_points < lp_minPoints)) {
        return (lp_minPoints - lp_points);
    }

    if ((lp_points > lp_maxPoints)) {
        return (lp_points - lp_maxPoints);
    }

    return 0;
}

int CMUIX_StandardBrutalPlusAttemptScore(int lp_count, int lp_points, int lp_minMutators, int lp_minPoints, int lp_maxPoints) {
    int lv_score;

    lv_score = (CMUIX_StandardBrutalPlusPointDistance(lp_points, lp_minPoints, lp_maxPoints) * 100);
    if ((lp_count < lp_minMutators)) {
        lv_score += ((lp_minMutators - lp_count) * 10000);
    }

    return lv_score;
}

void CMUIX_StandardBrutalPlusStoreConsidered(int lp_count, int lp_points) {
    int lv_index;

    lv_index = 1;
    libCOMU_gv_cT_MAbomination_MutatorsCount = lp_count;
    libCOMU_gv_cT_MAbomination_CountSnapshot = 1;
    libCOMU_gv_cT_MAbomination_CombosCounted = 1;
    libCOMU_gv_cT_MAbomination_PointsSnapshot = lp_points;
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        if ((lv_index <= lp_count)) {
            libCOMU_gv_cT_MAbomination_Mutators[lv_index] = libCOMU_gv_cT_MAbomination_ConsideredMutators[lv_index];
            libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index] = libCOMU_gv_cT_MAbomination_ConsideredMutatorsEnhanced[lv_index];
        }
        else {
            libCOMU_gv_cT_MAbomination_Mutators[lv_index] = "";
            libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index] = false;
        }

        lv_index += 1;
    }
}

bool CMUIX_StandardBrutalPlusRollBounded(int lp_minMutators, int lp_maxMutators, int lp_minPoints, int lp_maxPoints) {
    int lv_candidateCount;
    int lv_minMutators;
    int lv_maxMutators;
    int lv_minPoints;
    int lv_maxPoints;
    int lv_attempt;
    int lv_pickSlot;
    int lv_retry;
    int lv_retryLimit;
    int lv_candidateIndex;
    int lv_targetCount;
    int lv_totalPoints;
    int lv_attemptCount;
    int lv_score;
    int lv_bestScore;
    int lv_bestCount;
    int lv_bestPoints;
    string lv_mutator;
    bool lv_enhanced;
    int lv_index;

    lv_candidateCount = CMUIX_StandardBrutalPlusBuildCandidates();
    lv_minMutators = lp_minMutators;
    lv_maxMutators = lp_maxMutators;
    lv_minPoints = lp_minPoints;
    lv_maxPoints = lp_maxPoints;
    lv_attempt = 1;
    lv_pickSlot = 1;
    lv_retry = 0;
    lv_retryLimit = 0;
    lv_candidateIndex = 0;
    lv_targetCount = 0;
    lv_totalPoints = 0;
    lv_attemptCount = 0;
    lv_score = 0;
    lv_bestScore = 100000000;
    lv_bestCount = 0;
    lv_bestPoints = 0;
    lv_mutator = "";
    lv_enhanced = false;
    lv_index = 1;
    if ((lv_candidateCount <= 0)) {
        return false;
    }

    lv_minMutators = CMUIX_ClampInt(lv_minMutators, 1, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
    lv_maxMutators = CMUIX_ClampInt(lv_maxMutators, lv_minMutators, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
    if ((lv_maxMutators > lv_candidateCount)) {
        lv_maxMutators = lv_candidateCount;
    }

    if ((lv_minMutators > lv_maxMutators)) {
        lv_minMutators = lv_maxMutators;
    }

    while ((lv_attempt <= CMUIX_STANDARD_BP_ROLL_ATTEMPTS)) {
        lv_index = 1;
        while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
            libCOMU_gv_cT_MAbomination_ConsideredMutators[lv_index] = "";
            libCOMU_gv_cT_MAbomination_ConsideredMutatorsEnhanced[lv_index] = false;
            lv_index += 1;
        }

        lv_totalPoints = 0;
        lv_pickSlot = 1;
        lv_attemptCount = 0;
        lv_targetCount = RandomInt(lv_minMutators, lv_maxMutators);
        while ((lv_pickSlot <= lv_targetCount)) {
            lv_retry = 0;
            lv_retryLimit = (lv_candidateCount * 2);
            lv_candidateIndex = 0;
            while ((lv_retry < lv_retryLimit) && (lv_candidateIndex == 0)) {
                lv_candidateIndex = RandomInt(1, lv_candidateCount);
                lv_mutator = CMUIX_StandardBPCandidateMutators[lv_candidateIndex];
                if ((CMUIX_StandardBrutalPlusMutatorAlreadyPicked(lv_mutator, (lv_pickSlot - 1)) == true)) {
                    lv_candidateIndex = 0;
                }

                lv_retry += 1;
            }

            if ((lv_candidateIndex == 0)) {
                lv_pickSlot = (lv_targetCount + 1);
            }
            else {
                lv_enhanced = (CMUIX_StandardBPCandidateEnhanced[lv_candidateIndex] == 1);
                libCOMU_gv_cT_MAbomination_ConsideredMutators[lv_pickSlot] = CMUIX_StandardBPCandidateMutators[lv_candidateIndex];
                libCOMU_gv_cT_MAbomination_ConsideredMutatorsEnhanced[lv_pickSlot] = lv_enhanced;
                lv_totalPoints += CMUIX_StandardBPCandidatePoints[lv_candidateIndex];
                lv_attemptCount += 1;
                lv_pickSlot += 1;
            }
        }

        if ((lv_attemptCount >= lv_minMutators) && (lv_totalPoints >= lv_minPoints) && (lv_totalPoints <= lv_maxPoints)) {
            CMUIX_StandardBrutalPlusStoreConsidered(lv_attemptCount, lv_totalPoints);
            return true;
        }

        lv_score = CMUIX_StandardBrutalPlusAttemptScore(lv_attemptCount, lv_totalPoints, lv_minMutators, lv_minPoints, lv_maxPoints);
        if ((lv_score < lv_bestScore) && (lv_attemptCount > 0)) {
            lv_bestScore = lv_score;
            lv_bestCount = lv_attemptCount;
            lv_bestPoints = lv_totalPoints;
            CMUIX_StandardBrutalPlusStoreConsidered(lv_bestCount, lv_bestPoints);
        }

        lv_attempt += 1;
    }

    return (lv_bestCount > 0);
}

bool CMUIX_StandardBrutalPlusRuntimeReady() {
    string lv_difficultyLevel;

    lv_difficultyLevel = CMUIX_StandardBrutalPlusDifficultyLevel(CMUIX_DifficultySelectedPlus);
    if ((CMUIX_DifficultySelectedPlus <= 0)) {
        return true;
    }

    if ((lv_difficultyLevel == "")) {
        return false;
    }

    if ((libCOMU_gv_cT_MAbomination_DifficultyLevel != lv_difficultyLevel)) {
        return false;
    }

    if ((libCOMU_gv_cT_MAbomination_MutatorsCount <= 0)) {
        return false;
    }

    return true;
}

void CMUIX_StandardBrutalPlusApplyRuntime() {
    int lv_plus;
    int lv_mutatorsMin;
    int lv_mutatorsMax;
    int lv_pointsMin;
    int lv_pointsMax;
    int lv_index;
    string lv_difficultyLevel;

    lv_plus = CMUIX_DifficultyClampPlus(CMUIX_DifficultySelectedPlus);
    lv_mutatorsMin = 0;
    lv_mutatorsMax = 0;
    lv_pointsMin = 0;
    lv_pointsMax = 0;
    lv_index = 1;
    lv_difficultyLevel = "";
    if ((CMUIX_CurrentMode != CMUIX_MODE_STANDARD)) {
        return;
    }

    CMUIX_StandardBrutalPlusClearRuntime();
    if ((lv_plus <= 0)) {
        return;
    }

    lv_difficultyLevel = CMUIX_StandardBrutalPlusDifficultyLevel(lv_plus);
    if ((lv_difficultyLevel == "")) {
        CMUIX_StandardBrutalPlusClearRuntime();
        return;
    }

    libCOMU_gv_cT_MAbomination_DifficultyLevel = lv_difficultyLevel;
    lv_mutatorsMin = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "MutatorsMin", 1);
    lv_mutatorsMax = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "MutatorsMax", 1);
    lv_pointsMin = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "PointsMin", 1);
    lv_pointsMax = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "PointsMax", 1);
    if ((lv_mutatorsMax <= 0) || (lv_pointsMax <= 0) || (lv_pointsMax < lv_pointsMin)) {
        CMUIX_StandardBrutalPlusClearRuntime();
        return;
    }

    libCOMU_gv_cT_MAbomination_MinMutators = lv_mutatorsMin;
    libCOMU_gv_cT_MAbomination_MaxMutators = lv_mutatorsMax;
    libCOMU_gv_cT_MAbomination_MinPoints = lv_pointsMin;
    libCOMU_gv_cT_MAbomination_MaxPoints = lv_pointsMax;
    if ((CMUIX_StandardBrutalPlusRollBounded(lv_mutatorsMin, lv_mutatorsMax, lv_pointsMin, lv_pointsMax) == false)) {
        CMUIX_StandardBrutalPlusClearRuntime();
        return;
    }

    while ((lv_index <= libCOMU_gv_cT_MAbomination_MutatorsCount) && (lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        libCOMU_gf_CT_EnableMutatorVariant(libCOMU_gv_cT_MAbomination_Mutators[lv_index], libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index]);
        lv_index += 1;
    }
}

void CMUIX_StandardBrutalPlusEnsureRuntime() {
    if ((CMUIX_CurrentMode != CMUIX_MODE_STANDARD)) {
        return;
    }

    if ((CMUIX_DifficultySelectedPlus <= 0)) {
        CMUIX_StandardBrutalPlusClearRuntime();
        return;
    }

    if ((CMUIX_StandardBrutalPlusRuntimeReady() == false)) {
        CMUIX_StandardBrutalPlusApplyRuntime();
    }
}

void CMUIX_DifficultyAccept(int lp_player) {
    CMUIX_DifficultyEnsureSelection();
    CMUIX_DifficultySelectedBase = CMUIX_DifficultyDraftBase;
    CMUIX_DifficultySelectedPlus = CMUIX_DifficultyDraftPlus;
    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD)) {
        CMUIX_StandardBrutalPlusApplyRuntime();
    }

    CMUIX_DifficultyRefreshButton();
    CMUIX_SpecialDifficultyRefreshButton();
    CMUIX_DifficultyRefreshPopup(lp_player);
    CMUIX_MutatorInfoResetPages();
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_MutatorInfoRefreshAll();
}

void CMUIX_DifficultyCancel() {
    CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
    CMUIX_DifficultyDraftPlus = CMUIX_DifficultySelectedPlus;
    CMUIX_DifficultyRefreshButton();
    CMUIX_SpecialDifficultyRefreshButton();
}

void CMUIX_DifficultyRefreshAll() {
    CMUIX_DifficultyEnsureSelection();
    CMUIX_DifficultyRefreshButton();
    CMUIX_SpecialDifficultyRefreshButton();
}

bool CMUIX_DifficultyHandleClick(int lp_player, int lp_control) {
    int lv_index;
    int lv_clicked;
    int lv_base;

    lv_index = 0;
    lv_clicked = 0;
    lv_base = 0;
    if ((CMUICore_IsControlValid(libCMUI_gv_difficultyButton) == false)) {
        return false;
    }

    if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
        return false;
    }

    if ((lp_control == libCMUI_gv_difficultyButton)) {
        CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
        CMUIX_DifficultyDraftPlus = CMUIX_DifficultySelectedPlus;
        CMUIX_DifficultyRefreshPopup(lp_player);
        return true;
    }

    if ((lp_control == libCMUI_gv_difficultyAcceptButton)) {
        CMUIX_DifficultyAccept(lp_player);
        return true;
    }

    if ((lp_control == libCMUI_gv_difficultyCancelButton)) {
        CMUIX_DifficultyCancel();
        return true;
    }

    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        if ((lp_control == libCMUI_gv_difficultyBaseItems[lv_index])) {
            lv_base = CMUIX_DifficultyBaseItemBases[lv_index];
            if ((lv_base > 0) && (CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
                if ((CMUIX_DifficultyBaseCanChange(lp_player) == true)) {
                    CMUIX_DifficultyDraftBase = lv_base;
                }

                lv_clicked = 1;
            }
        }

        lv_index += 1;
    }

    if ((lv_clicked == 1)) {
        CMUIX_DifficultyRefreshPopup(lp_player);
        return true;
    }

    lv_index = 0;
    while ((lv_index <= libCMUI_gv_cMUI_Difficulty_Plus_Max)) {
        if ((lp_control == libCMUI_gv_difficultyPlusItems[lv_index])) {
            if ((CMUIX_DifficultyPlusCanChange(lp_player) == true)) {
                CMUIX_DifficultyDraftPlus = lv_index;
            }

            lv_clicked = 1;
        }

        lv_index += 1;
    }

    if ((lv_clicked == 1)) {
        CMUIX_DifficultyRefreshPopup(lp_player);
        return true;
    }

    return false;
}

int CMUIX_SpecialDifficultyRatingValue(int lp_base) {
    int lv_base;

    lv_base = CMUIX_DifficultyClampBase(lp_base);
    if ((lv_base == 1)) {
        return 10;
    }

    if ((lv_base == 2)) {
        return 20;
    }

    if ((lv_base == 3)) {
        return 35;
    }

    if ((lv_base == 4)) {
        return 55;
    }

    if ((lv_base == 5)) {
        return 75;
    }

    return 95;
}

text CMUIX_SpecialDifficultyRatingText(int lp_base) {
    return (StringToText("综合难度评级：") + IntToText(CMUIX_SpecialDifficultyRatingValue(lp_base)));
}

void CMUIX_SpecialDifficultySetButtonText(text lp_text, playergroup lp_players) {
    CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyButton, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyButtonLabel, lp_text, lp_players);
}

void CMUIX_SpecialDifficultyRefreshButton() {
    bool lv_canChange;

    lv_canChange = false;
    CMUIX_DifficultyEnsureSelection();
    CMUIX_SpecialDifficultySetButtonText(CMUIX_DifficultyBaseName(CMUIX_DifficultySelectedBase), PlayerGroupAll());
    lv_canChange = CMUIX_SpecialDifficultyCanChange(1);
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_specialDifficultyButton, lv_canChange);
}

void CMUIX_SpecialDifficultyRefreshBaseList(int lp_player) {
    int lv_index;
    int lv_base;
    int lv_count;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_base = 0;
    lv_count = CMUIX_DifficultyBaseCount();
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_DifficultyEnsureSelection();
    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        CMUIX_SpecialDifficultyBaseItemBases[lv_index] = 0;
        CMUIX_MapSelectionSetVisible(libCMUI_gv_specialDifficultyBaseItems[lv_index], false, lv_playerGroup);
        lv_index += 1;
    }

    lv_index = 0;
    lv_base = 1;
    while ((lv_base <= lv_count) && (lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        if ((CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
            CMUIX_SpecialDifficultyBaseItemBases[lv_index] = lv_base;
            CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyBaseItems[lv_index], StringToText(""), lv_playerGroup);
            CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyBaseItemLabels[lv_index], CMUIX_DifficultyBaseName(lv_base), lv_playerGroup);
            CMUIX_MapSelectionSetVisible(libCMUI_gv_specialDifficultyBaseItems[lv_index], true, lv_playerGroup);
            if ((CMUICore_IsControlValid(libCMUI_gv_specialDifficultyBaseItems[lv_index]) == true)) {
                CMUIX_MapSelectionSetEnabled(libCMUI_gv_specialDifficultyBaseItems[lv_index], CMUIX_SpecialDifficultyCanChange(lp_player), lv_playerGroup);
                libNtve_gf_SetDialogItemToggled(libCMUI_gv_specialDifficultyBaseItems[lv_index], (lv_base == CMUIX_DifficultyDraftBase), lv_playerGroup);
            }

            lv_index += 1;
        }

        lv_base += 1;
    }
}

void CMUIX_SpecialDifficultyRefreshDetails(int lp_player) {
    int lv_rating;
    int lv_rotation;
    playergroup lv_playerGroup;

    lv_rating = CMUIX_SpecialDifficultyRatingValue(CMUIX_DifficultyDraftBase);
    lv_rotation = CMUIX_DifficultyNeedleRotation(lv_rating);
    lv_playerGroup = PlayerGroupSingle(lp_player);

    CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyNameLabel, CMUIX_DifficultyBaseName(CMUIX_DifficultyDraftBase), lv_playerGroup);
    CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyRatingLabel, StringToText(""), lv_playerGroup);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_specialDifficultyRatingLabel, false, lv_playerGroup);
    CMUIX_MapSelectionSetText(libCMUI_gv_specialDifficultyDescriptionLabel, CMUIX_DifficultyBaseDescription(CMUIX_DifficultyDraftBase), lv_playerGroup);
    if ((CMUICore_IsControlValid(libCMUI_gv_specialDifficultyNeedle) == true)) {
        libNtve_gf_SetDialogItemRotation(libCMUI_gv_specialDifficultyNeedle, lv_rotation, lv_playerGroup);
    }
}

void CMUIX_SpecialDifficultyRefreshPopup(int lp_player) {
    CMUIX_SpecialDifficultyRefreshBaseList(lp_player);
    CMUIX_SpecialDifficultyRefreshDetails(lp_player);
}

void CMUIX_SpecialDifficultyAccept(int lp_player) {
    CMUIX_DifficultyEnsureSelection();
    CMUIX_DifficultySelectedBase = CMUIX_DifficultyDraftBase;
    CMUIX_DifficultyRefreshButton();
    CMUIX_SpecialDifficultyRefreshButton();
    CMUIX_SpecialDifficultyRefreshPopup(lp_player);
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_MutatorInfoRefreshAll();
}

void CMUIX_SpecialDifficultyCancel() {
    CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
    CMUIX_SpecialDifficultyRefreshButton();
}

void CMUIX_SpecialDifficultyRefreshAll() {
    CMUIX_DifficultyEnsureSelection();
    CMUIX_SpecialDifficultyRefreshButton();
}

void CMUIX_SendPopupAnimationEvent(int lp_control, int lp_player, string lp_event) {
    if ((CMUICore_IsControlValid(lp_control) == true)) {
        DialogControlSendAnimationEvent(lp_control, PlayerGroupSingle(lp_player), lp_event);
    }
}

bool CMUIX_SpecialDifficultyHandleClick(int lp_player, int lp_control) {
    int lv_index;
    int lv_clicked;
    int lv_base;

    lv_index = 0;
    lv_clicked = 0;
    lv_base = 0;
    if ((CMUICore_IsControlValid(libCMUI_gv_specialDifficultyButton) == false)) {
        return false;
    }

    if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
        return false;
    }

    if ((CMUIX_SpecialDifficultyCanChange(lp_player) == false)) {
        if ((lp_control == libCMUI_gv_specialDifficultyButton)) {
            return true;
        }

        if ((lp_control == libCMUI_gv_specialDifficultyAcceptButton) || (lp_control == libCMUI_gv_specialDifficultyCancelButton)) {
            CMUIX_SendPopupAnimationEvent(libCMUI_gv_specialDifficultyContainer, lp_player, "CMUIXHide");
            return true;
        }

        while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
            if ((lp_control == libCMUI_gv_specialDifficultyBaseItems[lv_index])) {
                return true;
            }

            lv_index += 1;
        }

        lv_index = 0;
    }

    if ((lp_control == libCMUI_gv_specialDifficultyButton)) {
        CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
        CMUIX_SpecialDifficultyRefreshPopup(lp_player);
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_specialDifficultyContainer, lp_player, "CMUIXShow");

        return true;
    }

    if ((lp_control == libCMUI_gv_specialDifficultyAcceptButton)) {
        CMUIX_SpecialDifficultyAccept(lp_player);
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_specialDifficultyContainer, lp_player, "CMUIXHide");
        return true;
    }

    if ((lp_control == libCMUI_gv_specialDifficultyCancelButton)) {
        CMUIX_SpecialDifficultyCancel();
        CMUIX_SendPopupAnimationEvent(libCMUI_gv_specialDifficultyContainer, lp_player, "CMUIXHide");
        return true;
    }

    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        if ((lp_control == libCMUI_gv_specialDifficultyBaseItems[lv_index])) {
            lv_base = CMUIX_SpecialDifficultyBaseItemBases[lv_index];
            if ((lv_base > 0) && (CMUIX_DifficultyBaseShouldShow(lv_base) == true)) {
                CMUIX_DifficultyDraftBase = lv_base;
                lv_clicked = 1;
            }
        }

        lv_index += 1;
    }

    if ((lv_clicked == 1)) {
        CMUIX_SpecialDifficultyRefreshPopup(lp_player);
        return true;
    }

    return false;
}

bool CMUIX_MapSelectionMapShouldShowForPlayer(int lp_player, string lp_mapInstance) {
    string lv_mapLink;

    lv_mapLink = "";
    if ((lp_mapInstance == "")) {
        return false;
    }

    if (CMUIX_MapAccessibleForPlayer(lp_player, lp_mapInstance) == false) {
        return false;
    }

    if ((UserDataGetInt("CoopMaps", lp_mapInstance, "MA - Is Launcher", 1) == 1)) {
        return false;
    }

    lv_mapLink = UserDataGetGameLink("CoopMaps", lp_mapInstance, "MA - Map Link", 1);
    if ((lv_mapLink == "")) {
        return false;
    }

    return true;
}

string CMUIX_MapSelectionInstanceForMapLink(string lp_mapLink) {
    int lv_index;
    int lv_count;
    string lv_instance;
    string lv_instanceMapLink;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    lv_instance = "";
    lv_instanceMapLink = "";
    if ((lp_mapLink == "")) {
        return "";
    }

    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopMaps", lv_index);
        lv_instanceMapLink = UserDataGetGameLink("CoopMaps", lv_instance, "MA - Map Link", 1);
        if ((lv_instanceMapLink == lp_mapLink)) {
            return lv_instance;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_MapSelectionCurrentMapInstance() {
    int lv_index;
    int lv_count;
    string lv_currentMap;
    string lv_instance;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    lv_currentMap = libCOOC_gf_CC_CurrentMap();
    lv_instance = CMUIX_MapSelectionInstanceForMapLink(lv_currentMap);
    if ((lv_instance != "")) {
        return lv_instance;
    }

    lv_instance = libCOOC_gf_CC_MapUserDataInstance(lv_currentMap);
    if ((lv_instance != "")) {
        return lv_instance;
    }

    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopMaps", lv_index);
        if ((UserDataGetInt("CoopMaps", lv_instance, "Auto - Is Current", 1) == 1)) {
            return lv_instance;
        }

        lv_index += 1;
    }

    return "";
}

bool CMUIX_MapSelectionCurrentMapIsLauncher() {
    string lv_currentMapInstance;

    if ((CMUIX_MapSelection_ForceLauncherForTest == 1)) {
        return true;
    }

    lv_currentMapInstance = CMUIX_MapSelectionCurrentMapInstance();
    if ((lv_currentMapInstance == "")) {
        return false;
    }

    if ((UserDataGetInt("CoopMaps", lv_currentMapInstance, "MA - Is Launcher", 1) == 1)) {
        return true;
    }

    return false;
}

text CMUIX_MapSelectionDisplayName(string lp_mapInstance) {
    string lv_mapLink;

    lv_mapLink = "";
    if ((CMUIX_MapSelectionIsRandom(lp_mapInstance) == true)) {
        return CMUIX_MapSelectionRandomName();
    }

    if ((lp_mapInstance == "")) {
        return libCOOC_gf_CC_CampaignMapName(libCOOC_gf_CC_CurrentMap());
    }

    lv_mapLink = UserDataGetGameLink("CoopMaps", lp_mapInstance, "MA - Map Link", 1);
    if ((lv_mapLink == "")) {
        return libCOOC_gf_CC_CampaignMapName(libCOOC_gf_CC_CurrentMap());
    }

    return UserDataGetText("CoopMaps", lp_mapInstance, "MA - Map Name", 1);
}

text CMUIX_MapSelectionDescription(string lp_mapInstance) {
    if ((CMUIX_MapSelectionIsRandom(lp_mapInstance) == true)) {
        return CMUIX_MapSelectionRandomDescription();
    }

    if ((lp_mapInstance == "") || (lp_mapInstance == null)) {
        return StringToText("");
    }

    return UserDataGetText("CoopMaps", lp_mapInstance, "MA - Map Description", 1);
}

string CMUIX_MapSelectionNormalizeSelection(string lp_mapInstance) {
    string lv_fromMapLink;

    lv_fromMapLink = "";
    if ((CMUIX_MapSelectionIsRandom(lp_mapInstance) == true)) {
        return CMUIX_MapSelection_Random;
    }

    if ((CMUIX_MapSelectionMapShouldShow(lp_mapInstance) == true)) {
        return lp_mapInstance;
    }

    lv_fromMapLink = CMUIX_MapSelectionInstanceForMapLink(lp_mapInstance);
    if ((CMUIX_MapSelectionMapShouldShow(lv_fromMapLink) == true)) {
        return lv_fromMapLink;
    }

    return "";
}

string CMUIX_MapSelectionFirstVisibleMap() {
    int lv_index;
    int lv_count;
    string lv_instance;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    lv_instance = "";
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopMaps", lv_index);
        if ((CMUIX_MapSelectionMapShouldShow(lv_instance) == true)) {
            return lv_instance;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_MapSelectionRandomVisibleMap() {
    int lv_index;
    int lv_count;
    int lv_candidateCount;
    string lv_instance;
    string lv_selected;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    lv_candidateCount = 0;
    lv_instance = "";
    lv_selected = "";
    while ((lv_index <= lv_count)) {
        lv_instance = UserDataInstance("CoopMaps", lv_index);
        if ((CMUIX_MapSelectionMapShouldShow(lv_instance) == true) && (UserDataGetInt("CoopMaps", lv_instance, "User - Random Allowed", 1) == 1)) {
            lv_candidateCount += 1;
            if ((RandomInt(1, lv_candidateCount) == 1)) {
                lv_selected = lv_instance;
            }
        }

        lv_index += 1;
    }

    if ((lv_selected == "")) {
        lv_selected = CMUIX_MapSelectionFirstVisibleMap();
    }

    return lv_selected;
}

void CMUIX_MapSelectionEnsureSelection() {
    string lv_currentMapInstance;
    string lv_selected;

    lv_currentMapInstance = CMUIX_MapSelectionCurrentMapInstance();
    lv_selected = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        CMUIX_MapSelectionSelected = lv_currentMapInstance;
        CMUIX_MapSelectionDraft = lv_currentMapInstance;
        return;
    }

    if ((CMUIX_MapSelectionSelected == "")) {
        lv_selected = CMUIX_MapSelectionNormalizeSelection(libCOTF_gv_sELECTED_Mission);
        if ((lv_selected == "")) {
            lv_selected = CMUIX_MapSelection_Random;
        }

        CMUIX_MapSelectionSelected = lv_selected;
    }
    else {
        CMUIX_MapSelectionSelected = CMUIX_MapSelectionNormalizeSelection(CMUIX_MapSelectionSelected);
        if ((CMUIX_MapSelectionSelected == "")) {
            CMUIX_MapSelectionSelected = CMUIX_MapSelection_Random;
        }
    }

    if ((CMUIX_MapSelectionDraft == "")) {
        CMUIX_MapSelectionDraft = CMUIX_MapSelectionSelected;
    }
}

void CMUIX_MapSelectionSetButtonText(text lp_text, playergroup lp_players) {
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionButton, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionButtonLabel, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionRetryButton, lp_text, lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionRetryButtonLabel, lp_text, lp_players);
}

void CMUIX_MapSelectionRefreshButton() {
    bool lv_isLauncher;
    string lv_currentMapInstance;
    text lv_text;

    lv_isLauncher = CMUIX_MapSelectionCurrentMapIsLauncher();
    lv_currentMapInstance = CMUIX_MapSelectionCurrentMapInstance();
    lv_text = StringToText("");
    CMUIX_MapSelectionEnsureSelection();
    if ((lv_isLauncher == true)) {
        lv_text = CMUIX_MapSelectionDisplayName(CMUIX_MapSelectionSelected);
    }
    else {
        lv_text = CMUIX_MapSelectionDisplayName(lv_currentMapInstance);
    }

    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_mapSelectionButton, true);
    CMUIX_SetSharedSetupControlEnabled(libCMUI_gv_mapSelectionRetryButton, true);
    CMUIX_MapSelectionSetButtonText(lv_text, PlayerGroupAll());
}

void CMUIX_MapSelectionRefreshDetails(int lp_player, string lp_mapInstance) {
    string lv_image;
    playergroup lv_playerGroup;

    lv_image = "";
    lv_playerGroup = PlayerGroupSingle(lp_player);
    if ((CMUICore_IsControlValid(libCMUI_gv_mapSelectionContainer) == false)) {
        return;
    }

    if ((CMUIX_MapSelectionIsRandom(lp_mapInstance) == true)) {
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionRandomImage, true, lv_playerGroup);
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionImageFrame, false, lv_playerGroup);
        CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionDescriptionLabel, CMUIX_MapSelectionDescription(lp_mapInstance), lv_playerGroup);
        return;
    }

    CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionRandomImage, false, lv_playerGroup);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionImageFrame, true, lv_playerGroup);
    lv_image = UserDataGetImagePath("CoopMaps", lp_mapInstance, "MA - Map Image", 1);
    if ((lv_image != "")) {
        libNtve_gf_SetDialogItemImage(libCMUI_gv_mapSelectionImage, lv_image, lv_playerGroup);
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionDescriptionLabel, CMUIX_MapSelectionDescription(lp_mapInstance), lv_playerGroup);
}

void CMUIX_MapSelectionClearList(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        libCMUI_gv_mapSelectionItemMaps[lv_index] = "";
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionItems[lv_index], false, lp_players);
        if ((CMUICore_IsControlValid(libCMUI_gv_mapSelectionItems[lv_index]) == true)) {
            CMUIX_MapSelectionSetEnabled(libCMUI_gv_mapSelectionItems[lv_index], true, lp_players);
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mapSelectionItems[lv_index], false, lp_players);
        }

        lv_index += 1;
    }
}

string CMUIX_MapSelectionListToggledMap() {
    string lv_currentMapInstance;

    lv_currentMapInstance = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        lv_currentMapInstance = CMUIX_MapSelectionCurrentMapInstance();
        if ((lv_currentMapInstance != "")) {
            return lv_currentMapInstance;
        }
    }

    return CMUIX_MapSelectionDraft;
}

void CMUIX_MapSelectionSetListItem(int lp_index, string lp_mapInstance, playergroup lp_players) {
    text lv_name;
    bool lv_toggled;
    string lv_toggledMap;

    lv_name = CMUIX_MapSelectionDisplayName(lp_mapInstance);
    lv_toggledMap = CMUIX_MapSelectionListToggledMap();
    lv_toggled = (lp_mapInstance == lv_toggledMap);
    if ((lp_index < 0) || (lp_index >= libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        return;
    }

    libCMUI_gv_mapSelectionItemMaps[lp_index] = lp_mapInstance;
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionItems[lp_index], StringToText(""), lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_mapSelectionItemLabels[lp_index], lv_name, lp_players);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_mapSelectionItems[lp_index], true, lp_players);
    if ((CMUICore_IsControlValid(libCMUI_gv_mapSelectionItems[lp_index]) == true)) {
        CMUIX_MapSelectionSetEnabled(libCMUI_gv_mapSelectionItems[lp_index], true, lp_players);
        libNtve_gf_SetDialogItemToggled(libCMUI_gv_mapSelectionItems[lp_index], lv_toggled, lp_players);
    }
}

void CMUIX_MapSelectionRefreshList(int lp_player) {
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_instance;
    playergroup lv_playerGroup;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    lv_slot = 0;
    lv_instance = "";
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_MapSelectionEnsureSelection();
    CMUIX_MapSelectionClearList(lv_playerGroup);
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        CMUIX_MapSelectionSetListItem(lv_slot, CMUIX_MapSelectionDraft, lv_playerGroup);
        CMUIX_MapSelectionRefreshDetails(lp_player, CMUIX_MapSelectionDraft);
        return;
    }

    CMUIX_MapSelectionSetListItem(lv_slot, CMUIX_MapSelection_Random, lv_playerGroup);
    lv_slot += 1;
    while ((lv_index <= lv_count) && (lv_slot < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        lv_instance = UserDataInstance("CoopMaps", lv_index);
        if ((CMUIX_MapSelectionMapShouldShow(lv_instance) == true)) {
            CMUIX_MapSelectionSetListItem(lv_slot, lv_instance, lv_playerGroup);
            lv_slot += 1;
        }

        lv_index += 1;
    }

    CMUIX_MapSelectionRefreshDetails(lp_player, CMUIX_MapSelectionDraft);
}

void CMUIX_MapSelectionRefreshListSelection(int lp_player) {
    int lv_index;
    string lv_toggledMap;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_toggledMap = CMUIX_MapSelectionListToggledMap();
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        if ((libCMUI_gv_mapSelectionItemMaps[lv_index] != "") && (CMUICore_IsControlValid(libCMUI_gv_mapSelectionItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_mapSelectionItems[lv_index], (libCMUI_gv_mapSelectionItemMaps[lv_index] == lv_toggledMap), lv_playerGroup);
        }

        lv_index += 1;
    }

    CMUIX_MapSelectionRefreshDetails(lp_player, CMUIX_MapSelectionDraft);
}

void CMUIX_MapSelectionResetReadyStatus() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    CMUIX_ReadyCountdownRunning = false;
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        libCOTF_gv_menu_ReadyStatus[lv_player] = false;
    }

    CMUIX_ReadyRefreshAll();
}

string CMUIX_MapSelectionAcceptedMission() {
    string lv_mission;

    lv_mission = CMUIX_MapSelectionDraft;
    if ((CMUIX_MapSelectionIsRandom(lv_mission) == true)) {
        lv_mission = CMUIX_MapSelectionRandomVisibleMap();
    }

    return lv_mission;
}

void CMUIX_MapSelectionAccept(int lp_player) {
    string lv_mission;
    string lv_mapLink;

    lv_mission = CMUIX_MapSelectionAcceptedMission();
    lv_mapLink = "";
    if ((lv_mission == "")) {
        return;
    }

    if ((CMUIX_MapSelectionDraft == CMUIX_MapSelection_Random)) {
        CMUIX_MapSelectionSelected = CMUIX_MapSelection_Random;
    }
    else {
        CMUIX_MapSelectionSelected = lv_mission;
    }

    libCOTF_gv_sELECTED_Mission = lv_mission;
    libCOTF_gv_mapSelect_Mission = lv_mission;
    lv_mapLink = UserDataGetGameLink("CoopMaps", lv_mission, "MA - Map Link", 1);
    if ((lv_mapLink != "")) {
        libCOTF_gv_sELECTED_Map = lv_mapLink;
    }

    CMUIX_MapSelectionDraft = CMUIX_MapSelectionSelected;
    CMUIX_DifficultyRefreshAll();
    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD)) {
        CMUIX_StandardBrutalPlusApplyRuntime();
    }

    CMUIX_MapSelectionRefreshButton();
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_MutatorInfoRefreshAll();
}

void CMUIX_MapSelectionCancel() {
    CMUIX_MapSelectionDraft = CMUIX_MapSelectionSelected;
    CMUIX_MapSelectionRefreshButton();
}

bool CMUIX_RandomSeedInputIsValid(string lp_value) {
    int lv_index;
    int lv_length;
    int lv_digit;
    int lv_limitDigit;
    string lv_character;
    string lv_digits;
    string lv_limit;

    lv_index = 1;
    lv_length = StringLength(lp_value);
    lv_digit = 0;
    lv_limitDigit = 0;
    lv_character = "";
    lv_digits = lp_value;
    lv_limit = "2147483647";
    if ((lv_length <= 0) || (lv_length > 16)) {
        return false;
    }

    if ((StringSub(lp_value, 1, 1) == "-")) {
        if ((lv_length == 1)) {
            return false;
        }

        lv_digits = StringSub(lp_value, 2, lv_length);
        lv_limit = "2147483648";
    }

    lv_length = StringLength(lv_digits);
    while ((lv_index <= lv_length)) {
        lv_character = StringSub(lv_digits, lv_index, lv_index);
        if ((StringFind("0123456789", lv_character, c_stringCase) == c_stringNotFound)) {
            return false;
        }

        lv_index += 1;
    }

    while ((StringLength(lv_digits) > 1) && (StringSub(lv_digits, 1, 1) == "0")) {
        lv_digits = StringSub(lv_digits, 2, StringLength(lv_digits));
    }

    lv_length = StringLength(lv_digits);
    if ((lv_length < 10)) {
        return true;
    }
    if ((lv_length > 10)) {
        return false;
    }

    lv_index = 1;
    while ((lv_index <= 10)) {
        lv_digit = StringToInt(StringSub(lv_digits, lv_index, lv_index));
        lv_limitDigit = StringToInt(StringSub(lv_limit, lv_index, lv_index));
        if ((lv_digit < lv_limitDigit)) {
            return true;
        }
        if ((lv_digit > lv_limitDigit)) {
            return false;
        }

        lv_index += 1;
    }

    return true;
}

string CMUIX_RandomSeedDisplayValue(int lp_seed) {
    int lv_length;
    string lv_result;

    lv_result = IntToString(lp_seed);
    lv_length = StringLength(lv_result);
    while ((lv_length < 16)) {
        if ((StringSub(lv_result, 1, 1) == "-")) {
            lv_result = ("-0" + StringSub(lv_result, 2, lv_length));
        }
        else {
            lv_result = ("0" + lv_result);
        }

        lv_length += 1;
    }

    return lv_result;
}

int CMUIX_RandomSeedButtonValue() {
    int lv_random;
    int lv_checksum;
    int lv_value;
    string lv_material;

    lv_random = RandomInt(0, 2147483647);
    lv_material = PlayerHandle(1) + "|" + PlayerHandle(2) + "|" + IntToString(DateTimeToInt(CurrentDateTimeGet())) + "|" + IntToString(lv_random);
    lv_checksum = CMUIX_ProfileChecksum(lv_material);
    lv_value = ModI(lv_random, 2147483647);
    if ((lv_value >= (2147483647 - lv_checksum))) {
        lv_value = lv_value - (2147483647 - lv_checksum);
    }
    else {
        lv_value += lv_checksum;
    }

    if ((lv_value < 0)) {
        lv_value = -lv_value;
    }

    if ((lv_value == 0)) {
        lv_value = 1;
    }

    return lv_value;
}

void CMUIX_RandomSeedInputRefresh() {
    string lv_value;

    lv_value = "";
    if ((CMUIX_RandomSeedDraftExplicit == true)) {
        lv_value = CMUIX_RandomSeedDisplayValue(CMUIX_RandomSeedDraft);
    }

    if ((CMUIX_IsControlValid(CMUIX_RandomSeedEditBox) == false)) {
        return;
    }

    CMUIX_RandomSeedInputRefreshing = true;
    libNtve_gf_SetDialogItemEditorValue(CMUIX_RandomSeedEditBox, lv_value, PlayerGroupAll());
    CMUIX_RandomSeedInputRefreshing = false;
}

void CMUIX_RandomSeedInputResetDraft() {
    CMUIX_RandomSeedDraftExplicit = CMUIX_ProfileRandomSeedExplicit;
    CMUIX_RandomSeedDraft = CMUIX_RandomSeed;
    CMUIX_RandomSeedInputRefresh();
}

void CMUIX_RandomSeedInputAccept(int lp_player) {
    bool lv_changed;
    string lv_value;

    lv_changed = false;
    lv_value = "";
    if ((CMUIX_IsControlValid(CMUIX_RandomSeedEditBox) == true)) {
        lv_value = libNtve_gf_DialogItemEditValue(CMUIX_RandomSeedEditBox, lp_player);
        if ((lv_value != "") && (CMUIX_RandomSeedInputIsValid(lv_value) == false)) {
            CMUIX_RandomSeedInputRefresh();
        }
    }

    lv_changed = (CMUIX_ProfileRandomSeedExplicit != CMUIX_RandomSeedDraftExplicit);
    if ((CMUIX_RandomSeedDraftExplicit == true) && (CMUIX_RandomSeed != CMUIX_RandomSeedDraft)) {
        lv_changed = true;
    }

    CMUIX_ProfileRandomSeedExplicit = CMUIX_RandomSeedDraftExplicit;
    CMUIX_RandomSeedResolved = CMUIX_RandomSeedDraftExplicit;
    CMUIX_RandomSeed = CMUIX_RandomSeedDraft;
    if ((CMUIX_ProfileRandomSeedExplicit == false)) {
        CMUIX_RandomSeed = 0;
    }

    if ((lv_changed == true)) {
        CMUIX_MapSelectionResetReadyStatus();
        CMUIX_MutatorInfoRefreshAll();
    }
}

void CMUIX_RandomSeedInputCancel() {
    CMUIX_RandomSeedInputResetDraft();
}

bool CMUIX_RandomSeedInputHandleEvent(int lp_player, int lp_control) {
    int lv_seed;
    string lv_value;

    lv_seed = 0;
    lv_value = "";
    if ((lp_control == CMUIX_RandomSeedRefreshButton)) {
        if ((CMUIX_ReadyCanEditSharedData(lp_player) == false)) {
            CMUIX_RandomSeedInputRefresh();
            return true;
        }

        lv_seed = CMUIX_RandomSeedButtonValue();
        CMUIX_RandomSeedDraftExplicit = true;
        CMUIX_RandomSeedDraft = lv_seed;
        CMUIX_RandomSeedInputRefresh();
        CMUIX_MapSelectionResetReadyStatus();
        return true;
    }

    if ((lp_control != CMUIX_RandomSeedEditBox)) {
        return false;
    }

    if ((CMUIX_RandomSeedInputRefreshing == true)) {
        return true;
    }

    if ((CMUIX_ReadyCanEditSharedData(lp_player) == false)) {
        CMUIX_RandomSeedInputRefresh();
        return true;
    }

    lv_value = libNtve_gf_DialogItemEditValue(CMUIX_RandomSeedEditBox, lp_player);
    if ((lv_value == "")) {
        CMUIX_RandomSeedDraftExplicit = false;
        CMUIX_RandomSeedDraft = 0;
        return true;
    }

    if ((lv_value == "-")) {
        return true;
    }

    if ((CMUIX_RandomSeedInputIsValid(lv_value) == false)) {
        CMUIX_RandomSeedInputRefresh();
        return true;
    }

    lv_seed = StringToInt(lv_value);
    CMUIX_RandomSeedDraftExplicit = true;
    CMUIX_RandomSeedDraft = lv_seed;
    return true;
}

void CMUIX_MapSelectionRefreshAll() {
    CMUIX_MapSelectionEnsureSelection();
    CMUIX_DifficultyRefreshAll();
    CMUIX_MapSelectionRefreshButton();
    CMUIX_EnemySelectionRefreshSelectedLabel();
    CMUIX_RandomSeedInputRefresh();
}

bool CMUIX_EnemySelectionFactionInstanceExists(string lp_faction) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAIFactions");
    if ((lp_faction == "") || (lp_faction == "[Default]")) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        if ((UserDataInstance("CoopAIFactions", lv_index) == lp_faction)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

string CMUIX_EnemySelectionRandomFaction(string lp_faction) {
    if ((CMUIX_EnemySelectionFactionInstanceExists(lp_faction) == false)) {
        return "";
    }

    return (CMUIX_EnemySelection_RandomFactionPrefix + lp_faction);
}

string CMUIX_EnemySelectionRandomFactionInstance(string lp_enemy) {
    int lv_prefixLength;
    int lv_length;
    string lv_faction;

    lv_prefixLength = StringLength(CMUIX_EnemySelection_RandomFactionPrefix);
    lv_length = StringLength(lp_enemy);
    lv_faction = "";
    if ((lv_length <= lv_prefixLength)) {
        return "";
    }

    if ((StringSub(lp_enemy, 1, lv_prefixLength) != CMUIX_EnemySelection_RandomFactionPrefix)) {
        return "";
    }

    lv_faction = StringSub(lp_enemy, (lv_prefixLength + 1), lv_length);
    if ((CMUIX_EnemySelectionFactionInstanceExists(lv_faction) == false)) {
        return "";
    }

    return lv_faction;
}

bool CMUIX_EnemySelectionIsRandom(string lp_enemy) {
    if ((lp_enemy == CMUIX_EnemySelection_Random)) {
        return true;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomOfficial)) {
        return true;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomUnofficial)) {
        return true;
    }

    if ((CMUIX_EnemySelectionRandomFactionInstance(lp_enemy) != "")) {
        return true;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomTerran)) {
        return true;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomProtoss)) {
        return true;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomZerg)) {
        return true;
    }

    return false;
}

bool CMUIX_EnemySelectionInstanceExists(string lp_enemyInstance) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    if ((lp_enemyInstance == "")) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        if ((UserDataInstance("CoopAICommanders", lv_index) == lp_enemyInstance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

bool CMUIX_EnemySelectionRaceIsStandard(string lp_race) {
    if ((lp_race == "Terr")) {
        return true;
    }

    if ((lp_race == "Prot")) {
        return true;
    }

    if ((lp_race == "Zerg")) {
        return true;
    }

    return false;
}

string CMUIX_EnemySelectionDefaultFactionForRace(string lp_race) {
    if ((lp_race == "Terr")) {
        return CMUIX_EnemyFaction_TerranDefault;
    }

    if ((lp_race == "Prot")) {
        return CMUIX_EnemyFaction_ProtossDefault;
    }

    if ((lp_race == "Zerg")) {
        return CMUIX_EnemyFaction_ZergDefault;
    }

    return "";
}

string CMUIX_EnemySelectionFactionForEnemy(string lp_enemyInstance) {
    string lv_faction;

    lv_faction = "";
    if ((CMUIX_EnemySelectionInstanceExists(lp_enemyInstance) == false)) {
        return "";
    }

    lv_faction = UserDataGetUserInstance("CoopAICommanders", lp_enemyInstance, "Faction", 1);
    if ((CMUIX_EnemySelectionFactionInstanceExists(lv_faction) == true)) {
        return lv_faction;
    }

    return "";
}

string CMUIX_EnemySelectionFactionRace(string lp_faction) {
    if ((CMUIX_EnemySelectionFactionInstanceExists(lp_faction) == false)) {
        return "";
    }

    return UserDataGetGameLink("CoopAIFactions", lp_faction, "Race", 1);
}

string CMUIX_EnemySelectionRaceForEnemy(string lp_enemyInstance) {
    string lv_faction;
    string lv_race;

    lv_faction = "";
    lv_race = "";
    if ((CMUIX_EnemySelectionInstanceExists(lp_enemyInstance) == false)) {
        return "";
    }

    lv_race = UserDataGetGameLink("CoopAICommanders", lp_enemyInstance, "Race", 1);
    if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == true)) {
        return lv_race;
    }

    lv_faction = CMUIX_EnemySelectionFactionForEnemy(lp_enemyInstance);
    lv_race = CMUIX_EnemySelectionFactionRace(lv_faction);
    if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == true)) {
        return lv_race;
    }

    return "";
}

bool CMUIX_EnemySelectionEnemyIsValid(string lp_enemyInstance) {
    if ((CMUIX_EnemySelectionInstanceExists(lp_enemyInstance) == false)) {
        return false;
    }

    if ((UserDataGetInt("CoopAICommanders", lp_enemyInstance, "UniqueIndex", 1) <= 0)) {
        return false;
    }

    return CMUIX_EnemySelectionRaceIsStandard(CMUIX_EnemySelectionRaceForEnemy(lp_enemyInstance));
}

bool CMUIX_EnemySelectionEnemyAccessibleForPlayer(int lp_player, string lp_enemyInstance) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return false;
    }

    if ((CMUIX_ProfileAIDisabled(lp_enemyInstance) == true)) {
        return false;
    }

    if ((UserDataGetInt("CoopAICommanders", lp_enemyInstance, "Auto - Unlocked", lp_player) != 0)) {
        return true;
    }

    return (UserDataGetInt("CoopAICommanders", lp_enemyInstance, "Dev - Developing", 1) != 1);
}

bool CMUIX_EnemySelectionEnemyProfileAccessibleForPlayer(int lp_player, string lp_enemyInstance) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return false;
    }

    if ((CMUIX_ProfileListContains(CMUIX_ProfileDisabledAIs, lp_enemyInstance) == true)) {
        return false;
    }

    if ((CMUIX_ProfileAIAllowed(lp_enemyInstance) == false)) {
        return false;
    }

    if ((UserDataGetInt("CoopAICommanders", lp_enemyInstance, "Auto - Unlocked", lp_player) != 0)) {
        return true;
    }

    return (UserDataGetInt("CoopAICommanders", lp_enemyInstance, "Dev - Developing", 1) != 1);
}

bool CMUIX_EnemySelectionEnemyIsValidForRace(string lp_enemyInstance, string lp_raceFilter) {
    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return false;
    }

    if ((lp_raceFilter == "")) {
        return true;
    }

    return (CMUIX_EnemySelectionRaceForEnemy(lp_enemyInstance) == lp_raceFilter);
}

bool CMUIX_EnemySelectionEnemyCanRandom(string lp_enemyInstance) {
    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return false;
    }

    if ((CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_enemyInstance) == false)) {
        return false;
    }

    return (UserDataGetInt("CoopAICommanders", lp_enemyInstance, "RandomMapInitAllowed", 1) == 1);
}

bool CMUIX_EnemySelectionEnemyCanRandomForRace(string lp_enemyInstance, string lp_raceFilter) {
    if ((CMUIX_EnemySelectionEnemyCanRandom(lp_enemyInstance) == false)) {
        return false;
    }

    if ((lp_raceFilter == "")) {
        return true;
    }

    return (CMUIX_EnemySelectionRaceForEnemy(lp_enemyInstance) == lp_raceFilter);
}

string CMUIX_EnemySelectionNormalizeLegacyRandom(string lp_enemy) {
    if ((lp_enemy == CMUIX_EnemySelection_Random)) {
        return CMUIX_EnemySelection_RandomOfficial;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomTerran)) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_TerranDefault);
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomProtoss)) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_ProtossDefault);
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomZerg)) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_ZergDefault);
    }

    return lp_enemy;
}

string CMUIX_EnemySelectionCurrentMapRaceFilter() {
    string lv_race;

    lv_race = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return "";
    }

    lv_race = libCOMI_gf_CM_GatAIRace(3);
    if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == true)) {
        return lv_race;
    }

    return "";
}

bool CMUIX_EnemySelectionEnemyShouldShow(string lp_enemyInstance) {
    if ((CMUIX_EnemySelectionIsRandom(lp_enemyInstance) == true)) {
        return true;
    }

    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return false;
    }

    if ((CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_enemyInstance) == false)) {
        return false;
    }

    return (UserDataGetInt("CoopAICommanders", lp_enemyInstance, "Show In UI", 1) == 1);
}

bool CMUIX_EnemySelectionRandomMatchesCandidate(string lp_randomEnemy, string lp_candidate) {
    string lv_faction;
    string lv_race;

    lv_faction = "";
    lv_race = "";
    if ((CMUIX_EnemySelectionEnemyCanRandom(lp_candidate) == false) || (CMUIX_EnemySelectionIsRandom(lp_candidate) == true)) {
        return false;
    }

    if ((lp_randomEnemy == CMUIX_EnemySelection_Random)) {
        return true;
    }

    if ((lp_randomEnemy == CMUIX_EnemySelection_RandomOfficial)) {
        return (UserDataGetInt("CoopAICommanders", lp_candidate, "Official", 1) == 1);
    }

    if ((lp_randomEnemy == CMUIX_EnemySelection_RandomUnofficial)) {
        return (UserDataGetInt("CoopAICommanders", lp_candidate, "Official", 1) != 1);
    }

    lv_faction = CMUIX_EnemySelectionRandomFactionInstance(lp_randomEnemy);
    if ((lv_faction != "")) {
        return (CMUIX_EnemySelectionFactionForEnemy(lp_candidate) == lv_faction);
    }

    lv_race = CMUIX_EnemySelectionRaceForEnemy(lp_candidate);
    if ((lp_randomEnemy == CMUIX_EnemySelection_RandomTerran)) {
        return (lv_race == "Terr");
    }

    if ((lp_randomEnemy == CMUIX_EnemySelection_RandomProtoss)) {
        return (lv_race == "Prot");
    }

    if ((lp_randomEnemy == CMUIX_EnemySelection_RandomZerg)) {
        return (lv_race == "Zerg");
    }

    return false;
}

bool CMUIX_EnemySelectionRandomHasCandidate(string lp_randomEnemy, string lp_raceFilter) {
    int lv_index;
    int lv_count;
    string lv_candidate;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    lv_candidate = "";
    if ((CMUIX_EnemySelectionIsRandom(lp_randomEnemy) == false)) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        lv_candidate = UserDataInstance("CoopAICommanders", lv_index);
        if ((CMUIX_EnemySelectionEnemyCanRandomForRace(lv_candidate, lp_raceFilter) == true) && (CMUIX_EnemySelectionRandomMatchesCandidate(lp_randomEnemy, lv_candidate) == true)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

bool CMUIX_EnemySelectionEnemyShouldShowForRace(string lp_enemyInstance, string lp_raceFilter) {
    string lv_race;

    lv_race = "";
    if ((CMUIX_EnemySelectionIsRandom(lp_enemyInstance) == true)) {
        return CMUIX_EnemySelectionRandomHasCandidate(lp_enemyInstance, lp_raceFilter);
    }

    if ((CMUIX_EnemySelectionEnemyShouldShow(lp_enemyInstance) == false)) {
        return false;
    }

    if ((lp_raceFilter == "")) {
        return true;
    }

    lv_race = CMUIX_EnemySelectionRaceForEnemy(lp_enemyInstance);
    if ((lv_race == lp_raceFilter)) {
        return true;
    }

    return false;
}

text CMUIX_EnemySelectionRandomName(string lp_enemy) {
    string lv_faction;

    lv_faction = CMUIX_EnemySelectionRandomFactionInstance(lp_enemy);
    if ((lp_enemy == CMUIX_EnemySelection_RandomOfficial)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomOfficialEnemyName");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomUnofficial)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomUnofficialEnemyName");
    }

    if ((lv_faction != "")) {
        return TextReplaceWord(StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomFactionEnemyNameFormat"), StringToText("FACTION"), UserDataGetText("CoopAIFactions", lv_faction, "Name", 1), c_stringReplaceAll, c_stringCase);
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomTerran)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomTerranEnemyName");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomProtoss)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomProtossEnemyName");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomZerg)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomZergEnemyName");
    }

    return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomEnemyName");
}

text CMUIX_EnemySelectionRandomDescription(string lp_enemy) {
    string lv_faction;

    lv_faction = CMUIX_EnemySelectionRandomFactionInstance(lp_enemy);
    if ((lp_enemy == CMUIX_EnemySelection_RandomOfficial)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomOfficialEnemyDescription");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomUnofficial)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomUnofficialEnemyDescription");
    }

    if ((lv_faction != "")) {
        return (StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomFactionEnemyDescriptionPrefix") + StringToText(" ") + UserDataGetText("CoopAIFactions", lv_faction, "Name", 1) + StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomFactionEnemyDescriptionSuffix"));
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomTerran)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomTerranEnemyDescription");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomProtoss)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomProtossEnemyDescription");
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomZerg)) {
        return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomZergEnemyDescription");
    }

    return StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomEnemyDescription");
}

text CMUIX_EnemySelectionDisplayName(string lp_enemyInstance) {
    if ((CMUIX_EnemySelectionIsRandom(lp_enemyInstance) == true)) {
        return CMUIX_EnemySelectionRandomName(lp_enemyInstance);
    }

    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return StringToText("");
    }

    return UserDataGetText("CoopAICommanders", lp_enemyInstance, "Name", 1);
}

text CMUIX_EnemySelectionDescription(string lp_enemyInstance) {
    if ((CMUIX_EnemySelectionIsRandom(lp_enemyInstance) == true)) {
        return CMUIX_EnemySelectionRandomDescription(lp_enemyInstance);
    }

    if ((CMUIX_EnemySelectionEnemyIsValid(lp_enemyInstance) == false)) {
        return StringToText("");
    }

    return UserDataGetText("CoopAICommanders", lp_enemyInstance, "Description", 1);
}

string CMUIX_EnemySelectionRaceState(string lp_enemyInstance) {
    string lv_faction;
    string lv_race;

    lv_faction = "";
    lv_race = "";
    if ((lp_enemyInstance == CMUIX_EnemySelection_Random) || (lp_enemyInstance == CMUIX_EnemySelection_RandomOfficial) || (lp_enemyInstance == CMUIX_EnemySelection_RandomUnofficial)) {
        return "Rand";
    }

    if ((lp_enemyInstance == CMUIX_EnemySelection_RandomTerran)) {
        return "Terr";
    }

    if ((lp_enemyInstance == CMUIX_EnemySelection_RandomProtoss)) {
        return "Prot";
    }

    if ((lp_enemyInstance == CMUIX_EnemySelection_RandomZerg)) {
        return "Zerg";
    }

    lv_faction = CMUIX_EnemySelectionRandomFactionInstance(lp_enemyInstance);
    if ((lv_faction != "")) {
        lv_race = CMUIX_EnemySelectionFactionRace(lv_faction);
        if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == false)) {
            return "Rand";
        }
    }
    else {
        if ((CMUIX_EnemySelectionInstanceExists(lp_enemyInstance) == true)) {
            lv_race = UserDataGetGameLink("CoopAICommanders", lp_enemyInstance, "Race", 1);
            lv_faction = CMUIX_EnemySelectionFactionForEnemy(lp_enemyInstance);
            if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == false)) {
                lv_race = CMUIX_EnemySelectionFactionRace(lv_faction);
            }

            if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == false)) {
                return "Rand";
            }
        }
        else {
            return "None";
        }
    }

    if ((lv_race == "Terr")) {
        return "Terr";
    }

    if ((lv_race == "Prot")) {
        return "Prot";
    }

    if ((lv_race == "Zerg")) {
        return "Zerg";
    }

    return "None";
}

string CMUIX_EnemySelectionFallbackForRace(string lp_raceFilter) {
    if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomOfficial, lp_raceFilter) == true)) {
        return CMUIX_EnemySelection_RandomOfficial;
    }

    if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomUnofficial, lp_raceFilter) == true)) {
        return CMUIX_EnemySelection_RandomUnofficial;
    }

    if ((lp_raceFilter == "Terr")) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_TerranDefault);
    }

    if ((lp_raceFilter == "Prot")) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_ProtossDefault);
    }

    if ((lp_raceFilter == "Zerg")) {
        return CMUIX_EnemySelectionRandomFaction(CMUIX_EnemyFaction_ZergDefault);
    }

    return CMUIX_EnemySelection_RandomOfficial;
}

string CMUIX_EnemySelectionNormalizeSelection(string lp_enemyInstance) {
    string lv_raceFilter;

    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    lp_enemyInstance = CMUIX_EnemySelectionNormalizeLegacyRandom(lp_enemyInstance);
    if ((CMUIX_EnemySelectionEnemyShouldShowForRace(lp_enemyInstance, lv_raceFilter) == true)) {
        return lp_enemyInstance;
    }

    return CMUIX_EnemySelectionFallbackForRace(lv_raceFilter);
}

void CMUIX_EnemySelectionEnsureSelection() {
    int lv_typeIndex;
    string lv_challenge;

    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
    lv_challenge = "";
    if ((CMUIX_EnemySelectionSelected == "")) {
        CMUIX_EnemySelectionSelected = CMUIX_EnemySelectionNormalizeSelection(CMUIX_EnemySelection_RandomOfficial);
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_challenge = CMUIX_MutatorChallengeSelected[lv_typeIndex];
        CMUIX_EnemySelectionSelected = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, lv_challenge, CMUIX_EnemySelectionSelected);
    }
    else {
        CMUIX_EnemySelectionSelected = CMUIX_EnemySelectionNormalizeSelection(CMUIX_EnemySelectionSelected);
    }

    if ((CMUIX_EnemySelectionDraft == "")) {
        CMUIX_EnemySelectionDraft = CMUIX_EnemySelectionSelected;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, lv_challenge, CMUIX_EnemySelectionDraft);
    }
    else {
        CMUIX_EnemySelectionDraft = CMUIX_EnemySelectionNormalizeSelection(CMUIX_EnemySelectionDraft);
    }
}

void CMUIX_EnemySelectionRefreshSelectedLabel() {
    text lv_enemyName;

    CMUIX_EnemySelectionEnsureSelection();
    lv_enemyName = CMUIX_EnemySelectionDisplayName(CMUIX_EnemySelectionSelected);
    CMUIX_MapSelectionSetText(libCMUI_gv_enemySelectionSelectedLabel, lv_enemyName, PlayerGroupAll());
    CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeSelectedEnemyLabel, lv_enemyName, PlayerGroupAll());
}

void CMUIX_EnemySelectionRefreshDetails(int lp_player, string lp_enemyInstance) {
    playergroup lv_playerGroup;

    lv_playerGroup = PlayerGroupSingle(lp_player);
    if ((CMUICore_IsControlValid(libCMUI_gv_enemySelectionDescriptionLabel) == false)) {
        return;
    }

    CMUIX_MapSelectionSetText(libCMUI_gv_enemySelectionDescriptionLabel, CMUIX_EnemySelectionDescription(lp_enemyInstance), lv_playerGroup);
}

void CMUIX_EnemySelectionClearList(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        libCMUI_gv_enemySelectionItemEnemies[lv_index] = "";
        CMUIX_MapSelectionSetVisible(libCMUI_gv_enemySelectionItems[lv_index], false, lp_players);
        if ((CMUICore_IsControlValid(libCMUI_gv_enemySelectionItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_enemySelectionItems[lv_index], false, lp_players);
            DialogControlSetAnimationState(libCMUI_gv_enemySelectionItems[lv_index], lp_players, "RaceState", "None");
        }

        if ((CMUICore_IsControlValid(libCMUI_gv_enemySelectionItemRaceIcons[lv_index]) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_enemySelectionItemRaceIcons[lv_index], lp_players, "RaceState", "None");
        }

        lv_index += 1;
    }
}

void CMUIX_EnemySelectionSetListItem(int lp_index, string lp_enemyInstance, playergroup lp_players) {
    text lv_name;
    string lv_raceState;

    lv_name = CMUIX_EnemySelectionDisplayName(lp_enemyInstance);
    lv_raceState = CMUIX_EnemySelectionRaceState(lp_enemyInstance);
    if ((lp_index < 0) || (lp_index >= libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        return;
    }

    libCMUI_gv_enemySelectionItemEnemies[lp_index] = lp_enemyInstance;
    CMUIX_MapSelectionSetText(libCMUI_gv_enemySelectionItems[lp_index], StringToText(""), lp_players);
    CMUIX_MapSelectionSetText(libCMUI_gv_enemySelectionItemLabels[lp_index], lv_name, lp_players);
    CMUIX_MapSelectionSetVisible(libCMUI_gv_enemySelectionItems[lp_index], true, lp_players);
    if ((CMUICore_IsControlValid(libCMUI_gv_enemySelectionItems[lp_index]) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_enemySelectionItems[lp_index], lp_players, "RaceState", lv_raceState);
        libNtve_gf_SetDialogItemToggled(libCMUI_gv_enemySelectionItems[lp_index], (lp_enemyInstance == CMUIX_EnemySelectionDraft), lp_players);
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_enemySelectionItemRaceIcons[lp_index]) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_enemySelectionItemRaceIcons[lp_index], lp_players, "RaceState", lv_raceState);
    }
}

bool CMUIX_EnemySelectionAlreadyListed(string lp_enemyInstance, int lp_count) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < lp_count)) {
        if ((libCMUI_gv_enemySelectionItemEnemies[lv_index] == lp_enemyInstance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

void CMUIX_EnemySelectionRefreshList(int lp_player) {
    int lv_factionIndex;
    int lv_factionCount;
    int lv_index;
    int lv_count;
    int lv_slot;
    string lv_faction;
    string lv_instance;
    string lv_challenge;
    string lv_allowedEnemy;
    string lv_randomEnemy;
    string lv_raceFilter;
    string lv_lockedAI;
    bool lv_restricted;
    playergroup lv_playerGroup;

    CMUIX_ProfileRuntimeLocksRefresh();
    lv_factionIndex = 1;
    lv_factionCount = UserDataInstanceCount("CoopAIFactions");
    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    lv_slot = 0;
    lv_faction = "";
    lv_instance = "";
    lv_challenge = "";
    lv_allowedEnemy = "";
    lv_randomEnemy = "";
    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    lv_lockedAI = CMUIX_MutatorChallengeSelectedLockedAI();
    lv_restricted = false;
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_challenge = CMUIX_MutatorChallengeSelected[CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType)];
        lv_restricted = CMUIX_MutatorChallengeHasAIRestriction(CMUIX_MutatorChallengeCurrentType, lv_challenge);
    }

    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_EnemySelectionEnsureSelection();
    CMUIX_EnemySelectionClearList(lv_playerGroup);
    if ((lv_lockedAI != "")) {
        CMUIX_EnemySelectionDraft = lv_lockedAI;
        if ((CMUIX_EnemySelectionEnemyIsValidForRace(lv_lockedAI, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_lockedAI) == true)) {
            CMUIX_EnemySelectionSetListItem(lv_slot, lv_lockedAI, lv_playerGroup);
        }

        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_enemySelectionTileList, lp_player, false);
        CMUIX_EnemySelectionRefreshDetails(lp_player, CMUIX_EnemySelectionDraft);
        return;
    }

    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_enemySelectionTileList, lp_player, CMUIX_ReadyCanEditSharedData(lp_player));
    if ((lv_restricted == true)) {
        CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, lv_challenge, CMUIX_EnemySelectionDraft);
        CMUIX_EnemySelectionSetListItem(lv_slot, CMUIX_EnemySelection_Random, lv_playerGroup);
        lv_slot += 1;
        lv_index = 1;
        while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max) && (lv_slot < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
            lv_allowedEnemy = CMUIX_MutatorChallengeAIAt(CMUIX_MutatorChallengeCurrentType, lv_challenge, lv_index);
            if ((lv_allowedEnemy != "") && (CMUIX_EnemySelectionEnemyIsValidForRace(lv_allowedEnemy, lv_raceFilter) == true) && (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_allowedEnemy) == true) && (CMUIX_EnemySelectionAlreadyListed(lv_allowedEnemy, lv_slot) == false)) {
                CMUIX_EnemySelectionSetListItem(lv_slot, lv_allowedEnemy, lv_playerGroup);
                lv_slot += 1;
            }

            lv_index += 1;
        }

        CMUIX_EnemySelectionRefreshDetails(lp_player, CMUIX_EnemySelectionDraft);
        return;
    }

    if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomOfficial, lv_raceFilter) == true)) {
        CMUIX_EnemySelectionSetListItem(lv_slot, CMUIX_EnemySelection_RandomOfficial, lv_playerGroup);
        lv_slot += 1;
    }

    if ((CMUIX_EnemySelectionRandomHasCandidate(CMUIX_EnemySelection_RandomUnofficial, lv_raceFilter) == true)) {
        CMUIX_EnemySelectionSetListItem(lv_slot, CMUIX_EnemySelection_RandomUnofficial, lv_playerGroup);
        lv_slot += 1;
    }

    while ((lv_factionIndex <= lv_factionCount) && (lv_slot < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        lv_faction = UserDataInstance("CoopAIFactions", lv_factionIndex);
        lv_randomEnemy = CMUIX_EnemySelectionRandomFaction(lv_faction);
        if ((lv_randomEnemy != "") && (CMUIX_EnemySelectionRandomHasCandidate(lv_randomEnemy, lv_raceFilter) == true)) {
            CMUIX_EnemySelectionSetListItem(lv_slot, lv_randomEnemy, lv_playerGroup);
            lv_slot += 1;
        }

        lv_factionIndex += 1;
    }

    while ((lv_index <= lv_count) && (lv_slot < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        lv_instance = UserDataInstance("CoopAICommanders", lv_index);
        if ((CMUIX_EnemySelectionEnemyShouldShowForRace(lv_instance, lv_raceFilter) == true)) {
            CMUIX_EnemySelectionSetListItem(lv_slot, lv_instance, lv_playerGroup);
            lv_slot += 1;
        }

        lv_index += 1;
    }

    CMUIX_EnemySelectionRefreshDetails(lp_player, CMUIX_EnemySelectionDraft);
}

void CMUIX_EnemySelectionRefreshListSelection(int lp_player) {
    int lv_index;
    playergroup lv_playerGroup;

    lv_index = 0;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    while ((lv_index < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        if ((libCMUI_gv_enemySelectionItemEnemies[lv_index] != "") && (CMUICore_IsControlValid(libCMUI_gv_enemySelectionItems[lv_index]) == true)) {
            libNtve_gf_SetDialogItemToggled(libCMUI_gv_enemySelectionItems[lv_index], (libCMUI_gv_enemySelectionItemEnemies[lv_index] == CMUIX_EnemySelectionDraft), lv_playerGroup);
        }

        lv_index += 1;
    }

    CMUIX_EnemySelectionRefreshDetails(lp_player, CMUIX_EnemySelectionDraft);
}

void CMUIX_EnemySelectionAccept(int lp_player) {
    if ((CMUIX_EnemySelectionDraft == "")) {
        return;
    }

    CMUIX_EnemySelectionSelected = CMUIX_EnemySelectionDraft;
    CMUIX_EnemySelectionRefreshSelectedLabel();
    CMUIX_EnemySelectionRefreshList(lp_player);
}

void CMUIX_EnemySelectionCancel() {
    CMUIX_EnemySelectionDraft = CMUIX_EnemySelectionSelected;
}

int CMUIX_MutatorChallengeTypeIndex(string lp_type) {
    if ((lp_type == CMUIX_MutatorChallenge_Type_CM)) {
        return 2;
    }

    return 1;
}

string CMUIX_MutatorChallengeNormalizeType(string lp_type) {
    if ((lp_type == CMUIX_MutatorChallenge_Type_CM)) {
        return CMUIX_MutatorChallenge_Type_CM;
    }

    return CMUIX_MutatorChallenge_Type_Official;
}

string CMUIX_MutatorChallengeUserType(string lp_type) {
    string lv_type;
    string lv_userType;

    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_userType = UserDataGetGameLink("MutatorChallengesType", lv_type, "MC - Type User Type", 1);
    if ((lv_userType == "")) {
        lv_userType = UserDataGetGameLink("MutatorChallengesType", CMUIX_MutatorChallenge_Type_Official, "MC - Type User Type", 1);
    }

    return lv_userType;
}

bool CMUIX_MutatorChallengeIsRandom(string lp_challenge) {
    if ((lp_challenge == CMUIX_MutatorChallenge_Random)) {
        return true;
    }

    return false;
}

text CMUIX_MutatorChallengeRandomName() {
    return StringExternal("CMUI/ScreenCoopCampaign/MutatorChallengeSelectionPanel/RandomChallengeName");
}

text CMUIX_MutatorChallengeRandomDescription() {
    return StringExternal("CMUI/ScreenCoopCampaign/MutatorChallengeSelectionPanel/RandomChallengeDescription");
}

bool CMUIX_MutatorChallengeInstanceExists(string lp_type, string lp_challenge) {
    int lv_index;
    int lv_count;
    string lv_userType;

    lv_index = 1;
    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lp_challenge == "") || (lv_userType == "")) {
        return false;
    }

    lv_count = UserDataInstanceCount(lv_userType);
    while ((lv_index <= lv_count)) {
        if ((UserDataInstance(lv_userType, lv_index) == lp_challenge)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

string CMUIX_MutatorChallengeRawMapLink(string lp_type, string lp_challenge) {
    string lv_userType;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lv_userType == "")) {
        return "";
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return "";
    }

    return UserDataGetGameLink(lv_userType, lp_challenge, "Map", 1);
}

string CMUIX_MutatorChallengeAIAt(string lp_type, string lp_challenge, int lp_index) {
    string lv_userType;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lp_index < 1) || (lp_index > libCMUI_gv_cMUI_MutatorChallenge_AI_Max) || (lv_userType == "")) {
        return "";
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return "";
    }

    return UserDataGetUserInstance(lv_userType, lp_challenge, "AI", lp_index);
}

int CMUIX_MutatorChallengeAllowedAICount(string lp_type, string lp_challenge) {
    int lv_count;
    int lv_index;

    lv_count = 0;
    lv_index = 1;
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max)) {
        if ((CMUIX_MutatorChallengeAIAt(lp_type, lp_challenge, lv_index) != "")) {
            lv_count += 1;
        }

        lv_index += 1;
    }

    return lv_count;
}

string CMUIX_MutatorChallengeLockedAI(string lp_type, string lp_challenge) {
    int lv_index;
    string lv_ai;

    lv_index = 1;
    lv_ai = "";
    if ((CMUIX_MutatorChallengeAllowedAICount(lp_type, lp_challenge) != 1)) {
        return "";
    }

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max)) {
        lv_ai = CMUIX_MutatorChallengeAIAt(lp_type, lp_challenge, lv_index);
        if ((lv_ai != "")) {
            return lv_ai;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_MutatorChallengeSelectedLockedAI() {
    int lv_typeIndex;
    string lv_type;

    lv_typeIndex = 0;
    lv_type = "";
    if ((CMUIX_CurrentMode != CMUIX_MODE_MUTATOR)) {
        return "";
    }

    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    return CMUIX_MutatorChallengeLockedAI(lv_type, CMUIX_MutatorChallengeSelected[lv_typeIndex]);
}

string CMUIX_MutatorChallengeDraftLockedAI() {
    int lv_typeIndex;
    string lv_type;

    lv_typeIndex = 0;
    lv_type = "";
    if ((CMUIX_CurrentMode != CMUIX_MODE_MUTATOR)) {
        return "";
    }

    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    return CMUIX_MutatorChallengeLockedAI(lv_type, CMUIX_MutatorChallengeDraft[lv_typeIndex]);
}

bool CMUIX_MutatorChallengeHasAIRestriction(string lp_type, string lp_challenge) {
    return (CMUIX_MutatorChallengeAllowedAICount(lp_type, lp_challenge) > 0);
}

bool CMUIX_MutatorChallengeAllowsEnemyInstance(string lp_type, string lp_challenge, string lp_enemyInstance) {
    int lv_index;
    string lv_allowedEnemy;

    lv_index = 1;
    lv_allowedEnemy = "";
    if ((CMUIX_MutatorChallengeHasAIRestriction(lp_type, lp_challenge) == false)) {
        return true;
    }

    if ((lp_enemyInstance == "") || (CMUIX_EnemySelectionIsRandom(lp_enemyInstance) == true)) {
        return false;
    }

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max)) {
        lv_allowedEnemy = CMUIX_MutatorChallengeAIAt(lp_type, lp_challenge, lv_index);
        if ((lv_allowedEnemy == lp_enemyInstance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

bool CMUIX_MutatorChallengeAIRestrictionMatchesRace(string lp_type, string lp_challenge, string lp_raceFilter) {
    int lv_index;
    string lv_allowedEnemy;
    string lv_lockedAI;

    lv_index = 1;
    lv_allowedEnemy = "";
    lv_lockedAI = CMUIX_MutatorChallengeLockedAI(lp_type, lp_challenge);
    if ((lv_lockedAI != "")) {
        return ((CMUIX_EnemySelectionEnemyIsValidForRace(lv_lockedAI, lp_raceFilter) == true) && (CMUIX_EnemySelectionEnemyProfileAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_lockedAI) == true));
    }

    if ((CMUIX_MutatorChallengeHasAIRestriction(lp_type, lp_challenge) == false)) {
        return true;
    }

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_AI_Max)) {
        lv_allowedEnemy = CMUIX_MutatorChallengeAIAt(lp_type, lp_challenge, lv_index);
        if ((lv_allowedEnemy != "") && (CMUIX_EnemySelectionEnemyProfileAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_allowedEnemy) == true)) {
            if ((lp_raceFilter == "") || (CMUIX_EnemySelectionEnemyIsValidForRace(lv_allowedEnemy, lp_raceFilter) == true)) {
                return true;
            }
        }

        lv_index += 1;
    }

    return false;
}

bool CMUIX_MutatorChallengeCurrentMapMatches(string lp_type, string lp_challenge) {
    string lv_currentMapInstance;
    string lv_currentMapLink;
    string lv_challengeMapLink;

    lv_currentMapInstance = CMUIX_MapSelectionCurrentMapInstance();
    lv_currentMapLink = "";
    lv_challengeMapLink = CMUIX_MutatorChallengeRawMapLink(lp_type, lp_challenge);
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return true;
    }

    if ((lv_currentMapInstance == "") || (lv_challengeMapLink == "")) {
        return false;
    }

    lv_currentMapLink = UserDataGetGameLink("CoopMaps", lv_currentMapInstance, "MA - Map Link", 1);
    if ((lv_currentMapLink == lv_challengeMapLink)) {
        return true;
    }

    return false;
}

bool CMUIX_MutatorChallengeShouldShow(string lp_type, string lp_challenge) {
    string lv_raceFilter;

    lv_raceFilter = "";
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return true;
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return false;
    }

    if (CMUIX_MutatorChallengeMutatorsAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_type, lp_challenge) == false) {
        return false;
    }

    if ((CMUIX_MutatorChallengeLockedAI(lp_type, lp_challenge) != "") && (CMUIX_MutatorChallengeAIRestrictionMatchesRace(lp_type, lp_challenge, "") == false)) {
        return false;
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        return true;
    }

    if ((CMUIX_MutatorChallengeCurrentMapMatches(lp_type, lp_challenge) == false)) {
        return false;
    }

    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    if ((CMUIX_MutatorChallengeAIRestrictionMatchesRace(lp_type, lp_challenge, lv_raceFilter) == false)) {
        return false;
    }

    return true;
}

string CMUIX_MutatorChallengeFirstVisibleForType(string lp_type) {
    int lv_index;
    int lv_count;
    string lv_userType;
    string lv_challenge;

    lv_index = 1;
    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    lv_challenge = "";
    if ((lv_userType == "")) {
        return "";
    }

    lv_count = UserDataInstanceCount(lv_userType);
    while ((lv_index <= lv_count)) {
        lv_challenge = UserDataInstance(lv_userType, lv_index);
        if ((CMUIX_MutatorChallengeShouldShow(lp_type, lv_challenge) == true)) {
            return lv_challenge;
        }

        lv_index += 1;
    }

    return "";
}

string CMUIX_MutatorChallengeFirstForType(string lp_type) {
    string lv_userType;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lv_userType == "")) {
        return "";
    }

    if ((UserDataInstanceCount(lv_userType) <= 0)) {
        return "";
    }

    return UserDataInstance(lv_userType, 1);
}

string CMUIX_MutatorChallengeDefaultForType(string lp_type) {
    int lv_count;
    int lv_periodHours;
    int lv_periodSeconds;
    int lv_elapsedSeconds;
    int lv_cycleIndex;
    int lv_instanceIndex;
    string lv_type;
    string lv_userType;
    string lv_startTime;
    string lv_challenge;

    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_userType = CMUIX_MutatorChallengeUserType(lv_type);
    lv_count = 0;
    lv_periodHours = 0;
    lv_periodSeconds = 0;
    lv_elapsedSeconds = 0;
    lv_cycleIndex = 0;
    lv_instanceIndex = 1;
    lv_startTime = "";
    lv_challenge = "";
    if ((lv_userType == "")) {
        return "";
    }

    lv_count = UserDataInstanceCount(lv_userType);
    if ((lv_count <= 0)) {
        return "";
    }

    lv_periodHours = UserDataGetInt("MutatorChallengesType", lv_type, "MC - Cycle Period", 1);
    lv_startTime = UserDataGetString("MutatorChallengesType", lv_type, "MC - Cycle Start Time", 1);
    if ((lv_periodHours <= 0) || (lv_startTime == "")) {
        return CMUIX_MutatorChallengeFirstVisibleForType(lv_type);
    }

    lv_periodSeconds = lv_periodHours * 3600;
    lv_elapsedSeconds = DateTimeToInt(CurrentDateTimeGet()) - DateTimeToInt(StringToDateTime(lv_startTime));
    if ((lv_elapsedSeconds < 0)) {
        lv_elapsedSeconds = 0;
    }

    lv_cycleIndex = lv_elapsedSeconds / lv_periodSeconds;
    lv_instanceIndex = ModI(lv_cycleIndex, lv_count) + 1;
    lv_challenge = UserDataInstance(lv_userType, lv_instanceIndex);
    if ((CMUIX_MutatorChallengeShouldShow(lv_type, lv_challenge) == true)) {
        return lv_challenge;
    }

    return CMUIX_MutatorChallenge_Random;
}

void CMUIX_MutatorChallengeBuildVisibleCache(string lp_type) {
    int lv_index;
    int lv_count;
    int lv_slot;
    int lv_typeIndex;
    string lv_type;
    string lv_userType;
    string lv_challenge;

    lv_index = 1;
    lv_count = 0;
    lv_slot = 0;
    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    lv_userType = CMUIX_MutatorChallengeUserType(lv_type);
    lv_challenge = "";
    while ((lv_slot <= libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        CMUIX_MutatorChallengeVisibleChallenges[lv_typeIndex][lv_slot] = "";
        lv_slot += 1;
    }

    lv_slot = 0;
    CMUIX_MutatorChallengeVisibleChallenges[lv_typeIndex][lv_slot] = CMUIX_MutatorChallenge_Random;
    lv_slot += 1;
    if ((lv_userType != "")) {
        lv_count = UserDataInstanceCount(lv_userType);
        while ((lv_index <= lv_count) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
            lv_challenge = UserDataInstance(lv_userType, lv_index);
            if ((CMUIX_MutatorChallengeShouldShow(lv_type, lv_challenge) == true)) {
                CMUIX_MutatorChallengeVisibleChallenges[lv_typeIndex][lv_slot] = lv_challenge;
                lv_slot += 1;
            }

            lv_index += 1;
        }
    }

    CMUIX_MutatorChallengeVisibleCount[lv_typeIndex] = lv_slot;
}

bool CMUIX_MutatorChallengeVisibleCacheContains(string lp_type, string lp_challenge) {
    int lv_slot;
    int lv_typeIndex;
    string lv_type;

    lv_slot = 0;
    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return true;
    }

    while ((lv_slot < CMUIX_MutatorChallengeVisibleCount[lv_typeIndex]) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        if ((CMUIX_MutatorChallengeVisibleChallenges[lv_typeIndex][lv_slot] == lp_challenge)) {
            return true;
        }

        lv_slot += 1;
    }

    return false;
}

void CMUIX_MutatorChallengeInitializeType(string lp_type) {
    int lv_typeIndex;
    string lv_type;
    string lv_defaultChallenge;

    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    lv_defaultChallenge = "";
    if ((CMUIX_MutatorChallengeTypeReady[lv_typeIndex] == true)) {
        return;
    }

    CMUIX_MutatorChallengeBuildVisibleCache(lv_type);
    lv_defaultChallenge = CMUIX_MutatorChallengeDefaultForType(lv_type);
    if ((lv_defaultChallenge == "")) {
        lv_defaultChallenge = CMUIX_MutatorChallenge_Random;
    }

    CMUIX_MutatorChallengeDefault[lv_typeIndex] = lv_defaultChallenge;
    CMUIX_MutatorChallengeTypeReady[lv_typeIndex] = true;
    if ((CMUIX_MutatorChallengeSelected[lv_typeIndex] == "")) {
        CMUIX_MutatorChallengeSelected[lv_typeIndex] = lv_defaultChallenge;
    }
    else {
        if ((CMUIX_MutatorChallengeVisibleCacheContains(lv_type, CMUIX_MutatorChallengeSelected[lv_typeIndex]) == false)) {
            CMUIX_MutatorChallengeSelected[lv_typeIndex] = lv_defaultChallenge;
        }
    }

    if ((CMUIX_MutatorChallengeDraft[lv_typeIndex] == "")) {
        CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    }
    else {
        if ((CMUIX_MutatorChallengeVisibleCacheContains(lv_type, CMUIX_MutatorChallengeDraft[lv_typeIndex]) == false)) {
            CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeSelected[lv_typeIndex];
        }
    }
}

void CMUIX_MutatorChallengeInitializeAllTypes() {
    CMUIX_MutatorChallengeInitializeType(CMUIX_MutatorChallenge_Type_Official);
    CMUIX_MutatorChallengeInitializeType(CMUIX_MutatorChallenge_Type_CM);
}

string CMUIX_MutatorChallengeNormalizeSelection(string lp_type, string lp_challenge) {
    string lv_defaultChallenge;
    string lv_type;
    int lv_typeIndex;

    lv_defaultChallenge = "";
    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return CMUIX_MutatorChallenge_Random;
    }

    CMUIX_MutatorChallengeInitializeType(lv_type);
    if ((CMUIX_MutatorChallengeVisibleCacheContains(lv_type, lp_challenge) == true)) {
        return lp_challenge;
    }

    lv_defaultChallenge = CMUIX_MutatorChallengeDefault[lv_typeIndex];
    if ((lv_defaultChallenge != "")) {
        return lv_defaultChallenge;
    }

    return CMUIX_MutatorChallenge_Random;
}

void CMUIX_MutatorChallengeEnsureSelection() {
    int lv_typeIndex;
    string lv_type;

    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    CMUIX_MutatorChallengeCurrentType = lv_type;
    CMUIX_MutatorChallengeInitializeType(lv_type);
    if ((CMUIX_MutatorChallengeSelected[lv_typeIndex] == "")) {
        CMUIX_MutatorChallengeSelected[lv_typeIndex] = CMUIX_MutatorChallengeDefault[lv_typeIndex];
        if ((CMUIX_MutatorChallengeSelected[lv_typeIndex] == "")) {
            CMUIX_MutatorChallengeSelected[lv_typeIndex] = CMUIX_MutatorChallenge_Random;
        }
    }
    else {
        CMUIX_MutatorChallengeSelected[lv_typeIndex] = CMUIX_MutatorChallengeNormalizeSelection(lv_type, CMUIX_MutatorChallengeSelected[lv_typeIndex]);
    }

    if ((CMUIX_MutatorChallengeDraft[lv_typeIndex] == "")) {
        CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    }
    else {
        CMUIX_MutatorChallengeDraft[lv_typeIndex] = CMUIX_MutatorChallengeNormalizeSelection(lv_type, CMUIX_MutatorChallengeDraft[lv_typeIndex]);
    }
}

string CMUIX_MutatorChallengeCurrentDraft() {
    int lv_typeIndex;

    CMUIX_MutatorChallengeEnsureSelection();
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
    return CMUIX_MutatorChallengeDraft[lv_typeIndex];
}

string CMUIX_MutatorChallengeCurrentSelected() {
    int lv_typeIndex;

    CMUIX_MutatorChallengeEnsureSelection();
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(CMUIX_MutatorChallengeCurrentType);
    return CMUIX_MutatorChallengeSelected[lv_typeIndex];
}

text CMUIX_MutatorChallengeDisplayName(string lp_type, string lp_challenge) {
    string lv_userType;
    text lv_name;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    lv_name = StringToText("");
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return CMUIX_MutatorChallengeRandomName();
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return StringToText(lp_challenge);
    }

    lv_name = UserDataGetText(lv_userType, lp_challenge, "Name", 1);
    if ((TextToString(lv_name) == "")) {
        return StringToText(lp_challenge);
    }

    return lv_name;
}

string CMUIX_MutatorChallengeMapLink(string lp_type, string lp_challenge) {
    return CMUIX_MutatorChallengeRawMapLink(lp_type, lp_challenge);
}

string CMUIX_MutatorChallengeMapInstance(string lp_type, string lp_challenge) {
    string lv_mapLink;

    lv_mapLink = CMUIX_MutatorChallengeMapLink(lp_type, lp_challenge);
    if ((lv_mapLink == "")) {
        return "";
    }

    return CMUIX_MapSelectionInstanceForMapLink(lv_mapLink);
}

text CMUIX_MutatorChallengeDescription(string lp_type, string lp_challenge) {
    string lv_userType;
    string lv_mapInstance;
    text lv_description;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    lv_mapInstance = "";
    lv_description = StringToText("");
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return CMUIX_MutatorChallengeRandomDescription();
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return StringToText("");
    }

    lv_description = UserDataGetText(lv_userType, lp_challenge, "Description", 1);
    if ((TextToString(lv_description) != "")) {
        return lv_description;
    }

    lv_mapInstance = CMUIX_MutatorChallengeMapInstance(lp_type, lp_challenge);
    if ((lv_mapInstance != "")) {
        return CMUIX_MapSelectionDescription(lv_mapInstance);
    }

    return StringToText("");
}

string CMUIX_MutatorChallengeImagePath(string lp_type, string lp_challenge) {
    string lv_mapInstance;

    lv_mapInstance = CMUIX_MutatorChallengeMapInstance(lp_type, lp_challenge);
    if ((lv_mapInstance == "")) {
        return "";
    }

    return UserDataGetImagePath("CoopMaps", lv_mapInstance, "MA - Map Image", 1);
}

string CMUIX_MutatorChallengeMutatorAt(string lp_type, string lp_challenge, int lp_index) {
    string lv_userType;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lp_index < 1) || (lp_index > libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max) || (lv_userType == "")) {
        return "";
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return "";
    }

    return UserDataGetUserInstance(lv_userType, lp_challenge, "Mutators", lp_index);
}

bool CMUIX_MutatorChallengeMutatorsAccessibleForPlayer(int lp_player, string lp_type, string lp_challenge) {
    int lv_index;
    string lv_mutator;

    lv_index = 1;
    lv_mutator = "";
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        lv_mutator = CMUIX_MutatorChallengeMutatorAt(lp_type, lp_challenge, lv_index);
        if ((lv_mutator != "") && (lv_mutator != null)) {
            if (CMUIX_MutatorAccessibleForPlayer(lp_player, lv_mutator) == false) {
                return false;
            }
        }

        lv_index += 1;
    }

    return true;
}

bool CMUIX_MutatorChallengeMutatorEnhancedAt(string lp_type, string lp_challenge, int lp_index, string lp_mutator) {
    string lv_userType;

    lv_userType = CMUIX_MutatorChallengeUserType(lp_type);
    if ((lp_index < 1) || (lp_index > libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max) || (lv_userType == "") || (lp_mutator == "")) {
        return false;
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lp_type, lp_challenge) == false)) {
        return false;
    }

    if ((UserDataGetInt(lv_userType, lp_challenge, "Mutators Enhanced", lp_index) != 1)) {
        return false;
    }

    return libCOMU_gf_MutatorHasEnhancement(lp_mutator);
}

int CMUIX_MutatorChallengeApplyRuntime(string lp_type, string lp_challenge) {
    int lv_index;
    int lv_enabled;
    int lv_chaosCount;
    int lv_typeIndex;
    string lv_type;
    string lv_mutator;
    bool lv_enhanced;

    lv_index = 1;
    lv_enabled = 0;
    lv_chaosCount = 0;
    lv_type = CMUIX_MutatorChallengeNormalizeType(lp_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    lv_mutator = "";
    lv_enhanced = false;
    if ((lp_challenge == "") || (lp_challenge == null) || (CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return 0;
    }

    if ((CMUIX_MutatorChallengeInstanceExists(lv_type, lp_challenge) == false)) {
        return 0;
    }

    CMUIX_MutatorChallengeCurrentType = lv_type;
    CMUIX_MutatorChallengeSelected[lv_typeIndex] = lp_challenge;
    CMUIX_MutatorChallengeDraft[lv_typeIndex] = lp_challenge;
    CMUIX_ProfileRuntimeLocksRefresh();

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        libCOMU_gv_cT_MAbomination_Mutators[lv_index] = "";
        libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index] = false;
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        lv_mutator = CMUIX_MutatorChallengeMutatorAt(lv_type, lp_challenge, lv_index);
        if ((lv_mutator != "") && (lv_mutator != null)) {
            lv_enhanced = CMUIX_MutatorChallengeMutatorEnhancedAt(lv_type, lp_challenge, lv_index, lv_mutator);
            lv_enabled += 1;
            libCOMU_gv_cT_MAbomination_Mutators[lv_enabled] = lv_mutator;
            libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_enabled] = lv_enhanced;
            if ((lv_mutator == CMUIX_MUTATOR_CHAOS_RANDOM)) {
                lv_chaosCount = CMUIX_MUTATOR_CHAOS_RANDOM_COUNT;
            }
            else {
                libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, lv_enhanced);
            }
        }

        lv_index += 1;
    }

    if ((lv_chaosCount > 0)) {
        CMUIX_CustomMutatorCommitEnableChaosPicks(lv_chaosCount);
    }

    libCOMU_gv_cT_MAbomination_MutatorsCount = lv_enabled;
    if ((lv_enabled > 0)) {
        libCOMU_gv_cT_MAbomination_CombosCounted = 1;
        libCOMU_gv_cT_MAbomination_CountSnapshot = 1;
    }
    else {
        libCOMU_gv_cT_MAbomination_CombosCounted = 0;
        libCOMU_gv_cT_MAbomination_CountSnapshot = 0;
    }

    libCOMU_gv_cT_MAbomination_PointsSnapshot = 0;
    return lv_enabled;
}

text CMUIX_MutatorChallengeMutatorDescription(string lp_mutator, bool lp_enhanced) {
    text lv_description;

    lv_description = StringToText("");
    if ((lp_mutator == "")) {
        return lv_description;
    }

    if ((lp_enhanced == true)) {
        lv_description = libCOMU_gf_CT_MutatorEnhanceDescription(lp_mutator);
        if ((TextToString(lv_description) != "")) {
            return lv_description;
        }
    }

    return libCOMU_gf_CT_MutatorDescription(lp_mutator);
}

string CMUIX_MutatorChallengeMutatorSourceState(string lp_mutator, bool lp_enhanced) {
    string lv_sourceState;

    lv_sourceState = "";
    if ((lp_enhanced == true)) {
        return "Plus";
    }

    if ((lp_mutator == "")) {
        return "Official";
    }

    lv_sourceState = UserDataGetString("MutatorType", UserDataGetUserInstance("Mutators", lp_mutator, "MA - Type", 1), "UIStateString", 1);
    if ((lv_sourceState == "")) {
        lv_sourceState = "Official";
    }

    return lv_sourceState;
}

void CMUIX_MutatorChallengeClearMutatorItems(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeMutatorItems[lv_index], false, lp_players);
        lv_index += 1;
    }
}

void CMUIX_MutatorChallengeRefreshMutatorItems(int lp_player, string lp_challenge) {
    int lv_index;
    int lv_slot;
    string lv_mutator;
    bool lv_enhanced;
    playergroup lv_playerGroup;

    lv_index = 1;
    lv_slot = 0;
    lv_mutator = "";
    lv_enhanced = false;
    lv_playerGroup = PlayerGroupSingle(lp_player);
    CMUIX_MutatorChallengeClearMutatorItems(lv_playerGroup);
    if ((CMUIX_MutatorChallengeIsRandom(lp_challenge) == true)) {
        return;
    }

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max) && (lv_slot < libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        lv_mutator = CMUIX_MutatorChallengeMutatorAt(CMUIX_MutatorChallengeCurrentType, lp_challenge, lv_index);
        if ((lv_mutator != "")) {
            lv_enhanced = CMUIX_MutatorChallengeMutatorEnhancedAt(CMUIX_MutatorChallengeCurrentType, lp_challenge, lv_index, lv_mutator);
            CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeMutatorTitleLabels[lv_slot], libCOMU_gf_CT_MutatorName(lv_mutator), lv_playerGroup);
            CMUIX_MapSelectionSetText(libCMUI_gv_mutatorChallengeMutatorDescriptionLabels[lv_slot], CMUIX_MutatorChallengeMutatorDescription(lv_mutator, lv_enhanced), lv_playerGroup);
            if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeMutatorIconBoxes[lv_slot]) == true)) {
                DialogControlSetAnimationState(libCMUI_gv_mutatorChallengeMutatorIconBoxes[lv_slot], lv_playerGroup, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lv_mutator, lv_enhanced));
            }

            if ((CMUICore_IsControlValid(libCMUI_gv_mutatorChallengeMutatorIcons[lv_slot]) == true)) {
                libNtve_gf_SetDialogItemImage(libCMUI_gv_mutatorChallengeMutatorIcons[lv_slot], libCOMU_gf_CT_MutatorIcon(lv_mutator), lv_playerGroup);
            }

            CMUIX_MapSelectionSetVisible(libCMUI_gv_mutatorChallengeMutatorItems[lv_slot], true, lv_playerGroup);
            lv_slot += 1;
        }

        lv_index += 1;
    }
}

