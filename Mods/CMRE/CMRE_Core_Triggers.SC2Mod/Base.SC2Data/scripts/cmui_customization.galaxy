    CMUIX_CommanderInfoNameLabel = c_invalidDialogControlId;
    CMUIX_CommanderInfoPrestigeLabel = c_invalidDialogControlId;
    CMUIX_CommanderInfoAllianceNameLabel = c_invalidDialogControlId;
    CMUIX_CommanderInfoAlliancePrestigeLabel = c_invalidDialogControlId;
    CMUIX_DetailsStatusHeaderLabel = c_invalidDialogControlId;
    CMUIX_DetailsStatusTableHeader = c_invalidDialogControlId;
    CMUIX_DetailsStatusTableGrid = c_invalidDialogControlId;
    CMUIX_AllianceStatusHeaderLabel = c_invalidDialogControlId;
    CMUIX_AllianceStatusTableHeader = c_invalidDialogControlId;
    CMUIX_AllianceStatusTableGrid = c_invalidDialogControlId;
    CMUIX_MasteryPanel = c_invalidDialogControlId;
