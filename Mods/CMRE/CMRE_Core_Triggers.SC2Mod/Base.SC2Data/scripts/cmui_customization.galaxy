bool CMUIX_CustomMutatorPickerHookupReady() {
    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerFullscreenUpperContainer) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerPanel) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerOpenButton) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerFullscreen) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerItemButtons[1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSelectedButtons[1]) == false)) {
        return false;
    }

    return true;
}

void CMUIX_CustomMutatorPickerHookup() {
    int lv_slot;

    lv_slot = 1;
    if ((CMUIX_CustomMutatorPickerHooked == true)) {
        if ((CMUIX_CustomMutatorPickerHookupReady() == true)) {
            return;
        }

        CMUIX_CustomMutatorPickerHooked = false;
    }

    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer");
    CMUIX_CustomMutatorPickerFullscreenUpperContainer = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_screenCoopCommanderSelectionPanel, c_triggerControlTypePanel, "MutatorSelectionPanel");
    CMUIX_CustomMutatorPickerPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerPanel, c_triggerControlTypeButton, "CustomMutatorButton");
    CMUIX_CustomMutatorPickerOpenButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerOpenButton, c_triggerControlTypeLabel, "Label");
    CMUIX_CustomMutatorPickerOpenButtonLabel = DialogControlLastCreated();
    DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "CustomMutatorFullscreen");
    CMUIX_CustomMutatorPickerFullscreen = DialogControlLastCreated();
    CMUIX_ConsoleHookup();
    DialogControlHookup(CMUIX_CustomMutatorPickerFullscreen, c_triggerControlTypePanel, "CustomMutatorMenuContainer");
    CMUIX_CustomMutatorPickerMenuContainer = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerMenuContainer, c_triggerControlTypePanel, "SelectionContainer");
    CMUIX_CustomMutatorPickerSelectionContainer = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerSelectionContainer, c_triggerControlTypePanel, "HeaderContainer");
    CMUIX_CustomMutatorPickerHeaderPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerHeaderPanel, c_triggerControlTypeLabel, "PageCount");
    CMUIX_CustomMutatorPickerPageLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerHeaderPanel, c_triggerControlTypeButton, "PageDownButton");
    CMUIX_CustomMutatorPickerPrevPageButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerHeaderPanel, c_triggerControlTypeButton, "PageUpButton");
    CMUIX_CustomMutatorPickerNextPageButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerSelectionContainer, c_triggerControlTypePanel, "ItemsContainer");
    CMUIX_CustomMutatorPickerSelectionItemsContainer = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerMenuContainer, c_triggerControlTypePanel, "SelectedContainer");
    CMUIX_CustomMutatorPickerSelectedContainer = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerSelectedContainer, c_triggerControlTypePanel, "ItemsContainer");
    CMUIX_CustomMutatorPickerSelectedScrollFrame = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerSelectedScrollFrame, c_triggerControlTypePanel, "ContainerFrame");
    CMUIX_CustomMutatorPickerSelectedItemsContainer = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerMenuContainer, c_triggerControlTypePanel, "HeaderPanel");
    CMUIX_CustomMutatorPickerHeaderPanel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerHeaderPanel, c_triggerControlTypeEditBox, "SearchEditBoxTemplate");
    CMUIX_CustomMutatorPickerSearchBox = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerSearchBox, c_triggerControlTypeButton, "ClearTextButton");
    CMUIX_CustomMutatorPickerSearchClearButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerMenuContainer, c_triggerControlTypeButton, "AcceptButton");
    CMUIX_CustomMutatorPickerAcceptButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_CustomMutatorPickerMenuContainer, c_triggerControlTypeButton, "CancelButton");
    CMUIX_CustomMutatorPickerCancelButton = DialogControlLastCreated();

    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        CMUIX_CustomMutatorPickerHookupAvailableItem(lv_slot);
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerHookupSelectedItem(lv_slot);
        lv_slot += 1;
    }

    if ((CMUIX_CustomMutatorPickerHookupReady() == false)) {
        return;
    }

    CMUIX_CustomMutatorPickerHooked = true;
    CMUIX_CustomMutatorPickerSetLauncherChatForAll();
    CMUIX_StartupInitializeData();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_CustomMutatorPickerClose(1);
    CMUIX_CustomMutatorPickerRefreshAll(1);
}

bool CMUIX_CustomMutatorPickerHandleControlEvent(int lp_player, int lp_control) {
    int lv_slot;
    string lv_mutator;

    lv_slot = 1;
    lv_mutator = "";
    if ((CMUIX_CustomMutatorPickerRefreshing == true)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerHooked == false)) {
        return false;
    }

    CMUIX_CustomMutatorPickerLoadViewerState(lp_player);
    if ((lp_control == CMUIX_CustomMutatorPickerOpenButton)) {
        CMUIX_CustomMutatorPickerOpen(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerSearchBox)) {
        CMUIX_CustomMutatorPickerSearchText = libNtve_gf_DialogItemEditValue(lp_control, lp_player);
        CMUIX_CustomMutatorPickerPageIndex = 1;
        CMUIX_CustomMutatorPickerStoreViewerState(lp_player);
        CMUIX_CustomMutatorPickerRefreshAll(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerSearchClearButton)) {
        CMUIX_CustomMutatorPickerSearchText = "";
        if ((CMUIX_IsControlValid(CMUIX_CustomMutatorPickerSearchBox) == true)) {
            libNtve_gf_SetDialogItemEditorValue(CMUIX_CustomMutatorPickerSearchBox, "", PlayerGroupSingle(lp_player));
        }

        CMUIX_CustomMutatorPickerPageIndex = 1;
        CMUIX_CustomMutatorPickerStoreViewerState(lp_player);
        CMUIX_CustomMutatorPickerRefreshAll(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerPrevPageButton)) {
        CMUIX_CustomMutatorPickerPageIndex -= 1;
        CMUIX_CustomMutatorPickerClampPage();
        CMUIX_CustomMutatorPickerStoreViewerState(lp_player);
        CMUIX_CustomMutatorPickerRefreshAll(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerNextPageButton)) {
        CMUIX_CustomMutatorPickerPageIndex += 1;
        CMUIX_CustomMutatorPickerClampPage();
        CMUIX_CustomMutatorPickerStoreViewerState(lp_player);
        CMUIX_CustomMutatorPickerRefreshAll(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerAcceptButton)) {
        if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
            return true;
        }

        CMUIX_CustomMutatorPickerCopyDraftToAccepted();
        CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
        CMUIX_CustomMutatorPickerClose(lp_player);
        CMUIX_MapSelectionResetReadyStatus();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerCancelButton)) {
        if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == true)) {
            CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
            CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
        }

        CMUIX_CustomMutatorPickerClose(lp_player);
        return true;
    }

    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        if ((lp_control == CMUIX_CustomMutatorPickerItemEnhanceButtons[lv_slot])) {
            lv_mutator = CMUIX_CustomMutatorPickerItemMutators[lv_slot];
            if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
                if ((CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
                    CMUIX_CustomMutatorPickerSuggestMutator(lp_player, lv_mutator, lv_slot, true);
                }

                return true;
            }

            if ((CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
                CMUIX_CustomMutatorPickerToggleDraftEnhanced(lv_mutator);
                CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
            }

            return true;
        }

        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        if ((lp_control == CMUIX_CustomMutatorPickerItemButtons[lv_slot])) {
            lv_mutator = CMUIX_CustomMutatorPickerItemMutators[lv_slot];
            if ((lv_mutator != "")) {
                if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
                    CMUIX_CustomMutatorPickerSuggestMutator(lp_player, lv_mutator, lv_slot, false);
                    return true;
                }

                if ((CMUIX_CustomMutatorPickerMultipleAllowed(lv_mutator) == false) && (CMUIX_CustomMutatorPickerSelectedOccurrences(lv_mutator) > 0)) {
                    CMUIX_CustomMutatorPickerRemoveFirstDraftMutator(lv_mutator);
                }
                else {
                    CMUIX_CustomMutatorPickerAddDraftMutator(lv_mutator);
                }

                CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
            }

            return true;
        }

        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((lp_control == CMUIX_CustomMutatorPickerSelectedButtons[lv_slot])) {
            if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == false)) {
                return true;
            }

            CMUIX_CustomMutatorPickerRemoveDraftAt(lv_slot);
            CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
            return true;
        }

        lv_slot += 1;
    }

    return false;
}

int CMUIX_CustomMutatorPickerAcceptedOccurrences(string lp_mutator) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = 0;
    while ((lv_index <= CMUIX_CustomMutatorPickerAcceptedCount) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((CMUIX_CustomMutatorPickerAcceptedMutators[lv_index] == lp_mutator)) {
            lv_count += 1;
        }

        lv_index += 1;
    }

    return lv_count;
}

bool CMUIX_CustomMutatorPickerAcceptedAppend(string lp_mutator) {
    if ((CMUIX_CustomMutatorPickerSelectable(lp_mutator) == false)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerAcceptedCount >= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerMultipleAllowed(lp_mutator) == false) && (CMUIX_CustomMutatorPickerAcceptedOccurrences(lp_mutator) > 0)) {
        return false;
    }

    CMUIX_CustomMutatorPickerAcceptedCount += 1;
    CMUIX_CustomMutatorPickerAcceptedMutators[CMUIX_CustomMutatorPickerAcceptedCount] = lp_mutator;
    CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 0;
    if ((CMUIX_CustomMutatorPickerAcceptedEnhancedForMutator(lp_mutator) == true)) {
        CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 1;
    }

    return true;
}

bool CMUIX_CustomMutatorPickerAcceptedRemoveFirst(string lp_mutator) {
    int lv_slot;

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CustomMutatorPickerAcceptedCount) && (lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot] == lp_mutator)) {
            while ((lv_slot < CMUIX_CustomMutatorPickerAcceptedCount) && (lv_slot < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
                CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot] = CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot + 1];
                CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] = CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot + 1];
                lv_slot += 1;
            }

            CMUIX_CustomMutatorPickerAcceptedMutators[CMUIX_CustomMutatorPickerAcceptedCount] = "";
            CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 0;
            CMUIX_CustomMutatorPickerAcceptedCount -= 1;
            return true;
        }

        lv_slot += 1;
    }

    return false;
}

void CMUIX_CustomMutatorPickerSyncAcceptedPreview(int lp_player) {
    CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
    CMUIX_CustomMutatorPickerRefreshAll(lp_player);
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_MutatorInfoRefreshAll();
}

bool CMUIX_CustomMutatorCommitEnablePickedVariant(string lp_sourceField) {
    string lv_mutator;
    bool lv_enhanced;

    lv_mutator = libCOMU_gv_cT_LastRandomPickMutator;
    lv_enhanced = libCOMU_gv_cT_LastRandomPickEnhanced;
    if ((lv_mutator == "") || (lv_mutator == null)) {
        return false;
    }

    libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, lv_enhanced);
    UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 0);
    UserDataSetInt("Mutators", lv_mutator, lp_sourceField, 1, 1);
    return true;
}

void CMUIX_CustomMutatorCommitEnableAcceptedRegular() {
    int lv_slot;
    string lv_mutator;
    bool lv_enhanced;

    lv_slot = 1;
    lv_mutator = "";
    lv_enhanced = false;
    while ((lv_slot <= CMUIX_CustomMutatorPickerAcceptedCount) && (lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot];
        if ((lv_mutator != "") && (CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false)) {
            lv_enhanced = false;
            if ((CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] == 1) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
                lv_enhanced = true;
            }

            libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, lv_enhanced);
        }

        lv_slot += 1;
    }
}

int CMUIX_CustomMutatorCommitEnableRandomPicks(int lp_count) {
    int lv_index;
    int lv_enabled;

    lv_index = 1;
    lv_enabled = 0;
    while ((lv_index <= lp_count) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((libCOMU_gf_CT_PickRandomUnusedVariant() == true)) {
            if ((CMUIX_CustomMutatorCommitEnablePickedVariant("Auto - Actived By Random") == true)) {
                lv_enabled += 1;
            }
        }

        lv_index += 1;
    }

    return lv_enabled;
}

int CMUIX_CustomMutatorCommitEnableChaosPicks(int lp_count) {
    int lv_index;
    int lv_enabled;
    string lv_mutator;

    lv_index = 1;
    lv_enabled = 0;
    lv_mutator = "";
    libCOTF_gv_rT_ChaosCycleCount = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        libCOTF_gv_rT_ChaosMutators[lv_index] = "";
        lv_index += 1;
    }

    lv_index = 1;
    while ((lv_index <= lp_count) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((libCOMU_gf_CT_PickRandomCycleFirstUnusedVariant() == true)) {
            lv_mutator = libCOMU_gv_cT_LastRandomPickMutator;
            if ((CMUIX_CustomMutatorCommitEnablePickedVariant("Auto - Actived By Chaos") == true)) {
                lv_enabled += 1;
                libCOTF_gv_rT_ChaosCycleCount = lv_enabled;
                libCOTF_gv_rT_ChaosMutators[lv_enabled] = lv_mutator;
                if ((lv_enabled <= 3)) {
                    libCOMU_gv_cT_RandomMutators[lv_enabled] = lv_mutator;
                    libCOMU_gv_cT_RandomMutatorsEnhanced[lv_enabled] = false;
                }
            }
        }

        lv_index += 1;
    }

    return lv_enabled;
}

void CMUIX_MutatorChallengeCommitFinal() {
    int lv_typeIndex;
    string lv_type;
    string lv_selected;
    string lv_challenge;
    string lv_mapLink;
    string lv_mapInstance;

    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    lv_selected = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    lv_challenge = lv_selected;
    lv_mapLink = "";
    lv_mapInstance = "";
    CMUIX_StandardBrutalPlusClearRuntime();
    if ((CMUIX_MutatorChallengeIsRandom(lv_selected) == true)) {
        lv_challenge = CMUIX_MutatorChallengeRandomVisibleChallenge(lv_type);
    }
    else {
        lv_challenge = CMUIX_MutatorChallengeNormalizeSelection(lv_type, lv_selected);
    }

    if ((lv_challenge == "")) {
        return;
    }

    libCOMU_gf_CT_MutatorChallengesSet(lv_type);
    libCOMU_gv_cT_MutatorChallengesCurrentChallenge = lv_challenge;
    CMUIX_MutatorChallengeApplyRuntime(lv_type, lv_challenge);
    lv_mapLink = CMUIX_MutatorChallengeMapLink(lv_type, lv_challenge);
    if ((lv_mapLink != "")) {
        libCOTF_gv_sELECTED_Map = lv_mapLink;
        lv_mapInstance = CMUIX_MapSelectionInstanceForMapLink(lv_mapLink);
        if ((lv_mapInstance != "")) {
            libCOTF_gv_sELECTED_Mission = lv_mapInstance;
            libCOTF_gv_mapSelect_Mission = lv_mapInstance;
        }
    }
}

void CMUIX_CustomMutatorCommitFinal() {
    int lv_randomCount;
    int lv_chaosCount;

    lv_randomCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
    lv_chaosCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
    CMUIX_StandardBrutalPlusClearRuntime();
    CMUIX_CustomMutatorPickerApplyAcceptedToUserData();
    CMUIX_CustomMutatorCommitEnableAcceptedRegular();
    CMUIX_CustomMutatorCommitEnableRandomPicks(lv_randomCount);
    CMUIX_CustomMutatorCommitEnableChaosPicks(lv_chaosCount);
}

void CMUIX_FinalConfigurationCommit() {
    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD)) {
        CMUIX_StandardBrutalPlusEnsureRuntime();
        return;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        CMUIX_MutatorChallengeCommitFinal();
        return;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        CMUIX_CustomMutatorCommitFinal();
        return;
    }

    CMUIX_StandardBrutalPlusClearRuntime();
}

bool CMUIX_FinalCommanderCandidateAllowed(int lp_player, string lp_commander) {
    int lv_otherPlayer;
    playergroup lv_players;

    lv_otherPlayer = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    if ((lp_commander == "") || (lp_commander == null)) {
        return false;
    }

    if ((CMUIX_CommanderSelectionIndexForInstance(lp_commander) == 0)) {
        return false;
    }

    if (CMUIX_CommanderAccessibleForPlayer(lp_player, lp_commander) == false) {
        return false;
    }

    while ((true == true)) {
        lv_otherPlayer = PlayerGroupNextPlayer(lv_players, lv_otherPlayer);
        if ((lv_otherPlayer < 0)) {
            break;
        }

        if ((lv_otherPlayer != lp_player) && (libCOTF_gv_sELECTED_Commander_Random[lv_otherPlayer] == false) && (libCOTF_gv_sELECTED_Commander[lv_otherPlayer] == lp_commander)) {
            return false;
        }

        if ((lv_otherPlayer != lp_player) && (libCOOC_gf_ActiveCommanderForPlayer(lv_otherPlayer) == lp_commander)) {
            return false;
        }
    }

    return true;
}

string CMUIX_FinalRandomCommanderForPlayer(int lp_player) {
    int lv_index;
    int lv_count;
    int lv_candidateCount;
    string lv_candidate;
    string lv_selected;

    lv_index = 1;
    lv_count = UserDataInstanceCount("PlayerCommanders");
    lv_candidateCount = 0;
    lv_candidate = "";
    lv_selected = "";
    while ((lv_index <= lv_count)) {
        lv_candidate = UserDataInstance("PlayerCommanders", lv_index);
        if ((CMUIX_FinalCommanderCandidateAllowed(lp_player, lv_candidate) == true)) {
            lv_candidateCount += 1;
            if ((RandomInt(1, lv_candidateCount) == 1)) {
                lv_selected = lv_candidate;
            }
        }

        lv_index += 1;
    }

    if ((lv_selected == "")) {
        lv_selected = CMUIX_DefaultCommanderForPlayer(lp_player);
    }

    if ((CMUIX_CommanderSelectionIndexForInstance(lv_selected) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_selected) == false)) {
        return "";
    }

    return lv_selected;
}

string CMUIX_FinalCommanderForPlayer(int lp_player) {
    string lv_commander;

    lv_commander = libCOTF_gv_sELECTED_Commander[lp_player];
    if ((libCOTF_gv_sELECTED_Commander_Random[lp_player] == true) || (lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
        return CMUIX_FinalRandomCommanderForPlayer(lp_player);
    }

    return lv_commander;
}

void CMUIX_FinalApplyCommanderForPlayer(int lp_player) {
    string lv_commander;

    lv_commander = CMUIX_FinalCommanderForPlayer(lp_player);
    if ((lv_commander == "") || (CMUIX_CommanderSelectionIndexForInstance(lv_commander) == 0) || (CMUIX_CommanderAccessibleForPlayer(lp_player, lv_commander) == false)) {
        return;
    }

    libCOTF_gv_sELECTED_Commander[lp_player] = lv_commander;
    libCOTF_gv_sELECTED_Commander_Random[lp_player] = false;
    libCOUI_gv_cU_CommanderSelection[lp_player] = lv_commander;
    libCOUI_gv_cU_CommanderSelect_PlayerReady[lp_player] = true;
    CMUIX_VoicePackApplyRuntimeForCommander(lv_commander, CMUIX_VoicePackForPlayerCommander(lp_player, lv_commander));
    CMUIX_PrepareConsoleSkinRefreshForCommander(lp_player, lv_commander);
    libCOUI_gf_CU_CommanderFinalizeStates(lp_player);
    CMUIX_ApplyStoredPrestigeForCommander(lp_player, lv_commander);
    CMUIX_EnsureDefaultAIMastery(lp_player);
    CMUIX_ApplyCommanderMasteryGate(lp_player, lv_commander);
    libCOOC_gf_CC_UpdateTechStates(lp_player);
}

void CMUIX_FinalApplyCommanders() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_FinalApplyCommanderForPlayer(lv_player);
    }
}

string CMUIX_FinalModeInstance() {
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        return "MutatorChallenges";
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        return "CustomMutators";
    }

    return "Standard";
}

string CMUIX_FinalMissionSelection() {
    string lv_mission;

    lv_mission = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        lv_mission = CMUIX_MapSelectionCurrentMapInstance();
        return lv_mission;
    }

    lv_mission = CMUIX_MapSelectionSelected;
    if ((CMUIX_MapSelectionIsRandom(lv_mission) == true) || (lv_mission == "")) {
        lv_mission = CMUIX_MapSelectionRandomVisibleMap();
    }

    return lv_mission;
}

void CMUIX_FinalApplyMissionSelection() {
    string lv_mission;
    string lv_mapLink;

    lv_mission = CMUIX_FinalMissionSelection();
    lv_mapLink = "";
    if ((lv_mission == "")) {
        return;
    }

    libCOTF_gv_sELECTED_Mission = lv_mission;
    libCOTF_gv_mapSelect_Mission = lv_mission;
    lv_mapLink = UserDataGetGameLink("CoopMaps", lv_mission, "MA - Map Link", 1);
    if ((lv_mapLink != "")) {
        libCOTF_gv_sELECTED_Map = lv_mapLink;
    }
}

string CMUIX_FinalEnemyRaceFilter(string lp_enemy) {
    string lv_raceFilter;

    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    if ((lv_raceFilter != "")) {
        return lv_raceFilter;
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomTerran)) {
        return "Terr";
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomProtoss)) {
        return "Prot";
    }

    if ((lp_enemy == CMUIX_EnemySelection_RandomZerg)) {
        return "Zerg";
    }

    return lv_raceFilter;
}

bool CMUIX_FinalEnemyMatchesChallengeRestriction(string lp_enemy) {
    return CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lp_enemy);
}

string CMUIX_FinalRandomEnemy(string lp_enemy) {
    int lv_index;
    int lv_count;
    int lv_candidateCount;
    string lv_candidate;
    string lv_selected;
    string lv_raceFilter;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopAICommanders");
    lv_candidateCount = 0;
    lv_candidate = "";
    lv_selected = "";
    lv_raceFilter = CMUIX_FinalEnemyRaceFilter(lp_enemy);
    while ((lv_index <= lv_count)) {
        lv_candidate = UserDataInstance("CoopAICommanders", lv_index);
        if ((CMUIX_EnemySelectionEnemyCanRandomForRace(lv_candidate, lv_raceFilter) == true) && (CMUIX_EnemySelectionRandomMatchesCandidate(lp_enemy, lv_candidate) == true) && (CMUIX_FinalEnemyMatchesChallengeRestriction(lv_candidate) == true)) {
            lv_candidateCount += 1;
            if ((RandomInt(1, lv_candidateCount) == 1)) {
                lv_selected = lv_candidate;
            }
        }

        lv_index += 1;
    }

    return lv_selected;
}

string CMUIX_FinalEnemySelection() {
    string lv_enemy;
    string lv_raceFilter;

    lv_enemy = CMUIX_EnemySelectionSelected;
    lv_raceFilter = CMUIX_EnemySelectionCurrentMapRaceFilter();
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_enemy = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(CMUIX_MutatorChallengeCurrentType, libCOMU_gv_cT_MutatorChallengesCurrentChallenge, lv_enemy);
        if ((lv_enemy == "")) {
            return "";
        }
    }
    else {
        lv_enemy = CMUIX_EnemySelectionNormalizeSelection(lv_enemy);
    }

    if ((CMUIX_EnemySelectionIsRandom(lv_enemy) == true) || (lv_enemy == "")) {
        lv_enemy = CMUIX_FinalRandomEnemy(lv_enemy);
    }

    if ((CMUIX_EnemySelectionEnemyIsValidForRace(lv_enemy, lv_raceFilter) == false) || (CMUIX_EnemySelectionEnemyAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_enemy) == false)) {
        lv_enemy = CMUIX_FinalRandomEnemy(CMUIX_EnemySelectionFallbackForRace(lv_raceFilter));
    }

    return lv_enemy;
}

void CMUIX_FinalApplyEnemySelection() {
    string lv_enemy;

    lv_enemy = CMUIX_FinalEnemySelection();
    if ((lv_enemy == "")) {
        return;
    }

    CMUIX_EnemySelectionSelected = lv_enemy;
    CMUIX_EnemySelectionDraft = lv_enemy;
    libCOMI_gf_CM_CoopAIPersonalitySet(lv_enemy);
    CMUIX_EnemySelectionRefreshSelectedLabel();
}

void CMUIX_FinalApplyLocalLaunchConfiguration() {
    libCOTF_gv_sELECTED_Mode = CMUIX_FinalModeInstance();
    if ((CMUIX_CurrentMode != CMUIX_MODE_MUTATOR)) {
        CMUIX_FinalApplyMissionSelection();
    }

    CMUIX_FinalConfigurationCommit();
    CMUIX_FinalApplyEnemySelection();
    CMUIX_FinalApplyCommanders();
}

bool CMUIX_LauncherJumpToSelectedMission() {
    int lv_messageArea;
    string lv_targetMap;
    string lv_targetMission;
    string lv_enemy;
    string lv_race;

    lv_messageArea = c_invalidDialogControlId;
    lv_targetMap = libCOTF_gv_sELECTED_Map;
    lv_targetMission = libCOTF_gv_sELECTED_Mission;
    lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    lv_race = "";
    if (((lv_targetMap == "") || (lv_targetMap == null)) && ((lv_targetMission != "") && (lv_targetMission != null))) {
        lv_targetMap = UserDataGetGameLink("CoopMaps", lv_targetMission, "MA - Map Link", 1);
    }

    if ((lv_targetMap == "") || (lv_targetMap == null)) {
        return false;
    }

    if ((lv_enemy != "") && (lv_enemy != null)) {
        lv_race = CMUIX_EnemySelectionRaceForEnemy(lv_enemy);
    }

    if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == false)) {
        lv_race = CMUIX_EnemySelectionCurrentMapRaceFilter();
    }

    if ((CMUIX_EnemySelectionRaceIsStandard(lv_race) == false)) {
        lv_race = "Terr";
    }

    CMUIX_SetCommanderSelectionUIActive(false);
    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/ChatDisplay");
    lv_messageArea = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(lv_messageArea) == true)) {
        DialogControlSetVisible(lv_messageArea, PlayerGroupAll(), false);
    }

    libCOOC_gf_LoadNextMap(lv_targetMap, lv_race);
    return true;
}

bool CMUIX_ReadyCanEditData(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((CMUIX_ReadyCountdownRunning == true)) {
        return false;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == true)) {
        return false;
    }

    return true;
}

bool CMUIX_ReadyCanEditSharedData(int lp_player) {
    if ((CMUIX_ReadyCanEditData(lp_player) == false)) {
        return false;
    }

    if ((CMUIX_ProfileSharedConfigLocked() == true)) {
        return false;
    }

    return CMUIX_PlayerCanControlSharedSetup(lp_player);
}

void CMUIX_ReadySetEnabledForPlayer(int lp_control, int lp_player, bool lp_enabled) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_SetControlEnabled(lp_control, PlayerGroupSingle(lp_player), lp_enabled);
}

void CMUIX_ReadyRefreshCommanderDataControlsForPlayer(int lp_player, bool lp_canEdit) {
    int lv_index;
    int lv_commanderCount;
    int lv_targetPlayer;
    bool lv_itemEnabled;
    string lv_commander;
    string lv_readyInputState;
    playergroup lv_players;

    lv_index = 0;
    lv_commanderCount = UserDataInstanceCount("PlayerCommanders");
    lv_targetPlayer = CMUIX_CommanderClickTargetPlayer(lp_player);
    lv_itemEnabled = false;
    lv_commander = "";
    lv_readyInputState = "Disabled";
    lv_players = PlayerGroupSingle(lp_player);

    while ((lv_index < libCMUI_gv_cMUI_Commander_Max_Count)) {
        lv_itemEnabled = lp_canEdit;
        lv_readyInputState = "Disabled";
        if ((lv_index < lv_commanderCount)) {
            lv_commander = UserDataInstance("PlayerCommanders", (lv_index + 1));
            if (CMUIX_CommanderAccessibleForOperatorTarget(lp_player, lv_targetPlayer, lv_commander) == false) {
                lv_itemEnabled = false;
            }
        }
        else {
            if ((lv_index > lv_commanderCount)) {
                lv_itemEnabled = false;
            }
        }

        if ((lv_itemEnabled == true)) {
            lv_readyInputState = "Enabled";
        }

        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_commanderItems[lv_index], lp_player, lv_itemEnabled);
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CommanderItemLevelLabels[lv_index], lp_player, lv_itemEnabled);
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CommanderItemAllyLevelLabels[lv_index], lp_player, lv_itemEnabled);
        if ((CMUICore_IsControlValid(libCMUI_gv_commanderItems[lv_index]) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_commanderItems[lv_index], lv_players, "ReadyInputState", lv_readyInputState);
        }

        if ((CMUICore_IsControlValid(libCMUI_gv_commanderItemsPortrait[lv_index]) == true)) {
            DialogControlSetAnimationState(libCMUI_gv_commanderItemsPortrait[lv_index], lv_players, "ReadyInputState", lv_readyInputState);
        }

        lv_index += 1;
    }
}

void CMUIX_ReadyRefreshSharedSetupDataControlsForPlayer(int lp_player, bool lp_canEditShared) {
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_screenCoopNavigationStandardButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_screenCoopNavigationMutatorButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_screenCoopNavigationCMMutatorButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_screenCoopNavigationCustomButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_HomeWidgetItems[0], lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_HomeWidgetItems[1], lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_difficultyButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_specialDifficultyButton, lp_player, (lp_canEditShared == true) && (CMUIX_SpecialDifficultyCanChange(lp_player) == true));
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mapSelectionButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mapSelectionRetryButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolModeOpenButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_difficultyAcceptButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_specialDifficultyAcceptButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mapSelectionAcceptButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_RandomSeedEditBox, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_RandomSeedRefreshButton, lp_player, lp_canEditShared);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeAcceptButton, lp_player, lp_canEditShared);
}

void CMUIX_ReadyRefreshListDataControlsForPlayer(int lp_player, bool lp_canEditShared) {
    int lv_index;
    bool lv_enemySelectionEnabled;
    bool lv_mutatorEnemySelectionEnabled;

    lv_index = 0;
    lv_enemySelectionEnabled = (lp_canEditShared == true) && (CMUIX_MutatorChallengeSelectedLockedAI() == "");
    lv_mutatorEnemySelectionEnabled = (lp_canEditShared == true) && (CMUIX_MutatorChallengeDraftLockedAI() == "");
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_enemySelectionTileList, lp_player, lv_enemySelectionEnabled);
    CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeEnemyTileList, lp_player, lv_mutatorEnemySelectionEnabled);
    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_difficultyBaseItems[lv_index], lp_player, (lp_canEditShared == true) && (CMUIX_DifficultyBaseCanChange(lp_player) == true));
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_specialDifficultyBaseItems[lv_index], lp_player, (lp_canEditShared == true) && (CMUIX_SpecialDifficultyCanChange(lp_player) == true));
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= libCMUI_gv_cMUI_Difficulty_Plus_Max)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_difficultyPlusItems[lv_index], lp_player, (lp_canEditShared == true) && (CMUIX_DifficultyPlusCanChange(lp_player) == true));
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mapSelectionItems[lv_index], lp_player, lp_canEditShared);
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_enemySelectionItems[lv_index], lp_player, lv_enemySelectionEnabled);
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeItems[lv_index], lp_player, lp_canEditShared);
        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        CMUIX_ReadySetEnabledForPlayer(libCMUI_gv_mutatorChallengeEnemyItems[lv_index], lp_player, lv_mutatorEnemySelectionEnabled);
        lv_index += 1;
    }
}

void CMUIX_ReadyRefreshCustomizationDataControlsForPlayer(int lp_player, bool lp_canEdit) {
    int lv_index;
    int lv_slot;
    int lv_targetPlayer;
    bool lv_selfCustomizationEnabled;
    bool lv_allianceCustomizationEnabled;
    bool lv_optimizationMasterEnabled;
    bool lv_forcedOptimization;
    string lv_commander;

    lv_index = 1;
    lv_slot = 1;
    lv_targetPlayer = CMUIX_DefaultAllianceTarget(lp_player);
    lv_selfCustomizationEnabled = lp_canEdit;
    lv_allianceCustomizationEnabled = false;
    lv_optimizationMasterEnabled = CMUIX_PersonalizationOptimizationMasterDraft[lp_player];
    lv_forcedOptimization = false;
    lv_commander = CMUIX_TargetCommander[lp_player];
    if ((CMUIX_ProfileConfigLocked == true) && (CMUIX_ProfileOptimizationAllowed == false)) {
        lv_optimizationMasterEnabled = false;
    }
    if ((CMUIX_PlayerCommanderSelectionIsRandom(lp_player) == true)) {
        lv_selfCustomizationEnabled = false;
    }

    if ((lp_canEdit == true) && (CMUIX_AllianceCustomizationButtonShouldShow(lp_player, lv_targetPlayer) == true)) {
        lv_allianceCustomizationEnabled = true;
    }

    CMUIX_ReadySetEnabledForPlayer(CMUIX_SelfMasteryButton, lp_player, lv_selfCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_AllianceCustomizationButton, lp_player, lv_allianceCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_DetailsLevelLabel, lp_player, lv_selfCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_DetailsLevelRingFrame, lp_player, lv_selfCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_DetailsMaxLevelIcon, lp_player, lv_selfCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_DetailsMasterySpentLabel, lp_player, lv_selfCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_AllianceLevelLabel, lp_player, lv_allianceCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_AllianceLevelRingFrame, lp_player, lv_allianceCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_AllianceMaxLevelIcon, lp_player, lv_allianceCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_AllianceMasterySpentLabel, lp_player, lv_allianceCustomizationEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MasteryAcceptButton, lp_player, lp_canEdit);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_PersonalizationOptimizationMasterCheckBox, lp_player, (lp_canEdit == true) && ((CMUIX_ProfileConfigLocked == false) || (CMUIX_ProfileOptimizationAllowed == true)));
    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        lv_forcedOptimization = false;
        if ((CMUIX_PersonalizationOptimizationIds[lp_player][lv_slot] == CMUIX_OPTIMIZATION_RACE_DEFAULT_TRANSMISSION) && (CMUIX_OptimizationRaceDefaultTransmissionForced(lv_commander) == true)) {
            lv_forcedOptimization = true;
        }

        CMUIX_ReadySetEnabledForPlayer(CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot], lp_player, (lp_canEdit == true) && (lv_optimizationMasterEnabled == true) && (lv_forcedOptimization == false));
        lv_slot += 1;
    }

    if ((lp_canEdit == false)) {
        CMUIX_ReadySetEnabledForPlayer(CMUIX_PersonalizationAnnouncerPulldown, lp_player, false);
        while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            CMUIX_ReadySetEnabledForPlayer(CMUIX_MasteryPlusButtons[lv_index], lp_player, false);
            CMUIX_ReadySetEnabledForPlayer(CMUIX_MasteryMinusButtons[lv_index], lp_player, false);
            lv_index += 1;
        }

        lv_index = 0;
        while ((lv_index <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
            CMUIX_ReadySetEnabledForPlayer(CMUIX_PrestigeItems[lv_index], lp_player, false);
            lv_index += 1;
        }
    }
}

void CMUIX_ReadyRefreshCustomMutatorDataControlsForPlayer(int lp_player, bool lp_canEdit, bool lp_canEditShared) {
    int lv_slot;
    bool lv_canUseVisibleMutatorRows;
    bool lv_openEnabled;

    lv_slot = 1;
    lv_canUseVisibleMutatorRows = true;
    lv_openEnabled = lp_canEdit;
    if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == true)) {
        lv_canUseVisibleMutatorRows = lp_canEditShared;
        lv_openEnabled = lp_canEditShared;
    }
    else {
        lv_openEnabled = true;
    }

    CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerOpenButton, lp_player, lv_openEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerAcceptButton, lp_player, lp_canEditShared);
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerItemButtons[lv_slot], lp_player, lv_canUseVisibleMutatorRows);
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerItemSettingsButtons[lv_slot], lp_player, lv_canUseVisibleMutatorRows);
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerItemEnhanceButtons[lv_slot], lp_player, lv_canUseVisibleMutatorRows);
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_ReadySetEnabledForPlayer(CMUIX_CustomMutatorPickerSelectedButtons[lv_slot], lp_player, lv_canUseVisibleMutatorRows);
        lv_slot += 1;
    }
}

void CMUIX_ReadyRefreshMutatorPoolDataControlsForPlayer(int lp_player, bool lp_canEdit) {
    int lv_view;
    int lv_slot;

    lv_view = 1;
    lv_slot = 1;
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolAcceptButton[1], lp_player, lp_canEdit);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolResetButton[1], lp_player, lp_canEdit);
    while ((lv_view <= CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        lv_slot = 1;
        while ((lv_slot <= CMUIX_MUTATOR_POOL_ROW_MAX)) {
            CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolActiveChecks[lv_view][lv_slot], lp_player, lp_canEdit);
            CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolFirstChecks[lv_view][lv_slot], lp_player, lp_canEdit);
            CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorPoolEnhanceButtons[lv_view][lv_slot], lp_player, lp_canEdit);
            lv_slot += 1;
        }

        lv_view += 1;
    }
}

void CMUIX_ReadyRefreshMutatorInfoDataControlsForPlayer(int lp_player, bool lp_canEditShared) {
    int lv_randomCount;
    int lv_chaosCount;
    bool lv_customAddEnabled;
    bool lv_customRemoveEnabled;
    bool lv_rerollEnabled;

    lv_randomCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
    lv_chaosCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
    lv_customAddEnabled = false;
    lv_customRemoveEnabled = false;
    lv_rerollEnabled = false;
    if ((lp_canEditShared == true) && (CMUIX_CurrentMode == CMUIX_MODE_STANDARD) && (CMUIX_DifficultySelectedPlus > 0)) {
        lv_rerollEnabled = true;
    }

    if ((lp_canEditShared == true) && (CMUIX_CurrentMode == CMUIX_MODE_CUSTOM) && (CMUIX_CustomMutatorPickerAcceptedCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_customAddEnabled = true;
    }

    if ((lp_canEditShared == true) && (CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        lv_customRemoveEnabled = true;
    }

    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorInfoRerollButton, lp_player, lv_rerollEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorInfoRandomIncreaseButton, lp_player, lv_customAddEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorInfoChaosIncreaseButton, lp_player, lv_customAddEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorInfoRandomDecreaseButton, lp_player, (lv_customRemoveEnabled == true) && (lv_randomCount > 0));
    CMUIX_ReadySetEnabledForPlayer(CMUIX_MutatorInfoChaosDecreaseButton, lp_player, (lv_customRemoveEnabled == true) && (lv_chaosCount > 0));
}

void CMUIX_ReadyRefreshDataControlsForPlayer(int lp_player) {
    bool lv_canEdit;
    bool lv_canEditShared;
    bool lv_cancelReadyEnabled;
    bool lv_profileCancelVisible;

    lv_canEdit = CMUIX_ReadyCanEditData(lp_player);
    lv_canEditShared = CMUIX_ReadyCanEditSharedData(lp_player);
    lv_cancelReadyEnabled = false;
    lv_profileCancelVisible = false;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == true) && (CMUIX_ReadyCountdownRunning == false)) {
        lv_cancelReadyEnabled = true;
    }

    lv_profileCancelVisible = CMUIX_ProfileConfigLocked;
    CMUIX_ReadySetEnabledForPlayer(CMUIX_ReadyButton, lp_player, lv_canEdit);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_ReadyCancelButton, lp_player, lv_cancelReadyEnabled);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_ReadyStatusCancelButton, lp_player, lv_cancelReadyEnabled);
    CMUIX_SetControlVisible(CMUIX_ProfileCancelDivider, PlayerGroupSingle(lp_player), lv_profileCancelVisible);
    CMUIX_SetControlVisible(CMUIX_ProfileCancelButton, PlayerGroupSingle(lp_player), lv_profileCancelVisible);
    CMUIX_ReadySetEnabledForPlayer(CMUIX_ProfileCancelButton, lp_player, (CMUIX_ProfileConfigLocked == true) && (CMUIX_ReadyCountdownRunning == false));
    CMUIX_SetControlToggled(CMUIX_ProfileCancelButton, PlayerGroupSingle(lp_player), false);
    CMUIX_ReadyRefreshCommanderDataControlsForPlayer(lp_player, lv_canEdit);
    CMUIX_ReadyRefreshSharedSetupDataControlsForPlayer(lp_player, lv_canEditShared);
    CMUIX_ReadyRefreshListDataControlsForPlayer(lp_player, lv_canEditShared);
    CMUIX_ReadyRefreshCustomizationDataControlsForPlayer(lp_player, lv_canEdit);
    CMUIX_ReadyRefreshCustomMutatorDataControlsForPlayer(lp_player, lv_canEdit, lv_canEditShared);
    CMUIX_ReadyRefreshMutatorPoolDataControlsForPlayer(lp_player, lv_canEditShared);
    CMUIX_ReadyRefreshMutatorInfoDataControlsForPlayer(lp_player, lv_canEditShared);
}

void CMUIX_ReadyRefreshDataControlsAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_humans;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_humans = libCOOC_gf_HumanPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_humans, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_ReadyRefreshDataControlsForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_ReadyRefreshDataControlsForPlayer(1);
    }
}

bool CMUIX_ReadyControlAffectsData(int lp_player, int lp_control) {
    int lv_index;
    int lv_view;
    int lv_slot;
    bool lv_sharedControl;

    lv_index = 0;
    lv_view = 1;
    lv_slot = 1;
    lv_sharedControl = (CMUIX_PlayerCanControlSharedSetup(lp_player) == true) && (CMUIX_ProfileSharedConfigLocked() == false);
    if ((CMUIX_CommanderSelectionForControl(lp_control) != 0)) {
        return true;
    }

    if ((CMUIX_CommanderLevelControlAffectsData(lp_control) == true)) {
        return true;
    }

    if ((lp_control == libCMUI_gv_screenCoopNavigationStandardButton) || (lp_control == libCMUI_gv_screenCoopNavigationMutatorButton) || (lp_control == libCMUI_gv_screenCoopNavigationCMMutatorButton) || (lp_control == libCMUI_gv_screenCoopNavigationCustomButton)) {
        return lv_sharedControl;
    }

    if ((CMUIX_HomeControlAffectsData(lp_control) == true)) {
        return lv_sharedControl;
    }

    if ((lp_control == libCMUI_gv_difficultyButton) || (lp_control == libCMUI_gv_specialDifficultyButton) || (lp_control == libCMUI_gv_mapSelectionButton) || (lp_control == libCMUI_gv_mapSelectionRetryButton) || (lp_control == libCMUI_gv_mutatorChallengeButton) || (lp_control == CMUIX_MutatorPoolModeOpenButton)) {
        return lv_sharedControl;
    }

    if ((lp_control == libCMUI_gv_difficultyAcceptButton) || (lp_control == libCMUI_gv_specialDifficultyAcceptButton) || (lp_control == libCMUI_gv_mapSelectionAcceptButton) || (lp_control == libCMUI_gv_mutatorChallengeAcceptButton)) {
        return lv_sharedControl;
    }

    if ((lp_control == CMUIX_RandomSeedEditBox) || (lp_control == CMUIX_RandomSeedRefreshButton)) {
        return lv_sharedControl;
    }

    while ((lv_index < libCMUI_gv_cMUI_Difficulty_Base_Count)) {
        if ((lp_control == libCMUI_gv_difficultyBaseItems[lv_index]) || (lp_control == libCMUI_gv_specialDifficultyBaseItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= libCMUI_gv_cMUI_Difficulty_Plus_Max)) {
        if ((lp_control == libCMUI_gv_difficultyPlusItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MapSelection_Item_Max)) {
        if ((lp_control == libCMUI_gv_mapSelectionItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_EnemySelection_Item_Max)) {
        if ((lp_control == libCMUI_gv_enemySelectionItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Item_Max)) {
        if ((lp_control == libCMUI_gv_mutatorChallengeItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index < libCMUI_gv_cMUI_MutatorChallenge_Enemy_Item_Max)) {
        if ((lp_control == libCMUI_gv_mutatorChallengeEnemyItems[lv_index])) {
            return lv_sharedControl;
        }

        lv_index += 1;
    }

    if ((lp_control == CMUIX_SelfMasteryButton) || (lp_control == CMUIX_AllianceCustomizationButton) || (lp_control == CMUIX_MasteryAcceptButton) || (lp_control == CMUIX_PersonalizationAnnouncerPulldown) || (lp_control == CMUIX_PersonalizationOptimizationMasterCheckBox)) {
        return true;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_PERSONALIZATION_OPTIMIZATION_MAX)) {
        if ((lp_control == CMUIX_PersonalizationOptimizationCheckBoxes[lv_slot])) {
            return true;
        }

        lv_slot += 1;
    }

    lv_index = 1;
    while ((lv_index <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
        if ((lp_control == CMUIX_MasteryPlusButtons[lv_index]) || (lp_control == CMUIX_MasteryMinusButtons[lv_index])) {
            return true;
        }

        lv_index += 1;
    }

    lv_index = 0;
    while ((lv_index <= CMUIX_CUSTOMIZATION_PRESTIGE_ITEMS)) {
        if ((lp_control == CMUIX_PrestigeItems[lv_index])) {
            return true;
        }

        lv_index += 1;
    }

    if ((lp_control == CMUIX_CustomMutatorPickerOpenButton) || (lp_control == CMUIX_CustomMutatorPickerAcceptButton)) {
        return lv_sharedControl;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_AVAILABLE_ROW_MAX)) {
        if ((lp_control == CMUIX_CustomMutatorPickerItemButtons[lv_slot]) || (lp_control == CMUIX_CustomMutatorPickerItemSettingsButtons[lv_slot]) || (lp_control == CMUIX_CustomMutatorPickerItemEnhanceButtons[lv_slot])) {
            return lv_sharedControl;
        }

        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        if ((lp_control == CMUIX_CustomMutatorPickerSelectedButtons[lv_slot])) {
            return lv_sharedControl;
        }

        lv_slot += 1;
    }

    if ((lp_control == CMUIX_MutatorPoolAcceptButton[1]) || (lp_control == CMUIX_MutatorPoolResetButton[1])) {
        return true;
    }

    while ((lv_view <= CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        lv_slot = 1;
        while ((lv_slot <= CMUIX_MUTATOR_POOL_ROW_MAX)) {
            if ((lp_control == CMUIX_MutatorPoolActiveChecks[lv_view][lv_slot]) || (lp_control == CMUIX_MutatorPoolFirstChecks[lv_view][lv_slot]) || (lp_control == CMUIX_MutatorPoolEnhanceButtons[lv_view][lv_slot])) {
                return true;
            }

            lv_slot += 1;
        }

        lv_view += 1;
    }

    if ((lp_control == CMUIX_MutatorInfoRerollButton) || (lp_control == CMUIX_MutatorInfoRandomIncreaseButton) || (lp_control == CMUIX_MutatorInfoRandomDecreaseButton) || (lp_control == CMUIX_MutatorInfoChaosIncreaseButton) || (lp_control == CMUIX_MutatorInfoChaosDecreaseButton)) {
        return lv_sharedControl;
    }

    return false;
}

bool CMUIX_ReadyPlayerRequiresManualReady(int lp_player) {
    if ((PlayerStatus(lp_player) != c_playerStatusActive)) {
        return false;
    }

    if ((PlayerType(lp_player) == c_playerTypeUser)) {
        return true;
    }

    return false;
}

int CMUIX_ReadyOtherCommanderPlayer(int lp_player) {
    if ((lp_player == 1)) {
        return 2;
    }

    return 1;
}

void CMUIX_ReadySetCommanderButtonStateForPlayer(int lp_player, string lp_selfState, string lp_otherState) {
    int lv_selection;
    int lv_control;
    int lv_otherPlayer;

    lv_selection = 0;
    lv_control = c_invalidDialogControlId;
    lv_otherPlayer = 0;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_selection = libCMUI_gv_selectedCommanderIndex[lp_player];
    if ((lv_selection < 1) || (lv_selection > libCMUI_gv_cMUI_Commander_Max_Count)) {
        return;
    }

    lv_control = libCMUI_gv_commanderItems[lv_selection - 1];
    if ((CMUICore_IsControlValid(lv_control) == false)) {
        return;
    }

    lv_otherPlayer = CMUIX_ReadyOtherCommanderPlayer(lp_player);
    DialogControlSetAnimationState(lv_control, PlayerGroupSingle(lp_player), "ReadyState", lp_selfState);
    DialogControlSetAnimationState(lv_control, PlayerGroupSingle(lv_otherPlayer), "ReadyState", lp_otherState);
}

void CMUIX_ReadyRefreshCommanderButtonForPlayer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == true)) {
        CMUIX_ReadySetCommanderButtonStateForPlayer(lp_player, "Ready", "AllyReady");
        return;
    }

    CMUIX_ReadySetCommanderButtonStateForPlayer(lp_player, "NotReady", "NotReady");
}

void CMUIX_ReadyRefreshCommanderButtonsAll() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        CMUIX_ReadyRefreshCommanderButtonForPlayer(lv_player);
    }
}

bool CMUIX_ReadyAllRequiredPlayersReady() {
    int lv_player;
    playergroup lv_players;

    lv_player = -1;
    lv_players = libCOOC_gf_CommanderPlayers();
    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_players, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        if ((PlayerStatus(lv_player) == c_playerStatusActive) && (libCOTF_gv_menu_ReadyStatus[lv_player] == false)) {
            return false;
        }
    }

    return true;
}

void CMUIX_ReadySetPanelStateForPlayer(int lp_player, string lp_state) {
    playergroup lv_group;
    bool lv_visible;

    lv_group = PlayerGroupSingle(lp_player);
    lv_visible = true;
    if ((CMUICore_IsControlValid(CMUIX_ReadyStatusPanel) == false)) {
        return;
    }

    if ((lp_state == "Hidden")) {
        lv_visible = false;
    }

    DialogControlSetVisible(CMUIX_ReadyStatusPanel, lv_group, lv_visible);
    DialogControlSetAnimationState(CMUIX_ReadyStatusPanel, lv_group, "ReadyStatus", lp_state);
}

void CMUIX_ReadySetReadyButtonVisibleForPlayer(int lp_player, bool lp_visible) {
    if ((CMUICore_IsControlValid(CMUIX_ReadyButton) == false)) {
        return;
    }

    DialogControlSetVisible(CMUIX_ReadyButton, PlayerGroupSingle(lp_player), lp_visible);
}

void CMUIX_ReadySetCommanderPanelReadyForPlayer(int lp_player, bool lp_ready) {
    string lv_state;

    lv_state = "NotReady";
    if ((lp_ready == true)) {
        lv_state = "Ready";
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == false)) {
        return;
    }

    DialogControlSetAnimationState(libCMUI_gv_screenCoopCommanderSelectionPanel, PlayerGroupSingle(lp_player), "CommanderSelectionPanel", lv_state);
}

void CMUIX_ReadySetCancelButtonsVisibleForPlayer(int lp_player, bool lp_visible) {
    playergroup lv_group;

    lv_group = PlayerGroupSingle(lp_player);
    if ((CMUICore_IsControlValid(CMUIX_ReadyCancelButton) == true)) {
        DialogControlSetVisible(CMUIX_ReadyCancelButton, lv_group, lp_visible);
    }

    if ((CMUICore_IsControlValid(CMUIX_ReadyStatusCancelButton) == true)) {
        DialogControlSetVisible(CMUIX_ReadyStatusCancelButton, lv_group, lp_visible);
    }
}

void CMUIX_ReadyRefreshForPlayer(int lp_player) {
    if ((CMUIX_ReadyCountdownRunning == true)) {
        CMUIX_ReadySetCommanderPanelReadyForPlayer(lp_player, true);
        CMUIX_ReadySetReadyButtonVisibleForPlayer(lp_player, false);
        CMUIX_ReadySetCancelButtonsVisibleForPlayer(lp_player, false);
        CMUIX_ReadySetPanelStateForPlayer(lp_player, "Countdown");
        CMUIX_ReadyRefreshDataControlsForPlayer(lp_player);
        return;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == true) && (CMUIX_ReadyPlayerRequiresManualReady(lp_player) == true)) {
        CMUIX_ReadySetCommanderPanelReadyForPlayer(lp_player, true);
        CMUIX_ReadySetReadyButtonVisibleForPlayer(lp_player, false);
        CMUIX_ReadySetCancelButtonsVisibleForPlayer(lp_player, true);
        CMUIX_ReadySetPanelStateForPlayer(lp_player, "Waiting");
        CMUIX_ReadyRefreshDataControlsForPlayer(lp_player);
        return;
    }

    CMUIX_ReadySetCommanderPanelReadyForPlayer(lp_player, false);
    CMUIX_ReadySetReadyButtonVisibleForPlayer(lp_player, true);
    CMUIX_ReadySetCancelButtonsVisibleForPlayer(lp_player, false);
    CMUIX_ReadySetPanelStateForPlayer(lp_player, "Hidden");
    CMUIX_ReadyRefreshDataControlsForPlayer(lp_player);
}

void CMUIX_ReadyRefreshAll() {
    int lv_player;
    int lv_seenPlayers;
    playergroup lv_humans;

    lv_player = -1;
    lv_seenPlayers = 0;
    lv_humans = libCOOC_gf_HumanPlayers();
    CMUIX_ReadyRefreshCommanderButtonsAll();
    if ((CMUICore_IsControlValid(CMUIX_ReadyStatusPanel) == false)) {
        return;
    }

    while ((true == true)) {
        lv_player = PlayerGroupNextPlayer(lv_humans, lv_player);
        if ((lv_player < 0)) {
            break;
        }

        lv_seenPlayers += 1;
        CMUIX_ReadyRefreshForPlayer(lv_player);
    }

    if ((lv_seenPlayers == 0)) {
        CMUIX_ReadyRefreshForPlayer(1);
    }
}

void CMUIX_ReadyHideLauncherDialogForLaunch() {
    if ((libCMUI_gv_screenCoopDialog != c_invalidDialogId)) {
        DialogSetVisible(libCMUI_gv_screenCoopDialog, PlayerGroupAll(), false);
    }

    CMUIX_SetCommanderSelectionUIActive(false);
    CMUIX_CustomMutatorPickerClearChatForAll();
}

bool CMUIX_ReadyCountdownFinishHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    if ((CMUIX_ReadyCountdownRunning == false)) {
        return true;
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        CMUIX_LaunchProfileSaveForTransitionAll();
        CMUIX_ReadyCountdownRunning = false;
        if ((CMUIX_LauncherJumpToSelectedMission() == true)) {
            return true;
        }

        return true;
    }

    CMUIX_ReadyHideLauncherDialogForLaunch();
    CMUIX_FinalApplyLocalLaunchConfiguration();
    CMUIX_ReadyCountdownRunning = false;
    CMUIX_DestroyLauncherUI();
    TriggerSendEvent(CMUIX_EVENT_COMMANDER_CHOICE_CLOSED);
    return true;
}

void CMUIX_ReadyBeginCountdown() {
    if ((CMUIX_ReadyCountdownRunning == true)) {
        return;
    }

    CMUIX_ReadyCountdownRunning = true;
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        CMUIX_ReadyHideLauncherDialogForLaunch();
    }

    if ((CMUIX_ReadyCountdownTrigger == null)) {
        CMUIX_ReadyCountdownTrigger = TriggerCreate("CMUIX_ReadyCountdownFinishHandler");
    }

    if ((CMUIX_ReadyCountdownTrigger != null)) {
        TriggerExecute(CMUIX_ReadyCountdownTrigger, true, false);
    }
}

void CMUIX_ReadySetPlayerReady(int lp_player, bool lp_ready) {
    int lv_targetPlayer;

    lv_targetPlayer = 0;
    if ((CMUIX_ReadyCountdownRunning == true)) {
        return;
    }

    libCOTF_gv_menu_ReadyStatus[lp_player] = lp_ready;
    if ((lp_player == 1) && (PlayerType(2) != c_playerTypeUser)) {
        libCOTF_gv_menu_ReadyStatus[2] = lp_ready;
    }

    if ((lp_ready == false)) {
        lv_targetPlayer = CMUIX_TargetForOperator(lp_player);
        CMUIX_CustomizationRefresh(lp_player);
        CMUIX_PersonalizationRefresh(lp_player, lv_targetPlayer, CMUIX_TargetCommander[lp_player]);
        CMUIX_MutatorInfoRefreshAll();
    }

    CMUIX_ReadyRefreshAll();
    if ((CMUIX_ReadyAllRequiredPlayersReady() == true)) {
        CMUIX_ReadyBeginCountdown();
    }
}

bool CMUIX_ReadyInputLocked(int lp_player, int lp_control) {
    if (((lp_control == CMUIX_ReadyStatusCancelButton) || (lp_control == CMUIX_ReadyCancelButton)) && (CMUIX_ReadyCountdownRunning == false)) {
        return false;
    }

    if ((CMUIX_ReadyCountdownRunning == true) && ((CMUIX_ReadyControlAffectsData(lp_player, lp_control) == true) || (lp_control == CMUIX_ReadyStatusCancelButton) || (lp_control == CMUIX_ReadyCancelButton))) {
        return true;
    }

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == false)) {
        return false;
    }

    return CMUIX_ReadyControlAffectsData(lp_player, lp_control);
}

bool CMUIX_FinalConfigurationHandleClick(int lp_player, int lp_control) {
    if ((CMUIX_IsControlValid(CMUIX_ReadyButton) == false)) {
        return false;
    }

    if ((lp_control == CMUIX_ReadyStatusCancelButton) || (lp_control == CMUIX_ReadyCancelButton)) {
        if ((CMUIX_ReadyCountdownRunning == true)) {
            return true;
        }

        CMUIX_ReadySetPlayerReady(lp_player, false);
        return true;
    }

    if ((lp_control != CMUIX_ReadyButton)) {
        return false;
    }

    if ((CMUIX_ReadyCountdownRunning == true)) {
        return true;
    }

    if ((libCOTF_gv_menu_ReadyStatus[lp_player] == true)) {
        return true;
    }

    CMUIX_ReadySetPlayerReady(lp_player, true);
    CMUIX_MutatorInfoResetPageForPlayer(lp_player);
    CMUIX_MutatorInfoRefreshAll();
    return true;
}

string CMUIX_MutatorInfoBadgeProfileState(int lp_rank) {
    if ((lp_rank <= 0)) {
        return "DefaultState";
    }

    if ((lp_rank == 1)) {
        return "WonVyEy";
    }

    if ((lp_rank == 2)) {
        return "WonEasy";
    }

    if ((lp_rank == 3)) {
        return "WonMedi";
    }

    return "WonMdHd";
}

int CMUIX_MutatorInfoRankFromRating(int lp_rating) {
    if ((lp_rating <= 20)) {
        return 0;
    }

    if ((lp_rating <= 40)) {
        return 1;
    }

    if ((lp_rating <= 60)) {
        return 2;
    }

    if ((lp_rating <= 80)) {
        return 3;
    }

    return 4;
}

int CMUIX_MutatorInfoRankFromBaseDifficulty(int lp_base) {
    if ((lp_base <= 2)) {
        return 0;
    }

    if ((lp_base == 3)) {
        return 1;
    }

    if ((lp_base == 4)) {
        return 2;
    }

    if ((lp_base == 5)) {
        return 3;
    }

    return 4;
}

void CMUIX_MutatorInfoSetBadgeRank(int lp_rank, playergroup lp_players) {
    if ((CMUIX_IsControlValid(libCMUI_gv_mutatorInfoPanel) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_mutatorInfoPanel, lp_players, "ProfileStatsState", CMUIX_MutatorInfoBadgeProfileState(lp_rank));
    }
}

void CMUIX_MutatorInfoSetBadgeQuestion(playergroup lp_players) {
    if ((CMUIX_IsControlValid(libCMUI_gv_mutatorInfoPanel) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_mutatorInfoPanel, lp_players, "ProfileStatsState", "Question");
    }
}

void CMUIX_MutatorInfoClearIcons(playergroup lp_players) {
    int lv_index;

    lv_index = 0;
    while ((lv_index < CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE)) {
        CMUIX_SetControlVisible(CMUIX_MutatorInfoIcons[lv_index], lp_players, false);
        CMUIX_SetControlTooltip(CMUIX_MutatorInfoIcons[lv_index], lp_players, StringToText(""));
        if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIcons[lv_index]) == true)) {
            DialogControlSetAnimationState(CMUIX_MutatorInfoIcons[lv_index], lp_players, "IconDisplayState", "Normal");
            DialogControlSetAnimationState(CMUIX_MutatorInfoIcons[lv_index], lp_players, "SourceState", "Official");
        }

        lv_index += 1;
    }
}

void CMUIX_MutatorInfoResetVisibleList() {
    int lv_index;

    lv_index = 0;
    CMUIX_MutatorInfoVisibleCount = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_MutatorInfoVisibleMutators[lv_index] = "";
        CMUIX_MutatorInfoVisibleEnhanced[lv_index] = 0;
        lv_index += 1;
    }
}

void CMUIX_MutatorInfoAddVisibleMutator(string lp_mutator, bool lp_enhanced) {
    if ((lp_mutator == "")) {
        return;
    }

    if ((CMUIX_MutatorInfoVisibleCount >= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        return;
    }

    CMUIX_MutatorInfoVisibleCount += 1;
    CMUIX_MutatorInfoVisibleMutators[CMUIX_MutatorInfoVisibleCount] = lp_mutator;
    CMUIX_MutatorInfoVisibleEnhanced[CMUIX_MutatorInfoVisibleCount] = 0;
    if ((lp_enhanced == true)) {
        CMUIX_MutatorInfoVisibleEnhanced[CMUIX_MutatorInfoVisibleCount] = 1;
    }
}

int CMUIX_MutatorInfoMaxPage() {
    int lv_pages;

    lv_pages = 1;
    if ((CMUIX_MutatorInfoVisibleCount > 0)) {
        lv_pages = (((CMUIX_MutatorInfoVisibleCount - 1) / CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE) + 1);
    }

    if ((lv_pages > CMUIX_MUTATOR_INFO_PAGE_BUTTON_MAX)) {
        return CMUIX_MUTATOR_INFO_PAGE_BUTTON_MAX;
    }

    return lv_pages;
}

void CMUIX_MutatorInfoClampPage() {
    int lv_maxPage;

    lv_maxPage = CMUIX_MutatorInfoMaxPage();
    if ((CMUIX_MutatorInfoPageIndex < 1)) {
        CMUIX_MutatorInfoPageIndex = 1;
    }

    if ((CMUIX_MutatorInfoPageIndex > lv_maxPage)) {
        CMUIX_MutatorInfoPageIndex = lv_maxPage;
    }
}

void CMUIX_MutatorInfoEnsurePlayerPage(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_MutatorInfoPageIndexByPlayer[lp_player] < 1)) {
        CMUIX_MutatorInfoPageIndexByPlayer[lp_player] = 1;
    }
}

void CMUIX_MutatorInfoLoadPlayerPage(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_MutatorInfoPageIndex = 1;
        return;
    }

    CMUIX_MutatorInfoEnsurePlayerPage(lp_player);
    CMUIX_MutatorInfoPageIndex = CMUIX_MutatorInfoPageIndexByPlayer[lp_player];
}

void CMUIX_MutatorInfoStorePlayerPage(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    if ((CMUIX_MutatorInfoPageIndex < 1)) {
        CMUIX_MutatorInfoPageIndex = 1;
    }

    CMUIX_MutatorInfoPageIndexByPlayer[lp_player] = CMUIX_MutatorInfoPageIndex;
}

void CMUIX_MutatorInfoResetPageForPlayer(int lp_player) {
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    CMUIX_MutatorInfoPageIndexByPlayer[lp_player] = 1;
    CMUIX_MutatorInfoPageIndex = 1;
}

void CMUIX_MutatorInfoResetPages() {
    int lv_player;

    lv_player = 1;
    CMUIX_MutatorInfoPageIndex = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_MutatorInfoPageIndexByPlayer[lv_player] = 1;
        lv_player += 1;
    }
}

void CMUIX_MutatorInfoRefreshPageSelector(playergroup lp_players) {
    int lv_index;
    int lv_page;
    int lv_maxPage;
    bool lv_visible;

    lv_index = 0;
    lv_page = CMUIX_MutatorInfoPageIndex;
    lv_maxPage = CMUIX_MutatorInfoMaxPage();
    lv_visible = (lv_maxPage > 1);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoIconPageSelector, lp_players, lv_visible);
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoPrevPageButton, lp_players, ((lv_visible == true) && (lv_page > 1)));
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoNextPageButton, lp_players, ((lv_visible == true) && (lv_page < lv_maxPage)));
    while ((lv_index < CMUIX_MUTATOR_INFO_PAGE_BUTTON_MAX)) {
        CMUIX_SetControlVisible(CMUIX_MutatorInfoPageButtons[lv_index], lp_players, ((lv_visible == true) && (lv_index < lv_maxPage)));
        CMUIX_SetControlEnabled(CMUIX_MutatorInfoPageButtons[lv_index], lp_players, ((lv_visible == true) && (lv_index < lv_maxPage)));
        CMUIX_SetControlToggled(CMUIX_MutatorInfoPageButtons[lv_index], lp_players, ((lv_visible == true) && (lv_page == (lv_index + 1))));
        lv_index += 1;
    }
}

int CMUIX_MutatorInfoLayoutRowWidth(int lp_count, int lp_iconSize, int lp_spacing) {
    if ((lp_count <= 0)) {
        return 0;
    }

    return ((lp_count * lp_iconSize) + ((lp_count - 1) * lp_spacing));
}

int CMUIX_MutatorInfoLayoutStartX(int lp_count, int lp_iconSize, int lp_spacing) {
    int lv_width;

    lv_width = CMUIX_MutatorInfoLayoutRowWidth(lp_count, lp_iconSize, lp_spacing);
    if ((lv_width >= CMUIX_MUTATOR_INFO_ICON_GROUP_WIDTH)) {
        return 0;
    }

    return ((CMUIX_MUTATOR_INFO_ICON_GROUP_WIDTH - lv_width) / 2);
}

void CMUIX_MutatorInfoLayoutSlot(int lp_slot, playergroup lp_players, int lp_x, int lp_y, int lp_iconSize, int lp_imageSize) {
    if ((lp_slot < 0) || (lp_slot >= CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE)) {
        return;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIcons[lp_slot]) == true)) {
        DialogControlSetSize(CMUIX_MutatorInfoIcons[lp_slot], lp_players, lp_iconSize, lp_iconSize);
        if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIconGroup) == true)) {
            DialogControlSetPositionRelative(CMUIX_MutatorInfoIcons[lp_slot], lp_players, c_anchorTopLeft, CMUIX_MutatorInfoIconGroup, c_anchorTopLeft, lp_x, lp_y);
        }
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIconImageFrames[lp_slot]) == true)) {
        DialogControlSetSize(CMUIX_MutatorInfoIconImageFrames[lp_slot], lp_players, lp_imageSize, lp_imageSize);
    }
}

void CMUIX_MutatorInfoApplyIconLayout(playergroup lp_players, int lp_count) {
    int lv_count;
    int lv_rowOneCount;
    int lv_rowTwoCount;
    int lv_slot;
    int lv_startX;
    int lv_y;

    lv_count = lp_count;
    if ((lv_count < 0)) {
        lv_count = 0;
    }

    if ((lv_count > CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE)) {
        lv_count = CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIconGroup) == true)) {
        DialogControlSetSize(CMUIX_MutatorInfoIconGroup, lp_players, CMUIX_MUTATOR_INFO_ICON_GROUP_WIDTH, CMUIX_MUTATOR_INFO_ICON_GROUP_HEIGHT);
    }

    if ((lv_count <= 0)) {
        return;
    }

    if ((lv_count <= CMUIX_MUTATOR_INFO_ICON_LARGE_MAX)) {
        lv_startX = CMUIX_MutatorInfoLayoutStartX(lv_count, CMUIX_MUTATOR_INFO_ICON_LARGE_SIZE, CMUIX_MUTATOR_INFO_ICON_LARGE_SPACING);
        lv_y = ((CMUIX_MUTATOR_INFO_ICON_GROUP_HEIGHT - CMUIX_MUTATOR_INFO_ICON_LARGE_SIZE) / 2);
        lv_slot = 0;
        while ((lv_slot < lv_count)) {
            CMUIX_MutatorInfoLayoutSlot(lv_slot, lp_players, (lv_startX + (lv_slot * (CMUIX_MUTATOR_INFO_ICON_LARGE_SIZE + CMUIX_MUTATOR_INFO_ICON_LARGE_SPACING))), lv_y, CMUIX_MUTATOR_INFO_ICON_LARGE_SIZE, CMUIX_MUTATOR_INFO_ICON_LARGE_IMAGE_SIZE);
            lv_slot += 1;
        }

        return;
    }

    lv_rowOneCount = ((lv_count + 1) / 2);
    if ((lv_rowOneCount > CMUIX_MUTATOR_INFO_ICON_ROW_MAX)) {
        lv_rowOneCount = CMUIX_MUTATOR_INFO_ICON_ROW_MAX;
    }

    lv_rowTwoCount = (lv_count - lv_rowOneCount);
    if ((lv_rowTwoCount < 0)) {
        lv_rowTwoCount = 0;
    }

    lv_startX = CMUIX_MutatorInfoLayoutStartX(lv_rowOneCount, CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE, CMUIX_MUTATOR_INFO_ICON_SMALL_SPACING);
    lv_slot = 0;
    while ((lv_slot < lv_rowOneCount)) {
        CMUIX_MutatorInfoLayoutSlot(lv_slot, lp_players, (lv_startX + (lv_slot * (CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE + CMUIX_MUTATOR_INFO_ICON_SMALL_SPACING))), 0, CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE, CMUIX_MUTATOR_INFO_ICON_SMALL_IMAGE_SIZE);
        lv_slot += 1;
    }

    lv_startX = CMUIX_MutatorInfoLayoutStartX(lv_rowTwoCount, CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE, CMUIX_MUTATOR_INFO_ICON_SMALL_SPACING);
    lv_y = (CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE + CMUIX_MUTATOR_INFO_ICON_SMALL_ROW_SPACING);
    lv_slot = 0;
    while ((lv_slot < lv_rowTwoCount)) {
        CMUIX_MutatorInfoLayoutSlot((lv_rowOneCount + lv_slot), lp_players, (lv_startX + (lv_slot * (CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE + CMUIX_MUTATOR_INFO_ICON_SMALL_SPACING))), lv_y, CMUIX_MUTATOR_INFO_ICON_SMALL_SIZE, CMUIX_MUTATOR_INFO_ICON_SMALL_IMAGE_SIZE);
        lv_slot += 1;
    }
}

void CMUIX_MutatorInfoRenderVisibleIcons(playergroup lp_players) {
    int lv_index;
    int lv_slot;
    int lv_iconCount;
    bool lv_enhanced;

    CMUIX_MutatorInfoClampPage();
    CMUIX_MutatorInfoClearIcons(lp_players);
    lv_index = (((CMUIX_MutatorInfoPageIndex - 1) * CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE) + 1);
    lv_iconCount = (CMUIX_MutatorInfoVisibleCount - lv_index + 1);
    if ((lv_iconCount < 0)) {
        lv_iconCount = 0;
    }

    if ((lv_iconCount > CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE)) {
        lv_iconCount = CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE;
    }

    CMUIX_MutatorInfoApplyIconLayout(lp_players, lv_iconCount);
    lv_slot = 0;
    lv_enhanced = false;
    while ((lv_slot < CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE) && (lv_index <= CMUIX_MutatorInfoVisibleCount) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_enhanced = (CMUIX_MutatorInfoVisibleEnhanced[lv_index] == 1);
        CMUIX_MutatorInfoSetIcon(lv_slot, CMUIX_MutatorInfoVisibleMutators[lv_index], lv_enhanced, lp_players);
        lv_slot += 1;
        lv_index += 1;
    }

    CMUIX_MutatorInfoRefreshPageSelector(lp_players);
}

int CMUIX_MutatorInfoRankFromCustomCount(int lp_count) {
    if ((lp_count <= 0)) {
        return 0;
    }

    if ((lp_count >= 7)) {
        return 4;
    }

    if ((lp_count >= 5)) {
        return 3;
    }

    if ((lp_count >= 3)) {
        return 2;
    }

    return 1;
}

void CMUIX_MutatorInfoSetIcon(int lp_slot, string lp_mutator, bool lp_enhanced, playergroup lp_players) {
    text lv_tooltip;

    lv_tooltip = StringToText("");
    if ((lp_slot < 0) || (lp_slot >= CMUIX_MUTATOR_INFO_ICON_PAGE_SIZE) || (lp_mutator == "")) {
        return;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIcons[lp_slot]) == true)) {
        DialogControlSetAnimationState(CMUIX_MutatorInfoIcons[lp_slot], lp_players, "IconDisplayState", "Normal");
        DialogControlSetAnimationState(CMUIX_MutatorInfoIcons[lp_slot], lp_players, "SourceState", CMUIX_MutatorChallengeMutatorSourceState(lp_mutator, lp_enhanced));
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorInfoIconImages[lp_slot]) == true)) {
        libNtve_gf_SetDialogItemImage(CMUIX_MutatorInfoIconImages[lp_slot], libCOMU_gf_CT_MutatorIcon(lp_mutator), lp_players);
    }

    lv_tooltip = libCOMU_gf_CT_MutatorName(lp_mutator) + StringToText("\n\n") + CMUIX_MutatorChallengeMutatorDescription(lp_mutator, lp_enhanced);
    CMUIX_SetControlTooltip(CMUIX_MutatorInfoIcons[lp_slot], lp_players, lv_tooltip);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoIcons[lp_slot], lp_players, true);
}

bool CMUIX_MutatorInfoIsChaosMutator(string lp_mutator) {
    if ((lp_mutator == CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS) || (lp_mutator == CMUIX_MUTATOR_CHAOS_RANDOM)) {
        return true;
    }

    return false;
}

text CMUIX_MutatorInfoStandardTitle() {
    return StringExternal("CMUI/MutatorInfo/StandardTitle");
}

text CMUIX_MutatorInfoCustomTitle() {
    if ((CMUIX_ProfileModeActive == true) && (CMUIX_ProfileChallengeName != "") && (CMUIX_ProfileChallengeName != null)) {
        return StringToText(CMUIX_ProfileChallengeName);
    }

    return StringExternal("CMUI/MutatorInfo/CustomTitle");
}

text CMUIX_MutatorInfoMapDescription() {
    CMUIX_MapSelectionEnsureSelection();
    return CMUIX_MapSelectionDescription(CMUIX_MapSelectionSelected);
}

text CMUIX_MutatorInfoRandomSeedText() {
    text lv_value;

    lv_value = StringExternal("CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedAuto");
    if ((CMUIX_ProfileRandomSeedExplicit == true)) {
        lv_value = StringToText(CMUIX_RandomSeedDisplayValue(CMUIX_RandomSeed));
    }

    return StringExternal("CMUI/MutatorInfo/RandomSeedPrefix") + StringToText(" ") + lv_value;
}

void CMUIX_MutatorInfoRefreshStandard(int lp_player, playergroup lp_players) {
    int lv_index;
    int lv_count;
    string lv_mutator;
    bool lv_enhanced;

    lv_index = 1;
    lv_count = libCOMU_gv_cT_MAbomination_MutatorsCount;
    lv_mutator = "";
    lv_enhanced = false;
    CMUIX_MutatorInfoResetVisibleList();
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryTitleLabel, lp_players, CMUIX_MutatorInfoStandardTitle());
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryBodyLabel, lp_players, CMUIX_MutatorInfoMapDescription());
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryStatusLabel, lp_players, StringExternal("CMUI/MutatorInfo/StandardMutatorCountPrefix") + IntToText(lv_count));

    CMUIX_SetControlVisible(CMUIX_MutatorInfoRerollButton, lp_players, false);
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoRerollButton, lp_players, false);
    if ((CMUIX_DifficultySelectedPlus > 0) && (lp_player == 1)) {
        CMUIX_SetControlVisible(CMUIX_MutatorInfoRerollButton, lp_players, true);
        CMUIX_SetControlEnabled(CMUIX_MutatorInfoRerollButton, lp_players, CMUIX_ReadyCanEditSharedData(1));
    }

    while ((lv_index <= lv_count) && (CMUIX_MutatorInfoVisibleCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = libCOMU_gv_cT_MAbomination_Mutators[lv_index];
        lv_enhanced = libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index];
        if ((lv_mutator != "")) {
            CMUIX_MutatorInfoAddVisibleMutator(lv_mutator, lv_enhanced);
        }

        lv_index += 1;
    }

    CMUIX_MutatorInfoRenderVisibleIcons(lp_players);
    CMUIX_MutatorInfoSetBadgeRank(CMUIX_MutatorInfoRankFromRating(CMUIX_DifficultyRatingValue(CMUIX_DifficultySelectedBase, CMUIX_DifficultySelectedPlus)), lp_players);
}

void CMUIX_MutatorInfoRefreshMutator(playergroup lp_players) {
    int lv_index;
    int lv_chaosCount;
    string lv_type;
    string lv_challenge;
    string lv_mutator;
    string lv_chaosMutator;
    bool lv_enhanced;
    bool lv_chaosEnhanced;

    lv_index = 1;
    lv_chaosCount = 0;
    lv_type = CMUIX_MutatorChallengeNormalizeType(CMUIX_MutatorChallengeCurrentType);
    lv_challenge = CMUIX_MutatorChallengeCurrentSelected();
    lv_mutator = "";
    lv_chaosMutator = "";
    lv_enhanced = false;
    lv_chaosEnhanced = false;
    CMUIX_MutatorInfoResetVisibleList();
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryTitleLabel, lp_players, CMUIX_MutatorChallengeDisplayName(lv_type, lv_challenge));
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryBodyLabel, lp_players, CMUIX_MutatorChallengeDescription(lv_type, lv_challenge));
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryStatusLabel, lp_players, StringExternal("CMUI/MutatorInfo/BaseDifficultyPrefix") + CMUIX_DifficultyBaseName(CMUIX_DifficultySelectedBase));
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRerollButton, lp_players, false);
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoRerollButton, lp_players, false);
    if ((CMUIX_MutatorChallengeIsRandom(lv_challenge) == false)) {
        while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max) && (CMUIX_MutatorInfoVisibleCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
            lv_mutator = CMUIX_MutatorChallengeMutatorAt(lv_type, lv_challenge, lv_index);
            if ((lv_mutator != "")) {
                lv_enhanced = CMUIX_MutatorChallengeMutatorEnhancedAt(lv_type, lv_challenge, lv_index, lv_mutator);
                CMUIX_MutatorInfoAddVisibleMutator(lv_mutator, lv_enhanced);
                if ((CMUIX_MutatorInfoIsChaosMutator(lv_mutator) == true)) {
                    lv_chaosCount = CMUIX_MUTATOR_CHAOS_RANDOM_COUNT;
                    if ((lv_chaosMutator == "")) {
                        lv_chaosMutator = lv_mutator;
                        lv_chaosEnhanced = lv_enhanced;
                    }
                }
            }

            lv_index += 1;
        }
    }

    CMUIX_SetControlText(CMUIX_MutatorInfoChaosCostLabel, lp_players, IntToText(lv_chaosCount));
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosIcon, lp_players, false);
    if ((lv_chaosCount > 0)) {
        CMUIX_MutatorInfoResetVisibleList();
        CMUIX_MutatorInfoAddVisibleMutator(lv_chaosMutator, lv_chaosEnhanced);
    }

    CMUIX_MutatorInfoRenderVisibleIcons(lp_players);
    if ((lv_chaosCount > 0)) {
        CMUIX_MutatorInfoSetBadgeQuestion(lp_players);
    }
    else {
        CMUIX_MutatorInfoSetBadgeRank(CMUIX_MutatorInfoRankFromBaseDifficulty(CMUIX_DifficultySelectedBase), lp_players);
    }
}

void CMUIX_MutatorInfoRefreshCustom(playergroup lp_players) {
    int lv_index;
    int lv_randomCount;
    int lv_chaosCount;
    string lv_mutator;
    bool lv_enhanced;

    lv_index = 1;
    lv_randomCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
    lv_chaosCount = CMUIX_CustomMutatorPickerAcceptedOccurrences(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
    lv_mutator = "";
    lv_enhanced = false;

    CMUIX_MutatorInfoResetVisibleList();
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryTitleLabel, lp_players, CMUIX_MutatorInfoCustomTitle());
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryBodyLabel, lp_players, CMUIX_MutatorInfoMapDescription());
    CMUIX_SetControlText(CMUIX_MutatorInfoSummaryStatusLabel, lp_players, StringExternal("CMUI/MutatorInfo/TotalCountPrefix") + IntToText(CMUIX_CustomMutatorPickerAcceptedCount) + StringToText(" / ") + IntToText(CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX));
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRerollButton, lp_players, false);
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoRerollButton, lp_players, false);
    while ((lv_index <= CMUIX_CustomMutatorPickerAcceptedCount) && (lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX) && (CMUIX_MutatorInfoVisibleCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_mutator = CMUIX_CustomMutatorPickerAcceptedMutators[lv_index];
        if ((lv_mutator != "") && (CMUIX_CustomMutatorPickerIsPlaceholder(lv_mutator) == false)) {
            lv_enhanced = (CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_index] == 1);
            CMUIX_MutatorInfoAddVisibleMutator(lv_mutator, lv_enhanced);
        }

        lv_index += 1;
    }

    CMUIX_SetControlText(CMUIX_MutatorInfoRandomCostLabel, lp_players, IntToText(lv_randomCount));
    CMUIX_SetControlText(CMUIX_MutatorInfoChaosCostLabel, lp_players, IntToText(lv_chaosCount));
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomIcon, lp_players, true);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomIncreaseButton, lp_players, true);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomDecreaseButton, lp_players, true);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosIcon, lp_players, true);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosIncreaseButton, lp_players, true);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosDecreaseButton, lp_players, true);
    CMUIX_MutatorInfoRenderVisibleIcons(lp_players);
    CMUIX_MutatorInfoSetBadgeRank(CMUIX_MutatorInfoRankFromCustomCount(CMUIX_CustomMutatorPickerAcceptedCount), lp_players);
}

void CMUIX_MutatorInfoRefreshForPlayer(int lp_player) {
    playergroup lv_players;

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    if ((CMUIX_IsControlValid(libCMUI_gv_mutatorInfoPanel) == false)) {
        return;
    }

    CMUIX_MutatorInfoLoadPlayerPage(lp_player);
    DialogControlSetAnimationState(libCMUI_gv_mutatorInfoPanel, lv_players, "InfoPanelState", "Active");
    DialogControlSetAnimationState(libCMUI_gv_mutatorInfoPanel, lv_players, "InfoPanelDescriptionState", "Loaded");
    DialogControlSetAnimationState(libCMUI_gv_mutatorInfoPanel, lv_players, "InfoPanelMapState", "Loaded");
    CMUIX_SetControlText(CMUIX_MutatorInfoRandomSeedLabel, lv_players, CMUIX_MutatorInfoRandomSeedText());
    CMUIX_SetControlText(CMUIX_MutatorInfoRandomCostLabel, lv_players, IntToText(0));
    CMUIX_SetControlText(CMUIX_MutatorInfoChaosCostLabel, lv_players, IntToText(0));
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomIcon, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomIncreaseButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRandomDecreaseButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosIcon, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosIncreaseButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoChaosDecreaseButton, lv_players, false);
    CMUIX_SetControlVisible(CMUIX_MutatorInfoRerollButton, lv_players, false);
    CMUIX_SetControlEnabled(CMUIX_MutatorInfoRerollButton, lv_players, false);
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        CMUIX_MutatorInfoRefreshMutator(lv_players);
        CMUIX_MutatorInfoStorePlayerPage(lp_player);
        return;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        CMUIX_MutatorInfoRefreshCustom(lv_players);
        CMUIX_MutatorInfoStorePlayerPage(lp_player);
        return;
    }

    CMUIX_MutatorInfoRefreshStandard(lp_player, lv_players);
    CMUIX_MutatorInfoStorePlayerPage(lp_player);
}

void CMUIX_MutatorInfoRefreshAll() {
    int lv_player;

    lv_player = 1;
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_MutatorInfoRefreshForPlayer(lv_player);
        lv_player += 1;
    }
}

bool CMUIX_MutatorInfoHandleClick(int lp_player, int lp_control) {
    int lv_index;
    bool lv_changed;
    playergroup lv_players;

    lv_index = 0;
    lv_changed = false;
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return false;
    }

    lv_players = PlayerGroupSingle(lp_player);
    CMUIX_MutatorInfoLoadPlayerPage(lp_player);
    if ((lp_control == CMUIX_MutatorInfoPrevPageButton)) {
        CMUIX_MutatorInfoPageIndex -= 1;
        CMUIX_MutatorInfoRenderVisibleIcons(lv_players);
        CMUIX_MutatorInfoStorePlayerPage(lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorInfoNextPageButton)) {
        CMUIX_MutatorInfoPageIndex += 1;
        CMUIX_MutatorInfoRenderVisibleIcons(lv_players);
        CMUIX_MutatorInfoStorePlayerPage(lp_player);
        return true;
    }

    while ((lv_index < CMUIX_MUTATOR_INFO_PAGE_BUTTON_MAX)) {
        if ((lp_control == CMUIX_MutatorInfoPageButtons[lv_index])) {
            CMUIX_MutatorInfoPageIndex = lv_index + 1;
            CMUIX_MutatorInfoRenderVisibleIcons(lv_players);
            CMUIX_MutatorInfoStorePlayerPage(lp_player);
            return true;
        }

        lv_index += 1;
    }

    if ((lp_control == CMUIX_MutatorInfoRerollButton)) {
        if ((CMUIX_PlayerCanControlSharedSetup(lp_player) == true) && (CMUIX_CurrentMode == CMUIX_MODE_STANDARD) && (CMUIX_DifficultySelectedPlus > 0)) {
            CMUIX_StandardBrutalPlusApplyRuntime();
            CMUIX_MutatorInfoResetPages();
            CMUIX_MapSelectionResetReadyStatus();
            CMUIX_MutatorInfoRefreshAll();
        }

        return true;
    }

    if ((lp_control != CMUIX_MutatorInfoRandomIncreaseButton) && (lp_control != CMUIX_MutatorInfoRandomDecreaseButton) && (lp_control != CMUIX_MutatorInfoChaosIncreaseButton) && (lp_control != CMUIX_MutatorInfoChaosDecreaseButton)) {
        return false;
    }

    if ((CMUIX_CurrentMode != CMUIX_MODE_CUSTOM) || (CMUIX_ReadyCanEditSharedData(lp_player) == false)) {
        return true;
    }

    if ((lp_control == CMUIX_MutatorInfoRandomIncreaseButton)) {
        lv_changed = CMUIX_CustomMutatorPickerAcceptedAppend(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
    }
    else {
        if ((lp_control == CMUIX_MutatorInfoRandomDecreaseButton)) {
            lv_changed = CMUIX_CustomMutatorPickerAcceptedRemoveFirst(CMUIX_CUSTOM_MUTATOR_PICKER_RANDOM);
        }
        else {
            if ((lp_control == CMUIX_MutatorInfoChaosIncreaseButton)) {
                lv_changed = CMUIX_CustomMutatorPickerAcceptedAppend(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
            }
            else {
                if ((lp_control == CMUIX_MutatorInfoChaosDecreaseButton)) {
                    lv_changed = CMUIX_CustomMutatorPickerAcceptedRemoveFirst(CMUIX_CUSTOM_MUTATOR_PICKER_CHAOS);
                }
            }
        }
    }

    if ((lv_changed == true)) {
        CMUIX_CustomMutatorPickerSyncAcceptedPreview(lp_player);
    }

    return true;
}

bool CMUIX_NavigationHandleClick(int lp_player, int lp_control) {
    int lv_previousMode;

    lv_previousMode = CMUIX_CurrentMode;
    if ((lp_control == libCMUI_gv_screenCoopNavigationStandardButton)) {
        CMUIX_CurrentMode = CMUIX_MODE_STANDARD;
        CMUIX_ProfileRuntimeLocksRefresh();
        CMUIX_ProfileEnforceCommanderSelections();
        libCMUI_gf_ScreenCoopCommanderInitFromData();
        CMUIX_MutatorInfoResetPages();
        if ((lv_previousMode != CMUIX_CurrentMode)) {
            CMUIX_MapSelectionResetReadyStatus();
        }

        CMUIX_DifficultyRefreshAll();
        CMUIX_StandardBrutalPlusApplyRuntime();
        CMUIX_MutatorPoolRefreshOpenButtons();
        CMUIX_ProfileRefreshModeVisuals();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    if ((lp_control == libCMUI_gv_screenCoopNavigationMutatorButton)) {
        CMUIX_CurrentMode = CMUIX_MODE_MUTATOR;
        CMUIX_MutatorInfoResetPages();
        CMUIX_MutatorChallengeSetCurrentType(CMUIX_MutatorChallenge_Type_Official);
        CMUIX_MutatorChallengeRefreshList(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
        CMUIX_ProfileEnforceCommanderSelections();
        libCMUI_gf_ScreenCoopCommanderInitFromData();
        if ((lv_previousMode != CMUIX_CurrentMode)) {
            CMUIX_MapSelectionResetReadyStatus();
        }

        CMUIX_DifficultyRefreshAll();
        CMUIX_MutatorPoolRefreshOpenButtons();
        CMUIX_ProfileRefreshModeVisuals();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    if ((lp_control == libCMUI_gv_screenCoopNavigationCMMutatorButton)) {
        CMUIX_CurrentMode = CMUIX_MODE_MUTATOR;
        CMUIX_MutatorInfoResetPages();
        CMUIX_MutatorChallengeSetCurrentType(CMUIX_MutatorChallenge_Type_CM);
        CMUIX_MutatorChallengeRefreshList(lp_player);
        CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
        CMUIX_ProfileEnforceCommanderSelections();
        libCMUI_gf_ScreenCoopCommanderInitFromData();
        if ((lv_previousMode != CMUIX_CurrentMode)) {
            CMUIX_MapSelectionResetReadyStatus();
        }

        CMUIX_DifficultyRefreshAll();
        CMUIX_MutatorPoolRefreshOpenButtons();
        CMUIX_ProfileRefreshModeVisuals();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    if ((lp_control == libCMUI_gv_screenCoopNavigationCustomButton)) {
        CMUIX_CurrentMode = CMUIX_MODE_CUSTOM;
        CMUIX_ProfileRuntimeLocksRefresh();
        CMUIX_ProfileEnforceCommanderSelections();
        libCMUI_gf_ScreenCoopCommanderInitFromData();
        CMUIX_MutatorInfoResetPages();
        if ((lv_previousMode != CMUIX_CurrentMode)) {
            CMUIX_MapSelectionResetReadyStatus();
        }

        CMUIX_DifficultyRefreshAll();
        CMUIX_MutatorPoolRefreshOpenButtons();
        CMUIX_ProfileRefreshModeVisuals();
        CMUIX_MutatorInfoRefreshAll();
        return true;
    }

    return false;
}

int CMUIX_MutatorPoolMaxPage(int lp_view) {
    int lv_count;

    if ((lp_view < 1) || (lp_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        return 1;
    }

    lv_count = CMUIX_MutatorPoolVisibleCount[lp_view];
    if ((lv_count <= 0)) {
        return 1;
    }

    return (((lv_count - 1) / CMUIX_MUTATOR_POOL_ROW_MAX) + 1);
}

void CMUIX_MutatorPoolClampCurrentPage(int lp_view) {
    int lv_maxPage;

    if ((lp_view < 1) || (lp_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        return;
    }

    lv_maxPage = CMUIX_MutatorPoolMaxPage(lp_view);
    if ((CMUIX_MutatorPoolPageIndex[lp_view] < 1)) {
        CMUIX_MutatorPoolPageIndex[lp_view] = 1;
    }

    if ((CMUIX_MutatorPoolPageIndex[lp_view] > lv_maxPage)) {
        CMUIX_MutatorPoolPageIndex[lp_view] = lv_maxPage;
    }
}

void CMUIX_MutatorPoolRefreshPageControls(int lp_view, playergroup lp_players) {
    int lv_maxPage;
    int lv_page;

    if ((lp_view < 1) || (lp_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        return;
    }

    CMUIX_MutatorPoolClampCurrentPage(lp_view);
    lv_page = CMUIX_MutatorPoolPageIndex[lp_view];
    lv_maxPage = CMUIX_MutatorPoolMaxPage(lp_view);
    CMUIX_SetControlText(CMUIX_MutatorPoolPageLabel, lp_players, StringToText(IntToString(lv_page) + " / " + IntToString(lv_maxPage)));
    CMUIX_SetControlEnabled(CMUIX_MutatorPoolPrevPageButton, lp_players, (lv_page > 1));
    CMUIX_SetControlEnabled(CMUIX_MutatorPoolNextPageButton, lp_players, (lv_page < lv_maxPage));
}

void CMUIX_MutatorPoolBuildVisibleList(int lp_view) {
    int lv_index;
    int lv_count;
    int lv_visibleCount;
    int lv_pool;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_visibleCount = 0;
    lv_pool = CMUIX_MutatorPoolPoolForView(lp_view);
    lv_mutator = "";
    if ((lp_view < 1) || (lp_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        return;
    }

    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_MutatorPoolShouldShow(lv_pool, lv_mutator) == true) && (CMUIX_MutatorPoolMatchesSearch(lp_view, lv_mutator) == true)) {
            lv_visibleCount += 1;
            CMUIX_MutatorPoolVisibleIndices[lp_view][lv_visibleCount] = lv_index;
        }

        lv_index += 1;
    }

    CMUIX_MutatorPoolVisibleCount[lp_view] = lv_visibleCount;
    while ((lv_visibleCount < CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_visibleCount += 1;
        CMUIX_MutatorPoolVisibleIndices[lp_view][lv_visibleCount] = 0;
    }

    CMUIX_MutatorPoolClampCurrentPage(lp_view);
}

bool CMUIX_MutatorPoolNormalEligible(int lp_pool, string lp_mutator) {
    if ((CMUIX_MutatorPoolMutatorIsCommonEligible(lp_mutator) == false)) {
        return false;
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS) && (UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Points", 1) <= 0)) {
        return false;
    }

    return true;
}

bool CMUIX_MutatorPoolFirstEligible(int lp_pool, string lp_mutator) {
    if ((lp_pool != CMUIX_MUTATOR_POOL_CYCLE)) {
        return false;
    }

    return CMUIX_MutatorPoolMutatorIsCommonEligible(lp_mutator);
}

bool CMUIX_MutatorPoolEnhanceEligible(int lp_pool, string lp_mutator) {
    if ((CMUIX_MutatorPoolMutatorIsCommonEligible(lp_mutator) == false)) {
        return false;
    }

    if ((libCOMU_gf_MutatorHasEnhancement(lp_mutator) == false)) {
        return false;
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS) && (UserDataGetInt("Mutators", lp_mutator, "Pool Brutal Plus - Enhance Points", 1) <= 0)) {
        return false;
    }

    return true;
}

bool CMUIX_MutatorPoolShouldShow(int lp_pool, string lp_mutator) {
    if ((CMUIX_MutatorPoolMutatorIsCommonEligible(lp_mutator) == false)) {
        return false;
    }

    if ((lp_pool == CMUIX_MUTATOR_POOL_BRUTAL_PLUS)) {
        if ((CMUIX_MutatorPoolNormalEligible(lp_pool, lp_mutator) == true)) {
            return true;
        }

        return CMUIX_MutatorPoolEnhanceEligible(lp_pool, lp_mutator);
    }

    return true;
}

bool CMUIX_MutatorPoolNormalValue(int lp_pool, string lp_mutator) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolNormalEligible(lp_pool, lp_mutator) == false)) {
        return false;
    }

    if ((lv_index <= 0)) {
        return false;
    }

    return CMUIX_MutatorPoolIntIsEnabled(CMUIX_MutatorPoolDraftNormal[lp_pool][lv_index]);
}

bool CMUIX_MutatorPoolFirstValue(string lp_mutator) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolMutatorIsCommonEligible(lp_mutator) == false)) {
        return false;
    }

    if ((lv_index <= 0)) {
        return false;
    }

    return CMUIX_MutatorPoolIntIsEnabled(CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index]);
}

bool CMUIX_MutatorPoolEnhanceValue(int lp_pool, string lp_mutator) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolEnhanceEligible(lp_pool, lp_mutator) == false)) {
        return false;
    }

    if ((lv_index <= 0)) {
        return false;
    }

    return CMUIX_MutatorPoolIntIsEnabled(CMUIX_MutatorPoolDraftEnhance[lp_pool][lv_index]);
}

void CMUIX_MutatorPoolSetNormalValue(int lp_pool, string lp_mutator, bool lp_enabled) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolNormalEligible(lp_pool, lp_mutator) == false)) {
        return;
    }

    if ((lv_index <= 0)) {
        return;
    }

    CMUIX_MutatorPoolDraftNormal[lp_pool][lv_index] = CMUIX_MutatorPoolBoolToInt(lp_enabled);
}

void CMUIX_MutatorPoolSetFirstValue(string lp_mutator, bool lp_enabled) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolFirstEligible(CMUIX_MUTATOR_POOL_CYCLE, lp_mutator) == false)) {
        return;
    }

    if ((lv_index <= 0)) {
        return;
    }

    CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = CMUIX_MutatorPoolBoolToInt(lp_enabled);
}

void CMUIX_MutatorPoolSetEnhanceValue(int lp_pool, string lp_mutator, bool lp_enabled) {
    int lv_index;

    lv_index = CMUIX_MutatorPoolIndexForMutator(lp_mutator);
    if ((CMUIX_MutatorPoolEnhanceEligible(lp_pool, lp_mutator) == false)) {
        return;
    }

    if ((lv_index <= 0)) {
        return;
    }

    CMUIX_MutatorPoolDraftEnhance[lp_pool][lv_index] = CMUIX_MutatorPoolBoolToInt(lp_enabled);
}

void CMUIX_MutatorPoolSetPoolState(int lp_view, playergroup lp_players) {
    int lv_pool;

    lv_pool = CMUIX_MutatorPoolPoolForView(lp_view);
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolMainDialog[lp_view]) == true)) {
        DialogControlSetAnimationState(CMUIX_MutatorPoolMainDialog[lp_view], lp_players, "PoolModeState", CMUIX_MutatorPoolStateName(lv_pool));
    }
}

void CMUIX_MutatorPoolResetCurrent(int lp_view) {
    int lv_index;
    int lv_count;
    int lv_pool;
    string lv_mutator;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_pool = CMUIX_MutatorPoolPoolForView(lp_view);
    lv_mutator = "";
    CMUIX_MutatorPoolEnsureDraft();
    while ((lv_index <= lv_count) && (lv_index <= CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == true)) {
            CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index] = 0;
            CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index] = 0;
            CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = 0;
        }
        else {
            CMUIX_MutatorPoolDraftNormal[lv_pool][lv_index] = UserDataGetInt("Mutators", lv_mutator, CMUIX_MutatorPoolDefaultNormalField(lv_pool), 1);
            CMUIX_MutatorPoolDraftEnhance[lv_pool][lv_index] = 0;
            if ((lv_pool == CMUIX_MUTATOR_POOL_CYCLE)) {
                CMUIX_MutatorPoolDraftFirst[CMUIX_MUTATOR_POOL_CYCLE][lv_index] = CMUIX_MutatorPoolDefaultFirstValue(lv_mutator);
            }
        }

        lv_index += 1;
    }
}

void CMUIX_MutatorPoolHideItem(int lp_view, int lp_slot, playergroup lp_players) {
    if ((lp_view < 1) || (lp_view > CMUIX_MUTATOR_POOL_VIEW_MAX) || (lp_slot < 1) || (lp_slot > CMUIX_MUTATOR_POOL_ITEM_MAX)) {
        return;
    }

    CMUIX_MutatorPoolItemMutators[lp_view][lp_slot] = "";
    CMUIX_SetControlVisible(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], lp_players, false);
}

void CMUIX_MutatorPoolApplySearchFilter(int lp_view, int lp_player) {
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolMainDialog[lp_view]) == false)) {
        return;
    }

    CMUIX_MutatorPoolPageIndex[lp_view] = 1;
    CMUIX_MutatorPoolRefreshView(lp_view, lp_player);
}

string CMUIX_MutatorPoolSourceState(int lp_pool, string lp_mutator) {
    string lv_sourceState;

    lv_sourceState = "";
    if ((lp_mutator == "")) {
        return "Official";
    }

    if ((CMUIX_MutatorPoolEnhanceValue(lp_pool, lp_mutator) == true)) {
        return "Plus";
    }

    lv_sourceState = UserDataGetString("MutatorType", UserDataGetUserInstance("Mutators", lp_mutator, "MA - Type", 1), "UIStateString", 1);
    if ((lv_sourceState == "")) {
        lv_sourceState = "Official";
    }

    return lv_sourceState;
}

void CMUIX_MutatorPoolRefreshItem(int lp_view, int lp_slot, string lp_mutator, playergroup lp_players) {
    int lv_pool;
    bool lv_normalEligible;
    bool lv_firstEligible;
    bool lv_enhanceEligible;
    string lv_sourceState;

    lv_pool = CMUIX_MutatorPoolPoolForView(lp_view);
    lv_normalEligible = CMUIX_MutatorPoolNormalEligible(lv_pool, lp_mutator);
    lv_firstEligible = CMUIX_MutatorPoolFirstEligible(lv_pool, lp_mutator);
    lv_enhanceEligible = CMUIX_MutatorPoolEnhanceEligible(lv_pool, lp_mutator);
    lv_sourceState = CMUIX_MutatorPoolSourceState(lv_pool, lp_mutator);

    CMUIX_MutatorPoolItemMutators[lp_view][lp_slot] = lp_mutator;
    CMUIX_SetControlVisible(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], lp_players, true);
    CMUIX_SetControlText(CMUIX_MutatorPoolNameLabels[lp_view][lp_slot], lp_players, libCOMU_gf_CT_MutatorName(lp_mutator));
    CMUIX_SetControlText(CMUIX_MutatorPoolDescriptionLabels[lp_view][lp_slot], lp_players, libCOMU_gf_CT_MutatorDescription(lp_mutator));
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolIconBoxes[lp_view][lp_slot]) == true)) {
        DialogControlSetAnimationState(CMUIX_MutatorPoolIconBoxes[lp_view][lp_slot], lp_players, "SourceState", lv_sourceState);
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolIcons[lp_view][lp_slot]) == true)) {
        libNtve_gf_SetDialogItemImage(CMUIX_MutatorPoolIcons[lp_view][lp_slot], libCOMU_gf_CT_MutatorIcon(lp_mutator), lp_players);
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolActiveChecks[lp_view][lp_slot]) == true)) {
        CMUIX_SetControlVisible(CMUIX_MutatorPoolActiveChecks[lp_view][lp_slot], lp_players, lv_normalEligible);
        libNtve_gf_SetDialogItemChecked(CMUIX_MutatorPoolActiveChecks[lp_view][lp_slot], CMUIX_MutatorPoolNormalValue(lv_pool, lp_mutator), lp_players);
        DialogControlSetEnabled(CMUIX_MutatorPoolActiveChecks[lp_view][lp_slot], lp_players, lv_normalEligible);
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolFirstChecks[lp_view][lp_slot]) == true)) {
        CMUIX_SetControlVisible(CMUIX_MutatorPoolFirstChecks[lp_view][lp_slot], lp_players, lv_firstEligible);
        libNtve_gf_SetDialogItemChecked(CMUIX_MutatorPoolFirstChecks[lp_view][lp_slot], CMUIX_MutatorPoolFirstValue(lp_mutator), lp_players);
        DialogControlSetEnabled(CMUIX_MutatorPoolFirstChecks[lp_view][lp_slot], lp_players, lv_firstEligible);
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolEnhanceButtons[lp_view][lp_slot]) == true)) {
        CMUIX_SetControlVisible(CMUIX_MutatorPoolEnhanceButtons[lp_view][lp_slot], lp_players, lv_enhanceEligible);
        libNtve_gf_SetDialogItemChecked(CMUIX_MutatorPoolEnhanceButtons[lp_view][lp_slot], CMUIX_MutatorPoolEnhanceValue(lv_pool, lp_mutator), lp_players);
        DialogControlSetEnabled(CMUIX_MutatorPoolEnhanceButtons[lp_view][lp_slot], lp_players, lv_enhanceEligible);
    }
}

void CMUIX_MutatorPoolRefreshView(int lp_view, int lp_player) {
    int lv_slot;
    int lv_visibleIndex;
    int lv_dataIndex;
    string lv_mutator;
    playergroup lv_players;

    lv_slot = 1;
    lv_visibleIndex = 0;
    lv_dataIndex = 0;
    lv_mutator = "";
    lv_players = PlayerGroupAll();

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolMainDialog[lp_view]) == false)) {
        return;
    }

    CMUIX_MutatorPoolRefreshing = true;
    CMUIX_MutatorPoolEnsureDraft();
    if ((lp_view == CMUIX_MutatorPoolCurrentView)) {
        CMUIX_MutatorPoolSetPoolState(lp_view, lv_players);
    }

    CMUIX_MutatorPoolBuildVisibleList(lp_view);
    CMUIX_MutatorPoolRefreshPageControls(lp_view, lv_players);

    while ((lv_slot <= CMUIX_MUTATOR_POOL_ROW_MAX)) {
        lv_visibleIndex = ((CMUIX_MutatorPoolPageIndex[lp_view] - 1) * CMUIX_MUTATOR_POOL_ROW_MAX) + lv_slot;
        if ((lv_visibleIndex <= CMUIX_MutatorPoolVisibleCount[lp_view])) {
            lv_dataIndex = CMUIX_MutatorPoolVisibleIndices[lp_view][lv_visibleIndex];
            if ((lv_dataIndex > 0)) {
                lv_mutator = UserDataInstance("Mutators", lv_dataIndex);
                CMUIX_MutatorPoolRefreshItem(lp_view, lv_slot, lv_mutator, lv_players);
            }
            else {
                CMUIX_MutatorPoolHideItem(lp_view, lv_slot, lv_players);
            }
        }
        else {
            CMUIX_MutatorPoolHideItem(lp_view, lv_slot, lv_players);
        }

        lv_slot += 1;
    }

    CMUIX_MutatorPoolRefreshing = false;
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ReadyRefreshDataControlsForPlayer(lp_player);
    }
    else {
        CMUIX_ReadyRefreshDataControlsAll();
    }
}

void CMUIX_MutatorPoolRefreshAll() {
    int lv_view;

    lv_view = CMUIX_MutatorPoolCurrentView;
    if ((lv_view < 1) || (lv_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        lv_view = 1;
    }

    CMUIX_MutatorPoolRefreshView(lv_view, 1);
}

void CMUIX_MutatorPoolShowView(int lp_view, int lp_player) {
    int lv_activeView;
    playergroup lv_players;
    bool lv_openPage;

    lv_activeView = lp_view;
    lv_players = PlayerGroupSingle(lp_player);
    lv_openPage = false;
    if ((lv_activeView < 1) || (lv_activeView > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        lv_activeView = 1;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPage[1]) == false)) {
        return;
    }

    CMUIX_StartupInitializeData();
    CMUIX_MutatorPoolCurrentView = lv_activeView;
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPulldown[1]) == true)) {
        DialogControlSelectItem(CMUIX_MutatorPoolPulldown[1], lv_players, CMUIX_MutatorPoolPoolForView(lv_activeView));
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolSearchBoxes[1]) == true)) {
        libNtve_gf_SetDialogItemEditorValue(CMUIX_MutatorPoolSearchBoxes[1], CMUIX_MutatorPoolSearchText[lv_activeView], lv_players);
    }

    CMUIX_MutatorPoolSetPoolState(lv_activeView, lv_players);
    if ((lp_player >= 1) && (lp_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_openPage = (CMUIX_MutatorPoolPageOpen[lp_player] == false);
        CMUIX_MutatorPoolPageOpen[lp_player] = true;
    }
    else {
        lv_openPage = true;
    }

    if ((lv_openPage == true)) {
        DialogControlSendAnimationEvent(CMUIX_MutatorPoolPage[1], lv_players, "Show");
    }

    CMUIX_MutatorPoolRefreshView(lv_activeView, lp_player);
}

void CMUIX_MutatorPoolSetupPulldown(int lp_view, int lp_defaultPool) {
    int lv_pool;

    lv_pool = CMUIX_MutatorPoolClampPool(lp_defaultPool);
    CMUIX_MutatorPoolSelectedPool[lp_view] = lv_pool;
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPulldown[lp_view]) == false)) {
        return;
    }

    DialogControlRemoveAllItems(CMUIX_MutatorPoolPulldown[lp_view], PlayerGroupAll());
    DialogControlAddItem(CMUIX_MutatorPoolPulldown[lp_view], PlayerGroupAll(), StringExternal("CMUI/CustomMutatorPool/PoolRandom"));
    DialogControlAddItem(CMUIX_MutatorPoolPulldown[lp_view], PlayerGroupAll(), StringExternal("CMUI/CustomMutatorPool/PoolCycle"));
    DialogControlAddItem(CMUIX_MutatorPoolPulldown[lp_view], PlayerGroupAll(), StringExternal("CMUI/CustomMutatorPool/PoolBrutalPlus"));
}

void CMUIX_MutatorPoolHookupItem(int lp_view, int lp_slot) {
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolListContainer[lp_view]) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_MutatorPoolListContainer[lp_view], c_triggerControlTypePanel, ("Item" + IntToString(lp_slot)));
    CMUIX_MutatorPoolItemPanels[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypeCheckBox, "ActiveCheckBox");
    CMUIX_MutatorPoolActiveChecks[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypeCheckBox, "FirstRandomCheckBox");
    CMUIX_MutatorPoolFirstChecks[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypeLabel, "NameLabel");
    CMUIX_MutatorPoolNameLabels[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypeLabel, "DescriptionLabel");
    CMUIX_MutatorPoolDescriptionLabels[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypePanel, "MutatorIconBox");
    CMUIX_MutatorPoolIconBoxes[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolIconBoxes[lp_view][lp_slot], c_triggerControlTypeImage, "MutatorIcon");
    CMUIX_MutatorPoolIcons[lp_view][lp_slot] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolItemPanels[lp_view][lp_slot], c_triggerControlTypeCheckBox, "EnhanceCheckBox");
    CMUIX_MutatorPoolEnhanceButtons[lp_view][lp_slot] = DialogControlLastCreated();
}

bool CMUIX_MutatorPoolHookupReady() {
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPage[1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolMainDialog[1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolListSections[1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolListContainer[1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolItemPanels[1][1]) == false)) {
        return false;
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolNameLabels[1][1]) == false)) {
        return false;
    }

    return true;
}

void CMUIX_MutatorPoolHookupPage(string lp_pageName) {
    int lv_view;
    int lv_slot;

    lv_view = 1;
    lv_slot = 1;
    DialogControlHookup(CMUIX_MutatorPoolHostPanel, c_triggerControlTypePanel, lp_pageName);
    CMUIX_MutatorPoolPage[1] = DialogControlLastCreated();
    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPage[1]) == false)) {
        return;
    }

    DialogControlHookup(CMUIX_MutatorPoolPage[1], c_triggerControlTypePanel, "MutatorSelectionMainDialog");
    CMUIX_MutatorPoolMainDialog[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolMainDialog[1], c_triggerControlTypePanel, "HeaderPanel");
    CMUIX_MutatorPoolHeaderPanel[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolHeaderPanel[1], c_triggerControlTypePulldown, "MutatorPoolPulldown");
    CMUIX_MutatorPoolPulldown[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolHeaderPanel[1], c_triggerControlTypeEditBox, "SearchEditBoxTemplate");
    CMUIX_MutatorPoolSearchBoxes[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolSearchBoxes[1], c_triggerControlTypeButton, "ClearTextButton");
    CMUIX_MutatorPoolSearchClearButtons[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolMainDialog[1], c_triggerControlTypeButton, "AcceptButton");
    CMUIX_MutatorPoolAcceptButton[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolMainDialog[1], c_triggerControlTypeButton, "CancelButton");
    CMUIX_MutatorPoolCancelButton[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolMainDialog[1], c_triggerControlTypeButton, "ResetButton");
    CMUIX_MutatorPoolResetButton[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolHeaderPanel[1], c_triggerControlTypeButton, "PrevPageButton");
    CMUIX_MutatorPoolPrevPageButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolHeaderPanel[1], c_triggerControlTypeButton, "NextPageButton");
    CMUIX_MutatorPoolNextPageButton = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolHeaderPanel[1], c_triggerControlTypeLabel, "PageLabel");
    CMUIX_MutatorPoolPageLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolMainDialog[1], c_triggerControlTypePanel, "ListPanel");
    CMUIX_MutatorPoolListSections[1] = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolListSections[1], c_triggerControlTypeLabel, "FirstRandomLabelTitle");
    CMUIX_MutatorPoolFirstHeaderLabel = DialogControlLastCreated();
    DialogControlHookup(CMUIX_MutatorPoolListSections[1], c_triggerControlTypePanel, "RowsPanel");
    CMUIX_MutatorPoolListContainer[1] = DialogControlLastCreated();

    while ((lv_view <= CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        CMUIX_MutatorPoolPage[lv_view] = CMUIX_MutatorPoolPage[1];
        CMUIX_MutatorPoolMainDialog[lv_view] = CMUIX_MutatorPoolMainDialog[1];
        CMUIX_MutatorPoolHeaderPanel[lv_view] = CMUIX_MutatorPoolHeaderPanel[1];
        CMUIX_MutatorPoolPulldown[lv_view] = CMUIX_MutatorPoolPulldown[1];
        CMUIX_MutatorPoolSearchBoxes[lv_view] = CMUIX_MutatorPoolSearchBoxes[1];
        CMUIX_MutatorPoolSearchClearButtons[lv_view] = CMUIX_MutatorPoolSearchClearButtons[1];
        CMUIX_MutatorPoolAcceptButton[lv_view] = CMUIX_MutatorPoolAcceptButton[1];
        CMUIX_MutatorPoolCancelButton[lv_view] = CMUIX_MutatorPoolCancelButton[1];
        CMUIX_MutatorPoolResetButton[lv_view] = CMUIX_MutatorPoolResetButton[1];
        CMUIX_MutatorPoolListSections[lv_view] = CMUIX_MutatorPoolListSections[1];
        CMUIX_MutatorPoolListContainer[lv_view] = CMUIX_MutatorPoolListContainer[1];

        lv_slot = 1;
        while ((lv_slot <= CMUIX_MUTATOR_POOL_ROW_MAX)) {
            CMUIX_MutatorPoolHookupItem(lv_view, lv_slot);
            lv_slot += 1;
        }

        lv_view += 1;
    }

    CMUIX_MutatorPoolSetupPulldown(1, CMUIX_MUTATOR_POOL_RANDOM);
    CMUIX_SetControlVisible(CMUIX_MutatorPoolPage[1], PlayerGroupAll(), false);
    DialogControlSendAnimationEvent(CMUIX_MutatorPoolPage[1], PlayerGroupAll(), "Hide");
}

void CMUIX_MutatorPoolHookup() {
    if ((CMUIX_MutatorPoolHooked == true)) {
        if ((CMUIX_MutatorPoolHookupReady() == true)) {
            return;
        }

        CMUIX_MutatorPoolHooked = false;
    }

    CMUIX_StartupInitializeData();
    if ((CMUIX_IsControlValid(libCMUI_gv_difficultyPanel) == true)) {
        DialogControlHookup(libCMUI_gv_difficultyPanel, c_triggerControlTypeButton, "MutatorPoolButton");
        CMUIX_MutatorPoolModeOpenButton = DialogControlLastCreated();
    }

    CMUIX_MutatorPoolHostPanel = c_invalidDialogControlId;
    if ((CMUIX_IsControlValid(libCMUI_gv_screenNavigationMain) == true)) {
        DialogControlHookup(libCMUI_gv_screenNavigationMain, c_triggerControlTypePanel, "CustomMutatorPoolPanel");
        CMUIX_MutatorPoolHostPanel = DialogControlLastCreated();
    }

    if ((CMUIX_IsControlValid(CMUIX_MutatorPoolHostPanel) == true)) {
        CMUIX_MutatorPoolHookupPage("MutatorPoolPage");
    }
    else {
        if ((CMUIX_IsControlValid(libCOUI_gv_cU_CustomMutatorPanel) == false)) {
            return;
        }

        CMUIX_MutatorPoolHostPanel = libCOUI_gv_cU_CustomMutatorPanel;
        CMUIX_MutatorPoolHookupPage("CM_CustomMutatorPool");
    }

    if ((CMUIX_MutatorPoolHookupReady() == false)) {
        return;
    }

    CMUIX_MutatorPoolHooked = true;
    CMUIX_MutatorPoolRefreshAll();
    CMUIX_MutatorPoolRefreshOpenButtons();
}

void CMUIX_MutatorPoolSetOpenButtonForP1(int lp_control, bool lp_visible) {
    playergroup lv_allPlayers;
    playergroup lv_playerOne;

    lv_allPlayers = PlayerGroupAll();
    lv_playerOne = PlayerGroupSingle(1);
    CMUIX_SetControlVisible(lp_control, lv_allPlayers, false);
    CMUIX_SetControlEnabled(lp_control, lv_allPlayers, false);
    if ((lp_visible == true)) {
        CMUIX_SetControlVisible(lp_control, lv_playerOne, true);
        CMUIX_SetControlEnabled(lp_control, lv_playerOne, true);
    }
}

void CMUIX_MutatorPoolRefreshOpenButtons() {
    int lv_player;

    lv_player = 1;
    CMUIX_MutatorPoolSetOpenButtonForP1(CMUIX_MutatorPoolStandardOpenButton, false);
    CMUIX_MutatorPoolSetOpenButtonForP1(CMUIX_MutatorPoolCustomOpenButton, false);
    if ((CMUIX_ProfileSharedConfigLocked() == true)) {
        CMUIX_MutatorPoolSetOpenButtonForP1(CMUIX_MutatorPoolModeOpenButton, true);
        CMUIX_SetControlEnabled(CMUIX_MutatorPoolModeOpenButton, PlayerGroupSingle(1), false);
        while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
            CMUIX_MutatorPoolPageOpen[lv_player] = false;
            lv_player += 1;
        }

        if ((CMUIX_IsControlValid(CMUIX_MutatorPoolPage[1]) == true)) {
            DialogControlSendAnimationEvent(CMUIX_MutatorPoolPage[1], PlayerGroupAll(), "Hide");
        }

        return;
    }

    CMUIX_MutatorPoolSetOpenButtonForP1(CMUIX_MutatorPoolModeOpenButton, true);
}

int CMUIX_MutatorPoolDefaultPoolForCurrentMode() {
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        return CMUIX_MUTATOR_POOL_CYCLE;
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        return CMUIX_MUTATOR_POOL_RANDOM;
    }

    return CMUIX_MUTATOR_POOL_BRUTAL_PLUS;
}

bool CMUIX_MutatorPoolHandleControlEvent(int lp_player, int lp_control) {
    int lv_view;
    int lv_slot;
    int lv_pool;
    string lv_mutator;

    lv_view = CMUIX_MutatorPoolCurrentView;
    lv_slot = 1;
    lv_pool = 0;
    lv_mutator = "";
    if ((CMUIX_MutatorPoolRefreshing == true)) {
        return false;
    }

    if ((CMUIX_MutatorPoolHooked == false)) {
        return false;
    }

    if ((CMUIX_ProfileSharedConfigLocked() == true)) {
        return true;
    }

    if ((lv_view < 1) || (lv_view > CMUIX_MUTATOR_POOL_VIEW_MAX)) {
        lv_view = 1;
    }

    if ((lp_control == CMUIX_MutatorPoolModeOpenButton)) {
        CMUIX_MutatorPoolOpenTemporary(lp_player, CMUIX_MutatorPoolDefaultPoolForCurrentMode());
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolPulldown[1])) {
        lv_pool = CMUIX_MutatorPoolClampPool(DialogControlGetSelectedItem(lp_control, lp_player));
        CMUIX_MutatorPoolShowView(CMUIX_MutatorPoolViewForPool(lv_pool), lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolSearchBoxes[1])) {
        CMUIX_MutatorPoolSearchText[lv_view] = libNtve_gf_DialogItemEditValue(lp_control, lp_player);
        CMUIX_MutatorPoolApplySearchFilter(lv_view, lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolSearchClearButtons[1])) {
        if ((CMUIX_IsControlValid(CMUIX_MutatorPoolSearchBoxes[1]) == true)) {
            libNtve_gf_SetDialogItemEditorValue(CMUIX_MutatorPoolSearchBoxes[1], "", PlayerGroupAll());
        }

        CMUIX_MutatorPoolSearchText[lv_view] = "";
        CMUIX_MutatorPoolApplySearchFilter(lv_view, lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolResetButton[1])) {
        CMUIX_MutatorPoolResetCurrent(lv_view);
        CMUIX_MutatorPoolRefreshView(lv_view, lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolPrevPageButton)) {
        CMUIX_MutatorPoolPageIndex[lv_view] -= 1;
        CMUIX_MutatorPoolClampCurrentPage(lv_view);
        CMUIX_MutatorPoolRefreshView(lv_view, lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolNextPageButton)) {
        CMUIX_MutatorPoolPageIndex[lv_view] += 1;
        CMUIX_MutatorPoolClampCurrentPage(lv_view);
        CMUIX_MutatorPoolRefreshView(lv_view, lp_player);
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolAcceptButton[1])) {
        CMUIX_MutatorPoolApplyDraftToUserData();
        CMUIX_PlayerProfileSaveMutatorPoolsFromUserData(CMUIX_PlayerProfileMutatorPoolBankPlayer());
        CMUIX_MutatorPoolLoadDraftFromUserData();
        CMUIX_MutatorPoolRefreshAll();
        CMUIX_MutatorPoolPageOpen[lp_player] = false;
        DialogControlSendAnimationEvent(CMUIX_MutatorPoolPage[1], PlayerGroupSingle(lp_player), "Hide");
        return true;
    }

    if ((lp_control == CMUIX_MutatorPoolCancelButton[1])) {
        CMUIX_MutatorPoolLoadDraftFromUserData();
        CMUIX_MutatorPoolRefreshAll();
        CMUIX_MutatorPoolPageOpen[lp_player] = false;
        DialogControlSendAnimationEvent(CMUIX_MutatorPoolPage[1], PlayerGroupSingle(lp_player), "Hide");
        return true;
    }

    lv_view = CMUIX_MutatorPoolCurrentView;
    lv_slot = 1;
    while ((lv_slot <= CMUIX_MUTATOR_POOL_ROW_MAX)) {
        lv_mutator = CMUIX_MutatorPoolItemMutators[lv_view][lv_slot];
        if ((lv_mutator != "")) {
            lv_pool = CMUIX_MutatorPoolPoolForView(lv_view);
            if ((lp_control == CMUIX_MutatorPoolActiveChecks[lv_view][lv_slot])) {
                CMUIX_MutatorPoolSetNormalValue(lv_pool, lv_mutator, libNtve_gf_DialogItemIsChecked(lp_control, lp_player));
                return true;
            }

            if ((lp_control == CMUIX_MutatorPoolFirstChecks[lv_view][lv_slot])) {
                CMUIX_MutatorPoolSetFirstValue(lv_mutator, libNtve_gf_DialogItemIsChecked(lp_control, lp_player));
                return true;
            }

            if ((lp_control == CMUIX_MutatorPoolEnhanceButtons[lv_view][lv_slot])) {
                CMUIX_MutatorPoolSetEnhanceValue(lv_pool, lv_mutator, libNtve_gf_DialogItemIsChecked(lp_control, lp_player));
                if ((CMUIX_IsControlValid(CMUIX_MutatorPoolIconBoxes[lv_view][lv_slot]) == true)) {
                    DialogControlSetAnimationState(CMUIX_MutatorPoolIconBoxes[lv_view][lv_slot], PlayerGroupAll(), "SourceState", CMUIX_MutatorPoolSourceState(lv_pool, lv_mutator));
                }

                return true;
            }
        }

        lv_slot += 1;
    }

    return false;
}

void CMUIX_MutatorPoolOpenTemporary(int lp_player, int lp_pool) {
    int lv_view;
    int lv_pool;

    lv_view = 1;
    lv_pool = CMUIX_MutatorPoolClampPool(lp_pool);
    lv_view = CMUIX_MutatorPoolViewForPool(lv_pool);
    if ((CMUIX_ProfileSharedConfigLocked() == true)) {
        return;
    }

    CMUIX_StartupInitializeData();
    if ((CMUIX_MutatorPoolHooked == false)) {
        CMUIX_MutatorPoolHookup();
    }

    if ((CMUIX_MutatorPoolHooked == false)) {
        return;
    }

    CMUIX_MutatorPoolEnsureDraft();
    CMUIX_MutatorPoolShowView(lv_view, lp_player);
}

string CMUIX_ProfileCommandPayload(string lp_message) {
    int lv_start;
    int lv_length;
    string lv_firstWord;

    lv_start = 0;
    lv_length = StringLength(lp_message);
    lv_firstWord = StringWord(lp_message, 1);
    if ((lv_firstWord == "") || (lv_firstWord == null)) {
        return "";
    }

    lv_start = StringLength(lv_firstWord) + 2;
    if ((lv_start > lv_length)) {
        return "";
    }

    return StringSub(lp_message, lv_start, lv_length);
}

bool CMUIX_ProfileChecksumValid(string lp_payload) {
    string lv_body;

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lp_payload);
    if ((CMUIX_ProfilePayloadIsCompact(lv_body) == true)) {
        lv_body = CMUIX_ProfileCompactExpandBody(lv_body);
    }

    if ((CMUIX_ProfilePayloadCertified(lp_payload) == false)) {
        CMUIX_ProfileCertified = false;
        CMUIX_ProfileChecksumValue = 0;
        return false;
    }

    CMUIX_ProfileCertified = true;
    CMUIX_ProfileChecksumValue = CMUIX_ProfileChecksumForBody(lv_body);
    return true;
}

void CMUIX_ProfileClearAcceptedMutators() {
    int lv_index;
    int lv_slot;

    lv_index = 0;
    lv_slot = 1;
    CMUIX_CustomMutatorPickerAcceptedCount = 0;
    while ((lv_index <= CMUIX_CUSTOM_MUTATOR_PICKER_ITEM_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_index] = 0;
        lv_index += 1;
    }

    while ((lv_slot <= CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        CMUIX_CustomMutatorPickerAcceptedMutators[lv_slot] = "";
        CMUIX_CustomMutatorPickerAcceptedEnhanced[lv_slot] = 0;
        lv_slot += 1;
    }
}

bool CMUIX_ProfileApplyMutatorToken(string lp_token) {
    int lv_mutatorIndex;
    int lv_length;
    bool lv_enhanced;
    string lv_mutator;

    lv_mutatorIndex = 0;
    lv_length = 0;
    lv_enhanced = false;
    lv_mutator = StringReplaceWord(lp_token, " ", "", c_stringReplaceAll, c_stringNoCase);
    if ((lv_mutator == "") || (lv_mutator == null)) {
        return false;
    }

    lv_length = StringLength(lv_mutator);
    if ((lv_length >= 2) && (StringSub(lv_mutator, lv_length, lv_length) == "+")) {
        lv_enhanced = true;
        lv_mutator = StringSub(lv_mutator, 1, (lv_length - 1));
    }

    lv_mutatorIndex = CMUIX_MutatorPoolIndexForMutator(lv_mutator);
    if ((lv_mutatorIndex <= 0)) {
        return false;
    }

    if ((CMUIX_CustomMutatorPickerAcceptedAppend(lv_mutator) == false)) {
        return false;
    }

    if ((lv_enhanced == true) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == true)) {
        CMUIX_CustomMutatorPickerAcceptedEnhanceMarks[lv_mutatorIndex] = 1;
        CMUIX_CustomMutatorPickerAcceptedEnhanced[CMUIX_CustomMutatorPickerAcceptedCount] = 1;
    }

    return true;
}

int CMUIX_ProfileApplyMutatorList(string lp_list) {
    int lv_separator;
    int lv_added;
    string lv_remaining;
    string lv_token;

    lv_separator = 0;
    lv_added = 0;
    lv_remaining = lp_list;
    lv_token = "";
    CMUIX_ProfileClearAcceptedMutators();
    while ((lv_remaining != "") && (CMUIX_CustomMutatorPickerAcceptedCount < CMUIX_CUSTOM_MUTATOR_PICKER_SELECTED_MAX)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        if ((CMUIX_ProfileApplyMutatorToken(lv_token) == true)) {
            lv_added += 1;
        }
    }

    CMUIX_CustomMutatorPickerCopyAcceptedToDraft();
    CMUIX_CustomMutatorPickerApplyAcceptedToUserData();
    return lv_added;
}

bool CMUIX_ProfileCoopMapInstanceExists(string lp_mapInstance) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount("CoopMaps");
    if ((lp_mapInstance == "") || (lp_mapInstance == null)) {
        return false;
    }

    while ((lv_index <= lv_count)) {
        if ((UserDataInstance("CoopMaps", lv_index) == lp_mapInstance)) {
            return true;
        }

        lv_index += 1;
    }

    return false;
}

string CMUIX_ProfileRequestedMapInstance(string lp_payload) {
    string lv_map;
    string lv_mapInstance;

    lv_map = CMUIX_ProfileConfigValue(lp_payload, "mission");
    lv_mapInstance = "";
    if ((lv_map == "")) {
        lv_map = CMUIX_ProfileConfigValue(lp_payload, "map");
    }

    if ((lv_map == "") || (lv_map == null)) {
        return "";
    }

    lv_mapInstance = lv_map;
    if ((CMUIX_ProfileCoopMapInstanceExists(lv_mapInstance) == false)) {
        lv_mapInstance = CMUIX_MapSelectionInstanceForMapLink(lv_map);
    }

    return lv_mapInstance;
}

bool CMUIX_ProfileRequestedMapUsableForSharedSetup(string lp_payload) {
    string lv_requestedMapInstance;

    lv_requestedMapInstance = CMUIX_ProfileRequestedMapInstance(lp_payload);
    if ((lv_requestedMapInstance == "") || (lv_requestedMapInstance == null)) {
        return false;
    }

    if ((CMUIX_ProfileCoopMapInstanceExists(lv_requestedMapInstance) == false)) {
        return false;
    }

    if ((CMUIX_MapSelectionMapShouldShowForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_requestedMapInstance) == false)) {
        return false;
    }

    return true;
}

bool CMUIX_ProfilePayloadIsCompact(string lp_payload) {
    if ((lp_payload == "") || (lp_payload == null)) {
        return false;
    }

    if ((StringLength(lp_payload) < StringLength(CMUIX_PROFILE_COMPACT_PREFIX))) {
        return false;
    }

    return (StringSub(lp_payload, 1, StringLength(CMUIX_PROFILE_COMPACT_PREFIX)) == CMUIX_PROFILE_COMPACT_PREFIX);
}

bool CMUIX_ProfileVersionSupported(string lp_body) {
    int lv_version;
    string lv_value;

    lv_version = 0;
    lv_value = CMUIX_ProfileConfigValue(lp_body, "version");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "profileVersion");
    }

    if ((lv_value == "")) {
        return true;
    }

    lv_version = StringToInt(lv_value);
    if ((IntToString(lv_version) != lv_value)) {
        return false;
    }

    return ((lv_version >= 0) && (lv_version <= CMUIX_PROFILE_FORMAT_VERSION));
}

string CMUIX_ProfileCompactBodyWithoutPrefix(string lp_payload) {
    int lv_start;
    int lv_length;

    lv_start = StringLength(CMUIX_PROFILE_COMPACT_PREFIX) + 1;
    lv_length = StringLength(lp_payload);
    if ((lv_length < lv_start)) {
        return "";
    }

    return StringSub(lp_payload, lv_start, lv_length);
}

string CMUIX_ProfileAppendConfig(string lp_body, string lp_key, string lp_value) {
    if ((lp_key == "") || (lp_key == null) || (lp_value == "") || (lp_value == null)) {
        return lp_body;
    }

    if ((lp_body == "") || (lp_body == null)) {
        return (lp_key + "=" + lp_value);
    }

    return (lp_body + ";" + lp_key + "=" + lp_value);
}

string CMUIX_ProfileSetConfigValue(string lp_body, string lp_key, string lp_value) {
    int lv_separator;
    int lv_prefixLength;
    string lv_remaining;
    string lv_token;
    string lv_prefix;
    string lv_result;
    bool lv_replaced;

    lv_separator = 0;
    lv_prefixLength = 0;
    lv_remaining = lp_body;
    lv_token = "";
    lv_prefix = (lp_key + "=");
    lv_result = "";
    lv_replaced = false;
    if ((lp_key == "") || (lp_key == null) || (lp_value == "") || (lp_value == null)) {
        return lp_body;
    }

    lv_prefixLength = StringLength(lv_prefix);
    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ";", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        if ((StringLength(lv_token) >= lv_prefixLength) && (StringEqual(StringSub(lv_token, 1, lv_prefixLength), lv_prefix, c_stringNoCase) == true)) {
            lv_token = (lp_key + "=" + lp_value);
            lv_replaced = true;
        }

        if ((lv_token != "")) {
            if ((lv_result != "")) {
                lv_result = (lv_result + ";");
            }

            lv_result = (lv_result + lv_token);
        }
    }

    if ((lv_replaced == false)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, lp_key, lp_value);
    }

    return lv_result;
}

string CMUIX_ProfileAppendCommaToken(string lp_body, string lp_token) {
    if ((lp_token == "") || (lp_token == null)) {
        return lp_body;
    }

    if ((lp_body == "") || (lp_body == null)) {
        return lp_token;
    }

    return (lp_body + "," + lp_token);
}

int CMUIX_ProfileMutatorVariantCountInList(string lp_list, string lp_mutator, bool lp_enhanced) {
    int lv_separator;
    int lv_count;
    int lv_length;
    bool lv_tokenEnhanced;
    string lv_remaining;
    string lv_token;

    lv_separator = 0;
    lv_count = 0;
    lv_length = 0;
    lv_tokenEnhanced = false;
    lv_remaining = lp_list;
    lv_token = "";
    if ((lp_list == "") || (lp_list == null) || (lp_mutator == "") || (lp_mutator == null)) {
        return 0;
    }

    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_token = StringReplaceWord(lv_token, " ", "", c_stringReplaceAll, c_stringNoCase);
        lv_tokenEnhanced = false;
        lv_length = StringLength(lv_token);
        if ((lv_length >= 2) && (StringSub(lv_token, lv_length, lv_length) == "+")) {
            lv_tokenEnhanced = true;
            lv_token = StringSub(lv_token, 1, (lv_length - 1));
        }

        if ((lv_token == lp_mutator) && (lv_tokenEnhanced == lp_enhanced)) {
            lv_count += 1;
        }
    }

    return lv_count;
}

string CMUIX_ProfileMutatorChallengeListFromBody(string lp_body) {
    int lv_index;
    int lv_mode;
    bool lv_enhanced;
    string lv_result;
    string lv_type;
    string lv_challenge;
    string lv_mutator;

    lv_index = 1;
    lv_mode = CMUIX_LaunchProfileModeIndex(CMUIX_ProfileConfigValue(lp_body, "mode"));
    lv_enhanced = false;
    lv_result = "";
    lv_type = CMUIX_ProfileConfigValue(lp_body, "challengeType");
    lv_challenge = CMUIX_ProfileConfigValue(lp_body, "challenge");
    lv_mutator = "";
    if ((lv_mode != CMUIX_MODE_MUTATOR) && (lv_challenge == "")) {
        return "";
    }

    if ((lv_type == "")) {
        lv_type = CMUIX_MutatorChallenge_Type_Official;
    }

    lv_type = CMUIX_MutatorChallengeNormalizeType(lv_type);
    lv_challenge = CMUIX_MutatorChallengeNormalizeSelection(lv_type, lv_challenge);
    if ((lv_challenge == "") || (CMUIX_MutatorChallengeIsRandom(lv_challenge) == true)) {
        return "";
    }

    while ((lv_index <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        lv_mutator = CMUIX_MutatorChallengeMutatorAt(lv_type, lv_challenge, lv_index);
        if ((lv_mutator != "")) {
            lv_enhanced = CMUIX_MutatorChallengeMutatorEnhancedAt(lv_type, lv_challenge, lv_index, lv_mutator);
            if ((lv_enhanced == true)) {
                lv_result = CMUIX_ProfileAppendCommaToken(lv_result, (lv_mutator + "+"));
            }
            else {
                lv_result = CMUIX_ProfileAppendCommaToken(lv_result, lv_mutator);
            }
        }

        lv_index += 1;
    }

    return lv_result;
}

string CMUIX_ProfileCanonicalMutatorsFromBody(string lp_body) {
    int lv_index;
    int lv_count;
    int lv_variantCount;
    string lv_mutator;
    string lv_mutators;
    string lv_result;

    lv_index = 1;
    lv_count = UserDataInstanceCount("Mutators");
    lv_variantCount = 0;
    lv_mutator = "";
    lv_mutators = CMUIX_ProfileConfigValue(lp_body, "mutators");
    lv_result = "";
    if ((lv_mutators == "")) {
        lv_mutators = CMUIX_ProfileConfigValue(lp_body, "factors");
    }

    if ((lv_mutators == "")) {
        lv_mutators = CMUIX_ProfileMutatorChallengeListFromBody(lp_body);
    }

    while ((lv_index <= lv_count)) {
        lv_mutator = UserDataInstance("Mutators", lv_index);
        if ((lv_mutator != "")) {
            lv_variantCount = CMUIX_ProfileMutatorVariantCountInList(lv_mutators, lv_mutator, false);
            while ((lv_variantCount > 0)) {
                lv_result = CMUIX_ProfileAppendCommaToken(lv_result, lv_mutator);
                lv_variantCount -= 1;
            }

            lv_variantCount = CMUIX_ProfileMutatorVariantCountInList(lv_mutators, lv_mutator, true);
            while ((lv_variantCount > 0)) {
                lv_result = CMUIX_ProfileAppendCommaToken(lv_result, (lv_mutator + "+"));
                lv_variantCount -= 1;
            }
        }

        lv_index += 1;
    }

    return lv_result;
}

string CMUIX_ProfileChecksumMaterialForBody(string lp_body, bool lp_includeResult) {
    string lv_map;
    string lv_enemy;
    string lv_mastery;
    string lv_mutators;
    string lv_result;
    string lv_attempts;
    string lv_source;
    string lv_profileChecksum;
    string lv_value;
    int lv_index;
    int lv_count;

    lv_map = CMUIX_ProfileRequestedMapInstance(lp_body);
    lv_enemy = CMUIX_ProfileConfigValue(lp_body, "enemy");
    lv_mastery = CMUIX_ProfileConfigValue(lp_body, "mastery");
    lv_mutators = CMUIX_ProfileCanonicalMutatorsFromBody(lp_body);
    lv_result = "";
    lv_attempts = "";
    lv_source = "";
    lv_profileChecksum = "";
    lv_value = "";
    lv_index = 1;
    lv_count = 0;
    if ((lv_mastery == "")) {
        lv_mastery = CMUIX_ProfileConfigValue(lp_body, "masterycap");
    }

    lv_result = ("map=" + lv_map + ";enemy=" + lv_enemy + ";mastery=" + lv_mastery + ";mutators=" + lv_mutators);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommanders");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommander");
    }

    if ((lv_value != "")) {
        lv_result += (";disabledCommanders=" + lv_value);
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestiges");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestige");
    }

    if ((lv_value != "")) {
        lv_result += (";disabledPrestiges=" + lv_value);
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAI");
    }

    if ((lv_value != "")) {
        lv_result += (";disabledAIs=" + lv_value);
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAI");
    }

    if ((lv_value != "")) {
        lv_result += (";allowedAIs=" + lv_value);
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "seed");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "randomSeed");
    }

    if ((lv_value != "")) {
        lv_result += (";seed=" + lv_value);
    }

    if ((lp_includeResult == true)) {
        lv_attempts = CMUIX_ProfileConfigValue(lp_body, "attempts");
        if ((lv_attempts == "")) {
            lv_attempts = CMUIX_ProfileConfigValue(lp_body, "attempt");
        }

        lv_source = CMUIX_ProfileConfigValue(lp_body, "source");
        if ((lv_source == "")) {
            lv_source = CMUIX_ProfileConfigValue(lp_body, "launchSource");
        }

        lv_profileChecksum = CMUIX_ProfileConfigValue(lp_body, "profileChecksum");
        lv_result += (";source=" + lv_source + ";profileChecksum=" + lv_profileChecksum + ";result=" + CMUIX_ProfileConfigValue(lp_body, "result") + ";attempts=" + lv_attempts);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Commander");
        lv_result += (";p1Commander=" + lv_value);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Mastery");
        lv_result += (";p1Mastery=" + lv_value);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Prestige");
        lv_result += (";p1Prestige=" + lv_value);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Commander");
        lv_result += (";p2Commander=" + lv_value);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Mastery");
        lv_result += (";p2Mastery=" + lv_value);
        lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Prestige");
        lv_result += (";p2Prestige=" + lv_value);
        lv_count = StringToInt(CMUIX_ProfileConfigValue(lp_body, "objectiveCount"));
        if ((lv_count > 0)) {
            lv_result += (";objectiveCount=" + IntToString(lv_count));
            lv_index = 1;
            while ((lv_index <= lv_count) && (lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
                lv_value = CMUIX_ProfileConfigValue(lp_body, ("objective" + IntToString(lv_index)));
                lv_result += (";objective" + IntToString(lv_index) + "=" + lv_value);
                lv_index += 1;
            }
        }
    }

    return lv_result;
}

int CMUIX_ProfileChecksumForBody(string lp_body) {
    return CMUIX_ProfileChecksum(CMUIX_ProfileChecksumMaterialForBody(lp_body, false));
}

int CMUIX_ProfileResultChecksumForBody(string lp_body) {
    return CMUIX_ProfileChecksum(CMUIX_ProfileChecksumMaterialForBody(lp_body, true));
}

int CMUIX_HistoryRecordIntegrityForPayload(string lp_payload) {
    string lv_payload;
    string lv_body;
    string lv_code;
    int lv_result;

    lv_payload = "";
    lv_body = "";
    lv_code = "";
    lv_result = CMUIX_HISTORY_INTEGRITY_INVALID;

    lv_code = CMUIX_ProfileConfigValue(lp_payload, "resultCode");
    if ((StringLength(lv_code) == 0)) {
        lv_code = CMUIX_ProfileConfigValue(lp_payload, "matchCode");
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lp_payload);
    if ((StringLength(lv_payload) > 0)) {
        if ((StringLength(lv_code) == 0)) {
            lv_result = CMUIX_HISTORY_INTEGRITY_PENDING;
        }

        if ((StringLength(lv_code) > 0)) {
            lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
            if ((CMUIX_ProfilePayloadIsCompact(lv_body) == true)) {
                lv_body = CMUIX_ProfileCompactExpandBody(lv_body);
            }

            if ((StringLength(lv_body) > 0)) {
                if ((StringToInt(lv_code) != CMUIX_ProfileResultChecksumForBody(lv_body))) {
                    lv_result = CMUIX_HISTORY_INTEGRITY_TAMPERED;
                }
                else {
                    lv_result = CMUIX_HISTORY_INTEGRITY_VALID;
                }
            }
        }
    }

    return lv_result;
}

bool CMUIX_HistoryRecordIsProfileSource(string lp_payload) {
    string lv_payload;
    string lv_body;
    string lv_source;
    string lv_profile;

    lv_payload = CMUIX_ProfileNormalizePayload(lp_payload);
    if ((lv_payload == "")) {
        return false;
    }

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
    if ((CMUIX_ProfilePayloadIsCompact(lv_body) == true)) {
        lv_body = CMUIX_ProfileCompactExpandBody(lv_body);
    }

    lv_source = CMUIX_ProfileConfigValue(lv_body, "source");
    lv_profile = CMUIX_ProfileConfigValue(lv_body, "profile");
    if ((lv_source == "Profile") || (lv_profile == "1") || (CMUIX_ProfileConfigValue(lv_body, "profileChecksum") != "")) {
        return true;
    }

    return false;
}

string CMUIX_ProfileCompactEncodeInt(int lp_value) {
    string lv_result;
    string lv_digit;
    int lv_value;
    int lv_digitIndex;
    int lv_base;

    lv_result = "";
    lv_digit = "";
    lv_value = lp_value;
    lv_digitIndex = 0;
    lv_base = StringLength(CMUIX_PROFILE_COMPACT_ALPHABET);
    if ((lv_value <= 0)) {
        return "0";
    }

    while ((lv_value > 0)) {
        lv_digitIndex = ModI(lv_value, lv_base);
        lv_digit = StringSub(CMUIX_PROFILE_COMPACT_ALPHABET, (lv_digitIndex + 1), (lv_digitIndex + 1));
        lv_result = lv_digit + lv_result;
        lv_value = lv_value / lv_base;
    }

    return lv_result;
}

int CMUIX_ProfileCompactDecodeInt(string lp_value) {
    string lv_char;
    int lv_index;
    int lv_length;
    int lv_position;
    int lv_result;
    int lv_base;

    lv_char = "";
    lv_index = 1;
    lv_length = StringLength(lp_value);
    lv_position = 0;
    lv_result = 0;
    lv_base = StringLength(CMUIX_PROFILE_COMPACT_ALPHABET);
    if ((lp_value == "") || (lp_value == null)) {
        return -1;
    }

    while ((lv_index <= lv_length)) {
        lv_char = StringSub(lp_value, lv_index, lv_index);
        lv_position = StringFind(CMUIX_PROFILE_COMPACT_ALPHABET, lv_char, c_stringCase);
        if ((lv_position < 1)) {
            return -1;
        }

        lv_result = (lv_result * lv_base) + (lv_position - 1);
        lv_index += 1;
    }

    return lv_result;
}

int CMUIX_ProfileUserDataInstanceIndex(string lp_type, string lp_instance) {
    int lv_index;
    int lv_count;

    lv_index = 1;
    lv_count = UserDataInstanceCount(lp_type);
    if ((lp_type == "") || (lp_type == null) || (lp_instance == "") || (lp_instance == null)) {
        return 0;
    }

    while ((lv_index <= lv_count)) {
        if ((UserDataInstance(lp_type, lv_index) == lp_instance)) {
            return lv_index;
        }

        lv_index += 1;
    }

    return 0;
}

string CMUIX_ProfileUserDataInstanceFromCompact(string lp_type, string lp_value) {
    int lv_index;
    int lv_count;

    lv_index = CMUIX_ProfileCompactDecodeInt(lp_value);
    lv_count = UserDataInstanceCount(lp_type);
    if ((lp_type == "") || (lp_type == null) || (lv_index < 1) || (lv_index > lv_count)) {
        return "";
    }

    return UserDataInstance(lp_type, lv_index);
}

string CMUIX_ProfileCompactEncodeMutatorToken(string lp_token) {
    string lv_mutator;
    string lv_result;
    int lv_length;
    int lv_index;
    bool lv_enhanced;

    lv_mutator = StringReplaceWord(lp_token, " ", "", c_stringReplaceAll, c_stringNoCase);
    lv_result = "";
    lv_length = StringLength(lv_mutator);
    lv_index = 0;
    lv_enhanced = false;
    if ((lv_mutator == "") || (lv_mutator == null)) {
        return "";
    }

    if ((lv_length >= 2) && (StringSub(lv_mutator, lv_length, lv_length) == "+")) {
        lv_enhanced = true;
        lv_mutator = StringSub(lv_mutator, 1, (lv_length - 1));
    }

    lv_index = CMUIX_ProfileUserDataInstanceIndex("Mutators", lv_mutator);
    if ((lv_index <= 0)) {
        return "";
    }

    lv_result = CMUIX_ProfileCompactEncodeInt(lv_index);
    if ((lv_enhanced == true)) {
        lv_result += "+";
    }

    return lv_result;
}

string CMUIX_ProfileCompactEncodeMutatorList(string lp_list) {
    string lv_remaining;
    string lv_token;
    string lv_encoded;
    string lv_result;
    int lv_separator;

    lv_remaining = lp_list;
    lv_token = "";
    lv_encoded = "";
    lv_result = "";
    lv_separator = 0;
    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_encoded = CMUIX_ProfileCompactEncodeMutatorToken(lv_token);
        if ((lv_encoded != "")) {
            if ((lv_result != "")) {
                lv_result += ".";
            }

            lv_result += lv_encoded;
        }
    }

    return lv_result;
}

string CMUIX_ProfileCompactDecodeMutatorToken(string lp_token) {
    string lv_value;
    string lv_mutator;
    int lv_length;
    bool lv_enhanced;

    lv_value = lp_token;
    lv_mutator = "";
    lv_length = StringLength(lv_value);
    lv_enhanced = false;
    if ((lv_value == "") || (lv_value == null)) {
        return "";
    }

    if ((lv_length >= 2) && (StringSub(lv_value, lv_length, lv_length) == "+")) {
        lv_enhanced = true;
        lv_value = StringSub(lv_value, 1, (lv_length - 1));
    }

    lv_mutator = CMUIX_ProfileUserDataInstanceFromCompact("Mutators", lv_value);
    if ((lv_mutator == "")) {
        return "";
    }

    if ((lv_enhanced == true)) {
        return (lv_mutator + "+");
    }

    return lv_mutator;
}

string CMUIX_ProfileCompactDecodeMutatorList(string lp_list) {
    string lv_remaining;
    string lv_token;
    string lv_decoded;
    string lv_result;
    int lv_separator;

    lv_remaining = lp_list;
    lv_token = "";
    lv_decoded = "";
    lv_result = "";
    lv_separator = 0;
    while ((lv_remaining != "") && (lv_remaining != null)) {
        lv_separator = StringFind(lv_remaining, ".", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_decoded = CMUIX_ProfileCompactDecodeMutatorToken(lv_token);
        if ((lv_decoded != "")) {
            if ((lv_result != "")) {
                lv_result += ",";
            }

            lv_result += lv_decoded;
        }
    }

    return lv_result;
}

string CMUIX_ProfileCompactBody(string lp_body) {
    string lv_result;
    string lv_value;
    string lv_mapInstance;
    string lv_mutators;
    int lv_index;
    int lv_count;

    lv_result = "";
    lv_value = CMUIX_ProfileConfigValue(lp_body, "name");
    lv_mapInstance = "";
    lv_mutators = "";
    lv_index = 0;
    lv_count = 0;
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "challenge");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "vr", CMUIX_ProfileCompactEncodeInt(CMUIX_PROFILE_FORMAT_VERSION));
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "n", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "mode");
    if ((lv_value != "")) {
        lv_index = CMUIX_LaunchProfileModeIndex(lv_value);
        if ((lv_index == CMUIX_MODE_MUTATOR)) {
            lv_result = CMUIX_ProfileAppendConfig(lv_result, "g", "M");
        }
        else {
            if ((lv_index == CMUIX_MODE_CUSTOM)) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "g", "C");
            }
            else {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "g", "S");
            }
        }
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "challengeType");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "q", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "challenge");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "c", lv_value);
    lv_mapInstance = CMUIX_ProfileRequestedMapInstance(lp_body);
    lv_index = CMUIX_ProfileUserDataInstanceIndex("CoopMaps", lv_mapInstance);
    if ((lv_index > 0)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "m", CMUIX_ProfileCompactEncodeInt(lv_index));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "enemy");
    lv_index = CMUIX_ProfileUserDataInstanceIndex("CoopAICommanders", lv_value);
    if ((lv_index > 0)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "e", CMUIX_ProfileCompactEncodeInt(lv_index));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "base");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "difficulty");
    }

    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "b", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "plus");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "p", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "mastery");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "masterycap");
    }

    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "y", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "history");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "h", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "source");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "launchSource");
    }

    if ((lv_value == "Profile")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "s", "P");
    }
    else {
        if ((lv_value == "History")) {
            lv_result = CMUIX_ProfileAppendConfig(lv_result, "s", "H");
        }
        else {
            if ((lv_value == "Manual")) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "s", "M");
            }
            else {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "s", lv_value);
            }
        }
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimization");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimizations");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "z", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommanders");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommander");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "dc", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestiges");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestige");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "dp", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAI");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "da", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAI");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "aa", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "seed");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "randomSeed");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "rs", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "time");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "t", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "result");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "r", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "attempts");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "a", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_mutators = CMUIX_ProfileConfigValue(lp_body, "mutators");
    if ((lv_mutators == "")) {
        lv_mutators = CMUIX_ProfileConfigValue(lp_body, "factors");
    }

    lv_mutators = CMUIX_ProfileCompactEncodeMutatorList(lv_mutators);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "u", lv_mutators);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "profile");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "pf", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "profileName");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "pn", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "profileChecksum");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "px", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "profileCertified");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "pv", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "certified");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "v", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Commander");
    lv_index = CMUIX_ProfileUserDataInstanceIndex("PlayerCommanders", lv_value);
    if ((lv_index > 0)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "1c", CMUIX_ProfileCompactEncodeInt(lv_index));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Prestige");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "1p", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "p1Mastery");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "1y", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Commander");
    lv_index = CMUIX_ProfileUserDataInstanceIndex("PlayerCommanders", lv_value);
    if ((lv_index > 0)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "2c", CMUIX_ProfileCompactEncodeInt(lv_index));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Prestige");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "2p", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "p2Mastery");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "2y", CMUIX_ProfileCompactEncodeInt(StringToInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lp_body, "note");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "o", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "objectiveCount");
    lv_count = StringToInt(lv_value);
    if ((lv_count > 0)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "jc", CMUIX_ProfileCompactEncodeInt(lv_count));
        lv_index = 1;
        while ((lv_index <= lv_count) && (lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
            lv_value = CMUIX_ProfileConfigValue(lp_body, ("objective" + IntToString(lv_index)));
            if ((lv_value != "")) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, ("j" + IntToString(lv_index)), lv_value);
            }

            lv_index += 1;
        }
    }

    return (CMUIX_PROFILE_COMPACT_PREFIX + lv_result);
}

string CMUIX_ProfileCompactPayloadWithChecksum(string lp_body) {
    string lv_body;
    string lv_result;
    string lv_attempts;

    lv_body = CMUIX_ProfileCompactBody(lp_body);
    lv_result = CMUIX_ProfileConfigValue(lp_body, "result");
    lv_attempts = CMUIX_ProfileConfigValue(lp_body, "attempts");
    if ((lv_attempts == "")) {
        lv_attempts = CMUIX_ProfileConfigValue(lp_body, "attempt");
    }

    if ((lv_result != "") || (lv_attempts != "")) {
        return (lv_body + ";v=1;code=" + IntToString(CMUIX_ProfileChecksumForBody(lp_body)) + ";resultCode=" + IntToString(CMUIX_ProfileResultChecksumForBody(lp_body)));
    }

    return (lv_body + ";v=1;code=" + IntToString(CMUIX_ProfileChecksumForBody(lp_body)));
}

bool CMUIX_ProfilePayloadIsGeneratorCommand(string lp_payload) {
    string lv_word;

    lv_word = "";
    if ((lp_payload == "") || (lp_payload == null)) {
        return true;
    }

    lv_word = StringWord(lp_payload, 1);
    if ((StringEqual(lv_word, "gen", c_stringNoCase) == true) ||
        (StringEqual(lv_word, "generate", c_stringNoCase) == true) ||
        (StringEqual(lv_word, "export", c_stringNoCase) == true) ||
        (StringEqual(lv_word, "copy", c_stringNoCase) == true) ||
        (StringEqual(lv_word, "make", c_stringNoCase) == true) ||
        (StringEqual(lv_word, "build", c_stringNoCase) == true)) {
        return true;
    }

    return false;
}

string CMUIX_ProfileGeneratorNameFromPayload(string lp_payload) {
    int lv_length;
    int lv_start;
    string lv_word;
    string lv_name;

    lv_length = 0;
    lv_start = 0;
    lv_word = "";
    lv_name = "Profile";
    if ((lp_payload == "") || (lp_payload == null)) {
        return lv_name;
    }

    lv_length = StringLength(lp_payload);
    lv_word = StringWord(lp_payload, 1);
    lv_start = StringLength(lv_word) + 2;
    if ((lv_start <= lv_length)) {
        lv_name = StringSub(lp_payload, lv_start, lv_length);
    }

    if ((lv_name == "") || (lv_name == null)) {
        lv_name = "Profile";
    }

    return lv_name;
}

string CMUIX_ProfileGeneratorCurrentMap() {
    string lv_map;

    lv_map = "";
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == true)) {
        CMUIX_MapSelectionEnsureSelection();
        lv_map = CMUIX_MapSelectionNormalizeSelection(CMUIX_MapSelectionSelected);
        if ((CMUIX_MapSelectionIsRandom(lv_map) == true)) {
            return "";
        }

        return lv_map;
    }

    lv_map = libCOTF_gv_sELECTED_Mission;
    if ((lv_map == "") || (lv_map == null)) {
        lv_map = CMUIX_MapSelectionCurrentMapInstance();
    }

    return lv_map;
}

string CMUIX_ProfileGeneratorCurrentEnemy() {
    string lv_enemy;

    lv_enemy = CMUIX_EnemySelectionSelected;
    if ((lv_enemy == "") || (lv_enemy == null)) {
        lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    }

    if ((CMUIX_EnemySelectionInstanceExists(lv_enemy) == false)) {
        return "";
    }

    return lv_enemy;
}

string CMUIX_ProfileBuildCurrentBody(string lp_name) {
    int lv_mastery;
    string lv_result;
    string lv_map;
    string lv_enemy;
    string lv_mutators;
    string lv_mode;
    string lv_challengeType;
    string lv_challenge;

    lv_mastery = CMUIX_ProfileMasteryCapCurrent();
    lv_result = "";
    lv_map = CMUIX_ProfileGeneratorCurrentMap();
    lv_enemy = CMUIX_ProfileGeneratorCurrentEnemy();
    lv_mutators = "";
    lv_mode = CMUIX_LaunchProfileModeInstance(CMUIX_CurrentMode);
    lv_challengeType = CMUIX_MutatorChallengeCurrentType;
    lv_challenge = "";
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "version", IntToString(CMUIX_PROFILE_FORMAT_VERSION));
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "name", lp_name);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", lv_mode);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mission", lv_map);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "enemy", lv_enemy);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "base", IntToString(CMUIX_DifficultySelectedBase));
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "plus", IntToString(CMUIX_DifficultySelectedPlus));
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_challenge = CMUIX_MutatorChallengeCurrentSelected();
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "challengeType", lv_challengeType);
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "challenge", lv_challenge);
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        lv_mutators = CMUIX_GameHistoryMutatorsFragment();
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "mutators", lv_mutators);
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) && (CMUIX_DifficultySelectedPlus > 0)) {
        CMUIX_StandardBrutalPlusEnsureRuntime();
        lv_mutators = CMUIX_GameHistoryMutatorsFragment();
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "mutators", lv_mutators);
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "note", "");
    if ((CMUIX_ProfileMasteryCapEnabled == true) || (lv_mastery != CMUIX_DefaultMasteryCap())) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "mastery", IntToString(lv_mastery));
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledCommanders", CMUIX_ProfileDisabledCommanders);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledPrestiges", CMUIX_ProfileDisabledPrestiges);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledAIs", CMUIX_ProfileDisabledAIs);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "allowedAIs", CMUIX_ProfileAllowedAIs);
    if ((CMUIX_ProfileRandomSeedExplicit == true)) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "seed", IntToString(CMUIX_RandomSeed));
    }

    return lv_result;
}

bool CMUIX_ProfileGenerateCurrentForPlayer(int lp_player, string lp_payload) {
    string lv_name;
    string lv_body;
    string lv_payload;
    string lv_command;
    int lv_commandLength;

    lv_name = "";
    lv_body = "";
    lv_payload = "";
    lv_command = "";
    lv_commandLength = 0;
    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        CMUIX_ProfileMessage(lp_player, "Profile 生成只能在启动器使用。");
        return false;
    }

    if ((CMUIX_ReadyCanEditData(lp_player) == false)) {
        CMUIX_ProfileMessage(lp_player, "Profile 生成只能在游戏开始前使用。");
        return false;
    }

    lv_name = CMUIX_ProfileGeneratorNameFromPayload(lp_payload);
    lv_body = CMUIX_ProfileBuildCurrentBody(lv_name);
    lv_payload = CMUIX_ProfileCompactPayloadWithChecksum(lv_body);
    lv_command = (CMUIX_PROFILE_COMMAND_CANONICAL + " " + lv_payload);
    lv_commandLength = StringLength(lv_command);
    CMUIX_ProfileTemplateRecord(lp_player, lv_name, lv_payload, "Generated");
    CMUIX_ProfileClearChatWindow(lp_player);
    CMUIX_ProfileMessage(lp_player, ("Profile 已生成，可复制下一行使用。长度 " + IntToString(lv_commandLength) + "。"));
    CMUIX_ProfileMessage(lp_player, lv_command);
    if ((lv_commandLength > 255)) {
        CMUIX_ProfileMessage(lp_player, "注意：该 Profile 超过聊天输入长度上限，可减少名称或因子数量。");
    }

    return true;
}

string CMUIX_ProfileCompactExpandBody(string lp_compactBody) {
    string lv_compact;
    string lv_result;
    string lv_value;
    string lv_instance;
    int lv_index;
    int lv_count;

    lv_compact = CMUIX_ProfileCompactBodyWithoutPrefix(lp_compactBody);
    lv_result = "";
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "vr");
    lv_index = 0;
    lv_count = 0;
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "version", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "n");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "name", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "g");
    if ((lv_value == "M")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", "MutatorChallenges");
    }
    else {
        if ((lv_value == "C")) {
            lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", "CustomMutators");
        }
        else {
            if ((lv_value == "S")) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", "Standard");
            }
            else {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", lv_value);
            }
        }
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "q");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "challengeType", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "c");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "challenge", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "m");
    lv_instance = CMUIX_ProfileUserDataInstanceFromCompact("CoopMaps", lv_value);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mission", lv_instance);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "e");
    lv_instance = CMUIX_ProfileUserDataInstanceFromCompact("CoopAICommanders", lv_value);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "enemy", lv_instance);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "b");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "base", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "p");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "plus", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "y");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "mastery", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "h");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "history", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "s");
    if ((lv_value == "P")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "source", "Profile");
    }
    else {
        if ((lv_value == "H")) {
            lv_result = CMUIX_ProfileAppendConfig(lv_result, "source", "History");
        }
        else {
            if ((lv_value == "M")) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "source", "Manual");
            }
            else {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, "source", lv_value);
            }
        }
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "z");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "allowOptimization", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "dc");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledCommanders", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "dp");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledPrestiges", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "da");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledAIs", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "aa");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "allowedAIs", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "rs");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "seed", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "t");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "time", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "r");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "result", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "a");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "attempts", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileCompactDecodeMutatorList(CMUIX_ProfileConfigValue(lv_compact, "u"));
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mutators", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "pf");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "profile", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "pn");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "profileName", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "px");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "profileChecksum", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "pv");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "profileCertified", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "v");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "certified", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "1c");
    lv_instance = CMUIX_ProfileUserDataInstanceFromCompact("PlayerCommanders", lv_value);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "p1Commander", lv_instance);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "1p");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "p1Prestige", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "1y");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "p1Mastery", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "2c");
    lv_instance = CMUIX_ProfileUserDataInstanceFromCompact("PlayerCommanders", lv_value);
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "p2Commander", lv_instance);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "2p");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "p2Prestige", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "2y");
    if ((lv_value != "")) {
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "p2Mastery", IntToString(CMUIX_ProfileCompactDecodeInt(lv_value)));
    }

    lv_value = CMUIX_ProfileConfigValue(lv_compact, "o");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "note", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lv_compact, "jc");
    if ((lv_value != "")) {
        lv_count = CMUIX_ProfileCompactDecodeInt(lv_value);
        lv_result = CMUIX_ProfileAppendConfig(lv_result, "objectiveCount", IntToString(lv_count));
        lv_index = 1;
        while ((lv_index <= lv_count) && (lv_index <= libCOOC_gv_cCC_OBJECTIVESMAX)) {
            lv_value = CMUIX_ProfileConfigValue(lv_compact, ("j" + IntToString(lv_index)));
            if ((lv_value != "")) {
                lv_result = CMUIX_ProfileAppendConfig(lv_result, ("objective" + IntToString(lv_index)), lv_value);
            }

            lv_index += 1;
        }
    }

    return lv_result;
}

bool CMUIX_ProfilePayloadCertified(string lp_payload) {
    int lv_expected;
    int lv_actual;
    string lv_body;
    string lv_code;

    lv_expected = 0;
    lv_actual = 0;
    lv_body = "";
    lv_code = CMUIX_ProfileChecksumCodeValue(lp_payload);
    if ((lv_code == "")) {
        return false;
    }

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lp_payload);
    if ((CMUIX_ProfilePayloadIsCompact(lv_body) == true)) {
        lv_body = CMUIX_ProfileCompactExpandBody(lv_body);
    }

    if ((lv_body == "") || (lv_body == null)) {
        return false;
    }

    lv_expected = CMUIX_ProfileChecksumForBody(lv_body);
    lv_actual = StringToInt(lv_code);
    if ((lv_actual != lv_expected)) {
        return false;
    }

    return true;
}

string CMUIX_ProfileNormalizePayload(string lp_payload) {
    string lv_compactBody;
    string lv_expandedBody;
    bool lv_hasChecksum;

    lv_compactBody = "";
    lv_expandedBody = "";
    lv_hasChecksum = CMUIX_ProfilePayloadHasChecksum(lp_payload);
    if ((CMUIX_ProfilePayloadIsCompact(lp_payload) == false)) {
        if ((lv_hasChecksum == true) && (CMUIX_ProfilePayloadCertified(lp_payload) == false)) {
            return "";
        }

        return lp_payload;
    }

    lv_compactBody = CMUIX_ProfilePayloadWithoutChecksum(lp_payload);
    lv_expandedBody = CMUIX_ProfileCompactExpandBody(lv_compactBody);
    if ((lv_expandedBody == "")) {
        return "";
    }

    if ((lv_hasChecksum == false)) {
        return lv_expandedBody;
    }

    if ((CMUIX_ProfilePayloadCertified(lp_payload) == false)) {
        return "";
    }

    return CMUIX_ProfilePayloadWithChecksum(lv_expandedBody);
}

void CMUIX_ProfileClearChatWindow(int lp_player) {
    playergroup lv_players;

    lv_players = PlayerGroupAll();
    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_players = PlayerGroupAll();
    }
    else {
        lv_players = PlayerGroupSingle(lp_player);
    }

    UIClearMessages(lv_players, c_messageAreaChat);
}

bool CMUIX_ProfileCommandAllowedForLauncher(int lp_player, string lp_payload) {
    string lv_requestedMapRaw;

    lv_requestedMapRaw = CMUIX_ProfileConfigValue(lp_payload, "mission");
    if ((lv_requestedMapRaw == "")) {
        lv_requestedMapRaw = CMUIX_ProfileConfigValue(lp_payload, "map");
    }

    if ((CMUIX_MapSelectionCurrentMapIsLauncher() == false)) {
        CMUIX_ProfileMessage(lp_player, "Profile 只能在启动器使用。");
        return false;
    }

    if ((CMUIX_ReadyCanEditData(lp_player) == false)) {
        CMUIX_ProfileMessage(lp_player, "Profile 只能在游戏开始前使用。");
        return false;
    }

    if ((lv_requestedMapRaw == "") || (lv_requestedMapRaw == null)) {
        return true;
    }

    if ((CMUIX_ProfileRequestedMapUsableForSharedSetup(lp_payload) == true)) {
        return true;
    }

    CMUIX_ProfileMessage(lp_player, "Profile 指定的地图无效或当前不可用，未应用配置。");
    return false;
}

void CMUIX_ProfileApplyMapAndEnemy(string lp_payload) {
    string lv_map;
    string lv_mapInstance;
    string lv_enemy;
    string lv_mapLink;

    lv_map = CMUIX_ProfileConfigValue(lp_payload, "mission");
    lv_mapInstance = "";
    lv_enemy = CMUIX_ProfileConfigValue(lp_payload, "enemy");
    lv_mapLink = "";
    if ((lv_map == "")) {
        lv_map = CMUIX_ProfileConfigValue(lp_payload, "map");
    }

    if ((lv_map != "")) {
        lv_mapInstance = lv_map;
        if ((CMUIX_ProfileCoopMapInstanceExists(lv_mapInstance) == false)) {
            lv_mapInstance = CMUIX_MapSelectionInstanceForMapLink(lv_map);
        }

        if ((CMUIX_ProfileCoopMapInstanceExists(lv_mapInstance) == true) && (CMUIX_MapSelectionMapShouldShowForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_mapInstance) == true)) {
            lv_mapLink = UserDataGetGameLink("CoopMaps", lv_mapInstance, "MA - Map Link", 1);
            CMUIX_MapSelectionSelected = lv_mapInstance;
            CMUIX_MapSelectionDraft = lv_mapInstance;
            libCOTF_gv_sELECTED_Mission = lv_mapInstance;
            libCOTF_gv_mapSelect_Mission = lv_mapInstance;
            if ((lv_mapLink != "")) {
                libCOTF_gv_sELECTED_Map = lv_mapLink;
            }
        }
    }

    if ((lv_enemy != "") && (CMUIX_EnemySelectionInstanceExists(lv_enemy) == true) && (CMUIX_EnemySelectionEnemyProfileAccessibleForPlayer(CMUIX_AccessSharedSetupPlayer(), lv_enemy) == true)) {
        CMUIX_EnemySelectionSelected = lv_enemy;
        CMUIX_EnemySelectionDraft = lv_enemy;
        libCOMI_gf_CM_CoopAIPersonalitySet(lv_enemy);
    }
}

void CMUIX_ProfileApplyDifficultyAndMastery(string lp_payload) {
    string lv_value;

    lv_value = CMUIX_ProfileConfigValue(lp_payload, "base");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_payload, "difficulty");
    }

    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_payload, "difficultyBase");
    }

    if ((lv_value != "")) {
        CMUIX_DifficultySelectedBase = CMUIX_DifficultyClampBase(StringToInt(lv_value));
        CMUIX_DifficultyDraftBase = CMUIX_DifficultySelectedBase;
    }

    lv_value = CMUIX_ProfileConfigValue(lp_payload, "plus");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_payload, "difficultyPlus");
    }

    if ((lv_value != "")) {
        CMUIX_DifficultySelectedPlus = CMUIX_DifficultyClampPlus(StringToInt(lv_value));
        CMUIX_DifficultyDraftPlus = CMUIX_DifficultySelectedPlus;
    }

    lv_value = CMUIX_ProfileConfigValue(lp_payload, "mastery");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_payload, "masterycap");
    }

    CMUIX_ProfileMasteryCapEnabled = false;
    CMUIX_ProfileMasteryCap = CMUIX_DefaultMasteryCap();
    if ((lv_value != "")) {
        CMUIX_ProfileMasteryCapEnabled = true;
        CMUIX_ProfileMasteryCap = CMUIX_ClampInt(StringToInt(lv_value), 0, libCOOC_gv_cCC_MASTERY_MAX_LEVEL);
    }

    CMUIX_ProfileApplyMasteryCapAll();
}

void CMUIX_ProfileRefreshModeVisualsForPlayer(int lp_player) {
    playergroup lv_players;
    string lv_modeState;
    int lv_backgroundCutscene;
    int lv_foregroundCutscene;

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        return;
    }

    lv_players = PlayerGroupSingle(lp_player);
    lv_modeState = "ModeStandard";
    lv_backgroundCutscene = c_invalidDialogControlId;
    lv_foregroundCutscene = c_invalidDialogControlId;
    libCOTF_gv_sELECTED_Mode = CMUIX_LaunchProfileModeInstance(CMUIX_CurrentMode);
    if ((CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) {
        lv_modeState = "ModeMutator";
    }

    if ((CMUIX_CurrentMode == CMUIX_MODE_CUSTOM)) {
        lv_modeState = "ModeCustom";
    }

    if ((CMUICore_IsControlValid(libCMUI_gv_screenCoopMain) == true)) {
        DialogControlSetAnimationState(libCMUI_gv_screenCoopMain, lv_players, "ModeState", lv_modeState);
        DialogControlSendAnimationEvent(libCMUI_gv_screenCoopMain, lv_players, lv_modeState);
    }

    if ((CMUIX_IsControlValid(libCMUI_gv_screenCoopCommanderSelectionPanel) == true)) {
        DialogControlSendAnimationEvent(libCMUI_gv_screenCoopCommanderSelectionPanel, lv_players, lv_modeState);
        DialogControlHookup(libCMUI_gv_screenCoopCommanderSelectionPanel, c_triggerControlTypeCutscene, "BackgroundCutscene");
        lv_backgroundCutscene = DialogControlLastCreated();
        if ((CMUIX_IsControlValid(lv_backgroundCutscene) == true)) {
            DialogControlSetAnimationState(lv_backgroundCutscene, lv_players, "ModeCutsceneStateGroup", lv_modeState);
            DialogControlSendAnimationEvent(lv_backgroundCutscene, lv_players, lv_modeState);
        }

        DialogControlHookup(libCMUI_gv_screenCoopCommanderSelectionPanel, c_triggerControlTypePanel, "ForegroundCutscene");
        lv_foregroundCutscene = DialogControlLastCreated();
        if ((CMUIX_IsControlValid(lv_foregroundCutscene) == true)) {
            DialogControlSendAnimationEvent(lv_foregroundCutscene, lv_players, lv_modeState);
        }
    }

    CMUIX_SetControlToggled(libCMUI_gv_screenCoopNavigationStandardButton, lv_players, (CMUIX_CurrentMode == CMUIX_MODE_STANDARD));
    CMUIX_SetControlToggled(libCMUI_gv_screenCoopNavigationMutatorButton, lv_players, (CMUIX_CurrentMode == CMUIX_MODE_MUTATOR) && (CMUIX_MutatorChallengeCurrentType == CMUIX_MutatorChallenge_Type_Official));
    CMUIX_SetControlToggled(libCMUI_gv_screenCoopNavigationCMMutatorButton, lv_players, (CMUIX_CurrentMode == CMUIX_MODE_MUTATOR) && (CMUIX_MutatorChallengeCurrentType == CMUIX_MutatorChallenge_Type_CM));
    CMUIX_SetControlToggled(libCMUI_gv_screenCoopNavigationCustomButton, lv_players, (CMUIX_CurrentMode == CMUIX_MODE_CUSTOM));
}

void CMUIX_ProfileRefreshModeVisuals() {
    int lv_player;

    lv_player = 1;
    libCOTF_gv_sELECTED_Mode = CMUIX_LaunchProfileModeInstance(CMUIX_CurrentMode);
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_ProfileRefreshModeVisualsForPlayer(lv_player);
        lv_player += 1;
    }
}

bool CMUIX_ProfileRefreshModeVisualsDeferredHandler(bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    Wait(0.0625, c_timeReal);
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
    Wait(0.125, c_timeReal);
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
    return true;
}

void CMUIX_ProfileRefreshModeVisualsDeferred() {
    CMUIX_ProfileRefreshModeVisuals();
    if ((CMUIX_ProfileModeVisualsDeferredTrigger == null)) {
        CMUIX_ProfileModeVisualsDeferredTrigger = TriggerCreate("CMUIX_ProfileRefreshModeVisualsDeferredHandler");
    }

    if ((CMUIX_ProfileModeVisualsDeferredTrigger != null)) {
        TriggerExecute(CMUIX_ProfileModeVisualsDeferredTrigger, true, false);
    }
}

void CMUIX_ProfileSetModeUI(int lp_mode) {
    if ((lp_mode == CMUIX_MODE_MUTATOR)) {
        CMUIX_CurrentMode = CMUIX_MODE_MUTATOR;
    }
    else {
        if ((lp_mode == CMUIX_MODE_CUSTOM)) {
            CMUIX_CurrentMode = CMUIX_MODE_CUSTOM;
        }
        else {
            CMUIX_CurrentMode = CMUIX_MODE_STANDARD;
        }
    }

    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_MutatorInfoResetPages();
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_MutatorPoolRefreshOpenButtons();
}

void CMUIX_ProfileSetCustomModeUI() {
    CMUIX_ProfileSetModeUI(CMUIX_MODE_CUSTOM);
}

void CMUIX_ProfileRefreshAfterApply(int lp_player) {
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_DifficultyRefreshAll();
    CMUIX_SpecialDifficultyRefreshAll();
    CMUIX_MapSelectionRefreshAll();
    CMUIX_NavigationRefreshEnabled();
    CMUIX_MutatorChallengeRefreshAll();
    CMUIX_StartupRefreshSelectionListsAll();
    CMUIX_CustomMutatorPickerRefreshOpenViewers(lp_player);
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
    CMUIX_MapSelectionResetReadyStatus();
}

int CMUIX_ProfileModeFromPayload(string lp_payload, string lp_mutators) {
    string lv_mode;
    string lv_plus;
    int lv_modeIndex;

    lv_mode = CMUIX_ProfileConfigValue(lp_payload, "mode");
    lv_plus = "";
    lv_modeIndex = CMUIX_MODE_CUSTOM;
    if ((lv_mode != "")) {
        lv_modeIndex = CMUIX_LaunchProfileModeIndex(lv_mode);
        if ((lv_modeIndex == CMUIX_MODE_MUTATOR)) {
            return CMUIX_MODE_MUTATOR;
        }

        if ((lv_modeIndex == CMUIX_MODE_CUSTOM)) {
            return CMUIX_MODE_CUSTOM;
        }

        return CMUIX_MODE_STANDARD;
    }

    if ((lp_mutators != "") && (lp_mutators != null)) {
        return CMUIX_MODE_CUSTOM;
    }

    lv_plus = CMUIX_ProfileConfigValue(lp_payload, "plus");
    if ((lv_plus == "")) {
        lv_plus = CMUIX_ProfileConfigValue(lp_payload, "difficultyPlus");
    }

    if ((StringToInt(lv_plus) > 0)) {
        return CMUIX_MODE_STANDARD;
    }

    return CMUIX_MODE_CUSTOM;
}

void CMUIX_ProfileApplyMutatorChallengeSettings(int lp_player, string lp_payload) {
    int lv_typeIndex;
    string lv_type;
    string lv_challenge;

    lv_typeIndex = 0;
    lv_type = CMUIX_ProfileConfigValue(lp_payload, "challengeType");
    lv_challenge = CMUIX_ProfileConfigValue(lp_payload, "challenge");
    if ((lv_type == "")) {
        lv_type = CMUIX_MutatorChallengeCurrentType;
    }

    lv_type = CMUIX_MutatorChallengeNormalizeType(lv_type);
    CMUIX_MutatorChallengeSetCurrentType(lv_type);
    lv_typeIndex = CMUIX_MutatorChallengeTypeIndex(lv_type);
    if ((lv_typeIndex <= 0) || (lv_typeIndex > CMUIX_MUTATOR_CHALLENGE_TYPE_MAX)) {
        return;
    }

    if ((lv_challenge == "")) {
        lv_challenge = CMUIX_MutatorChallengeSelected[lv_typeIndex];
    }

    lv_challenge = CMUIX_MutatorChallengeNormalizeSelection(lv_type, lv_challenge);
    if ((lv_challenge == "")) {
        lv_challenge = CMUIX_MutatorChallengeDefault[lv_typeIndex];
    }

    if ((lv_challenge == "")) {
        lv_challenge = CMUIX_MutatorChallenge_Random;
    }

    CMUIX_MutatorChallengeSelected[lv_typeIndex] = lv_challenge;
    CMUIX_MutatorChallengeDraft[lv_typeIndex] = lv_challenge;
    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_ProfileEnforceCommanderSelections();
    if ((CMUIX_MutatorChallengeIsRandom(lv_challenge) == false)) {
        CMUIX_EnemySelectionDraft = CMUIX_MutatorChallengeNormalizeEnemyForChallenge(lv_type, lv_challenge, CMUIX_EnemySelectionDraft);
        CMUIX_EnemySelectionSelected = CMUIX_EnemySelectionDraft;
    }

    CMUIX_MutatorChallengeRefreshButton();
    CMUIX_MutatorChallengeRefreshList(lp_player);
    CMUIX_MutatorChallengeEnemyRefreshList(lp_player);
}

int CMUIX_ProfileApplyStandardBrutalPlusMutators(string lp_list) {
    int lv_separator;
    int lv_length;
    int lv_slot;
    int lv_totalPoints;
    int lv_index;
    bool lv_enhanced;
    string lv_remaining;
    string lv_token;
    string lv_mutator;
    string lv_difficultyLevel;

    lv_separator = 0;
    lv_length = 0;
    lv_slot = 1;
    lv_totalPoints = 0;
    lv_index = 1;
    lv_enhanced = false;
    lv_remaining = lp_list;
    lv_token = "";
    lv_mutator = "";
    lv_difficultyLevel = "";
    if ((CMUIX_CurrentMode != CMUIX_MODE_STANDARD) || (CMUIX_DifficultySelectedPlus <= 0) || (lp_list == "") || (lp_list == null)) {
        return 0;
    }

    lv_difficultyLevel = CMUIX_StandardBrutalPlusDifficultyLevel(CMUIX_DifficultySelectedPlus);
    if ((lv_difficultyLevel == "")) {
        return 0;
    }

    CMUIX_StandardBrutalPlusClearRuntime();
    libCOMU_gv_cT_MAbomination_DifficultyLevel = lv_difficultyLevel;
    libCOMU_gv_cT_MAbomination_MinMutators = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "MutatorsMin", 1);
    libCOMU_gv_cT_MAbomination_MaxMutators = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "MutatorsMax", 1);
    libCOMU_gv_cT_MAbomination_MinPoints = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "PointsMin", 1);
    libCOMU_gv_cT_MAbomination_MaxPoints = UserDataGetInt("MutationDifficultyLevels", lv_difficultyLevel, "PointsMax", 1);
    while ((lv_remaining != "") && (lv_remaining != null) && (lv_slot <= libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max)) {
        lv_separator = StringFind(lv_remaining, ",", c_stringCase);
        if ((lv_separator < 0)) {
            lv_token = lv_remaining;
            lv_remaining = "";
        }
        else {
            if ((lv_separator <= 1)) {
                lv_token = "";
            }
            else {
                lv_token = StringSub(lv_remaining, 1, (lv_separator - 1));
            }

            if ((lv_separator >= StringLength(lv_remaining))) {
                lv_remaining = "";
            }
            else {
                lv_remaining = StringSub(lv_remaining, (lv_separator + 1), StringLength(lv_remaining));
            }
        }

        lv_mutator = StringReplaceWord(lv_token, " ", "", c_stringReplaceAll, c_stringNoCase);
        lv_enhanced = false;
        lv_length = StringLength(lv_mutator);
        if ((lv_length >= 2) && (StringSub(lv_mutator, lv_length, lv_length) == "+")) {
            lv_enhanced = true;
            lv_mutator = StringSub(lv_mutator, 1, (lv_length - 1));
        }

        if ((lv_mutator != "") && (CMUIX_MutatorPoolIndexForMutator(lv_mutator) > 0) && (CMUIX_MutatorPoolIsPlaceholder(lv_mutator) == false)) {
            if ((lv_enhanced == true) && (CMUIX_CustomMutatorPickerEnhanceAllowed(lv_mutator) == false)) {
                lv_enhanced = false;
            }

            libCOMU_gv_cT_MAbomination_Mutators[lv_slot] = lv_mutator;
            libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_slot] = lv_enhanced;
            libCOMU_gf_CT_EnableMutatorVariant(lv_mutator, lv_enhanced);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1, 0);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1, 1);
            UserDataSetInt("Mutators", lv_mutator, "Auto - Enhanced", 1, BoolToInt(lv_enhanced));
            lv_totalPoints += CMUIX_StandardBrutalPlusVariantPoints(lv_mutator, lv_enhanced);
            lv_slot += 1;
        }
    }

    libCOMU_gv_cT_MAbomination_MutatorsCount = (lv_slot - 1);
    libCOMU_gv_cT_MAbomination_CombosCounted = 1;
    libCOMU_gv_cT_MAbomination_CountSnapshot = 1;
    libCOMU_gv_cT_MAbomination_PointsSnapshot = lv_totalPoints;
    while ((lv_index <= 3)) {
        libCOMU_gv_cT_RandomMutators[lv_index] = "";
        libCOMU_gv_cT_RandomMutatorsEnhanced[lv_index] = false;
        if ((lv_index <= libCOMU_gv_cT_MAbomination_MutatorsCount)) {
            libCOMU_gv_cT_RandomMutators[lv_index] = libCOMU_gv_cT_MAbomination_Mutators[lv_index];
            libCOMU_gv_cT_RandomMutatorsEnhanced[lv_index] = libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_index];
        }

        lv_index += 1;
    }

    if ((libCOMU_gv_cT_MAbomination_MutatorsCount <= 0)) {
        CMUIX_StandardBrutalPlusClearRuntime();
        return 0;
    }

    return libCOMU_gv_cT_MAbomination_MutatorsCount;
}

string CMUIX_ProfileTemplateBodyFromBody(string lp_body) {
    string lv_result;
    string lv_value;

    lv_result = "";
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "version", IntToString(CMUIX_PROFILE_FORMAT_VERSION));
    lv_value = CMUIX_ProfileConfigValue(lp_body, "profileName");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "name");
    }

    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "challenge");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "name", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "mode");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mode", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "mission");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "map");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mission", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "enemy");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "enemy", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "base");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "difficulty");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "base", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "plus");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "difficultyPlus");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "plus", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "mastery");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "masterycap");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mastery", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "challengeType");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "challengeType", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "challenge");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "challenge", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "mutators");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "factors");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "mutators", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimization");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowOptimizations");
    }

    if ((lv_value == "")) {
        lv_value = "1";
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "allowOptimization", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommanders");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledCommander");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledCommanders", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestiges");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledPrestige");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledPrestiges", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "disabledAI");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "disabledAIs", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAIs");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "allowedAI");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "allowedAIs", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "seed");
    if ((lv_value == "")) {
        lv_value = CMUIX_ProfileConfigValue(lp_body, "randomSeed");
    }

    lv_result = CMUIX_ProfileAppendConfig(lv_result, "seed", lv_value);
    lv_value = CMUIX_ProfileConfigValue(lp_body, "note");
    lv_result = CMUIX_ProfileAppendConfig(lv_result, "note", lv_value);
    return lv_result;
}

string CMUIX_ProfileTemplatePayloadFromBody(string lp_body, bool lp_certified) {
    string lv_body;

    lv_body = CMUIX_ProfileTemplateBodyFromBody(lp_body);
    if ((lv_body == "")) {
        return "";
    }

    if ((lp_certified == true)) {
        return CMUIX_ProfilePayloadWithChecksum(lv_body);
    }

    return lv_body;
}

void CMUIX_ProfileShowCoopCommanderSelection(int lp_player) {
    playergroup lv_players;

    if ((lp_player < 1) || (lp_player > libCOOC_gv_cCC_MAXPLAYERS)) {
        lv_players = PlayerGroupAll();
    }
    else {
        lv_players = PlayerGroupSingle(lp_player);
    }

    if ((CMUIX_IsControlValid(libCMUI_gv_screenNavigationMain) == true)) {
        DialogControlSelectItem(libCMUI_gv_screenNavigationMain, lv_players, 1);
        DialogControlSendAnimationEvent(libCMUI_gv_screenNavigationMain, lv_players, "CMUIXSelectCoop");
    }

    CMUIX_SetControlToggled(CMUIX_MainNavigationHomeButton, lv_players, false);
    CMUIX_SetControlToggled(CMUIX_MainNavigationCoopButton, lv_players, true);
    CMUIX_SetControlToggled(CMUIX_MainNavigationHistoryButton, lv_players, false);
    CMUIX_ProfileRefreshModeVisualsDeferred();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
}

bool CMUIX_ProfileApplyPayloadWithSource(int lp_player, string lp_payload, int lp_source, string lp_sourceProfileKey, string lp_sourceHistoryKey) {
    int lv_added;
    int lv_mode;
    int lv_player;
    string lv_payload;
    string lv_body;
    string lv_mutators;
    string lv_name;
    string lv_displayName;
    string lv_profilePayload;
    string lv_profileBody;
    bool lv_certified;

    lv_added = 0;
    lv_mode = CMUIX_MODE_CUSTOM;
    lv_player = 0;
    lv_payload = "";
    lv_body = "";
    lv_mutators = "";
    lv_name = "";
    lv_displayName = "";
    lv_profilePayload = "";
    lv_profileBody = "";
    lv_certified = false;
    if ((CMUIX_ProfilePayloadIsGeneratorCommand(lp_payload) == true)) {
        return CMUIX_ProfileGenerateCurrentForPlayer(lp_player, lp_payload);
    }

    if ((lp_payload == "") || (lp_payload == null)) {
        CMUIX_ProfileMessage(lp_player, "Profile 配置为空。");
        return false;
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lp_payload);
    if ((lv_payload == "")) {
        if ((CMUIX_ProfilePayloadIsCompact(lp_payload) == true)) {
            CMUIX_ProfileMessage(lp_player, "Profile 压缩编码无效，未应用配置。");
            return false;
        }

        CMUIX_ProfileMessage(lp_player, "Profile 配置为空。");
        return false;
    }

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
    if ((lv_body == "")) {
        CMUIX_ProfileMessage(lp_player, "Profile 配置为空。");
        return false;
    }

    if ((CMUIX_ProfileVersionSupported(lv_body) == false)) {
        CMUIX_ProfileMessage(lp_player, ("Profile 版本无效或高于当前支持版本 " + IntToString(CMUIX_PROFILE_FORMAT_VERSION) + "，未应用配置。"));
        return false;
    }

    if ((lp_source < CMUIX_LAUNCH_SOURCE_MANUAL) || (lp_source > CMUIX_LAUNCH_SOURCE_HISTORY)) {
        lp_source = CMUIX_LAUNCH_SOURCE_PROFILE;
    }

    CMUIX_ProfileCertified = false;
    CMUIX_ProfileChecksumValue = 0;
    if ((CMUIX_ProfilePayloadHasChecksum(lv_payload) == true)) {
        lv_certified = CMUIX_ProfilePayloadCertified(lv_payload);
        if ((lv_certified == false)) {
            CMUIX_ProfileMessage(lp_player, "Profile 校验失败，未应用配置。");
            return false;
        }
    }

    if ((CMUIX_ProfileCommandAllowedForLauncher(lp_player, lv_body) == false)) {
        return false;
    }

    lv_name = CMUIX_ProfileConfigValue(lv_body, "name");
    if ((lv_name == "")) {
        lv_name = CMUIX_ProfileConfigValue(lv_body, "challenge");
    }

    lv_displayName = lv_name;
    if ((lv_displayName == "")) {
        lv_displayName = "Profile";
    }

    CMUIX_ProfileClearChatWindow(lp_player);
    if ((CMUIX_ProfileConfigLocked == false) && (lp_source != CMUIX_LAUNCH_SOURCE_MANUAL)) {
        CMUIX_ProfileCancelSnapshotPayload = CMUIX_ProfileBuildCurrentBody("BeforeProfile");
    }

    CMUIX_ProfileModeActive = (lp_source == CMUIX_LAUNCH_SOURCE_PROFILE);
    CMUIX_ProfileConfigLocked = (lp_source != CMUIX_LAUNCH_SOURCE_MANUAL);
    CMUIX_ProfileOptimizationAllowed = CMUIX_ProfileOptimizationAllowedFromBody(lv_body);
    CMUIX_ProfileApplyRestrictionsAndSeed(lv_body, CMUIX_ProfileConfigLocked);
    CMUIX_ProfileLaunchCounted = false;
    CMUIX_LaunchSource = lp_source;
    CMUIX_ProfileRawConfig = lv_payload;
    if ((lp_source == CMUIX_LAUNCH_SOURCE_PROFILE)) {
        lv_profilePayload = CMUIX_ProfileTemplatePayloadFromBody(lv_body, lv_certified);
        if ((lv_profilePayload != "")) {
            CMUIX_ProfileRawConfig = lv_profilePayload;
            lv_profileBody = CMUIX_ProfilePayloadWithoutChecksum(lv_profilePayload);
        }
    }

    CMUIX_ProfileChallengeName = lv_name;
    CMUIX_ProfileCertified = lv_certified;
    if ((lp_source == CMUIX_LAUNCH_SOURCE_PROFILE)) {
        if ((lv_profileBody == "")) {
            lv_profileBody = lv_body;
        }

        CMUIX_ProfileChecksumValue = CMUIX_ProfileChecksumForBody(lv_profileBody);
    }

    CMUIX_ProfileSourceTemplateKey = lp_sourceProfileKey;
    CMUIX_ProfileSourceTemplatePlayer = 0;
    if ((lp_source == CMUIX_LAUNCH_SOURCE_PROFILE) && (CMUIX_HistoryProfileTemplateKeyExists(lp_player, CMUIX_ProfileSourceTemplateKey) == true)) {
        CMUIX_ProfileSourceTemplatePlayer = lp_player;
    }
    else {
        CMUIX_ProfileSourceTemplateKey = "";
    }

    CMUIX_ProfileSourceHistoryKey = lp_sourceHistoryKey;
    CMUIX_LaunchAttemptCount = 1;
    CMUIX_LaunchAttemptChecksum = 0;
    CMUIX_LaunchHistoryKey = "";
    while ((lv_player <= libCOOC_gv_cCC_MAXPLAYERS)) {
        CMUIX_LaunchHistoryKeys[lv_player] = "";
        lv_player += 1;
    }

    CMUIX_LaunchLastResult = "";
    lv_mutators = CMUIX_ProfileConfigValue(lv_body, "mutators");
    if ((lv_mutators == "")) {
        lv_mutators = CMUIX_ProfileConfigValue(lv_body, "factors");
    }

    lv_mode = CMUIX_ProfileModeFromPayload(lv_body, lv_mutators);
    CMUIX_ProfileSetModeUI(lv_mode);
    CMUIX_ProfileApplyDifficultyAndMastery(lv_body);
    CMUIX_ProfileApplyMapAndEnemy(lv_body);
    if ((lv_mode != CMUIX_MODE_MUTATOR)) {
        CMUIX_DifficultyEnsureSelection();
    }

    if ((lv_mode == CMUIX_MODE_STANDARD)) {
        CMUIX_ProfileApplyMutatorList("");
        if ((CMUIX_DifficultySelectedPlus > 0) && (lv_mutators != "")) {
            lv_added = CMUIX_ProfileApplyStandardBrutalPlusMutators(lv_mutators);
        }

        if ((lv_added <= 0)) {
            CMUIX_StandardBrutalPlusApplyRuntime();
        }

        lv_added = libCOMU_gv_cT_MAbomination_MutatorsCount;
    }
    else {
        if ((lv_mode == CMUIX_MODE_MUTATOR)) {
            CMUIX_ProfileApplyMutatorList("");
            CMUIX_ProfileApplyMutatorChallengeSettings(lp_player, lv_body);
            CMUIX_DifficultyEnsureSelection();
            lv_added = 0;
        }
        else {
            lv_added = CMUIX_ProfileApplyMutatorList(lv_mutators);
        }
    }

    CMUIX_ProfileRuntimeLocksRefresh();
    CMUIX_ProfileEnforceCommanderSelections();
    CMUIX_ProfileRefreshAfterApply(lp_player);
    if ((lp_source == CMUIX_LAUNCH_SOURCE_PROFILE)) {
        if ((CMUIX_ProfileSourceTemplatePlayer != lp_player) || (CMUIX_ProfileSourceTemplateKey == "")) {
            CMUIX_ProfileTemplateRecord(lp_player, lv_displayName, CMUIX_ProfileRawConfig, "Loaded");
            CMUIX_ProfileSourceTemplateKey = CMUIX_HistoryLastProfileTemplateKey;
            if ((CMUIX_ProfileSourceTemplateKey != "")) {
                CMUIX_ProfileSourceTemplatePlayer = lp_player;
            }
        }
    }

    CMUIX_ApplyOptimizationStateForAllPlayers();
    CMUIX_ProfileMessage(lp_player, ("Profile 已应用：" + lv_displayName + "，因子数 " + IntToString(lv_added) + "。"));
    return true;
}

bool CMUIX_ProfileApplyPayload(int lp_player, string lp_payload) {
    return CMUIX_ProfileApplyPayloadWithSource(lp_player, lp_payload, CMUIX_LAUNCH_SOURCE_PROFILE, "", "");
}

void CMUIX_ProfileCancelActiveConfiguration(int lp_player) {
    string lv_payload;

    lv_payload = CMUIX_ProfileCancelSnapshotPayload;
    if ((CMUIX_ProfileConfigLocked == false)) {
        return;
    }

    CMUIX_ProfileConfigLocked = false;
    CMUIX_ProfileModeActive = false;
    CMUIX_ProfileOptimizationAllowed = true;
    CMUIX_ProfileApplyRestrictionsAndSeed("", false);
    CMUIX_ProfileLaunchCounted = false;
    CMUIX_LaunchSource = CMUIX_LAUNCH_SOURCE_MANUAL;
    CMUIX_ProfileRawConfig = "";
    CMUIX_ProfileChallengeName = "";
    CMUIX_ProfileChecksumValue = 0;
    CMUIX_ProfileCertified = false;
    CMUIX_ProfileSourceTemplateKey = "";
    CMUIX_ProfileSourceTemplatePlayer = 0;
    CMUIX_ProfileSourceHistoryKey = "";
    CMUIX_LaunchAttemptCount = 1;
    CMUIX_LaunchAttemptChecksum = 0;
    CMUIX_LaunchHistoryKey = "";
    CMUIX_LaunchLastResult = "";
    if ((lv_payload != "") && (lv_payload != null)) {
        CMUIX_ProfileApplyPayloadWithSource(lp_player, lv_payload, CMUIX_LAUNCH_SOURCE_MANUAL, "", "");
    }

    CMUIX_ProfileConfigLocked = false;
    CMUIX_ProfileModeActive = false;
    CMUIX_ProfileOptimizationAllowed = true;
    CMUIX_ProfileApplyRestrictionsAndSeed("", false);
    CMUIX_ProfileLaunchCounted = false;
    CMUIX_LaunchSource = CMUIX_LAUNCH_SOURCE_MANUAL;
    CMUIX_ProfileRawConfig = "";
    CMUIX_ProfileChallengeName = "";
    CMUIX_ProfileChecksumValue = 0;
    CMUIX_ProfileCertified = false;
    CMUIX_ProfileSourceTemplateKey = "";
    CMUIX_ProfileSourceTemplatePlayer = 0;
    CMUIX_ProfileSourceHistoryKey = "";
    CMUIX_ProfileCancelSnapshotPayload = "";
    CMUIX_CustomizationClearTemporaryAll();
    CMUIX_MapSelectionResetReadyStatus();
    CMUIX_StartupRefreshControls();
    CMUIX_ProfileRefreshModeVisuals();
    CMUIX_ReadyRefreshDataControlsAll();
    CMUIX_MutatorPoolRefreshOpenButtons();
    CMUIX_MutatorInfoRefreshAll();
    CMUIX_ApplyOptimizationStateForAllPlayers();
    CMUIX_ProfileMessage(lp_player, "Profile 限制已取消。");
}

string CMUIX_HistoryRecordKey(int lp_index) {
    return ("Row|" + IntToString(lp_index));
}

string CMUIX_HistoryRecordCheatKey(string lp_key) {
    return (lp_key + "|Cheated");
}

int CMUIX_HistoryRecordIndexFromKey(string lp_key) {
    string lv_indexText;

    lv_indexText = "";
    if ((lp_key == "") || (lp_key == null)) {
        return 0;
    }

    if ((StringLength(lp_key) <= 4)) {
        return 0;
    }

    if ((StringSub(lp_key, 1, 4) != "Row|")) {
        return 0;
    }

    lv_indexText = StringSub(lp_key, 5, StringLength(lp_key));
    return StringToInt(lv_indexText);
}

string CMUIX_HistoryProfileTemplateKey(int lp_index) {
    return ("Profile|" + IntToString(lp_index));
}

string CMUIX_HistoryBodyFromPayload(string lp_payload) {
    string lv_payload;
    string lv_body;

    lv_payload = "";
    lv_body = "";
    if ((lp_payload == "") || (lp_payload == null)) {
        return "";
    }

    lv_payload = CMUIX_ProfileNormalizePayload(lp_payload);
    if ((lv_payload == "")) {
        return "";
    }

    lv_body = CMUIX_ProfilePayloadWithoutChecksum(lv_payload);
    if ((lv_body == null)) {
        return "";
    }

    return lv_body;
}

bool CMUIX_HistoryRecordMarkedCheated(bank lp_bank, string lp_key, string lp_payload) {
    string lv_body;

    lv_body = "";
    if ((lp_bank != null) && (lp_key != "") && (BankKeyExists(lp_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lp_key)) == true)) {
        if ((CMUIX_PlayerProfileGetInt(lp_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lp_key), 0) == 1)) {
            return true;
        }
    }

    if ((lp_payload == "") || (lp_payload == null)) {
        return false;
    }

    lv_body = CMUIX_HistoryBodyFromPayload(lp_payload);
    if ((CMUIX_ProfileConfigValue(lv_body, "cheated") == "1")) {
        return true;
    }

    return false;
}

void CMUIX_HistoryRemoveRecordBankKeys(bank lp_bank, string lp_key) {
    if ((lp_bank == null) || (lp_key == "") || (lp_key == null)) {
        return;
    }

    BankKeyRemove(lp_bank, CMUIX_HISTORY_SECTION, lp_key);
    BankKeyRemove(lp_bank, CMUIX_HISTORY_SECTION, CMUIX_HistoryRecordCheatKey(lp_key));
}

int CMUIX_HistoryPageCount(int lp_count) {
    if ((lp_count <= 0)) {
        return 1;
    }

    return (((lp_count - 1) / CMUIX_HISTORY_ROW_MAX) + 1);
}

string CMUIX_HistoryTwoDigitString(int lp_value) {
    if ((lp_value < 10)) {
        return ("0" + IntToString(lp_value));
    }

    return IntToString(lp_value);
}

string CMUIX_HistoryDateString(int lp_timestamp) {
    datetime lv_time;

    if ((lp_timestamp <= 0)) {
        return "-";
    }

    lv_time = IntToDateTime(lp_timestamp);
    return (IntToString(GetDateTimeYear(lv_time)) + "/" + CMUIX_HistoryTwoDigitString(GetDateTimeMonth(lv_time)) + "/" + CMUIX_HistoryTwoDigitString(GetDateTimeDay(lv_time)) + " " + CMUIX_HistoryTwoDigitString(GetDateTimeHour(lv_time)) + ":" + CMUIX_HistoryTwoDigitString(GetDateTimeMinute(lv_time)));
}

string CMUIX_HistoryDateHourString(int lp_timestamp) {
    datetime lv_time;

    if ((lp_timestamp <= 0)) {
        return "-";
    }

    lv_time = IntToDateTime(lp_timestamp);
    return (IntToString(GetDateTimeYear(lv_time)) + "/" + CMUIX_HistoryTwoDigitString(GetDateTimeMonth(lv_time)) + "/" + CMUIX_HistoryTwoDigitString(GetDateTimeDay(lv_time)) + " " + CMUIX_HistoryTwoDigitString(GetDateTimeHour(lv_time)) + ":00");
}

text CMUIX_HistoryDateText(int lp_timestamp) {
    datetime lv_time;
    datetime lv_nowTime;
    int lv_now;
    int lv_delta;
    int lv_hours;
    int lv_days;
    int lv_month;
    int lv_day;
    int lv_year;
    int lv_nowYear;

    if ((lp_timestamp <= 0)) {
        return StringToText("-");
    }

    lv_time = IntToDateTime(lp_timestamp);
    lv_nowTime = CurrentDateTimeGet();
    lv_now = DateTimeToInt(lv_nowTime);
    lv_delta = lv_now - lp_timestamp;
    lv_hours = 0;
    lv_days = 0;
    lv_month = GetDateTimeMonth(lv_time);
    lv_day = GetDateTimeDay(lv_time);
    lv_year = GetDateTimeYear(lv_time);
    lv_nowYear = GetDateTimeYear(lv_nowTime);
    if ((lv_delta < 0)) {
        lv_delta = 0;
    }

    if ((lv_delta < 86400)) {
        lv_hours = (lv_delta / 3600);
        if ((lv_hours < 1)) {
            lv_hours = 1;
        }

        return StringToText(IntToString(lv_hours)) + StringExternal("CMUI/ScreenHistory/Date/HoursAgo");
    }

    if ((lv_delta < 2592000)) {
        lv_days = (lv_delta / 86400);
        if ((lv_days < 1)) {
            lv_days = 1;
        }

        return StringToText(IntToString(lv_days)) + StringExternal("CMUI/ScreenHistory/Date/DaysAgo");
    }

    if ((lv_year == lv_nowYear)) {
        return StringToText(CMUIX_HistoryTwoDigitString(lv_month) + "/" + CMUIX_HistoryTwoDigitString(lv_day));
    }

    return StringToText(IntToString(lv_year) + "/" + CMUIX_HistoryTwoDigitString(lv_month) + "/" + CMUIX_HistoryTwoDigitString(lv_day));
}

