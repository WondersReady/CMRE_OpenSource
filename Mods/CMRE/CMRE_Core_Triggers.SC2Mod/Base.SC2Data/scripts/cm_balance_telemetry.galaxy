// -----------------------------------------------------------------------------
// UT_DL Damage Source Interception (Native-style encapsulation)
// -----------------------------------------------------------------------------
bool CMBT_UT_DL_IsValidDamageSource () {
    if (EventUnitDamageSourceUnit() != null) {
        return true;
    }
    if (EventUnitDamageEffect() == "NovaGriffinBombingRunDamage") {
        return true;
    }
    return false;
}

string CMBT_UT_DL_GetDamageSourceUnitType () {
    if (EventUnitDamageEffect() == "NovaGriffinBombingRunDamage") {
        return "NovaGriffinBombingRunStrafer";
    }
    return UnitGetType(EventUnitDamageSourceUnit());
}

// -----------------------------------------------------------------------------
// Small helpers
// -----------------------------------------------------------------------------
string CMBT_UnitKey (int lp_player, int lp_slot) {
    return ("P" + IntToString(lp_player) + "S" + IntToString(lp_slot));
}

void CMBT_Message (int lp_player, string lp_message) {
    CMUIX_ConsoleDisplayColoredLine(PlayerGroupSingle(lp_player), StringToText("[Balance Telemetry] " + lp_message), CMUIX_CONSOLE_COLOR_DESCRIPTION);
}

string CMBT_TwoDigit (int lp_value) {
    if ((lp_value < 10)) {
        return ("0" + IntToString(lp_value));
    }
    return IntToString(lp_value);
}

string CMBT_WallText (int lp_timestamp) {
    datetime lv_time;

    lv_time = IntToDateTime(lp_timestamp);
    return (IntToString(GetDateTimeYear(lv_time)) + "/" + CMBT_TwoDigit(GetDateTimeMonth(lv_time)) + "/" + CMBT_TwoDigit(GetDateTimeDay(lv_time)) + " " + CMBT_TwoDigit(GetDateTimeHour(lv_time)) + ":" + CMBT_TwoDigit(GetDateTimeMinute(lv_time)) + ":" + CMBT_TwoDigit(GetDateTimeSecond(lv_time)));
}

string CMBT_AsciiAlnumPrefix (string lp_value, int lp_max) {
    int lv_i;
    string lv_char;
    string lv_out;

    lv_i = 1;
    lv_char = "";
    lv_out = "";
    while (((lv_i <= StringLength(lp_value)) && (StringLength(lv_out) < lp_max))) {
        lv_char = StringSub(lp_value, lv_i, lv_i);
        if ((StringContains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", lv_char, c_stringAnywhere, c_stringCase) == true)) {
            lv_out += lv_char;
        }
        lv_i += 1;
    }
    if ((lv_out == "")) {
        return "CM";
    }
    return lv_out;
}

// Commander ids carry a race prefix (ProtossMalash, TerranMengsk); drop it so the 6-char bank tag names the commander.
string CMBT_StripRacePrefix (string lp_id) {
    if (((StringLength(lp_id) > 7) && (StringSub(lp_id, 1, 7) == "Protoss"))) {
        return StringSub(lp_id, 8, StringLength(lp_id));
    }
    if (((StringLength(lp_id) > 6) && (StringSub(lp_id, 1, 6) == "Terran"))) {
        return StringSub(lp_id, 7, StringLength(lp_id));
    }
    if (((StringLength(lp_id) > 4) && (StringSub(lp_id, 1, 4) == "Zerg"))) {
        return StringSub(lp_id, 5, StringLength(lp_id));
    }
    return lp_id;
}

string CMBT_BuildBankBaseName (int lp_startedAt, int lp_player) {
    datetime lv_time;
    string lv_commander;

    lv_time = IntToDateTime(lp_startedAt);
    lv_commander = CMBT_AsciiAlnumPrefix(CMBT_StripRacePrefix(libCOOC_gf_ActiveCommanderForPlayer(lp_player)), CMBT_COMMANDER_NAME_CHARS);
    return (CMBT_BANK_PREFIX + IntToString(GetDateTimeYear(lv_time)) + CMBT_TwoDigit(GetDateTimeMonth(lv_time)) + CMBT_TwoDigit(GetDateTimeDay(lv_time)) + "T" + CMBT_TwoDigit(GetDateTimeHour(lv_time)) + CMBT_TwoDigit(GetDateTimeMinute(lv_time)) + CMBT_TwoDigit(GetDateTimeSecond(lv_time)) + lv_commander);
}

void CMBT_SetMutBuffDefinition (int lp_slot, string lp_factor, string lp_behavior, string lp_direction, string lp_valueSource, string lp_catalogField, bool lp_trackOutput, bool lp_trackDefense) {
    CMBT_MutBuffFactor[lp_slot] = lp_factor;
    CMBT_MutBuffBehavior[lp_slot] = lp_behavior;
    CMBT_MutBuffDirection[lp_slot] = lp_direction;
    CMBT_MutBuffValueSource[lp_slot] = lp_valueSource;
    CMBT_MutBuffCatalogField[lp_slot] = lp_catalogField;
    CMBT_MutBuffTrackOutput[lp_slot] = lp_trackOutput;
    CMBT_MutBuffTrackDefense[lp_slot] = lp_trackDefense;
}

void CMBT_SetMutatorUnitDefinition (int lp_slot, string lp_factor, string lp_unitType) {
    CMBT_MutatorUnitFactor[lp_slot] = lp_factor;
    CMBT_MutatorUnitType[lp_slot] = lp_unitType;
}

void CMBT_SetMutatorEffectDefinition (int lp_slot, string lp_factor, string lp_effect) {
    CMBT_MutatorEffectFactor[lp_slot] = lp_factor;
    CMBT_MutatorEffectId[lp_slot] = lp_effect;
}

void CMBT_InitMutatorWhitelist () {
    CMBT_MutBuffCount = 16;
    CMBT_SetMutBuffDefinition(1, "Avenger", "MutatorAvenger", "both", "BehaviorData.xml MutatorAvenger modification fields", "Modification.AttackSpeedMultiplier", true, true);
    CMBT_SetMutBuffDefinition(2, "JustDie", "MutatorJustDie", "event_only", "BehaviorData.xml MutatorJustDie Duration", "Duration", false, false);
    CMBT_SetMutBuffDefinition(3, "HybridDisaster", "HybridUnitDummy", "event_only", "BehaviorData.xml HybridUnitDummy Permanent", "BehaviorFlags[Permanent]", false, false);
    CMBT_SetMutBuffDefinition(4, "HeroesFromTheStorm", "HeroesBalanceCooldowns", "enemy_output", "BehaviorData.xml HeroesBalanceCooldowns Charge rate", "Modification.RateMultiplierArray[Charge]", true, false);
    CMBT_SetMutBuffDefinition(5, "HeroesFromTheStorm", "ReduceWeaponDamage10", "enemy_output", "BehaviorData.xml ReduceWeaponDamage10 Melee", "Modification.DamageTotalMultiplier[Melee]", true, false);
    CMBT_SetMutBuffDefinition(6, "HeroesFromTheStorm", "ReduceAbilityDamage10", "enemy_output", "BehaviorData.xml ReduceAbilityDamage10 Spell", "Modification.DamageTotalMultiplier[Spell]", true, false);
