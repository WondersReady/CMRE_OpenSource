const int CMBT_STREAM_ECON = 6;
const int CMBT_STREAM_HERO = 7;
const int CMBT_STREAM_COUNT = 8;

const int CMBT_PACK_MAX = 6;

// Growth vector (bank 2 "Growth" section). Only the Malash schema is wired so far; the vector
// is written only when player CMBT_GROWTH_PLAYER is detected as Malash (U22, plan §9).
//   G1..G3 hero attribute points (CBehaviorAttribute stacks on the hero unit, 0..500)
//   G4..G6 army obedience: mean / max / unit count over the four army types (0..1000 each)
//   G7..G11 casts this frame: purge (hunter) / blood drinking (autocast) / shackles (T5b) /
//     break (hero ultimate MalashBreak) / immortal order (walker mark MalashImmortalOrder)
const int CMBT_GROWTH_PLAYER = 1;
