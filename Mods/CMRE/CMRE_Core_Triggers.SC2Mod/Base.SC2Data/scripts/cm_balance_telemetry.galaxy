const string CMBT_HERO_UNITS_SECTION = "HeroUnits";
const string CMBT_PLAYERS_SECTION = "Players";
const string CMBT_MUTATORS_SECTION = "Mutators";
const string CMBT_OBJECTIVES_SECTION = "Objectives";
const string CMBT_SCORE_STATS_SECTION = "ScoreStats";
const string CMBT_SAMPLES_SECTION = "Samples";
const string CMBT_TAKEN_SECTION = "Taken";
