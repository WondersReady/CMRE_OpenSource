// 3.2 attack instances: per-slot counts plus the previous event's dedupe triple, so one
// attack splashing onto several targets within the same mission-time tick counts once.
// The unit part is compared by handle (not unit type), so same-type units firing in the
// same tick each still count.
int[CMBT_MAX_SLOTS + 1][3] CMBT_AtkCount;
int[CMBT_MAX_SLOTS + 1][3] CMBT_AtkLastTag;
string[CMBT_MAX_SLOTS + 1][3] CMBT_AtkLastEffect;
fixed[CMBT_MAX_SLOTS + 1][3] CMBT_AtkLastTime;

// 3.2 hostile-to-P1 on-field vitals, refreshed once per sample by CMBT_UpdateEnemyField.
fixed CMBT_FieldHpUnits = 0.0;
fixed CMBT_FieldHpStructures = 0.0;
int CMBT_FieldNUnits = 0;
int CMBT_FieldNStructures = 0;

fixed[CMBT_MAX_SLOTS + 1][CMBT_FIXED_FIELDS][3] CMBT_Acc;
int[CMBT_MAX_SLOTS + 1][CMBT_INT_FIELDS][3] CMBT_AccInt;
