string CMBT_MutBuffCatalogValue (int lp_slot) {
    string lv_behavior;

    lv_behavior = CMBT_MutBuffBehavior[lp_slot];
    if ((CatalogEntryIsValid(c_gameCatalogBehavior, lv_behavior) == false)) {
        return "unavailable";
    }
    if ((lp_slot == 1)) {
        return ("attack_speed=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.AttackSpeedMultiplier", c_playerAny) + ";life_armor=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.LifeArmorBonus", c_playerAny) + ";life_max=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.VitalMaxAdditiveMultiplierArray[Life]", c_playerAny) + ";shield_max=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.VitalMaxAdditiveMultiplierArray[Shields]", c_playerAny));
    }
    if ((lp_slot == 13)) {
        return ("dealt=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.UnifiedDamageDealtFraction[Spell]", c_playerAny) + ";taken=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.UnifiedDamageTakenFraction[Spell]", c_playerAny));
    }
    if ((lp_slot == 15)) {
        return ("attack_speed=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.AttackSpeedMultiplier", c_playerAny) + ";taken=" + CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, "Modification.DamageTakenFraction[Spell]", c_playerAny));
    }
    return CatalogFieldValueGet(c_gameCatalogBehavior, lv_behavior, CMBT_MutBuffCatalogField[lp_slot], c_playerAny);
}

void CMBT_WriteMutatorWhitelistMeta () {
    int lv_i;
    string lv_key;

    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, "Count", CMBT_MutBuffCount);
    lv_i = 1;
    while ((lv_i <= CMBT_MutBuffCount)) {
        lv_key = "B" + IntToString(lv_i);
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, lv_key + "Factor", CMBT_MutBuffFactor[lv_i]);
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, lv_key + "Behavior", CMBT_MutBuffBehavior[lv_i]);
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, lv_key + "Direction", CMBT_MutBuffDirection[lv_i]);
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, lv_key + "ValueSource", CMBT_MutBuffValueSource[lv_i]);
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTBUFFS_SECTION, lv_key + "Value", CMBT_MutBuffCatalogValue(lv_i));
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATOR_UNITS_SECTION, "Count", CMBT_MutatorUnitCount);
    lv_i = 1;
    while ((lv_i <= CMBT_MutatorUnitCount)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATOR_UNITS_SECTION, "U" + IntToString(lv_i), CMBT_MutatorUnitFactor[lv_i] + "~" + CMBT_MutatorUnitType[lv_i]);
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATOR_EFFECTS_SECTION, "Count", CMBT_MutatorEffectCount);
    lv_i = 1;
    while ((lv_i <= CMBT_MutatorEffectCount)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATOR_EFFECTS_SECTION, "X" + IntToString(lv_i), CMBT_MutatorEffectFactor[lv_i] + "~" + CMBT_MutatorEffectId[lv_i]);
        lv_i += 1;
    }
}

string CMBT_MutatorFactorForUnitType (string lp_type) {
    int lv_i;

    lv_i = 1;
    while ((lv_i <= CMBT_MutatorUnitCount)) {
        if ((lp_type == CMBT_MutatorUnitType[lv_i])) {
            return CMBT_MutatorUnitFactor[lv_i];
        }
        lv_i += 1;
    }
    return "";
}

int CMBT_MutBuffSlotForBehavior (string lp_behavior) {
    int lv_i;

    lv_i = 1;
    while ((lv_i <= CMBT_MutBuffCount)) {
        if ((lp_behavior == CMBT_MutBuffBehavior[lv_i])) {
            return lv_i;
        }
        lv_i += 1;
    }
    return 0;
}

int CMBT_MutatorEffectSlot (string lp_effect) {
    int lv_i;

    lv_i = 1;
    while ((lv_i <= CMBT_MutatorEffectCount)) {
        if ((lp_effect == CMBT_MutatorEffectId[lv_i])) {
            return lv_i;
        }
        lv_i += 1;
    }
    return 0;
}

string CMBT_BankPathHint (int lp_player, string lp_bankName) {
    if ((GameIsOnline() == false)) {
        return "Documents/StarCraft II/Banks/" + lp_bankName + ".SC2Bank";
    }
    return "Documents/StarCraft II/Accounts/<account-number>/" + PlayerHandle(lp_player) + "/Banks/<map-author-handle>/" + lp_bankName + ".SC2Bank";
}

void CMBT_WritePathMeta (bank lp_bank, int lp_player, string lp_bankName) {
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "IsOnline", BoolToInt(GameIsOnline()));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "PlayerHandle", PlayerHandle(lp_player));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "BankPathHint", CMBT_BankPathHint(lp_player, lp_bankName));
}

string CMBT_StreamSection (int lp_stream) {
    if ((lp_stream == CMBT_STREAM_SAMPLES)) {
        return CMBT_SAMPLES_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_TAKEN)) {
        return CMBT_TAKEN_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_ENEMY)) {
        return CMBT_ENEMY_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_GROWTH)) {
        return CMBT_GROWTH_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_FIELD)) {
        return CMBT_FIELD_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_VICTIM)) {
        return CMBT_VICTIM_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_ECON)) {
        return CMBT_ECON_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_HERO)) {
        return CMBT_HERO_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_MUTBUFF)) {
        return CMBT_MUTBUFF_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_SKILL)) {
        return CMBT_SKILL_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_GROWTH_P2)) {
        return CMBT_GROWTH_P2_SECTION;
    }
    return CMBT_COMMANDS_SECTION;
}

// Linear search over this module's own slot table, creating a slot on demand.
// Morph pairs share a slot (same rule UT_DL's damage log uses), so e.g. a sieged tank does
// not split away from its unsieged form. Returns 0 when the type is unusable or the table
// is full (the overflow is counted and reported in Meta.SlotOverflow).
int CMBT_FindSlot (int lp_player, string lp_unitType, bool lp_create) {
    int lv_slot;

    if (((lp_player < 1) || (lp_player > 2))) {
        return 0;
    }
    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }

    // Exact match first: it is a plain string compare and covers virtually every event.
    // The morph-pair test is a long boolean chain, so it only runs once the cheap pass has
    // failed for the whole table.
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        if ((lp_unitType == CMBT_SlotType[lv_slot][lp_player])) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        if ((libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_SlotType[lv_slot][lp_player]) == true)) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    if ((lp_create == false)) {
        return 0;
    }
    if ((CMBT_SlotCount[lp_player] >= CMBT_MAX_SLOTS)) {
        CMBT_SlotOverflow += 1;
        return 0;
    }

    CMBT_SlotCount[lp_player] += 1;
    CMBT_SlotType[CMBT_SlotCount[lp_player]][lp_player] = lp_unitType;
    return CMBT_SlotCount[lp_player];
}

int CMBT_FindEnemySlot (string lp_unitType, string lp_effect) {
    int lv_slot;

    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if (((lp_unitType == CMBT_EnemyType[lv_slot]) && (lp_effect == CMBT_EnemyEffect[lv_slot]))) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if (((lp_effect == CMBT_EnemyEffect[lv_slot]) && (libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_EnemyType[lv_slot]) == true))) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    if ((CMBT_EnemyCount >= (CMBT_ENEMY_OTHER_SLOT - 1))) {
        CMBT_EnemyOverflow += 1;
        CMBT_EnemyCount = CMBT_ENEMY_OTHER_SLOT;
        CMBT_EnemyType[CMBT_ENEMY_OTHER_SLOT] = "_Other";
        CMBT_EnemyEffect[CMBT_ENEMY_OTHER_SLOT] = "_Other";
        return CMBT_ENEMY_OTHER_SLOT;
    }

    CMBT_EnemyCount += 1;
    CMBT_EnemyType[CMBT_EnemyCount] = lp_unitType;
    CMBT_EnemyEffect[CMBT_EnemyCount] = lp_effect;
    return CMBT_EnemyCount;
}

int CMBT_FindSkillSlot (int lp_player, string lp_unitType, string lp_effect) {
    int lv_slot;

    if (((lp_player < 1) || (lp_player > 2) || (lp_unitType == null) || (lp_unitType == "") || (lp_effect == null) || (lp_effect == ""))) {
        return 0;
    }
    lv_slot = 1;
    while ((lv_slot <= CMBT_SkillCount[lp_player])) {
        if (((lp_unitType == CMBT_SkillType[lv_slot][lp_player]) && (lp_effect == CMBT_SkillEffect[lv_slot][lp_player]))) {
            return lv_slot;
        }
        lv_slot += 1;
    }
    if ((CMBT_SkillCount[lp_player] >= CMBT_MAX_SKILL_SLOTS)) {
        CMBT_SkillOverflow[lp_player] += 1;
        return 0;
    }
    CMBT_SkillCount[lp_player] += 1;
    CMBT_SkillType[CMBT_SkillCount[lp_player]][lp_player] = lp_unitType;
    CMBT_SkillEffect[CMBT_SkillCount[lp_player]][lp_player] = lp_effect;
    return CMBT_SkillCount[lp_player];
}

int CMBT_FindVictimSlot (string lp_unitType) {
    int lv_slot;

    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((lp_unitType == CMBT_VictimType[lv_slot])) {
            return lv_slot;
        }
        lv_slot += 1;
    }
    BankValueSetFromInt(CMBT_Bank, CMBT_OUR_UNITS_SECTION, "Count", CMBT_SlotCount[1] + CMBT_SlotCount[2]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_OUR_UNITS_SECTION, "Count", CMBT_SlotCount[1] + CMBT_SlotCount[2]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION, "Count", CMBT_EnemyCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION, "Count", CMBT_VictimCount);
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_VictimType[lv_slot]) == true)) {
            return lv_slot;
        }
        lv_slot += 1;
    }
    if ((CMBT_VictimCount >= CMBT_MAX_VICTIM_SLOTS)) {
        CMBT_VictimOverflow += 1;
        return 0;
    }
    CMBT_VictimCount += 1;
    CMBT_VictimType[CMBT_VictimCount] = lp_unitType;
    return CMBT_VictimCount;
}

// Drains the whole-number part of an accumulator, leaving the remainder for the next frame.
int CMBT_TakeFixed (int lp_slot, int lp_field, int lp_player) {
    int lv_out;

    lv_out = FixedToInt(CMBT_Acc[lp_slot][lp_field][lp_player]);
    CMBT_Acc[lp_slot][lp_field][lp_player] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeEnemyFixed (int lp_slot) {
    int lv_out;

    lv_out = FixedToInt(CMBT_EnemyAcc[lp_slot]);
    CMBT_EnemyAcc[lp_slot] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeVictimFixed (int lp_slot, int lp_field, int lp_player) {
    int lv_out;

    lv_out = FixedToInt(CMBT_VictimAcc[lp_slot][lp_field][lp_player]);
    CMBT_VictimAcc[lp_slot][lp_field][lp_player] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeSkillFixed (int lp_slot, int lp_field, int lp_player) {
    int lv_out;

    lv_out = FixedToInt(CMBT_SkillAcc[lp_slot][lp_field][lp_player]);
    CMBT_SkillAcc[lp_slot][lp_field][lp_player] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeMutBuffFixed (int lp_slot, int lp_field, int lp_direction) {
    int lv_out;

    if ((lp_field == 0)) {
        lv_out = FixedToInt(CMBT_MutBuffDamage[lp_slot][lp_direction]);
        CMBT_MutBuffDamage[lp_slot][lp_direction] -= IntToFixed(lv_out);
        return lv_out;
    }
    lv_out = FixedToInt(CMBT_MutBuffMitigation[lp_slot][lp_direction]);
    CMBT_MutBuffMitigation[lp_slot][lp_direction] -= IntToFixed(lv_out);
    return lv_out;
}

void CMBT_RecordMutBuffDamage (unit lp_unit, int lp_direction, fixed lp_amount, fixed lp_attempted) {
    int lv_slot;
    int lv_stacks;
    fixed lv_mitigation;

    if (((lp_unit == null) || (UnitIsValid(lp_unit) == false))) {
        return;
    }
    lv_mitigation = lp_attempted - lp_amount;
    if ((lv_mitigation < 0.0)) {
        lv_mitigation = 0.0;
    }
    lv_slot = 1;
    while ((lv_slot <= CMBT_MutBuffCount)) {
        if ((((lp_direction == CMBT_MUTBUFF_ENEMY_TO_OUR) && (CMBT_MutBuffTrackOutput[lv_slot] == true)) || ((lp_direction == CMBT_MUTBUFF_OUR_TO_ENEMY) && (CMBT_MutBuffTrackDefense[lv_slot] == true)))) {
            lv_stacks = UnitBehaviorCount(lp_unit, CMBT_MutBuffBehavior[lv_slot]);
            if ((lv_stacks > 0)) {
                CMBT_MutBuffDamage[lv_slot][lp_direction] += lp_amount;
                CMBT_MutBuffMitigation[lv_slot][lp_direction] += lv_mitigation;
                CMBT_MutBuffHits[lv_slot][lp_direction] += 1;
                CMBT_MutBuffStackSum[lv_slot][lp_direction] += lv_stacks;
            }
        }
        lv_slot += 1;
    }
}

// Encodes CMBT_PackBuf[0 .. lp_count-1] as "slot:v0/v1/..", dropping trailing zero fields.
// Returns "" when every field is zero, so the slot is omitted from the frame entirely.
string CMBT_PackRecord (int lp_slot, int lp_count) {
    int lv_i;
    int lv_last;
    string lv_record;

    lv_last = -1;
    lv_i = 0;
    while ((lv_i < lp_count)) {
        if ((CMBT_PackBuf[lv_i] != 0)) {
            lv_last = lv_i;
        }
        lv_i += 1;
    }

    if ((lv_last < 0)) {
        return "";
    }

    lv_record = IntToString(lp_slot) + ":";
    lv_i = 0;
    while ((lv_i <= lv_last)) {
        if ((lv_i > 0)) {
            lv_record += "/";
        }
        lv_record += IntToString(CMBT_PackBuf[lv_i]);
        lv_i += 1;
    }
    return lv_record;
}

// -----------------------------------------------------------------------------
// Frame builders (each drains the accumulators it reports)
// -----------------------------------------------------------------------------
string CMBT_BuildSampleSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        CMBT_PackBuf[0] = CMBT_TakeFixed(lv_slot, CMBT_F_DEALT, lp_player);
        CMBT_PackBuf[1] = CMBT_Present[lv_slot][lp_player];
        CMBT_PackBuf[2] = CMBT_AccInt[lv_slot][CMBT_I_HITS][lp_player];
        CMBT_PackBuf[3] = CMBT_TakeFixed(lv_slot, CMBT_F_OVERKILL, lp_player);
        CMBT_PackBuf[4] = CMBT_TakeFixed(lv_slot, CMBT_F_DEALTNEUTRAL, lp_player);
        CMBT_PackBuf[5] = CMBT_AtkCount[lv_slot][lp_player];
        CMBT_AccInt[lv_slot][CMBT_I_HITS][lp_player] = 0;
        CMBT_AtkCount[lv_slot][lp_player] = 0;

        lv_record = CMBT_PackRecord(lv_slot, 6);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildTakenSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        CMBT_PackBuf[0] = CMBT_TakeFixed(lv_slot, CMBT_F_TAKENLIFE, lp_player);
        CMBT_PackBuf[1] = CMBT_TakeFixed(lv_slot, CMBT_F_TAKENSHIELD, lp_player);
        CMBT_PackBuf[2] = CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lp_player];
        CMBT_PackBuf[3] = CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lp_player];
        CMBT_PackBuf[4] = CMBT_TakeFixed(lv_slot, CMBT_F_HEALLIFE, lp_player);
        CMBT_PackBuf[5] = CMBT_TakeFixed(lv_slot, CMBT_F_HEALSHIELD, lp_player);
        CMBT_PackBuf[6] = CMBT_AccInt[lv_slot][CMBT_I_DISAPPEARED][lp_player];
        CMBT_PackBuf[7] = CMBT_AccInt[lv_slot][CMBT_I_CONSUMED][lp_player];
        CMBT_AccInt[lv_slot][CMBT_I_DISAPPEARED][lp_player] = 0;
        CMBT_AccInt[lv_slot][CMBT_I_CONSUMED][lp_player] = 0;
        CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lp_player] = 0;
        CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lp_player] = 0;

        lv_record = CMBT_PackRecord(lv_slot, 8);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildEnemySegment () {
    int lv_slot;
    int lv_damage;
    string lv_payload;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        lv_damage = CMBT_TakeEnemyFixed(lv_slot);
        if ((lv_damage != 0)) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += (IntToString(lv_slot) + ":" + IntToString(lv_damage));
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildVictimSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        CMBT_PackBuf[0] = CMBT_TakeVictimFixed(lv_slot, CMBT_VF_DAMAGE, lp_player);
        CMBT_PackBuf[1] = CMBT_VictimAccInt[lv_slot][CMBT_VI_HITS][lp_player];
        CMBT_PackBuf[2] = CMBT_TakeVictimFixed(lv_slot, CMBT_VF_OVERKILL, lp_player);
        CMBT_PackBuf[3] = CMBT_VictimAccInt[lv_slot][CMBT_VI_KILLS][lp_player];
        CMBT_VictimAccInt[lv_slot][CMBT_VI_HITS][lp_player] = 0;
        CMBT_VictimAccInt[lv_slot][CMBT_VI_KILLS][lp_player] = 0;
        lv_record = CMBT_PackRecord(lv_slot, 4);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildMutBuffSegment (int lp_direction) {
    int lv_slot;
    int lv_hits;
    int lv_stackAverage;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_MutBuffCount)) {
        lv_hits = CMBT_MutBuffHits[lv_slot][lp_direction];
        lv_stackAverage = 0;
        if ((lv_hits > 0)) {
            lv_stackAverage = FixedToInt((IntToFixed(CMBT_MutBuffStackSum[lv_slot][lp_direction]) * 100.0) / IntToFixed(lv_hits));
        }
        CMBT_PackBuf[0] = CMBT_TakeMutBuffFixed(lv_slot, 0, lp_direction);
        CMBT_PackBuf[1] = lv_hits;
        CMBT_PackBuf[2] = CMBT_TakeMutBuffFixed(lv_slot, 1, lp_direction);
        CMBT_PackBuf[3] = lv_stackAverage;
        CMBT_MutBuffHits[lv_slot][lp_direction] = 0;
        CMBT_MutBuffStackSum[lv_slot][lp_direction] = 0;
        lv_record = CMBT_PackRecord(lv_slot, 4);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildSkillSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_SkillCount[lp_player])) {
        CMBT_PackBuf[0] = CMBT_TakeSkillFixed(lv_slot, 0, lp_player);
        CMBT_PackBuf[1] = CMBT_SkillHits[lv_slot][lp_player];
        CMBT_PackBuf[2] = CMBT_TakeSkillFixed(lv_slot, 1, lp_player);
        CMBT_SkillHits[lv_slot][lp_player] = 0;
        lv_record = CMBT_PackRecord(lv_slot, 3);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildCommandSegment (int lp_player) {
    string lv_payload;

    lv_payload = IntToString(CMBT_CommandCount[lp_player][CMBT_COMMAND_MOVE]) + "/" + IntToString(CMBT_CommandCount[lp_player][CMBT_COMMAND_ATTACK]) + "/" + IntToString(CMBT_CommandCount[lp_player][CMBT_COMMAND_ABILITY]) + "/" + IntToString(CMBT_CommandCount[lp_player][CMBT_COMMAND_OTHER]);
    CMBT_CommandCount[lp_player][CMBT_COMMAND_MOVE] = 0;
    CMBT_CommandCount[lp_player][CMBT_COMMAND_ATTACK] = 0;
    CMBT_CommandCount[lp_player][CMBT_COMMAND_ABILITY] = 0;
    CMBT_CommandCount[lp_player][CMBT_COMMAND_OTHER] = 0;
    return lv_payload;
}

string CMBT_BuildEconSegment (int lp_player) {
    return (IntToString(PlayerGetPropertyInt(lp_player, c_playerPropMinerals)) + "/" + IntToString(PlayerGetPropertyInt(lp_player, c_playerPropVespene)) + "/" + IntToString(PlayerScoreValueGetAsInt(lp_player, "MineralsCollected")) + "/" + IntToString(PlayerScoreValueGetAsInt(lp_player, "VespeneCollected")) + "/" + IntToString(FixedToInt(PlayerGetPropertyFixed(lp_player, c_playerPropSuppliesUsed) * 100.0)) + "/" + IntToString(PlayerGetPropertyInt(lp_player, c_playerPropSuppliesLimit) * 100));
}

string CMBT_BuildHeroSegment (int lp_player) {
    unit lv_hero;
    int lv_deaths;

    lv_hero = libCOMI_gv_cM_HeroUnit[lp_player];
    lv_deaths = libCOMI_gv_cM_HeroDeathCount[lp_player];
    if (((lv_hero == null) || (UnitIsValid(lv_hero) == false))) {
        return "";
    }
    if ((lv_deaths < 0)) {
        lv_deaths = 0;
    }
    return ("1/" + IntToString(BoolToInt(UnitIsAlive(lv_hero))) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropLife, c_unitPropCurrent) * 100.0)) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropShields, c_unitPropCurrent) * 100.0)) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropEnergy, c_unitPropCurrent) * 100.0)) + "/" + IntToString(lv_deaths));
}

// Growth payload. While no supported commander is detected the segment stays empty (frame
// "t|", exporter status "reserved"). Once active every field is written explicitly: a numeric
// zero is an observation, an empty token means "not observable this frame" (e.g. hero dead).
string CMBT_GrowthImplementedKey (int lp_player) {
    if ((lp_player == 2)) { return "GrowthP2Implemented"; }
    return "GrowthImplemented";
}

string CMBT_GrowthSchemaKey (int lp_player) {
    if ((lp_player == 2)) { return "GrowthP2Schema"; }
    return "GrowthSchema";
}

string CMBT_BuildGrowthSegment (int lp_player) {
    int lv_i;
    string lv_payload;

    if ((CMBT_GrowthActive[lp_player] == false)) {
        return "";
    }

    lv_payload = "";
    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        if ((lv_i > 1)) {
            lv_payload += ",";
        }
        if ((CMBT_GrowthKnown[lv_i][lp_player] == true)) {
            lv_payload += IntToString(CMBT_Growth[lv_i][lp_player]);
        }
        lv_i += 1;
    }
    return lv_payload;
}

// 3.2: hostile-to-P1 on-field vitals, one full-map enumeration per sample. Non-structure and
// structure totals are two UnitGroupAlliance passes (precedent LibCOMU.galaxy:4420 / :5540:
// alliance group plus a UnitFilter whose require/exclude halves split the low and high
// target-filter bits). Destructibles such as rocks are neither Structure nor Missile and
// therefore land on the non-structure side (noted in the changelog).
void CMBT_UpdateEnemyField () {
    int lv_i;
    int lv_count;
    fixed lv_hp;
    unitgroup lv_group;
    unit lv_unit;

    CMBT_FieldHpUnits = 0.0;
    CMBT_FieldHpStructures = 0.0;
    CMBT_FieldNUnits = 0;
    CMBT_FieldNStructures = 0;

    lv_group = UnitGroupAlliance(CMBT_FIELD_PLAYER, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_hp = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_hp += UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent);
            CMBT_FieldHpUnits += lv_hp;
            CMBT_FieldNUnits += 1;
        }
        lv_i += 1;
    }

    lv_group = UnitGroupAlliance(CMBT_FIELD_PLAYER, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_hp = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_hp += UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent);
            CMBT_FieldHpStructures += lv_hp;
            CMBT_FieldNStructures += 1;
        }
        lv_i += 1;
    }
}

// 3.2: Field frame body "hu,hs,nu,ns" — every value explicit (measured zeros included). The
// fixed sums restart each sample, so per-frame truncation cannot drift across frames.
string CMBT_BuildFieldSegment () {
    return (IntToString(FixedToInt(CMBT_FieldHpUnits)) + "," + IntToString(FixedToInt(CMBT_FieldHpStructures)) + "," + IntToString(CMBT_FieldNUnits) + "," + IntToString(CMBT_FieldNStructures));
}

// T6 / B-22: enumerate living, visible, non-missile P1/P2 units before serializing.
// Register types even if they have never produced a combat event. Morph pairs use the
// same slot lookup as damage, so both forms contribute to that slot's present count.
void CMBT_UpdatePresent () {
    int lv_player;
    int lv_slot;
    int lv_count;
    int lv_i;
    unitgroup lv_group;
    unit lv_unit;

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_Present[lv_slot][lv_player] = 0;
            lv_slot += 1;
        }
        lv_group = UnitGroup(null, lv_player, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_group, c_unitCountAll);
        lv_i = 1;
        while ((lv_i <= lv_count)) {
            lv_unit = UnitGroupUnit(lv_group, lv_i);
            if ((lv_unit != null)) {
                lv_slot = CMBT_FindSlot(lv_player, UnitGetType(lv_unit), true);
                if ((lv_slot > 0)) {
                    CMBT_Present[lv_slot][lv_player] += 1;
                }
            }
            lv_i += 1;
        }
        lv_player += 1;
    }
}

// T5: commander-specific growth carriers. Malash wired (U22 settled: the three attributes and
// army obedience are CBehaviorAttribute stacks, read with UnitBehaviorCount; precedent
// LibCOMU.galaxy:4388). Nut's stack count is still not wired.
string CMBT_GrowthFieldName (int lp_field) {
    if ((lp_field == CMBT_G_SADISM)) {
        return "Sadism";
    }
    if ((lp_field == CMBT_G_CUNNING)) {
        return "Cunning";
    }
    if ((lp_field == CMBT_G_DOMINION)) {
        return "Dominion";
    }
    if ((lp_field == CMBT_G_OBEDIENCE_MEAN)) {
        return "ObedienceMean";
    }
    if ((lp_field == CMBT_G_OBEDIENCE_MAX)) {
        return "ObedienceMax";
    }
    if ((lp_field == CMBT_G_ARMY_COUNT)) {
        return "ArmyCount";
    }
    if ((lp_field == CMBT_G_CAST_PURGE)) {
        return "CastPurge";
    }
    if ((lp_field == CMBT_G_CAST_SACRIFICE)) {
        return "CastSacrifice";
    }
    if ((lp_field == CMBT_G_CAST_SHACKLES)) {
        return "CastShackles";
    }
    if ((lp_field == CMBT_G_CAST_BREAK)) {
        return "CastBreak";
    }
    if ((lp_field == CMBT_G_CAST_ORDER)) {
        return "CastOrder";
    }
    return "reserved";
}

// Alive units of one exact type owned by one player (same filter the T6 presence count uses).
unitgroup CMBT_OwnedUnitsOfType (int lp_player, string lp_unitType) {
    return UnitGroup(lp_unitType, lp_player, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
}

// Malash detection: the commander string (libCOOC_gv_cCX_PlayerCommander) contains "Malash",
// or a live hero unit of type Malash is owned by the player. Either alone is enough, so a
// non-standard commander string still activates once the hero is on the field.
bool CMBT_IsMalashPlayer (int lp_player) {
    string lv_commander;

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if (((lv_commander != null) && (lv_commander != ""))) {
        if ((StringContains(lv_commander, CMBT_MALASH_HERO, c_stringAnywhere, c_stringNoCase) == true)) {
            return true;
        }
    }
    if ((UnitGroupCount(CMBT_OwnedUnitsOfType(lp_player, CMBT_MALASH_HERO), c_unitCountAlive) > 0)) {
        return true;
    }
    return false;
}

unit CMBT_FindMalashHero (int lp_player) {
    unitgroup lv_group;

    lv_group = CMBT_OwnedUnitsOfType(lp_player, CMBT_MALASH_HERO);
    if ((UnitGroupCount(lv_group, c_unitCountAlive) <= 0)) {
        return null;
    }
    return UnitGroupUnit(lv_group, 1);
}

// Flips the Growth section from "reserved" to the Malash schema in both banks' Meta and in
// bank 2's Units field names. Idempotent; called from CMBT_Start or from the first frame in
// which Malash is detected.
void CMBT_ActivateGrowth (int lp_player) {
    int lv_i;

    CMBT_GrowthActive[lp_player] = true;
    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }

    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, CMBT_GrowthImplementedKey(lp_player), 1);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, CMBT_GrowthImplementedKey(lp_player), 1);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, CMBT_GrowthSchemaKey(lp_player), "Malash");
    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_GROWTH_FIELDS_SECTION, "G" + IntToString(lv_i), CMBT_GrowthFieldName(lv_i));
        lv_i += 1;
    }
}

// Adds every live unit of one army type into the obedience sum / max / count.
// MalashStalkerShadow (the stalker's shadow image) carries no obedience and is not one of the
// four types passed in, so it is excluded by construction.
void CMBT_AccumulateObedience (int lp_player, string lp_unitType) {
    unitgroup lv_group;
    unit lv_unit;
    int lv_count;
    int lv_i;
    int lv_value;

    lv_group = CMBT_OwnedUnitsOfType(lp_player, lp_unitType);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_value = UnitBehaviorCount(lv_unit, CMBT_MALASH_OBEDIENCE);
            CMBT_ObedienceSum += lv_value;
            if ((lv_value > CMBT_ObedienceMax)) {
                CMBT_ObedienceMax = lv_value;
            }
            CMBT_ObedienceCount += 1;
        }
        lv_i += 1;
    }
}

void CMBT_UpdateGrowth (int lp_player) {
    unit lv_hero;
    int lv_i;

    if ((CMBT_GrowthActive[lp_player] == false)) {
        if ((CMBT_IsMalashPlayer(lp_player) == false)) {
            return;
        }
        CMBT_ActivateGrowth(lp_player);
    }

    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        CMBT_Growth[lv_i][lp_player] = 0;
        CMBT_GrowthKnown[lv_i][lp_player] = false;
        lv_i += 1;
    }

    // G1..G3: hero attributes. Unobservable (empty token) while the hero is dead / reviving.
    lv_hero = CMBT_FindMalashHero(lp_player);
    if ((lv_hero != null)) {
        CMBT_Growth[CMBT_G_SADISM][lp_player] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_SADISM);
        CMBT_Growth[CMBT_G_CUNNING][lp_player] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_CUNNING);
        CMBT_Growth[CMBT_G_DOMINION][lp_player] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_DOMINION);
        CMBT_GrowthKnown[CMBT_G_SADISM][lp_player] = true;
        CMBT_GrowthKnown[CMBT_G_CUNNING][lp_player] = true;
        CMBT_GrowthKnown[CMBT_G_DOMINION][lp_player] = true;
    }

    // G4..G6: army obedience over the four army types (ValidatorData.xml TargetIsMalashArmy).
    CMBT_ObedienceSum = 0;
    CMBT_ObedienceMax = 0;
    CMBT_ObedienceCount = 0;
    CMBT_AccumulateObedience(lp_player, "MalashZealot");
    CMBT_AccumulateObedience(lp_player, "MalashAdept");
    CMBT_AccumulateObedience(lp_player, "MalashStalker");
    CMBT_AccumulateObedience(lp_player, "MalashDarkTemplar");
    if ((CMBT_ObedienceCount > 0)) {
        CMBT_Growth[CMBT_G_OBEDIENCE_MEAN][lp_player] = (CMBT_ObedienceSum / CMBT_ObedienceCount);
    }
    CMBT_Growth[CMBT_G_OBEDIENCE_MAX][lp_player] = CMBT_ObedienceMax;
    CMBT_Growth[CMBT_G_ARMY_COUNT][lp_player] = CMBT_ObedienceCount;
    CMBT_GrowthKnown[CMBT_G_OBEDIENCE_MEAN][lp_player] = true;
    CMBT_GrowthKnown[CMBT_G_OBEDIENCE_MAX][lp_player] = true;
    CMBT_GrowthKnown[CMBT_G_ARMY_COUNT][lp_player] = true;

    // G7..G11: casts since the previous frame (T5b event counters), then drained.
    lv_i = CMBT_G_CAST_PURGE;
    while ((lv_i <= CMBT_G_CAST_ORDER)) {
        CMBT_Growth[lv_i][lp_player] = CMBT_CastCount[lv_i][lp_player];
        CMBT_CastCount[lv_i][lp_player] = 0;
        CMBT_GrowthKnown[lv_i][lp_player] = true;
        lv_i += 1;
    }
}

void CMBT_RegisterUnitKeys () {
    int lv_player;
    int lv_slot;
    string lv_key;

    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_SlotCount[lv_player])) {
            if ((CMBT_SlotNamed[lv_slot][lv_player] == false)) {
                lv_key = CMBT_UnitKey(lv_player, lv_slot);
                BankValueSetFromString(CMBT_Bank, CMBT_OUR_UNITS_SECTION, lv_key, CMBT_SlotType[lv_slot][lv_player]);
                BankValueSetFromString(CMBT_Bank2, CMBT_OUR_UNITS_SECTION, lv_key, CMBT_SlotType[lv_slot][lv_player]);
                CMBT_SlotNamed[lv_slot][lv_player] = true;
            }
            lv_slot += 1;
        }
        lv_player += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if ((CMBT_EnemyNamed[lv_slot] == false)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION, "E" + IntToString(lv_slot), CMBT_EnemyType[lv_slot] + "~" + CMBT_EnemyEffect[lv_slot]);
            CMBT_EnemyNamed[lv_slot] = true;
        }
        lv_slot += 1;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_SkillCount[lv_player])) {
            if ((CMBT_SkillNamed[lv_slot][lv_player] == false)) {
                if ((lv_player == 1)) {
                    BankValueSetFromString(CMBT_Bank2, CMBT_SKILL_P1_SECTION, "S" + IntToString(lv_slot), CMBT_SkillType[lv_slot][lv_player] + "~" + CMBT_SkillEffect[lv_slot][lv_player]);
                }
                else {
                    BankValueSetFromString(CMBT_Bank2, CMBT_SKILL_P2_SECTION, "S" + IntToString(lv_slot), CMBT_SkillType[lv_slot][lv_player] + "~" + CMBT_SkillEffect[lv_slot][lv_player]);
                }
                CMBT_SkillNamed[lv_slot][lv_player] = true;
            }
            lv_slot += 1;
        }
        lv_player += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_SKILL_P1_SECTION, "Count", CMBT_SkillCount[1]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_SKILL_P2_SECTION, "Count", CMBT_SkillCount[2]);

    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((CMBT_VictimNamed[lv_slot] == false)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION, "V" + IntToString(lv_slot), CMBT_VictimType[lv_slot]);
            CMBT_VictimNamed[lv_slot] = true;
        }
        lv_slot += 1;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        if (((libCOMI_gv_cM_HeroUnit[lv_player] != null) && (UnitIsValid(libCOMI_gv_cM_HeroUnit[lv_player]) == true))) {
            BankValueSetFromString(CMBT_Bank2, CMBT_HERO_UNITS_SECTION, "P" + IntToString(lv_player), UnitGetType(libCOMI_gv_cM_HeroUnit[lv_player]));
        }
        lv_player += 1;
    }
}

// Settles U21/U24 in the first captured game: is the Unit Damaged event raised before or
// after the damage is applied? Writes the first CMBT_ORDER_PROBE_MAX hits taken by our units
// as "type|amount|life|lifeMax|shields|shieldsMax" (all x100, integer). If life+shields
// equals the maximum, the event fires pre-application and the life/shield split plus the
// overkill column are exact; if it equals maximum-amount, the event fires post-application
// and both are re-derived offline. One-shot, no per-frame cost.
void CMBT_RecordOrderProbe (unit lp_unit, fixed lp_amount) {
    string lv_value;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    if ((CMBT_OrderProbeCount >= CMBT_ORDER_PROBE_MAX)) {
        return;
    }

    CMBT_OrderProbeCount += 1;
    lv_value = UnitGetType(lp_unit);
    lv_value += "|" + IntToString(FixedToInt(lp_amount * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropLife, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropLifeMax, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropShields, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropShieldsMax, c_unitPropCurrent) * 100.0));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "OrderProbe" + IntToString(CMBT_OrderProbeCount), lv_value);
}

// First eight distinct (victim player, raw alliance flags) observations from P1/P2.
// These booleans do not yet establish a positive neutral classification. Preserve the
// first source player for each combination; later sources with the same flags dedupe.
void CMBT_RecordAllianceProbe (int lp_sourcePlayer, int lp_victimPlayer) {
    int lv_i;
    string lv_flags;
    string lv_key;

    if (((CMBT_Bank2 == null) || (CMBT_AllianceProbeCount >= CMBT_ALLIANCE_PROBE_MAX))) {
        return;
    }
    if (((lp_sourcePlayer != 1) && (lp_sourcePlayer != 2))) {
        return;
    }
    lv_flags = "";
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdVision, lp_victimPlayer) == true)) {
        lv_flags += "V1";
    }
    else {
        lv_flags += "V0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdControl, lp_victimPlayer) == true)) {
        lv_flags += "C1";
    }
    else {
        lv_flags += "C0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdPassive, lp_victimPlayer) == true)) {
        lv_flags += "Pa1";
    }
    else {
        lv_flags += "Pa0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdPushable, lp_victimPlayer) == true)) {
        lv_flags += "Pu1";
    }
    else {
        lv_flags += "Pu0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdSpend, lp_victimPlayer) == true)) {
        lv_flags += "Sp1";
    }
    else {
        lv_flags += "Sp0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdDefeat, lp_victimPlayer) == true)) {
        lv_flags += "De1";
    }
    else {
        lv_flags += "De0";
    }
    lv_key = IntToString(lp_victimPlayer) + "|" + lv_flags;
    lv_i = 0;
    while ((lv_i < CMBT_AllianceProbeCount)) {
        if ((CMBT_AllianceProbeKey[lv_i] == lv_key)) {
            return;
        }
        lv_i += 1;
    }
    CMBT_AllianceProbeKey[CMBT_AllianceProbeCount] = lv_key;
    CMBT_AllianceProbeCount += 1;
    BankValueSetFromString(CMBT_Bank2, CMBT_DIAG_SECTION, "AllianceProbe" + IntToString(CMBT_AllianceProbeCount), IntToString(lp_sourcePlayer) + "|" + lv_key);
}

string CMBT_BuildProbe () {
    int lv_i;
    string lv_out;

    lv_out = "";
    lv_i = 0;
    while ((lv_i < CMBT_PROBE_REPEATS)) {
        lv_out += "0123456789";
        lv_i += 1;
    }
    return lv_out;
}

string CMBT_EventField (string lp_value) {
    string lv_value;

    lv_value = lp_value;
    if ((lv_value == null)) {
        return "";
    }
    lv_value = StringReplaceWord(lv_value, "|", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, ";", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\n", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\r", "_", c_stringReplaceAll, c_stringCase);
    return lv_value;
}

void CMBT_AppendEvent (string lp_type, int lp_player, string lp_subject, string lp_value, string lp_source, string lp_precision) {
    int lv_sequence;
    string lv_event;
    string lv_candidate;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    if ((CMBT_EventCount >= CMBT_EVENT_MAX)) {
        CMBT_EventOverflow += 1;
        return;
    }
    lv_sequence = CMBT_EventCount + 1;
    lv_event = IntToString(lv_sequence) + "|" + IntToString(FixedToInt(GameGetMissionTime())) + "|" + CMBT_EventField(lp_type) + "|" + IntToString(lp_player) + "|" + CMBT_EventField(lp_subject) + "|" + CMBT_EventField(lp_value) + "|" + CMBT_EventField(lp_source) + "|" + CMBT_EventField(lp_precision);
    if ((StringLength(lv_event) > CMBT_EVENT_MAX_CHARS)) {
        CMBT_EventOverflow += 1;
        return;
    }
    if ((CMBT_EventChunkEntries >= CMBT_EVENTS_PER_CHUNK)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_EVENTS_SECTION, "C" + IntToString(CMBT_EventChunkIndex), CMBT_EventChunkText);
        CMBT_EventChunkText = "";
        CMBT_EventChunkEntries = 0;
    }
    if ((CMBT_EventChunkEntries == 0)) {
        if ((CMBT_EventChunkIndex >= CMBT_MAX_CHUNKS)) {
            CMBT_EventOverflow += 1;
            return;
        }
        CMBT_EventChunkIndex += 1;
    }
    lv_candidate = CMBT_EventChunkText;
    if ((CMBT_EventChunkEntries > 0)) {
        lv_candidate += ";";
    }
    lv_candidate += lv_event;
    if ((StringLength(lv_candidate) > CMBT_EVENT_CHUNK_MAX_CHARS)) {
        CMBT_EventOverflow += 1;
        return;
    }
    CMBT_EventChunkText = lv_candidate;
    CMBT_EventChunkEntries += 1;
    CMBT_EventCount = lv_sequence;
}

bool CMBT_IsTrackedMutatorUnitType (string lp_type) {
    return (CMBT_MutatorFactorForUnitType(lp_type) != "");
}

void CMBT_FlushMutatorEvents () {
    int lv_i;
    string lv_value;

    lv_i = 1;
    while ((lv_i <= CMBT_MutBuffCount)) {
        if (((CMBT_MutBehaviorAdd[lv_i] + CMBT_MutBehaviorRemove[lv_i] + CMBT_MutBehaviorRefresh[lv_i]) > 0)) {
            lv_value = CMBT_MutBehaviorLastUnit[lv_i] + ",add=" + IntToString(CMBT_MutBehaviorAdd[lv_i]) + ",remove=" + IntToString(CMBT_MutBehaviorRemove[lv_i]) + ",refresh=" + IntToString(CMBT_MutBehaviorRefresh[lv_i]) + ",last=" + IntToString(CMBT_MutBehaviorLastStack[lv_i]);
            CMBT_AppendEvent("MutatorBehavior5s", CMBT_MutBehaviorLastOwner[lv_i], CMBT_MutBuffBehavior[lv_i], lv_value, CMBT_MutBuffFactor[lv_i], "5s_aggregate");
            CMBT_MutBehaviorAdd[lv_i] = 0;
            CMBT_MutBehaviorRemove[lv_i] = 0;
            CMBT_MutBehaviorRefresh[lv_i] = 0;
        }
        lv_i += 1;
    }
    lv_i = 1;
    while ((lv_i <= CMBT_MutatorEffectCount)) {
        if ((CMBT_MutEffectUseCount[lv_i] > 0)) {
            lv_value = CMBT_MutEffectLastUnit[lv_i] + ",count=" + IntToString(CMBT_MutEffectUseCount[lv_i]);
            CMBT_AppendEvent("MutatorEffect5s", CMBT_MutEffectLastOwner[lv_i], CMBT_MutatorEffectId[lv_i], lv_value, CMBT_MutatorEffectFactor[lv_i], "5s_aggregate");
            CMBT_MutEffectUseCount[lv_i] = 0;
        }
        lv_i += 1;
    }
}

void CMBT_UpdateChaosEvents () {
    while (((CMBT_ChaosHistoryLogged < CMUIX_ResultChaosHistoryCount) && (CMBT_ChaosHistoryLogged < CMBT_CHAOS_HISTORY_MAX))) {
        CMBT_ChaosHistoryLogged += 1;
        CMBT_AppendEvent("ChaosRotated", 0, CMUIX_ResultChaosHistoryMutators[CMBT_ChaosHistoryLogged], IntToString(BoolToInt(CMUIX_ResultChaosHistoryEnhanced[CMBT_ChaosHistoryLogged])), "ChaosHistory", "5s_bucket_end");
    }
}

void CMBT_PrimeObjectives () {
    int lv_i;
    string lv_objective;

    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        CMBT_ObjectiveLast[lv_i] = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        lv_i += 1;
    }
}

void CMBT_UpdateObjectives () {
    int lv_i;
    string lv_objective;
    string lv_entry;

    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        lv_entry = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        if ((lv_entry != CMBT_ObjectiveLast[lv_i])) {
            CMBT_AppendEvent("ObjectiveChanged", 0, lv_objective, lv_entry, "ObjectivePoll", "5s_bucket_end");
            CMBT_ObjectiveLast[lv_i] = lv_entry;
        }
        lv_i += 1;
    }
}

void CMBT_WriteIdentityMeta (bank lp_bank, int lp_startedAt, string lp_bankName, string lp_otherBankName) {
    string lv_enemy;

    lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    if (((lv_enemy == null) || (lv_enemy == ""))) {
        lv_enemy = libCOMI_gv_cM_CoopAIPlayer_Commander[3];
    }
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "StartedAt", lp_startedAt);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "LegacyEpoch", lp_startedAt);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "LegacyBank1", "CMCombatTelemetry" + IntToString(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "LegacyBank2", "CMCombatTelemetryX" + IntToString(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "BankName", lp_bankName);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "WallStartInt", lp_startedAt);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallStartText", CMBT_WallText(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallClockSource", "CurrentDateTimeGet");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallClockTimezone", "Unspecified");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapInstance", CMUIX_MapSelectionCurrentMapInstance());
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "EnemyAI", lv_enemy);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "EnemyRace", CMUIX_EnemySelectionRaceForEnemy(lv_enemy));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyBase", CMUIX_DifficultySelectedBase);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyPlus", CMUIX_DifficultySelectedPlus);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyP1", libCOMI_gf_DifficultyLevelForPlayerCoop(1));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyP2", libCOMI_gf_DifficultyLevelForPlayerCoop(2));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "MissionDifficulty", libCOMI_gf_GetMissionDifficulty());
    if ((lp_bankName == CMBT_BankName)) {
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank2", lp_otherBankName);
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank2Name", lp_otherBankName);
    }
    else {
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank1", lp_otherBankName);
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank1Name", lp_otherBankName);
    }
}

void CMBT_AppendDirectMutator (string lp_mutator, bool lp_enhanced) {
    if (((lp_mutator == "") || (lp_mutator == null) || (CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true))) {
        return;
    }
    if ((lp_mutator == "Chaos") || (UserDataGetInt("Mutators", lp_mutator, "Auto - Actived By Chaos", 1) >= 1) || (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lp_mutator) == true)) {
        return;
    }
    if ((CMBT_DirectMutatorCount >= CMBT_DIRECT_MUTATOR_MAX)) {
        CMBT_MutatorOverflow += 1;
        return;
    }
    CMBT_DirectMutatorCount += 1;
    BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "D" + IntToString(CMBT_DirectMutatorCount), lp_mutator + "|" + IntToString(BoolToInt(lp_enhanced)));
}

void CMBT_CaptureMutators () {
    int lv_i;
    int lv_count;
    int lv_chaosCount;
    string lv_mutator;
    bool lv_enhanced;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_MUTATORS_SECTION);
    CMBT_DirectMutatorCount = 0;
    CMBT_MutatorOverflow = 0;
    CMBT_IndexSlot = 0;
    CMBT_IndexOverflow = 0;
    lv_i = 1;
    lv_count = 0;
    lv_chaosCount = 0;
    lv_mutator = "";
    lv_enhanced = false;
    if ((((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) || (CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) && (libCOMU_gv_cT_MAbomination_MutatorsCount > 0))) {
        lv_count = MinI(libCOMU_gv_cT_MAbomination_MutatorsCount, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
        while ((lv_i <= lv_count)) {
            CMBT_AppendDirectMutator(libCOMU_gv_cT_MAbomination_Mutators[lv_i], libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_i]);
            lv_i += 1;
        }
    }
    else {
        lv_count = UserDataInstanceCount("Mutators");
        while ((lv_i <= lv_count)) {
            lv_mutator = UserDataInstance("Mutators", lv_i);
            if ((lv_mutator != "") && (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1) == 0) && (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lv_mutator) == false)) {
                if ((UserDataGetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1) >= 1) || (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1) >= 1)) {
                    lv_enhanced = (UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1);
                    CMBT_AppendDirectMutator(lv_mutator, lv_enhanced);
                }
            }
            lv_i += 1;
        }
    }
    lv_chaosCount = MinI(libCOTF_gv_rT_ChaosCycleCount, CMBT_DIRECT_MUTATOR_MAX);
    lv_i = 1;
    while ((lv_i <= lv_chaosCount)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "A" + IntToString(lv_i), libCOTF_gv_rT_ChaosMutators[lv_i] + "|" + IntToString(BoolToInt(libCOMU_gf_MutatorIsEnhanced(libCOTF_gv_rT_ChaosMutators[lv_i]))));
        lv_i += 1;
    }
    if ((libCOTF_gv_rT_ChaosCycleCount > CMBT_DIRECT_MUTATOR_MAX)) {
        CMBT_MutatorOverflow += (libCOTF_gv_rT_ChaosCycleCount - CMBT_DIRECT_MUTATOR_MAX);
    }
    lv_i = 1;
    while (((lv_i <= CMUIX_ResultChaosHistoryCount) && (lv_i <= CMBT_CHAOS_HISTORY_MAX))) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "C" + IntToString(lv_i), CMUIX_ResultChaosHistoryMutators[lv_i] + "|" + IntToString(BoolToInt(CMUIX_ResultChaosHistoryEnhanced[lv_i])));
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "DirectCount", CMBT_DirectMutatorCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "ChaosSlotCount", lv_chaosCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "ChaosHistoryCount", MinI(CMUIX_ResultChaosHistoryCount, CMBT_CHAOS_HISTORY_MAX));
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "Overflow", CMBT_MutatorOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "Truncated", BoolToInt((CMBT_MutatorOverflow > 0) || (CMUIX_ResultChaosHistoryCount >= CMBT_CHAOS_HISTORY_MAX)));
}

void CMBT_CapturePlayers () {
    int lv_player;
    int lv_i;
    int lv_count;
    int lv_masteryIndex;
    int lv_prestige;
    int lv_level;
    string lv_commander;
    string lv_mastery;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_PLAYERS_SECTION);
    lv_player = 1;
    lv_i = 0;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryIndex = 0;
    lv_prestige = 0;
    lv_level = 0;
    lv_commander = "";
    lv_mastery = "";
    while ((lv_player <= 2)) {
        lv_commander = CMUIX_ResultSnapshotCommander(lv_player);
        lv_prestige = 0;
        lv_level = 0;
        if (((lv_commander != "") && (lv_commander != null))) {
            lv_prestige = CMUIX_ReadPrestigeForCommander(lv_player, lv_commander);
            lv_level = libCOOC_gf_CC_CommanderLevel(lv_player, lv_commander);
        }
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Present", BoolToInt((PlayerStatus(lv_player) == c_playerStatusActive) && (PlayerType(lv_player) == c_playerTypeUser)));
        BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Name", TextToString(PlayerName(lv_player)));
        BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Commander", lv_commander);
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Prestige", lv_prestige);
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Level", lv_level);
        lv_masteryIndex = 1;
        while ((lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "M" + IntToString(lv_masteryIndex), "|0");
            lv_masteryIndex += 1;
        }
        lv_i = 1;
        while ((lv_i <= lv_count)) {
            lv_mastery = UserDataInstance("MasteryUpgrades", lv_i);
            if ((UserDataGetUserInstance("MasteryUpgrades", lv_mastery, "Commander", 1) == lv_commander)) {
                lv_masteryIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lv_mastery);
                if (((lv_masteryIndex >= 1) && (lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER))) {
                    BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "M" + IntToString(lv_masteryIndex), lv_mastery + "|" + IntToString(libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lv_player, lv_mastery)));
                }
            }
            lv_i += 1;
        }
        lv_player += 1;
    }
}

string CMBT_ScoreKey (int lp_index) {
    if ((lp_index == 1)) { return "UnitsStructuresKilled"; }
    if ((lp_index == 2)) { return "UnitsProduced"; }
    if ((lp_index == 3)) { return "ResourcesGathered"; }
    if ((lp_index == 4)) { return libCOOC_gf_CC_MapScoreStatistic(libCOOC_gf_CC_CurrentMap()); }
    if ((lp_index == 5)) { return libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultSnapshotCommander(1)); }
    if ((lp_index == 6)) { return libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultSnapshotCommander(1)); }
    if ((lp_index == 7)) { return libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultSnapshotCommander(2)); }
    if ((lp_index == 8)) { return libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultSnapshotCommander(2)); }
    return "UnitsLostCount";
}

void CMBT_CaptureOutcomeData () {
    int lv_i;
    int lv_count;
    string lv_objective;
    string lv_entry;
    string lv_key;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_OBJECTIVES_SECTION);
    BankSectionRemove(CMBT_Bank2, CMBT_SCORE_STATS_SECTION);
    lv_i = 1;
    lv_count = 0;
    lv_objective = "";
    lv_entry = "";
    lv_key = "";
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        lv_entry = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        if ((lv_entry != "")) {
            lv_count += 1;
            BankValueSetFromString(CMBT_Bank2, CMBT_OBJECTIVES_SECTION, "O" + IntToString(lv_count), lv_entry);
        }
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_OBJECTIVES_SECTION, "Count", lv_count);
    lv_i = 1;
    while ((lv_i <= 9)) {
        lv_key = CMBT_ScoreKey(lv_i);
        BankValueSetFromString(CMBT_Bank2, CMBT_SCORE_STATS_SECTION, "S" + IntToString(lv_i), lv_key + "|" + IntToString(PlayerScoreValueGetAsInt(1, lv_key)) + "|" + IntToString(PlayerScoreValueGetAsInt(2, lv_key)));
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_SCORE_STATS_SECTION, "Count", 9);
}

void CMBT_UpdateIndex (int lp_complete, int lp_truncated, int lp_result) {
    int lv_next;
    string lv_key;
    string lv_value;

    if ((CMBT_IndexBank == null)) {
        return;
    }
    if ((CMBT_IndexSlot <= 0)) {
        lv_next = 1;
        if ((BankKeyExists(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot") == true)) {
            lv_next = BankValueGetAsInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot");
        }
        if (((lv_next < 1) || (lv_next > CMBT_INDEX_MAX))) {
            lv_next = 1;
        }
        CMBT_IndexSlot = lv_next;
        lv_key = "R" + IntToString(CMBT_IndexSlot);
        if ((BankKeyExists(CMBT_IndexBank, CMBT_INDEX_RUNS_SECTION, lv_key) == true)) {
            CMBT_IndexOverflow += 1;
        }
        lv_next = CMBT_IndexSlot + 1;
        if ((lv_next > CMBT_INDEX_MAX)) {
            lv_next = 1;
        }
        BankValueSetFromInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot", lv_next);
    }
    lv_key = "R" + IntToString(CMBT_IndexSlot);
    lv_value = CMBT_BankName + "|" + CMBT_Bank2Name + "|" + IntToString(lp_complete) + "|" + IntToString(lp_truncated) + "|" + IntToString(lp_result) + "|" + IntToString(FixedToInt(GameGetMissionTime()));
    BankValueSetFromString(CMBT_IndexBank, CMBT_INDEX_RUNS_SECTION, lv_key, lv_value);
    BankValueSetFromInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "IndexOverflow", CMBT_IndexOverflow);
    BankSave(CMBT_IndexBank);
}

// Provenance written into both banks so a CSV can always be traced back to what produced it.
//   ScriptVersion : this module's own version.
//   GameVersion / ModVersion : the mod's declared strings (libCOMI_InitVariables,
//     LibCOMI.galaxy:39-40). The engine exposes NO version native — the native name table in
//     SC2_x64.exe carries GameMapName / GameMapDescription / GameMapPath / GameMapIsBlizzard
//     but nothing version-related — so "5.0.10 (89165)" is the build the mod is maintained
//     against, not a live read. GameVersionSource says so inside the bank too.
//   MapName / MapPath : live natives (precedent: cmui_customization.galaxy:17004-17005, where
//     GameMapPath() is assigned to a string and GameMapName() goes through TextToString).
//     MapPath is the closest thing to a map version: no native exposes one.
void CMBT_WriteEnvironmentMeta (bank lp_bank) {
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "ScriptVersion", CMBT_SCRIPT_VERSION);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "GameVersion", libCOMI_gv_cT_CurrentVersion);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "GameVersionSource", "libCOMI_gv_cT_CurrentVersion; mod-declared target build, no engine native exists");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "ModVersion", libCOMI_gv_cT_CM_CurrentVersion);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapName", TextToString(GameMapName()));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapPath", GameMapPath());
}

// -----------------------------------------------------------------------------
// Session state
// -----------------------------------------------------------------------------
void CMBT_ResetStoredSession () {
    if ((CMBT_Bank != null)) {
        BankSectionRemove(CMBT_Bank, CMBT_META_SECTION);
        BankSectionRemove(CMBT_Bank, CMBT_OUR_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank, CMBT_SAMPLES_SECTION);
    }
    if ((CMBT_Bank2 != null)) {
        BankSectionRemove(CMBT_Bank2, CMBT_META_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_OUR_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_GROWTH_FIELDS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_HERO_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTBUFFS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_SKILL_P1_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_SKILL_P2_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTATOR_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTATOR_EFFECTS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_PLAYERS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTATORS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_OBJECTIVES_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_SCORE_STATS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_TAKEN_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ENEMY_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_GROWTH_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_GROWTH_P2_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_FIELD_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_VICTIM_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ECON_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_HERO_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTBUFF_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_SKILL_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_COMMANDS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_EVENTS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_DIAG_SECTION);
    }
}

void CMBT_ResetState () {
    int lv_player;
    int lv_slot;
    int lv_field;
    int lv_i;

    lv_player = 1;
    while ((lv_player <= 2)) {
        CMBT_SlotCount[lv_player] = 0;
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_SlotType[lv_slot][lv_player] = "";
            CMBT_SlotNamed[lv_slot][lv_player] = false;
            CMBT_Present[lv_slot][lv_player] = 0;
            lv_field = 0;
            while ((lv_field < CMBT_FIXED_FIELDS)) {
                CMBT_Acc[lv_slot][lv_field][lv_player] = 0.0;
                lv_field += 1;
            }
            lv_field = 0;
            while ((lv_field < CMBT_INT_FIELDS)) {
                CMBT_AccInt[lv_slot][lv_field][lv_player] = 0;
                lv_field += 1;
            }
            lv_slot += 1;
        }
        CMBT_SkillCount[lv_player] = 0;
        CMBT_SkillOverflow[lv_player] = 0;
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SKILL_SLOTS)) {
            CMBT_SkillType[lv_slot][lv_player] = "";
            CMBT_SkillEffect[lv_slot][lv_player] = "";
            CMBT_SkillNamed[lv_slot][lv_player] = false;
            CMBT_SkillAcc[lv_slot][0][lv_player] = 0.0;
            CMBT_SkillAcc[lv_slot][1][lv_player] = 0.0;
            CMBT_SkillHits[lv_slot][lv_player] = 0;
            lv_slot += 1;
        }
        lv_field = 0;
        while ((lv_field < CMBT_COMMAND_FIELDS)) {
            CMBT_CommandCount[lv_player][lv_field] = 0;
            lv_field += 1;
        }
        lv_player += 1;
    }

    CMBT_EnemyCount = 0;
    lv_slot = 1;
    while ((lv_slot <= CMBT_MAX_ENEMY_SLOTS)) {
        CMBT_EnemyType[lv_slot] = "";
        CMBT_EnemyEffect[lv_slot] = "";
        CMBT_EnemyNamed[lv_slot] = false;
        CMBT_EnemyAcc[lv_slot] = 0.0;
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_MutBuffCount)) {
        lv_field = 0;
        while ((lv_field < 2)) {
            CMBT_MutBuffDamage[lv_slot][lv_field] = 0.0;
            CMBT_MutBuffMitigation[lv_slot][lv_field] = 0.0;
            CMBT_MutBuffHits[lv_slot][lv_field] = 0;
            CMBT_MutBuffStackSum[lv_slot][lv_field] = 0;
            lv_field += 1;
        }
        CMBT_MutBehaviorAdd[lv_slot] = 0;
        CMBT_MutBehaviorRemove[lv_slot] = 0;
        CMBT_MutBehaviorRefresh[lv_slot] = 0;
        CMBT_MutBehaviorLastStack[lv_slot] = 0;
        CMBT_MutBehaviorLastOwner[lv_slot] = 0;
        CMBT_MutBehaviorLastUnit[lv_slot] = "";
        lv_slot += 1;
    }
    lv_slot = 1;
    while ((lv_slot <= CMBT_MutatorEffectCount)) {
        CMBT_MutEffectUseCount[lv_slot] = 0;
        CMBT_MutEffectLastOwner[lv_slot] = 0;
        CMBT_MutEffectLastUnit[lv_slot] = "";
        lv_slot += 1;
    }

    CMBT_VictimCount = 0;
    CMBT_VictimOverflow = 0;
    lv_slot = 1;
    while ((lv_slot <= CMBT_MAX_VICTIM_SLOTS)) {
        CMBT_VictimType[lv_slot] = "";
        CMBT_VictimNamed[lv_slot] = false;
        lv_player = 1;
        while ((lv_player <= 2)) {
            lv_field = 0;
            while ((lv_field < 2)) {
                CMBT_VictimAcc[lv_slot][lv_field][lv_player] = 0.0;
                CMBT_VictimAccInt[lv_slot][lv_field][lv_player] = 0;
                lv_field += 1;
            }
            lv_player += 1;
        }
        lv_slot += 1;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_i = 1;
        while ((lv_i <= CMBT_GROWTH_FIELDS)) {
            CMBT_Growth[lv_i][lv_player] = 0;
            CMBT_GrowthKnown[lv_i][lv_player] = false;
            CMBT_CastCount[lv_i][lv_player] = 0;
            lv_i += 1;
        }
        CMBT_GrowthActive[lv_player] = false;
        CMBT_FriendlyPlayerHits[lv_player] = 0;
        CMBT_FriendlyPlayerDamage[lv_player] = 0.0;
        lv_player += 1;
    }
    CMBT_ObedienceSum = 0;
    CMBT_ObedienceMax = 0;
    CMBT_ObedienceCount = 0;

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_AtkCount[lv_slot][lv_player] = 0;
            CMBT_AtkLastTag[lv_slot][lv_player] = 0;
            CMBT_AtkLastEffect[lv_slot][lv_player] = "";
            CMBT_AtkLastTime[lv_slot][lv_player] = 0.0;
            lv_slot += 1;
        }
        lv_player += 1;
    }
    CMBT_FieldHpUnits = 0.0;
    CMBT_FieldHpStructures = 0.0;
    CMBT_FieldNUnits = 0;
    CMBT_FieldNStructures = 0;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        CMBT_ChunkText[lv_i] = "";
        CMBT_ChunkFrames[lv_i] = 0;
        CMBT_ChunkIndex[lv_i] = 0;
        lv_i += 1;
    }

    CMBT_SampleCount = 0;
    CMBT_SlotOverflow = 0;
    CMBT_EnemyOverflow = 0;
    CMBT_OrderProbeCount = 0;
    CMBT_AllianceProbeCount = 0;
    lv_i = 0;
    while ((lv_i < CMBT_ALLIANCE_PROBE_MAX)) {
        CMBT_AllianceProbeKey[lv_i] = "";
        lv_i += 1;
    }
    CMBT_NeutralHits = 0;
    CMBT_FriendlyHits = 0;
    CMBT_UnclassifiedHits = 0;
    CMBT_FilteredNullVictim = 0;
    CMBT_NeutralDamage = 0.0;
    CMBT_FriendlyDamage = 0.0;
    CMBT_UnclassifiedDamage = 0.0;
    CMBT_FilteredNullVictimDamage = 0.0;
    CMBT_Truncated = false;
    CMBT_EventChunkText = "";
    CMBT_EventChunkEntries = 0;
    CMBT_EventChunkIndex = 0;
    CMBT_EventCount = 0;
    CMBT_EventOverflow = 0;
    CMBT_MutBuffOverflow = 0;
    CMBT_ChaosHistoryLogged = 0;
    CMBT_DirectMutatorCount = 0;
    CMBT_MutatorOverflow = 0;
    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        CMBT_ObjectiveLast[lv_i] = "";
        lv_i += 1;
    }
}

void CMBT_SetCapture (bool lp_on) {
    TriggerEnable(CMBT_DamageTrigger, lp_on);
    TriggerEnable(CMBT_DiedTrigger, lp_on);
    TriggerEnable(CMBT_HealLifeTrigger, lp_on);
    TriggerEnable(CMBT_HealShieldTrigger, lp_on);
    TriggerEnable(CMBT_AbilPurgeTrigger, lp_on);
    TriggerEnable(CMBT_AbilSacrificeTrigger, lp_on);
    TriggerEnable(CMBT_AbilShacklesTrigger, lp_on);
    TriggerEnable(CMBT_AbilBreakTrigger, lp_on);
    TriggerEnable(CMBT_AbilOrderTrigger, lp_on);
    TriggerEnable(CMBT_ResearchTrigger, lp_on);
    TriggerEnable(CMBT_UpgradeTrigger, lp_on);
    TriggerEnable(CMBT_PlayerLeftTrigger, lp_on);
    // Revive evidence stays enabled for the match, independently of capture.
    // Birth evidence stays enabled for the match, independently of capture.
    TriggerEnable(CMBT_MutBehaviorTrigger, lp_on);
    TriggerEnable(CMBT_MutEffectTrigger, lp_on);
    TriggerEnable(CMBT_CommandTrigger, lp_on);
}

// -----------------------------------------------------------------------------
// Chunk plumbing
// -----------------------------------------------------------------------------
// True while every section can still open another key without crossing CMBT_MAX_CHUNKS.
// 720 samples at 6 frames per key is 120 keys, so this only fires if the caps are retuned.
bool CMBT_CapacityOK () {
    int lv_i;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if (((CMBT_ChunkFrames[lv_i] == 0) && (CMBT_ChunkIndex[lv_i] >= CMBT_MAX_CHUNKS))) {
            return false;
        }
        lv_i += 1;
    }
    return true;
}

void CMBT_StreamAppend (int lp_stream, string lp_frame) {
    if ((CMBT_ChunkFrames[lp_stream] == 0)) {
        CMBT_ChunkIndex[lp_stream] += 1;
        CMBT_ChunkText[lp_stream] = "";
    }
    else {
        CMBT_ChunkText[lp_stream] += ";";
    }
    CMBT_ChunkText[lp_stream] += lp_frame;
    CMBT_ChunkFrames[lp_stream] += 1;
}

void CMBT_RollChunks () {
    int lv_i;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if ((CMBT_ChunkFrames[lv_i] >= CMBT_FRAMES_PER_CHUNK)) {
            CMBT_ChunkText[lv_i] = "";
            CMBT_ChunkFrames[lv_i] = 0;
        }
        lv_i += 1;
    }
}

// Whole-session source-side counters mirrored to both banks; friendly damage also splits P1/P2.
// All keys are written even before the first sample; absence never means measured zero.
// Neutral stays zero in 3.1a. Unknown alliances remain separate until engine observation.
void CMBT_WriteVictimMeta (bank lp_bank) {
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyP1Hits", CMBT_FriendlyPlayerHits[1]);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyP2Hits", CMBT_FriendlyPlayerHits[2]);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyP1Damage", FixedToInt(CMBT_FriendlyPlayerDamage[1]));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyP2Damage", FixedToInt(CMBT_FriendlyPlayerDamage[2]));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "BirthP1Overflow", CMBT_BirthOverflow[1]);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "BirthP2Overflow", CMBT_BirthOverflow[2]);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "DeathLedger", "de=real_enemy; ds=real_other; nc=noncombat; bc=construction");
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "NeutralHits", CMBT_NeutralHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "NeutralDamage", FixedToInt(CMBT_NeutralDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyHits", CMBT_FriendlyHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyDamage", FixedToInt(CMBT_FriendlyDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "UnclassifiedVictimHits", CMBT_UnclassifiedHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "UnclassifiedVictimDamage", FixedToInt(CMBT_UnclassifiedDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FilteredNullVictimHits", CMBT_FilteredNullVictim);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FilteredNullVictimDamage", FixedToInt(CMBT_FilteredNullVictimDamage));
}

void CMBT_Save () {
    int lv_i;

    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }

    if ((CMBT_EventChunkEntries > 0)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_EVENTS_SECTION, "C" + IntToString(CMBT_EventChunkIndex), CMBT_EventChunkText);
    }

    // Write each section's current (possibly partial) chunk in place, so an in-progress
    // chunk is never lost on crash yet we do not create a new key every sample.
    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if ((CMBT_ChunkFrames[lv_i] > 0)) {
            if ((lv_i == CMBT_STREAM_SAMPLES)) {
                BankValueSetFromString(CMBT_Bank, CMBT_SAMPLES_SECTION, "C" + IntToString(CMBT_ChunkIndex[lv_i]), CMBT_ChunkText[lv_i]);
            }
            else {
                BankValueSetFromString(CMBT_Bank2, CMBT_StreamSection(lv_i), "C" + IntToString(CMBT_ChunkIndex[lv_i]), CMBT_ChunkText[lv_i]);
            }
        }
        lv_i += 1;
    }

    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SampleCount", CMBT_SampleCount);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "ChunkCount", CMBT_ChunkIndex[CMBT_STREAM_SAMPLES]);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "LastMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SlotOverflow", CMBT_SlotOverflow);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));

    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SampleCount", CMBT_SampleCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "ChunkCount", CMBT_ChunkIndex[CMBT_STREAM_TAKEN]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "TakenChunkCount", CMBT_ChunkIndex[CMBT_STREAM_TAKEN]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemyChunkCount", CMBT_ChunkIndex[CMBT_STREAM_ENEMY]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthChunkCount", CMBT_ChunkIndex[CMBT_STREAM_GROWTH]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthP2ChunkCount", CMBT_ChunkIndex[CMBT_STREAM_GROWTH_P2]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "FieldChunkCount", CMBT_ChunkIndex[CMBT_STREAM_FIELD]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimChunkCount", CMBT_ChunkIndex[CMBT_STREAM_VICTIM]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EconChunkCount", CMBT_ChunkIndex[CMBT_STREAM_ECON]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "HeroChunkCount", CMBT_ChunkIndex[CMBT_STREAM_HERO]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MutBuffChunkCount", CMBT_ChunkIndex[CMBT_STREAM_MUTBUFF]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SkillChunkCount", CMBT_ChunkIndex[CMBT_STREAM_SKILL]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "CommandsChunkCount", CMBT_ChunkIndex[CMBT_STREAM_COMMANDS]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventCount", CMBT_EventCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventChunkCount", CMBT_EventChunkIndex);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventOverflow", CMBT_EventOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "LastMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SlotOverflow", CMBT_SlotOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemyOverflow", CMBT_EnemyOverflow);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "EnemyOverflowMeaning", "events_aggregated_into_E33_Other");
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemySlotCount", CMBT_EnemyCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimOverflow", CMBT_VictimOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimSlotCount", CMBT_VictimCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MutBuffOverflow", CMBT_MutBuffOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SkillP1Overflow", CMBT_SkillOverflow[1]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SkillP2Overflow", CMBT_SkillOverflow[2]);
    // B-20: bank 2 identity keys were written once in CMBT_Start and never refreshed, so a
    // stale commander lookup at trace-start froze into the file. Refresh in step with bank 1.
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    CMBT_WriteVictimMeta(CMBT_Bank);
    CMBT_WriteVictimMeta(CMBT_Bank2);

    BankSave(CMBT_Bank);
    BankSave(CMBT_Bank2);
}

void CMBT_MarkStopped (int lp_complete, int lp_truncated) {
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Enabled", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Complete", lp_complete);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Truncated", lp_truncated);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Enabled", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Complete", lp_complete);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Truncated", lp_truncated);
    // B-20 belt-and-braces: a run stopping before the first periodic save would otherwise keep
    // the trace-start commander snapshot in both banks.
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
}

bool CMBT_WriteSample () {
    string lv_time;

    if (((CMBT_Enabled == false) || (CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return false;
    }
    if ((GameGetMissionTime() <= 0.0)) {
        return false;
    }

    CMBT_FlushMutatorEvents();
    CMBT_UpdateChaosEvents();

    if (((CMBT_SampleCount >= CMBT_MAX_SAMPLES) || (CMBT_CapacityOK() == false))) {
        CMBT_Enabled = false;
        CMBT_Truncated = true;
        CMBT_SetCapture(false);
        TimerPause(CMBT_Timer, true);
        CMBT_MarkStopped(0, 1);
        CMBT_Save();
        CMBT_UpdateIndex(0, 1, -1);
        CMBT_Message(CMBT_Operator, "stopped: sample or chunk limit reached");
        return false;
    }

    CMBT_UpdatePresent();
    CMBT_UpdateGrowth(1);
    CMBT_UpdateGrowth(2);
    CMBT_UpdateEnemyField();
    CMBT_UpdateObjectives();
    CMBT_RegisterUnitKeys();

    CMBT_SampleCount += 1;
    lv_time = IntToString(FixedToInt(GameGetMissionTime()));
    CMBT_StreamAppend(CMBT_STREAM_SAMPLES, lv_time + "|" + CMBT_BuildSampleSegment(1) + "|" + CMBT_BuildSampleSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_TAKEN, lv_time + "|" + CMBT_BuildTakenSegment(1) + "|" + CMBT_BuildTakenSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_ENEMY, lv_time + "|" + CMBT_BuildEnemySegment());
    CMBT_StreamAppend(CMBT_STREAM_GROWTH, lv_time + "|" + CMBT_BuildGrowthSegment(1));
    CMBT_StreamAppend(CMBT_STREAM_GROWTH_P2, lv_time + "|" + CMBT_BuildGrowthSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_FIELD, lv_time + "|" + CMBT_BuildFieldSegment());
    CMBT_StreamAppend(CMBT_STREAM_VICTIM, lv_time + "|" + CMBT_BuildVictimSegment(1) + "|" + CMBT_BuildVictimSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_ECON, lv_time + "|" + CMBT_BuildEconSegment(1) + "|" + CMBT_BuildEconSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_HERO, lv_time + "|" + CMBT_BuildHeroSegment(1) + "|" + CMBT_BuildHeroSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_MUTBUFF, lv_time + "|" + CMBT_BuildMutBuffSegment(CMBT_MUTBUFF_ENEMY_TO_OUR) + "|" + CMBT_BuildMutBuffSegment(CMBT_MUTBUFF_OUR_TO_ENEMY));
    CMBT_StreamAppend(CMBT_STREAM_SKILL, lv_time + "|" + CMBT_BuildSkillSegment(1) + "|" + CMBT_BuildSkillSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_COMMANDS, lv_time + "|" + CMBT_BuildCommandSegment(1) + "|" + CMBT_BuildCommandSegment(2));

    // Persist every sample (a crash loses <= 5s); roll to fresh chunk keys once they are full,
    // which keeps every section's key count bounded (~120 keys for a full 720-sample game).
    CMBT_Save();
    CMBT_RollChunks();
    return true;
}

// -----------------------------------------------------------------------------
// Capture handlers
// -----------------------------------------------------------------------------
// One damage event feeds four measurements: dealt damage (T0), hit count (T7) and overkill
// (T8) on the source side; damage taken split into life and shields (T1) plus the enemy
// unit-type table (T4) on the victim side.
bool CMBT_DamageHandler (bool testConds, bool runActions) {
    unit lv_victim;
    unit lv_sourceUnit;
    int lv_sourcePlayer;
    int lv_victimPlayer;
    int lv_slot;
    int lv_atkSlot;
    int lv_victimSlot;
    int lv_skillSlot;
    int lv_atkTag;
    fixed lv_amount;
    fixed lv_life;
    fixed lv_shields;
    fixed lv_split;
    fixed lv_atkTime;
    fixed lv_attempted;
    string lv_type;
    string lv_atkEffect;
    int lv_victimClass;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }

    lv_atkSlot = 0;
    lv_victimSlot = 0;

    // 3.2 attack instances: counted BEFORE the amount gate so fully-absorbed hits count.
    // Aligned with the d column: only a positively hostile victim counts (hub rescope
    // 2026-09-10: blood drinking hits the caster's own fanatics and would inflate Malash's
    // atk otherwise; d/a must share numerator scope). Same source-validity and slot rules as
    // d/n/h below. One attack splashing onto several targets fires several events with the
    // same (source tag, effect, mission time) key; only the first increments the slot. Two
    // genuine attacks by the same unit with the same effect inside one mission-time read also
    // merge (known limitation, changelog). Nova's source-less strike keys on tag 0 + the
    // effect name; its victim must still be hostile, same as here.
    lv_victim = EventUnit();
    lv_sourceUnit = EventUnitDamageSourceUnit();
    if (((lv_sourceUnit != lv_victim) && (lv_victim != null))) {
        lv_sourcePlayer = EventUnitDamageSourcePlayer();
        if (((lv_sourcePlayer == 1) || (lv_sourcePlayer == 2))) {
            if ((libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, UnitGetOwner(lv_victim), libNtve_ge_PlayerRelation_Enemy) == true)) {
                if ((CMBT_UT_DL_IsValidDamageSource() == true)) {
                    lv_atkSlot = CMBT_FindSlot(lv_sourcePlayer, CMBT_UT_DL_GetDamageSourceUnitType(), true);
                    if ((lv_atkSlot > 0)) {
                        lv_atkTag = 0;
                        if ((lv_sourceUnit != null)) {
                            lv_atkTag = UnitGetTag(lv_sourceUnit);
                        }
                        lv_atkEffect = EventUnitDamageEffect();
                        lv_atkTime = GameGetMissionTime();
                        if (((CMBT_AtkLastTag[lv_atkSlot][lv_sourcePlayer] != lv_atkTag) || (CMBT_AtkLastEffect[lv_atkSlot][lv_sourcePlayer] != lv_atkEffect) || (CMBT_AtkLastTime[lv_atkSlot][lv_sourcePlayer] != lv_atkTime))) {
                            CMBT_AtkLastTag[lv_atkSlot][lv_sourcePlayer] = lv_atkTag;
                            CMBT_AtkLastEffect[lv_atkSlot][lv_sourcePlayer] = lv_atkEffect;
                            CMBT_AtkLastTime[lv_atkSlot][lv_sourcePlayer] = lv_atkTime;
                            CMBT_AtkCount[lv_atkSlot][lv_sourcePlayer] += 1;
                        }
                    }
                }
            }
        }
    }

    lv_amount = EventUnitDamageAmount();
    lv_attempted = EventUnitDamageAttempted();
    lv_atkEffect = EventUnitDamageEffect();
    if ((lv_atkEffect == "")) {
        lv_atkEffect = "_UnknownEffect";
    }
    if ((lv_attempted < lv_amount)) {
        lv_attempted = lv_amount;
    }
    if ((lv_amount < 0.1)) {
        return true;
    }

    lv_victim = EventUnit();
    if ((EventUnitDamageSourceUnit() == lv_victim)) {
        return true;
    }

    lv_sourcePlayer = EventUnitDamageSourcePlayer();
    lv_victimPlayer = 0;
    // 0=unclassified, 1=enemy, 2=friendly; 3=neutral is reserved, never assigned in 3.1a.
    lv_victimClass = 0;
    if ((lv_victim != null)) {
        lv_victimPlayer = UnitGetOwner(lv_victim);
        if ((libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, lv_victimPlayer, libNtve_ge_PlayerRelation_Enemy) == true)) {
            lv_victimClass = 1;
        }
        if ((lv_victimClass == 0)) {
            if (((lv_victimPlayer == lv_sourcePlayer) || (libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, lv_victimPlayer, libNtve_ge_PlayerRelation_Ally) == true))) {
                lv_victimClass = 2;
            }
        }
        if ((lv_victimClass == 0)) {
            CMBT_RecordAllianceProbe(lv_sourcePlayer, lv_victimPlayer);
        }
    }

    // Source side: our own unit types only (Nova's source-less air strike included).
    // B-23 / MeasureVersion 3.1: only a positively hostile victim counts toward T0/T7/T8.
    // 3.1a separates friendly from unknown victims without guessing neutral/objective owners.
    if (((lv_sourcePlayer == 1) || (lv_sourcePlayer == 2))) {
        if ((CMBT_UT_DL_IsValidDamageSource() == true)) {
            if ((lv_victim == null)) {
                CMBT_FilteredNullVictim += 1;
                CMBT_FilteredNullVictimDamage += lv_amount;
            }
            if ((lv_victimClass == 2)) {
                CMBT_FriendlyHits += 1;
                CMBT_FriendlyDamage += lv_amount;
                CMBT_FriendlyPlayerHits[lv_sourcePlayer] += 1;
                CMBT_FriendlyPlayerDamage[lv_sourcePlayer] += lv_amount;
            }
            if (((lv_victim != null) && (lv_victimClass == 0))) {
                CMBT_UnclassifiedHits += 1;
                CMBT_UnclassifiedDamage += lv_amount;
            }
            lv_slot = 0;
            if ((lv_victimClass == 1)) {
                lv_slot = lv_atkSlot;
                lv_type = CMBT_UT_DL_GetDamageSourceUnitType();
                lv_life = UnitGetPropertyFixed(lv_victim, c_unitPropLife, c_unitPropCurrent);
                lv_shields = UnitGetPropertyFixed(lv_victim, c_unitPropShields, c_unitPropCurrent);
                lv_split = lv_amount - (lv_life + lv_shields);
                if ((lv_slot > 0)) {
                    CMBT_Acc[lv_slot][CMBT_F_DEALT][lv_sourcePlayer] += lv_amount;
                    CMBT_AccInt[lv_slot][CMBT_I_HITS][lv_sourcePlayer] += 1;
                    if ((lv_split > 0.0)) {
                        CMBT_Acc[lv_slot][CMBT_F_OVERKILL][lv_sourcePlayer] += lv_split;
                    }
                }
                lv_skillSlot = CMBT_FindSkillSlot(lv_sourcePlayer, lv_type, lv_atkEffect);
                if ((lv_skillSlot > 0)) {
                    CMBT_SkillAcc[lv_skillSlot][0][lv_sourcePlayer] += lv_amount;
                    CMBT_SkillHits[lv_skillSlot][lv_sourcePlayer] += 1;
                    if ((lv_split > 0.0)) {
                        CMBT_SkillAcc[lv_skillSlot][1][lv_sourcePlayer] += lv_split;
                    }
                }
                CMBT_RecordMutBuffDamage(lv_victim, CMBT_MUTBUFF_OUR_TO_ENEMY, lv_amount, lv_attempted);
                lv_victimSlot = CMBT_FindVictimSlot(UnitGetType(lv_victim));
                if ((lv_victimSlot > 0)) {
                    CMBT_VictimAcc[lv_victimSlot][CMBT_VF_DAMAGE][lv_sourcePlayer] += lv_amount;
                    CMBT_VictimAccInt[lv_victimSlot][CMBT_VI_HITS][lv_sourcePlayer] += 1;
                    if ((lv_split > 0.0)) {
                        CMBT_VictimAcc[lv_victimSlot][CMBT_VF_OVERKILL][lv_sourcePlayer] += lv_split;
                    }
                }
            }
        }
    }

    // Victim side: our own units only.
    if ((((lv_victimPlayer == 1) || (lv_victimPlayer == 2)) && (lv_victim != null))) {
        lv_slot = CMBT_FindSlot(lv_victimPlayer, UnitGetType(lv_victim), true);
        if ((lv_slot > 0)) {
            lv_shields = UnitGetPropertyFixed(lv_victim, c_unitPropShields, c_unitPropCurrent);
            lv_split = lv_shields;
            if ((lv_split > lv_amount)) {
                lv_split = lv_amount;
            }
            if ((lv_split < 0.0)) {
                lv_split = 0.0;
            }
            CMBT_Acc[lv_slot][CMBT_F_TAKENSHIELD][lv_victimPlayer] += lv_split;
            CMBT_Acc[lv_slot][CMBT_F_TAKENLIFE][lv_victimPlayer] += (lv_amount - lv_split);
            CMBT_RecordOrderProbe(lv_victim, lv_amount);
        }

        if ((lv_victimClass == 1)) {
            lv_type = "_Sourceless";
            if ((EventUnitDamageSourceUnit() != null)) {
                lv_type = UnitGetType(EventUnitDamageSourceUnit());
            }
            lv_slot = CMBT_FindEnemySlot(lv_type, lv_atkEffect);
            if ((lv_slot > 0)) {
                CMBT_EnemyAcc[lv_slot] += lv_amount;
            }
            CMBT_RecordMutBuffDamage(EventUnitDamageSourceUnit(), CMBT_MUTBUFF_ENEMY_TO_OUR, lv_amount, lv_attempted);
        }
    }

    return true;
}

// 3.4 birth evidence: no banks and no periodic work before opt-in. Presence at
// startup seeds preplaced units; subsequent UnitCreated/UnitRevive provide evidence.
// Inference, not an engine proof: Birth=0 precursors are expected not to be born.
bool CMBT_HasBirth (int lp_player, string lp_type) {
    int lv_i;
    lv_i = 1;
    while ((lv_i <= CMBT_BirthCount[lp_player])) {
        if (((lp_type == CMBT_BirthType[lv_i][lp_player]) || (libCOTF_gf_UT_AreMorphUnits(lp_type, CMBT_BirthType[lv_i][lp_player]) == true))) { return true; }
        lv_i += 1;
    }
    // A full table cannot prove absence: conservatively treat the type as born.
    return (CMBT_BirthOverflow[lp_player] > 0);
}

void CMBT_RecordBirth (unit lp_unit) {
    int lv_owner;
    string lv_type;
    if ((lp_unit == null)) { return; }
    lv_owner = UnitGetOwner(lp_unit);
    if (((lv_owner < 1) || (lv_owner > 2))) { return; }
    if ((UnitFilterMatch(lp_unit, lv_owner, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterHidden - 32)))) == false)) { return; }
    lv_type = UnitGetType(lp_unit);
    if ((CMBT_HasBirth(lv_owner, lv_type) == true)) { return; }
    if ((CMBT_BirthCount[lv_owner] >= CMBT_BIRTH_MAX)) {
        CMBT_BirthOverflow[lv_owner] += 1;
        return;
    }
    CMBT_BirthCount[lv_owner] += 1;
    CMBT_BirthType[CMBT_BirthCount[lv_owner]][lv_owner] = lv_type;
}

bool CMBT_IsConstructionWorker (string lp_type) {
    // PeonKillFinish is demonstrated for Valerian, not for every worker type.
    // Conservative whitelist avoids labelling sacrificed probes/SCVs as construction.
    return (lp_type == "SCVValerian");
}

// Accounts: real enemy + real other, noncombat disappearance, construction consumption.
// Missile is always noncombat. Hero initial placeholder is a bounded inference;
// an enemy kill or a death after initial revive remains a real hero death.
// T2 3.4: de + ds are real deaths (enemy / other); nc is inferred noncombat
// disappearance, bc is inferred construction consumption. Do not equate their
// total with replay tracker deaths without engine validation.
bool CMBT_DiedHandler (bool testConds, bool runActions) {
    unit lv_victim;
    int lv_owner;
    int lv_killer;
    int lv_slot;
    int lv_victimSlot;
    string lv_type;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }

    lv_victim = EventUnit();
    if ((lv_victim == null)) {
        return true;
    }

    lv_owner = UnitGetOwner(lv_victim);
    lv_killer = libNtve_gf_KillingPlayer();
    lv_type = UnitGetType(lv_victim);
    if (((lv_owner >= 1) && (lv_owner <= 2) && (lv_victim == libCOMI_gv_cM_HeroUnit[lv_owner]))) {
        CMBT_AppendEvent("HeroDied", lv_owner, lv_type, "", "UnitDied", "exact");
    }
    if ((CMBT_IsTrackedMutatorUnitType(lv_type) == true)) {
        CMBT_AppendEvent("MutatorUnitDied", lv_owner, lv_type, "", CMBT_MutatorFactorForUnitType(lv_type), "exact");
    }
    if (((lv_killer == 1) || (lv_killer == 2))) {
        if ((libNtve_gf_PlayerIsEnemy(lv_killer, lv_owner, libNtve_ge_PlayerRelation_Enemy) == true)) {
            lv_victimSlot = CMBT_FindVictimSlot(lv_type);
            if ((lv_victimSlot > 0)) {
                CMBT_VictimAccInt[lv_victimSlot][CMBT_VI_KILLS][lv_killer] += 1;
            }
        }
    }
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return true;
    }

    lv_slot = CMBT_FindSlot(lv_owner, lv_type, true);
    if ((lv_slot == 0)) {
        return true;
    }

    if ((UnitFilterMatch(lv_victim, lv_owner, UnitFilter((1 << c_targetFilterMissile), 0, 0, 0)) == true)) {
        CMBT_AccInt[lv_slot][CMBT_I_DISAPPEARED][lv_owner] += 1;
    }
    else if (((lv_killer != c_playerAny) && (lv_killer != lv_owner) && (libNtve_gf_PlayerIsEnemy(lv_killer, lv_owner, libNtve_ge_PlayerRelation_Enemy) == true))) {
        CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lv_owner] += 1;
    }
    else if (((lv_killer == c_playerAny) && (CMBT_IsConstructionWorker(lv_type) == true))) {
        CMBT_AccInt[lv_slot][CMBT_I_CONSUMED][lv_owner] += 1;
    }
    else if ((lv_victim == libCOMI_gv_cM_HeroUnit[lv_owner])) {
        if (((CMBT_HeroRevived[lv_owner] == false) && (GameGetMissionTime() <= CMBT_HERO_PLACEHOLDER_SECONDS))) {
            CMBT_AccInt[lv_slot][CMBT_I_DISAPPEARED][lv_owner] += 1;
        }
        else { CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lv_owner] += 1; }
    }
    else if ((CMBT_HasBirth(lv_owner, lv_type) == false)) {
        CMBT_AccInt[lv_slot][CMBT_I_DISAPPEARED][lv_owner] += 1;
    }
    else { CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lv_owner] += 1; }
    return true;
}

// T3: healing and shield restoration are booked against the BENEFICIARY, not the healer, so
// that they line up with the damage-taken columns of the same slot. Shield regeneration has
// no launch unit at all, which is exactly the case UT_DL's heal log drops.
void CMBT_RecordHeal (int lp_field) {
    unit lv_target;
    int lv_owner;
    int lv_slot;
    fixed lv_amount;

    if ((CMBT_Enabled == false)) {
        return;
    }

    lv_amount = EventUnitHealAmount();
    if ((lv_amount < 0.1)) {
        return;
    }

    lv_target = EventUnit();
    if ((lv_target == null)) {
        return;
    }

    lv_owner = UnitGetOwner(lv_target);
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return;
    }

    lv_slot = CMBT_FindSlot(lv_owner, UnitGetType(lv_target), true);
    if ((lv_slot == 0)) {
        return;
    }

    CMBT_Acc[lv_slot][lp_field][lv_owner] += lv_amount;
}

bool CMBT_HealLifeHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordHeal(CMBT_F_HEALLIFE);
    return true;
}

bool CMBT_HealShieldHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordHeal(CMBT_F_HEALSHIELD);
    return true;
}

// T5b: ability casts have no data-layer carrier (no charges, no counting buff), so they are
// counted from the Unit Uses Ability event at the Execute stage (precedent: LibCOMI.galaxy:25207,
// the Raynor banshee achievement; EventUnit() is the caster, as in the Alarak sacrifice
// trigger LibCOMI.galaxy:26552). Casts by either of our players are counted; the abilities only
// exist on Malash units, so in a non-Malash game the events never fire.
void CMBT_RecordCast (int lp_field) {
    int lv_owner;

    if ((CMBT_Enabled == false)) {
        return;
    }
    if ((EventUnit() == null)) {
        return;
    }
    lv_owner = UnitGetOwner(EventUnit());
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return;
    }
    CMBT_CastCount[lp_field][lv_owner] += 1;
}

bool CMBT_AbilPurgeHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordCast(CMBT_G_CAST_PURGE);
    return true;
}

bool CMBT_AbilSacrificeHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordCast(CMBT_G_CAST_SACRIFICE);
    return true;
}

bool CMBT_AbilShacklesHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordCast(CMBT_G_CAST_SHACKLES);
    return true;
}

// 3.2 G10: MalashBreak (hero ultimate "tear reality"). Same Execute-stage event shape.
bool CMBT_AbilBreakHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordCast(CMBT_G_CAST_BREAK);
    return true;
}

// 3.2 G11: MalashImmortalOrder (walker "immortal order" mark ability).
bool CMBT_AbilOrderHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }
    CMBT_RecordCast(CMBT_G_CAST_ORDER);
    return true;
}

bool CMBT_ResearchHandler (bool testConds, bool runActions) {
    int lv_player;
    string lv_upgrade;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_player = EventPlayer();
    lv_upgrade = libNtve_gf_TriggeringProgressUpgrade();
    CMBT_AppendEvent("ResearchComplete", lv_player, lv_upgrade, IntToString(TechTreeUpgradeCount(lv_player, lv_upgrade, c_techCountCompleteOnly)), "UnitResearchProgress", "exact");
    return true;
}

bool CMBT_UpgradeHandler (bool testConds, bool runActions) {
    int lv_player;
    string lv_upgrade;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_player = EventPlayer();
    lv_upgrade = EventUpgradeName();
    CMBT_AppendEvent("UpgradeLevelChanged", lv_player, lv_upgrade, IntToString(TechTreeUpgradeCount(lv_player, lv_upgrade, c_techCountCompleteOnly)), "UpgradeLevelChanged", "exact");
    return true;
}

bool CMBT_PlayerLeftHandler (bool testConds, bool runActions) {
    int lv_player;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_player = EventPlayer();
    CMBT_AppendEvent("PlayerLeft", lv_player, "", "", "PlayerLeft", "exact");
    CMBT_Save();
    return true;
}

bool CMBT_HeroReviveHandler (bool testConds, bool runActions) {
    unit lv_unit;
    int lv_player;

    if ((!runActions)) {
        return true;
    }
    lv_unit = EventUnit();
    if ((lv_unit == null)) {
        return true;
    }
    lv_player = UnitGetOwner(lv_unit);
    if (((lv_player >= 1) && (lv_player <= 2) && (lv_unit == libCOMI_gv_cM_HeroUnit[lv_player]))) {
        CMBT_HeroRevived[lv_player] = true;
        CMBT_RecordBirth(lv_unit);
        if ((CMBT_Enabled == false)) { return true; }
        CMBT_AppendEvent("HeroRevived", lv_player, UnitGetType(lv_unit), "", "UnitRevive", "exact");
    }
    return true;
}

bool CMBT_UnitCreatedHandler (bool testConds, bool runActions) {
    unit lv_unit;
    string lv_type;

    if ((!runActions)) {
        return true;
    }
    lv_unit = EventUnit();
    if ((lv_unit == null)) {
        return true;
    }
    CMBT_RecordBirth(lv_unit);
    if ((CMBT_Enabled == false)) { return true; }
    lv_type = UnitGetType(lv_unit);
    if ((CMBT_IsTrackedMutatorUnitType(lv_type) == true)) {
        CMBT_AppendEvent("MutatorUnitBorn", UnitGetOwner(lv_unit), lv_type, "", CMBT_MutatorFactorForUnitType(lv_type), "exact");
    }
    return true;
}

bool CMBT_MutBehaviorHandler (bool testConds, bool runActions) {
    unit lv_unit;
    string lv_behavior;
    string lv_unitType;
    int lv_slot;
    int lv_change;
    int lv_owner;
    int lv_total;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_unit = EventUnit();
    lv_behavior = EventUnitBehavior();
    lv_slot = CMBT_MutBuffSlotForBehavior(lv_behavior);
    if (((lv_unit == null) || (lv_slot == 0))) {
        return true;
    }
    lv_unitType = UnitGetType(lv_unit);
    lv_owner = UnitGetOwner(lv_unit);
    lv_total = CMBT_MutBehaviorAdd[lv_slot] + CMBT_MutBehaviorRemove[lv_slot] + CMBT_MutBehaviorRefresh[lv_slot];
    if ((lv_total == 0)) {
        CMBT_MutBehaviorLastOwner[lv_slot] = lv_owner;
        CMBT_MutBehaviorLastUnit[lv_slot] = lv_unitType;
    }
    else {
        if ((CMBT_MutBehaviorLastOwner[lv_slot] != lv_owner)) {
            CMBT_MutBehaviorLastOwner[lv_slot] = 0;
        }
        if ((CMBT_MutBehaviorLastUnit[lv_slot] != lv_unitType)) {
            CMBT_MutBehaviorLastUnit[lv_slot] = "_Mixed";
        }
    }
    lv_change = EventUnitBehaviorChange();
    if (((lv_change == c_unitBehaviorChangeCreate) || (lv_change == c_unitBehaviorChangeIncrease) || (lv_change == c_unitBehaviorChangeActivate))) {
        CMBT_MutBehaviorAdd[lv_slot] += 1;
    }
    else if (((lv_change == c_unitBehaviorChangeDestroy) || (lv_change == c_unitBehaviorChangeDecrease) || (lv_change == c_unitBehaviorChangeDeactivate))) {
        CMBT_MutBehaviorRemove[lv_slot] += 1;
    }
    else {
        CMBT_MutBehaviorRefresh[lv_slot] += 1;
    }
    CMBT_MutBehaviorLastStack[lv_slot] = UnitBehaviorCount(lv_unit, lv_behavior);
    return true;
}

bool CMBT_MutEffectHandler (bool testConds, bool runActions) {
    string lv_effect;
    string lv_unitType;
    int lv_slot;
    int lv_owner;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_effect = EventPlayerEffectUsed();
    lv_slot = CMBT_MutatorEffectSlot(lv_effect);
    if ((lv_slot == 0)) {
        return true;
    }
    lv_unitType = EventPlayerEffectUsedUnitType(c_effectUnitCaster);
    if ((lv_unitType == "")) {
        lv_unitType = EventPlayerEffectUsedUnitType(c_effectUnitTarget);
    }
    lv_owner = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    if ((CMBT_MutEffectUseCount[lv_slot] == 0)) {
        CMBT_MutEffectLastOwner[lv_slot] = lv_owner;
        CMBT_MutEffectLastUnit[lv_slot] = lv_unitType;
    }
    else {
        if ((CMBT_MutEffectLastOwner[lv_slot] != lv_owner)) {
            CMBT_MutEffectLastOwner[lv_slot] = 0;
        }
        if ((CMBT_MutEffectLastUnit[lv_slot] != lv_unitType)) {
            CMBT_MutEffectLastUnit[lv_slot] = "_Mixed";
        }
    }
    CMBT_MutEffectUseCount[lv_slot] += 1;
    return true;
}

bool CMBT_CommandHandler (bool testConds, bool runActions) {
    int lv_player;
    string lv_ability;
    order lv_order;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }
    lv_order = EventUnitOrder();
    lv_player = EventPlayer();
    if (((lv_player < 1) || (lv_player > 2) || (PlayerType(lv_player) != c_playerTypeUser))) {
        return true;
    }
    lv_ability = AbilityCommandGetAbility(OrderGetAbilityCommand(lv_order));
    if (((StringEqual(lv_ability, "move", c_stringNoCase) == true) || (StringEqual(lv_ability, "patrol", c_stringNoCase) == true))) {
        CMBT_CommandCount[lv_player][CMBT_COMMAND_MOVE] += 1;
    }
    else if ((StringEqual(lv_ability, "attack", c_stringNoCase) == true)) {
        CMBT_CommandCount[lv_player][CMBT_COMMAND_ATTACK] += 1;
    }
    else if (((lv_ability == "") || (StringEqual(lv_ability, "smart", c_stringNoCase) == true) || (StringEqual(lv_ability, "stop", c_stringNoCase) == true) || (StringEqual(lv_ability, "holdposition", c_stringNoCase) == true))) {
        CMBT_CommandCount[lv_player][CMBT_COMMAND_OTHER] += 1;
    }
    else {
        CMBT_CommandCount[lv_player][CMBT_COMMAND_ABILITY] += 1;
    }
    return true;
}

// -----------------------------------------------------------------------------
// Session control
// -----------------------------------------------------------------------------
// COCampaign three-stage bank precedent: cmui_customization.galaxy:9356-9397.
bank CMBT_SettingsOpen (int lp_player) {
    bank lv_bank;
    if (((lp_player < 1) || (lp_player > 2) || (PlayerType(lp_player) != c_playerTypeUser))) { return null; }
    BankLoad(CMBT_SETTINGS_BANK_NAME, lp_player);
    lv_bank = BankLastCreated();
    if ((lv_bank != null)) { BankWait(lv_bank); }
    return lv_bank;
}

bool CMBT_SettingsAuto (int lp_player) {
    bank lv_bank;
    lv_bank = CMBT_SettingsOpen(lp_player);
    if ((lv_bank == null)) { return false; }
    if ((BankKeyExists(lv_bank, CMBT_SETTINGS_SECTION, "Auto") == false)) { return false; }
    return (BankValueGetAsInt(lv_bank, CMBT_SETTINGS_SECTION, "Auto") == 1);
}

bool CMBT_SettingsSet (int lp_player, bool lp_auto) {
    bank lv_bank;
    lv_bank = CMBT_SettingsOpen(lp_player);
    if ((lv_bank == null)) {
        CMBT_Message(lp_player, "failed: cannot open settings bank");
        return false;
    }
    BankValueSetFromInt(lv_bank, CMBT_SETTINGS_SECTION, "Auto", BoolToInt(lp_auto));
    BankSave(lv_bank);
    lv_bank = CMBT_SettingsOpen(lp_player);
    if ((lv_bank == null)) { CMBT_Message(lp_player, "failed: settings readback open"); return false; }
    if ((BankKeyExists(lv_bank, CMBT_SETTINGS_SECTION, "Auto") == false)) { CMBT_Message(lp_player, "failed: settings readback missing Auto"); return false; }
    if ((BankValueGetAsInt(lv_bank, CMBT_SETTINGS_SECTION, "Auto") != BoolToInt(lp_auto))) { CMBT_Message(lp_player, "failed: settings readback mismatch"); return false; }
    CMBT_Message(lp_player, "saved local preference: auto=" + IntToString(BoolToInt(lp_auto)));
    return true;
}

// No repository precedent for save/reopen verification. BankLoad may cache its
// handle: this validates the engine bank state, NOT proven physical-disk flush.
bool CMBT_VerifyStart (bank lp_bank, int lp_epoch, string lp_peerKey, string lp_peer) {
    if ((lp_bank == null)) { return false; }
    if ((BankKeyExists(lp_bank, CMBT_META_SECTION, "StartedAt") == false)) { return false; }
    if ((BankKeyExists(lp_bank, CMBT_META_SECTION, "Enabled") == false)) { return false; }
    if ((BankKeyExists(lp_bank, CMBT_META_SECTION, lp_peerKey) == false)) { return false; }
    if ((BankKeyExists(lp_bank, CMBT_META_SECTION, "CaptureSchema") == false)) { return false; }
    return ((BankValueGetAsInt(lp_bank, CMBT_META_SECTION, "StartedAt") == lp_epoch) && (BankValueGetAsInt(lp_bank, CMBT_META_SECTION, "Enabled") == 1) && (BankValueGetAsString(lp_bank, CMBT_META_SECTION, lp_peerKey) == lp_peer) && (BankValueGetAsString(lp_bank, CMBT_META_SECTION, "CaptureSchema") == CMBT_CAPTURE_SCHEMA));
}

void CMBT_Start (int lp_player, bool lp_auto) {
    int lv_startedAt;
    int lv_i;
    string lv_origin;

    if ((CMBT_StartPending == true)) { CMBT_Message(lp_player, "start is pending"); return; }
    if ((CMBT_Enabled == true)) {
        CMBT_Message(lp_player, "already enabled by player " + IntToString(CMBT_Operator));
        return;
    }

    if (((lp_player < 1) || (lp_player > 2) || (PlayerType(lp_player) != c_playerTypeUser))) { return; }
    CMBT_StartPending = true;
    // N1': pure ASCII alphanumeric, readable date/time + truncated internal commander id.
    // Primary length <= 27 and companion adds one trailing X, so both stay <= 28.
    lv_startedAt = DateTimeToInt(CurrentDateTimeGet());
    CMBT_Operator = lp_player;
    CMBT_BankName = CMBT_BuildBankBaseName(lv_startedAt, lp_player);
    CMBT_Bank2Name = CMBT_BankName + "X";
    if (((StringLength(CMBT_BankName) > 28) || (StringLength(CMBT_Bank2Name) > 28))) {
        CMBT_StartPending = false;
        CMBT_Message(lp_player, "failed: generated bank name exceeds 28 characters");
        return;
    }

    BankLoad(CMBT_BankName, lp_player);
    CMBT_Bank = BankLastCreated();
    BankLoad(CMBT_Bank2Name, lp_player);
    CMBT_Bank2 = BankLastCreated();
    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        CMBT_Bank = null;
        CMBT_Bank2 = null;
        CMBT_StartPending = false;
        CMBT_Message(lp_player, "failed to open telemetry banks");
        return;
    }
    BankWait(CMBT_Bank);
    BankWait(CMBT_Bank2);
    BankLoad(CMBT_INDEX_BANK_NAME, lp_player);
    CMBT_IndexBank = BankLastCreated();
    if ((CMBT_IndexBank != null)) {
        BankWait(CMBT_IndexBank);
    }

    CMBT_StartedMissionTime = GameGetMissionTime();
    CMBT_ResetStoredSession();
    CMBT_ResetState();
    if (((CMBT_IndexBank != null) && (BankKeyExists(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "IndexOverflow") == true))) {
        CMBT_IndexOverflow = BankValueGetAsInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "IndexOverflow");
    }

    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Version", 3);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "GrowthImplemented", 0);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "SampleEncoding", CMBT_SCRIPT_VERSION);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "FrameFormat", "t|p1(slot:d/n/h/o/dn/a)|p2(slot:d/n/h/o/dn/a)");
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "DamageScope", "EnemyVictimOnly");
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "MeasureVersion", CMBT_MEASURE_VERSION);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CaptureSchema", CMBT_CAPTURE_SCHEMA);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "MutatorAddendum", 1);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "PreMitigation", "EventUnitDamageAttempted");
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "PrimaryScope", "EnemyOnly+NeutralPending");
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "TimeOrigin", "MissionStart");
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "Bank2", CMBT_Bank2Name);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Enabled", 1);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Complete", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Truncated", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Operator", lp_player);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "IntervalSeconds", FixedToInt(CMBT_INTERVAL_SECONDS));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SaveSeconds", FixedToInt(CMBT_INTERVAL_SECONDS));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "FramesPerChunk", CMBT_FRAMES_PER_CHUNK);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "MaxChunks", CMBT_MAX_CHUNKS);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "MaxSlots", CMBT_MAX_SLOTS);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SlotOverflow", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "StartedAt", lv_startedAt);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "StartMissionTime", FixedToInt(CMBT_StartedMissionTime));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SampleCount", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "ChunkCount", 0);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "Map", libCOOC_gf_CC_CurrentMap());
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "Probe", CMBT_BuildProbe());
    CMBT_WriteEnvironmentMeta(CMBT_Bank);
    CMBT_WriteIdentityMeta(CMBT_Bank, lv_startedAt, CMBT_BankName, CMBT_Bank2Name);
    CMBT_WritePathMeta(CMBT_Bank, lp_player, CMBT_BankName);
    CMBT_WriteVictimMeta(CMBT_Bank);

    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Version", 3);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthImplemented", 0);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "SampleEncoding", CMBT_SCRIPT_VERSION);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "FrameFormat", "Taken t|p1(slot:tl/ts/de/ds/hl/hs/nc/bc)|p2; Enemy t|e:d; Growth/GrowthP2 t|g1,..,g11; Field t|hu,hs,nu,ns; Victim t|p1(slot:d/h/o/k)|p2; Econ t|p1(m/g/cm/cg/su/sl)|p2; Hero t|p1(present/alive/life/shield/energy/deaths)|p2; MutBuff t|enemy_to_our(slot:d/h/m/s100)|our_to_enemy; Skill t|p1(slot:d/h/o)|p2; Commands t|p1(move/attack/ability/other)|p2");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "GrowthSchema", "none");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "TakenSplit", "shield=min(amount,shieldsAtEvent); life=amount-shield");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "MeasureVersion", CMBT_MEASURE_VERSION);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CaptureSchema", CMBT_CAPTURE_SCHEMA);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MutatorAddendum", 1);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "PreMitigation", "EventUnitDamageAttempted");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "EnemySourceKeyFormat", "unit_type~effect_id");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommandScope", "EventPlayer 1/2 with PlayerTypeUser");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommandDefinition", "move=move/patrol; attack=attack; ability=other nonbasic ability; other=empty/smart/stop/holdposition");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "PrimaryScope", "EnemyOnly+NeutralPending");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "DamageScope", "EnemyVictimOnly");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "OverkillDefinition", "amount-(life+shields) at event time, clamped at 0");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "OrderProbeFormat", "type|amount|life|lifeMax|shields|shieldsMax (x100)");
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "Bank1", CMBT_BankName);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Enabled", 1);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Complete", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Truncated", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Operator", lp_player);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "IntervalSeconds", FixedToInt(CMBT_INTERVAL_SECONDS));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "FramesPerChunk", CMBT_FRAMES_PER_CHUNK);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MaxChunks", CMBT_MAX_CHUNKS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MaxEnemySlots", CMBT_MAX_ENEMY_SLOTS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MaxVictimSlots", CMBT_MAX_VICTIM_SLOTS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MaxMutBuffSlots", CMBT_MAX_MUTBUFF_SLOTS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MaxSkillSlots", CMBT_MAX_SKILL_SLOTS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventMax", CMBT_EVENT_MAX);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventsPerChunk", CMBT_EVENTS_PER_CHUNK);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventMaxChars", CMBT_EVENT_MAX_CHARS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventChunkMaxChars", CMBT_EVENT_CHUNK_MAX_CHARS);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SlotOverflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemyOverflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimOverflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventOverflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "MutBuffOverflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SkillP1Overflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SkillP2Overflow", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "StartedAt", lv_startedAt);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "StartMissionTime", FixedToInt(CMBT_StartedMissionTime));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SampleCount", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "ChunkCount", 0);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "Map", libCOOC_gf_CC_CurrentMap());
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "Probe", CMBT_BuildProbe());
    CMBT_WriteEnvironmentMeta(CMBT_Bank2);
    CMBT_WriteIdentityMeta(CMBT_Bank2, lv_startedAt, CMBT_Bank2Name, CMBT_BankName);
    CMBT_WritePathMeta(CMBT_Bank2, lp_player, CMBT_Bank2Name);
    CMBT_WriteVictimMeta(CMBT_Bank2);

    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_GROWTH_FIELDS_SECTION, "G" + IntToString(lv_i), "reserved");
        lv_i += 1;
    }
    if ((CMBT_IsMalashPlayer(CMBT_GROWTH_PLAYER) == true)) {
        CMBT_ActivateGrowth(1);
    }
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "GrowthP2Implemented", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthP2Implemented", 0);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "GrowthP2Schema", "none");
    if ((CMBT_IsMalashPlayer(2) == true)) { CMBT_ActivateGrowth(2); }

    BankValueSetFromInt(CMBT_Bank, CMBT_OUR_UNITS_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_OUR_UNITS_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_SKILL_P1_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_SKILL_P2_SECTION, "Count", 0);
    BankValueSetFromString(CMBT_Bank2, CMBT_HERO_UNITS_SECTION, "P1", "absent");
    BankValueSetFromString(CMBT_Bank2, CMBT_HERO_UNITS_SECTION, "P2", "absent");
    BankValueSetFromInt(CMBT_Bank2, CMBT_OBJECTIVES_SECTION, "Count", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_SCORE_STATS_SECTION, "Count", 0);
    CMBT_WriteMutatorWhitelistMeta();
    CMBT_CapturePlayers();
    CMBT_CaptureMutators();
    CMBT_PrimeObjectives();
    lv_origin = "Chat";
    if ((lp_auto == true)) { lv_origin = "Auto"; }
    CMBT_AppendEvent("TraceOn", lp_player, CMBT_BankName, CMBT_Bank2Name, lv_origin, "exact");

    CMBT_Save();
    // Save first, reopen both, check identity and enabled state before success.
    BankLoad(CMBT_BankName, lp_player);
    CMBT_Bank = BankLastCreated();
    BankLoad(CMBT_Bank2Name, lp_player);
    CMBT_Bank2 = BankLastCreated();
    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        CMBT_StartPending = false;
        CMBT_Bank = null;
        CMBT_Bank2 = null;
        CMBT_Message(lp_player, "failed: readback cannot open telemetry banks");
        return;
    }
    BankWait(CMBT_Bank);
    BankWait(CMBT_Bank2);
    if (((CMBT_VerifyStart(CMBT_Bank, lv_startedAt, "Bank2", CMBT_Bank2Name) == false) || (CMBT_VerifyStart(CMBT_Bank2, lv_startedAt, "Bank1", CMBT_BankName) == false))) {
        BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Enabled", 0);
        BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Enabled", 0);
        CMBT_Save();
        CMBT_Bank = null;
        CMBT_Bank2 = null;
        CMBT_StartPending = false;
        CMBT_Message(lp_player, "failed: telemetry readback mismatch or missing key");
        return;
    }
    CMBT_UpdateIndex(0, 0, -1);
    CMBT_StartPending = false;
    CMBT_Enabled = true;
    CMBT_SetCapture(true);
    TimerStart(CMBT_Timer, CMBT_INTERVAL_SECONDS, true, c_timeGame);
    CMBT_Message(lp_player, "enabled; bank1=" + CMBT_BankPathHint(lp_player, CMBT_BankName) + "; bank2=" + CMBT_BankPathHint(lp_player, CMBT_Bank2Name));
}

void CMBT_Stop (int lp_player) {
    CMBT_SuppressAutoThisMatch = true;
    if ((CMBT_Enabled == false)) {
        CMBT_Message(lp_player, "already disabled");
        return;
    }
    if ((lp_player != CMBT_Operator)) {
        CMBT_Message(lp_player, "only the enabling player can stop capture");
        return;
    }

    CMBT_AppendEvent("TraceOff", lp_player, "", "", "Chat", "exact");
    CMBT_WriteSample();
    // If that sample hit a cap, CMBT_WriteSample already disabled + flagged Truncated and
    // saved. Don't overwrite Truncated with Complete in that case.
    if ((CMBT_Enabled == false)) {
        CMBT_Message(lp_player, "disabled; samples=" + IntToString(CMBT_SampleCount) + "; bank1=" + CMBT_BankPathHint(lp_player, CMBT_BankName) + "; bank2=" + CMBT_BankPathHint(lp_player, CMBT_Bank2Name));
        return;
    }
    CMBT_Enabled = false;
    CMBT_SetCapture(false);
    TimerPause(CMBT_Timer, true);
    CMBT_MarkStopped(1, 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "StoppedAt", DateTimeToInt(CurrentDateTimeGet()));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "StoppedAt", DateTimeToInt(CurrentDateTimeGet()));
    CMBT_Save();
    CMBT_UpdateIndex(1, 0, -1);
    CMBT_Message(lp_player, "disabled; samples=" + IntToString(CMBT_SampleCount) + "; bank1=" + CMBT_BankPathHint(lp_player, CMBT_BankName) + "; bank2=" + CMBT_BankPathHint(lp_player, CMBT_Bank2Name));
}

void CMBT_FinalizeResult (int lp_result) {
    int lv_complete;
    int lv_stoppedAt;

    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }
    CMBT_Enabled = false;
    CMBT_SetCapture(false);
    TimerPause(CMBT_Timer, true);
    CMBT_AppendEvent("Result", 0, "", IntToString(lp_result), "ResultSessionOpen", "exact");
    CMBT_CapturePlayers();
    CMBT_CaptureMutators();
    CMBT_CaptureOutcomeData();
    lv_complete = 1;
    if ((CMBT_Truncated == true)) {
        lv_complete = 0;
    }
    lv_stoppedAt = DateTimeToInt(CurrentDateTimeGet());
    CMBT_MarkStopped(lv_complete, BoolToInt(CMBT_Truncated));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Result", lp_result);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Result", lp_result);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "EndMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EndMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "StoppedAt", lv_stoppedAt);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "StoppedAt", lv_stoppedAt);
    CMBT_Save();
    CMBT_UpdateIndex(lv_complete, BoolToInt(CMBT_Truncated), lp_result);
}

bool CMBT_TimerHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }

    CMBT_WriteSample();
    return true;
}

bool CMBT_MissionEndHandler (bool testConds, bool runActions) {
    if ((!runActions)) {
        return true;
    }

    if ((CMBT_Enabled == true)) {
        CMBT_WriteSample();
    }
    return true;
}

bool CMBT_ChatHandler (bool testConds, bool runActions) {
    string lv_message;
    string lv_command;
    int lv_player;

    if ((!runActions)) {
        return true;
    }

    lv_message = EventChatMessage(false);
    if ((StringEqual(StringWord(lv_message, 1), "-baltrace", c_stringNoCase) == false)) {
        return true;
    }

    lv_command = StringWord(lv_message, 2);
    lv_player = EventPlayer();
    if ((lv_command == "") || (StringEqual(lv_command, "status", c_stringNoCase) == true)) {
        if ((CMBT_Enabled == true)) {
            CMBT_Message(lv_player, "enabled by player " + IntToString(CMBT_Operator) + "; samples=" + IntToString(CMBT_SampleCount));
        }
        else {
            CMBT_Message(lv_player, "disabled");
        }
        return true;
    }

    if ((StringEqual(lv_command, "auto", c_stringNoCase) == true)) {
        if ((CMBT_SettingsSet(lv_player, true) == true)) { CMBT_Start(lv_player, false); }
        return true;
    }
    if ((StringEqual(lv_command, "manual", c_stringNoCase) == true)) {
        CMBT_SettingsSet(lv_player, false);
        return true;
    }
    if ((StringEqual(lv_command, "on", c_stringNoCase) == true)) {
        CMBT_Start(lv_player, false);
        return true;
    }

    if ((StringEqual(lv_command, "off", c_stringNoCase) == true)) {
        CMBT_Stop(lv_player);
        return true;
    }

    if ((StringEqual(lv_command, "snapshot", c_stringNoCase) == true)) {
        if ((lv_player == CMBT_Operator) && (CMBT_WriteSample() == true)) {
            CMBT_Message(lv_player, "snapshot saved; samples=" + IntToString(CMBT_SampleCount));
        }
        return true;
    }

    CMBT_Message(lv_player, "usage: -baltrace auto|manual|on|off|status|snapshot");
    return true;
}

bool CMBT_StartupHandler (bool testConds, bool runActions) {
    int lv_player;
    int lv_autoPlayer;
    int lv_i;
    unitgroup lv_group;
    if ((!runActions)) { return true; }
    if ((CMBT_StartupDone == true)) { return true; }
    CMBT_StartupDone = true;
    lv_autoPlayer = 0;
    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_group = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_i = 1;
        while ((lv_i <= UnitGroupCount(lv_group, c_unitCountAll))) {
            CMBT_RecordBirth(UnitGroupUnit(lv_group, lv_i));
            lv_i += 1;
        }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            if ((CMBT_SettingsAuto(lv_player) == true)) {
                if ((lv_autoPlayer == 0)) { lv_autoPlayer = lv_player; }
            }
        }
        lv_player += 1;
    }
    // Deterministic ascending player id; both preferences remain intact.
    if (((lv_autoPlayer > 0) && (CMBT_Enabled == false) && (CMBT_SuppressAutoThisMatch == false))) { CMBT_Start(lv_autoPlayer, true); }
    if ((CMBT_Enabled == false)) {
        CMUIX_ConsoleDisplayColoredLine(PlayerGroupAll(), StringToText("[CM] 战斗遥测未开启；-baltrace on 记录本局，-baltrace auto 保存自动开启设置，-baltrace manual 取消自动开启。"), CMUIX_CONSOLE_COLOR_DESCRIPTION);
    }
    return true;
}

void CMBT_Init () {
    int lv_i;

    if ((CMBT_Initialized == true)) {
        return;
    }

    CMBT_Initialized = true;
    CMBT_InitMutatorWhitelist();
    CMBT_Timer = TimerCreate();
    CMBT_TimerTrigger = TriggerCreate("CMBT_TimerHandler");
    TriggerAddEventTimer(CMBT_TimerTrigger, CMBT_Timer);
    CMBT_MissionEndTrigger = TriggerCreate("CMBT_MissionEndHandler");
    TriggerAddEventGeneric(CMBT_MissionEndTrigger, "UT_MissionEnd");
    CMBT_ChatTrigger = TriggerCreate("CMBT_ChatHandler");
    TriggerAddEventChatMessage(CMBT_ChatTrigger, c_playerAny, "-baltrace", false);

    // Capture triggers stay disabled until "-baltrace on", so a normal game pays nothing
    // beyond the registrations themselves (same pattern UT_DL's own loggers use).
    CMBT_DamageTrigger = TriggerCreate("CMBT_DamageHandler");
    TriggerEnable(CMBT_DamageTrigger, false);
    TriggerAddEventUnitDamaged(CMBT_DamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    CMBT_DiedTrigger = TriggerCreate("CMBT_DiedHandler");
    TriggerEnable(CMBT_DiedTrigger, false);
    TriggerAddEventUnitDied(CMBT_DiedTrigger, null);
    CMBT_HealLifeTrigger = TriggerCreate("CMBT_HealLifeHandler");
    TriggerEnable(CMBT_HealLifeTrigger, false);
    TriggerAddEventUnitHealed(CMBT_HealLifeTrigger, null, c_unitVitalLife, null);
    CMBT_HealShieldTrigger = TriggerCreate("CMBT_HealShieldHandler");
    TriggerEnable(CMBT_HealShieldTrigger, false);
    TriggerAddEventUnitHealed(CMBT_HealShieldTrigger, null, c_unitVitalShields, null);
    CMBT_AbilPurgeTrigger = TriggerCreate("CMBT_AbilPurgeHandler");
    TriggerEnable(CMBT_AbilPurgeTrigger, false);
    TriggerAddEventUnitAbility(CMBT_AbilPurgeTrigger, null, AbilityCommand(CMBT_MALASH_ABIL_PURGE, 0), c_unitAbilStageExecute, false);
    CMBT_AbilSacrificeTrigger = TriggerCreate("CMBT_AbilSacrificeHandler");
    TriggerEnable(CMBT_AbilSacrificeTrigger, false);
    TriggerAddEventUnitAbility(CMBT_AbilSacrificeTrigger, null, AbilityCommand(CMBT_MALASH_ABIL_SACRIFICE, 0), c_unitAbilStageExecute, false);
    CMBT_AbilShacklesTrigger = TriggerCreate("CMBT_AbilShacklesHandler");
    TriggerEnable(CMBT_AbilShacklesTrigger, false);
    TriggerAddEventUnitAbility(CMBT_AbilShacklesTrigger, null, AbilityCommand(CMBT_MALASH_ABIL_SHACKLES, 0), c_unitAbilStageExecute, false);
    CMBT_AbilBreakTrigger = TriggerCreate("CMBT_AbilBreakHandler");
    TriggerEnable(CMBT_AbilBreakTrigger, false);
    TriggerAddEventUnitAbility(CMBT_AbilBreakTrigger, null, AbilityCommand(CMBT_MALASH_ABIL_BREAK, 0), c_unitAbilStageExecute, false);
    CMBT_AbilOrderTrigger = TriggerCreate("CMBT_AbilOrderHandler");
    TriggerEnable(CMBT_AbilOrderTrigger, false);
    TriggerAddEventUnitAbility(CMBT_AbilOrderTrigger, null, AbilityCommand(CMBT_MALASH_ABIL_ORDER, 0), c_unitAbilStageExecute, false);
    CMBT_ResearchTrigger = TriggerCreate("CMBT_ResearchHandler");
    TriggerEnable(CMBT_ResearchTrigger, false);
    TriggerAddEventUnitResearchProgress(CMBT_ResearchTrigger, null, c_unitProgressStageComplete);
    CMBT_UpgradeTrigger = TriggerCreate("CMBT_UpgradeHandler");
    TriggerEnable(CMBT_UpgradeTrigger, false);
    TriggerAddEventUpgradeLevelChanged(CMBT_UpgradeTrigger, c_playerAny);
    CMBT_PlayerLeftTrigger = TriggerCreate("CMBT_PlayerLeftHandler");
    TriggerEnable(CMBT_PlayerLeftTrigger, false);
    TriggerAddEventPlayerLeft(CMBT_PlayerLeftTrigger, c_playerAny, c_gameResultUndecided);
    CMBT_HeroReviveTrigger = TriggerCreate("CMBT_HeroReviveHandler");
    TriggerEnable(CMBT_HeroReviveTrigger, true);
    TriggerAddEventUnitRevive(CMBT_HeroReviveTrigger, null);
    CMBT_UnitCreatedTrigger = TriggerCreate("CMBT_UnitCreatedHandler");
    TriggerEnable(CMBT_UnitCreatedTrigger, true);
    TriggerAddEventUnitCreated(CMBT_UnitCreatedTrigger, null, null, null);
    CMBT_MutBehaviorTrigger = TriggerCreate("CMBT_MutBehaviorHandler");
    TriggerEnable(CMBT_MutBehaviorTrigger, false);
    lv_i = 1;
    while ((lv_i <= CMBT_MutBuffCount)) {
        TriggerAddEventUnitBehaviorChange(CMBT_MutBehaviorTrigger, null, CMBT_MutBuffBehavior[lv_i], c_unitBehaviorChangeAny);
        lv_i += 1;
    }
    CMBT_MutEffectTrigger = TriggerCreate("CMBT_MutEffectHandler");
    TriggerEnable(CMBT_MutEffectTrigger, false);
    lv_i = 1;
    while ((lv_i <= CMBT_MutatorEffectCount)) {
        TriggerAddEventPlayerEffectUsed(CMBT_MutEffectTrigger, c_playerAny, CMBT_MutatorEffectId[lv_i]);
        lv_i += 1;
    }
    CMBT_CommandTrigger = TriggerCreate("CMBT_CommandHandler");
    TriggerEnable(CMBT_CommandTrigger, false);
    TriggerAddEventUnitOrder(CMBT_CommandTrigger, null, null);

    CMBT_StartupTimer = TimerCreate();
    CMBT_StartupTrigger = TriggerCreate("CMBT_StartupHandler");
    TriggerAddEventTimer(CMBT_StartupTrigger, CMBT_StartupTimer);
    TimerStart(CMBT_StartupTimer, 3.0, false, c_timeGame);
}
