    return true;
}

// T5b: ability casts have no data-layer carrier (no charges, no counting buff), so they are
// counted from the Unit Uses Ability event at the Execute stage (precedent: LibCOMI.galaxy:25207,
// the Raynor banshee achievement; EventUnit() is the caster, as in the Alarak sacrifice
// trigger LibCOMI.galaxy:26552). Casts by either of our players are counted; the abilities only
// exist on Malash units, so in a non-Malash game the events never fire.
void CMBT_RecordCast (int lp_field) {
    int lv_owner;

    if ((CMBT_Enabled == false)) {
        return;
    }
    if ((EventUnit() == null)) {
        return;
    }
    lv_owner = UnitGetOwner(EventUnit());
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return;
    }
    CMBT_CastCount[lp_field] += 1;
}

