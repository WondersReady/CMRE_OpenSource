const int CMBT_VF_DAMAGE = 0;
const int CMBT_VF_OVERKILL = 1;
const int CMBT_VI_HITS = 0;
const int CMBT_VI_KILLS = 1;

// Periodic chunk streams. Stream 0 lives in bank 1, streams 1..7 in bank 2.
const int CMBT_STREAM_SAMPLES = 0;
const int CMBT_STREAM_TAKEN = 1;
const int CMBT_STREAM_ENEMY = 2;
const int CMBT_STREAM_GROWTH = 3;
const int CMBT_STREAM_FIELD = 4;
