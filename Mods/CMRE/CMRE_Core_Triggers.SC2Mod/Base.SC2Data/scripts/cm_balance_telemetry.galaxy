// -----------------------------------------------------------------------------
// UT_DL Damage Source Interception (Native-style encapsulation)
// -----------------------------------------------------------------------------
bool CMBT_UT_DL_IsValidDamageSource () {
    if (EventUnitDamageSourceUnit() != null) {
        return true;
    }
    if (EventUnitDamageEffect() == "NovaGriffinBombingRunDamage") {
        return true;
    }
    return false;
}

string CMBT_UT_DL_GetDamageSourceUnitType () {
    if (EventUnitDamageEffect() == "NovaGriffinBombingRunDamage") {
        return "NovaGriffinBombingRunStrafer";
    }
    return UnitGetType(EventUnitDamageSourceUnit());
}

// -----------------------------------------------------------------------------
// Small helpers
// -----------------------------------------------------------------------------
string CMBT_UnitKey (int lp_player, int lp_slot) {
    return ("P" + IntToString(lp_player) + "S" + IntToString(lp_slot));
}

void CMBT_Message (int lp_player, string lp_message) {
    UIDisplayMessage(PlayerGroupSingle(lp_player), c_messageAreaSubtitle, StringToText("[Balance Telemetry] " + lp_message));
}

string CMBT_TwoDigit (int lp_value) {
    if ((lp_value < 10)) {
        return ("0" + IntToString(lp_value));
    }
    return IntToString(lp_value);
}

string CMBT_WallText (int lp_timestamp) {
    datetime lv_time;

    lv_time = IntToDateTime(lp_timestamp);
    return (IntToString(GetDateTimeYear(lv_time)) + "/" + CMBT_TwoDigit(GetDateTimeMonth(lv_time)) + "/" + CMBT_TwoDigit(GetDateTimeDay(lv_time)) + " " + CMBT_TwoDigit(GetDateTimeHour(lv_time)) + ":" + CMBT_TwoDigit(GetDateTimeMinute(lv_time)) + ":" + CMBT_TwoDigit(GetDateTimeSecond(lv_time)));
}

string CMBT_AsciiAlnumPrefix (string lp_value, int lp_max) {
    int lv_i;
    string lv_char;
    string lv_out;

    lv_i = 1;
    lv_char = "";
    lv_out = "";
    while (((lv_i <= StringLength(lp_value)) && (StringLength(lv_out) < lp_max))) {
        lv_char = StringSub(lp_value, lv_i, lv_i);
        if ((StringContains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", lv_char, c_stringAnywhere, c_stringCase) == true)) {
            lv_out += lv_char;
        }
        lv_i += 1;
    }
    if ((lv_out == "")) {
        return "CM";
    }
    return lv_out;
}

// Commander ids carry a race prefix (ProtossMalash, TerranMengsk); drop it so the 6-char bank tag names the commander.
string CMBT_StripRacePrefix (string lp_id) {
    if (((StringLength(lp_id) > 7) && (StringSub(lp_id, 1, 7) == "Protoss"))) {
        return StringSub(lp_id, 8, StringLength(lp_id));
    }
    if (((StringLength(lp_id) > 6) && (StringSub(lp_id, 1, 6) == "Terran"))) {
        return StringSub(lp_id, 7, StringLength(lp_id));
    }
    if (((StringLength(lp_id) > 4) && (StringSub(lp_id, 1, 4) == "Zerg"))) {
        return StringSub(lp_id, 5, StringLength(lp_id));
    }
    return lp_id;
}

string CMBT_BuildBankBaseName (int lp_startedAt, int lp_player) {
    datetime lv_time;
    string lv_commander;

    lv_time = IntToDateTime(lp_startedAt);
    lv_commander = CMBT_AsciiAlnumPrefix(CMBT_StripRacePrefix(libCOOC_gf_ActiveCommanderForPlayer(lp_player)), CMBT_COMMANDER_NAME_CHARS);
    return (CMBT_BANK_PREFIX + IntToString(GetDateTimeYear(lv_time)) + CMBT_TwoDigit(GetDateTimeMonth(lv_time)) + CMBT_TwoDigit(GetDateTimeDay(lv_time)) + "T" + CMBT_TwoDigit(GetDateTimeHour(lv_time)) + CMBT_TwoDigit(GetDateTimeMinute(lv_time)) + CMBT_TwoDigit(GetDateTimeSecond(lv_time)) + lv_commander);
}

string CMBT_StreamSection (int lp_stream) {
    if ((lp_stream == CMBT_STREAM_SAMPLES)) {
        return CMBT_SAMPLES_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_TAKEN)) {
        return CMBT_TAKEN_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_ENEMY)) {
        return CMBT_ENEMY_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_GROWTH)) {
        return CMBT_GROWTH_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_FIELD)) {
        return CMBT_FIELD_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_VICTIM)) {
        return CMBT_VICTIM_SECTION;
    }
    if ((lp_stream == CMBT_STREAM_ECON)) {
        return CMBT_ECON_SECTION;
    }
    return CMBT_HERO_SECTION;
}

// Linear search over this module's own slot table, creating a slot on demand.
// Morph pairs share a slot (same rule UT_DL's damage log uses), so e.g. a sieged tank does
// not split away from its unsieged form. Returns 0 when the type is unusable or the table
// is full (the overflow is counted and reported in Meta.SlotOverflow).
int CMBT_FindSlot (int lp_player, string lp_unitType, bool lp_create) {
    int lv_slot;

    if (((lp_player < 1) || (lp_player > 2))) {
        return 0;
    }
    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }

    // Exact match first: it is a plain string compare and covers virtually every event.
    // The morph-pair test is a long boolean chain, so it only runs once the cheap pass has
    // failed for the whole table.
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        if ((lp_unitType == CMBT_SlotType[lv_slot][lp_player])) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        if ((libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_SlotType[lv_slot][lp_player]) == true)) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    if ((lp_create == false)) {
        return 0;
    }
    if ((CMBT_SlotCount[lp_player] >= CMBT_MAX_SLOTS)) {
        CMBT_SlotOverflow += 1;
        return 0;
    }

    CMBT_SlotCount[lp_player] += 1;
    CMBT_SlotType[CMBT_SlotCount[lp_player]][lp_player] = lp_unitType;
    return CMBT_SlotCount[lp_player];
}

int CMBT_FindEnemySlot (string lp_unitType) {
    int lv_slot;

    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if ((lp_unitType == CMBT_EnemyType[lv_slot])) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if ((libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_EnemyType[lv_slot]) == true)) {
            return lv_slot;
        }
        lv_slot += 1;
    }

    if ((CMBT_EnemyCount >= CMBT_MAX_ENEMY_SLOTS)) {
        CMBT_EnemyOverflow += 1;
        return 0;
    }

    CMBT_EnemyCount += 1;
    CMBT_EnemyType[CMBT_EnemyCount] = lp_unitType;
    return CMBT_EnemyCount;
}

int CMBT_FindVictimSlot (string lp_unitType) {
    int lv_slot;

    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return 0;
    }
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((lp_unitType == CMBT_VictimType[lv_slot])) {
            return lv_slot;
        }
        lv_slot += 1;
    }
    BankValueSetFromInt(CMBT_Bank, CMBT_OUR_UNITS_SECTION, "Count", CMBT_SlotCount[1] + CMBT_SlotCount[2]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_OUR_UNITS_SECTION, "Count", CMBT_SlotCount[1] + CMBT_SlotCount[2]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION, "Count", CMBT_EnemyCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION, "Count", CMBT_VictimCount);
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((libCOTF_gf_UT_AreMorphUnits(lp_unitType, CMBT_VictimType[lv_slot]) == true)) {
            return lv_slot;
        }
        lv_slot += 1;
    }
    if ((CMBT_VictimCount >= CMBT_MAX_VICTIM_SLOTS)) {
        CMBT_VictimOverflow += 1;
        return 0;
    }
    CMBT_VictimCount += 1;
    CMBT_VictimType[CMBT_VictimCount] = lp_unitType;
    return CMBT_VictimCount;
}

// Drains the whole-number part of an accumulator, leaving the remainder for the next frame.
int CMBT_TakeFixed (int lp_slot, int lp_field, int lp_player) {
    int lv_out;

    lv_out = FixedToInt(CMBT_Acc[lp_slot][lp_field][lp_player]);
    CMBT_Acc[lp_slot][lp_field][lp_player] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeEnemyFixed (int lp_slot) {
    int lv_out;

    lv_out = FixedToInt(CMBT_EnemyAcc[lp_slot]);
    CMBT_EnemyAcc[lp_slot] -= IntToFixed(lv_out);
    return lv_out;
}

int CMBT_TakeVictimFixed (int lp_slot, int lp_field, int lp_player) {
    int lv_out;

    lv_out = FixedToInt(CMBT_VictimAcc[lp_slot][lp_field][lp_player]);
    CMBT_VictimAcc[lp_slot][lp_field][lp_player] -= IntToFixed(lv_out);
    return lv_out;
}

// Encodes CMBT_PackBuf[0 .. lp_count-1] as "slot:v0/v1/..", dropping trailing zero fields.
// Returns "" when every field is zero, so the slot is omitted from the frame entirely.
string CMBT_PackRecord (int lp_slot, int lp_count) {
    int lv_i;
    int lv_last;
    string lv_record;

    lv_last = -1;
    lv_i = 0;
    while ((lv_i < lp_count)) {
        if ((CMBT_PackBuf[lv_i] != 0)) {
            lv_last = lv_i;
        }
        lv_i += 1;
    }

    if ((lv_last < 0)) {
        return "";
    }

    lv_record = IntToString(lp_slot) + ":";
    lv_i = 0;
    while ((lv_i <= lv_last)) {
        if ((lv_i > 0)) {
            lv_record += "/";
        }
        lv_record += IntToString(CMBT_PackBuf[lv_i]);
        lv_i += 1;
    }
    return lv_record;
}

// -----------------------------------------------------------------------------
// Frame builders (each drains the accumulators it reports)
// -----------------------------------------------------------------------------
string CMBT_BuildSampleSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        CMBT_PackBuf[0] = CMBT_TakeFixed(lv_slot, CMBT_F_DEALT, lp_player);
        CMBT_PackBuf[1] = CMBT_Present[lv_slot][lp_player];
        CMBT_PackBuf[2] = CMBT_AccInt[lv_slot][CMBT_I_HITS][lp_player];
        CMBT_PackBuf[3] = CMBT_TakeFixed(lv_slot, CMBT_F_OVERKILL, lp_player);
        CMBT_PackBuf[4] = CMBT_TakeFixed(lv_slot, CMBT_F_DEALTNEUTRAL, lp_player);
        CMBT_PackBuf[5] = CMBT_AtkCount[lv_slot][lp_player];
        CMBT_AccInt[lv_slot][CMBT_I_HITS][lp_player] = 0;
        CMBT_AtkCount[lv_slot][lp_player] = 0;

        lv_record = CMBT_PackRecord(lv_slot, 6);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildTakenSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_SlotCount[lp_player])) {
        CMBT_PackBuf[0] = CMBT_TakeFixed(lv_slot, CMBT_F_TAKENLIFE, lp_player);
        CMBT_PackBuf[1] = CMBT_TakeFixed(lv_slot, CMBT_F_TAKENSHIELD, lp_player);
        CMBT_PackBuf[2] = CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lp_player];
        CMBT_PackBuf[3] = CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lp_player];
        CMBT_PackBuf[4] = CMBT_TakeFixed(lv_slot, CMBT_F_HEALLIFE, lp_player);
        CMBT_PackBuf[5] = CMBT_TakeFixed(lv_slot, CMBT_F_HEALSHIELD, lp_player);
        CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lp_player] = 0;
        CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lp_player] = 0;

        lv_record = CMBT_PackRecord(lv_slot, 6);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildEnemySegment () {
    int lv_slot;
    int lv_damage;
    string lv_payload;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        lv_damage = CMBT_TakeEnemyFixed(lv_slot);
        if ((lv_damage != 0)) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += (IntToString(lv_slot) + ":" + IntToString(lv_damage));
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildVictimSegment (int lp_player) {
    int lv_slot;
    string lv_payload;
    string lv_record;

    lv_payload = "";
    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        CMBT_PackBuf[0] = CMBT_TakeVictimFixed(lv_slot, CMBT_VF_DAMAGE, lp_player);
        CMBT_PackBuf[1] = CMBT_VictimAccInt[lv_slot][CMBT_VI_HITS][lp_player];
        CMBT_PackBuf[2] = CMBT_TakeVictimFixed(lv_slot, CMBT_VF_OVERKILL, lp_player);
        CMBT_PackBuf[3] = CMBT_VictimAccInt[lv_slot][CMBT_VI_KILLS][lp_player];
        CMBT_VictimAccInt[lv_slot][CMBT_VI_HITS][lp_player] = 0;
        CMBT_VictimAccInt[lv_slot][CMBT_VI_KILLS][lp_player] = 0;
        lv_record = CMBT_PackRecord(lv_slot, 4);
        if ((lv_record != "")) {
            if ((lv_payload != "")) {
                lv_payload += ",";
            }
            lv_payload += lv_record;
        }
        lv_slot += 1;
    }
    return lv_payload;
}

string CMBT_BuildEconSegment (int lp_player) {
    return (IntToString(PlayerGetPropertyInt(lp_player, c_playerPropMinerals)) + "/" + IntToString(PlayerGetPropertyInt(lp_player, c_playerPropVespene)) + "/" + IntToString(PlayerScoreValueGetAsInt(lp_player, "MineralsCollected")) + "/" + IntToString(PlayerScoreValueGetAsInt(lp_player, "VespeneCollected")) + "/" + IntToString(FixedToInt(PlayerGetPropertyFixed(lp_player, c_playerPropSuppliesUsed) * 100.0)) + "/" + IntToString(PlayerGetPropertyInt(lp_player, c_playerPropSuppliesLimit) * 100));
}

string CMBT_BuildHeroSegment (int lp_player) {
    unit lv_hero;
    int lv_deaths;

    lv_hero = libCOMI_gv_cM_HeroUnit[lp_player];
    lv_deaths = libCOMI_gv_cM_HeroDeathCount[lp_player];
    if (((lv_hero == null) || (UnitIsValid(lv_hero) == false))) {
        return "";
    }
    if ((lv_deaths < 0)) {
        lv_deaths = 0;
    }
    return ("1/" + IntToString(BoolToInt(UnitIsAlive(lv_hero))) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropLife, c_unitPropCurrent) * 100.0)) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropShields, c_unitPropCurrent) * 100.0)) + "/" + IntToString(FixedToInt(UnitGetPropertyFixed(lv_hero, c_unitPropEnergy, c_unitPropCurrent) * 100.0)) + "/" + IntToString(lv_deaths));
}

// Growth payload. While no supported commander is detected the segment stays empty (frame
// "t|", exporter status "reserved"). Once active every field is written explicitly: a numeric
// zero is an observation, an empty token means "not observable this frame" (e.g. hero dead).
string CMBT_BuildGrowthSegment () {
    int lv_i;
    string lv_payload;

    if ((CMBT_GrowthActive == false)) {
        return "";
    }

    lv_payload = "";
    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        if ((lv_i > 1)) {
            lv_payload += ",";
        }
        if ((CMBT_GrowthKnown[lv_i] == true)) {
            lv_payload += IntToString(CMBT_Growth[lv_i]);
        }
        lv_i += 1;
    }
    return lv_payload;
}

// 3.2: hostile-to-P1 on-field vitals, one full-map enumeration per sample. Non-structure and
// structure totals are two UnitGroupAlliance passes (precedent LibCOMU.galaxy:4420 / :5540:
// alliance group plus a UnitFilter whose require/exclude halves split the low and high
// target-filter bits). Destructibles such as rocks are neither Structure nor Missile and
// therefore land on the non-structure side (noted in the changelog).
void CMBT_UpdateEnemyField () {
    int lv_i;
    int lv_count;
    fixed lv_hp;
    unitgroup lv_group;
    unit lv_unit;

    CMBT_FieldHpUnits = 0.0;
    CMBT_FieldHpStructures = 0.0;
    CMBT_FieldNUnits = 0;
    CMBT_FieldNStructures = 0;

    lv_group = UnitGroupAlliance(CMBT_FIELD_PLAYER, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_hp = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_hp += UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent);
            CMBT_FieldHpUnits += lv_hp;
            CMBT_FieldNUnits += 1;
        }
        lv_i += 1;
    }

    lv_group = UnitGroupAlliance(CMBT_FIELD_PLAYER, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_hp = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_hp += UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent);
            CMBT_FieldHpStructures += lv_hp;
            CMBT_FieldNStructures += 1;
        }
        lv_i += 1;
    }
}

// 3.2: Field frame body "hu,hs,nu,ns" — every value explicit (measured zeros included). The
// fixed sums restart each sample, so per-frame truncation cannot drift across frames.
string CMBT_BuildFieldSegment () {
    return (IntToString(FixedToInt(CMBT_FieldHpUnits)) + "," + IntToString(FixedToInt(CMBT_FieldHpStructures)) + "," + IntToString(CMBT_FieldNUnits) + "," + IntToString(CMBT_FieldNStructures));
}

// T6 / B-22: enumerate living, visible, non-missile P1/P2 units before serializing.
// Register types even if they have never produced a combat event. Morph pairs use the
// same slot lookup as damage, so both forms contribute to that slot's present count.
void CMBT_UpdatePresent () {
    int lv_player;
    int lv_slot;
    int lv_count;
    int lv_i;
    unitgroup lv_group;
    unit lv_unit;

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_Present[lv_slot][lv_player] = 0;
            lv_slot += 1;
        }
        lv_group = UnitGroup(null, lv_player, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_group, c_unitCountAll);
        lv_i = 1;
        while ((lv_i <= lv_count)) {
            lv_unit = UnitGroupUnit(lv_group, lv_i);
            if ((lv_unit != null)) {
                lv_slot = CMBT_FindSlot(lv_player, UnitGetType(lv_unit), true);
                if ((lv_slot > 0)) {
                    CMBT_Present[lv_slot][lv_player] += 1;
                }
            }
            lv_i += 1;
        }
        lv_player += 1;
    }
}

// T5: commander-specific growth carriers. Malash wired (U22 settled: the three attributes and
// army obedience are CBehaviorAttribute stacks, read with UnitBehaviorCount; precedent
// LibCOMU.galaxy:4388). Nut's stack count is still not wired.
string CMBT_GrowthFieldName (int lp_field) {
    if ((lp_field == CMBT_G_SADISM)) {
        return "Sadism";
    }
    if ((lp_field == CMBT_G_CUNNING)) {
        return "Cunning";
    }
    if ((lp_field == CMBT_G_DOMINION)) {
        return "Dominion";
    }
    if ((lp_field == CMBT_G_OBEDIENCE_MEAN)) {
        return "ObedienceMean";
    }
    if ((lp_field == CMBT_G_OBEDIENCE_MAX)) {
        return "ObedienceMax";
    }
    if ((lp_field == CMBT_G_ARMY_COUNT)) {
        return "ArmyCount";
    }
    if ((lp_field == CMBT_G_CAST_PURGE)) {
        return "CastPurge";
    }
    if ((lp_field == CMBT_G_CAST_SACRIFICE)) {
        return "CastSacrifice";
    }
    if ((lp_field == CMBT_G_CAST_SHACKLES)) {
        return "CastShackles";
    }
    if ((lp_field == CMBT_G_CAST_BREAK)) {
        return "CastBreak";
    }
    if ((lp_field == CMBT_G_CAST_ORDER)) {
        return "CastOrder";
    }
    return "reserved";
}

// Alive units of one exact type owned by one player (same filter the T6 presence count uses).
unitgroup CMBT_OwnedUnitsOfType (int lp_player, string lp_unitType) {
    return UnitGroup(lp_unitType, lp_player, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
}

// Malash detection: the commander string (libCOOC_gv_cCX_PlayerCommander) contains "Malash",
// or a live hero unit of type Malash is owned by the player. Either alone is enough, so a
// non-standard commander string still activates once the hero is on the field.
bool CMBT_IsMalashPlayer (int lp_player) {
    string lv_commander;

    lv_commander = libCOOC_gf_ActiveCommanderForPlayer(lp_player);
    if (((lv_commander != null) && (lv_commander != ""))) {
        if ((StringContains(lv_commander, CMBT_MALASH_HERO, c_stringAnywhere, c_stringNoCase) == true)) {
            return true;
        }
    }
    if ((UnitGroupCount(CMBT_OwnedUnitsOfType(lp_player, CMBT_MALASH_HERO), c_unitCountAlive) > 0)) {
        return true;
    }
    return false;
}

unit CMBT_FindMalashHero (int lp_player) {
    unitgroup lv_group;

    lv_group = CMBT_OwnedUnitsOfType(lp_player, CMBT_MALASH_HERO);
    if ((UnitGroupCount(lv_group, c_unitCountAlive) <= 0)) {
        return null;
    }
    return UnitGroupUnit(lv_group, 1);
}

// Flips the Growth section from "reserved" to the Malash schema in both banks' Meta and in
// bank 2's Units field names. Idempotent; called from CMBT_Start or from the first frame in
// which Malash is detected.
void CMBT_ActivateGrowth () {
    int lv_i;

    CMBT_GrowthActive = true;
    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "GrowthImplemented", 1);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthImplemented", 1);
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "GrowthSchema", "Malash");
    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_GROWTH_FIELDS_SECTION, "G" + IntToString(lv_i), CMBT_GrowthFieldName(lv_i));
        lv_i += 1;
    }
}

// Adds every live unit of one army type into the obedience sum / max / count.
// MalashStalkerShadow (the stalker's shadow image) carries no obedience and is not one of the
// four types passed in, so it is excluded by construction.
void CMBT_AccumulateObedience (int lp_player, string lp_unitType) {
    unitgroup lv_group;
    unit lv_unit;
    int lv_count;
    int lv_i;
    int lv_value;

    lv_group = CMBT_OwnedUnitsOfType(lp_player, lp_unitType);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while ((lv_i <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        if ((lv_unit != null)) {
            lv_value = UnitBehaviorCount(lv_unit, CMBT_MALASH_OBEDIENCE);
            CMBT_ObedienceSum += lv_value;
            if ((lv_value > CMBT_ObedienceMax)) {
                CMBT_ObedienceMax = lv_value;
            }
            CMBT_ObedienceCount += 1;
        }
        lv_i += 1;
    }
}

void CMBT_UpdateGrowth () {
    unit lv_hero;
    int lv_i;

    if ((CMBT_GrowthActive == false)) {
        if ((CMBT_IsMalashPlayer(CMBT_GROWTH_PLAYER) == false)) {
            return;
        }
        CMBT_ActivateGrowth();
    }

    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        CMBT_Growth[lv_i] = 0;
        CMBT_GrowthKnown[lv_i] = false;
        lv_i += 1;
    }

    // G1..G3: hero attributes. Unobservable (empty token) while the hero is dead / reviving.
    lv_hero = CMBT_FindMalashHero(CMBT_GROWTH_PLAYER);
    if ((lv_hero != null)) {
        CMBT_Growth[CMBT_G_SADISM] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_SADISM);
        CMBT_Growth[CMBT_G_CUNNING] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_CUNNING);
        CMBT_Growth[CMBT_G_DOMINION] = UnitBehaviorCount(lv_hero, CMBT_MALASH_ATTR_DOMINION);
        CMBT_GrowthKnown[CMBT_G_SADISM] = true;
        CMBT_GrowthKnown[CMBT_G_CUNNING] = true;
        CMBT_GrowthKnown[CMBT_G_DOMINION] = true;
    }

    // G4..G6: army obedience over the four army types (ValidatorData.xml TargetIsMalashArmy).
    CMBT_ObedienceSum = 0;
    CMBT_ObedienceMax = 0;
    CMBT_ObedienceCount = 0;
    CMBT_AccumulateObedience(CMBT_GROWTH_PLAYER, "MalashZealot");
    CMBT_AccumulateObedience(CMBT_GROWTH_PLAYER, "MalashAdept");
    CMBT_AccumulateObedience(CMBT_GROWTH_PLAYER, "MalashStalker");
    CMBT_AccumulateObedience(CMBT_GROWTH_PLAYER, "MalashDarkTemplar");
    if ((CMBT_ObedienceCount > 0)) {
        CMBT_Growth[CMBT_G_OBEDIENCE_MEAN] = (CMBT_ObedienceSum / CMBT_ObedienceCount);
    }
    CMBT_Growth[CMBT_G_OBEDIENCE_MAX] = CMBT_ObedienceMax;
    CMBT_Growth[CMBT_G_ARMY_COUNT] = CMBT_ObedienceCount;
    CMBT_GrowthKnown[CMBT_G_OBEDIENCE_MEAN] = true;
    CMBT_GrowthKnown[CMBT_G_OBEDIENCE_MAX] = true;
    CMBT_GrowthKnown[CMBT_G_ARMY_COUNT] = true;

    // G7..G11: casts since the previous frame (T5b event counters), then drained.
    lv_i = CMBT_G_CAST_PURGE;
    while ((lv_i <= CMBT_G_CAST_ORDER)) {
        CMBT_Growth[lv_i] = CMBT_CastCount[lv_i];
        CMBT_CastCount[lv_i] = 0;
        CMBT_GrowthKnown[lv_i] = true;
        lv_i += 1;
    }
}

void CMBT_RegisterUnitKeys () {
    int lv_player;
    int lv_slot;
    string lv_key;

    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_SlotCount[lv_player])) {
            if ((CMBT_SlotNamed[lv_slot][lv_player] == false)) {
                lv_key = CMBT_UnitKey(lv_player, lv_slot);
                BankValueSetFromString(CMBT_Bank, CMBT_OUR_UNITS_SECTION, lv_key, CMBT_SlotType[lv_slot][lv_player]);
                BankValueSetFromString(CMBT_Bank2, CMBT_OUR_UNITS_SECTION, lv_key, CMBT_SlotType[lv_slot][lv_player]);
                CMBT_SlotNamed[lv_slot][lv_player] = true;
            }
            lv_slot += 1;
        }
        lv_player += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_EnemyCount)) {
        if ((CMBT_EnemyNamed[lv_slot] == false)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION, "E" + IntToString(lv_slot), CMBT_EnemyType[lv_slot]);
            CMBT_EnemyNamed[lv_slot] = true;
        }
        lv_slot += 1;
    }

    lv_slot = 1;
    while ((lv_slot <= CMBT_VictimCount)) {
        if ((CMBT_VictimNamed[lv_slot] == false)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION, "V" + IntToString(lv_slot), CMBT_VictimType[lv_slot]);
            CMBT_VictimNamed[lv_slot] = true;
        }
        lv_slot += 1;
    }

    lv_player = 1;
    while ((lv_player <= 2)) {
        if (((libCOMI_gv_cM_HeroUnit[lv_player] != null) && (UnitIsValid(libCOMI_gv_cM_HeroUnit[lv_player]) == true))) {
            BankValueSetFromString(CMBT_Bank2, CMBT_HERO_UNITS_SECTION, "P" + IntToString(lv_player), UnitGetType(libCOMI_gv_cM_HeroUnit[lv_player]));
        }
        lv_player += 1;
    }
}

// Settles U21/U24 in the first captured game: is the Unit Damaged event raised before or
// after the damage is applied? Writes the first CMBT_ORDER_PROBE_MAX hits taken by our units
// as "type|amount|life|lifeMax|shields|shieldsMax" (all x100, integer). If life+shields
// equals the maximum, the event fires pre-application and the life/shield split plus the
// overkill column are exact; if it equals maximum-amount, the event fires post-application
// and both are re-derived offline. One-shot, no per-frame cost.
void CMBT_RecordOrderProbe (unit lp_unit, fixed lp_amount) {
    string lv_value;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    if ((CMBT_OrderProbeCount >= CMBT_ORDER_PROBE_MAX)) {
        return;
    }

    CMBT_OrderProbeCount += 1;
    lv_value = UnitGetType(lp_unit);
    lv_value += "|" + IntToString(FixedToInt(lp_amount * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropLife, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropLifeMax, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropShields, c_unitPropCurrent) * 100.0));
    lv_value += "|" + IntToString(FixedToInt(UnitGetPropertyFixed(lp_unit, c_unitPropShieldsMax, c_unitPropCurrent) * 100.0));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "OrderProbe" + IntToString(CMBT_OrderProbeCount), lv_value);
}

// First eight distinct (victim player, raw alliance flags) observations from P1/P2.
// These booleans do not yet establish a positive neutral classification. Preserve the
// first source player for each combination; later sources with the same flags dedupe.
void CMBT_RecordAllianceProbe (int lp_sourcePlayer, int lp_victimPlayer) {
    int lv_i;
    string lv_flags;
    string lv_key;

    if (((CMBT_Bank2 == null) || (CMBT_AllianceProbeCount >= CMBT_ALLIANCE_PROBE_MAX))) {
        return;
    }
    if (((lp_sourcePlayer != 1) && (lp_sourcePlayer != 2))) {
        return;
    }
    lv_flags = "";
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdVision, lp_victimPlayer) == true)) {
        lv_flags += "V1";
    }
    else {
        lv_flags += "V0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdControl, lp_victimPlayer) == true)) {
        lv_flags += "C1";
    }
    else {
        lv_flags += "C0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdPassive, lp_victimPlayer) == true)) {
        lv_flags += "Pa1";
    }
    else {
        lv_flags += "Pa0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdPushable, lp_victimPlayer) == true)) {
        lv_flags += "Pu1";
    }
    else {
        lv_flags += "Pu0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdSpend, lp_victimPlayer) == true)) {
        lv_flags += "Sp1";
    }
    else {
        lv_flags += "Sp0";
    }
    if ((PlayerGetAlliance(lp_sourcePlayer, c_allianceIdDefeat, lp_victimPlayer) == true)) {
        lv_flags += "De1";
    }
    else {
        lv_flags += "De0";
    }
    lv_key = IntToString(lp_victimPlayer) + "|" + lv_flags;
    lv_i = 0;
    while ((lv_i < CMBT_AllianceProbeCount)) {
        if ((CMBT_AllianceProbeKey[lv_i] == lv_key)) {
            return;
        }
        lv_i += 1;
    }
    CMBT_AllianceProbeKey[CMBT_AllianceProbeCount] = lv_key;
    CMBT_AllianceProbeCount += 1;
    BankValueSetFromString(CMBT_Bank2, CMBT_DIAG_SECTION, "AllianceProbe" + IntToString(CMBT_AllianceProbeCount), IntToString(lp_sourcePlayer) + "|" + lv_key);
}

string CMBT_BuildProbe () {
    int lv_i;
    string lv_out;

    lv_out = "";
    lv_i = 0;
    while ((lv_i < CMBT_PROBE_REPEATS)) {
        lv_out += "0123456789";
        lv_i += 1;
    }
    return lv_out;
}

string CMBT_EventField (string lp_value) {
    string lv_value;

    lv_value = lp_value;
    if ((lv_value == null)) {
        return "";
    }
    lv_value = StringReplaceWord(lv_value, "|", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, ";", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\n", "_", c_stringReplaceAll, c_stringCase);
    lv_value = StringReplaceWord(lv_value, "\r", "_", c_stringReplaceAll, c_stringCase);
    return lv_value;
}

void CMBT_AppendEvent (string lp_type, int lp_player, string lp_subject, string lp_value, string lp_source, string lp_precision) {
    int lv_sequence;
    string lv_event;
    string lv_candidate;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    if ((CMBT_EventCount >= CMBT_EVENT_MAX)) {
        CMBT_EventOverflow += 1;
        return;
    }
    lv_sequence = CMBT_EventCount + 1;
    lv_event = IntToString(lv_sequence) + "|" + IntToString(FixedToInt(GameGetMissionTime())) + "|" + CMBT_EventField(lp_type) + "|" + IntToString(lp_player) + "|" + CMBT_EventField(lp_subject) + "|" + CMBT_EventField(lp_value) + "|" + CMBT_EventField(lp_source) + "|" + CMBT_EventField(lp_precision);
    if ((StringLength(lv_event) > CMBT_EVENT_MAX_CHARS)) {
        CMBT_EventOverflow += 1;
        return;
    }
    if ((CMBT_EventChunkEntries >= CMBT_EVENTS_PER_CHUNK)) {
        CMBT_EventChunkText = "";
        CMBT_EventChunkEntries = 0;
    }
    if ((CMBT_EventChunkEntries == 0)) {
        if ((CMBT_EventChunkIndex >= CMBT_MAX_CHUNKS)) {
            CMBT_EventOverflow += 1;
            return;
        }
        CMBT_EventChunkIndex += 1;
    }
    lv_candidate = CMBT_EventChunkText;
    if ((CMBT_EventChunkEntries > 0)) {
        lv_candidate += ";";
    }
    lv_candidate += lv_event;
    if ((StringLength(lv_candidate) > CMBT_EVENT_CHUNK_MAX_CHARS)) {
        CMBT_EventOverflow += 1;
        return;
    }
    CMBT_EventChunkText = lv_candidate;
    CMBT_EventChunkEntries += 1;
    CMBT_EventCount = lv_sequence;
}

bool CMBT_IsTrackedMutatorUnitType (string lp_type) {
    return ((lp_type == "MutatorAmonArtanis") || (lp_type == "MutatorAmonDehaka") || (lp_type == "MutatorAmonKarax") || (lp_type == "MutatorAmonKerrigan") || (lp_type == "MutatorAmonNova") || (lp_type == "MutatorAmonRaynor") || (lp_type == "MutatorAmonTychus") || (lp_type == "MutatorAmonZagara") || (lp_type == "MutatorAmonZeratul") || (lp_type == "MutatorVoidRift") || (lp_type == "MutatorPropagator") || (lp_type == "MutatorVoidReanimator") || (lp_type == "MutatorPurifierBeam") || (lp_type == "MutatorKillBot") || (lp_type == "MutatorBoomBot") || (lp_type == "MutatorDeathBot") || (lp_type == "MutatorMurderBot") || (lp_type == "MutatorLaserDrill") || (lp_type == "MutatorTornado") || (lp_type == "MutatorTurkey") || (lp_type == "MutatorTurking") || (lp_type == "MutatorMineralCrystal") || (lp_type == "MutatorGift") || (lp_type == "MutatorCloakedMine") || (lp_type == "MutatorSpiderMine") || (lp_type == "MutatorMissileNuke") || (lp_type == "MutatorOrbitalStrike") || (lp_type == "MutatorPhotonOvercharge") || (lp_type == "MutatorStoneZealot") || (lp_type == "MutatorDancingOracle"));
}

void CMBT_PrimeObjectives () {
    int lv_i;
    string lv_objective;

    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        CMBT_ObjectiveLast[lv_i] = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        lv_i += 1;
    }
}

void CMBT_UpdateObjectives () {
    int lv_i;
    string lv_objective;
    string lv_entry;

    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        lv_entry = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        if ((lv_entry != CMBT_ObjectiveLast[lv_i])) {
            CMBT_AppendEvent("ObjectiveChanged", 0, lv_objective, lv_entry, "ObjectivePoll", "5s_bucket_end");
            CMBT_ObjectiveLast[lv_i] = lv_entry;
        }
        lv_i += 1;
    }
}

void CMBT_WriteIdentityMeta (bank lp_bank, int lp_startedAt, string lp_bankName, string lp_otherBankName) {
    string lv_enemy;

    lv_enemy = libCOMI_gv_cM_CoopAIPlayer_CommanderShared;
    if (((lv_enemy == null) || (lv_enemy == ""))) {
        lv_enemy = libCOMI_gv_cM_CoopAIPlayer_Commander[3];
    }
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "StartedAt", lp_startedAt);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "LegacyEpoch", lp_startedAt);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "LegacyBank1", "CMCombatTelemetry" + IntToString(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "LegacyBank2", "CMCombatTelemetryX" + IntToString(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "BankName", lp_bankName);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "WallStartInt", lp_startedAt);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallStartText", CMBT_WallText(lp_startedAt));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallClockSource", "CurrentDateTimeGet");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "WallClockTimezone", "Unspecified");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapInstance", CMUIX_MapSelectionCurrentMapInstance());
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "EnemyAI", lv_enemy);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "EnemyRace", CMUIX_EnemySelectionRaceForEnemy(lv_enemy));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyBase", CMUIX_DifficultySelectedBase);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyPlus", CMUIX_DifficultySelectedPlus);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyP1", libCOMI_gf_DifficultyLevelForPlayerCoop(1));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "DifficultyP2", libCOMI_gf_DifficultyLevelForPlayerCoop(2));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "MissionDifficulty", libCOMI_gf_GetMissionDifficulty());
    if ((lp_bankName == CMBT_BankName)) {
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank2", lp_otherBankName);
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank2Name", lp_otherBankName);
    }
    else {
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank1", lp_otherBankName);
        BankValueSetFromString(lp_bank, CMBT_META_SECTION, "Bank1Name", lp_otherBankName);
    }
}

void CMBT_AppendDirectMutator (string lp_mutator, bool lp_enhanced) {
    if (((lp_mutator == "") || (lp_mutator == null) || (CMUIX_MutatorPoolIsPlaceholder(lp_mutator) == true))) {
        return;
    }
    if ((lp_mutator == "Chaos") || (UserDataGetInt("Mutators", lp_mutator, "Auto - Actived By Chaos", 1) >= 1) || (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lp_mutator) == true)) {
        return;
    }
    if ((CMBT_DirectMutatorCount >= CMBT_DIRECT_MUTATOR_MAX)) {
        CMBT_MutatorOverflow += 1;
        return;
    }
    CMBT_DirectMutatorCount += 1;
    BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "D" + IntToString(CMBT_DirectMutatorCount), lp_mutator + "|" + IntToString(BoolToInt(lp_enhanced)));
}

void CMBT_CaptureMutators () {
    int lv_i;
    int lv_count;
    int lv_chaosCount;
    string lv_mutator;
    bool lv_enhanced;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_MUTATORS_SECTION);
    CMBT_DirectMutatorCount = 0;
    CMBT_MutatorOverflow = 0;
    CMBT_IndexSlot = 0;
    CMBT_IndexOverflow = 0;
    lv_i = 1;
    lv_count = 0;
    lv_chaosCount = 0;
    lv_mutator = "";
    lv_enhanced = false;
    if ((((CMUIX_CurrentMode == CMUIX_MODE_STANDARD) || (CMUIX_CurrentMode == CMUIX_MODE_MUTATOR)) && (libCOMU_gv_cT_MAbomination_MutatorsCount > 0))) {
        lv_count = MinI(libCOMU_gv_cT_MAbomination_MutatorsCount, libCMUI_gv_cMUI_MutatorChallenge_Mutator_Max);
        while ((lv_i <= lv_count)) {
            CMBT_AppendDirectMutator(libCOMU_gv_cT_MAbomination_Mutators[lv_i], libCOMU_gv_cT_MAbomination_MutatorsEnhanced[lv_i]);
            lv_i += 1;
        }
    }
    else {
        lv_count = UserDataInstanceCount("Mutators");
        while ((lv_i <= lv_count)) {
            lv_mutator = UserDataInstance("Mutators", lv_i);
            if ((lv_mutator != "") && (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Chaos", 1) == 0) && (libCOMU_gf_CT_TemporaryMutatorHasLifetime(lv_mutator) == false)) {
                if ((UserDataGetInt("Mutators", lv_mutator, "Auto - Selected By Player", 1) >= 1) || (UserDataGetInt("Mutators", lv_mutator, "Auto - Actived By Random", 1) >= 1)) {
                    lv_enhanced = (UserDataGetInt("Mutators", lv_mutator, "Auto - Enhanced", 1) == 1);
                    CMBT_AppendDirectMutator(lv_mutator, lv_enhanced);
                }
            }
            lv_i += 1;
        }
    }
    lv_chaosCount = MinI(libCOTF_gv_rT_ChaosCycleCount, CMBT_DIRECT_MUTATOR_MAX);
    lv_i = 1;
    while ((lv_i <= lv_chaosCount)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "A" + IntToString(lv_i), libCOTF_gv_rT_ChaosMutators[lv_i] + "|" + IntToString(BoolToInt(libCOMU_gf_MutatorIsEnhanced(libCOTF_gv_rT_ChaosMutators[lv_i]))));
        lv_i += 1;
    }
    if ((libCOTF_gv_rT_ChaosCycleCount > CMBT_DIRECT_MUTATOR_MAX)) {
        CMBT_MutatorOverflow += (libCOTF_gv_rT_ChaosCycleCount - CMBT_DIRECT_MUTATOR_MAX);
    }
    lv_i = 1;
    while (((lv_i <= CMUIX_ResultChaosHistoryCount) && (lv_i <= CMBT_CHAOS_HISTORY_MAX))) {
        BankValueSetFromString(CMBT_Bank2, CMBT_MUTATORS_SECTION, "C" + IntToString(lv_i), CMUIX_ResultChaosHistoryMutators[lv_i] + "|" + IntToString(BoolToInt(CMUIX_ResultChaosHistoryEnhanced[lv_i])));
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "DirectCount", CMBT_DirectMutatorCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "ChaosSlotCount", lv_chaosCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "ChaosHistoryCount", MinI(CMUIX_ResultChaosHistoryCount, CMBT_CHAOS_HISTORY_MAX));
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "Overflow", CMBT_MutatorOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_MUTATORS_SECTION, "Truncated", BoolToInt((CMBT_MutatorOverflow > 0) || (CMUIX_ResultChaosHistoryCount >= CMBT_CHAOS_HISTORY_MAX)));
}

void CMBT_CapturePlayers () {
    int lv_player;
    int lv_i;
    int lv_count;
    int lv_masteryIndex;
    int lv_prestige;
    int lv_level;
    string lv_commander;
    string lv_mastery;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_PLAYERS_SECTION);
    lv_player = 1;
    lv_i = 0;
    lv_count = UserDataInstanceCount("MasteryUpgrades");
    lv_masteryIndex = 0;
    lv_prestige = 0;
    lv_level = 0;
    lv_commander = "";
    lv_mastery = "";
    while ((lv_player <= 2)) {
        lv_commander = CMUIX_ResultSnapshotCommander(lv_player);
        lv_prestige = 0;
        lv_level = 0;
        if (((lv_commander != "") && (lv_commander != null))) {
            lv_prestige = CMUIX_ReadPrestigeForCommander(lv_player, lv_commander);
            lv_level = libCOOC_gf_CC_CommanderLevel(lv_player, lv_commander);
        }
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Present", BoolToInt((PlayerStatus(lv_player) == c_playerStatusActive) && (PlayerType(lv_player) == c_playerTypeUser)));
        BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Name", TextToString(PlayerName(lv_player)));
        BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Commander", lv_commander);
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Prestige", lv_prestige);
        BankValueSetFromInt(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "Level", lv_level);
        lv_masteryIndex = 1;
        while ((lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER)) {
            BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "M" + IntToString(lv_masteryIndex), "|0");
            lv_masteryIndex += 1;
        }
        lv_i = 1;
        while ((lv_i <= lv_count)) {
            lv_mastery = UserDataInstance("MasteryUpgrades", lv_i);
            if ((UserDataGetUserInstance("MasteryUpgrades", lv_mastery, "Commander", 1) == lv_commander)) {
                lv_masteryIndex = libCOOC_gf_CC_PlayerMasteryInternalIndex(lv_mastery);
                if (((lv_masteryIndex >= 1) && (lv_masteryIndex <= libCOOC_gv_cCC_MASTERIES_PER_COMMANDER))) {
                    BankValueSetFromString(CMBT_Bank2, CMBT_PLAYERS_SECTION, "P" + IntToString(lv_player) + "M" + IntToString(lv_masteryIndex), lv_mastery + "|" + IntToString(libCOOC_gf_CC_PlayerMasteryUpgradeLevel(lv_player, lv_mastery)));
                }
            }
            lv_i += 1;
        }
        lv_player += 1;
    }
}

string CMBT_ScoreKey (int lp_index) {
    if ((lp_index == 1)) { return "UnitsStructuresKilled"; }
    if ((lp_index == 2)) { return "UnitsProduced"; }
    if ((lp_index == 3)) { return "ResourcesGathered"; }
    if ((lp_index == 4)) { return libCOOC_gf_CC_MapScoreStatistic(libCOOC_gf_CC_CurrentMap()); }
    if ((lp_index == 5)) { return libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultSnapshotCommander(1)); }
    if ((lp_index == 6)) { return libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultSnapshotCommander(1)); }
    if ((lp_index == 7)) { return libCOOC_gf_CC_CommanderScoreCoopStatistic(CMUIX_ResultSnapshotCommander(2)); }
    if ((lp_index == 8)) { return libCOOC_gf_CC_CommanderScoreSelfStatistic(CMUIX_ResultSnapshotCommander(2)); }
    return "UnitsLostCount";
}

void CMBT_CaptureOutcomeData () {
    int lv_i;
    int lv_count;
    string lv_objective;
    string lv_entry;
    string lv_key;

    if ((CMBT_Bank2 == null)) {
        return;
    }
    BankSectionRemove(CMBT_Bank2, CMBT_OBJECTIVES_SECTION);
    BankSectionRemove(CMBT_Bank2, CMBT_SCORE_STATS_SECTION);
    lv_i = 1;
    lv_count = 0;
    lv_objective = "";
    lv_entry = "";
    lv_key = "";
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        lv_objective = libCOOC_gv_cC_ObjectivesCreated[lv_i];
        lv_entry = CMUIX_HistoryObjectiveSnapshotEntry(lv_objective);
        if ((lv_entry != "")) {
            lv_count += 1;
            BankValueSetFromString(CMBT_Bank2, CMBT_OBJECTIVES_SECTION, "O" + IntToString(lv_count), lv_entry);
        }
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_OBJECTIVES_SECTION, "Count", lv_count);
    lv_i = 1;
    while ((lv_i <= 9)) {
        lv_key = CMBT_ScoreKey(lv_i);
        BankValueSetFromString(CMBT_Bank2, CMBT_SCORE_STATS_SECTION, "S" + IntToString(lv_i), lv_key + "|" + IntToString(PlayerScoreValueGetAsInt(1, lv_key)) + "|" + IntToString(PlayerScoreValueGetAsInt(2, lv_key)));
        lv_i += 1;
    }
    BankValueSetFromInt(CMBT_Bank2, CMBT_SCORE_STATS_SECTION, "Count", 9);
}

void CMBT_UpdateIndex (int lp_complete, int lp_truncated, int lp_result) {
    int lv_next;
    string lv_key;
    string lv_value;

    if ((CMBT_IndexBank == null)) {
        return;
    }
    if ((CMBT_IndexSlot <= 0)) {
        lv_next = 1;
        if ((BankKeyExists(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot") == true)) {
            lv_next = BankValueGetAsInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot");
        }
        if (((lv_next < 1) || (lv_next > CMBT_INDEX_MAX))) {
            lv_next = 1;
        }
        CMBT_IndexSlot = lv_next;
        lv_key = "R" + IntToString(CMBT_IndexSlot);
        if ((BankKeyExists(CMBT_IndexBank, CMBT_INDEX_RUNS_SECTION, lv_key) == true)) {
            CMBT_IndexOverflow += 1;
        }
        lv_next = CMBT_IndexSlot + 1;
        if ((lv_next > CMBT_INDEX_MAX)) {
            lv_next = 1;
        }
        BankValueSetFromInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "NextSlot", lv_next);
    }
    lv_key = "R" + IntToString(CMBT_IndexSlot);
    lv_value = CMBT_BankName + "|" + CMBT_Bank2Name + "|" + IntToString(lp_complete) + "|" + IntToString(lp_truncated) + "|" + IntToString(lp_result) + "|" + IntToString(FixedToInt(GameGetMissionTime()));
    BankValueSetFromString(CMBT_IndexBank, CMBT_INDEX_RUNS_SECTION, lv_key, lv_value);
    BankValueSetFromInt(CMBT_IndexBank, CMBT_INDEX_META_SECTION, "IndexOverflow", CMBT_IndexOverflow);
    BankSave(CMBT_IndexBank);
}

// Provenance written into both banks so a CSV can always be traced back to what produced it.
//   ScriptVersion : this module's own version.
//   GameVersion / ModVersion : the mod's declared strings (libCOMI_InitVariables,
//     LibCOMI.galaxy:39-40). The engine exposes NO version native — the native name table in
//     SC2_x64.exe carries GameMapName / GameMapDescription / GameMapPath / GameMapIsBlizzard
//     but nothing version-related — so "5.0.10 (89165)" is the build the mod is maintained
//     against, not a live read. GameVersionSource says so inside the bank too.
//   MapName / MapPath : live natives (precedent: cmui_customization.galaxy:17004-17005, where
//     GameMapPath() is assigned to a string and GameMapName() goes through TextToString).
//     MapPath is the closest thing to a map version: no native exposes one.
void CMBT_WriteEnvironmentMeta (bank lp_bank) {
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "ScriptVersion", CMBT_SCRIPT_VERSION);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "GameVersion", libCOMI_gv_cT_CurrentVersion);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "GameVersionSource", "libCOMI_gv_cT_CurrentVersion; mod-declared target build, no engine native exists");
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "ModVersion", libCOMI_gv_cT_CM_CurrentVersion);
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapName", TextToString(GameMapName()));
    BankValueSetFromString(lp_bank, CMBT_META_SECTION, "MapPath", GameMapPath());
}

// -----------------------------------------------------------------------------
// Session state
// -----------------------------------------------------------------------------
void CMBT_ResetStoredSession () {
    if ((CMBT_Bank != null)) {
        BankSectionRemove(CMBT_Bank, CMBT_META_SECTION);
        BankSectionRemove(CMBT_Bank, CMBT_OUR_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank, CMBT_SAMPLES_SECTION);
    }
    if ((CMBT_Bank2 != null)) {
        BankSectionRemove(CMBT_Bank2, CMBT_META_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_OUR_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ENEMY_SOURCES_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_VICTIM_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_GROWTH_FIELDS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_HERO_UNITS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_PLAYERS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_MUTATORS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_OBJECTIVES_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_SCORE_STATS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_TAKEN_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ENEMY_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_GROWTH_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_FIELD_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_VICTIM_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_ECON_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_HERO_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_EVENTS_SECTION);
        BankSectionRemove(CMBT_Bank2, CMBT_DIAG_SECTION);
    }
}

void CMBT_ResetState () {
    int lv_player;
    int lv_slot;
    int lv_field;
    int lv_i;

    lv_player = 1;
    while ((lv_player <= 2)) {
        CMBT_SlotCount[lv_player] = 0;
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_SlotType[lv_slot][lv_player] = "";
            CMBT_SlotNamed[lv_slot][lv_player] = false;
            CMBT_Present[lv_slot][lv_player] = 0;
            lv_field = 0;
            while ((lv_field < CMBT_FIXED_FIELDS)) {
                CMBT_Acc[lv_slot][lv_field][lv_player] = 0.0;
                lv_field += 1;
            }
            lv_field = 0;
            while ((lv_field < CMBT_INT_FIELDS)) {
                CMBT_AccInt[lv_slot][lv_field][lv_player] = 0;
                lv_field += 1;
            }
            lv_slot += 1;
        }
        lv_player += 1;
    }

    CMBT_EnemyCount = 0;
    lv_slot = 1;
    while ((lv_slot <= CMBT_MAX_ENEMY_SLOTS)) {
        CMBT_EnemyType[lv_slot] = "";
        CMBT_EnemyNamed[lv_slot] = false;
        CMBT_EnemyAcc[lv_slot] = 0.0;
        lv_slot += 1;
    }

    CMBT_VictimCount = 0;
    CMBT_VictimOverflow = 0;
    lv_slot = 1;
    while ((lv_slot <= CMBT_MAX_VICTIM_SLOTS)) {
        CMBT_VictimType[lv_slot] = "";
        CMBT_VictimNamed[lv_slot] = false;
        lv_player = 1;
        while ((lv_player <= 2)) {
            lv_field = 0;
            while ((lv_field < 2)) {
                CMBT_VictimAcc[lv_slot][lv_field][lv_player] = 0.0;
                CMBT_VictimAccInt[lv_slot][lv_field][lv_player] = 0;
                lv_field += 1;
            }
            lv_player += 1;
        }
        lv_slot += 1;
    }

    lv_i = 1;
    while ((lv_i <= CMBT_GROWTH_FIELDS)) {
        CMBT_Growth[lv_i] = 0;
        CMBT_GrowthKnown[lv_i] = false;
        CMBT_CastCount[lv_i] = 0;
        lv_i += 1;
    }
    CMBT_GrowthActive = false;
    CMBT_ObedienceSum = 0;
    CMBT_ObedienceMax = 0;
    CMBT_ObedienceCount = 0;

    lv_player = 1;
    while ((lv_player <= 2)) {
        lv_slot = 1;
        while ((lv_slot <= CMBT_MAX_SLOTS)) {
            CMBT_AtkCount[lv_slot][lv_player] = 0;
            CMBT_AtkLastTag[lv_slot][lv_player] = 0;
            CMBT_AtkLastEffect[lv_slot][lv_player] = "";
            CMBT_AtkLastTime[lv_slot][lv_player] = 0.0;
            lv_slot += 1;
        }
        lv_player += 1;
    }
    CMBT_FieldHpUnits = 0.0;
    CMBT_FieldHpStructures = 0.0;
    CMBT_FieldNUnits = 0;
    CMBT_FieldNStructures = 0;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        CMBT_ChunkText[lv_i] = "";
        CMBT_ChunkFrames[lv_i] = 0;
        CMBT_ChunkIndex[lv_i] = 0;
        lv_i += 1;
    }

    CMBT_SampleCount = 0;
    CMBT_SlotOverflow = 0;
    CMBT_EnemyOverflow = 0;
    CMBT_OrderProbeCount = 0;
    CMBT_AllianceProbeCount = 0;
    lv_i = 0;
    while ((lv_i < CMBT_ALLIANCE_PROBE_MAX)) {
        CMBT_AllianceProbeKey[lv_i] = "";
        lv_i += 1;
    }
    CMBT_NeutralHits = 0;
    CMBT_FriendlyHits = 0;
    CMBT_UnclassifiedHits = 0;
    CMBT_FilteredNullVictim = 0;
    CMBT_NeutralDamage = 0.0;
    CMBT_FriendlyDamage = 0.0;
    CMBT_UnclassifiedDamage = 0.0;
    CMBT_FilteredNullVictimDamage = 0.0;
    CMBT_Truncated = false;
    CMBT_EventChunkText = "";
    CMBT_EventChunkEntries = 0;
    CMBT_EventChunkIndex = 0;
    CMBT_EventCount = 0;
    CMBT_EventOverflow = 0;
    CMBT_DirectMutatorCount = 0;
    CMBT_MutatorOverflow = 0;
    lv_i = 1;
    while ((lv_i <= CMBT_OBJECTIVE_MAX)) {
        CMBT_ObjectiveLast[lv_i] = "";
        lv_i += 1;
    }
    if ((CMBT_EventChunkEntries > 0)) {
        BankValueSetFromString(CMBT_Bank2, CMBT_EVENTS_SECTION, "C" + IntToString(CMBT_EventChunkIndex), CMBT_EventChunkText);
    }
}

void CMBT_SetCapture (bool lp_on) {
    TriggerEnable(CMBT_DamageTrigger, lp_on);
    TriggerEnable(CMBT_DiedTrigger, lp_on);
    TriggerEnable(CMBT_HealLifeTrigger, lp_on);
    TriggerEnable(CMBT_HealShieldTrigger, lp_on);
    TriggerEnable(CMBT_AbilPurgeTrigger, lp_on);
    TriggerEnable(CMBT_AbilSacrificeTrigger, lp_on);
    TriggerEnable(CMBT_AbilShacklesTrigger, lp_on);
    TriggerEnable(CMBT_AbilBreakTrigger, lp_on);
    TriggerEnable(CMBT_AbilOrderTrigger, lp_on);
    TriggerEnable(CMBT_ResearchTrigger, lp_on);
    TriggerEnable(CMBT_UpgradeTrigger, lp_on);
    TriggerEnable(CMBT_PlayerLeftTrigger, lp_on);
    TriggerEnable(CMBT_HeroReviveTrigger, lp_on);
    TriggerEnable(CMBT_UnitCreatedTrigger, lp_on);
}

// -----------------------------------------------------------------------------
// Chunk plumbing
// -----------------------------------------------------------------------------
// True while every section can still open another key without crossing CMBT_MAX_CHUNKS.
// 720 samples at 6 frames per key is 120 keys, so this only fires if the caps are retuned.
bool CMBT_CapacityOK () {
    int lv_i;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if (((CMBT_ChunkFrames[lv_i] == 0) && (CMBT_ChunkIndex[lv_i] >= CMBT_MAX_CHUNKS))) {
            return false;
        }
        lv_i += 1;
    }
    return true;
}

void CMBT_StreamAppend (int lp_stream, string lp_frame) {
    if ((CMBT_ChunkFrames[lp_stream] == 0)) {
        CMBT_ChunkIndex[lp_stream] += 1;
        CMBT_ChunkText[lp_stream] = "";
    }
    else {
        CMBT_ChunkText[lp_stream] += ";";
    }
    CMBT_ChunkText[lp_stream] += lp_frame;
    CMBT_ChunkFrames[lp_stream] += 1;
}

void CMBT_RollChunks () {
    int lv_i;

    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if ((CMBT_ChunkFrames[lv_i] >= CMBT_FRAMES_PER_CHUNK)) {
            CMBT_ChunkText[lv_i] = "";
            CMBT_ChunkFrames[lv_i] = 0;
        }
        lv_i += 1;
    }
}

// Global P1+P2 source-side counters, mirrored to both banks (not per-player totals).
// All keys are written even before the first sample; absence never means measured zero.
// Neutral stays zero in 3.1a. Unknown alliances remain separate until engine observation.
void CMBT_WriteVictimMeta (bank lp_bank) {
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "NeutralHits", CMBT_NeutralHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "NeutralDamage", FixedToInt(CMBT_NeutralDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyHits", CMBT_FriendlyHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FriendlyDamage", FixedToInt(CMBT_FriendlyDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "UnclassifiedVictimHits", CMBT_UnclassifiedHits);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "UnclassifiedVictimDamage", FixedToInt(CMBT_UnclassifiedDamage));
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FilteredNullVictimHits", CMBT_FilteredNullVictim);
    BankValueSetFromInt(lp_bank, CMBT_META_SECTION, "FilteredNullVictimDamage", FixedToInt(CMBT_FilteredNullVictimDamage));
}

void CMBT_Save () {
    int lv_i;

    if (((CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return;
    }

    // Write each section's current (possibly partial) chunk in place, so an in-progress
    // chunk is never lost on crash yet we do not create a new key every sample.
    lv_i = 0;
    while ((lv_i < CMBT_STREAM_COUNT)) {
        if ((CMBT_ChunkFrames[lv_i] > 0)) {
            if ((lv_i == CMBT_STREAM_SAMPLES)) {
                BankValueSetFromString(CMBT_Bank, CMBT_SAMPLES_SECTION, "C" + IntToString(CMBT_ChunkIndex[lv_i]), CMBT_ChunkText[lv_i]);
            }
            else {
                BankValueSetFromString(CMBT_Bank2, CMBT_StreamSection(lv_i), "C" + IntToString(CMBT_ChunkIndex[lv_i]), CMBT_ChunkText[lv_i]);
            }
        }
        lv_i += 1;
    }

    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SampleCount", CMBT_SampleCount);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "ChunkCount", CMBT_ChunkIndex[CMBT_STREAM_SAMPLES]);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "LastMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "SlotOverflow", CMBT_SlotOverflow);
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));

    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SampleCount", CMBT_SampleCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "ChunkCount", CMBT_ChunkIndex[CMBT_STREAM_TAKEN]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "TakenChunkCount", CMBT_ChunkIndex[CMBT_STREAM_TAKEN]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemyChunkCount", CMBT_ChunkIndex[CMBT_STREAM_ENEMY]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "GrowthChunkCount", CMBT_ChunkIndex[CMBT_STREAM_GROWTH]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "FieldChunkCount", CMBT_ChunkIndex[CMBT_STREAM_FIELD]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimChunkCount", CMBT_ChunkIndex[CMBT_STREAM_VICTIM]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EconChunkCount", CMBT_ChunkIndex[CMBT_STREAM_ECON]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "HeroChunkCount", CMBT_ChunkIndex[CMBT_STREAM_HERO]);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventCount", CMBT_EventCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventChunkCount", CMBT_EventChunkIndex);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EventOverflow", CMBT_EventOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "LastMissionTime", FixedToInt(GameGetMissionTime()));
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "SlotOverflow", CMBT_SlotOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemyOverflow", CMBT_EnemyOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "EnemySlotCount", CMBT_EnemyCount);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimOverflow", CMBT_VictimOverflow);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "VictimSlotCount", CMBT_VictimCount);
    // B-20: bank 2 identity keys were written once in CMBT_Start and never refreshed, so a
    // stale commander lookup at trace-start froze into the file. Refresh in step with bank 1.
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    CMBT_WriteVictimMeta(CMBT_Bank);
    CMBT_WriteVictimMeta(CMBT_Bank2);

    BankSave(CMBT_Bank);
    BankSave(CMBT_Bank2);
}

void CMBT_MarkStopped (int lp_complete, int lp_truncated) {
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Enabled", 0);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Complete", lp_complete);
    BankValueSetFromInt(CMBT_Bank, CMBT_META_SECTION, "Truncated", lp_truncated);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Enabled", 0);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Complete", lp_complete);
    BankValueSetFromInt(CMBT_Bank2, CMBT_META_SECTION, "Truncated", lp_truncated);
    // B-20 belt-and-braces: a run stopping before the first periodic save would otherwise keep
    // the trace-start commander snapshot in both banks.
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP1", libCOOC_gf_ActiveCommanderForPlayer(1));
    BankValueSetFromString(CMBT_Bank2, CMBT_META_SECTION, "CommanderP2", libCOOC_gf_ActiveCommanderForPlayer(2));
}

bool CMBT_WriteSample () {
    string lv_time;

    if (((CMBT_Enabled == false) || (CMBT_Bank == null) || (CMBT_Bank2 == null))) {
        return false;
    }
    if ((GameGetMissionTime() <= 0.0)) {
        return false;
    }

    if (((CMBT_SampleCount >= CMBT_MAX_SAMPLES) || (CMBT_CapacityOK() == false))) {
        CMBT_Enabled = false;
        CMBT_Truncated = true;
        CMBT_SetCapture(false);
        TimerPause(CMBT_Timer, true);
        CMBT_MarkStopped(0, 1);
        CMBT_Save();
        CMBT_UpdateIndex(0, 1, -1);
        CMBT_Message(CMBT_Operator, "stopped: sample or chunk limit reached");
        return false;
    }

    CMBT_UpdatePresent();
    CMBT_UpdateGrowth();
    CMBT_UpdateEnemyField();
    CMBT_UpdateObjectives();
    CMBT_RegisterUnitKeys();

    CMBT_SampleCount += 1;
    lv_time = IntToString(FixedToInt(GameGetMissionTime()));
    CMBT_StreamAppend(CMBT_STREAM_SAMPLES, lv_time + "|" + CMBT_BuildSampleSegment(1) + "|" + CMBT_BuildSampleSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_TAKEN, lv_time + "|" + CMBT_BuildTakenSegment(1) + "|" + CMBT_BuildTakenSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_ENEMY, lv_time + "|" + CMBT_BuildEnemySegment());
    CMBT_StreamAppend(CMBT_STREAM_GROWTH, lv_time + "|" + CMBT_BuildGrowthSegment());
    CMBT_StreamAppend(CMBT_STREAM_FIELD, lv_time + "|" + CMBT_BuildFieldSegment());
    CMBT_StreamAppend(CMBT_STREAM_VICTIM, lv_time + "|" + CMBT_BuildVictimSegment(1) + "|" + CMBT_BuildVictimSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_ECON, lv_time + "|" + CMBT_BuildEconSegment(1) + "|" + CMBT_BuildEconSegment(2));
    CMBT_StreamAppend(CMBT_STREAM_HERO, lv_time + "|" + CMBT_BuildHeroSegment(1) + "|" + CMBT_BuildHeroSegment(2));

    // Persist every sample (a crash loses <= 5s); roll to fresh chunk keys once they are full,
    // which keeps every section's key count bounded (~120 keys for a full 720-sample game).
    CMBT_Save();
    CMBT_RollChunks();
    return true;
}

// -----------------------------------------------------------------------------
// Capture handlers
// -----------------------------------------------------------------------------
// One damage event feeds four measurements: dealt damage (T0), hit count (T7) and overkill
// (T8) on the source side; damage taken split into life and shields (T1) plus the enemy
// unit-type table (T4) on the victim side.
bool CMBT_DamageHandler (bool testConds, bool runActions) {
    unit lv_victim;
    unit lv_sourceUnit;
    int lv_sourcePlayer;
    int lv_victimPlayer;
    int lv_slot;
    int lv_atkSlot;
    int lv_victimSlot;
    int lv_atkTag;
    fixed lv_amount;
    fixed lv_life;
    fixed lv_shields;
    fixed lv_split;
    fixed lv_atkTime;
    string lv_type;
    string lv_atkEffect;
    int lv_victimClass;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }

    lv_atkSlot = 0;
    lv_victimSlot = 0;

    // 3.2 attack instances: counted BEFORE the amount gate so fully-absorbed hits count.
    // Aligned with the d column: only a positively hostile victim counts (hub rescope
    // 2026-09-10: blood drinking hits the caster's own fanatics and would inflate Malash's
    // atk otherwise; d/a must share numerator scope). Same source-validity and slot rules as
    // d/n/h below. One attack splashing onto several targets fires several events with the
    // same (source tag, effect, mission time) key; only the first increments the slot. Two
    // genuine attacks by the same unit with the same effect inside one mission-time read also
    // merge (known limitation, changelog). Nova's source-less strike keys on tag 0 + the
    // effect name; its victim must still be hostile, same as here.
    lv_victim = EventUnit();
    lv_sourceUnit = EventUnitDamageSourceUnit();
    if (((lv_sourceUnit != lv_victim) && (lv_victim != null))) {
        lv_sourcePlayer = EventUnitDamageSourcePlayer();
        if (((lv_sourcePlayer == 1) || (lv_sourcePlayer == 2))) {
            if ((libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, UnitGetOwner(lv_victim), libNtve_ge_PlayerRelation_Enemy) == true)) {
                if ((CMBT_UT_DL_IsValidDamageSource() == true)) {
                    lv_atkSlot = CMBT_FindSlot(lv_sourcePlayer, CMBT_UT_DL_GetDamageSourceUnitType(), true);
                    if ((lv_atkSlot > 0)) {
                        lv_atkTag = 0;
                        if ((lv_sourceUnit != null)) {
                            lv_atkTag = UnitGetTag(lv_sourceUnit);
                        }
                        lv_atkEffect = EventUnitDamageEffect();
                        lv_atkTime = GameGetMissionTime();
                        if (((CMBT_AtkLastTag[lv_atkSlot][lv_sourcePlayer] != lv_atkTag) || (CMBT_AtkLastEffect[lv_atkSlot][lv_sourcePlayer] != lv_atkEffect) || (CMBT_AtkLastTime[lv_atkSlot][lv_sourcePlayer] != lv_atkTime))) {
                            CMBT_AtkLastTag[lv_atkSlot][lv_sourcePlayer] = lv_atkTag;
                            CMBT_AtkLastEffect[lv_atkSlot][lv_sourcePlayer] = lv_atkEffect;
                            CMBT_AtkLastTime[lv_atkSlot][lv_sourcePlayer] = lv_atkTime;
                            CMBT_AtkCount[lv_atkSlot][lv_sourcePlayer] += 1;
                        }
                    }
                }
            }
        }
    }

    lv_amount = EventUnitDamageAmount();
    if ((lv_amount < 0.1)) {
        return true;
    }

    lv_victim = EventUnit();
    if ((EventUnitDamageSourceUnit() == lv_victim)) {
        return true;
    }

    lv_sourcePlayer = EventUnitDamageSourcePlayer();
    lv_victimPlayer = 0;
    // 0=unclassified, 1=enemy, 2=friendly; 3=neutral is reserved, never assigned in 3.1a.
    lv_victimClass = 0;
    if ((lv_victim != null)) {
        lv_victimPlayer = UnitGetOwner(lv_victim);
        if ((libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, lv_victimPlayer, libNtve_ge_PlayerRelation_Enemy) == true)) {
            lv_victimClass = 1;
        }
        if ((lv_victimClass == 0)) {
            if (((lv_victimPlayer == lv_sourcePlayer) || (libNtve_gf_PlayerIsEnemy(lv_sourcePlayer, lv_victimPlayer, libNtve_ge_PlayerRelation_Ally) == true))) {
                lv_victimClass = 2;
            }
        }
        if ((lv_victimClass == 0)) {
            CMBT_RecordAllianceProbe(lv_sourcePlayer, lv_victimPlayer);
        }
    }

    // Source side: our own unit types only (Nova's source-less air strike included).
    // B-23 / MeasureVersion 3.1: only a positively hostile victim counts toward T0/T7/T8.
    // 3.1a separates friendly from unknown victims without guessing neutral/objective owners.
    if (((lv_sourcePlayer == 1) || (lv_sourcePlayer == 2))) {
        if ((CMBT_UT_DL_IsValidDamageSource() == true)) {
            if ((lv_victim == null)) {
                CMBT_FilteredNullVictim += 1;
                CMBT_FilteredNullVictimDamage += lv_amount;
            }
            if ((lv_victimClass == 2)) {
                CMBT_FriendlyHits += 1;
                CMBT_FriendlyDamage += lv_amount;
            }
            if (((lv_victim != null) && (lv_victimClass == 0))) {
                CMBT_UnclassifiedHits += 1;
                CMBT_UnclassifiedDamage += lv_amount;
            }
            lv_slot = 0;
            if ((lv_victimClass == 1)) {
                lv_slot = lv_atkSlot;
                lv_life = UnitGetPropertyFixed(lv_victim, c_unitPropLife, c_unitPropCurrent);
                lv_shields = UnitGetPropertyFixed(lv_victim, c_unitPropShields, c_unitPropCurrent);
                lv_split = lv_amount - (lv_life + lv_shields);
                if ((lv_slot > 0)) {
                    CMBT_Acc[lv_slot][CMBT_F_DEALT][lv_sourcePlayer] += lv_amount;
                    CMBT_AccInt[lv_slot][CMBT_I_HITS][lv_sourcePlayer] += 1;
                    if ((lv_split > 0.0)) {
                        CMBT_Acc[lv_slot][CMBT_F_OVERKILL][lv_sourcePlayer] += lv_split;
                    }
                }
                lv_victimSlot = CMBT_FindVictimSlot(UnitGetType(lv_victim));
                if ((lv_victimSlot > 0)) {
                    CMBT_VictimAcc[lv_victimSlot][CMBT_VF_DAMAGE][lv_sourcePlayer] += lv_amount;
                    CMBT_VictimAccInt[lv_victimSlot][CMBT_VI_HITS][lv_sourcePlayer] += 1;
                    if ((lv_split > 0.0)) {
                        CMBT_VictimAcc[lv_victimSlot][CMBT_VF_OVERKILL][lv_sourcePlayer] += lv_split;
                    }
                }
            }
        }
    }

    // Victim side: our own units only.
    if ((((lv_victimPlayer == 1) || (lv_victimPlayer == 2)) && (lv_victim != null))) {
        lv_slot = CMBT_FindSlot(lv_victimPlayer, UnitGetType(lv_victim), true);
        if ((lv_slot > 0)) {
            lv_shields = UnitGetPropertyFixed(lv_victim, c_unitPropShields, c_unitPropCurrent);
            lv_split = lv_shields;
            if ((lv_split > lv_amount)) {
                lv_split = lv_amount;
            }
            if ((lv_split < 0.0)) {
                lv_split = 0.0;
            }
            CMBT_Acc[lv_slot][CMBT_F_TAKENSHIELD][lv_victimPlayer] += lv_split;
            CMBT_Acc[lv_slot][CMBT_F_TAKENLIFE][lv_victimPlayer] += (lv_amount - lv_split);
            CMBT_RecordOrderProbe(lv_victim, lv_amount);
        }

        if ((lv_victimClass == 1)) {
            lv_type = "_Sourceless";
            if ((EventUnitDamageSourceUnit() != null)) {
                lv_type = UnitGetType(EventUnitDamageSourceUnit());
            }
            lv_slot = CMBT_FindEnemySlot(lv_type);
            if ((lv_slot > 0)) {
                CMBT_EnemyAcc[lv_slot] += lv_amount;
            }
        }
    }

    return true;
}

// T2: our losses, split by whether an enemy player got the kill. Anything else (our own
// sacrifice abilities, allies, neutral, expiring summons, no killer at all) counts as a
// self-side loss, so de + ds is always the total number of units lost.
bool CMBT_DiedHandler (bool testConds, bool runActions) {
    unit lv_victim;
    int lv_owner;
    int lv_killer;
    int lv_slot;
    int lv_victimSlot;
    string lv_type;

    if ((!runActions)) {
        return true;
    }
    if ((CMBT_Enabled == false)) {
        return true;
    }

    lv_victim = EventUnit();
    if ((lv_victim == null)) {
        return true;
    }

    lv_owner = UnitGetOwner(lv_victim);
    lv_killer = libNtve_gf_KillingPlayer();
    lv_type = UnitGetType(lv_victim);
    if (((lv_owner >= 1) && (lv_owner <= 2) && (lv_victim == libCOMI_gv_cM_HeroUnit[lv_owner]))) {
        CMBT_AppendEvent("HeroDied", lv_owner, lv_type, "", "UnitDied", "exact");
    }
    if ((CMBT_IsTrackedMutatorUnitType(lv_type) == true)) {
        CMBT_AppendEvent("MutatorUnitDied", lv_owner, lv_type, "", "UnitDied", "exact");
    }
    if (((lv_killer == 1) || (lv_killer == 2))) {
        if ((libNtve_gf_PlayerIsEnemy(lv_killer, lv_owner, libNtve_ge_PlayerRelation_Enemy) == true)) {
            lv_victimSlot = CMBT_FindVictimSlot(lv_type);
            if ((lv_victimSlot > 0)) {
                CMBT_VictimAccInt[lv_victimSlot][CMBT_VI_KILLS][lv_killer] += 1;
            }
        }
    }
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return true;
    }

    lv_slot = CMBT_FindSlot(lv_owner, lv_type, true);
    if ((lv_slot == 0)) {
        return true;
    }

    if (((lv_killer != c_playerAny) && (lv_killer != lv_owner) && (libNtve_gf_PlayerIsEnemy(lv_killer, lv_owner, libNtve_ge_PlayerRelation_Enemy) == true))) {
        CMBT_AccInt[lv_slot][CMBT_I_DIEDENEMY][lv_owner] += 1;
    }
    else {
        CMBT_AccInt[lv_slot][CMBT_I_DIEDSELF][lv_owner] += 1;
    }
    return true;
}

// T3: healing and shield restoration are booked against the BENEFICIARY, not the healer, so
// that they line up with the damage-taken columns of the same slot. Shield regeneration has
// no launch unit at all, which is exactly the case UT_DL's heal log drops.
void CMBT_RecordHeal (int lp_field) {
    unit lv_target;
    int lv_owner;
    int lv_slot;
    fixed lv_amount;

    if ((CMBT_Enabled == false)) {
        return;
    }

    lv_amount = EventUnitHealAmount();
    if ((lv_amount < 0.1)) {
        return;
    }

    lv_target = EventUnit();
    if ((lv_target == null)) {
        return;
    }

    lv_owner = UnitGetOwner(lv_target);
    if (((lv_owner < 1) || (lv_owner > 2))) {
        return;
    }

    lv_slot = CMBT_FindSlot(lv_owner, UnitGetType(lv_target), true);
    if ((lv_slot == 0)) {
        return;
    }

    CMBT_Acc[lv_slot][lp_field][lv_owner] += lv_amount;
}

bool CMBT_HealLifeHandler (bool testConds, bool runActions) {
