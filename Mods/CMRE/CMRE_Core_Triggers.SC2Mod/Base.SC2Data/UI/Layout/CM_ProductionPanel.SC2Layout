        <Frame type="ProductionCountFrame" name="ProductionCountFrame12" template="CM_ProductionPanel/Template_ProductionCountFrame">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/ProductionCountFrame11" pos="Min" offset="-4"/>
        </Frame>
    </Frame>

