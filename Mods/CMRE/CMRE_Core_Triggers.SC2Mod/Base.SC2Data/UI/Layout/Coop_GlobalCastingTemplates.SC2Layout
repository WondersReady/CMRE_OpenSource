        </Frame>        
        
        <Frame type="Frame" name="ProtossEnergyBarFill">
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Min" offset="92"/>
            <AlphaMaskTexture val="@UI/HotS_Shared_Frame_PortraitMask_Circle01"/>
            <Height val="#ProtossEnergyHeight"/>
            <Width val="#ProtossEnergyWidth"/>            

            <Frame type="CutsceneFrame" name="ProtossFillScene">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="#ProtossEnergyHeight"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Width val="#ProtossEnergyWidth"/>
                <Height val="#ProtossEnergyHeightDouble"/>
                <File val="Cutscenes/UI_SoAMissionEnergy.SC2Cutscene"/>
                <RenderType val="HDR"/>
                <AutoPlay val="true"/>                
                <ToneMapping val="False"/>
                
                <Animation name="EnergyLevel">
                    <Event event="SetEnergyPlay" action="Reset"/>
                    <Event event="SetEnergyPlay" action="Play"/>
                    <Event event="SetEnergyPause" action="Pause"/>
                    <Controller type="Anchor" end="Pause" side="Bottom" relative="true">
                        <Key type="Curve" time="0" value="0" out="Linear"/>
                        <Key type="Curve" time="100" value="#ProtossEnergyGrowth" in="Linear"/>
                    </Controller>
                </Animation>
            </Frame>            
            <RenderPriority val="514"/>
        </Frame>                           

        <Frame type="Frame" name="ProtossEnergyTooltipHitFrame">
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Min" offset="92"/>
            <Height val="#ProtossEnergyHeight"/>
            <Width val="#ProtossEnergyWidth"/>   
            <AcceptsMouse val="true"/>
            <TooltipFrame val="ProtossEnergyTooltip"/>
            <Tooltip val="@UI/SoAMissionEnergyTooltip"/>                     
