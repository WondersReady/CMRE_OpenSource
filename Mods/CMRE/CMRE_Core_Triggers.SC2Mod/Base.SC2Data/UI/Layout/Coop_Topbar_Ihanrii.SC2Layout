<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>  
    <Constant name="IhanriiEnergyHeight" val="128"/>
    <Constant name="IhanriiEnergyHeightDouble" val="256"/>
    <Constant name="IhanriiEnergyWidth" val="128"/>
    <Constant name="IhanriiEnergyGrowth" val="-128"/>    

    <!--
    ==========================
    Ihanrii Command Button Template
    ==========================
    -->

    <Frame type="CommandButton" name="IhanriiCommandButtonTemplate" template="CommandButton/CommandButtonTemplate">
        <TooltipFrame val="ProtossCommandTooltip"/>
        <ClickSound val="*@UI_SoA_SpellClick"/>
        <ShowCooldownText val="True"/>
        <Width val="68"/>
        <Height val="68"/>
        
        <Frame type="Label" name="CooldownLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-5"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-5"/>
            <Style val="GameButtonCooldownLight"/>
            <RenderPriority val="516"/>
        </Frame>

        <Frame type="CommandHotkeyFrame" name="HotkeyFrame">
            <Anchor side="Top" relative="$parent" pos="Min" offset="3"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="2"/>
            
            <Frame type="Label" name="HotkeyLabel">
                <Style val="GameButtonChargeSmall"/>
            </Frame>
        </Frame>
    </Frame>       

    <!--
    ==========================
    Ihanrii Global Command Panel Template
    ==========================
    -->
    
    <Frame type="CommandPanel" name="IhanriiGlobalCommandPanelTemplate" template="CommandPanel/CommandPanelTemplate">
        <Anchor relative="$parent"/>
        <HideUnusedButtons val="true"/>
        <DisplayCancelCommandCard val="false"/>
        <UseGridHotkeys val="false"/>

        <Frame type="CommandTooltip" name="ProtossCommandTooltip" template="CommandButton/CommandTooltipTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="120"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-225"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton00" template="Coop_TopBar_Ihanrii/IhanriiCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/$parent/Background" pos="Min" offset="7"/>
            <Anchor side="Left" relative="$parent/$parent/Background" pos="Min" offset="113"/>
            <HotkeyUse val="CommanderAbility0"/>
        </Frame>        

        <Frame type="CommandButton" name="CommandButton01" template="Coop_TopBar_Ihanrii/IhanriiCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/$parent/Background" pos="Min" offset="7"/>
            <Anchor side="Left" relative="$parent/CommandButton00" pos="Max" offset="221"/>
            <HotkeyUse val="CommanderAbility1"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton02" template="Coop_TopBar_Ihanrii/IhanriiCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/$parent/Background" pos="Min" offset="7"/>
            <Anchor side="Left" relative="$parent/CommandButton01" pos="Max" offset="12"/>
            <HotkeyUse val="CommanderAbility2"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton03" template="Coop_TopBar_Ihanrii/IhanriiCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/$parent/Background" pos="Min" offset="7"/>
            <Anchor side="Left" relative="$parent/CommandButton02" pos="Max" offset="12"/>
            <HotkeyUse val="CommanderAbility3"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton04" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent/$parent/Background" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/$parent/Background" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/$parent/Background" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/$parent/Background" pos="Mid" offset="0"/>
            <Width val="38"/>
            <Height val="38"/>
        </Frame>
        
        <Frame type="CommandButton" name="CommandButton05" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>
        
        <Frame type="CommandButton" name="CommandButton06" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton07" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton08" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton09" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton10" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton11" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton12" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton13" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton14" template="CommandButton/CommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="-1000"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="Label" name="RowText0">
            <Anchor side="Top" relative="$parent/CommandButton00" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/CommandButton00" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="@@CommandRow"/>
        </Frame>

        <Frame type="Label" name="RowText1">
            <Visible val="false"/>
        </Frame>

        <Frame type="Label" name="RowText2">
            <Visible val="false"/>
        </Frame>

        <Frame type="Image" name="CommandTargetImage">
            <Anchor side="Left" relative="$parent" pos="Max" offset="200"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="200"/>
            <Anchor side="Top" relative="$parent" pos="Max" offset="200"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="200"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="Label" name="CommandTargetName">
            <Visible val="false"/>
        </Frame>

        <Frame type="Label" name="CommandTargetPrompt">
            <Visible val="false"/>
        </Frame>

        <Frame type="Frame" name="UncontrollableUnitFrame">
            <Visible val="false"/>
            
            <Frame type="Label" name="UncontrollableUnitTitleLabel">
                <Visible val="false"/>
            </Frame>
            
            <Frame type="Label" name="UncontrollableUnitPromptLabel">
                <Visible val="false"/>
            </Frame>
        </Frame>
    </Frame>
    
    <!--
    ==========================
    Ihanrii Top Bar Template
    ==========================
    -->
    
    <Frame type="Frame" name="IhanriiTopBar">
        <Anchor relative="$parent"/>
        <RenderPriority val="500"/>
        
        <Frame type="Image" name="ProphecyBackground">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="-49"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-80"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-80"/>
            <Width val="180"/>
            <Height val="180"/>
            <Texture val="Assets/Textures/SC2_UI_Global_GenericMask_Circle_76x76_Buffer12pt.dds"/>
            <Color val="3,42,29"/>
            <RenderPriority val="511"/>
            <Visible val="False"/>
        </Frame>
        
        <Frame type="Frame" name="Prophecy">
            <Anchor side="Top" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Width val="128"/>
            <Height val="128"/>
            <Visible val="False"/>
        </Frame>
        
        <Frame type="Image" name="Background">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Width val="744"/>
            <Height val="176"/>
            <Texture val="Assets/Textures/ui_ingame_coop_topbar_zeratul_mainbar.dds"/>
        </Frame>

        <Frame type="Frame" name="ProphecyAboveBar">
            <Anchor side="Top" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/ProphecyBackground" pos="Mid" offset="0"/>
            <Width val="200"/>
            <Height val="200"/>
    
            <Frame type="Image" name="ProphecyGlow">
                <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Width val="200"/>
                <Height val="200"/>
                <Color val="0,255,150"/>
                <Alpha val="0"/>
                
                <Texture val="Assets/Textures/ui_ingame_coop_topbar_zeratul_prophecymask_gradient_radial_outerglow.dds"/>
                
                <Animation name="ProphecyUrgent">
                    <Event event="Ready" frame="$parent/$parent" action="DirectionForward,Play"/>
                    <Event event="NotReady" frame="$parent/$parent" action="DirectionReverse,Play"/>
                    
                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" inout="Linear"/>
                        <Key type="Curve" time="4" value="90" inout="Linear"/>
                    </Controller>
                </Animation>
            </Frame>
    
            <Frame type="Image" name="UrgencyGlow">
                <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Width val="200"/>
                <Height val="200"/>
                <Color val="0,255,150"/>
                <Alpha val="0"/>
                
                <Texture val="Assets/Textures/ui_ingame_coop_topbar_zeratul_prophecymask_gradient_radial_outerglow.dds"/>
                
                <Animation name="ProphecyUrgent">
                    <Event event="Urgency2" frame="$parent/$parent" action="Reset,Play"/>
                    <Event event="NoUrgency" frame="$parent/$parent" action="Reset,Stop"/>
                    
                    <Controller type="Fade" end="PingPong">
                        <Key type="Curve" time="0" value="0" inout="Linear"/>
                        <Key type="Curve" time="1" value="255" inout="Linear"/>
                    </Controller>
                </Animation>
            </Frame>
        </Frame>
        
        <Frame type="CommandPanel" name="IhanriiGlobalCommandPanel" template="Coop_TopBar_Ihanrii/IhanriiGlobalCommandPanelTemplate"/>

        <Frame type="CutsceneFrame" name="IhanriiOverlayCutscene">
            <Width val="1524"/>
            <Height val="1524"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-37"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-843"/>
            <File val="Cutscenes/UI_IhanriiMission_Glass.SC2Cutscene"/>
            <RenderType val="HDR"/>
            <ToneMapping val="False"/>
            <RenderPriority val="515"/>
            <AutoPlay val="true"/>
        </Frame>            

        <Frame type="Frame" name="IhanriiEnergyBarFill">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="-24"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-80"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-80"/>
            <AlphaMaskTexture val="@UI/HotS_Shared_Frame_PortraitMask_Circle01"/>
            <Height val="#IhanriiEnergyHeight"/>
            <Width val="#IhanriiEnergyWidth"/>            

            <Frame type="CutsceneFrame" name="IhanriiFillScene">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="#IhanriiEnergyHeight"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Width val="#IhanriiEnergyWidth"/>
                <Height val="#IhanriiEnergyHeightDouble"/>
                <File val="Cutscenes/UI_IhanriiMissionEnergy.SC2Cutscene"/>
                <RenderType val="HDR"/>
                <AutoPlay val="true"/>                
                <ToneMapping val="False"/>
                
                <Animation name="EnergyLevel">
                    <Event event="SetEnergyPlay" action="Reset"/>
                    <Event event="SetEnergyPlay" action="Play"/>
                    <Event event="SetEnergyPause" action="Pause"/>
                    <Controller type="Anchor" end="Pause" side="Bottom" relative="true">
                        <Key type="Curve" time="0" value="0" out="Linear"/>
                        <Key type="Curve" time="100" value="#IhanriiEnergyGrowth" in="Linear"/>
                    </Controller>
                </Animation>
            </Frame>            
            <RenderPriority val="514"/>
        </Frame>                           

        <Frame type="Frame" name="IhanriiEnergyTooltipHitFrame">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="-24"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-80"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-80"/>
            <Height val="#IhanriiEnergyHeight"/>
            <Width val="#IhanriiEnergyWidth"/>   
            <AcceptsMouse val="true"/>
            <TooltipFrame val="IhanriiEnergyTooltip"/>
            <Tooltip val="@UI/IhanriiMissionEnergyTooltip"/>                     
        </Frame>
        
        <Frame type="StandardTooltip" name="IhanriiEnergyTooltip" template="StandardTooltip/StandardTooltip">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="-24"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-80"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-80"/>
            <MinWidth val="450"/>
            <MaxWidth val="450"/>
            <Width val="450"/>
            <Height val="300"/>

            <Frame type="Label" name="Label">
                <Width val="420"/>
            </Frame>
        </Frame>
        
        <Frame type="Label" name="IhanriiEnergyLabel">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="32"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-80"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-80"/>
            <Width val="80"/>
            <Style val="Ihanrii_SoAEnergyText"/>
            <RenderPriority val="517"/>
            
            <Animation name="FadeIn">
                <Event event="OnShown" action="Reset"/>
                <Event event="OnShown" action="Play"/>                
                <Controller type="Fade" end="Pause">
                    <Key type="Curve" time="0" value="0" out="Slow"/>
                    <Key type="Curve" time="0.25" value="255" in="Slow"/>
                </Controller>
            </Animation>
        </Frame>               
    </Frame>
</Desc>