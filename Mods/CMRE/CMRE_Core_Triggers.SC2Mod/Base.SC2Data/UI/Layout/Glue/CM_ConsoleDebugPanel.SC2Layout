    <Frame type="Button" name="CM_ConsoleToggleButtonTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <Toggleable val="True"/>
        <Toggled val="False"/>
        <Text val="@CMUI/Console/Toggle"/>
        <DisplayType val="ImageLayer"/>
        <ClickSound val="@UI_ActionButtonSelect"/>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>
            <Texture val="Assets/Textures/CM_ConsoleTopButton_Normal.tga"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>
            <Texture val="Assets/Textures/CM_ConsoleTopButton_Hover.tga"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="ToggledImage">
            <Anchor relative="$parent"/>
            <Texture val="Assets/Textures/CM_ConsoleTopButton_Toggled.tga"/>
            <TextureType val="NineSlice"/>
            <Alpha val="0"/>
            <AcceptsMouse val="False"/>

            <StateGroup name="ToggleState">
                <DefaultState val="Off"/>
                <State name="On">
                    <When type="Property" frame="$parent" Toggled="True"/>
                    <Action type="SetProperty" frame="$this" Alpha="255"/>
                </State>
                <State name="Off">
                    <Action type="SetProperty" frame="$this" Alpha="0"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Label" name="Label">
            <Anchor side="Top" relative="$parent" pos="Min" offset="4"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-2"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Style val="BattlenetStandardButton"/>
            <Text val="@CMUI/Console/Toggle"/>
        </Frame>
    </Frame>

