    <Frame type="Control" name="ChatDebugPanelTemplate">
            <Handle val="CM_ChatDebugPanel"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="36"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="24"/>
