                    </Frame>

                    <Frame type="Label" name="NameLabel">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="-11"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="11"/>
                        <Anchor side="Left" relative="$parent/MutatorIconBox" pos="Max" offset="10"/>
