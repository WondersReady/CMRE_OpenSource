                        <Action type="SetProperty" frame="FirstRandomLabelTitle" Visible="False"/>
                    </State>
                    <State name="BrutalPlus">
                        <When type="StateGroup" frame="$ancestor[@name=MutatorSelectionMainDialog]" PoolModeState="BrutalPlus"/>
                        <Action type="SetProperty" frame="FirstRandomLabelTitle" Visible="False"/>
                    </State>
                    <State name="Cycle">
                        <When type="StateGroup" frame="$ancestor[@name=MutatorSelectionMainDialog]" PoolModeState="Cycle"/>
                        <Action type="SetProperty" frame="FirstRandomLabelTitle" Visible="True"/>
                    </State>
                    <State name="Chaos">
                        <When type="StateGroup" frame="$ancestor[@name=MutatorSelectionMainDialog]" PoolModeState="Chaos"/>
                        <Action type="SetProperty" frame="FirstRandomLabelTitle" Visible="True"/>
                    </State>
                </StateGroup>
