<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Constant name="MutatorPoolRowHeight" val="45"/>

    <Frame type="Frame" name="MutatorSelectionPage">
        <Handle val="CM_CustomMutatorPoolPage"/>
        <Anchor relative="$parent"/>
        <Visible val="False"/>
        <Alpha val="0"/>
        <RenderPriority val="960"/>

        <Animation name="Show">
            <Event event="Show" action="Reset,Play"/>
            <Controller type="Visibility" end="Pause">
                <Key type="Bool" time="0" value="True"/>
            </Controller>
            <Controller type="Fade" end="Pause">
                <Key type="Curve" time="0" value="0" out="Fast"/>
                <Key type="Curve" time=".12" value="255" in="Slow"/>
            </Controller>
        </Animation>

        <Animation name="Hide">
            <Event event="Hide" action="Reset,Play"/>
            <Event event="OnClick" action="Reset,Play" frame="$this/MutatorSelectionMainDialog/AcceptButton"/>
            <Event event="OnClick" action="Reset,Play" frame="$this/MutatorSelectionMainDialog/CancelButton"/>
            <Controller type="Fade" end="Pause">
                <Key type="Curve" time="0" value="0"/>
            </Controller>
            <Controller type="Visibility" end="Pause">
                <Key type="Bool" time="0" value="False"/>
            </Controller>
        </Animation>

        <Frame type="Image" name="BackgroundTint">
            <Anchor relative="$parent"/>
            <Color val="0,0,0"/>
            <Alpha val="180"/>
            <AcceptsMouse val="true"/>
        </Frame>

        <Frame type="Frame" name="MutatorSelectionMainDialog">
            <Anchor relative="$parent"/>

            <Frame type="Image" name="BackgroundImage">
                <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
                <TextureType val="NineSlice"/>
                <Tiled val="false"/>
                <Width val="1280"/>
                <Height val="1012"/>
            </Frame>

            <Frame type="Image" name="TopHexPattern">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
            </Frame>

            <Frame type="Image" name="BottomHexPattern">
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                <TextureCoords top="1" left="1" bottom="0" right="0"/>
            </Frame>

            <Frame type="Label" name="Title">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="50"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Style val="@BattlenetDialogTitle"/>
                <Text val="@CMUI/Coop_CustopmMutatorSelection_Title"/>
            </Frame>

            <Frame type="Image" name="PoolInfoIcon">
                <Anchor side="Top" relative="$parent/Title" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent/Title" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent/Title" pos="Max" offset="30"/>
                <Width val="32"/>
                <Height val="32"/>
                <Texture val="Assets/Textures/ui_glues_icons_infogeneric.dds"/>
                <AcceptsMouse val="true"/>
                <Tooltip val="@CMUI/CustomMutatorPool/InfoTooltip"/>
                <TooltipFrame val="BattleNetTooltip"/>
                <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
            </Frame>

            <Frame type="Label" name="MessageLabel">
                <Anchor side="Top" relative="$parent/Title" pos="Max" offset="10"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
                <Style val="@StandardDialogMessage"/>
                <Text val="@CMUI/Coop_CustopmMutatorSelection_Message"/>
            </Frame>

            <Frame type="Frame" name="HeaderPanel">
                <Anchor side="Top" relative="$parent/MessageLabel" pos="Max" offset="18"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="-450"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="450"/>
                <Height val="54"/>

                <Frame type="EditBox" name="SearchEditBoxTemplate" template="StandardSmallButtonTemplates/StandardSmallSearchBoxTemplate">
                    <Tooltip val="@CMUI/MutatorSearch/SearchTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <MaxCharacters val="80"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                    <Frame type="Label" name="SearchTextLabel">
                        <Text val="@CMUI/MutatorSearch/SearchText"/>
                    </Frame>
                    <Frame type="Button" name="ClearTextButton"/>
                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent" pos="Min" offset="0"/>
                        <Width val="420"/>
                    </Frame>
                </Frame>

                <Frame type="Pulldown" name="MutatorPoolPulldown" template="StandardSmallButtonTemplates/StandardSmallPulldownTemplate">
                    <Tooltip val="@CMUI/CustomMutatorPool/PoolTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/SearchEditBoxTemplate/AnchorFrame" pos="Max" offset="18"/>
                        <Width val="230"/>
                    </Frame>
                </Frame>

                <Frame type="Button" name="PrevPageButton" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/NextPageButton" pos="Min" offset="-2"/>
                    <Width val="50"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                        <DesaturateOnDisable val="false"/>
                        <Texture val="@UI/Glues_Icons_SingleArrow"/>

                        <Animation name="Disabled">
                            <Event event="OnDisabled" action="Reset,Play" frame="$parent"/>
                            <Event event="OnEnabled" action="Reset" frame="$parent"/>

                            <Controller name="Texture_0" type="Texture" end="Pause" layer="0" frame="$this">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SingleArrowDisabled"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>

                <Frame type="Label" name="PageLabel">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="2"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="2"/>
                    <Anchor side="Right" relative="$parent/PrevPageButton" pos="Min" offset="-4"/>
                    <Width val="86"/>
                    <Text val="1 / 1"/>
                    <Style val="@Coop_CustomMutator_PageNumber"/>
                </Frame>

                <Frame type="Button" name="NextPageButton" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="-4"/>
                    <Width val="50"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                        <DesaturateOnDisable val="false"/>
                        <Texture val="@UI/Glues_Icons_SingleArrow"/>
                        <TextureCoords top="0" left="1" bottom="1" right="0"/>

                        <Animation name="Disabled">
                            <Event event="OnDisabled" action="Reset,Play" frame="$parent"/>
                            <Event event="OnEnabled" action="Reset" frame="$parent"/>

                            <Controller name="Texture_0" type="Texture" end="Pause" layer="0" frame="$this">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SingleArrowDisabled"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>
            </Frame>

            <Frame type="Frame" name="ListPanel">
                <Anchor side="Top" relative="$parent/HeaderPanel" pos="Max" offset="12"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="55"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-55"/>
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-25"/>

                <Frame type="Image" name="MutatorListBg">
                    <Anchor relative="$parent"/>
                    <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
                    <TextureType val="NineSlice"/>
                </Frame>

                <Frame type="Image" name="MutatorTileListHeaderBg">
                    <Anchor side="Top" relative="$parent/MutatorListBg" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/MutatorListBg" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/MutatorListBg" pos="Max" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerHeader"/>
                    <TextureType val="NineSlice"/>
                    <Height val="40"/>
                </Frame>

                <Frame type="Frame" name="RowsPanel">
                    <Anchor side="Top" relative="$parent/MutatorTileListHeaderBg" pos="Max" offset="4"/>
                    <Anchor side="Left" relative="$parent/MutatorListBg" pos="Min" offset="8"/>
                    <Anchor side="Right" relative="$parent/MutatorListBg" pos="Max" offset="-8"/>
                    <Anchor side="Bottom" relative="$parent/MutatorListBg" pos="Max" offset="-8"/>
                <Frame type="Frame" name="Item1">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
