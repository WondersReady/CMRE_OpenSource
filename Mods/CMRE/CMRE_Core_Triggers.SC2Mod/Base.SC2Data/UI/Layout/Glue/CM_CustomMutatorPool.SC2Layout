                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="180"/>
                <Width val="300"/>
                <Text val="@CMUI/MatchmakingMapVetoFrame/Cancel"/>
                <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
            </Frame>

            <StateGroup name="PoolModeState">
                <DefaultState val="Random"/>
                <State name="Random">
                    <When type="AnimationState" PoolModeState="Random"/>
                </State>
                <State name="BrutalPlus">
                    <When type="AnimationState" PoolModeState="BrutalPlus"/>
                </State>
                <State name="Cycle">
                    <When type="AnimationState" PoolModeState="Cycle"/>
                </State>
                <State name="Chaos">
                    <When type="AnimationState" PoolModeState="Chaos"/>
                </State>
