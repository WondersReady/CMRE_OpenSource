<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="Frame" name="OverviewPlayerPanelTemplate">
        <Width val="650"/>
        <Height val="460"/>

        <Frame type="Image" name="HeaderImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Height val="52"/>
            <Texture val="@UI/SC2_UI_Tournament_NextInfo_BG_Large"/>
        </Frame>

        <Frame type="Label" name="PlayerLabel">
            <Anchor side="Top" relative="$parent/HeaderImage" pos="Min" offset="3"/>
            <Anchor side="Left" relative="$parent/HeaderImage" pos="Min" offset="16"/>
            <Anchor side="Right" relative="$parent/HeaderImage" pos="Max" offset="-16"/>
            <Height val="26"/>
            <Style val="Coop_ScoreScreen_StatNameCommander"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
        </Frame>

        <Frame type="Label" name="PrestigeLabel">
            <Anchor side="Top" relative="$parent/PlayerLabel" pos="Max" offset="-1"/>
            <Anchor side="Left" relative="$parent/HeaderImage" pos="Min" offset="16"/>
            <Anchor side="Right" relative="$parent/HeaderImage" pos="Max" offset="-16"/>
            <Height val="20"/>
            <Style val="Coop_ScoreScreen_PlayerNameCommander"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
        </Frame>

        <Frame type="Frame" name="TotalsFrame">
            <Anchor side="Top" relative="$parent/HeaderImage" pos="Max" offset="4"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Height val="32"/>

            <Frame type="Label" name="KillsLabel">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
                <Width val="250"/>
                <Style val="Coop_ScoreScreen_StatSource"/>
                <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
            </Frame>

            <Frame type="Label" name="DamageLabel">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
                <Width val="340"/>
                <Style val="Coop_ScoreScreen_StatCommander"/>
                <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
            </Frame>
        </Frame>

        <Frame type="Frame" name="ChartPanel">
            <Anchor side="Top" relative="$parent/TotalsFrame" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Height val="255"/>
        </Frame>

        <Frame type="Image" name="MasteryBackground">
            <Anchor side="Top" relative="$parent/ChartPanel" pos="Max" offset="2"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
            <TextureType val="NineSlice"/>
            <Alpha val="150"/>
        </Frame>

        <Frame type="Label" name="MasteryLabel">
            <Anchor side="Top" relative="$parent/MasteryBackground" pos="Min" offset="8"/>
            <Anchor side="Bottom" relative="$parent/MasteryBackground" pos="Max" offset="-6"/>
            <Anchor side="Left" relative="$parent/MasteryBackground" pos="Min" offset="12"/>
            <Anchor side="Right" relative="$parent/MasteryBackground" pos="Max" offset="-12"/>
            <Style val="Coop_ScoreScreen_StatSource"/>
        </Frame>
    </Frame>

