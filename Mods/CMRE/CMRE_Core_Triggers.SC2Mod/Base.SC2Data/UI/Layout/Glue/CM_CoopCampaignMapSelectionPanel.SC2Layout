                </Frame>

                <Frame type="ScrollBar" name="ScrollBar" template="CM_CoopCampaignMapSelectionPanel/TileListScrollBarTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="-4"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-1"/>
                    <StepValue val="48"/>
                    <Continuous val="true"/>
                </Frame>
            </Frame>
            <Frame type="Image" name="MapDescriptionBg">
                <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
                <Anchor side="Left" relative="$parent/EnemyTileListBg" pos="Max" offset="20"/>
                <Width val="430"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Image" name="MapImageRandom">
                <Anchor side="Top" relative="$parent/MapDescriptionBg" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Width val="396"/>
                <Height val="230"/>
                <TextureType val="Normal"/>
                <CollapseLayout val="true"/>
                <Visible val="False"/>
                <Texture val="@UI/SC2_UI_Coop_MapIcon_Random"/>

                <!-- Display random map icon -->
                <Animation name="MapSelection">
                    <Event event="Random" action="Reset,Play" frame="$parent/$parent"/>
                    <Event event="NotRandom" action="Reset,Stop" frame="$parent/$parent"/>

                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="true"/>
                    </Controller>
                </Animation>
            </Frame>

            <!-- <Frame type="BattleMapIcon" name="MapImage"> -->
            <Frame type="Frame" name="MapImage">
                <Anchor side="Top" relative="$parent/MapDescriptionBg" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Width val="396"/>
                <Height val="230"/>
                <CollapseLayout val="true"/>

                <Frame type="Image" name="Image">
                    <Anchor relative="$parent"/>
                    <TextureType val="Normal"/>
                </Frame>

                <!-- Display normal map icon -->
                <Animation name="MapSelection">
                    <Event event="Random" action="Reset,Play" frame="$parent/$parent"/>
                    <Event event="NotRandom" action="Reset,Stop" frame="$parent/$parent"/>

                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="false"/>
                    </Controller>
                </Animation>

                <Animation name="IconState">
                    <Event event="Show" action="Reset,Play" frame="$this"/>
                    <Event event="Hide" action="Reset,Stop" frame="$this"/>

                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" out="Auto"/>
                        <Key type="Curve" time="0.2" value="255" in="Auto"/>
                    </Controller>
                </Animation>
            </Frame>

            <Frame type="Image" name="MapImageBorder">
                <Anchor side="Top" relative="$parent/MapDescriptionBg" pos="Min" offset="10"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/MapDescriptionBg" pos="Mid" offset="0"/>
                <Width val="398"/>
                <Height val="232"/>
                <Texture val="@UI/SC2_UI_Battlenet_Glue_Arcade_ImageBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Label" name="MapDescriptionLabel">
                <Anchor side="Top" relative="$parent/MapImageBorder" pos="Max" offset="20"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapDescriptionBg" pos="Max" offset="-15"/>
                <Style val="Tournament_MapVetoDetails"/>
            </Frame>

            <Frame type="Label" name="EnemyDescriptionLabel">
                <Anchor side="Top" relative="$parent/MapDescriptionLabel" pos="Max" offset="20"/>
                <Anchor side="Bottom" relative="$parent/MapDescriptionBg" pos="Max" offset="-15"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapDescriptionBg" pos="Max" offset="-15"/>
                <Style val="Tournament_MapVetoDetails"/>
            </Frame>

            <Frame type="Image" name="MapOptionsBg">
                <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
                <Anchor side="Left" relative="$parent/MapDescriptionBg" pos="Max" offset="20"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Image" name="MapOptionsHeaderBg">
                <Anchor side="Top" relative="$parent/RandomSeedContainer" pos="Max" offset="14"/>
                <Anchor side="Left" relative="$parent/MapOptionsBg" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/MapOptionsBg" pos="Max" offset="0"/>
                <Height val="40"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerHeader"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Label" name="MapOptionsHeader">
                <Anchor side="Top" relative="$parent/MapOptionsHeaderBg" pos="Min" offset="3"/>
                <Anchor side="Left" relative="$parent/MapOptionsHeaderBg" pos="Min" offset="25"/>
                <Anchor side="Bottom" relative="$parent/MapOptionsHeaderBg" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent/MapOptionsHeaderBg" pos="Max" offset="-10"/>
                <Text val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/MapOptions"/>
                <Style val="BattlenetListHeader"/>
            </Frame>

            <Frame type="Frame" name="RandomSeedContainer">
                <Anchor side="Top" relative="$parent/MapOptionsBg" pos="Min" offset="14"/>
                <Anchor side="Left" relative="$parent/MapOptionsBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <Height val="36"/>

                <Frame type="EditBox" name="RandomSeedEditBox" template="StandardSmallButtonTemplates/StandardSmallSearchBoxTemplate">
                    <MaxCharacters val="16"/>
                    <Tooltip val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>

                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>

                    <Frame type="Label" name="SearchTextLabel">
                        <Text val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedLabel"/>
                    </Frame>

                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent/$parent/RandomSeedRefreshButton/AnchorFrame" pos="Min" offset="-8"/>
                    </Frame>
                </Frame>

                <Frame type="Button" name="RandomSeedRefreshButton" template="StandardSmallButtonTemplates/StandardSmallIconButtonTemplate">
                    <Tooltip val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedRefreshTooltip"/>

                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent/$parent" pos="Max" offset="0"/>
                        <Width val="36"/>
                    </Frame>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Normal"/>

                        <StateGroup name="DisplayState">
                            <DefaultState val="Normal"/>

                            <State name="Disabled">
                                <When type="StateGroup" frame="$parent" DisabledState="Disabled"/>
                                <Action type="SetProperty" frame="$this" Texture="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Normal"/>
                                <Action type="SetProperty" frame="$this" Color="64,95,113"/>
                            </State>

                            <State name="Pressed">
                                <When type="StateGroup" frame="$parent" PressedState="Pressed"/>
                                <Action type="SetProperty" frame="$this" Texture="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Pressed"/>
                                <Action type="SetProperty" frame="$this" Color="255,255,255"/>
                            </State>

                            <State name="Hover">
                                <When type="StateGroup" frame="$parent" HoveredState="Hovered"/>
                                <Action type="SetProperty" frame="$this" Texture="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Normal"/>
                                <Action type="SetProperty" frame="$this" Color="204,231,255"/>
                            </State>

                            <State name="Normal">
                                <Action type="SetProperty" frame="$this" Texture="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Normal"/>
                                <Action type="SetProperty" frame="$this" Color="141,191,234"/>
                            </State>
                        </StateGroup>
                    </Frame>
                </Frame>
            </Frame>

            <Frame type="ScrollableFrame" name="MapOptionsScrollFrame">
                <Anchor side="Top" relative="$parent/MapOptionsHeaderBg" pos="Max" offset="8"/>
                <Anchor side="Left" relative="$parent/MapOptionsBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <Anchor side="Bottom" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <AcceptsMouse val="true"/>
                <Frame type="Frame" name="ContainerFrame">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/ScrollBar" pos="Min" offset="-6"/>
                    <Anchor side="Bottom" relative="$this/Option7" pos="Max" offset="0"/>
                    <Frame type="Label" name="MapOptionsEmptyLabel">
                        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Height val="32"/>
                        <CollapseLayout val="true"/>
                        <Text val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/MapOptionsEmpty"/>
                        <Style val="Tournament_MapVetoDetails"/>
                    </Frame>
                    <Frame type="Frame" name="Option0" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate">
                        <Anchor side="Top" relative="$parent/MapOptionsEmptyLabel" pos="Max" offset="0"/>
                    </Frame>
                    <Frame type="Frame" name="Option1" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option0" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option2" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option1" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option3" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option2" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option4" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option3" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option5" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option4" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option6" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option5" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option7" template="CM_CoopCampaignMapSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option6" pos="Max" offset="6"/></Frame>
                </Frame>
                <Frame type="ScrollBar" name="ScrollBar" template="CM_CoopCampaignMapSelectionPanel/TileListScrollBarTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                    <StepValue val="48"/>
                    <Continuous val="true"/>
                </Frame>
            </Frame>

            <Frame type="Button" name="AcceptButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="-3"/>
                <Text val="@CMUI/StandardDialog_Ok_Control"/>
            </Frame>

            <Frame type="Button" name="CloseButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="3"/>
                <Text val="@CMUI/StandardDialog_Cancel_Control"/>
                <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
            </Frame>
        </Frame>



    <!-- <Frame type="CoopCampaignMapSelectionPanel" name="CoopCampaignMapSelectionPanelTemplate"> -->
    <Frame type="Frame" name="CoopCampaignMapSelectionPanelTemplate">
        <Frame type="Button" name="RetryMapButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
            <!--"Fake" map button to replace the real one while retry is selected.-->
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Width val="260"/>
            <Visible val="False"/>
            <CollapseLayout val="True"/>
        </Frame>
        <Frame type="Button" name="MapButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Width val="260"/>
            <Visible val="True"/>
        </Frame>

        <Frame type="Label" name="SelectedEnemyLabel">
            <Anchor side="Top" relative="$parent/MapButton" pos="Min" offset="-20"/>
            <Anchor side="Left" relative="$parent/MapButton" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/MapButton" pos="Max" offset="0"/>
            <Style val="Coop_MapDifficultyLabel"/>
        </Frame>

        </Frame>
</Desc>
