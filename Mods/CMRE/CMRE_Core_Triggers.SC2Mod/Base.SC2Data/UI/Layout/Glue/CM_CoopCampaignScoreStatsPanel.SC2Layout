        <Frame type="Frame" name="ScoreValueNameFrame4" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagNameFrameTemplate">
            <Anchor side="Top" relative="$parent/ScoreValueNameFrame3" pos="Max" offset="#StatItemVerticalSpacing"/>
            <!-- <ScoreValueLink val="#ScoreValue4"/> -->
        </Frame>

        <!-- <Frame type="PlayerScoreValueResultUniqueTagNameFrame" name="ScoreValueNameFrame5" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagNameFrameTemplate"> -->
        <Frame type="Frame" name="ScoreValueNameFrame5" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagNameFrameTemplate">
            <Anchor side="Top" relative="$parent/ScoreValueNameFrame4" pos="Max" offset="#StatItemVerticalSpacing"/>
            <!-- <ScoreValueLink val="#ScoreValue5"/> -->
        </Frame>

        <!-- <Frame type="PlayerScoreValueResultUniqueTagNameFrame" name="ScoreValueNameFrame6" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagNameFrameTemplate"> -->
