                <Anchor side="Top" relative="$parent/ScoreValueFrame3" pos="Max" offset="#StatItemVerticalSpacing"/>
                <!-- <ScoreValueLink val="#ScoreValue4"/> -->
            </Frame>

            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame5" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame5" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame4" pos="Max" offset="#StatItemVerticalSpacing"/>
                <!-- <ScoreValueLink val="#ScoreValue5"/> -->
            </Frame>

            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame6" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame6" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame5" pos="Max" offset="#StatItemVerticalSpacing"/>
                <!-- <ScoreValueLink val="#ScoreValue6"/> -->
            </Frame>

            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame7" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame7" template="CM_CoopCampaignScoreStatsPanel/ScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame6" pos="Max" offset="#StatItemVerticalSpacing"/>
                <!-- <ScoreValueLink val="#ScoreValue7"/> -->
            </Frame>
        </Frame>
        
        <!-- <Frame type="CoopCampaignPlayerScoreResultFrame" name="AllyPlayerFrame" template="CM_CoopCampaignScoreStatsPanel/PlayerScoreResultFrameTemplate"> -->
        <Frame type="Frame" name="AllyPlayerFrame" template="CM_CoopCampaignScoreStatsPanel/PlayerScoreResultFrameTemplate">
            <Anchor side="Top" relative="$parent/LocalPlayerFrame" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/LocalPlayerFrame" pos="Max" offset="10"/>

            <Frame type="Label" name="NameLabel">
                <Style val="Coop_ScoreScreen_PlayerNameAlly"/>
            </Frame>
            
            <Frame type="Label" name="CommanderLabel">
                <Style val="Coop_ScoreScreen_StatNameAlly"/>
            </Frame>

            <!-- <Frame type="PlayerScoreValueResultNumberFrame" name="ScoreValueFrame0" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueNumberFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame0" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueNumberFrameTemplate">
                <Anchor side="Top" relative="$parent/NameLabel" pos="Max" offset="30"/>
                <!-- <ScoreValueLink val="#ScoreValue0"/> -->
            </Frame>

            <!-- <Frame type="PlayerScoreValueResultNumberFrame" name="ScoreValueFrame1" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueNumberFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame1" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueNumberFrameTemplate">
