            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame3" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame3" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame2" pos="Max" offset="#StatItemVerticalSpacing"/>
