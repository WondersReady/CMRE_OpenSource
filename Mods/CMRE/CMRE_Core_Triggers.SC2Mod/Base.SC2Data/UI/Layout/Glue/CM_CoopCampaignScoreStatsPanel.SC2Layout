    <Frame type="Frame" name="ScoreValueTitlesTemplate">
        <Width val="320"/>

        <!-- <Frame type="PlayerScoreValueResultNameFrame" name="ScoreValueNameFrame0" template="CM_CoopCampaignScoreStatsPanel/ScoreValueNameFrameTemplate"> -->
        <Frame type="Frame" name="ScoreValueNameFrame0" template="CM_CoopCampaignScoreStatsPanel/ScoreValueNameFrameTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <!-- <ScoreValueLink val="#ScoreValue0"/> -->
        </Frame>

        <!-- <Frame type="PlayerScoreValueResultNameFrame" name="ScoreValueNameFrame1" template="CM_CoopCampaignScoreStatsPanel/ScoreValueNameFrameTemplate"> -->
        <Frame type="Frame" name="ScoreValueNameFrame1" template="CM_CoopCampaignScoreStatsPanel/ScoreValueNameFrameTemplate">
            <Anchor side="Top" relative="$parent/ScoreValueNameFrame0" pos="Max" offset="#StatItemVerticalSpacing"/>
