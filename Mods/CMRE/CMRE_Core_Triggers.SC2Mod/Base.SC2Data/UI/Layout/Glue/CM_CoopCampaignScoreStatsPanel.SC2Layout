<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    
    <Constant name="StatItemVerticalSpacing" val="10"/>
    <Constant name="ScoreValue0" val="UnitsStructuresKilled"/>
    <Constant name="ScoreValue1" val="UnitsProduced"/>
    <Constant name="ScoreValue2" val="ResourcesGathered"/>
    <Constant name="ScoreValue3" val="MissionScore"/>
    <Constant name="ScoreValue4" val="CommanderOneScorePrimary"/>
    <Constant name="ScoreValue5" val="CommanderOneScoreSecondary"/>
    <Constant name="ScoreValue6" val="CommanderTwoScorePrimary"/>
    <Constant name="ScoreValue7" val="CommanderTwoScoreSecondary"/>

    <Frame type="Frame" name="ScoreValueLabelFrameTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="30"/>

        <Frame type="Label" name="ResultLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="2"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Coop_ScoreScreen_StatSource"/>
            <AcceptsMouseTooltip val="True"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
            <TooltipFrame val="BattleNetTooltip"/>

            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
        </Frame>
    </Frame>

    <!-- <Frame type="PlayerScoreValueResultNameFrame" name="ScoreValueNameFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueLabelFrameTemplate"> -->
    <Frame type="Frame" name="ScoreValueNameFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueLabelFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Text val=""/>
        </Frame>
    </Frame>

    <!-- <Frame type="PlayerScoreValueResultUniqueTagNameFrame" name="ScoreValueUniqueTagNameFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueLabelFrameTemplate"> -->
    <Frame type="Frame" name="ScoreValueUniqueTagNameFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueLabelFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Text val=""/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="ScoreValueFrameTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="30"/>

        <Frame type="Label" name="ResultLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="2"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Coop_ScoreScreen_StatCommander"/>
        </Frame>
    </Frame>

    <!-- <Frame type="PlayerScoreValueResultNumberFrame" name="ScoreValueNumberFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate"> -->
    <Frame type="Frame" name="ScoreValueNumberFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Text val=""/>
        </Frame>
    </Frame>

    <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueUniqueTagFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate"> -->
    <Frame type="Frame" name="ScoreValueUniqueTagFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Text val=""/>
        </Frame>
    </Frame>
    
    <!-- <Frame type="PlayerScoreValueResultNumberFrame" name="AllyScoreValueNumberFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate"> -->
    <Frame type="Frame" name="AllyScoreValueNumberFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Style val="Coop_ScoreScreen_StatAlly"/>
            <Text val=""/>
