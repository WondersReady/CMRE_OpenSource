            </Frame>

            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame4" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame4" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame3" pos="Max" offset="#StatItemVerticalSpacing"/>
                <!-- <ScoreValueLink val="#ScoreValue4"/> -->
