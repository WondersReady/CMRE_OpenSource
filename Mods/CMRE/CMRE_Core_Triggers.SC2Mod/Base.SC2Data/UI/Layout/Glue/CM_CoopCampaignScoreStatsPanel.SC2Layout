            <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="ScoreValueFrame5" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate"> -->
            <Frame type="Frame" name="ScoreValueFrame5" template="CM_CoopCampaignScoreStatsPanel/AllyScoreValueUniqueTagFrameTemplate">
                <Anchor side="Top" relative="$parent/ScoreValueFrame4" pos="Max" offset="#StatItemVerticalSpacing"/>
