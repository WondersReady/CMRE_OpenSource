    <!-- <Frame type="PlayerScoreValueResultUniqueTagFrame" name="AllyScoreValueUniqueTagFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate"> -->
    <Frame type="Frame" name="AllyScoreValueUniqueTagFrameTemplate" template="CM_CoopCampaignScoreStatsPanel/ScoreValueFrameTemplate">
        <Frame type="Label" name="ResultLabel">
            <Style val="Coop_ScoreScreen_StatAlly"/>
