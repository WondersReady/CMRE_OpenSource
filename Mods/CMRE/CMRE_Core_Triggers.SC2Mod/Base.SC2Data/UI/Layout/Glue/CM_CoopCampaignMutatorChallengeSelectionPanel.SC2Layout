                <Anchor side="Right" relative="$parent/MutatorChallengeDescriptionBg" pos="Mid" offset="0"/>
                <Width val="396"/>
                <Height val="230"/>
                <TextureType val="Normal"/>
                <CollapseLayout val="true"/>
                <Visible val="False"/>
                <Texture val="@UI/SC2_UI_Coop_MapIcon_Random"/>

                <Frame type="Image" name="MutatorOverlay">
                    <Anchor relative="$parent"/>
                    <Texture val="@UI/Glues_Battlenet_PageAssets_Loading_MutatorOverlay"/>
                    <TextureType val="Normal"/>
                </Frame>

                <!-- Display random map icon -->
                <Animation name="MutatorChallengeSelection">
                    <Event event="Random" action="Reset,Play" frame="$parent/$parent"/>
                    <Event event="NotRandom" action="Reset,Stop" frame="$parent/$parent"/>

                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="true"/>
                    </Controller>
                </Animation>
            </Frame>

            <!-- <Frame type="BattleMapIcon" name="MutatorChallengeImage"> -->
            <Frame type="Frame" name="MutatorChallengeImage">
                <Anchor side="Top" relative="$parent/MutatorChallengeDescriptionBg" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeDescriptionBg" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeDescriptionBg" pos="Mid" offset="0"/>
                <Width val="396"/>
                <Height val="230"/>
                <CollapseLayout val="true"/>

                <Frame type="Image" name="Image">
                    <Anchor relative="$parent"/>
                    <TextureType val="Normal"/>
                </Frame>

                <Frame type="Image" name="MutatorOverlay">
                    <Anchor relative="$parent"/>
                    <Texture val="@UI/Glues_Battlenet_PageAssets_Loading_MutatorOverlay"/>
                    <TextureType val="Normal"/>
                </Frame>

                <!-- Display normal map icon -->
                <Animation name="MutatorChallengeSelection">
                    <Event event="Random" action="Reset,Play" frame="$parent/$parent"/>
                    <Event event="NotRandom" action="Reset,Stop" frame="$parent/$parent"/>

                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="false"/>
                    </Controller>
                </Animation>

                <Animation name="IconState">
                    <Event event="Show" action="Reset,Play" frame="$this"/>
                    <Event event="Hide" action="Reset,Stop" frame="$this"/>

                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" out="Auto"/>
                        <Key type="Curve" time="0.2" value="255" in="Auto"/>
                    </Controller>
                </Animation>
            </Frame>

            <Frame type="Image" name="MutatorChallengeImageBorder">
                <Anchor side="Top" relative="$parent/MutatorChallengeDescriptionBg" pos="Min" offset="10"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeDescriptionBg" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeDescriptionBg" pos="Mid" offset="0"/>
                <Width val="398"/>
                <Height val="232"/>
                <Texture val="@UI/SC2_UI_Battlenet_Glue_Arcade_ImageBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="ScrollableFrame" name="MutatorChallengeDetailsScrollFrame">
                <Anchor side="Top" relative="$parent/MutatorChallengeImageBorder" pos="Max" offset="14"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeDescriptionBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeDescriptionBg" pos="Max" offset="-6"/>
                <Anchor side="Bottom" relative="$parent/MutatorChallengeDescriptionBg" pos="Max" offset="-10"/>
                <AcceptsMouse val="true"/>

                <Frame type="Frame" name="ContainerFrame">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/ScrollBar" pos="Min" offset="-6"/>
                    <Anchor side="Bottom" relative="$this/ContentsBottom" pos="Max" offset="0"/>

                    <Frame type="Label" name="MutatorChallengeDescriptionLabel">
                        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Style val="Tournament_MapVetoDetails"/>
                    </Frame>

                    <Frame type="Label" name="EnemyDescriptionLabel">
                        <Anchor side="Top" relative="$parent/MutatorChallengeDescriptionLabel" pos="Max" offset="18"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Style val="Tournament_MapVetoDetails"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem0" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/EnemyDescriptionLabel" pos="Max" offset="18"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem1" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem0" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem2" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem1" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem3" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem2" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem4" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem3" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem5" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem4" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem6" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem5" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem7" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem6" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem8" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem7" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="MutatorItem9" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MutatorChallengeMutatorInfoItemTemplate">
                        <Anchor side="Top" relative="$parent/MutatorItem8" pos="Max" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <Frame type="Frame" name="ContentsBottom">
                        <Anchor side="Top" relative="$parent/MutatorItem9" pos="Max" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Height val="1"/>
                    </Frame>
                </Frame>

                <Frame type="ScrollBar" name="ScrollBar" template="CM_CoopCampaignMutatorChallengeSelectionPanel/TileListScrollBarTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                    <StepValue val="50"/>
                    <Continuous val="true"/>
                </Frame>
            </Frame>

            <Frame type="Image" name="MapOptionsBg">
                <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeDescriptionBg" pos="Max" offset="20"/>
