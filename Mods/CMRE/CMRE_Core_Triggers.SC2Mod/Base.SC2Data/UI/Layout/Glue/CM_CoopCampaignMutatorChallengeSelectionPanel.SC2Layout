            </Frame>

            <Frame type="Frame" name="RandomSeedContainer">
                <Anchor side="Top" relative="$parent/MapOptionsBg" pos="Min" offset="14"/>
                <Anchor side="Left" relative="$parent/MapOptionsBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <Height val="36"/>
                <Frame type="EditBox" name="RandomSeedEditBox" template="StandardSmallButtonTemplates/StandardSmallSearchBoxTemplate">
                    <MaxCharacters val="16"/>
                    <Tooltip val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                    <Frame type="Label" name="SearchTextLabel">
                        <Text val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedLabel"/>
                    </Frame>
                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent/$parent/RandomSeedRefreshButton/AnchorFrame" pos="Min" offset="-8"/>
                    </Frame>
                </Frame>
                <Frame type="Button" name="RandomSeedRefreshButton" template="StandardSmallButtonTemplates/StandardSmallIconButtonTemplate">
                    <Tooltip val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/RandomSeedRefreshTooltip"/>
                    <Frame type="Frame" name="AnchorFrame">
                        <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent/$parent" pos="Max" offset="0"/>
                        <Width val="36"/>
                    </Frame>
                    <Frame type="Image" name="Icon">
                        <Anchor relative="$parent"/>
                        <Texture val="@UI/Glues_Battlenet_StandardButtons_Small_Icon_Refresh_Normal"/>
                    </Frame>
                </Frame>
            </Frame>

            <Frame type="ScrollableFrame" name="MapOptionsScrollFrame">
                <Anchor side="Top" relative="$parent/MapOptionsHeaderBg" pos="Max" offset="8"/>
                <Anchor side="Left" relative="$parent/MapOptionsBg" pos="Min" offset="15"/>
                <Anchor side="Right" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <Anchor side="Bottom" relative="$parent/MapOptionsBg" pos="Max" offset="-15"/>
                <AcceptsMouse val="true"/>
                <Frame type="Frame" name="ContainerFrame">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/ScrollBar" pos="Min" offset="-6"/>
                    <Anchor side="Bottom" relative="$this/Option7" pos="Max" offset="0"/>
                    <Frame type="Label" name="MapOptionsEmptyLabel">
                        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Height val="32"/>
                        <CollapseLayout val="true"/>
                        <Text val="@CMUI/ScreenCoopCampaign/MapSelectionPanel/MapOptionsEmpty"/>
                        <Style val="Tournament_MapVetoDetails"/>
                    </Frame>
                    <Frame type="Frame" name="Option0" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/MapOptionsEmptyLabel" pos="Max" offset="0"/></Frame>
                    <Frame type="Frame" name="Option1" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option0" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option2" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option1" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option3" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option2" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option4" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option3" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option5" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option4" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option6" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option5" pos="Max" offset="6"/></Frame>
                    <Frame type="Frame" name="Option7" template="CM_CoopCampaignMutatorChallengeSelectionPanel/MapOptionRowTemplate"><Anchor side="Top" relative="$parent/Option6" pos="Max" offset="6"/></Frame>
                </Frame>
                <Frame type="ScrollBar" name="ScrollBar" template="CM_CoopCampaignMutatorChallengeSelectionPanel/TileListScrollBarTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                    <StepValue val="48"/>
                    <Continuous val="true"/>
                </Frame>
            </Frame>

            <Frame type="Button" name="AcceptButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="-3"/>
                <Text val="@CMUI/StandardDialog_Ok_Control"/>
            </Frame>

            <Frame type="Button" name="CloseButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="3"/>
                <Text val="@CMUI/StandardDialog_Cancel_Control"/>
                <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
            </Frame>
        </Frame>
</Desc>
