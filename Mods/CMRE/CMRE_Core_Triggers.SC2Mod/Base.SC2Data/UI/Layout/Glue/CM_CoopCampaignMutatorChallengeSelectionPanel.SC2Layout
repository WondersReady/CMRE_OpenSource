<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Constant name="MutatorChallengeListItemVerticalGap" val="-4"/>

    <Frame type="Image" name="ScrollBarBackgroundImage">
        <Texture val="Assets/Textures/UI_Battlenet_Glue_ChatPanelScrollBarLine.dds"/>
        <TextureType val="Nineslice"/>
        <Tiled val="true"/>
        <Alpha val="0"/>
        <DescFlags val="Internal"/>
    </Frame>

    <Frame type="Button" name="ScrollBarButtonTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <DescFlags val="Internal"/>

        <Frame type="Image" name="NormalImage">
            <Texture val="@UI/ChatPanelScrollBarGrabber_Normal"/>
            <TextureType val="Nineslice"/>
            <Tiled val="true"/>
            <DescFlags val="Internal"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Texture val="@UI/ChatPanelScrollBarGrabber_Hover"/>
            <TextureType val="Nineslice"/>
            <Tiled val="true"/>
            <DescFlags val="Internal"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="MapOptionRowTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="88"/>
        <Visible val="False"/>
        <CollapseLayout val="true"/>
        <Frame type="Label" name="DescriptionLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Height val="30"/>
            <Style val="@Coop_CommanderMasteryInfoHeader"/>
        </Frame>
        <Frame type="Pulldown" name="Pulldown" template="StandardBattlenetTemplates/BattlenetPulldownTemplate">
            <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="4"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        </Frame>
    </Frame>

    <Frame type="ScrollBar" name="TileListScrollBarTemplate">
        <Image val="$root/CM_CoopCampaignMutatorChallengeSelectionPanel/ScrollBarBackgroundImage"/>
        <Button val="$root/CM_CoopCampaignMutatorChallengeSelectionPanel/ScrollBarButtonTemplate"/>
        <Orientation val="Vertical"/>
        <Width val="16"/>
        <CollapseLayout val="true"/>
    </Frame>

    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="CoopCampaignMutatorChallengeTileListItemTemplate"> -->
    <Frame type="Button" name="CoopCampaignMutatorChallengeTileListItemTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <!-- Button selected state is driven by Toggled animations below. -->
        <!-- <SelectedImage val="SelectedImage"/> -->
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="52"/>
        <CollapseLayout val="true"/>
		<ClickSound val="@AC_UI_MapSelect"/>

        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Normal"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Hover"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="SelectedImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Selected"/>
            <TextureType val="NineSlice"/>
            <Visible val="false"/>

            <Animation name="ToggledSelectedImage">
                <Event event="Toggled" action="Reset" frame="$parent"/>
                <Event event="Toggled" action="Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="true"/>
                </Controller>
            </Animation>

            <Animation name="NormalSelectedImage">
                <Event event="Normal" action="Reset" frame="$parent"/>
                <Event event="Normal" action="Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="false"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Label" name="MutatorChallengeNameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Text val="@CMUI/ScreenCoopCampaign/MutatorChallengeSelectionPanel/MutatorChallengeNameLabel"/>
            <Style val="BattlenetListItem"/>

            <Animation name="SelectedFontStyle">
                <Event event="OnShown" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnShown" action="Play" frame="$parent/SelectedImage"/>

                <Controller type="Style" end="Pause" style1="BattlenetListItem" style2="BattlenetListItemSelected">
                    <Key type="Curve" time="0" value="1"/>
                </Controller>
            </Animation>

            <Animation name="NormalFontStyle">
                <Event event="OnHidden" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnHidden" action="Play" frame="$parent/SelectedImage"/>

                <Controller type="Style" end="Pause" style1="BattlenetListItem" style2="BattlenetListItemSelected">
                    <Key type="Curve" time="0" value="0"/>
                </Controller>
            </Animation>
        </Frame>
    </Frame>

    <Frame type="Button" name="CoopCampaignMutatorChallengeEnemyTileListItemTemplate" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
        <StateGroup name="RaceState">
            <DefaultState val="None"/>
            <State name="None">
                <When type="AnimationState" RaceState="None"/>
            </State>
            <State name="Rand">
                <When type="AnimationState" RaceState="Rand"/>
            </State>
            <State name="Prot">
                <When type="AnimationState" RaceState="Prot"/>
            </State>
            <State name="Terr">
                <When type="AnimationState" RaceState="Terr"/>
            </State>
            <State name="Zerg">
                <When type="AnimationState" RaceState="Zerg"/>
            </State>
        </StateGroup>

        <Frame type="Image" name="RaceIcon">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="-14"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
            <Width val="28"/>
            <Height val="28"/>
            <Texture val="@UI/SC2_UI_Multiplayer_RaceButton_RaceIcon_Selected_Rand"/>
            <TextureType val="Normal"/>
            <Visible val="False"/>

            <StateGroup name="RaceState">
                <DefaultState val="None"/>

                <State name="None">
                    <When type="AnimationState" RaceState="None"/>
                    <Action type="SetProperty" frame="$this" Visible="False"/>
                </State>

                <State name="Rand">
                    <When type="AnimationState" RaceState="Rand"/>
                    <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Multiplayer_RaceButton_RaceIcon_Selected_Rand"/>
                    <Action type="SetProperty" frame="$this" Visible="True"/>
                </State>

                <State name="Prot">
                    <When type="AnimationState" RaceState="Prot"/>
                    <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Multiplayer_RaceButton_RaceIcon_Selected_Prot"/>
                    <Action type="SetProperty" frame="$this" Visible="True"/>
                </State>

                <State name="Terr">
                    <When type="AnimationState" RaceState="Terr"/>
                    <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Multiplayer_RaceButton_RaceIcon_Selected_Terr"/>
                    <Action type="SetProperty" frame="$this" Visible="True"/>
                </State>

                <State name="Zerg">
                    <When type="AnimationState" RaceState="Zerg"/>
                    <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Multiplayer_RaceButton_RaceIcon_Selected_Zerg"/>
                    <Action type="SetProperty" frame="$this" Visible="True"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Label" name="MutatorChallengeNameLabel">
            <Anchor side="Left" relative="$parent" pos="Min" offset="50"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="MutatorChallengeIconSlotTemplate">
        <Width val="48"/>
        <Height val="48"/>

        <Frame type="Image" name="Background">
            <Anchor relative="$parent"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Normal"/>
            <TextureType val="NineSlice"/>
            <Alpha val="210"/>
        </Frame>

        <Frame type="Image" name="IconImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-5"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-5"/>
        </Frame>

        <Frame type="Image" name="Border">
            <Anchor relative="$parent"/>
            <Texture val="@UI/SC2_UI_Battlenet_Glue_Arcade_ImageBorder"/>
            <TextureType val="NineSlice"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="MutatorChallengeMutatorInfoItemTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Anchor side="Bottom" relative="$this/DescriptionLabel" pos="Max" offset="0"/>
        <Visible val="False"/>
        <CollapseLayout val="true"/>

        <Frame type="Frame" name="MutatorIconBox">
            <Anchor side="Top" relative="$parent" pos="Min" offset="3"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Width val="44"/>
            <Height val="44"/>

            <Frame type="Image" name="IconImage">
                <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Width val="36"/>
                <Height val="36"/>
                <TextureType val="Normal"/>
                <AlphaMaskTexture val="@UI/SC2_UI_Coop_AbilityFrame_Mask"/>
            </Frame>

            <Frame type="Image" name="BorderImage">
                <Anchor relative="$parent"/>
                <Texture val="assets/textures/ui_coop_ingame_mutatorframe.dds"/>
                <TextureType val="Normal"/>
            </Frame>

            <StateGroup name="SourceState">
                <DefaultState val="Official"/>
                <State name="Official">
                    <Action type="SetProperty" frame="BorderImage" texture="assets/textures/ui_coop_ingame_mutatorframe.dds"/>
                </State>
                <State name="Plus">
                    <When type="AnimationState" SourceState="Plus"/>
                    <Action type="SetProperty" frame="BorderImage" texture="assets/textures/ui_glues_profileavatar_grandmaster_small.dds"/>
                </State>
                <State name="Maguro">
                    <When type="AnimationState" SourceState="Maguro"/>
                    <Action type="SetProperty" frame="BorderImage" texture="assets/textures/ui_glues_profileavatar_master_small.dds"/>
                </State>
                <State name="ThirdParty">
                    <When type="AnimationState" SourceState="ThirdParty"/>
                    <Action type="SetProperty" frame="BorderImage" texture="assets/textures/ui_glues_profileavatar_diamond_small.dds"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Label" name="TitleLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/MutatorIconBox" pos="Max" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Height val="28"/>
            <Style val="BattlenetListItemSelected"/>
        </Frame>

        <Frame type="Label" name="DescriptionLabel">
            <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="1"/>
            <Anchor side="Left" relative="$parent/TitleLabel" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Tournament_MapVetoDetails"/>
            <AutoSizeClamps minHeight="20"/>
        </Frame>
    </Frame>
    <Frame type="Frame" name="MutatorChallengeSelectionContainerTemplate">

            <!-- This tooltip is just for blocking tooltips behind this panel -->
            <Frame type="StandardTooltip" name="CoopCampaignTooltip">
                <Frame type="Label" name="Label">
                    <Anchor relative="$parent"/>
                </Frame>
            </Frame>

            <Frame type="Image" name="FullscreenBlackoutImage">
                <Anchor relative="$parent"/>
                <Color val="0,0,0"/>
                <Alpha val="180"/>
                <AcceptsMouse val="true"/>
                <TooltipFrame val="CoopCampaignTooltip"/>
            </Frame>

            <Frame type="Image" name="LeftBGGlowPattern">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Min" offset="40"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
            </Frame>

            <Frame type="Image" name="RightBGGlowPattern">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
                <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
            </Frame>

            <Frame type="Image" name="BackgroundImage">
                <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
                <TextureType val="NineSlice"/>
                <Tiled val="false"/>
                <Width val="1500"/>
                <Height val="900"/>
            </Frame>

            <Frame type="Image" name="TopHexPattern">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
            </Frame>

            <Frame type="Image" name="BottomHexPattern">
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
            </Frame>

            <Frame type="Label" name="TitleLabel">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="50"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
                <Style val="@BattlenetDialogTitle"/>
                <Text val="@CMUI/ScreenCoopCampaign/MutatorChallengePanel/Title"/>
            </Frame>

            <Frame type="Label" name="DescriptionLabel">
                <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="10"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
                <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
                <Style val="@Coop_SelectMissionDescription"/>
            </Frame>

            <Frame type="Image" name="MutatorChallengeTileListBg">
                <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
                <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
                <Width val="290"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Image" name="MutatorChallengeTileListHeaderBg">
                <Anchor side="Top" relative="$parent/MutatorChallengeTileListBg" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeTileListBg" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeTileListBg" pos="Max" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerHeader"/>
                <TextureType val="NineSlice"/>
                <Height val="40"/>
            </Frame>

            <Frame type="Label" name="MutatorChallengeTileListHeader">
                <Anchor side="Top" relative="$parent/MutatorChallengeTileListHeaderBg" pos="Min" offset="3"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeTileListHeaderBg" pos="Min" offset="25"/>
                <Anchor side="Bottom" relative="$parent/MutatorChallengeTileListHeaderBg" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeTileListHeaderBg" pos="Max" offset="-10"/>
                <Text val="@CMUI/ScreenCoopCampaign/MutatorChallengeSelectionPanel/MissionName"/>
                <Style val="BattlenetListHeader"/>
            </Frame>

            <Frame type="ScrollableFrame" name="MutatorChallengeTileList">
                <Handle val="CM_MutatorChallengeTileList"/>
                <Anchor side="Top" relative="$parent/MutatorChallengeTileListHeaderBg" pos="Max" offset="3"/>
                <Anchor side="Left" relative="$parent/MutatorChallengeTileListBg" pos="Min" offset="5"/>
                <Anchor side="Bottom" relative="$parent/MutatorChallengeTileListBg" pos="Max" offset="-5"/>
                <Anchor side="Right" relative="$parent/MutatorChallengeTileListBg" pos="Max" offset="-5"/>
                <!-- TileList-only: <ClearSelectionIfNotVisible val="true"/> -->
                <AcceptsMouse val="true"/>

                <Frame type="Frame" name="ContainerFrame">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/ScrollBar" pos="Min" offset="0"/>
                    <Anchor side="Bottom" relative="$this/Item199" pos="Max" offset="0"/>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item0" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item0" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item1" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item1" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item0" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item2" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item2" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item1" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item1" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item3" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item3" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item2" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item2" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item4" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item4" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item3" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item3" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item5" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item5" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item4" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item4" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item6" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item6" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item5" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item5" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item7" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item7" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item6" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item6" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item8" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item8" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item7" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item7" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item9" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item9" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item8" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item8" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item10" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item10" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item9" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item9" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

                    <!-- <Frame type="CoopCampaignMutatorChallengeTileListItem" name="Item11" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate"> -->
                    <Frame type="Button" name="Item11" template="CM_CoopCampaignMutatorChallengeSelectionPanel/CoopCampaignMutatorChallengeTileListItemTemplate">
                        <Anchor side="Top" relative="$parent/Item10" pos="Max" offset="#MutatorChallengeListItemVerticalGap"/>
                        <Anchor side="Left" relative="$parent/Item10" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    </Frame>

