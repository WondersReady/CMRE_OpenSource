            <Frame type="Frame" name="MutatorIconPageSelector">
                <Anchor side="Bottom" relative="$parent/HorizontalTopDivider" pos="Min" offset="-4"/>
                <Anchor side="Left" relative="$parent/MutatorIconGroup" pos="Mid" offset="-88"/>
                <Anchor side="Right" relative="$parent/MutatorIconGroup" pos="Mid" offset="88"/>
                <Width val="176"/>
                <Height val="22"/>
                <Visible val="False"/>

                <Frame type="Button" name="DecrementButton" template="EmoticonSelectionPanel/EmoticonPageButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>

                    <Frame type="Image" name="Icon">
                        <Texture val="@UI/Glues_Icons_SmallPageArrow_Left_Normal"/>

                        <Animation name="OnDisable">
                            <Event event="OnDisabled" action="Reset,Play"/>
                            <Event event="OnEnabled" action="Reset"/>

                            <Controller type="Texture" end="Pause">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SmallPageArrow_Left_Disabled"/>
                            </Controller>
                        </Animation>

                        <Animation name="OnHover">
                            <Event event="OnMouseEnter" action="Reset, Play" frame="$parent"/>
                            <Event event="OnMouseExit" action="Reset" frame="$parent"/>
                            <Controller type="Texture" end="Pause">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SmallPageArrow_Left_Hover"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>

                <Frame type="Button" name="PageButton0" template="EmoticonSelectionPanel/PageSelectorButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/PageButton1" pos="Min" offset="12"/>
                </Frame>

                <Frame type="Button" name="PageButton1" template="EmoticonSelectionPanel/PageSelectorButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="-4"/>
                </Frame>

                <Frame type="Button" name="PageButton2" template="EmoticonSelectionPanel/PageSelectorButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="4"/>
                </Frame>

                <Frame type="Button" name="PageButton3" template="EmoticonSelectionPanel/PageSelectorButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/PageButton2" pos="Max" offset="-12"/>
                </Frame>

                <Frame type="Button" name="IncrementButton" template="EmoticonSelectionPanel/EmoticonPageButtonTemplate">
                    <Anchor side="Top" relative="$parent/DecrementButton" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>

                    <Frame type="Image" name="Icon">
                        <Texture val="@UI/Glues_Icons_SmallPageArrow_Left_Normal"/>
                        <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>

                        <Animation name="OnDisable">
                            <Event event="OnDisabled" action="Reset,Play"/>
                            <Event event="OnEnabled" action="Reset"/>

                            <Controller type="Texture" end="Pause">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SmallPageArrow_Left_Disabled"/>
                            </Controller>
                        </Animation>

                        <Animation name="OnHover">
                            <Event event="OnMouseEnter" action="Reset, Play" frame="$parent"/>
                            <Event event="OnMouseExit" action="Reset" frame="$parent"/>
                            <Controller type="Texture" end="Pause">
                                <Key type="Image" time="0" image="@UI/Glues_Icons_SmallPageArrow_Left_Hover"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>
            </Frame>

            <Frame type="Frame" name="MutatorQuickControlPanel">
                <Anchor side="Top" relative="$parent/HorizontalBottomDivider" pos="Max" offset="2"/>
                <Anchor side="Bottom" relative="$parent/BackgroundContainer" pos="Max" offset="-5"/>
                <Anchor side="Right" relative="$parent/HorizontalBottomDivider" pos="Max" offset="0"/>
                <Width val="340"/>
                <Visible val="False"/>

                <Frame type="Label" name="QuickControlLabel">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-10"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="10"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
                    <Width val="56"/>
                    <Style val="Coop_TimeRemainingLabel"/>
                    <Text val="@CMUI/MutatorInfo/QuickControlLabel"/>
                    <Options val="NoWrapping | ScaleToPreventTruncation"/>
                </Frame>

                <Frame type="Image" name="QuickControlDivider">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="6"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-6"/>
                    <Anchor side="Left" relative="$parent/QuickControlLabel" pos="Max" offset="6"/>
                    <Width val="1"/>
                    <Texture val="Assets/Textures/white.dds"/>
                    <Color val="37,107,169"/>
                    <Alpha val="180"/>
                </Frame>

                <Frame type="Frame" name="MutatorRandomIcon" template="CM_CoopCampaignMutatorInfoPanel/CoopCampaignMutatorCountIconTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-23"/>
                    <Anchor side="Left" relative="$parent/QuickControlDivider" pos="Max" offset="33"/>
                    <Width val="46"/>
                    <Height val="46"/>
                    <Tooltip val="@CMUI/MutatorInfo/RandomCountTooltip"/>

                    <Frame type="Frame" name="IconImage">
                        <Width val="42"/>
                        <Height val="42"/>

                        <Frame type="Image" name="Image">
                            <Texture val="@@UI/CM_MutatorRandomIcon"/>
                        </Frame>
                    </Frame>

                </Frame>

                <Frame type="Button" name="MutatorRandomIncress" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-23"/>
                    <Anchor side="Left" relative="$parent/MutatorRandomIcon" pos="Max" offset="3"/>
                    <Height val="23"/>
                    <Width val="34"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="8"/>
                        <Texture val="@UI/SC2_UI_Coop_MasteryIcons_Increment"/>
                        <DesaturateOnDisable val="false"/>
                    </Frame>
                </Frame>

                <Frame type="Button" name="MutatorRandomDecress" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/MutatorRandomIcon" pos="Max" offset="3"/>
                    <Height val="23"/>
                    <Width val="34"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="8"/>
                        <Texture val="@UI/SC2_UI_Coop_MasteryIcons_Decrement"/>
                        <DesaturateOnDisable val="false"/>
                    </Frame>
                </Frame>

                <Frame type="Frame" name="MutatorChaosIcon" template="CM_CoopCampaignMutatorInfoPanel/CoopCampaignMutatorCountIconTemplate">
                    <Anchor side="Top" relative="$parent/MutatorRandomIcon" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/QuickControlDivider" pos="Max" offset="151"/>
                    <Width val="46"/>
                    <Height val="46"/>
                    <Tooltip val="@CMUI/MutatorInfo/ChaosCountTooltip"/>

                    <Frame type="Frame" name="IconImage">
                        <Width val="42"/>
                        <Height val="42"/>

                        <Frame type="Image" name="Image">
                            <Texture val="@@UI/CM_MutatorChaosIcon"/>
                        </Frame>
                    </Frame>

                </Frame>

                <Frame type="Button" name="MutatorChaosIncress" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-23"/>
                    <Anchor side="Left" relative="$parent/MutatorChaosIcon" pos="Max" offset="3"/>
                    <Height val="23"/>
                    <Width val="34"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="8"/>
                        <Texture val="@UI/SC2_UI_Coop_MasteryIcons_Increment"/>
                        <DesaturateOnDisable val="false"/>
                    </Frame>
                </Frame>

                <Frame type="Button" name="MutatorChaosDecress" template="StandardBattlenetTemplates/BattlenetSquareIconButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/MutatorChaosIcon" pos="Max" offset="3"/>
                    <Height val="23"/>
                    <Width val="34"/>

                    <Frame type="Image" name="Icon">
                        <Anchor side="Top" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="8"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="-8"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="8"/>
                        <Texture val="@UI/SC2_UI_Coop_MasteryIcons_Decrement"/>
                        <DesaturateOnDisable val="false"/>
                    </Frame>
                </Frame>
            </Frame>

            <StateGroup name="MutatorCountModeState">
                <DefaultState val="ModeStandard"/>

                <State name="ModeStandard">
                    <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                    <Action type="SetProperty" frame="MutatorQuickControlPanel" Visible="False"/>
                </State>

                <State name="ModeMutator">
                    <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                    <Action type="SetProperty" frame="MutatorQuickControlPanel" Visible="False"/>
                </State>

                <State name="ModeCustom">
                    <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                    <Action type="SetProperty" frame="MutatorQuickControlPanel" Visible="True"/>
                </State>
            </StateGroup>
            
            <Frame type="Frame" name="DifficultyBadgeContainer">
                <Anchor side="Top" relative="$parent/BackgroundContainer" pos="Min" offset="6"/>
                <Anchor side="Bottom" relative="$parent/BackgroundContainer" pos="Max" offset="-6"/>
                <Anchor side="Left" relative="$parent/BackgroundContainer" pos="Min" offset="6"/>
                <Anchor side="Right" relative="$parent/VerticalDivider" pos="Min" offset="0"/>
                <AcceptsMouse val="false"/>
                
                <Frame type="Image" name="CommanderDetailsBackground">
                    <Anchor relative="$parent"/>
                    <LayerCount val="2"/>
                    <Texture val="@UI/SC2_UI_Multiplayer_LeaguePanel_IconBackground_Mask" layer="0"/>
                    <AlphaLayer val="True" layer="0"/>
                    <Texture val="assets/textures/SC2_UI_Coop_Detail_Background_Mutation.dds" layer="1"/>
                </Frame>
                
                <Frame type="Image" name="ArtBackgroundVignette">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="-2"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="2"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="-2"/>
                    <Anchor side="Right" relative="$parent" pos="Min" offset="2"/>
                    <Texture val="@UI/Glues_Battlenet_PageAssets_StandardElements_ArtBackground_Vignette"/>
                    <Color val="20,119,217"/>
                    <Alpha val="31"/>
                </Frame>
                
                <Frame type="Image" name="BadgeIcon">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-12"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="-12"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="1"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="1"/>
                    <Texture val="@UI/SC2_UI_Coop_Mutators_Badges_Rank_0"/>

                    <StateGroup name="RankStateGroup">
                        <State name="WonVyEyState">
                            <When type="AnimationState" frame="$parent/$parent/$parent" ProfileStatsState="WonVyEy"/>
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_Mutators_Badges_Rank_1"/>
                        </State>

                        <State name="WonEasyState">
                            <When type="AnimationState" frame="$parent/$parent/$parent" ProfileStatsState="WonEasy"/>
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_Mutators_Badges_Rank_2"/>
                        </State>

                        <State name="WonMediState">
                            <When type="AnimationState" frame="$parent/$parent/$parent" ProfileStatsState="WonMedi"/>
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_Mutators_Badges_Rank_3"/>
                        </State>

                        <State name="WonMdHdState">
                            <When type="AnimationState" frame="$parent/$parent/$parent" ProfileStatsState="WonMdHd"/>
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_Mutators_Badges_Rank_4"/>
                        </State>

                        <State name="QuestionState">
                            <When type="AnimationState" frame="$parent/$parent/$parent" ProfileStatsState="Question"/>
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_CommanderIcon_Bubble_Random"/>
                        </State>
                        
                        <State name="DefaultState">
                            <Action type="SetProperty" frame="$this" Texture="@UI/SC2_UI_Coop_Mutators_Badges_Rank_0"/>
                        </State>
                    </StateGroup>
                </Frame>
            </Frame>
            
            <Frame type="Frame" name="Loading">
                <Anchor relative="$parent/BackgroundContainer"/>
                <Visible val="False"/>
                
                <Frame type="Frame" name="IdleSpinner" template="StandardBattlenetTemplates/IdleSpinnerTemplate">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                </Frame>
            </Frame>
            
        </Frame>
        
        <Frame type="Image" name="ToggleArrow">
            <Anchor side="Top" relative="$parent/Button" pos="Max" offset="-9"/>
            <Anchor side="Left" relative="$parent/Button" pos="Mid" offset="-1"/>
            <Anchor side="Right" relative="$parent/Button" pos="Mid" offset="-1"/>
            <Texture val="@UI/Glues_BlueButtons_Arrow_Down"/>
            <Visible val="False"/>
        </Frame>

        <Frame type="Button" name="Button" template="StandardSmallButtonTemplates/StandardSmallBaseButtonTemplate">
            <Text val="@CMUI/MutatorInfo/Button"/>
            <Toggleable val="true"/>
            <Visible val="False"/>
            <Enabled val="False"/>
            
            <Frame type="Frame" name="AnchorFrame">
                <Anchor side="Bottom" relative="$parent/$parent/InfoContainer/BackgroundContainer" pos="Min" offset="-10"/>
                <Anchor side="Right" relative="$parent/$parent/InfoContainer/BackgroundContainer" pos="Max" offset="-4"/>
                <Width val="192"/>
                <Height val="38"/>
            </Frame>
            
            <Frame type="Label" name="Label">
                <Anchor side="Top" relative="$parent/AnchorFrame" pos="Mid" offset="1"/>
                <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Mid" offset="1"/>
                <Anchor side="Left" relative="$parent/AnchorFrame" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent/AnchorFrame" pos="Mid" offset="0"/>
            
                <StateGroup name="StyleState">
                    <DefaultState val="Normal"/>
                    
                    <State name="Disabled">
                        <When type="StateGroup" frame="$parent" DisabledState="Disabled"/>
                        <Action type="SetProperty" frame="$this" Style="StandardSmallButtonExtended_Disabled"/>
                    </State>
                
                    <State name="Pressed">
                        <When type="StateGroup" frame="$parent" PressedState="Pressed"/>
                        <Action type="SetProperty" frame="$this" Style="StandardSmallButtonExtended_Pressed"/>
                    </State>
                
                    <State name="Selected">
                        <When type="StateGroup" frame="$parent" ToggledState="Toggled"/>
                        <Action type="SetProperty" frame="$this" Style="StandardSmallButtonExtended_Pressed"/>
                    </State>
                    
                    <State name="Hover">
                        <When type="StateGroup" frame="$parent" HoveredState="Hovered"/>
                        <Action type="SetProperty" frame="$this" Style="StandardSmallButtonExtended_Hovered"/>
                    </State>

                    <State name="Normal">
                        <Action type="SetProperty" frame="$this" Style="StandardSmallButtonExtended_Normal"/>
                    </State>
                </StateGroup>
            </Frame>

            <StateGroup name="MutatorButtonStateGroup">
                <State name="InactiveState">
                    <When type="AnimationState" frame="$parent" InfoPanelState="Inactive"/>
                    <Action type="SetProperty" frame="$this" Enabled="false"/>
                </State>
                
                <State name="DefaultState">
                    <Action type="SetProperty" frame="$this" Enabled="false"/>
                </State>
            </StateGroup>
                
            <StateGroup name="PressedState">
                <DefaultState val="Pressed"/>
                <State name="NotPressed">
                    <When type="Property" frame="$this" Pushed="False"/>
                    <When type="Property" frame="$this" Toggled="False"/>
                </State>
                <State name="Pressed">
                </State>
            </StateGroup>
        </Frame>
    </Frame>
</Desc>

