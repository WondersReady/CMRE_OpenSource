<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Constant name="SubNavigationButtonDividerOffset" val="-42"/>
    <Constant name="SubNavigationButtonOverlapOffset" val="-84"/>

    <Frame type="StandardTooltip" name="StandardBattlenetTooltipTemplate">
        <MaxWidth val="480"/>
        <Insets top="15" left="15" bottom="15" right="15"/>

        <Frame type="Image" name="BackgroundImage">
            <Anchor relative="$parent"/>
            <Texture val="@UI/StandardGameTooltip"/>
            <TextureType val="Border"/>
            <Tiled val="false"/>
        </Frame>

        <Frame type="Label" name="Label">
            <Style val="StoryModeTooltip"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="15"/>
            <Width val="450"/>
        </Frame>

        <StateGroup name="TooltipContentState">
            <DefaultState val="Default"/>
            <State name="Empty">
                <When type="Property" frame="Label" Text="" Index="0"/>
                <Action type="SetProperty" frame="BackgroundImage" Alpha="0"/>
            </State>
            <State name="Default">
                <Action type="SetProperty" frame="BackgroundImage" Alpha="255"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="Button" name="SubNavigationButtonTemplate" template="StandardBattlenetTemplates/BattlenetSubNavButtonTemplate">
        <Toggleable val="true"/>
    </Frame>
</Desc>
