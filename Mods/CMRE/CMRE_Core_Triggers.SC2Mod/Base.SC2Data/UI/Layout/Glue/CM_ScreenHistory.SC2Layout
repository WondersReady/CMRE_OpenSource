    <Frame type="Button" name="HistoryListItemTemplate">
        <Height val="39"/>
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <Toggleable val="true"/>
        <Toggled val="false"/>
        <AcceptsMouse val="true"/>
        <CollapseLayout val="true"/>
        <ClickSound val="@UI_ActionButtonSelect"/>

        <StateGroup name="DisplayState">
            <DefaultState val="Normal"/>

            <State name="Normal">
                <Action type="SetProperty" frame="SelectedImage" Visible="False"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Base"/>
            </State>

            <State name="NormalVictory">
                <Action type="SetProperty" frame="SelectedImage" Visible="False"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Win"/>
            </State>

            <State name="NormalDefeat">
                <Action type="SetProperty" frame="SelectedImage" Visible="False"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Loss"/>
            </State>

            <State name="NormalDraw">
                <Action type="SetProperty" frame="SelectedImage" Visible="False"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Base"/>
            </State>

            <State name="Selected">
                <Action type="SetProperty" frame="SelectedImage" Visible="True"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Base"/>
            </State>

            <State name="SelectedVictory">
                <Action type="SetProperty" frame="SelectedImage" Visible="True"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Win"/>
            </State>

            <State name="SelectedDefeat">
                <Action type="SetProperty" frame="SelectedImage" Visible="True"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Loss"/>
            </State>

            <State name="SelectedDraw">
                <Action type="SetProperty" frame="SelectedImage" Visible="True"/>
                <Action type="SetProperty" frame="ResultLabel" Style="Profile_MatchHistory_ListItem_Base"/>
            </State>
        </StateGroup>

        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
