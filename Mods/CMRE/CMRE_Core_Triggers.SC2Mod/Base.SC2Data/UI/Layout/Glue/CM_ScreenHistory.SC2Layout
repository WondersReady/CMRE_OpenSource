                <Anchor side="Right" relative="$parent" pos="Mid" offset="360"/>
                <Texture val="@UI/SC2_UI_Battlenet_Glue_Arcade_MainContainer"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Label" name="TitleLabel">
                <Anchor side="Top" relative="$parent/PopupBackground" pos="Min" offset="24"/>
                <Anchor side="Left" relative="$parent/PopupBackground" pos="Min" offset="32"/>
                <Anchor side="Right" relative="$parent/PopupBackground" pos="Max" offset="-32"/>
                <Height val="38"/>
                <Style val="@Arcade_Subtitle"/>
                <Text val="@CMUI/ScreenHistory/SaveRecordTemplate/Title"/>
            </Frame>

            <Frame type="Label" name="DescriptionLabel">
                <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="8"/>
                <Anchor side="Left" relative="$parent/PopupBackground" pos="Min" offset="32"/>
                <Anchor side="Right" relative="$parent/PopupBackground" pos="Max" offset="-32"/>
                <Height val="52"/>
                <Style val="StoryModeTooltip"/>
                <Text val="@CMUI/ScreenHistory/SaveRecordTemplate/Description"/>
            </Frame>

            <Frame type="EditBox" name="TemplateNameEditBox" template="StandardSmallButtonTemplates/StandardSmallEditBoxTemplate">
                <Handle val="CM_HistorySaveRecordTemplateNameEditBox"/>
                <Frame type="Frame" name="AnchorFrame">
                    <Anchor side="Top" relative="$parent/$parent/DescriptionLabel" pos="Max" offset="14"/>
                    <Anchor side="Left" relative="$parent/$parent/PopupBackground" pos="Min" offset="32"/>
                    <Anchor side="Right" relative="$parent/$parent/PopupBackground" pos="Max" offset="-32"/>
                    <Height val="54"/>
                </Frame>
                <Text val="@CMUI/ScreenHistory/SaveRecordTemplate/NamePlaceholder"/>
            </Frame>

            <Frame type="Label" name="StatusLabel">
                <Handle val="CM_HistorySaveRecordTemplateStatusLabel"/>
                <Anchor side="Top" relative="$parent/TemplateNameEditBox" pos="Max" offset="10"/>
                <Anchor side="Left" relative="$parent/TemplateNameEditBox" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/TemplateNameEditBox" pos="Max" offset="0"/>
                <Height val="44"/>
                <Style val="StoryModeTooltip"/>
                <Text val="@CMUI/ScreenHistory/SaveRecordTemplate/StatusIdle"/>
            </Frame>

            <Frame type="Button" name="AcceptButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                <Handle val="CM_HistorySaveRecordTemplateAcceptButton"/>
                <Anchor side="Bottom" relative="$parent/PopupBackground" pos="Max" offset="-24"/>
                <Anchor side="Right" relative="$parent/PopupBackground" pos="Max" offset="-32"/>
                <Width val="180"/>
                <Height val="54"/>
                <Text val="@CMUI/ScreenHistory/SaveRecordTemplate/Save"/>
            </Frame>

            <Frame type="Button" name="CancelButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                <Handle val="CM_HistorySaveRecordTemplateCancelButton"/>
                <Anchor side="Top" relative="$parent/AcceptButton" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
                <Width val="180"/>
                <Height val="54"/>
                <Text val="@CMUI/ScreenHistory/NewProfile/Cancel"/>
            </Frame>
        </Frame>
    </Frame>
</Desc>
