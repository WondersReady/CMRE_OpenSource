        </Frame>

        <!-- <Frame type="CommanderMasteryTalentFrame" name="TalentFrame0" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate"> -->
        <Frame type="Frame" name="TalentFrame0" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate">
            <Anchor side="Top" relative="$parent/ListHeader0" pos="Max" offset="5"/>
            <Anchor side="Left" relative="$parent/ListBackground0" pos="Min" offset="5"/>
            <Anchor side="Right" relative="$parent/ListBackground0" pos="Max" offset="-5"/>
        </Frame>

        <!-- <Frame type="CommanderMasteryTalentFrame" name="TalentFrame1" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate"> -->
        <Frame type="Frame" name="TalentFrame1" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate">
            <Anchor side="Top" relative="$parent/TalentFrame0" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent/ListBackground0" pos="Min" offset="5"/>
