        <!-- <Frame type="CommanderMasteryTalentFrame" name="TalentFrame2" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate"> -->
        <Frame type="Frame" name="TalentFrame2" template="CM_CommanderMasterySelectionPanel/CommanderMasteryTalentFrameTemplate">
