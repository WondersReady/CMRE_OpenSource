<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    
    <!-- 
    
    Commander Info Container
    
    -->
    
    <Frame type="Frame" name="CommanderInfoContainerTemplate">
        <Handle val="CM_CommanderInfoContainer"/>
        <Anchor side="Right" relative="NameLabel" pos="Max" offset="420"/>
        <Height val="162"/>

        <Frame type="Label" name="NameLabel">
            <!-- <Handle val="CM_CommanderInfoCommanderNameLabel"/> -->
            <Anchor side="Top" relative="$parent" pos="Min" offset="40"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="112"/>
            <Style val="@Coop_CommanderTitle"/>
            <Text val=""/>
        </Frame>

        <Frame type="Label" name="PrestigeLabel">
            <!-- <Handle val="CM_CommanderInfoPrestigeLabel"/> -->
            <Anchor side="Bottom" relative="$parent/NameLabel" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/NameLabel" pos="Max" offset="16"/>
            <Style val="@BattlenetTitle"/>
            <Text val=""/>
            <Options val="NoWrapping | Ellipsis"/>
        </Frame>

        <Frame type="Label" name="AllianceNameLabel">
            <!-- <Handle val="CM_CommanderInfoAllianceCommanderNameLabel"/> -->
            <Anchor side="Top" relative="$parent/NameLabel" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/NameLabel" pos="Min" offset="0"/>
            <Style val="@Coop_CommanderTitle"/>
            <Text val=""/>
            <Visible val="False"/>
        </Frame>

        <Frame type="Label" name="AlliancePrestigeLabel">
            <!-- <Handle val="CM_CommanderInfoAlliancePrestigeLabel"/> -->
            <Anchor side="Bottom" relative="$parent/AllianceNameLabel" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/AllianceNameLabel" pos="Max" offset="16"/>
            <Style val="@BattlenetTitle"/>
            <Text val="@CMUI/ScreenCoopCampaign/StatusUnset"/>
            <Visible val="False"/>
            <Options val="NoWrapping | Ellipsis"/>
        </Frame>

        <!-- TODO: Whatever you want to display race with these animation events -->
        <Frame type="Frame" name="RacePanel">
            <Anchor relative="$parent"/>

            <Animation name="Race">
                <Event event="Terr" action="Reset" frame="$parent"/>
                <Event event="Zerg" action="Reset" frame="$parent"/>
                <Event event="Prot" action="Reset" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="true"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Frame" name="AbilHitArea" template="StandardTemplates/HoverableFrameTemplate">
            <Anchor relative="$parent/NameLabel"/>
        </Frame>

        <StateGroup name="IdentityDisplayState">
            <DefaultState val="Commander"/>

            <State name="Alliance">
                <When type="Property" frame="$ancestor[@name=CommanderSelectionPanel]/AllianceStatePanel/Button" Toggled="True"/>
                <Action type="SetProperty" frame="NameLabel" Visible="False"/>
                <Action type="SetProperty" frame="PrestigeLabel" Visible="False"/>
                <Action type="SetProperty" frame="AllianceNameLabel" Visible="True"/>
                <Action type="SetProperty" frame="AlliancePrestigeLabel" Visible="True"/>
                <Action type="SetProperty" frame="AbilHitArea" Visible="False"/>
            </State>

            <State name="Commander">
                <Action type="SetProperty" frame="NameLabel" Visible="True"/>
                <Action type="SetProperty" frame="PrestigeLabel" Visible="True"/>
                <Action type="SetProperty" frame="AllianceNameLabel" Visible="False"/>
                <Action type="SetProperty" frame="AlliancePrestigeLabel" Visible="False"/>
                <Action type="SetProperty" frame="AbilHitArea" Visible="True"/>
            </State>
        </StateGroup>
    </Frame>
</Desc>
