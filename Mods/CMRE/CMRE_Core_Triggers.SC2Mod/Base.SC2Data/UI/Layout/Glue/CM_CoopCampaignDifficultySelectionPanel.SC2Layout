<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Constant name="DifficultyListItemVerticalGap" val="-4"/>

    <Frame type="Image" name="ScrollBarBackgroundImage">
        <Texture val="Assets/Textures/UI_Battlenet_Glue_ChatPanelScrollBarLine.dds"/>
        <TextureType val="Nineslice"/>
        <Tiled val="true"/>
        <Alpha val="0"/>
        <DescFlags val="Internal"/>
    </Frame>

    <Frame type="Button" name="ScrollBarButtonTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <DescFlags val="Internal"/>

        <Frame type="Image" name="NormalImage">
            <Texture val="@UI/ChatPanelScrollBarGrabber_Normal"/>
            <TextureType val="Nineslice"/>
            <Tiled val="true"/>
            <DescFlags val="Internal"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Texture val="@UI/ChatPanelScrollBarGrabber_Hover"/>
            <TextureType val="Nineslice"/>
            <Tiled val="true"/>
            <DescFlags val="Internal"/>
        </Frame>
    </Frame>

    <Frame type="ScrollBar" name="TileListScrollBarTemplate">
        <Image val="$root/CM_CoopCampaignDifficultySelectionPanel/ScrollBarBackgroundImage"/>
        <Button val="$root/CM_CoopCampaignDifficultySelectionPanel/ScrollBarButtonTemplate"/>
        <Orientation val="Vertical"/>
        <Width val="16"/>
        <CollapseLayout val="true"/>
    </Frame>

    <!-- <Frame type="CommanderDifficultyTileListItem" name="CommanderDifficultyTileListItemTemplate"> -->
    <Frame type="Button" name="CommanderDifficultyTileListItemTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <!-- Button selected state is driven by Toggled animations below. -->
        <!-- <SelectedImage val="SelectedImage"/> -->
        <Height val="52"/>
		<ClickSound val="@AC_UI_MapSelect"/>
        
        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Normal"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Hover"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="SelectedImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ListItem_Selected"/>
            <TextureType val="NineSlice"/>
            <Visible val="false"/>

            <Animation name="ToggledSelectedImage">
                <Event event="Toggled" action="Reset" frame="$parent"/>
                <Event event="Toggled" action="Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="true"/>
                </Controller>
            </Animation>

            <Animation name="NormalSelectedImage">
                <Event event="Normal" action="Reset" frame="$parent"/>
                <Event event="Normal" action="Play" frame="$parent"/>
                <Event event="Disabled" action="Reset" frame="$parent"/>
                <Event event="Disabled" action="Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="false"/>
                </Controller>
            </Animation>
        </Frame>

        <!-- The difficulty icon is not currently used -->
        <Frame type="Image" name="Icon">
            <Anchor relative="$parent"/>
            <Visible val="false"/>
        </Frame>

        <Frame type="Label" name="NameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Text val="@CMUI/ScreenCoopCampaign/Difficulty/NameLabelShort"/>
            <Style val="BattlenetListItem"/>
            
            <Animation name="SelectedFontStyle">
                <Event event="OnShown" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnShown" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="BattlenetListItem" style2="BattlenetListItemSelected">
                    <Key type="Curve" time="0" value="1"/>
                </Controller>
            </Animation>
            
            <Animation name="NormalFontStyle">
                <Event event="OnHidden" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnHidden" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="BattlenetListItem" style2="BattlenetListItemSelected">
                    <Key type="Curve" time="0" value="0"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Label" name="BonusLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5000"/>
            <Anchor side="Left" relative="$parent/DescriptionLabel" pos="Max" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-10"/>
            <Style val="DifficultySelectionBonusNumber"/>
            
            <Animation name="SelectedFontStyle">
                <Event event="OnShown" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnShown" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="DifficultySelectionBonusNumber" style2="DifficultySelectionBonusNumberSelected">
                    <Key type="Curve" time="0" value="1"/>
                </Controller>
            </Animation>
            
            <Animation name="NormalFontStyle">
                <Event event="OnHidden" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnHidden" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="DifficultySelectionBonusNumber" style2="DifficultySelectionBonusNumberSelected">
                    <Key type="Curve" time="0" value="0"/>
                </Controller>
            </Animation>
            
            <Animation name="DisabledFontStyle">
                <Event event="OnDisabled" action="Reset" frame="$parent"/>
                <Event event="OnDisabled" action="Play" frame="$parent"/>
                
                <Controller type="Fade" end="Pause">
                    <Key type="Curve" time="0" value="77" out="Linear"/>
                </Controller>
            </Animation>
            
            <Animation name="EnabledFontStyle">
                <Event event="OnEnabled" action="Reset" frame="$parent"/>
                <Event event="OnEnabled" action="Play" frame="$parent"/>
                
                <Controller type="Fade" end="Pause">
                    <Key type="Curve" time="0" value="255" out="Linear"/>
                </Controller>
            </Animation>
        </Frame>
        
        <Frame type="Label" name="DescriptionLabel">
            <Anchor side="Top" relative="$parent/NameLabel" pos="Max" offset="5"/>
            <Anchor side="Left" relative="$parent/NameLabel" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-180"/>
            <Style val="DifficultySelectionButtonSubText"/>
            
            <Animation name="SelectedFontStyle">
                <Event event="OnShown" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnShown" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="DifficultySelectionButtonSubText" style2="DifficultySelectionButtonSubTextSelected">
                    <Key type="Curve" time="0" value="1"/>
                </Controller>
            </Animation>
            
            <Animation name="NormalFontStyle">
                <Event event="OnHidden" action="Reset" frame="$parent/SelectedImage"/>
                <Event event="OnHidden" action="Play" frame="$parent/SelectedImage"/>
                
                <Controller type="Style" end="Pause" style1="DifficultySelectionButtonSubText" style2="DifficultySelectionButtonSubTextSelected">
                    <Key type="Curve" time="0" value="0"/>
                </Controller>
            </Animation>
            
            <Animation name="DisabledFontStyle">
                <Event event="OnDisabled" action="Reset" frame="$parent"/>
                <Event event="OnDisabled" action="Play" frame="$parent"/>
                
                <Controller type="Fade" end="Pause">
                    <Key type="Curve" time="0" value="77" out="Linear"/>
                </Controller>
            </Animation>
            
            <Animation name="EnabledFontStyle">
                <Event event="OnEnabled" action="Reset" frame="$parent"/>
                <Event event="OnEnabled" action="Play" frame="$parent"/>
                
                <Controller type="Fade" end="Pause">
                    <Key type="Curve" time="0" value="255" out="Linear"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Label" name="LockedLabel">
            <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="5"/>
            <Anchor side="Left" relative="$parent/DescriptionLabel" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-180"/>
            <Style val="DifficultySelectionLockedText"/>
            <CollapseLayout val="true"/>
            <Visible val="true"/>

            <!--
            <Animation name="LockState">
                <Event event="Unlocked" action="Reset" frame="$parent"/>
                <Event event="Unlocked" action="Stop" frame="$parent"/>
                <Event event="Locked" action="Reset" frame="$parent"/>
                <Event event="Locked" action="Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="true"/>
                </Controller>
            </Animation>
            -->
        </Frame>
            
        <!-- <StateGroup name="SetPreviewData">
            <DefaultState val="NoData"/>

            <State name="RandomCommanderSelected">
                <When type="Property" frame="$this" Selected="True"/>
                <Action type="SetProperty" frame="$parent/$parent/MapDescriptionLabel" Text="{$this/BonusLabel/@Text}" on="Enter"/>
            </State>
            
            <State name="NoData">
            </State>
        </StateGroup> -->
        
        <Frame type="Image" name="ModeWarningIcon">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
            <Width val="35"/>
            <Height val="31"/>
            <CollapseLayout val="True"/>
            <AcceptsMouseTooltip val="True"/>
            <Tooltip val="@CommanderDifficultyLevel/Description/InvalidMode"/>
            <TooltipFrame val="BattleNetTooltip"/>
            <Texture val="@UI/Glues_Icons_Warning_Small"/>
            <Visible val="False"/>

            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
        </Frame>
        
        <Frame type="Image" name="PartyIcon">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/ModeWarningIcon" pos="Min" offset="-6"/>
            <Width val="20"/>
            <Height val="24"/>
            <AcceptsMouseTooltip val="True"/>
            <Tooltip val="@CommanderDifficultyLevel/Description/RequiresParty"/>
            <TooltipFrame val="BattleNetTooltip"/>
            <!-- <Texture val="@UI/SC2_UI_Coop_DifficultySelection_RequiresParty"/> -->
            <Texture val="@UI/Glues_Icons_NumPlayers"/>
            <Color val="80,170,220"/>
            <!-- <Color val="240,120,255"/> -->
            <Visible val="False"/>

            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="DifficultyContainerTemplate">
        <Anchor relative="$parent"/>
        <Visible val="false"/>
        <Batch val="False"/>
        
        <!-- <Animation name="Show"> -->
            <!-- <Event event="OnHidden" action="Reset,Stop" frame="$parent"/> -->
            <!-- <Event event="OnClick" action="Reset,Play" frame="$parent/MapButton"/> -->
            <!-- <Event event="OnClick" action="DirectionReverse,Play" frame="AcceptButton"/> -->
            <!-- <Event event="OnClick" action="DirectionReverse,Play" frame="CloseButton"/> -->
            <!-- <Event event="OnDisabled" action="Reset,Stop" frame="$parent/MapButton"/> -->
            <!-- <Event event="UISlideOut" action="Reset,Stop" frame="$parent/$parent"/> -->

            <!-- <Controller type="Fade" end="Pause"> -->
                <!-- <Key type="Curve" time="0" value="0" out="Slow"/> -->
                <!-- <Key type="Curve" time=".175" value="255" in="Auto"/> -->
            <!-- </Controller> -->

            <!-- <Controller type="Visibility" end="Pause"> -->
                <!-- <Key type="Bool" time="0" value="false"/> -->
                <!-- <Key type="Bool" time=".001" value="true"/> -->
                <!-- <Key type="Bool" time=".175" value="true"/> -->
            <!-- </Controller> -->
        <!-- </Animation> -->
        
        <!-- This tooltip is just for blocking tooltips behind this panel -->
        <Frame type="StandardTooltip" name="CoopCampaignTooltip">
            <Frame type="Label" name="Label">
                <Anchor relative="$parent"/>
            </Frame>
        </Frame>

        <Frame type="Image" name="FullscreenBlackoutImage">
            <Anchor relative="$parent"/>
            <Color val="0,0,0"/>
            <Alpha val="180"/>
            <AcceptsMouse val="true"/>
            <TooltipFrame val="CoopCampaignTooltip"/>
        </Frame>

        <Frame type="Image" name="LeftBGGlowPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Min" offset="40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
        </Frame>
    
        <Frame type="Image" name="RightBGGlowPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
            <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
        </Frame>

        <Frame type="Image" name="BackgroundImage">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
            <TextureType val="NineSlice"/>
            <Tiled val="false"/>
            <Width val="1000"/>
            <Height val="900"/>
        </Frame>
    
        <Frame type="Image" name="TopHexPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
        </Frame>
    
        <Frame type="Image" name="BottomHexPattern">
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
            <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
        </Frame>

        <Frame type="Label" name="TitleLabel">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="50"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
            <Style val="@BattlenetDialogTitle"/>
            <Text val="@CMUI/ScreenCoopCampaign/Difficulty/Title"/>
        </Frame>

        <Frame type="Label" name="DescriptionLabel">
            <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="10"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
            <Style val="@Coop_SelectMissionDescription"/>
            <Text val="@CMUI/ScreenCoopCampaign/Difficulty/Description"/>
        </Frame>
    
        <Frame type="Image" name="BaseTileListBg">
            <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
            <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
            <Width val="230"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Image" name="BaseTileListHeaderBg">
            <Anchor side="Top" relative="$parent/BaseTileListBg" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/BaseTileListBg" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/BaseTileListBg" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerHeader"/>
            <TextureType val="NineSlice"/>
            <Height val="40"/>
        </Frame>

        <Frame type="Label" name="BaseDifficultyTileListHeader">
            <Anchor side="Top" relative="$parent/BaseTileListHeaderBg" pos="Min" offset="3"/>
            <Anchor side="Left" relative="$parent/BaseTileListHeaderBg" pos="Min" offset="25"/>
            <Anchor side="Bottom" relative="$parent/BaseTileListHeaderBg" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/BaseTileListHeaderBg" pos="Max" offset="-10"/>
            <Text val="@CMUI/ScreenCoopCampaign/Difficulty/BaseHeader"/>
            <Style val="BattlenetListHeader"/>
        </Frame>

        <Frame type="Frame" name="BaseDifficultyTileList">
            <Anchor side="Top" relative="$parent/BaseTileListHeaderBg" pos="Max" offset="3"/>
            <Anchor side="Left" relative="$parent/BaseTileListBg" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent/BaseTileListBg" pos="Max" offset="-5"/>
            <Anchor side="Right" relative="$parent/BaseTileListBg" pos="Max" offset="-5"/>
            <AcceptsMouse val="true"/>

            <Frame type="Frame" name="ContainerFrame">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Bottom" relative="$this/Item5" pos="Max" offset="0"/>

                <Frame type="Button" name="Item0" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <Frame type="Button" name="Item1" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item0" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <Frame type="Button" name="Item2" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item1" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item1" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <Frame type="Button" name="Item3" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item2" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item2" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <Frame type="Button" name="Item4" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item3" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item3" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <Frame type="Button" name="Item5" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item4" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item4" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>
            </Frame>
        </Frame>

        <Frame type="Image" name="TileListBg">
            <Anchor side="Top" relative="$parent/DescriptionLabel" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent/BaseTileListBg" pos="Max" offset="10"/>
            <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Min" offset="-10"/>
            <Anchor side="Right" relative="$parent/DescriptionBg" pos="Min" offset="-10"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
            <TextureType val="NineSlice"/>
        </Frame>
    
        <Frame type="Image" name="TileListHeaderBg">
            <Anchor side="Top" relative="$parent/TileListBg" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/TileListBg" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/TileListBg" pos="Max" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerHeader"/>
            <TextureType val="NineSlice"/>
            <Height val="40"/>
        </Frame>
    
        <Frame type="Label" name="DifficultyTileListHeader">
            <Anchor side="Top" relative="$parent/TileListHeaderBg" pos="Min" offset="3"/>
            <Anchor side="Left" relative="$parent/TileListHeaderBg" pos="Min" offset="25"/>
            <Anchor side="Bottom" relative="$parent/TileListHeaderBg" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/TileListHeaderBg" pos="Max" offset="-10"/>
            <Text val="@CMUI/ScreenCoopCampaign/Difficulty/PlusHeader"/>
            <Style val="BattlenetListHeader"/>
        </Frame>

        <!-- <Frame type="CommanderDifficultyTileList" name="DifficultyTileList"> -->
        <Frame type="ScrollableFrame" name="DifficultyTileList">
            <Handle val="CM_DifficultyTileList"/>
            <Anchor side="Top" relative="$parent/TileListHeaderBg" pos="Max" offset="3"/>
            <Anchor side="Left" relative="$parent/TileListBg" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent/TileListBg" pos="Max" offset="-5"/>
            <Anchor side="Right" relative="$parent/TileListBg" pos="Max" offset="-5"/>
            <!-- TileList-only: <ClearSelectionIfNotVisible val="true"/> -->
            <AcceptsMouse val="true"/>

            <Frame type="Frame" name="ContainerFrame">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/ScrollBar" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$this/Item15" pos="Max" offset="0"/>

                <!-- <Frame type="CommanderDifficultyTileListItem" name="Item0" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate"> -->
                <Frame type="Button" name="Item0" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <!-- <Frame type="CommanderDifficultyTileListItem" name="Item1" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate"> -->
                <Frame type="Button" name="Item1" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item0" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <!-- <Frame type="CommanderDifficultyTileListItem" name="Item2" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate"> -->
                <Frame type="Button" name="Item2" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item1" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item1" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <!-- <Frame type="CommanderDifficultyTileListItem" name="Item3" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate"> -->
                <Frame type="Button" name="Item3" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item2" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item2" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                </Frame>

                <!-- <Frame type="CommanderDifficultyTileListItem" name="Item4" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate"> -->
                <Frame type="Button" name="Item4" template="CM_CoopCampaignDifficultySelectionPanel/CommanderDifficultyTileListItemTemplate">
                    <Anchor side="Top" relative="$parent/Item3" pos="Max" offset="#DifficultyListItemVerticalGap"/>
                    <Anchor side="Left" relative="$parent/Item3" pos="Min" offset="0"/>
