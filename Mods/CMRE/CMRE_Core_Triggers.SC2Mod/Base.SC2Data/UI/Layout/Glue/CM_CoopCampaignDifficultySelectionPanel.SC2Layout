            <Height val="184"/>
            <TextureType val="Normal"/>
            <CollapseLayout val="true"/>
            <Texture val="@UI/SC2_UI_Coop_DifficultySelection_Meter"/>
            <Alpha val="255"/>
            <Visible val="True"/>
