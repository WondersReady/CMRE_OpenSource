<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    
    <!-- 
    ========================
    HEADER PRIMARY PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="HeaderPrimaryPanelTemplate">
        <Anchor side="Top" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
    </Frame>
    
    <!-- 
    ========================
    HEADER SECONDARY PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="HeaderSecondaryPanelTemplate">
        <Anchor side="Top" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
        <Anchor side="Left" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
    </Frame>

    <!--
    ========================
    HEADER PERSONALIZATION PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="HeaderPersonalizationPanelTemplate">
        <Anchor side="Top" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
        <Anchor side="Left" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
    </Frame>
    
    <!-- 
    ========================
    PRIMARY PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="PrimaryPanelTemplate">
        <Anchor side="Top" relative="$parent/DividerLeft" pos="Max" offset="0"/>
        <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent/DividerBottom" pos="Min" offset="0"/>
    </Frame>
    
    <!-- 
    ========================
    SECONDARY PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="SecondaryPanelTemplate">
        <Anchor side="Top" relative="$parent/DividerRight" pos="Max" offset="0"/>
        <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent/DividerBottom" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$parent/DividerPersonalizationBottom" pos="Min" offset="0"/>
    </Frame>

    <!--
    ========================
    PERSONALIZATION PANEL TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="PersonalizationPanelTemplate">
        <Anchor side="Top" relative="$parent/DividerPersonalizationRight" pos="Max" offset="0"/>
        <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent/DividerPersonalizationBottom" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
    </Frame>

    <!--
    ========================
    THREE PANEL CONTENT CONTAINER TEMPLATE
    ========================
    -->
    <Frame type="Frame" name="BattlenetThreePanelContentContainerTemplate">
        <Anchor side="Top" relative="$Anchor_StandardContentContainer_Top" pos="Max" offset="0"/>
        <Anchor side="Bottom" relative="$Anchor_StandardContentContainer_Bottom" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$Anchor_StandardContentContainer_Left" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$Anchor_StandardContentContainer_Right" pos="Max" offset="0"/>

        <Frame type="BlurFrame" name="BackgroundBlur">
            <Anchor relative="$parent/Background"/>
            <BlurAmount val="0.35"/>
            <Alpha val="255"/>
        </Frame>

        <Frame type="Frame" name="AnchorFrame">
            <Anchor side="Top" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-8"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
        </Frame>

        <Frame type="Image" name="Shadow">
            <Anchor relative="$parent"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_Border_Glow"/>
            <TextureType val="NineSlice"/>
            <Color val="0,0,0"/>
            <Alpha val="128"/>
        </Frame>

        <Frame type="Image" name="Background">
            <Anchor side="Top" relative="$parent" pos="Min" offset="4"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-4"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="4"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-4"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_Mask"/>
            <TextureType val="NineSlice"/>
            <Color val="9,12,21"/>
            <Alpha val="153"/>
        </Frame>

        <Frame type="Image" name="HeaderHighlight">
            <Anchor side="Top" relative="$parent/Background" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/Background" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/Background" pos="Max" offset="0"/>
            <LayerCount val="2"/>

            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_Mask" layer="0"/>
            <TextureType val="NineSlice" layer="0"/>
            <AlphaLayer val="True" layer="0"/>

            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_InnerHighlight" layer="1"/>
            <LayerColor val="46,112,168" layer="1"/>
            <LayerAlpha val="64" layer="1"/>
        </Frame>

        <Frame type="Image" name="BodyShadow">
            <Anchor side="Top" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/Background" pos="Min" offset="2"/>
            <Anchor side="Right" relative="$parent/Background" pos="Max" offset="-2"/>
            <Height val="80"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_InnerShadow"/>
            <Color val="11,14,25"/>
            <Alpha val="102"/>
        </Frame>

        <Frame type="Image" name="BorderInner">
            <Anchor relative="$parent/Background"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_Border_Inner"/>
            <TextureType val="NineSlice"/>
            <Color val="69,120,167"/>
            <Alpha val="77"/>
        </Frame>

        <Frame type="Image" name="BorderOuter">
            <Anchor relative="$parent/Background"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_StandardContainer_Border_Outer"/>
            <TextureType val="NineSlice"/>
            <Color val="0,0,0"/>
            <Alpha val="179"/>
        </Frame>

        <Frame type="Image" name="DividerAnchor" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="60"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="680"/>
            <Width val="2"/>
            <Height val="2"/>
        </Frame>

        <Frame type="Image" name="DividerPersonalizationAnchor" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="1110"/>
            <Width val="2"/>
            <Height val="2"/>
        </Frame>

        <Frame type="Image" name="DividerLeft" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerRight" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerPersonalizationRight" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerTop" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerPersonalizationTop" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/AnchorFrame" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerBottom" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerAnchor" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerAnchor" pos="Max" offset="0"/>
        </Frame>

        <Frame type="Image" name="DividerPersonalizationBottom" template="StandardBattlenetTemplates/BattlenetStandardContentContainerDividerTemplate">
            <Anchor side="Top" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/DividerPersonalizationAnchor" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent/DividerPersonalizationAnchor" pos="Max" offset="0"/>
        </Frame>
    </Frame>

    <!-- 
    ========================================================================
    COMMANDER CUSTOMIZAITION SELECTION PANEL TEMPLATE
    ========================================================================
    -->
    <Frame type="Frame" name="CommanderCustomizationSelectionPanelTemplate">
        <!-- This tooltip is just for blocking tooltips behind this panel -->
        <Frame type="StandardTooltip" name="CoopCampaignTooltip">
            <Frame type="Label" name="Label">
                <Anchor relative="$parent"/>
            </Frame>
        </Frame>

        <Frame type="Image" name="FullscreenBlackoutImage">
            <Anchor relative="$parent"/>
            <Color val="0,0,0"/>
            <Alpha val="180"/>
            <AcceptsMouse val="true"/>
            <TooltipFrame val="CoopCampaignTooltip"/>
        </Frame>
        
        <Frame type="Image" name="LeftBGGlowPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Min" offset="40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
        </Frame>
        
        <Frame type="Image" name="RightBGGlowPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
            <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
        </Frame>

        <Frame type="Image" name="BackgroundImage">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
            <TextureType val="NineSlice"/>
            <Tiled val="false"/>
            <Width val="1560"/>
            <Height val="900"/>
        </Frame>
        
        <Frame type="Image" name="TopHexPattern">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
        </Frame>
        
        <Frame type="Image" name="BottomHexPattern">
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
            <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
        </Frame>

        <Frame type="Label" name="TitleLabel">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="46"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="30"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-30"/>
            <Style val="@BattlenetDialogTitle"/>
            <Text val="{$this/FormatFrame/@Text}"/>

            <Frame type="TextFormatFrame" name="FormatFrame">
                <Anchor relative="$parent"/>
                <FormatText val="@CMUI/CommanderMasterySelectionPanel/TitleCustomization"/>
                <Replacement index="0" val=""/>
            </Frame>
        </Frame>
        
        <Frame type="Frame" name="Container" template="CM_CommanderCustomizationSelectionPanel/BattlenetThreePanelContentContainerTemplate">
            <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="90"/>
            <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-120"/>
            <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="40"/>
            <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-40"/>

            <Frame type="Frame" name="HeaderPrimaryPanel" template="CM_CommanderCustomizationSelectionPanel/HeaderPrimaryPanelTemplate">
        
                <Frame type="Label" name="MasteryTitleLabel">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Text val="@CMUI/CommanderMasterySelectionPanel/HeaderMastery"/>
                    <Style val="@Collection_BundleSelection_PageCount"/>

                    <StateGroup name="AscensionLevelStateGroup">
                        <DefaultState val="AscensionLevelState"/>
                        
                        <State name="AscensionLevelState">
                            <!-- Mastery level display is fixed to max for the custom UI. -->
                            <Action type="SetProperty" frame="$this" Text="@CMUI/CommanderMasterySelectionPanel/HeaderAscension"/>
                        </State>

                        <State name="MasteryLevelState">
                            <Action type="SetProperty" frame="$this" Text="@CMUI/CommanderMasterySelectionPanel/HeaderMastery"/>
                        </State>
                    </StateGroup>
                </Frame>

                <Frame type="Image" name="MasteryInfoIcon">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/MasteryTitleLabel" pos="Max" offset="30"/>
                    <Width val="32"/>
                    <Height val="32"/>
                    <Texture val="Assets/Textures/ui_glues_icons_infogeneric.dds"/>
                    <AcceptsMouse val="True"/>
                    <Tooltip val="@CMUI/CommanderMasterySelectionPanel/AscensionInfoTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                </Frame>
            </Frame>
            
            <Frame type="Frame" name="HeaderSecondaryPanel" template="CM_CommanderCustomizationSelectionPanel/HeaderSecondaryPanelTemplate">
        
                <Frame type="Label" name="PrestigeTitleLabel">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Text val="@CMUI/CommanderMasterySelectionPanel/HeaderPrestige"/>
                    <Style val="@Collection_BundleSelection_PageCount"/>
                </Frame>

                <Frame type="Image" name="PrestigeInfoIcon">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/PrestigeTitleLabel" pos="Max" offset="30"/>
                    <Width val="32"/>
                    <Height val="32"/>
                    <Texture val="Assets/Textures/ui_glues_icons_infogeneric.dds"/>
                    <AcceptsMouse val="True"/>
                    <Tooltip val="@CMUI/CommanderPrestigeSelectionPanel/InfoTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                </Frame>
            </Frame>

            <Frame type="Frame" name="HeaderPersonalizationPanel" template="CM_CommanderCustomizationSelectionPanel/HeaderPersonalizationPanelTemplate">

                <Frame type="Label" name="PersonalizationTitleLabel">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Text val="@CMUI/CommanderCustomizationSelectionPanel/HeaderPersonalization"/>
                    <Style val="@Collection_BundleSelection_PageCount"/>
                </Frame>

                <Frame type="Image" name="PersonalizationInfoIcon">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/PersonalizationTitleLabel" pos="Max" offset="30"/>
                    <Width val="32"/>
                    <Height val="32"/>
                    <Texture val="Assets/Textures/ui_glues_icons_infogeneric.dds"/>
                    <AcceptsMouse val="True"/>
                    <Tooltip val="@CMUI/CommanderCustomizationSelectionPanel/InfoTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                </Frame>
            </Frame>
            
            <Frame type="Frame" name="PrimaryPanel" template="CM_CommanderCustomizationSelectionPanel/PrimaryPanelTemplate">
            </Frame>
            
            <Frame type="Frame" name="SecondaryPanel" template="CM_CommanderCustomizationSelectionPanel/SecondaryPanelTemplate">
            </Frame>

            <Frame type="Frame" name="PersonalizationPanel" template="CM_CommanderCustomizationSelectionPanel/PersonalizationPanelTemplate">
            </Frame>

            <StateGroup name="CustomizationModeState">
                <DefaultState val="Self"/>

                <State name="Alliance">
                    <Action type="SetAnchor" frame="DividerAnchor" side="Left" relative="$parent/AnchorFrame" pos="Mid" offset="0"/>
                    <Action type="SetAnchor" frame="DividerPersonalizationAnchor" side="Left" relative="$parent/AnchorFrame" pos="Max" offset="0"/>
                    <Action type="SetProperty" frame="DividerPersonalizationAnchor" Visible="False"/>
                    <Action type="SetProperty" frame="DividerPersonalizationRight" Visible="False"/>
                    <Action type="SetProperty" frame="DividerPersonalizationTop" Visible="False"/>
                    <Action type="SetProperty" frame="DividerPersonalizationBottom" Visible="False"/>
                    <Action type="SetProperty" frame="HeaderPersonalizationPanel" Visible="False"/>
                    <Action type="SetProperty" frame="PersonalizationPanel" Visible="False"/>
                    <Action type="SetProperty" frame="$parent/PersonalizationSelectionPanel" Visible="False"/>
                </State>

                <State name="Self">
                    <Action type="SetAnchor" frame="DividerAnchor" side="Left" relative="$parent" pos="Min" offset="680"/>
                    <Action type="SetAnchor" frame="DividerPersonalizationAnchor" side="Left" relative="$parent" pos="Min" offset="1110"/>
                    <Action type="SetProperty" frame="DividerPersonalizationAnchor" Visible="True"/>
                    <Action type="SetProperty" frame="DividerPersonalizationRight" Visible="True"/>
                    <Action type="SetProperty" frame="DividerPersonalizationTop" Visible="True"/>
                    <Action type="SetProperty" frame="DividerPersonalizationBottom" Visible="True"/>
                    <Action type="SetProperty" frame="HeaderPersonalizationPanel" Visible="True"/>
                    <Action type="SetProperty" frame="PersonalizationPanel" Visible="True"/>
                    <Action type="SetProperty" frame="$parent/PersonalizationSelectionPanel" Visible="True"/>
                </State>
            </StateGroup>
        </Frame>

        <Animation name="SetSelfMode">
            <Event event="OpenSelf" action="Reset,Play"/>

            <Controller type="State" stateGroup="CustomizationModeState" frame="$this/Container" end="Pause">
                <Key type="Identifier" time="0" value="Self"/>
            </Controller>
        </Animation>

        <Animation name="SetAllianceMode">
            <Event event="OpenAlliance" action="Reset,Play"/>

            <Controller type="State" stateGroup="CustomizationModeState" frame="$this/Container" end="Pause">
                <Key type="Identifier" time="0" value="Alliance"/>
            </Controller>
        </Animation>
        
        <!-- MASTERY SELECTION PANEL -->
        <!-- <Frame type="CommanderMasterySelectionPanel" name="MasterySelectionPanel" template="CM_CommanderMasterySelectionPanel/CommanderMasterySelectionPanelTemplate"> -->
        <Frame type="Frame" name="MasterySelectionPanel" template="CM_CommanderMasterySelectionPanel/CommanderMasterySelectionPanelTemplate">
            <Anchor relative="$parent/Container/PrimaryPanel"/>
            <Handle val="CM_MasterySelectionPanel"/>
            <Visible val="True"/>

            <Frame type="Button" name="AcceptButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                <Anchor side="Bottom" relative="$parent/$parent/BackgroundImage" pos="Max" offset="-35"/>
                <Anchor side="Right" relative="$parent/$parent/BackgroundImage" pos="Mid" offset="-3"/>
                <Unclipped val="True"/>
                <Text val="@CMUI/StandardDialog_Ok_Control"/>
                
                <StateGroup name="EnabledState">
                    <DefaultState val="Enabled"/>
                    
                    <State name="Enabled">
                        <Action type="SetProperty" frame="$this" Enabled="True"/>
                        <Action type="SetProperty" frame="$this" Tooltip=""/>
                    </State>
                </StateGroup>
            </Frame>

            <Frame type="Button" name="CancelButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent/$parent/BackgroundImage" pos="Mid" offset="3"/>
                <Unclipped val="True"/>
                <Text val="@CMUI/StandardDialog_Cancel_Control"/>
                <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
                
                <StateGroup name="EnabledState">
                    <DefaultState val="Enabled"/>
                    
                    <State name="Enabled">
                        <Action type="SetProperty" frame="$this" Enabled="True"/>
                        <Action type="SetProperty" frame="$this" Tooltip=""/>
                    </State>
                </StateGroup>
            </Frame>
        </Frame>
        
        
        <!-- PRESTIGE SELECTION PANEL -->
        
        <!-- <Frame type="CommanderPrestigeSelectionPanel" name="CommanderPrestigePanel" template="CM_CommanderPrestigeSelectionPanel/CommanderPrestigeSelectionPanelTemplate"> -->
        <Frame type="Frame" name="CommanderPrestigePanel" template="CM_CommanderPrestigeSelectionPanel/CommanderPrestigeSelectionPanelTemplate">
            <Anchor relative="$parent/Container/SecondaryPanel"/>
            <Handle val="CM_PrestigeSelectionPanel"/>
            <!-- CommanderPrestigeSelectionPanel data fields are unavailable after restoring this restricted type to Frame. -->
            <!-- Commander data is supplied by CMUI script refresh. -->
        </Frame>

        <!-- PERSONALIZATION PANEL -->
        <Frame type="Frame" name="PersonalizationSelectionPanel" template="CM_CommanderPersonalizationSelectionPanel/CommanderPersonalizationSelectionPanelTemplate">
            <Anchor relative="$parent/Container/PersonalizationPanel"/>
            <Handle val="CM_PersonalizationSelectionPanel"/>
        </Frame>
    </Frame>
</Desc>

