                    <Action type="SetAnchor" frame="$this/ChatEditBox/LabelContainerFrame" side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Action type="SetProperty" frame="$this/ChatEditBox/Image" visible="False"/>
                    <Action type="SetProperty" frame="$this/RecipientLabel" Style="CM_InGameChatRecipient"/>
                    <Action type="SetProperty" frame="$this/ChatEditBox" Style="StandardEditBox"/>
                    <Action type="SetProperty" frame="$this/ChatEditBox/LabelContainerFrame/Label" Style="CM_InGameChatInput"/>
