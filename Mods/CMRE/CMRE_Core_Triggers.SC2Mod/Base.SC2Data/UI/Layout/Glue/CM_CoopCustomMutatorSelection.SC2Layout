                    <Action type="SetProperty" frame="$this/ChatDebugDivider" texture="@UI/ChatEmojiBorder"/>
                    <Action type="SetProperty" frame="$this/ChatDebugDivider" ColorAdjustMode="Colorize"/>
                    <Action type="SetProperty" frame="$this/ChatDebugDivider" color="255,255,255"/>
                    <Action type="SetProperty" frame="$this/EmoticonButton/DropShadowImage" visible="false"/>
                    <Action type="SetProperty" frame="$this/EmoticonButton/NormalImage" texture="@UI/ChatEmojiIcon"/>
                    <Action type="SetProperty" frame="$this/EmoticonButton/HoverImage" texture="@UI/ChatEmojiIcon"/>
                    <Action type="SetProperty" frame="$this/EmoticonButton/NormalImage" color="###ColorChatIconColor"/>
                    <Action type="SetProperty" frame="$this/EmoticonButton/HoverImage" color="###ColorChatIconColor"/>
                    <Action type="SetProperty" frame="$this/ChatDebugButton/DropShadowImage" visible="False"/>
                    <Action type="SetProperty" frame="$this/ChatDebugButton/NormalImage" texture="@@UI/CM_ChatDebugGear"/>
                    <Action type="SetProperty" frame="$this/ChatDebugButton/HoverImage" texture="@@UI/CM_ChatDebugGear"/>
                    <Action type="SetProperty" frame="$this/ChatDebugButton/NormalImage" color="###ColorChatIconColor"/>
                    <Action type="SetProperty" frame="$this/ChatDebugButton/HoverImage" color="###ColorChatIconColor"/>
                </State>

                <State name="Active">
