<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Frame type="Frame" name="CM_CustomMutatorSettingsPopupTemplate">
        <Anchor relative="$parent"/>
        <Handle val="CM_CustomMutatorSettingsPopup"/>
        <Visible val="False"/>
        <Alpha val="0"/>
        <RenderPriority val="950"/>

        <Animation name="Show">
            <Event event="Show" action="Reset,Play"/>

            <Controller type="Visibility" end="Pause">
                <Key type="Bool" time="0" value="True"/>
            </Controller>

            <Controller type="Fade" end="Pause">
                <Key type="Curve" time="0" value="0" out="Fast"/>
                <Key type="Curve" time=".12" value="255" in="Slow"/>
            </Controller>
        </Animation>

        <Animation name="Hide">
            <Event event="Hide" action="Reset,Play"/>
            <Event event="OnClick" action="Reset,Play" frame="CloseButton"/>

            <Controller type="Fade" end="Pause">
                <Key type="Curve" time="0" value="0"/>
            </Controller>

            <Controller type="Visibility" end="Pause">
                <Key type="Bool" time="0" value="False"/>
            </Controller>
        </Animation>

        <Frame type="StandardTooltip" name="CoopCampaignTooltip">
            <Frame type="Label" name="Label">
                <Anchor relative="$parent"/>
            </Frame>
        </Frame>

        <Frame type="Image" name="FullscreenBlackoutImage">
            <Anchor relative="$parent"/>
            <Color val="0,0,0"/>
            <Alpha val="180"/>
            <AcceptsMouse val="True"/>
            <TooltipFrame val="CoopCampaignTooltip"/>
        </Frame>

        <Frame type="Image" name="LeftBGGlowPattern">
            <Anchor side="Top" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/PopupBackground" pos="Min" offset="40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
        </Frame>

        <Frame type="Image" name="RightBGGlowPattern">
            <Anchor side="Top" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/PopupBackground" pos="Max" offset="-40"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_BackGlow"/>
            <TextureCoords top="0.0" left="1.0" bottom="1.0" right="0.0"/>
        </Frame>

        <Frame type="Image" name="PopupBackground">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Width val="760"/>
            <Height val="520"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
            <TextureType val="NineSlice"/>
            <Tiled val="False"/>
        </Frame>

        <Frame type="Image" name="TopHexPattern">
            <Anchor side="Top" relative="$parent/PopupBackground" pos="Min" offset="11"/>
            <Anchor side="Left" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
        </Frame>

        <Frame type="Image" name="BottomHexPattern">
            <Anchor side="Bottom" relative="$parent/PopupBackground" pos="Max" offset="-11"/>
            <Anchor side="Left" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/PopupBackground" pos="Mid" offset="0"/>
            <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
            <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
        </Frame>

        <Frame type="Label" name="TitleLabel">
            <Anchor side="Top" relative="$parent/PopupBackground" pos="Min" offset="31"/>
            <Anchor side="Left" relative="$parent/PopupBackground" pos="Min" offset="40"/>
            <Anchor side="Right" relative="$parent/PopupBackground" pos="Max" offset="-40"/>
            <Style val="@Coop_CustomMutator_MutatorSectionTitle"/>
            <Text val="@CMUI/Options"/>
        </Frame>

        <Frame type="Image" name="ContentBackground">
            <Anchor side="Top" relative="$parent/PopupBackground" pos="Min" offset="72"/>
            <Anchor side="Left" relative="$parent/PopupBackground" pos="Min" offset="40"/>
            <Anchor side="Right" relative="$parent/PopupBackground" pos="Max" offset="-40"/>
            <Anchor side="Bottom" relative="$parent/CloseButton" pos="Min" offset="-18"/>
            <Texture val="@UI/Glues_Battlenet_PageAssets_MainInnerContainer"/>
            <TextureType val="NineSlice"/>
        </Frame>

        <Frame type="Frame" name="ContentPanel">
            <Anchor side="Top" relative="$parent/ContentBackground" pos="Min" offset="16"/>
            <Anchor side="Left" relative="$parent/ContentBackground" pos="Min" offset="16"/>
            <Anchor side="Right" relative="$parent/ContentBackground" pos="Max" offset="-16"/>
            <Anchor side="Bottom" relative="$parent/ContentBackground" pos="Max" offset="-16"/>
            <Handle val="CM_CustomMutatorSettingsContentPanel"/>
        </Frame>

        <Frame type="Button" name="CloseButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
            <Anchor side="Bottom" relative="$parent/PopupBackground" pos="Max" offset="-40"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Text val="@CMUI/Close"/>
            <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
            <HoverSound val="@UI_HoverTick"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="CustomMutatorFullscreenTemplate">

            <Frame type="Frame" name="ExtendedExperienceBG" template="StandardExtendedExperienceTemplates/StandardSizeExtendedExperienceTemplate">

                <Frame type="Frame" name="AnchorFrame">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Width val="1559"/>
                    <Height val="1072"/>
                </Frame>

                <Frame type="Frame" name="BackgroundContainer">
                    <Frame type="Image" name="Corner_TopRight">
                        <Texture val="@UI/Glues_ExtendedXP_Scaleable_Background_Corner_Standard"/>
                        <TextureCoords top="0" left="1" bottom="1" right="0"/>
                    </Frame>
                </Frame>
            </Frame>

            <Frame type="Frame" name="CustomMutatorMenuContainer">
                <Handle val="CM_CustomMutatorMenuContainer"/>
                <Anchor side="Top" relative="$parent/ExtendedExperienceBG/AnchorFrame" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$this/AcceptButton" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent/ExtendedExperienceBG/AnchorFrame" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/ExtendedExperienceBG/AnchorFrame" pos="Max" offset="0"/>

                <Frame type="Label" name="Title">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="44"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Style val="@Coop_CustomMutator_Title"/>
                    <Text val="@CMUI/CustomMutators/MutatorSelection"/>
                </Frame>

                <Frame type="Label" name="Description">
                    <Anchor side="Top" relative="$parent/Title" pos="Max" offset="1"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Style val="@Coop_CustomMutator_Subtitle"/>
                    <Text val="@CMUI/CustomMutators/MutatorSelectionDescription"/>
                </Frame>

                <Frame type="Frame" name="SelectionContainer" template="CM_CoopCustomMutatorTemplates/SelectionContainerTemplate">
                    <Handle val="CM_CustomMutatorSelectionContainer"/>
                    <Anchor side="Top" relative="$parent" pos="Min" offset="128"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="65"/>
                </Frame>

                <Frame type="Frame" name="SelectedContainer" template="CM_CoopCustomMutatorTemplates/SelectedContainerTemplate">
                    <Handle val="CM_CustomMutatorSelectedContainer"/>
                    <Anchor side="Top" relative="$parent/SelectionContainer" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="-65"/>
                </Frame>

                <Frame type="Frame" name="HeaderPanel">
                    <Anchor side="Top" relative="$parent/AcceptButton" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent/SelectionContainer" pos="Min" offset="4"/>
                    <Anchor side="Bottom" relative="$parent/AcceptButton" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/AcceptButton" pos="Min" offset="-10"/>

                    <Height val="36"/>
                    <Frame type="EditBox" name="SearchEditBoxTemplate" template="StandardSmallButtonTemplates/StandardSmallSearchBoxTemplate">
                        <Tooltip val="@CMUI/MutatorSearch/SearchTooltip"/>
                        <TooltipFrame val="BattleNetTooltip"/>
                        <MaxCharacters val="80"/>

                        <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>

                        <Animation name="RequestSearch">
                            <Event event="OnEnterPressed" frame="$this" action="Reset,Play"/>
                        </Animation>

                        <Frame type="Label" name="SearchTextLabel">
                            <Text val="@CMUI/MutatorSearch/SearchText"/>
                        </Frame>

                        <Frame type="Button" name="ClearTextButton">
                            <Animation name="ClearLobbyList">
                                <Event event="OnClick" frame="$this" action="Reset,Play"/>
                            </Animation>
                        </Frame>

                        <Frame type="Frame" name="AnchorFrame">
                            <Anchor side="Top" relative="$parent/$parent" pos="Mid" offset="0"/>
                            <Anchor side="Bottom" relative="$parent/$parent" pos="Mid" offset="0"/>
                            <Anchor side="Left" relative="$parent/$parent" pos="Min" offset="0"/>
                            <Anchor side="Right" relative="$parent/$parent" pos="Max" offset="0"/>
                        </Frame>

                        <!-- Doing the edit box animation this way because apparently you lose focus on the edit box otherwise -->
                        <Animation name="ListEmptyFilterPrep">
                            <Event event="EmptyFilter" action="DirectionForward,Play" frame="$parent"/>
                            <Event event="NotEmpty" action="DirectionForward,Play" frame="$parent"/>
                            <Event event="Empty" action="DirectionReverse,Play" frame="$parent"/>
                            <Event event="Loading" action="DirectionReverse,Play" frame="$parent"/>

                            <Controller type="Visibility" end="Pause">
                                <Key type="Bool" time="0.00" value="False"/>
                                <Key type="Bool" time="0.01" value="True"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>

                <Frame type="Button" name="AcceptButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                    <Anchor side="Top" relative="$parent/CancelButton" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/CancelButton" pos="Min" offset="-6"/>
                    <Style val="@StandardButtonAlternate"/>
                    <Text val="@CMUI/StandardDialog_Ok_Control"/>
                </Frame>

                <Frame type="Button" name="CancelButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                    <Anchor side="Top" relative="$parent/SelectionContainer" pos="Max" offset="7"/>
                    <Anchor side="Right" relative="$parent/SelectedContainer" pos="Max" offset="-4"/>
                    <Text val="@CMUI/StandardDialog_Cancel_Control"/>
                    <Shortcut val="@UI/ScreenNavigationBack_Hotkey"/>
                </Frame>

            </Frame>

            <Frame type="Frame" name="CustomMutatorChatContainer">
                <Anchor side="Top" relative="$parent/CustomMutatorMenuContainer" pos="Max" offset="9"/>
                <Anchor side="Left" relative="$parent/CustomMutatorMenuContainer" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/CustomMutatorMenuContainer/SelectedContainer" pos="Max" offset="0"/>
                <Height val="300"/>

                <Frame type="Image" name="ChatBackground">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-91"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="65"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <TextureType val="NineSlice"/>
                    <Texture val="@UI/SC2_UI_Coop_CustomMutators_InnerPanel_01"/>
                </Frame>

                <Frame type="Image" name="ChatEntryBackground">
                    <Anchor side="Top" relative="$parent/ChatBackground" pos="Max" offset="5"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-40"/>
                    <Anchor side="Left" relative="$parent/ChatBackground" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent/ChatBackground" pos="Max" offset="0"/>
                    <TextureType val="NineSlice"/>
                    <Texture val="@UI/SC2_UI_Coop_CustomMutators_InnerPanel_01"/>
                </Frame>

                <Frame type="Label" name="ChatLabel">
                    <Anchor side="Top" relative="$parent/ChatEntryBackground" pos="Min" offset="3"/>
                    <Anchor side="Bottom" relative="$parent/ChatEntryBackground" pos="Max" offset="0"/>
                    <Anchor side="Left" relative="$parent/ChatEntryBackground" pos="Min" offset="10"/>
                    <Anchor side="Right" relative="$parent/ChatEntryBackground" pos="Max" offset="0"/>
                    <Style val="@Coop_CustomMutator_ChatDisplay"/>
                    <Text val="@CMUI/CustomMutators/InactiveChat"/>

                    <StateGroup name="ChatLabelVisibleState">

                        <State name="Active">
                            <When type="Property" frame="$GameUI_ChatBar" visible="False"/>
                            <Action type="SetProperty" frame="$this" visible="True"/>
                        </State>

                        <State name="Inactive">
                            <When type="Property" frame="$GameUI_ChatBar" visible="True"/>
                            <Action type="SetProperty" frame="$this" visible="False"/>
                        </State>
                    </StateGroup>
                </Frame>

                <Frame type="GameMessageDisplay" name="ChatDisplay">
                    <MessageArea val="Chat"/>
                    <Anchor side="Top" relative="$parent/ChatBackground" pos="Min" offset="13"/>
                    <Anchor side="Bottom" relative="$parent/ChatBackground" pos="Max" offset="-10"/>
                    <Anchor side="Left" relative="$parent/ChatBackground" pos="Min" offset="10"/>
                    <Anchor side="Right" relative="$parent/ChatBackground" pos="Max" offset="-10"/>
                    <Style val="@Coop_CustomMutator_ChatDisplay"/>
                    <MaxMessages val="16"/>
                    <BatchText val="true"/>
                </Frame>
            </Frame>

            <Frame type="Image" name="MouseBlocker">
                <Anchor relative="$parent"/>
                <AcceptsMouse val="True"/>
                <Color val="0,0,0"/>
                <Alpha val="0"/>
                <Visible val="False"/>

                <Animation name="Show">
                    <Event event="CountdownStart" action="Reset,Play" frame="$parent"/>

                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="True"/>
                    </Controller>

                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" out="Fast"/>
                        <Key type="Curve" time=".5" value="170" in="Slow"/>
                    </Controller>
                </Animation>
            </Frame>

            <Frame type="Frame" name="CM_CustomMutatorSettingsPopup" template="CM_CoopCustomMutatorSelection/CM_CustomMutatorSettingsPopupTemplate"/>

        </Frame>


    <Frame type="Frame" name="MutatorPanelTemplate">
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>

        <Frame type="Button" name="CustomMutatorButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Width val="260"/>
            <Text val="@CMUI/CustomMutators/MutatorButton"/>
        </Frame>

        </Frame>

    <Frame type="Button" name="PageSelectorInGameButtonTemplate" template="EmoticonSelectionPanel/PageSelectorButtonTemplate">
        <StateGroup name="MutatorSelectionState">
            <State name="Inactive">
                <When type="StateGroup" frame="$parent/$parent/$parent" MutatorSelectionState="Inactive"/>
            </State>

            <State name="Active">
                <When type="StateGroup" frame="$parent/$parent/$parent" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this" width="31"/>
                <Action type="SetProperty" frame="$this" height="20"/>
                <Action type="SetProperty" frame="$this/NormalImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonUp"/>
                <Action type="SetProperty" frame="$this/HoverImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonSelected"/>
                <Action type="SetProperty" frame="$this/SelectedImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonSelected"/>
                <Action type="SetProperty" frame="$this/NormalImage" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this/HoverImage" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this/SelectedImage" ColorAdjustMode="None"/>
            </State>

            <State name="Launcher">
                <When type="StateGroup" frame="$parent/$parent/$parent" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this" width="31"/>
                <Action type="SetProperty" frame="$this" height="20"/>
                <Action type="SetProperty" frame="$this/NormalImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonUp"/>
                <Action type="SetProperty" frame="$this/HoverImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonSelected"/>
                <Action type="SetProperty" frame="$this/SelectedImage" texture="@UI/Glues_Battlenet_PageAssets_PageButtonSelected"/>
                <Action type="SetProperty" frame="$this/NormalImage" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this/HoverImage" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this/SelectedImage" ColorAdjustMode="None"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="PageSelectorButtonList" name="PageSelectorInGameTemplate">
        <StateGroup name="MutatorSelectionState">
            <State name="Inactive">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Inactive"/>
                <Action type="SetProperty" frame="$this/DecrementButton/Icon" visible="true"/>
                <Action type="SetProperty" frame="$this/DecrementButton/GlueIcon" visible="false"/>
                <Action type="SetProperty" frame="$this/IncrementButton/Icon" visible="true"/>
                <Action type="SetProperty" frame="$this/IncrementButton/GlueIcon" visible="false"/>
                <Action type="SetAnchor" frame="$this/PageButton0" side="Right" relative="$parent/PageButton1" pos="Min" offset="0"/>
                <Action type="SetAnchor" frame="$this/PageButton1" side="Right" relative="$parent/PageButton2" pos="Min" offset="0"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Top" relative="$parent" pos="Min" offset="7"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Left" relative="$parent" pos="Min" offset="165"/>
                <Action type="SetAnchor" frame="$this/PageButton3" side="Left" relative="$parent/PageButton2" pos="Max" offset="0"/>
                <Action type="SetAnchor" frame="$this/PageButton4" side="Left" relative="$parent/PageButton3" pos="Max" offset="0"/>
            </State>

            <State name="Active">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this/DecrementButton/Icon" visible="false"/>
                <Action type="SetProperty" frame="$this/DecrementButton/GlueIcon" visible="true"/>
                <Action type="SetProperty" frame="$this/IncrementButton/Icon" visible="false"/>
                <Action type="SetProperty" frame="$this/IncrementButton/GlueIcon" visible="true"/>
                <Action type="SetAnchor" frame="$this/PageButton0" side="Right" relative="$parent/PageButton1" pos="Min" offset="12"/>
                <Action type="SetAnchor" frame="$this/PageButton1" side="Right" relative="$parent/PageButton2" pos="Min" offset="12"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Top" relative="$parent" pos="Min" offset="8"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Left" relative="$parent" pos="Min" offset="158"/>
                <Action type="SetAnchor" frame="$this/PageButton3" side="Left" relative="$parent/PageButton2" pos="Max" offset="-12"/>
                <Action type="SetAnchor" frame="$this/PageButton4" side="Left" relative="$parent/PageButton3" pos="Max" offset="-12"/>
            </State>

            <State name="Launcher">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this/DecrementButton/Icon" visible="false"/>
                <Action type="SetProperty" frame="$this/DecrementButton/GlueIcon" visible="true"/>
                <Action type="SetProperty" frame="$this/IncrementButton/Icon" visible="false"/>
                <Action type="SetProperty" frame="$this/IncrementButton/GlueIcon" visible="true"/>
                <Action type="SetAnchor" frame="$this/PageButton0" side="Right" relative="$parent/PageButton1" pos="Min" offset="12"/>
                <Action type="SetAnchor" frame="$this/PageButton1" side="Right" relative="$parent/PageButton2" pos="Min" offset="12"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Top" relative="$parent" pos="Min" offset="8"/>
                <Action type="SetAnchor" frame="$this/PageButton2" side="Left" relative="$parent" pos="Min" offset="158"/>
                <Action type="SetAnchor" frame="$this/PageButton3" side="Left" relative="$parent/PageButton2" pos="Max" offset="-12"/>
                <Action type="SetAnchor" frame="$this/PageButton4" side="Left" relative="$parent/PageButton3" pos="Max" offset="-12"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="StandardTooltip" name="MutableEmoticonTooltip" template="StandardTooltip/StandardTooltip">
        <StateGroup name="MutatorSelectionState">
            <State name="Inactive">
                <When type="StateGroup" frame="$parent/GameUI/UIContainer/FullscreenUpperContainer/EmoticonPanel" MutatorSelectionState="Inactive"/>
            </State>

            <State name="Active">
                <When type="StateGroup" frame="$parent/GameUI/UIContainer/FullscreenUpperContainer/EmoticonPanel" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this/BackgroundImage" texture="@UI/StandardGameTooltip"/>
                <Action type="SetProperty" frame="$this/Label" style="StoryModeTooltip"/>
            </State>

            <State name="Launcher">
                <When type="StateGroup" frame="$parent/GameUI/UIContainer/FullscreenUpperContainer/EmoticonPanel" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this/BackgroundImage" texture="@UI/StandardGameTooltip"/>
                <Action type="SetProperty" frame="$this/Label" style="StoryModeTooltip"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="EmoticonTileListItem" name="EmoticonInGameTileListItemTemplate">
        <StateGroup name="MutatorSelectionState">
            <State name="Inactive">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Inactive"/>
                <Action type="SetProperty" frame="$this/Background" visible="true"/>
                <Action type="SetProperty" frame="$this/GlueBackground" visible="false"/>
                <Action type="SetProperty" frame="$this/SelectedImage" ColorAdjustMode="Colorize"/>
            </State>

            <State name="Active">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this/Background" visible="false"/>
                <Action type="SetProperty" frame="$this/GlueBackground" visible="true"/>
                <Action type="SetProperty" frame="$this/SelectedImage" ColorAdjustMode="None"/>
            </State>

            <State name="Launcher">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this/Background" visible="false"/>
                <Action type="SetProperty" frame="$this/GlueBackground" visible="true"/>
                <Action type="SetProperty" frame="$this/SelectedImage" ColorAdjustMode="None"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="Image" name="MutablePagePipDummyDisabled">
        <StateGroup name="MutatorSelectionState">
            <State name="Inactive">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Inactive"/>
            </State>

            <State name="Active">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this" texture="@UI/Glues_Battlenet_PageAssets_PageButtonUp"/>
                <Action type="SetProperty" frame="$this" TextureType="Normal"/>
                <Action type="SetProperty" frame="$this" Width="31"/>
                <Action type="SetProperty" frame="$this" Height="20"/>
                <Action type="SetProperty" frame="$this" Alpha="80"/>
            </State>

            <State name="Launcher">
                <When type="StateGroup" frame="$parent/$parent" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this" ColorAdjustMode="None"/>
                <Action type="SetProperty" frame="$this" texture="@UI/Glues_Battlenet_PageAssets_PageButtonUp"/>
                <Action type="SetProperty" frame="$this" TextureType="Normal"/>
                <Action type="SetProperty" frame="$this" Width="31"/>
                <Action type="SetProperty" frame="$this" Height="20"/>
                <Action type="SetProperty" frame="$this" Alpha="80"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="Frame" name="GameUI/UIContainer/FullscreenUpperContainer" file="GameUI">

        <Frame type="MenuBar" name="MenuBar">

            <Frame type="Image" name="MouseBlocker">
                <Anchor relative="$parent"/>
                <Alpha val="0"/>
                <AcceptsMouse val="True"/>
                <Visible val="False"/>
            </Frame>
        </Frame>

        <Frame type="AspectRatioFrame" name="MutatorAspectRatio5x4">
            <Anchor relative="$parent"/>
            <MinVisibleAspectRatio val="1"/>
            <MaxVisibleAspectRatio val="1.25"/>
        </Frame>

        <Frame type="Frame" name="LauncherChatPanel">
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
            <Width val="800"/>
            <Height val="550"/>
            <RenderPriority val="700"/>
            <Visible val="False"/>
            <Alpha val="0"/>
            <AcceptsMouse val="False"/>

            <StateGroup name="LauncherChatPanelVisibleState">
                <State name="Visible">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Launcher"/>
                    <Action type="SetProperty" frame="$this" visible="True"/>
                    <Action type="SetProperty" frame="$this" alpha="255"/>
                </State>

                <State name="HiddenByInactive">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Inactive"/>
                    <Action type="SetProperty" frame="$this" visible="False"/>
                    <Action type="SetProperty" frame="$this" alpha="0"/>
                </State>

                <State name="HiddenByActive">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Active"/>
                    <Action type="SetProperty" frame="$this" visible="False"/>
                    <Action type="SetProperty" frame="$this" alpha="0"/>
                </State>
            </StateGroup>

            <Frame type="Image" name="DisplayOuterBackground">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-56"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_MainContainer"/>
                <TextureType val="Nineslice"/>
                <Tiled val="False"/>
                <StateGroup name="LauncherBackgroundVisibleState">
                    <State name="Visible">
                        <When type="Property" frame="$GameUI_ChatBar" visible="True"/>
                        <Action type="SetProperty" frame="$this" visible="True"/>
                        <Action type="SetProperty" frame="$this" alpha="255"/>
                    </State>

                    <State name="Hidden">
                        <When type="Property" frame="$GameUI_ChatBar" visible="False"/>
                        <Action type="SetProperty" frame="$this" visible="False"/>
                        <Action type="SetProperty" frame="$this" alpha="0"/>
                    </State>
                </StateGroup>
            </Frame>

            <Frame type="Image" name="DisplayInnerBackground">
                <Anchor side="Top" relative="$parent/DisplayOuterBackground" pos="Min" offset="12"/>
                <Anchor side="Left" relative="$parent/DisplayOuterBackground" pos="Min" offset="12"/>
                <Anchor side="Bottom" relative="$parent/DisplayOuterBackground" pos="Max" offset="-12"/>
                <Anchor side="Right" relative="$parent/DisplayOuterBackground" pos="Max" offset="-12"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_MainInnerContainer"/>
                <TextureType val="Nineslice"/>
                <Tiled val="False"/>
                <StateGroup name="LauncherBackgroundVisibleState">
                    <State name="Visible">
                        <When type="Property" frame="$GameUI_ChatBar" visible="True"/>
                        <Action type="SetProperty" frame="$this" visible="True"/>
                        <Action type="SetProperty" frame="$this" alpha="255"/>
                    </State>

                    <State name="Hidden">
                        <When type="Property" frame="$GameUI_ChatBar" visible="False"/>
                        <Action type="SetProperty" frame="$this" visible="False"/>
                        <Action type="SetProperty" frame="$this" alpha="0"/>
                    </State>
                </StateGroup>

                <Frame type="Image" name="ScrollbarDivider">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="11"/>
                    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-10"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="-24"/>
                    <Texture val="@UI/ChatPanelScrollBarLine"/>
                    <TextureType val="Nineslice"/>
                    <Width val="5"/>
                    <Visible val="False"/>
                </Frame>
            </Frame>

            <Frame type="GameMessageDisplay" name="LauncherChatDisplay">
                <MessageArea val="Chat"/>
                <RenderPriority val="710"/>
                <Anchor side="Top" relative="$parent/DisplayInnerBackground" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent/DisplayInnerBackground" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent/DisplayInnerBackground" pos="Min" offset="6"/>
                <Anchor side="Right" relative="$parent/DisplayInnerBackground" pos="Max" offset="0"/>
                <Style val="CM_LauncherChatDisplay"/>
                <MaxMessages val="24"/>
                <MessageDuration val="0"/>
                <FadeDuration val="0"/>
                <AcceptsMouse val="false"/>
                <LabelsWithHyperlinksAcceptMouseTarget val="false"/>
                <BatchText val="true"/>

                <StateGroup name="LauncherChatDisplayFadeState">
                    <State name="Visible">
                        <When type="Property" frame="$GameUI_ChatBar" visible="True"/>
                        <Action type="SetProperty" frame="$this" MessageDuration="0"/>
                        <Action type="SetProperty" frame="$this" FadeDuration="0"/>
                    </State>

                    <State name="Hidden">
                        <When type="Property" frame="$GameUI_ChatBar" visible="False"/>
                        <Action type="SetProperty" frame="$this" MessageDuration="10000"/>
                        <Action type="SetProperty" frame="$this" FadeDuration="5000"/>
                    </State>
                </StateGroup>
            </Frame>
        </Frame>

        <Frame type="GameMessageDisplay" name="ChatDisplay">
            <StateGroup name="CM_OriginalChatDisplayVisibleState">
                <State name="Launcher">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Launcher"/>
                    <Action type="SetProperty" frame="$this" visible="False"/>
                </State>

                <State name="Inactive">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Inactive"/>
                    <Action type="SetProperty" frame="$this" visible="True"/>
                </State>

                <State name="Active">
                    <When type="AnimationState" frame="$parent" MutatorSelectionState="Active"/>
                    <Action type="SetProperty" frame="$this" visible="False"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="ChatBar" name="ChatBar">
            <RenderPriority val="910"/>

            <Frame type="Button" name="ChatDebugButton" template="StandardBattlenetTemplates/OptionsButton">
                <Handle val="CM_ChatDebugButton"/>
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="21"/>
                <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Min" offset="53"/>
                <Anchor side="Left" relative="$parent/EmojiBorderLine" pos="Max" offset="8"/>
                <Width val="32"/>
                <Height val="32"/>
