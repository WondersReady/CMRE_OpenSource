        <StateGroup name="MutatorSelectionState">
            <DefaultState val="Inactive"/>

            <State name="Active">
                <When type="AnimationState" MutatorSelectionState="Active"/>
                <Action type="SetProperty" frame="$this/ChatBar/BackgroundImage" visible="False"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientImage" visible="False"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientLabel" visible="true"/>
                <Action type="SetProperty" frame="$this/ChatBar/HelpLabel" visible="False"/>
                <Action type="SetProperty" frame="$this/ChatHelpLabel" alpha="0"/>
                <Action type="SetProperty" frame="$this/MenuBar" alpha="0"/>
                <Action type="SetProperty" frame="$this/MenuBar/MouseBlocker" visible="True"/>
                <Action type="SetState" frame="$this/ChatBar" group="MutatorSelectionState" state="Active"/>
                <Action type="SetState" frame="$this/EmoticonPanel" group="MutatorSelectionState" state="Active"/>
            </State>

            <State name="Inactive">
                <When type="AnimationState" MutatorSelectionState="Inactive"/>
                <Action type="SetProperty" frame="$this/ChatBar/BackgroundImage" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientImage" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientLabel" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatBar/HelpLabel" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatHelpLabel" alpha="255"/>
                <Action type="SetProperty" frame="$this/MenuBar" alpha="255"/>
                <Action type="SetProperty" frame="$this/MenuBar/MouseBlocker" visible="False"/>
                <Action type="SetState" frame="$this/ChatBar" group="MutatorSelectionState" state="Inactive"/>
                <Action type="SetState" frame="$this/EmoticonPanel" group="MutatorSelectionState" state="Inactive"/>
            </State>

            <State name="Launcher">
                <When type="AnimationState" MutatorSelectionState="Launcher"/>
                <Action type="SetProperty" frame="$this/ChatBar/BackgroundImage" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientImage" visible="False"/>
                <Action type="SetProperty" frame="$this/ChatBar/RecipientLabel" visible="True"/>
                <Action type="SetProperty" frame="$this/ChatBar/HelpLabel" visible="False"/>
                <Action type="SetProperty" frame="$this/ChatHelpLabel" alpha="0"/>
                <Action type="SetProperty" frame="$this/MenuBar" alpha="255"/>
                <Action type="SetProperty" frame="$this/MenuBar/MouseBlocker" visible="False"/>
                <Action type="SendEvent" frame="$this" event="CustomMutatorInactive"/>
                <Action type="SetState" frame="$this/ChatBar" group="MutatorSelectionState" state="Launcher"/>
                <Action type="SetState" frame="$this/EmoticonPanel" group="MutatorSelectionState" state="Launcher"/>
            </State>
        </StateGroup>

        <Frame type="EmoticonSelectionPanel" name="EmoticonPanel">
            <StateGroup name="MutatorSelectionState">
                <DefaultState val="Inactive"/>

                <State name="Inactive">
                    <Action type="SetAnchor" frame="$this" side="Top" relative="$this" pos="Max" offset="-563"/>
                    <Action type="SetAnchor" frame="$this" side="Bottom" relative="$parent/ChatBar/BackgroundImage" pos="Max" offset="0"/>
                    <Action type="SetAnchor" frame="$this" side="Left" relative="$this" pos="Max" offset="-383"/>
                    <Action type="SetAnchor" frame="$this" side="Right" relative="$parent/ChatBar/BackgroundImage" pos="Min" offset="0"/>
                    <Action type="SetProperty" frame="$this/Background" texture="@@@UI/Game_Console_Chat_Background"/>
                    <Action type="SetProperty" frame="$this/Background" TextureType="Border"/>
                    <Action type="SetProperty" frame="$this/BackgroundDimmer" visible="false"/>
                    <Action type="SetProperty" frame="$this/BackgroundInner" visible="false"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Top" relative="$parent" pos="Min" offset="27"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Bottom" relative="$parent" pos="Min" offset="52"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Left" relative="$parent" pos="Min" offset="27"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Right" relative="$parent" pos="Max" offset="-20"/>
                    <Action type="SetProperty" frame="$this/EmoticonTitleLabel" style="@@@StandardTooltipHeader"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Bottom" relative="$parent" pos="Max" offset="-35"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Left" relative="$parent/$parent/BackgroundInner" pos="Min" offset="-2"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Right" relative="$parent/$parent/BackgroundInner" pos="Max" offset="2"/>
                    <Action type="SetProperty" frame="$this" RenderPriority="600"/>
                </State>

                <State name="Active">
                    <Action type="SetAnchor" frame="$this" side="Top" relative="$this" pos="Max" offset="-550"/>
                    <Action type="SetAnchor" frame="$this" side="Bottom" relative="$parent/ChatBar" pos="Min" offset="14"/>
                    <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/ChatBar" pos="Min" offset="47"/>
                    <Action type="SetAnchor" frame="$this" side="Right" relative="$this" pos="Min" offset="371"/>
                    <Action type="SetProperty" frame="$this/Background" texture="@UI/Glues_Battlenet_PageAssets_MainContainer"/>
                    <Action type="SetProperty" frame="$this/Background" TextureType="Nineslice"/>
                    <Action type="SetProperty" frame="$this/BackgroundDimmer" visible="true"/>
                    <Action type="SetProperty" frame="$this/BackgroundInner" visible="true"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Top" relative="$parent/Background" pos="Min" offset="50"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Left" relative="$parent/Background" pos="Min" offset="12"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Right" relative="$parent/Background" pos="Max" offset="-12"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Bottom" relative="$parent/BackgroundInner" pos="Min" offset="-5"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Left" relative="$parent" pos="Min" offset="20"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Right" relative="$parent" pos="Max" offset="-20"/>
                    <Action type="SetProperty" frame="$this/EmoticonTitleLabel" style="@EmoticonTitleText"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Bottom" relative="$parent" pos="Max" offset="-11"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Left" relative="$parent/$parent/BackgroundInner" pos="Min" offset="0"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Right" relative="$parent/$parent/BackgroundInner" pos="Max" offset="0"/>
                    <Action type="SetProperty" frame="$this" RenderPriority="600"/>
                </State>

                <State name="Launcher">
                    <Action type="SetAnchor" frame="$this" side="Top" relative="$this" pos="Max" offset="-550"/>
                    <Action type="SetAnchor" frame="$this" side="Bottom" relative="$parent/LauncherChatPanel" pos="Max" offset="0"/>
                    <Action type="SetAnchor" frame="$this" side="Left" relative="$this" pos="Max" offset="-371"/>
                    <Action type="SetAnchor" frame="$this" side="Right" relative="$parent/LauncherChatPanel" pos="Min" offset="-10"/>
                    <Action type="SetProperty" frame="$this/Background" texture="@UI/Glues_Battlenet_PageAssets_MainContainer"/>
                    <Action type="SetProperty" frame="$this/Background" TextureType="Nineslice"/>
                    <Action type="SetProperty" frame="$this/BackgroundDimmer" visible="true"/>
                    <Action type="SetProperty" frame="$this/BackgroundInner" visible="true"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Top" relative="$parent/Background" pos="Min" offset="50"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Left" relative="$parent/Background" pos="Min" offset="12"/>
                    <Action type="SetAnchor" frame="$this/BackgroundInner" side="Right" relative="$parent/Background" pos="Max" offset="-12"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Bottom" relative="$parent/BackgroundInner" pos="Min" offset="-5"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Left" relative="$parent" pos="Min" offset="20"/>
                    <Action type="SetAnchor" frame="$this/EmoticonTitleLabel" side="Right" relative="$parent" pos="Max" offset="-20"/>
                    <Action type="SetProperty" frame="$this/EmoticonTitleLabel" style="@EmoticonTitleText"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Bottom" relative="$parent" pos="Max" offset="-11"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Left" relative="$parent/$parent/BackgroundInner" pos="Min" offset="0"/>
                    <Action type="SetAnchor" frame="$this/TileList/PageSelectorAnchor" side="Right" relative="$parent/$parent/BackgroundInner" pos="Max" offset="0"/>
                    <Action type="SetProperty" frame="$this" RenderPriority="920"/>
                </State>
            </StateGroup>
        </Frame>

        <StateGroup name="MutatorSelectionAndAspectRatioState">
            <DefaultState val="Inactive"/>

            <State name="Active">
                <When type="AnimationState" MutatorSelectionState="Active"/>
                <When type="Property" frame="$this/MutatorAspectRatio5x4" Visible="false"/>
                <Action type="SendEvent" frame="$this" event="CustomMutatorActive"/>
            </State>

            <State name="Active5x4">
                <When type="AnimationState" MutatorSelectionState="Active"/>
                <When type="Property" frame="$this/MutatorAspectRatio5x4" Visible="true"/>
                <Action type="SendEvent" frame="$this" event="CustomMutatorActive5x4"/>
            </State>

            <State name="Inactive">
                <When type="AnimationState" MutatorSelectionState="Inactive"/>
                <Action type="SendEvent" frame="$this" event="CustomMutatorInactive"/>
            </State>

            <State name="Launcher">
                <When type="AnimationState" MutatorSelectionState="Launcher"/>
                <Action type="SetState" frame="$this/ChatBar" group="MutatorSelectionState" state="Launcher"/>
            </State>
        </StateGroup>
    </Frame>

</Desc>

