                <Frame type="Image" name="DropShadowImage">
                    <Anchor side="Top" relative="$parent/NormalImage" pos="Min" offset="2"/>
                    <Anchor side="Left" relative="$parent/NormalImage" pos="Min" offset="1"/>
                    <Texture val="@@UI/CM_ChatDebugGear"/>
                    <Height val="26"/>
                    <Width val="26"/>
                    <ColorAdjustMode val="Fill"/>
                    <AdjustmentColor val="255,0,0,0"/>
                    <Alpha val="96"/>
                    <Visible val="False"/>
                </Frame>

                <Frame type="Image" name="NormalImage">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-1"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="-1"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="1"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="1"/>
                    <Height val="26"/>
                    <Width val="26"/>
                    <Color val="###ColorChatIconColor"/>
                    <LayerCount val="1"/>
                    <Texture val="@@UI/CM_ChatDebugGear" layer="0"/>
                </Frame>

                <Frame type="Image" name="HoverImage">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="-1"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="-1"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="1"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="1"/>
                    <Height val="26"/>
                    <Width val="26"/>
                    <Color val="###ColorChatIconColor"/>
                    <LayerCount val="1"/>
                    <Texture val="@@UI/CM_ChatDebugGear" layer="0"/>
                    <ColorAdjustMode val="AddSelf"/>
                    <AdjustmentColor val="96,96,96,96"/>
                </Frame>

                <Frame type="Image" name="HoverAdd">
                    <Anchor relative="$parent/HoverImage"/>
                    <Texture val="@@UI/CM_ChatDebugGear"/>
                    <Alpha val="0"/>
                    <Visible val="False"/>
                </Frame>
            </Frame>

            <Frame type="Image" name="ChatDebugDivider">
                <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="21"/>
                <Anchor side="Left" relative="$parent/ChatDebugButton" pos="Max" offset="8"/>
                <Width val="2"/>
                <Height val="32"/>
                <Texture val="@UI/ChatEmojiBorder"/>
                <ColorAdjustMode val="Colorize"/>
                <AdjustmentColor val="###ColorChatDividerColor"/>

                <StateGroup name="FadeStates">
                    <DefaultState val="Unfocused"/>

                    <State name="Unfocused">
                        <When type="Property" frame="$parent/ChatEditBox" Focused="false"/>
                        <Action type="SetProperty" frame="$this" Alpha="64"/>
                    </State>

                    <State name="Focused">
                        <When type="Property" frame="$parent/ChatEditBox" Focused="true"/>
                        <Action type="SetProperty" frame="$this" Alpha="255"/>
                    </State>
                </StateGroup>
            </Frame>

            <Frame type="Image" name="RecipientImage">
                <Anchor side="Left" relative="$parent/ChatDebugDivider" pos="Max" offset="8"/>
            </Frame>

            <Frame type="Label" name="RecipientLabel">
                <Anchor side="Left" relative="$parent/RecipientImage" pos="Max" offset="5"/>
            </Frame>

            <Frame type="EditBox" name="ChatEditBox">
                <Frame type="Image" name="Image">
                    <Visible val="False"/>
                </Frame>
            </Frame>

            <Animation name="CustomMutatorAnchoring">
                <Event event="CustomMutatorActive" action="Reset,Play" frame="$parent"/>
                <Event event="CustomMutatorInactive" action="Reset,Stop" frame="$parent"/>

                <Controller type="Anchor" end="Pause" side="Left" relative="true">
                    <Key type="Curve" time="0" value="-408" out="Fast"/>
                </Controller>

                <Controller type="Anchor" end="Pause" side="Right" relative="true">
                    <Key type="Curve" time="0" value="-80" out="Fast"/>
                </Controller>

                <Controller type="Anchor" end="Pause" side="Bottom" relative="true">
                    <Key type="Curve" time="0" value="210" out="Fast"/>
                </Controller>
            </Animation>

            <Animation name="CustomMutatorAnchoring5x4">
                <Event event="CustomMutatorActive5x4" action="Reset,Play" frame="$parent"/>
                <Event event="CustomMutatorInactive" action="Reset,Stop" frame="$parent"/>

                <Controller type="Anchor" end="Pause" side="Left" relative="true">
                    <Key type="Curve" time="0" value="-408" out="Fast"/>
                </Controller>

                <Controller type="Anchor" end="Pause" side="Right" relative="true">
                    <Key type="Curve" time="0" value="-80" out="Fast"/>
                </Controller>

                <Controller type="Anchor" end="Pause" side="Bottom" relative="true">
