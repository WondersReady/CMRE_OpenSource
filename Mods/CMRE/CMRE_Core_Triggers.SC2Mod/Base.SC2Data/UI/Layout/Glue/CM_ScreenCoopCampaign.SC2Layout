<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="Frame" name="ScreenCoopCampaignTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Handle val="CM_ScreenCoopCampaign"/>

            <!-- <DisplayBackgroundModel val="false"/> -->
            <!-- <MasteryVersion val="3"/> -->

            <StateGroup name="ModeState">
                <DefaultState val="ModeStandard"/>

                <State name="ModeStandard">
                    <Action type="SendEvent" frame="$this" event="ModeStandard"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel" event="ModeStandard"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/BackgroundCutscene" event="ModeStandard"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/ForegroundCutscene" event="ModeStandard"/>
                </State>

                <State name="ModeMutator">
                    <Action type="SendEvent" frame="$this" event="ModeMutator"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel" event="ModeMutator"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/BackgroundCutscene" event="ModeMutator"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/ForegroundCutscene" event="ModeMutator"/>
                </State>

                <State name="ModeCustom">
                    <Action type="SendEvent" frame="$this" event="ModeCustom"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel" event="ModeCustom"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/BackgroundCutscene" event="ModeCustom"/>
                    <Action type="SendEvent" frame="CommanderSelectionPanel/ForegroundCutscene" event="ModeCustom"/>
                </State>
            </StateGroup>

            <!--

            <Frame type="Image" name="BackgroundImage">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <ScaleWidthToTexture val="true"/>
                <TextureType val="Normal"/>
                <Texture val="@UI/GlueCampaignPanelBackground_Challenge"/>
            </Frame> 
            
            -->

            <!-- <Frame type="CommanderSelectionPanel" name="CommanderSelectionPanel" template="CM_CommanderSelectionPanel/CommanderSelectionPanelTemplate"> -->
            <Frame type="Frame" name="CommanderSelectionPanel" template="CM_CommanderSelectionPanel/CommanderSelectionPanelTemplate">
                <Anchor relative="$parent"/>

                <Animation name="Show">
                    <Event event="Show" action="Reset" frame="$parent/ScorePanel"/>
                    <Event event="Show" action="Play" frame="$parent/ScorePanel"/>

                    <Controller type="Event" end="Stop" frame="$this">
                        <Key type="Event" time="0" event="UISlideOut"/>
                    </Controller>
                </Animation>

                <Animation name="Hide">
                    <Event event="Hide" action="Reset" frame="$parent/ScorePanel"/>
                    <Event event="Hide" action="Play" frame="$parent/ScorePanel"/>

                    <Controller type="Event" end="Stop" frame="$this">
                        <Key type="Event" time="0" event="UISlideIn"/>
                    </Controller>
                </Animation>

                <Animation name="MatchStarting">
                    <Event event="Matched" action="Reset,Play" frame="$parent"/>
                    <Event event="PartyReady" action="Reset,Play" frame="$parent"/>
                    
                    <Controller type="Enabled" end="Pause" frame="CancelButton">
                        <Key type="Bool" time="0" value="false"/>
                    </Controller>
                </Animation>

                <!-- This is a dummy button for when mutators are inactive -->
                <!--Frame type="Button" name="MutatorReadyButton" template="StandardBattlenetTemplates/BattlenetAlternateButtonTemplate">
                    <Anchor relative="$parent/ReadyButton"/>
                    <Text val="@CMUI/ScreenCoopCampaign/Ready"/>
                    <Tooltip val="@CMUI/ScreenCoopCampaign/MutatorInactiveTooltip"/>
                    <TooltipFrame val="BattleNetTooltip"/>
                    <Visible val="false"/>
                    <Enabled val="false"/>

                    <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                </Frame-->

                <!-- <Frame type="CoopCampaignMutatorInfoPanel" name="MutatorInfoPanel" template="CM_CoopCampaignMutatorInfoPanel/CoopCampaignMutatorInfoPanelTemplate"> -->
                <Frame type="Frame" name="MutatorInfoPanel" template="CM_CoopCampaignMutatorInfoPanel/CoopCampaignMutatorInfoPanelTemplate">
                    <Anchor relative="$parent"/>
                    <Handle val="CM_MutatorInfoPanel"/>
                    
                    <Animation name="CloseAllianceStatePanel">
                        <Event event="Show" action="Reset,Play" frame="$this"/>
                        <Event event="OnClick" action="Reset,Play" frame="Button"/>

                        <Controller type="Event" end="Stop" frame="$parent/AllianceStatePanel">
                            <Key type="Event" time="0" event="Inactive"/>
                        </Controller>
                    </Animation>

                    <Animation name="UISlideOut" template="CM_CommanderSelectionPanel/UISlideOutAnimationTemplate"/>
                    <Animation name="UISlideIn" template="CM_CommanderSelectionPanel/UISlideInAnimationTemplate"/>
                    
                </Frame>
                
                <Frame type="Frame" name="AllianceStatePanel" template="CM_CommanderSelectionDetailsContainer/AllianceStatePanelTemplate">
                    <Anchor relative="$parent/DetailsContainer"/>
                    <Handle val="CM_AllianceStatePanel"/>

                    <Animation name="UISlideOut" template="CM_CommanderSelectionPanel/UISlideOutAnimationTemplate"/>
                    <Animation name="UISlideIn" template="CM_CommanderSelectionPanel/UISlideInAnimationTemplate"/>
                </Frame>

                <Frame type="Frame" name="CustomMutatorInfoPanel" template="CM_CoopCampaignCustomMutatorInfoPanel/CoopCampaignCustomMutatorInfoPanelTemplate">
                    <Visible val="False"/>
                </Frame>
                
                <Frame type="Frame" name="StandardInfoPanel" template="CM_CoopCampaignStandardInfoPanel/CoopCampaignStandardInfoPanelTemplate">
                    <Anchor side="Bottom" relative="Button" pos="Max" offset="31"/>
                    <Anchor side="Left" relative="$parent/ReadyButton" pos="Min" offset="-361"/>
                    <Handle val="CM_StandardInfoPanel"/>
                    
                    <Frame type="Button" name="Button">
                        <Anchor side="Bottom" relative="$parent/$parent/ReadyButton" pos="Max" offset="-4"/>
                        <HoverSound val="@UI_HoverTick"/>
                        <Visible val="False"/>
                    </Frame>
                </Frame>

                <!-- <Frame type="CoopCampaignMapSelectionPanel" name="MapSelectionPanel" template="CM_CoopCampaignMapSelectionPanel/CoopCampaignMapSelectionPanelTemplate"> -->
                <Frame type="Frame" name="MapSelectionPanel" template="CM_CoopCampaignMapSelectionPanel/CoopCampaignMapSelectionPanelTemplate">
                    <Handle val="CM_MapSelectionPanel"/>
                    <Anchor relative="$parent"/>
                    
                    <Frame type="Button" name="RetryMapButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <!--Fake map button to replace the real one while retry is selected.-->
                        <Anchor side="Top" relative="$parent/MapButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/MapButton" pos="Min" offset="0"/>
                        <Width val="260"/>
                        <Enabled val="False"/>
                        <HoverSound val="@UI_HoverTick"/>

                        <Frame type="Label" name="Label">
                            <Anchor side="Left" relative="$parent" pos="Min" offset="14"/>
                            <Anchor side="Right" relative="$parent" pos="Max" offset="-14"/>
                            <Options val="Ellipsis | TooltipIfTruncated"/>
                            <AcceptsMouseTooltip val="True"/>
                            <TooltipFrame val="BattleNetTooltip"/>

                            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                        </Frame>
                    </Frame>
                    
                    
                    <Frame type="Button" name="MapButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <Anchor side="Top" relative="$parent/$parent/ReadyButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/ReadyButton" pos="Max" offset="8"/>
                        <Width val="260"/>
                        <HoverSound val="@UI_HoverTick"/>

                        <Frame type="Label" name="Label">
                            <Anchor side="Left" relative="$parent" pos="Min" offset="14"/>
                            <Anchor side="Right" relative="$parent" pos="Max" offset="-14"/>
                            <Options val="Ellipsis | TooltipIfTruncated"/>
                            <AcceptsMouseTooltip val="True"/>
                            <TooltipFrame val="BattleNetTooltip"/>

                            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                        </Frame>
                    </Frame>
                    
                    <Animation name="UISlideOut" template="CM_CommanderSelectionPanel/UISlideOutAnimationTemplate"/>
                    <Animation name="UISlideIn" template="CM_CommanderSelectionPanel/UISlideInAnimationTemplate"/>
                </Frame>

                <Frame type="Frame" name="MutatorChallengePanel">
                    <Handle val="CM_MutatorChallengePanel"/>
                    <Anchor relative="$parent"/>
                    <Visible val="False"/>

                    <Frame type="Button" name="MutatorChallengeButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <Anchor side="Top" relative="$parent/$parent/ReadyButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/ReadyButton" pos="Max" offset="8"/>
                        <Width val="260"/>
                        <HoverSound val="@UI_HoverTick"/>
                        <Text val="@CMUI/ScreenCoopCampaign/MutatorChallengeButton"/>

                        <Frame type="Label" name="Label">
                            <Anchor side="Left" relative="$parent" pos="Min" offset="14"/>
                            <Anchor side="Right" relative="$parent" pos="Max" offset="-14"/>
                            <Options val="Ellipsis | TooltipIfTruncated"/>
                            <AcceptsMouseTooltip val="True"/>
                            <TooltipFrame val="BattleNetTooltip"/>

                            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
                        </Frame>
                    </Frame>

                    <Frame type="Label" name="SelectedEnemyLabel">
                        <Anchor side="Top" relative="$parent/MutatorChallengeButton" pos="Min" offset="-20"/>
                        <Anchor side="Left" relative="$parent/MutatorChallengeButton" pos="Min" offset="0"/>
                        <Anchor side="Right" relative="$parent/MutatorChallengeButton" pos="Max" offset="0"/>
                        <Style val="Coop_MapDifficultyLabel"/>
                    </Frame>
                </Frame>

                <Frame type="Frame" name="DifficultyPanel">
                    <Anchor relative="$parent"/>
                    <Visible val="True"/>

                    <Frame type="Button" name="DifficultyButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <Anchor side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                        <Width val="260"/>
                        <HoverSound val="@UI_HoverTick"/>

                        <StateGroup name="DifficultyButtonPositionState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MutatorChallengePanel/MutatorChallengeButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MutatorChallengePanel/MutatorChallengeButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                            </State>
                        </StateGroup>

                        <StateGroup name="DifficultyButtonVisibilityState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetProperty" frame="$this" Visible="True"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetProperty" frame="$this" Visible="False"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetProperty" frame="$this" Visible="False"/>
                            </State>
                        </StateGroup>
                    </Frame>

                    <Frame type="Button" name="SpecialDifficultyButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <Anchor side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                        <Width val="260"/>
                        <HoverSound val="@UI_HoverTick"/>
                        <Visible val="False"/>

                        <StateGroup name="SpecialDifficultyButtonPositionState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MutatorChallengePanel/MutatorChallengeButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MutatorChallengePanel/MutatorChallengeButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Max" offset="8"/>
                            </State>
                        </StateGroup>

                        <StateGroup name="SpecialDifficultyButtonVisibilityState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetProperty" frame="$this" Visible="False"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetProperty" frame="$this" Visible="True"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetProperty" frame="$this" Visible="True"/>
                            </State>
                        </StateGroup>
                    </Frame>

                    <Frame type="Button" name="MutatorPoolButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                        <Anchor side="Top" relative="$parent/DifficultyButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/DifficultyButton" pos="Max" offset="8"/>
                        <Width val="260"/>
                        <HoverSound val="@UI_HoverTick"/>
                        <Text val="@CMUI/CustomMutatorPool/OpenButton"/>
                        <Visible val="False"/>

                        <StateGroup name="MutatorPoolButtonPositionState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/DifficultyButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/DifficultyButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/SpecialDifficultyButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/SpecialDifficultyButton" pos="Max" offset="8"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetAnchor" frame="$this" side="Top" relative="$parent/SpecialDifficultyButton" pos="Min" offset="0"/>
                                <Action type="SetAnchor" frame="$this" side="Left" relative="$parent/SpecialDifficultyButton" pos="Max" offset="8"/>
                            </State>
                        </StateGroup>

                        <StateGroup name="MutatorPoolButtonTextState">
                            <DefaultState val="ModeStandard"/>

                            <State name="ModeStandard">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                                <Action type="SetProperty" frame="$this" Text="@CMUI/CustomMutatorPool/OpenButtonBrutalPlus"/>
                                <Action type="SetProperty" frame="Label" Text="@CMUI/CustomMutatorPool/OpenButtonBrutalPlus"/>
                            </State>

                            <State name="ModeMutator">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                                <Action type="SetProperty" frame="$this" Text="@CMUI/CustomMutatorPool/OpenButtonCycle"/>
                                <Action type="SetProperty" frame="Label" Text="@CMUI/CustomMutatorPool/OpenButtonCycle"/>
                            </State>

                            <State name="ModeCustom">
                                <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                                <Action type="SetProperty" frame="$this" Text="@CMUI/CustomMutatorPool/OpenButtonRandom"/>
                                <Action type="SetProperty" frame="Label" Text="@CMUI/CustomMutatorPool/OpenButtonRandom"/>
                            </State>
                        </StateGroup>

                        <Frame type="Label" name="Label">
                            <Anchor side="Left" relative="$parent" pos="Min" offset="14"/>
                            <Anchor side="Right" relative="$parent" pos="Max" offset="-14"/>
                            <Text val="@CMUI/CustomMutatorPool/OpenButton"/>
                            <Options val="Ellipsis"/>
                        </Frame>
                    </Frame>

                </Frame>

                <Frame type="Frame" name="MutatorSelectionPanel" template="CM_CoopCustomMutatorSelection/MutatorPanelTemplate">
                    <Handle val="CM_MutatorSelectionPanel"/>
                    <Anchor relative="$parent"/>
                    <Visible val="False"/>

                    <Frame type="Button" name="CustomMutatorButton">
                        <Anchor side="Top" relative="$parent/$parent/MapSelectionPanel/MapButton" pos="Min" offset="0"/>
                        <Anchor side="Left" relative="$parent/$parent/DifficultyPanel/MutatorPoolButton" pos="Max" offset="8"/>
                    </Frame>
                </Frame>

                <Animation name="ApplyModeStandardButtons">
                    <Event event="ModeStandard" action="Reset,Play"/>

                    <Controller type="Property" property="Visible" frame="MapSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MapSelectionContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="DifficultyPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_DifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_SpecialDifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_CustomMutatorFullscreen" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorChallengePanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MutatorChallengeContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="StandardInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="CustomMutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>
                </Animation>

                <Animation name="ApplyModeMutatorButtons">
                    <Event event="ModeMutator" action="Reset,Play"/>

                    <Controller type="Property" property="Visible" frame="MapSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MapSelectionContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="DifficultyPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_DifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_SpecialDifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_CustomMutatorFullscreen" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorChallengePanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MutatorChallengeContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="StandardInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="CustomMutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>
                </Animation>

                <Animation name="ApplyModeCustomButtons">
                    <Event event="ModeCustom" action="Reset,Play"/>

                    <Controller type="Property" property="Visible" frame="MapSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MapSelectionContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="DifficultyPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_DifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_SpecialDifficultyContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorSelectionPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_CustomMutatorFullscreen" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorChallengePanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="$CM_MutatorChallengeContainer" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="StandardInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="False"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="MutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>

                    <Controller type="Property" property="Visible" frame="CustomMutatorInfoPanel" end="Pause">
                        <Key type="Property" time="0" value="True"/>
                    </Controller>
                </Animation>

                <StateGroup name="ButtonModeVisibilty">
                    <DefaultState val="ButtonModeStandard"/>

                    <State name="ButtonModeStandard">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                        <Action type="SetProperty" frame="MapSelectionPanel" Visible="True"/>
                        <Action type="SetProperty" frame="MutatorChallengePanel" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MutatorChallengeContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MutatorChallengeContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="DifficultyPanel" Visible="True"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="MutatorSelectionPanel" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_CustomMutatorFullscreen" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_CustomMutatorFullscreen" Alpha="0"/>
                        <Action type="SetProperty" frame="StandardInfoPanel" Visible="True"/>
                        <Action type="SetProperty" frame="MutatorInfoPanel" Visible="True"/>
                        <Action type="SetProperty" frame="CustomMutatorInfoPanel" Visible="False"/>
                    </State>
                  
                    <State name="ButtonModeMutator">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                        <Action type="SetProperty" frame="MapSelectionPanel" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MapSelectionContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MapSelectionContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="MutatorChallengePanel" Visible="True"/>
                        <Action type="SetProperty" frame="DifficultyPanel" Visible="True"/>
                        <Action type="SetProperty" frame="$CM_DifficultyContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_DifficultyContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="MutatorSelectionPanel" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_CustomMutatorFullscreen" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_CustomMutatorFullscreen" Alpha="0"/>
                        <Action type="SetProperty" frame="StandardInfoPanel" Visible="False"/>
                        <Action type="SetProperty" frame="MutatorInfoPanel" Visible="True"/>
                        <Action type="SetProperty" frame="CustomMutatorInfoPanel" Visible="False"/>
                    </State>

                    <State name="ButtonModeCustom">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                        <Action type="SetProperty" frame="MapSelectionPanel" Visible="True"/>
                        <Action type="SetProperty" frame="MutatorChallengePanel" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MutatorChallengeContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_MutatorChallengeContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="DifficultyPanel" Visible="True"/>
                        <Action type="SetProperty" frame="$CM_DifficultyContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_DifficultyContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Visible="False"/>
                        <Action type="SetProperty" frame="$CM_SpecialDifficultyContainer" Alpha="0"/>
                        <Action type="SetProperty" frame="MutatorSelectionPanel" Visible="True"/>
                        <Action type="SetProperty" frame="StandardInfoPanel" Visible="False"/>
                        <Action type="SetProperty" frame="MutatorInfoPanel" Visible="True"/>
                        <Action type="SetProperty" frame="CustomMutatorInfoPanel" Visible="True"/>
                    </State>
                </StateGroup>

                <StateGroup name="TitleStateGroup">
                    <DefaultState val="TitleModeStandard"/>

                    <State name="TitleModeStandard">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                        <Action type="SetProperty" frame="Title" Text="@CMUI/ScreenCoopCampaign/Title"/>
                        <Action type="SetProperty" frame="Subtitle" Text="@CMUI/ScreenCoopCampaign/Subtitle"/>
                    </State>

                    <State name="TitleModeMutator">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                        <Action type="SetProperty" frame="Title" Text="@CMUI/ScreenCoopCampaign/MutatorTitle"/>
                        <Action type="SetProperty" frame="Subtitle" Text="@CMUI/ScreenCoopCampaign/MutatorSubtitle"/>
                    </State>

                    <State name="TitleModeCustom">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                        <Action type="SetProperty" frame="Title" Text="@CMUI/ScreenCoopCampaign/CustomTitle"/>
                        <Action type="SetProperty" frame="Subtitle" Text="@CMUI/ScreenCoopCampaign/CustomSubtitle"/>
                    </State>
                </StateGroup>

                <StateGroup name="ReadyButtonStateGroup">
                    <State name="MutatorDisabledState">
                        <When type="AnimationState" frame="MutatorInfoPanel" InfoPanelState="Inactive"/>
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                        <Action type="SetProperty" frame="ReadyButton" Visible="True"/>
                        <Action type="SetProperty" frame="CancelButton" Visible="False"/>
                        <!--Action type="SetProperty" frame="MutatorReadyButton" Visible="False"/-->
                    </State>
                </StateGroup>
            </Frame>

            <Frame type="Frame" name="ReadyStatusPanel" template="CM_CoopReadyStatusPanel/ReadyStatusPanelTemplate">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="52"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="84"/>
                <Visible val="False"/>
            </Frame>

            <Frame type="Button" name="DebugButton" template="StandardTemplates/StandardButtonTemplate" requiredtoload="IS_COOP_CAMPAIGN_DEBUG_CODE_ENABLED">
                <Anchor side="Top" relative="$parent" pos="Min" offset="150"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-50"/>
                <Width val ="315"/>
                <Text val="@CMUI/Debug/Title"/>
                <Toggleable val="true"/>

                <StateGroup name="ToggleStateGroup">
                    <State name="ToggledState">
                        <When type="Property" frame="$this" Toggled="true"/>
                        <Action type="SetProperty" frame="$parent/DebugFrame" Visible="True"/>
                    </State>
                </StateGroup>
            </Frame>

            <Frame type="CoopCampaignDebugFrame" name="DebugFrame" requiredtoload="IS_COOP_CAMPAIGN_DEBUG_CODE_ENABLED">
                <Anchor side="Top" relative="$parent/DebugButton" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent/DebugButton" pos="Max" offset="0"/>
                <Anchor side="Bottom" relative="ResetMasteryVersionButton" pos="Max" offset="20"/>
