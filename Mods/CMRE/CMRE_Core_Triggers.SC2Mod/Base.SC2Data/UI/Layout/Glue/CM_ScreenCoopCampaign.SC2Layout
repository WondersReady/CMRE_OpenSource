                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/AdvanceTime"/>
                </Frame>

                <Frame type="Button" name="AdvanceRotationButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/AdvanceTimeButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/NextMapRotation"/>
                </Frame>
                
                <Frame type="Button" name="DebugScoreButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/AdvanceRotationButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/ScoreScreen"/>
                </Frame>

                <Frame type="Button" name="DebugMasteryButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/DebugScoreButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/MasteryEarned"/>

                    <Animation name="Show">
                        <Event event="OnClick" action="Reset,Play" frame="$this"/>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/MasteryUnlockPanel">
                            <Key type="Event" time="0" event="ShowMasteryWindow"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Button" name="ResetNewUserButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/DebugMasteryButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/ResetNewUser"/>
                </Frame>

                <Frame type="Button" name="ResetNewUserMutatorButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/ResetNewUserButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/Background" pos="Mid" offset="0"/>
                    <Width val ="315"/>
                    <Text val="@CMUI/Debug/ResetNewUserMutator"/>
                </Frame>

                <Frame type="Button" name="ResetNewUserMasteryButton" template="StandardBattlenetTemplates/BattlenetMediumButtonTemplate">
                    <Anchor side="Top" relative="$parent/ResetNewUserMutatorButton" pos="Max" offset="20"/>
                    <Anchor side="Left" relative="$parent/Background" pos="Mid" offset="0"/>
