            </Frame>

            <Frame type="Frame" name="MasteryVersionPanel">
                <Handle val="CM_MasteryVersionPanel"/>
                <Anchor relative="$parent"/>
                <Visible val="false"/>
            
                <Animation name="Show">
                    <Event event="ShowMasteryVersionWindow" action="Reset,Play" frame="$parent"/>
                    <Event event="OnHidden" action="Reset,Stop" frame="$parent"/>
                    <Event event="OnClick" action="DirectionReverse,Play" frame="CloseButton"/>
                    
                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="false"/>
                        <Key type="Bool" time=".001" value="true"/>
                        <Key type="Bool" time=".175" value="true"/>
                    </Controller>

                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" out="Slow"/>
                        <Key type="Curve" time=".175" value="255" in="Auto"/>
                    </Controller>
                </Animation>
                
                <Animation name="FlashMasteryButton">
                    <Event event="OnClick" action="Reset,Play" frame="CloseButton"/>

                    <Controller type="Event" end="Pause" frame="$parent/CommanderSelectionPanel/MasteryButton/NotificationGlow">
                        <Key type="Event" time="0" event="ShowMasteryNotification"/>
                    </Controller>
                </Animation>
                
                <!-- This tooltip is just for blocking tooltips behind this panel -->
                <Frame type="StandardTooltip" name="CoopCampaignTooltip">
                    <Frame type="Label" name="Label">
                        <Anchor relative="$parent"/>
                    </Frame>
                </Frame>

                <Frame type="Image" name="FullscreenBlackoutImage">
                    <Anchor relative="$parent"/>
                    <Color val="0,0,0"/>
                    <Alpha val="180"/>
                    <AcceptsMouse val="true"/>
                    <TooltipFrame val="CoopCampaignTooltip"/>
                </Frame>

                <Frame type="Image" name="BackgroundImage">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
                    <TextureType val="NineSlice"/>
                    <Tiled val="false"/>
                    <Width val="860"/>
                    <Height val="380"/>
                </Frame>
                
                <Frame type="Image" name="TopHexPattern">
                    <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                </Frame>
                
                <Frame type="Image" name="BottomHexPattern">
                    <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                    <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
                </Frame>

                <Frame type="Label" name="TitleLabel">
                    <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="45"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="60"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-60"/>
                    <Style val="@@StandardDialogTitle"/>
                    <Text val="@CMUI/ScreenCoopCampaign/MasteryVersionTitle"/>
                </Frame>

                <Frame type="Label" name="MessageLabel">
                    <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="30"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="60"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-60"/>
                    <Style val="@Coop_MasteryDialogUnlockText"/>
                    <Text val="@CMUI/ScreenCoopCampaign/MasteryVersionMessage"/>
                </Frame>
                
                <Frame type="Label" name="DescriptionLabel">
                    <Anchor side="Top" relative="$parent/MessageLabel" pos="Max" offset="10"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="90"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-90"/>
                    <Style val="@@StandardDialogMessage"/>
                    <Text val="@CMUI/ScreenCoopCampaign/MasteryVersionDescription"/>
                </Frame>

                <Frame type="Button" name="CloseButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                    <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-45"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Text val="@CMUI/StandardDialog_Ok_Control"/>
                    <HoverSound val="@UI_HoverTick"/>
                </Frame>
            </Frame>

            <Frame type="Frame" name="MasteryUnlockPanel">
                <Handle val="CM_MasteryUnlockPanel"/>
                <Anchor relative="$parent"/>
                <Visible val="false"/>

                <!-- This animation is shown by the code based on the hitting level 15 and unlocking mastery -->
                <!-- You may change the event to "OnShown" to debug it every time -->
                <!-- MasteryStateGroup: if you're leveling up mastery or not -->
                <StateGroup name="MasteryStateGroup">
                    <State name="MasteryActiveState">
                        <When type="Property" frame="$parent/ScorePanel" Visible="false"/>
                        <When type="AnimationState" frame="$parent/ScorePanel/SummaryPanel" MasteryState="MasteryInactive"/>
                        <When type="AnimationState" frame="$parent/ScorePanel/SummaryPanel" MaxLevelState="MaxLevel"/>
                        <Action type="SendEvent" frame="$this" event="ShowMasteryWindow"/>
                    </State>
                    
                    <State name="MasteryActiveEarlyState">
                        <When type="Property" frame="$parent/ScorePanel" Visible="false"/>
                        <When type="AnimationState" frame="$parent/ScorePanel/SummaryPanel" MasteryState="MasteryInactive"/>
                        <When type="AnimationState" frame="$parent/ScorePanel/SummaryPanel" MaxLevelState="MaxLevelEarned"/>
                        <Action type="SendEvent" frame="$this" event="ShowMasteryWindow"/>
                    </State>
                </StateGroup>
            
                <Animation name="Show">
                    <Event event="ShowMasteryWindow" action="Reset,Play" frame="$this"/>
                    <Event event="ShowMasteryWindow" action="Reset,Play" frame="$parent"/>
                    <Event event="OnHidden" action="Reset,Stop" frame="$parent"/>
                    <Event event="OnClick" action="DirectionReverse,Play" frame="CloseButton"/>
                    
                    <Controller type="Visibility" end="Pause">
                        <Key type="Bool" time="0" value="false"/>
                        <Key type="Bool" time=".001" value="true"/>
                        <Key type="Bool" time=".175" value="true"/>
                    </Controller>

                    <Controller type="Fade" end="Pause">
                        <Key type="Curve" time="0" value="0" out="Slow"/>
                        <Key type="Curve" time=".175" value="255" in="Auto"/>
                    </Controller>
                </Animation>
                
                <Animation name="FlashMasteryButton">
                    <Event event="OnClick" action="Reset,Play" frame="CloseButton"/>

                    <Controller type="Event" end="Pause" frame="$parent/CommanderSelectionPanel/MasteryButton/NotificationGlow">
                        <Key type="Event" time="0" event="ShowMasteryNotification"/>
                    </Controller>
                </Animation>
                
                <!-- This tooltip is just for blocking tooltips behind this panel -->
                <Frame type="StandardTooltip" name="CoopCampaignTooltip">
                    <Frame type="Label" name="Label">
                        <Anchor relative="$parent"/>
                    </Frame>
                </Frame>

                <Frame type="Image" name="FullscreenBlackoutImage">
                    <Anchor relative="$parent"/>
                    <Color val="0,0,0"/>
                    <Alpha val="180"/>
                    <AcceptsMouse val="true"/>
                    <TooltipFrame val="CoopCampaignTooltip"/>
                </Frame>

                <Frame type="Image" name="BackgroundImage">
                    <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_StandardBG"/>
                    <TextureType val="NineSlice"/>
                    <Tiled val="false"/>
                    <Width val="860"/>
                    <Height val="480"/>
                </Frame>
                
                <Frame type="Image" name="TopHexPattern">
                    <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="11"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                </Frame>
                
                <Frame type="Image" name="BottomHexPattern">
                    <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-11"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_DialogBox_HexPattern"/>
                    <TextureCoords top="1.0" left="1.0" bottom="0.0" right="0.0"/>
                </Frame>

                <Frame type="Label" name="TitleLabel">
                    <Anchor side="Top" relative="$parent/BackgroundImage" pos="Min" offset="45"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="60"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-60"/>
                    <Style val="@@StandardDialogTitle"/>
                    <Text val="@CMUI/ScreenCoopCampaign/CustomizationUnlockTitle"/>
                </Frame>

                <Frame type="Label" name="MessageLabel">
                    <Anchor side="Top" relative="$parent/TitleLabel" pos="Max" offset="30"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="60"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-60"/>
                    <Style val="@Coop_MasteryDialogUnlockText"/>
                    <Text val="@CMUI/ScreenCoopCampaign/MasteryUnlockMessage"/>
                </Frame>
                
                <Frame type="Label" name="CustomizationDescriptionLabel">
                    <Anchor side="Top" relative="$parent/MessageLabel" pos="Max" offset="30"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Min" offset="90"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Max" offset="-90"/>
                    <Style val="@@StandardDialogMessage"/>
                    <Text val="@CMUI/ScreenCoopCampaign/CustomizationUnlockDescription"/>
                </Frame>

                <Frame type="Button" name="CloseButton" template="StandardBattlenetTemplates/BattlenetStandardButtonTemplate">
                    <Anchor side="Bottom" relative="$parent/BackgroundImage" pos="Max" offset="-45"/>
                    <Anchor side="Left" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/BackgroundImage" pos="Mid" offset="0"/>
                    <Text val="@CMUI/StandardDialog_Ok_Control"/>
                    <HoverSound val="@UI_HoverTick"/>
                </Frame>
            </Frame>

            <Frame type="Frame" name="NavigationContainer">
                <Handle val="CM_NavigationContainer"/>
                <!--Anchor side="Top" relative="$Anchor_SubNav" pos="Max" offset="0"/-->
                <Anchor side="Top" relative="$parent" pos="Min" offset="72"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>

                <Frame type="BlurFrame" name="BlurEffect">
                    <Anchor relative="$parent/Background"/>
                    <BlurAmount val=".3"/>

                    <Frame type="Image" name="LowImage">
                        <Anchor relative="$parent"/>
                        <Color val="0,0,0"/>
                        <Alpha val="150"/>
                    </Frame>
                </Frame>

                <Frame type="Image" name="Background">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                    <Height val="52"/>
                    <Texture val="@UI/Glues_Battlenet_SubNav_Bg"/>
                    <TextureType val="Nineslice"/>
                    <Tiled val="true"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Linear"/>
                            <Key type="Curve" time="0.95" value="255" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>
                
                <Frame type="Image" name="BottomLineHighlightAnim">
                    <Anchor side="Bottom" relative="$parent/Background" pos="Max" offset="2"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_TopNav_BottomHighlightAnim"/>
                    <Alpha val="150"/>
                    
                    <Animation name="Highlight">
                        <Event event="OnShown" action="DirectionForward" frame="$parent"/>
                        <Event event="OnShown" action="Play" frame="$parent"/>
                        
                        <Controller type="Fade" end="Loop">
                            <Key type="Curve" time="0" value="0"/>
                            <Key type="Curve" time="2" value="100"/>
                            <Key type="Curve" time="4.5" value="175"/>
                            <Key type="Curve" time="6" value="150"/>
                            <Key type="Curve" time="10" value="0"/>
                        </Controller>
                        
                        <Controller type="Anchor" end="Loop" side="Left" relative="true">
                            <Key type="Curve" time="0" value="0" out="linear"/>
                            <Key type="Curve" time="2" value="0" out="linear"/>
                            <Key type="Curve" time="10" value="1920" out="linear"/>
                        </Controller>
                    </Animation>
                </Frame>
                
                <Frame type="Image" name="ButtonDivider1">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Anchor side="Right" relative="$parent/StandardButton" pos="Max" offset="#SubNavigationButtonDividerOffset"/>
                    <Texture val="@UI/Glues_Battlenet_SubNav_ButtonDivider"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Linear"/>
                            <Key type="Curve" time="0.5" value="255" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>
                
                <Frame type="Image" name="ButtonDivider2">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Anchor side="Right" relative="$parent/MutatorButton" pos="Max" offset="#SubNavigationButtonDividerOffset"/>
                    <Texture val="@UI/Glues_Battlenet_SubNav_ButtonDivider"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Linear"/>
                            <Key type="Curve" time="0.5" value="255" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Image" name="ButtonDivider3">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Anchor side="Right" relative="$parent/CMMutatorButton" pos="Max" offset="#SubNavigationButtonDividerOffset"/>
                    <Texture val="@UI/Glues_Battlenet_SubNav_ButtonDivider"/>
                    <Alpha val="0"/>

                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Linear"/>
                            <Key type="Curve" time="0.5" value="255" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Image" name="ProfileCancelDivider">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                    <Anchor side="Right" relative="$parent/CustomButton" pos="Max" offset="#SubNavigationButtonDividerOffset"/>
                    <Texture val="@UI/Glues_Battlenet_SubNav_ButtonDivider"/>
                    <Alpha val="0"/>
                    <Visible val="false"/>

                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Linear"/>
                            <Key type="Curve" time="0.5" value="255" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>
                
                <Frame type="Button" name="StandardButton" template="CM_SharedTemplates/SubNavigationButtonTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$Anchor_SubNav" pos="Max" offset="0"/>
                    <Text val="@CMUI/ScreenCoopCampaign/StandardButton"/>
                    <Toggled val="True"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Auto"/>
                            <Key type="Curve" time="0.3" value="0" in="Auto"/>
                            <Key type="Curve" time="0.45" value="255" out="Auto"/>
                        </Controller>
                        
                        <Controller type="Anchor" end="Pause" side="Left" relative="true">
                            <Key type="Curve" time="0" value="-40" out="Linear"/>
                            <Key type="Curve" time="0.3" value="-40" out="Linear"/>
                            <Key type="Curve" time="0.45" value="0" out="Linear"/>
                        </Controller>
                    </Animation>

                    <Animation name="SelectMode">
                        <Event event="OnClick" action="Reset,Play"/>

                        <Controller type="State" stateGroup="ModeState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="ModeStandard"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel">
                            <Key type="Event" time="0" event="ModeStandard"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/BackgroundCutscene">
                            <Key type="Event" time="0" event="ModeStandard"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/ForegroundCutscene">
                            <Key type="Event" time="0" event="ModeStandard"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/StandardButton" end="Pause">
                            <Key type="Property" time="0" value="True"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/MutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CMMutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CustomButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Button" name="MutatorButton" template="CM_SharedTemplates/SubNavigationButtonTemplate">
                    <Anchor side="Top" relative="$parent/StandardButton" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/StandardButton" pos="Max" offset="#SubNavigationButtonOverlapOffset"/>
                    <Text val="@CMUI/ScreenCoopCampaign/MutatorButton"/>
                    <Toggled val="False"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Auto"/>
                            <Key type="Curve" time="0.3" value="0" in="Auto"/>
                            <Key type="Curve" time="0.47" value="255" out="Auto"/>
                        </Controller>
                        
                        <Controller type="Anchor" end="Pause" side="Left" relative="true">
                            <Key type="Curve" time="0" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.3" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.47" value="0" out="Linear"/>
                        </Controller>
                    </Animation>

                    <Animation name="SelectMode">
                        <Event event="OnClick" action="Reset,Play"/>

                        <Controller type="State" stateGroup="ModeState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/BackgroundCutscene">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/ForegroundCutscene">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/StandardButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/MutatorButton" end="Pause">
                            <Key type="Property" time="0" value="True"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CMMutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CustomButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Button" name="CMMutatorButton" template="CM_SharedTemplates/SubNavigationButtonTemplate">
                    <Anchor side="Top" relative="$parent/MutatorButton" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/MutatorButton" pos="Max" offset="#SubNavigationButtonOverlapOffset"/>
                    <Text val="@CMUI/ScreenCoopCampaign/CMMutatorButton"/>
                    <Toggled val="False"/>
                    <Alpha val="0"/>

                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Auto"/>
                            <Key type="Curve" time="0.3" value="0" in="Auto"/>
                            <Key type="Curve" time="0.47" value="255" out="Auto"/>
                        </Controller>

                        <Controller type="Anchor" end="Pause" side="Left" relative="true">
                            <Key type="Curve" time="0" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.3" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.47" value="0" out="Linear"/>
                        </Controller>
                    </Animation>

                    <Animation name="SelectMode">
                        <Event event="OnClick" action="Reset,Play"/>

                        <Controller type="State" stateGroup="ModeState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/BackgroundCutscene">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/ForegroundCutscene">
                            <Key type="Event" time="0" event="ModeMutator"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/StandardButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/MutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CMMutatorButton" end="Pause">
                            <Key type="Property" time="0" value="True"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CustomButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Button" name="CustomButton" template="CM_SharedTemplates/SubNavigationButtonTemplate">
                    <Anchor side="Top" relative="$parent/CMMutatorButton" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/CMMutatorButton" pos="Max" offset="#SubNavigationButtonOverlapOffset"/>
                    <Text val="@CMUI/ScreenCoopCampaign/CustomButton"/>
                    <Toggled val="False"/>
                    <Alpha val="0"/>
                    
                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Auto"/>
                            <Key type="Curve" time="0.3" value="0" in="Auto"/>
                            <Key type="Curve" time="0.47" value="255" out="Auto"/>
                        </Controller>
                        
                        <Controller type="Anchor" end="Pause" side="Left" relative="true">
                            <Key type="Curve" time="0" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.3" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.47" value="0" out="Linear"/>
                        </Controller>
                    </Animation>

                    <Animation name="SelectMode">
                        <Event event="OnClick" action="Reset,Play"/>

                        <Controller type="State" stateGroup="ModeState" frame="$parent/$parent" end="Pause">
                            <Key type="Identifier" time="0" value="ModeCustom"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel">
                            <Key type="Event" time="0" event="ModeCustom"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/BackgroundCutscene">
                            <Key type="Event" time="0" event="ModeCustom"/>
                        </Controller>

                        <Controller type="Event" end="Pause" frame="$parent/$parent/CommanderSelectionPanel/ForegroundCutscene">
                            <Key type="Event" time="0" event="ModeCustom"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/StandardButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/MutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CMMutatorButton" end="Pause">
                            <Key type="Property" time="0" value="False"/>
                        </Controller>

                        <Controller type="Property" property="Toggled" frame="$parent/CustomButton" end="Pause">
                            <Key type="Property" time="0" value="True"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Button" name="ProfileCancelButton" template="CM_SharedTemplates/SubNavigationButtonTemplate">
                    <Anchor side="Top" relative="$parent/CustomButton" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent/CustomButton" pos="Max" offset="#SubNavigationButtonOverlapOffset"/>
                    <Text val="@CMUI/ScreenCoopCampaign/ProfileCancel"/>
                    <Toggled val="False"/>
                    <Toggleable val="False"/>
                    <Alpha val="0"/>
                    <Visible val="false"/>

                    <Animation name="FadeNav">
                        <Event event="OnShown" action="Reset"/>
                        <Event event="OnShown" action="Play"/>

                        <Controller name="FadeIn" type="Fade" end="Pause">
                            <Key type="Curve" time="0.0" value="0" in="Auto"/>
                            <Key type="Curve" time="0.3" value="0" in="Auto"/>
                            <Key type="Curve" time="0.47" value="255" out="Auto"/>
                        </Controller>

                        <Controller type="Anchor" end="Pause" side="Left" relative="true">
                            <Key type="Curve" time="0" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.3" value="-10" out="Linear"/>
                            <Key type="Curve" time="0.47" value="0" out="Linear"/>
                        </Controller>
                    </Animation>
                </Frame>

                <StateGroup name="NavigationModeState">
                    <DefaultState val="ModeStandard"/>

                    <State name="ModeStandard">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                        <Action type="SetProperty" frame="StandardButton" Toggled="True"/>
                        <Action type="SetProperty" frame="MutatorButton" Toggled="False"/>
                        <Action type="SetProperty" frame="CMMutatorButton" Toggled="False"/>
                        <Action type="SetProperty" frame="CustomButton" Toggled="False"/>
                    </State>

                    <State name="ModeMutator">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeMutator"/>
                        <Action type="SetProperty" frame="StandardButton" Toggled="False"/>
                        <Action type="SetProperty" frame="MutatorButton" Toggled="True"/>
                        <Action type="SetProperty" frame="CMMutatorButton" Toggled="False"/>
                        <Action type="SetProperty" frame="CustomButton" Toggled="False"/>
                    </State>

                    <State name="ModeCustom">
                        <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeCustom"/>
                        <Action type="SetProperty" frame="StandardButton" Toggled="False"/>
                        <Action type="SetProperty" frame="MutatorButton" Toggled="False"/>
                        <Action type="SetProperty" frame="CMMutatorButton" Toggled="False"/>
                        <Action type="SetProperty" frame="CustomButton" Toggled="True"/>
                    </State>
                </StateGroup>
                
                <Frame type="Image" name="NewContentFlagGlow">
                    <Anchor side="Bottom" relative="$parent/NewMutatorIndicator" pos="Max" offset="0"/>
                    <Anchor side="Left" relative="$parent/NewMutatorIndicator" pos="Mid" offset="0"/>
                    <Anchor side="Right" relative="$parent/NewMutatorIndicator" pos="Mid" offset="0"/>
                    <Texture val="@UI/Glues_Battlenet_TopNav_NewContentGlow"/>
                    <Width val="36"/>
                    <Height val="36"/>
                    <Visible val="False"/>

                    <Frame type="Image" name="NewContentFlagPulse">
                        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_TopNav_NewContentBg"/>
                        <Width val="36"/>
                        <Height val="36"/>
                        <Alpha val="0"/>
                        
                        <Animation name="FlagGlow">
                            <Event event="OnShown" action="Reset,Play" frame="$parent"/>
                            <Event event="OnHidden" action="Stop" frame="$parent"/>

                            <Controller type="Rotation" relative="False" end="Loop">
                                <Key type="Curve" time="0" value="0" out="Linear"/>
                                <Key type="Curve" time="5" value="360" in="Linear"/>
                            </Controller>

                            <Controller type="Fade" end="Loop">
                                <Key type="Curve" time="0" value="255" out="Fast"/>
                                <Key type="Curve" time="2" value="0" in="Slow"/>
                                <Key type="Curve" time="4" value="255" out="Fast"/>
                            </Controller>
                        </Animation>
                    </Frame>
                    
                    <Animation name="FlagGlow">
                        <Event event="OnShown" action="Reset,Play" frame="$parent/NewMutatorIndicator"/>
                        <Event event="OnHidden" action="Reset,Stop" frame="$parent/NewMutatorIndicator"/>

                        <Controller type="Rotation" relative="False" end="Loop">
                            <Key type="Curve" time="0" value="0" out="Linear"/>
                            <Key type="Curve" time="5" value="360" in="Linear"/>
                        </Controller>

                        <Controller name="Show" type="Visibility" end="Pause">
                            <Key type="Bool" time="0" value="true"/>
                        </Controller>
                    </Animation>
                </Frame>

                <Frame type="Frame" name="NewMutatorHelperFrame">
                    <Anchor relative="$parent/NewMutatorIndicator"/>
                    <Visible val="false"/>
                    <Animation name="Show">
                        <Event event="Show" action="Reset,Play" frame="$parent/$parent/CommanderSelectionPanel/MutatorInfoPanel"/>
                        
                        <Controller name="Show" type="Visibility" end="Pause">
                            <Key type="Bool" time="0" value="true"/>
                            <Key type="Bool" time="0.1" value="false"/>
                        </Controller>
                    </Animation>

                    <StateGroup name="ShowMutatorIndicatorGroup">
                        <State name="ShowMutatorIndicatorState">
                            <When type="Property" frame="$this" Visible="true"/>
                            <When type="StateGroup" frame="$CM_ScreenCoopCampaign" ModeState="ModeStandard"/>
                            <Action type="SendEvent" frame="$parent/NewMutatorIndicator" event="Show"/>
                        </State>
                    </StateGroup>
                </Frame>

                <Frame type="Frame" name="NewMutatorIndicator">
                    <Anchor side="Bottom" relative="$parent/MutatorButton" pos="Max" offset="11"/>
                    <Anchor side="Right" relative="$parent/MutatorButton/Label" pos="Max" offset="21"/>
                    <Width val="36"/>
                    <Height val="36"/>
                    <Visible val="false"/>

                    <Frame type="Image" name="IconImage">
                        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_TopNav_NewContent"/>
                        <Width val="36"/>
                        <Height val="36"/>
                    </Frame>

                    <Animation name="Show">
                        <Event event="Show" action="Reset,Play" frame="$this"/>
                        <Event event="OnClick" action="Reset,Stop" frame="$parent/MutatorButton"/>
                        <Event event="ModeMutator" action="Reset,Stop" frame="$parent/$parent"/>
                        
                        <Controller name="Show" type="Visibility" end="Pause">
                            <Key type="Bool" time="0" value="true"/>
                        </Controller>

                        <Controller type="Tooltip" end="Pause" frame="$parent/MutatorButton">
                            <Key type="Text" time="0" text="@CMUI/ScreenNavigation/NewMutation"/>
                        </Controller>
                    </Animation>
                </Frame>
                
                <!-- <Frame type="VersionNotificationFrame" name="CustomNewContentIndicator"> -->
                <Frame type="Frame" name="CustomNewContentIndicator">
                    <Anchor side="Bottom" relative="$parent/CustomButton" pos="Max" offset="11"/>
                    <Anchor side="Right" relative="$parent/CustomButton/Label" pos="Max" offset="21"/>
                    <Width val="36"/>
                    <Height val="36"/>
                    <Visible val="False"/>
                    <!-- <Version val="1"/> -->
                    <!-- <SettingName val="CustomButton"/> -->
                    
                    <Animation name="VersionState">
                        <Event event="NewVersion" action="Reset,Play"/>
                        <Event event="OldVersion" action="Reset,Stop"/>
                        <Event event="InvalidVersion" action="Reset,Stop"/>
                        <Controller type="Visibility" end="Pause">
                            <Key type="Bool" time="0" value="True"/>
                        </Controller>
                        <Controller type="Tooltip" end="Pause" frame="$parent/CustomButton">
                            <Key type="Text" time="0" text="@CMUI/ScreenNavigation/NewMode"/>
                        </Controller>
                    </Animation>
                 
                    <!-- The name of this animation must be "ClearNotification" -->
                    <!-- When played, it will update the version of this notification  -->
                    <Animation name="ClearNotification">
                        <Event event="OnClick" action="Reset,Play" frame="$parent/CustomButton"/>
                        <Event event="Toggled" action="Reset,Play" frame="$parent/CustomButton"/>
                 
                        <Controller type="Event" end="Stop">
                            <Key type="Event" time="0.0" event="NoOp"/>
                            <Key type="Event" time="1.0" event="NoOp"/>
                        </Controller>

                        <Controller type="Tooltip" end="Pause" frame="$parent/CustomButton">
                            <Key type="Text" time="0" text=""/>
                        </Controller>
                    </Animation>
                        
                    <Frame type="Image" name="NewContentFlagBg">
                        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_TopNav_NewContentGlow"/>
                        <Width val="36"/>
                        <Height val="36"/>

                        <Animation name="FlagGlow">
                            <Event event="OnShown" action="Reset,Play" frame="$parent"/>
                            <Event event="OnHidden" action="Stop" frame="$parent"/>

                            <Controller type="Rotation" relative="False" end="Loop">
                                <Key type="Curve" time="0" value="0" out="Linear"/>
                                <Key type="Curve" time="5" value="360" in="Linear"/>
                            </Controller>
                        </Animation>
                    </Frame>

                    <Frame type="Image" name="NewContentFlag">
                        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_TopNav_NewContent"/>
                        <Width val="36"/>
                        <Height val="36"/>
                    </Frame>
                    
                    <Frame type="Image" name="NewContentFlagGlow">
                        <Anchor side="Bottom" relative="$parent/NewContentFlag" pos="Max" offset="0"/>
                        <Anchor side="Left" relative="$parent/NewContentFlag" pos="Mid" offset="0"/>
                        <Anchor side="Right" relative="$parent/NewContentFlag" pos="Mid" offset="0"/>
                        <Texture val="@UI/Glues_Battlenet_TopNav_NewContentBg"/>
                        <Width val="36"/>
                        <Height val="36"/>
                        <Alpha val="0"/>
                        
                        <Animation name="FlagGlow">
                            <Event event="OnShown" action="Reset,Play" frame="$parent"/>
                            <Event event="OnHidden" action="Stop" frame="$parent"/>

                            <Controller type="Rotation" relative="False" end="Loop">
                                <Key type="Curve" time="0" value="0" out="Linear"/>
                                <Key type="Curve" time="5" value="360" in="Linear"/>
                            </Controller>

                            <Controller type="Fade" end="Loop">
                                <Key type="Curve" time="0" value="255" out="Fast"/>
                                <Key type="Curve" time="2" value="0" in="Slow"/>
                                <Key type="Curve" time="4" value="255" out="Fast"/>
                            </Controller>
                        </Animation>
                    </Frame>
                </Frame>
            </Frame>
    </Frame>
</Desc>

