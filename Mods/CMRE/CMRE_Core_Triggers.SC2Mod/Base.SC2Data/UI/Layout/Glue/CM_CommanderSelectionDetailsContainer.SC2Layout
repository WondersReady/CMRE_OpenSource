    <!--

    Commander Status Detail Container Template

    -->

    <Frame type="Frame" name="StatusMasteryValueRowTemplate">
        <Width val="404"/>
        <Height val="32"/>

        <Frame type="Image" name="BottomLine">
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Height val="1"/>
            <Texture val="Assets/Textures/white.dds"/>
            <Color val="37,107,169"/>
            <Alpha val="180"/>
            <Visible val="False"/>
        </Frame>

        <Frame type="Label" name="NameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-74"/>
            <Style val="StandardTabButton_Normal"/>
            <Text val="@CMUI/ScreenCoopCampaign/StatusUnset"/>
            <Options val="NoWrapping | Ellipsis | TooltipIfTruncated"/>
        </Frame>

        <Frame type="Image" name="ColumnDivider">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-70"/>
            <Width val="1"/>
            <Texture val="Assets/Textures/white.dds"/>
            <Color val="37,107,169"/>
            <Alpha val="180"/>
            <Visible val="False"/>
        </Frame>

        <Frame type="Label" name="ValueLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/ColumnDivider" pos="Max" offset="6"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Style val="StandardTabButton_Normal"/>
            <Options val="NoWrapping | Ellipsis | TooltipIfTruncated"/>
            <Text val="@CMUI/ScreenCoopCampaign/StatusUnset"/>
        </Frame>
    </Frame>

