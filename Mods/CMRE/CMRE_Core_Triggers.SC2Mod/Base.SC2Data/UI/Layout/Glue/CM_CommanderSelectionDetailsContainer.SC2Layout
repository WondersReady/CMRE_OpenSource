<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    
    
    <!-- 
    
    Commander Trait Ability Info Container Template 
    
    -->
    
    <Frame type="Frame" name="AbilContainerTemplate">
        <Width val="504"/>
        <Height val="415"/>

        <Frame type="Image" name="Background">
            <Anchor relative="$parent"/>
            <Texture val="@UI/SC2_UI_Coop_TooltipBG"/>
            <TextureType val="NineSlice"/>
        </Frame>
        
        <Frame type="Image" name="HoriztonalBorder">
            <Anchor side="Top" relative="$parent/LevelCapWarningLabel" pos="Max" offset="5"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="4"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-4"/>
            <Height val="2"/>
            <LayerColor val="00a8ff"/>
            <Alpha val="102"/>
            <PreserveAnchorOffset val="True"/>
            
            <StateGroup name="AnchorState">
                <DefaultState val="TitleAnchored"/>
                
                <State name="CapAnchored">
                    <When type="Property" frame="$parent/LevelCapWarningLabel" Visible="True"/>
                    <Action type="SetAnchor" side="Top" relative="$parent/LevelCapWarningLabel" pos="Max" offset="5"/>
                </State>
                
                <State name="TitleAnchored">
                    <Action type="SetAnchor" side="Top" relative="$parent/LevelCapWarningLabel" pos="Max" offset="9"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Label" name="LevelLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="14"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="25"/>
            <Style val="@Coop_AbilTooltip_LevelLabel"/>
            <Text val=""/>
        </Frame>

        <Frame type="Label" name="ExperienceLabel">
            <Anchor side="Top" relative="$parent/LevelLabel" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/LevelLabel" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/LevelLabel" pos="Max" offset="5"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-20"/>
            <Style val="@Coop_AbilTooltip_ExperienceLabel"/>
            <Text val=""/>

            <StateGroup name="MaxLevelStateGroup">
                <DefaultState val="NotMaxLevelState"/>
                
                <State name="MaxLevelState">
                    <When type="AnimationState" frame="$CM_CoopStandardGlue_CommanderSelectionPanel" CommanderMaxLevel="MaxLevel"/>
                    <Action type="SetProperty" frame="$this" Text="@CMUI/ScreenCoopCampaign/ExperienceMaxTooltip"/>
                </State>

                <State name="NotMaxLevelState">
                    <When type="AnimationState" frame="$CM_CoopStandardGlue_CommanderSelectionPanel" CommanderMaxLevel="NotMaxLevel"/>
                    <Action type="SetProperty" frame="$this" Text=""/>
                </State>
            </StateGroup>
        </Frame>
        
        <Frame type="Label" name="LevelCapWarningLabel">
            <Anchor side="Top" relative="$parent/LevelLabel" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent/LevelLabel" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-50"/>
            <Text val="@CMUI/ScreenCoopCampaign/XPCappedHint"/>
            <Style val="Coop_TraitTooltip_Warning"/>
            <CollapseLayout val="True"/>
            <Visible val="{$parent/$parent/DetailsContainer/DetailsBackground/CappedLevelLabel/@Visible}"/>
        </Frame>
        
        <Frame type="Image" name="CappedIcon">
            <Anchor side="Top" relative="$parent" pos="Min" offset="19"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-19"/>
            <Texture val="@UI/SC2_UI_Coop_CappedIcon_Small_Overlay"/>
            <Visible val="{$parent/LevelCapWarningLabel/@Visible}"/>
        </Frame>

        <Frame type="Label" name="Title">
            <Anchor side="Top" relative="$parent/HoriztonalBorder" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="25"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="@Coop_TraitTooltip_Title"/>
            <Text val=""/>
        </Frame>

        <Frame type="Frame" name="TileList">
            <Anchor side="Top" relative="$parent/Title" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>

            <!-- <Frame type="CommanderAbilTileListItem" name="Item0" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate"> -->
            <Frame type="Button" name="Item0" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate">
                <Anchor side="Top" relative="$parent" pos="Min" offset="15"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="23"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-20"/>
            </Frame>

            <!-- <Frame type="CommanderAbilTileListItem" name="Item1" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate"> -->
            <Frame type="Button" name="Item1" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate">
                <Anchor side="Top" relative="$parent/Item0" pos="Max" offset="5"/>
                <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/Item0" pos="Max" offset="0"/>
            </Frame>

            <!-- <Frame type="CommanderAbilTileListItem" name="Item2" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate"> -->
            <Frame type="Button" name="Item2" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate">
                <Anchor side="Top" relative="$parent/Item1" pos="Max" offset="5"/>
                <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/Item0" pos="Max" offset="0"/>
            </Frame>

            <!-- <Frame type="CommanderAbilTileListItem" name="Item3" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate"> -->
            <Frame type="Button" name="Item3" template="CM_CommanderSelectionDetailsContainerItems/CommanderAbilTileListItemTemplate">
                <Anchor side="Top" relative="$parent/Item2" pos="Max" offset="5"/>
                <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/Item0" pos="Max" offset="0"/>
            </Frame>
            
            <Frame type="Frame" name="ListPadding">
                <Anchor side="Top" relative="$parent/Item3" pos="Max" offset="5"/>
                <Anchor side="Left" relative="$parent/Item0" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/Item0" pos="Max" offset="0"/>
                <Height val="20"/>
            </Frame>
        </Frame>
    </Frame>
    
    <!--
    
    Commander Info Detail Container Template
    
