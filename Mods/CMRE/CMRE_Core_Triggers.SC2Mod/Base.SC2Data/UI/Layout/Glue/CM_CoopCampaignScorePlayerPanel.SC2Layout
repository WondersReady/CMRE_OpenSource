<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="Frame" name="MasteryTitleRowTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="30"/>

        <Frame type="Label" name="NameLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Coop_ScoreScreen_StatSource"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
            <AcceptsMouseTooltip val="true"/>
            <TooltipFrame val="BattleNetTooltip"/>

            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="MasteryValueRowTemplate">
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <Height val="30"/>

        <Frame type="Label" name="ValueLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Coop_ScoreScreen_StatCommander"/>
        </Frame>
    </Frame>

    <Frame type="Frame" name="PlayerFrameTemplate">
        <Width val="620"/>
        <Height val="326"/>

        <Frame type="Image" name="HeaderImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Height val="64"/>
            <Texture val="@UI/SC2_UI_Tournament_NextInfo_BG_Large"/>
        </Frame>

        <Frame type="Label" name="CommanderLabel">
            <Anchor side="Top" relative="$parent/HeaderImage" pos="Min" offset="4"/>
            <Anchor side="Left" relative="$parent/HeaderImage" pos="Min" offset="18"/>
            <Anchor side="Right" relative="$parent/HeaderImage" pos="Max" offset="-18"/>
            <Style val="Coop_ScoreScreen_StatNameCommander"/>
            <Height val="28"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
        </Frame>

        <Frame type="Label" name="PlayerNameLabel">
            <Anchor side="Top" relative="$parent/CommanderLabel" pos="Max" offset="-1"/>
            <Anchor side="Left" relative="$parent/HeaderImage" pos="Min" offset="18"/>
            <Anchor side="Right" relative="$parent/HeaderImage" pos="Max" offset="-18"/>
            <Height val="20"/>
            <Style val="Coop_ScoreScreen_PlayerNameCommander"/>
            <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
        </Frame>

        <Frame type="Frame" name="TitlesFrame">
            <Anchor side="Top" relative="$parent/PlayerNameLabel" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
            <Anchor side="Bottom" relative="$this/MasteryRow6" pos="Max" offset="0"/>
            <Width val="320"/>

            <Frame type="Label" name="PrestigeTitleLabel">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Height val="30"/>
                <Style val="Coop_ScoreScreen_StatSource"/>
                <Text val="@CMUI/ScreenCoopCampaign/ScorePanel/Prestige"/>
            </Frame>

            <Frame type="Label" name="MasteryTitleLabel">
                <Anchor side="Top" relative="$parent/PrestigeTitleLabel" pos="Max" offset="8"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Height val="28"/>
                <Style val="Coop_ScoreScreen_StatNameBreakdown"/>
                <Text val="@CMUI/ScreenCoopCampaign/ScorePanel/MasteryAllocation"/>
            </Frame>

            <Frame type="Frame" name="MasteryRow1" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryTitleLabel" pos="Max" offset="2"/>
            </Frame>
            <Frame type="Frame" name="MasteryRow2" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryRow1" pos="Max" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryRow3" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryRow2" pos="Max" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryRow4" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryRow3" pos="Max" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryRow5" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryRow4" pos="Max" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryRow6" template="CM_CoopCampaignScorePlayerPanel/MasteryTitleRowTemplate">
                <Anchor side="Top" relative="$parent/MasteryRow5" pos="Max" offset="0"/>
            </Frame>
        </Frame>

        <Frame type="Frame" name="ValuesFrame">
            <Anchor side="Top" relative="$parent/TitlesFrame" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/TitlesFrame" pos="Max" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
            <Anchor side="Bottom" relative="$this/MasteryValueRow6" pos="Max" offset="0"/>

            <Frame type="Label" name="PrestigeLabel">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Height val="30"/>
                <Style val="Coop_ScoreScreen_StatCommander"/>
                <Options val="Ellipsis | TooltipIfTruncated | NoWrapping"/>
            </Frame>

            <Frame type="Frame" name="MasteryValueRow1" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow1" pos="Min" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow2" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow2" pos="Min" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow3" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow3" pos="Min" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow4" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow4" pos="Min" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow5" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow5" pos="Min" offset="0"/>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow6" template="CM_CoopCampaignScorePlayerPanel/MasteryValueRowTemplate">
                <Anchor side="Top" relative="$parent/$parent/TitlesFrame/MasteryRow6" pos="Min" offset="0"/>
            </Frame>
        </Frame>
    </Frame>

    <Frame type="Frame" name="AllyPlayerFrameTemplate" template="CM_CoopCampaignScorePlayerPanel/PlayerFrameTemplate">
        <Frame type="Label" name="CommanderLabel">
            <Style val="Coop_ScoreScreen_StatNameAlly"/>
        </Frame>

        <Frame type="Label" name="PlayerNameLabel">
            <Style val="Coop_ScoreScreen_PlayerNameAlly"/>
        </Frame>

        <Frame type="Frame" name="ValuesFrame">
            <Frame type="Label" name="PrestigeLabel">
                <Style val="Coop_ScoreScreen_StatAlly"/>
            </Frame>

            <Frame type="Frame" name="MasteryValueRow1">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow2">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow3">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow4">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow5">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
            <Frame type="Frame" name="MasteryValueRow6">
                <Frame type="Label" name="ValueLabel"><Style val="Coop_ScoreScreen_StatAlly"/></Frame>
            </Frame>
        </Frame>
    </Frame>

    <Frame type="Frame" name="ChaosHistoryRowTemplate">
        <Width val="1038"/>
