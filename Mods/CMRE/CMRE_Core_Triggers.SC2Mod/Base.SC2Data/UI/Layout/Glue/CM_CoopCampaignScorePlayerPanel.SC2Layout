        <Frame type="Frame" name="Mutator9" template="Coop_MutatorList/MutatorLargeListItemTemplate"><Anchor side="Top" relative="$parent/Mutator8" pos="Min" offset="0"/><Anchor side="Left" relative="$parent/Mutator8" pos="Max" offset="2"/></Frame>
