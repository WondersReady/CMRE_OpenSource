        <Frame type="Frame" name="Mutator11" template="Coop_MutatorList/MutatorLargeListItemTemplate"><Anchor side="Top" relative="$parent/Mutator10" pos="Min" offset="0"/><Anchor side="Left" relative="$parent/Mutator10" pos="Max" offset="2"/></Frame>
        <Frame type="Frame" name="Mutator12" template="Coop_MutatorList/MutatorLargeListItemTemplate"><Anchor side="Top" relative="$parent/Mutator11" pos="Min" offset="0"/><Anchor side="Left" relative="$parent/Mutator11" pos="Max" offset="2"/></Frame>
