    <Frame type="Frame" name="ScorePlayerPanelTemplate">
        <Width val="1320"/>
        <Height val="620"/>

        <Frame type="Frame" name="PlayerFrame1" template="CM_CoopCampaignScorePlayerPanel/PlayerFrameTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
        </Frame>

        <Frame type="Frame" name="PlayerFrame2" template="CM_CoopCampaignScorePlayerPanel/AllyPlayerFrameTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-20"/>
        </Frame>

        <Frame type="Frame" name="ChaosHistoryPanel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="342"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-20"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>

            <Frame type="Label" name="ChaosHistoryTitleLabel">
                <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent/ChaosActiveCountLabel" pos="Min" offset="-10"/>
                <Height val="34"/>
                <Style val="Coop_ScoreScreen_StatNameBreakdown"/>
                <Text val="@CMUI/ScreenCoopCampaign/ScorePanel/ChaosHistory"/>
            </Frame>

            <Frame type="Label" name="ChaosActiveCountLabel">
                <Anchor side="Top" relative="$parent/ChaosHistoryTitleLabel" pos="Min" offset="0"/>
                <Anchor side="Bottom" relative="$parent/ChaosHistoryTitleLabel" pos="Max" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <AutoSizeClamps maxWidth="320"/>
                <Style val="Coop_ScoreScreen_StatCommander"/>
                <Options val="NoWrapping"/>
            </Frame>

            <Frame type="Image" name="ChaosHistoryBackground">
                <Anchor side="Top" relative="$parent/ChaosHistoryTitleLabel" pos="Max" offset="4"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
                <Texture val="@UI/Glues_Battlenet_PageAssets_ContainerBorder"/>
                <TextureType val="NineSlice"/>
            </Frame>

            <Frame type="Frame" name="ChaosHistoryGrid">
                <Anchor side="Top" relative="$parent/ChaosHistoryBackground" pos="Min" offset="6"/>
                <Anchor side="Left" relative="$parent/ChaosHistoryBackground" pos="Min" offset="10"/>
                <Width val="1038"/>
                <Height val="157"/>

                <Frame type="Frame" name="Row1" template="CM_CoopCampaignScorePlayerPanel/ChaosHistoryRowTemplate">
                    <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                </Frame>
                <Frame type="Frame" name="Row2" template="CM_CoopCampaignScorePlayerPanel/ChaosHistoryRowTemplate">
                    <Anchor side="Top" relative="$parent/Row1" pos="Max" offset="2"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                </Frame>
                <Frame type="Frame" name="Row3" template="CM_CoopCampaignScorePlayerPanel/ChaosHistoryRowTemplate">
                    <Anchor side="Top" relative="$parent/Row2" pos="Max" offset="2"/>
                    <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
                </Frame>
            </Frame>
        </Frame>
    </Frame>
</Desc>
