        <Frame type="Frame" name="Mutator2" template="Coop_MutatorList/MutatorLargeListItemTemplate"><Anchor side="Top" relative="$parent/Mutator1" pos="Min" offset="0"/><Anchor side="Left" relative="$parent/Mutator1" pos="Max" offset="2"/></Frame>
        <Frame type="Frame" name="Mutator3" template="Coop_MutatorList/MutatorLargeListItemTemplate"><Anchor side="Top" relative="$parent/Mutator2" pos="Min" offset="0"/><Anchor side="Left" relative="$parent/Mutator2" pos="Max" offset="2"/></Frame>
