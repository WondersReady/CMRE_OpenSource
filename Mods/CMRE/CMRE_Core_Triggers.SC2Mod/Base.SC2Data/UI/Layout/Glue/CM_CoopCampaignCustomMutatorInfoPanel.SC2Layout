<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Frame type="Frame" name="CoopCampaignCustomMutatorInfoPanelTemplate">
        <Anchor relative="$parent"/>
        
        <Frame type="Image" name="CustomMutatorInfo">
            <Anchor side="Top" relative="$parent/$parent/Title" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/$parent/Title" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/$parent/Title" pos="Max" offset="10"/>
            <Width val="43"/>
            <Height val="43"/>
            <Texture val="@UI/Glues_Icons_GenericInfo"/>
            <AcceptsMouse val="true"/>
            <Tooltip val="@CMUI/ScreenCoopCampaign/Custom/InfoPanel/Warning"/>
            <TooltipFrame val="BattleNetTooltip"/>
            <Frame type="StandardTooltip" name="BattleNetTooltip" template="CM_SharedTemplates/StandardBattlenetTooltipTemplate"/>
        </Frame>
    </Frame>
</Desc>

