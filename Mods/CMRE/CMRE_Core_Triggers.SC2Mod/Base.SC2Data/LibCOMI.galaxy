    libNtve_gf_CreateUnitsAtPoint2(1, lv_newUnitType, c_unitCreateIgnorePlacement, lv_owner, lv_spawnPosition);
    UnitGroupAdd(libCOMI_gv_cM_Zeratul_DevolvedUnits, UnitLastCreated());
