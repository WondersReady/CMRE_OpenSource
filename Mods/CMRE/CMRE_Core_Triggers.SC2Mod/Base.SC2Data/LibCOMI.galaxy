    libCOMI_gt_CM_Tychus_HeroReviveFailSafe = TriggerCreate("libCOMI_gt_CM_Tychus_HeroReviveFailSafe_Func");
    TriggerEnable(libCOMI_gt_CM_Tychus_HeroReviveFailSafe, false);
    TriggerAddEventUnitCreated(libCOMI_gt_CM_Tychus_HeroReviveFailSafe, null, "TychusFakeReviveTrain", null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: CM_Tychus_OilBombFireDamageResponse
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Tychus_OilBombFireDamageResponse_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_oilcaster;
    int lv_tychusPlayer;
    int[libCOOC_gv_cCC_MAXPLAYERS + 1] lv_tychusPoints;

    // Automatic Variable Declarations
    playergroup auto9F6678CD_g;
    playergroup autoF27CE927_g;
    playergroup autoDFE770B2_g;

    // Variable Initialization
    lv_oilcaster = libCOMI_gv_cM_Tychus_FirebatOilCaster;

    // Conditions
    if (testConds) {
        if (!((CatalogFieldValueGet(c_gameCatalogEffect, EventUnitDamageEffect(), "Death", EventUnitDamageSourcePlayer()) == "Fire"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto9F6678CD_g = libCOOC_gf_CC_PlayersOfCommander("TerranTychus");
    lv_tychusPlayer = -1;
    while (true) {
        lv_tychusPlayer = PlayerGroupNextPlayer(auto9F6678CD_g, lv_tychusPlayer);
        if (lv_tychusPlayer < 0) { break; }
        if ((TechTreeUpgradeCount(lv_tychusPlayer, "TychusFirebatOwned", c_techCountCompleteOnly) == 1) && (libNtve_gf_PlayerIsEnemy(lv_tychusPlayer, UnitGetOwner(EventUnit()), libNtve_ge_PlayerRelation_Enemy) == true)) {
            if ((TechTreeUpgradeCount(lv_tychusPlayer, "CommanderPrestigeTychusLoneWolfRecruitment", c_techCountCompleteOnly) > 0)) {
                lv_tychusPoints[lv_tychusPlayer] += TechTreeUpgradeCount(lv_tychusPlayer, "CommanderPrestigeTychusLoneWolfRecruitment", c_techCountQueuedOrBetter);
            }

            if ((TechTreeUpgradeCount(lv_tychusPlayer, "TychusFirebatBlueFlameOil", c_techCountCompleteOnly) == 1)) {
                lv_tychusPoints[lv_tychusPlayer] += 1;
            }

            if ((TechTreeUpgradeCount(lv_tychusPlayer, "TychusFirebatBlueFlameOil", c_techCountCompleteOnly) == 1)) {
                lv_tychusPoints[lv_tychusPlayer] += 1;
            }

        }

    }
    autoF27CE927_g = libCOOC_gf_CC_PlayersOfCommander("TerranTychus");
    lv_tychusPlayer = -1;
    while (true) {
        lv_tychusPlayer = PlayerGroupNextPlayer(autoF27CE927_g, lv_tychusPlayer);
        if (lv_tychusPlayer < 0) { break; }
        if ((lv_oilcaster == null)) {
            libCOMI_gv_cM_Tychus_FirebatOilCaster = UnitGroupUnit(UnitGroup("TychusFirebat", lv_tychusPlayer, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), 0), 0), 1);
            lv_oilcaster = libCOMI_gv_cM_Tychus_FirebatOilCaster;
        }
        else {
            if ((lv_tychusPoints[lv_tychusPlayer] > lv_tychusPoints[UnitGetOwner(lv_oilcaster)])) {
                libCOMI_gv_cM_Tychus_FirebatOilCaster = UnitGroupUnit(UnitGroup("TychusFirebat", lv_tychusPlayer, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), 0), 0), 1);
                lv_oilcaster = libCOMI_gv_cM_Tychus_FirebatOilCaster;
            }

        }
    }
    if ((UnitIsAlive(EventUnit()) == true)) {
        UnitBehaviorAdd(EventUnit(), "TychusFirebatOilFire", lv_oilcaster, 1);
    }
    else {
        autoDFE770B2_g = libCOOC_gf_CC_PlayersOfCommander("TerranTychus");
        lv_tychusPlayer = -1;
        while (true) {
            lv_tychusPlayer = PlayerGroupNextPlayer(autoDFE770B2_g, lv_tychusPlayer);
            if (lv_tychusPlayer < 0) { break; }
            if ((TechTreeUpgradeCount(lv_tychusPlayer, "TychusFirebatIncendiaryPetroleum", c_techCountCompleteOnly) > 0)) {
                UnitCreateEffectPoint(lv_oilcaster, "TychusFirebatOilFireSearchTrigger", UnitGetPosition(EventUnit()));
                break;
            }

        }
    }
    return true;
}

