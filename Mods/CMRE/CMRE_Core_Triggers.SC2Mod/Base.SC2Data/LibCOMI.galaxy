void libCOMI_gf_CM_Stetmann_ApplyPlayerBonus (int lp_targetPlayer, int lp_mSSelf, int lp_hPSelf, int lp_mPSelf, int lp_mSAlly, int lp_hPAlly, int lp_mPAlly) {
    // Variable Declarations
    fixed lv_multiplayerCodeMSSelf;
    fixed lv_multiplayerCodeMSAlly;
    fixed lv_multiplayerCodeHPSelf;
    fixed lv_multiplayerCodeHPAlly;
    fixed lv_multiplayerCodeMPSelf;
    fixed lv_multiplayerCodeMPAlly;
    fixed lv_selfCode;
    fixed lv_allyCode;
    fixed lv_code;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_multiplayerCodeMSSelf = 0.02;
    lv_multiplayerCodeMSAlly = 0.01;
    lv_multiplayerCodeHPSelf = 0.2;
    lv_multiplayerCodeHPAlly = 0.1;
    lv_multiplayerCodeMPSelf = 0.1;
    lv_multiplayerCodeMPAlly = 0.05;

    // Implementation
    lv_selfCode = (1.0 + (IntToFixed(lp_mSSelf) * lv_multiplayerCodeMSSelf));
    lv_allyCode = (1.0 + (IntToFixed(lp_mSAlly) * lv_multiplayerCodeMSAlly));
    lv_code = (lv_selfCode * lv_allyCode);
    CatalogFieldValueSet(c_gameCatalogBehavior, "PowerFieldBuffStetmannBuff", "Modification.MoveSpeedMultiplier", lp_targetPlayer, FixedToString(lv_code, 2));
    CatalogFieldValueSet(c_gameCatalogBehavior, "PowerFieldBuffStetmannBuff", "Modification.AccelerationMultiplier", lp_targetPlayer, FixedToString(lv_code, 2));
    lv_selfCode = (0.0 + (IntToFixed(lp_hPSelf) * lv_multiplayerCodeHPSelf));
    lv_allyCode = (0.0 + (IntToFixed(lp_hPAlly) * lv_multiplayerCodeHPAlly));
    lv_code = (lv_selfCode + lv_allyCode);
    CatalogFieldValueSet(c_gameCatalogEffect, "PowerFieldBuffStetmannLifeRestore", "RechargeVitalRate", lp_targetPlayer, FixedToString(lv_code, 2));
    lv_selfCode = (0.0 + (IntToFixed(lp_mPSelf) * lv_multiplayerCodeMPSelf));
    lv_allyCode = (0.0 + (IntToFixed(lp_mPAlly) * lv_multiplayerCodeMPAlly));
    lv_code = (lv_selfCode + lv_allyCode);
    CatalogFieldValueSet(c_gameCatalogEffect, "PowerFieldBuffStetmannEnergyRestore", "RechargeVitalRate", lp_targetPlayer, FixedToString(lv_code, 2));
}

