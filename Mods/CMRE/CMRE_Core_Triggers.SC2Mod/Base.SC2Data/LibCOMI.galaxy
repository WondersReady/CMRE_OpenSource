    libCOMI_gv_cM_UnitName_CountCurrentPosition += libCOMI_gv_cM_UnitName_CountStep;
    if ((libCOMI_gv_cM_UnitName_CountCurrentPosition > libCOMI_gv_cMC_UnitName_CountMax)) {
        libCOMI_gv_cM_UnitName_CountCurrentPosition -= libCOMI_gv_cMC_UnitName_CountMax;
    }

    if ((libCOMI_gv_cM_UnitName_CountCurrentPosition < 1)) {
        libCOMI_gv_cM_UnitName_CountCurrentPosition += libCOMI_gv_cMC_UnitName_CountMax;
    }

    return true;
}

