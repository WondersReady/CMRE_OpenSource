        if (((libCOMI_gf_DifficultyLevelForPlayerCoop(lp_dehakaPlayer) == 3) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lp_dehakaPlayer) == 4) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lp_dehakaPlayer) == 5) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lp_dehakaPlayer) == 6)) && (lv_dehakaCurrentLevel >= 6) && (GameGetMissionTime() < 360.0)) {
            AchievementAward(lp_dehakaPlayer, "CommanderDehakaLevelUp");
