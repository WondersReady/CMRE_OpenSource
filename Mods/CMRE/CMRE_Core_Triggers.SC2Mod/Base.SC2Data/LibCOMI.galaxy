// Trigger: CM_KaraxUnitReviveBarrier
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_KaraxUnitReviveBarrier_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    int lv_karaxPlayer;

    // Automatic Variable Declarations
    playergroup auto443DF28B_g;

    // Variable Initialization
    lv_player = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!((libCOOC_gf_PlayerIsCommander(lv_player) == true))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterStasis - 32)) | (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto443DF28B_g = libCOOC_gf_CC_PlayersOfCommander("ProtossKarax");
    lv_karaxPlayer = -1;
    while (true) {
        lv_karaxPlayer = PlayerGroupNextPlayer(auto443DF28B_g, lv_karaxPlayer);
        if (lv_karaxPlayer < 0) { break; }
        if ((libNtve_gf_PlayerIsEnemy(lv_karaxPlayer, lv_player, libNtve_ge_PlayerRelation_AllyMutual) == true) && (TechTreeUpgradeCount(lv_karaxPlayer, "KaraxUnitSpawnBarrier", c_techCountCompleteOnly) == 1)) {
            UnitBehaviorAdd(EventUnit(), "KaraxUnitSpawnBarrier", libCOMI_gv_cM_GlobalCasterUnit[lv_karaxPlayer], 1);
            return true;
        }

    }
    return true;
}

