void libCOMI_gf_CM_Mengsk_ForceMorphTrooper (int lp_player, unit lp_trooper, unit lp_pickup, string lp_morphEffect, string lp_morphBehavior, string lp_actorSignal) {
    // Automatic Variable Declarations
