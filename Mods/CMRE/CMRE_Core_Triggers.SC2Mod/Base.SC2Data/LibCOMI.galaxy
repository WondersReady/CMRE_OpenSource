//--------------------------------------------------------------------------------------------------
// Trigger: CM_Mengsk_VeterancyEarned
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Mengsk_VeterancyEarned_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_dyingunit;
    fixed lv_xp;
    unitgroup lv_veteranunits;
    int lv_veterancount;
    fixed lv_xppersupplyratio;
    fixed lv_heroicxpoverride;
    fixed lv_minimumearnedxp;
    fixed lv_xpradius;
    int lv_player;

    // Automatic Variable Declarations
    playergroup autoD97D124C_g;
    unitgroup auto9DCFEB60_g;
    int auto9DCFEB60_u;
    unit auto9DCFEB60_var;

    // Variable Initialization
    lv_dyingunit = EventUnit();
    lv_veteranunits = UnitGroupEmpty();
    lv_heroicxpoverride = 800.0;
    lv_minimumearnedxp = 1.0;
    lv_xpradius = 15.0;

    // Conditions
    if (testConds) {
        if (!((UnitFilterMatch(lv_dyingunit, 1, UnitFilter(0, 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterStructure) | (1 << c_targetFilterRawResource) | (1 << c_targetFilterHarvestableResource) | (1 << c_targetFilterMissile) | (1 << c_targetFilterDestructible) | (1 << c_targetFilterItem) | (1 << c_targetFilterUncommandable), (1 << (c_targetFilterHallucination - 32)))) == true))) {
            return false;
        }

        if (!((libNtve_gf_KillingPlayer() != c_playerAny))) {
            return false;
        }

        if (!((UnitHasBehavior2(lv_dyingunit, "NoBiomassDrop") == false))) {
            return false;
        }

        if (!((EventUnitDamageDeathCheck(c_deathTypeRemove) == false))) {
            return false;
        }

        if (!((libCOMU_gf_CT_UnitSpawnedByMutator(lv_dyingunit) == false))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(libCOOC_gf_CommanderPlayers(), libNtve_gf_KillingPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoD97D124C_g = libCOOC_gf_CC_PlayersOfCommander("TerranMengsk");
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(autoD97D124C_g, lv_player);
        if (lv_player < 0) { break; }
        if ((libNtve_gf_PlayerIsEnemy(lv_player, libNtve_gf_KillingPlayer(), libNtve_ge_PlayerRelation_AllyMutual) == true) && (libNtve_gf_PlayerIsEnemy(lv_player, UnitGetOwner(EventUnit()), libNtve_ge_PlayerRelation_Enemy) == true)) {
            lv_veteranunits = UnitGroupFilterRegion(libCOMI_gv_cM_Mengsk_XPHungryUnits[lv_player], RegionCircle(UnitGetPosition(lv_dyingunit), lv_xpradius), 0);
            lv_veterancount = UnitGroupCount(lv_veteranunits, c_unitCountAlive);
            lv_xppersupplyratio = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogEffect, "MengskRoyalGuardExperienceGainDummy", "Amount", lv_player);
            lv_xp = (UnitTypeGetProperty(UnitGetType(lv_dyingunit), c_unitPropSuppliesUsed) * lv_xppersupplyratio);
            if ((lv_xp <= 0.0) && (UnitFilterMatch(lv_dyingunit, 1, UnitFilter((1 << c_targetFilterHeroic), 0, 0, 0)) == true)) {
                lv_xp = lv_heroicxpoverride;
            }
            else if ((lv_xp <= 0.0)) {
                continue;
            }
            if ((lv_veterancount == 0)) {
                lv_veteranunits = UnitGroupCopy(libCOMI_gv_cM_Mengsk_XPHungryUnits[lv_player]);
                lv_veterancount = UnitGroupCount(lv_veteranunits, c_unitCountAlive);
                if ((lv_veterancount == 0)) {
                    continue;
                }

            }

            lv_xp = MaxF(Round((lv_xp / lv_veterancount)), lv_minimumearnedxp);
            auto9DCFEB60_g = lv_veteranunits;
            auto9DCFEB60_u = UnitGroupCount(auto9DCFEB60_g, c_unitCountAll);
            for (;; auto9DCFEB60_u -= 1) {
                auto9DCFEB60_var = UnitGroupUnitFromEnd(auto9DCFEB60_g, auto9DCFEB60_u);
                if (auto9DCFEB60_var == null) { break; }
                UnitXPAddXP(auto9DCFEB60_var, null, lv_xp);
            }
        }

    }
    return true;
}

