            UnitCreateEffectUnit(EventPlayerEffectUsedUnit(c_effectUnitTarget), "FenixVoidShieldCapacitorSetAutocast", EventPlayerEffectUsedUnit(c_effectUnitTarget));
        }

    }
    else {
    }
    return true;
}

