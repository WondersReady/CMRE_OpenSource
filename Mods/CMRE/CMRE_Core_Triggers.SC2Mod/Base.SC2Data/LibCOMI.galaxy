//--------------------------------------------------------------------------------------------------
// Trigger: CM_Stetmann_PowerFieldToggleRe
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Stetmann_PowerFieldToggleRe_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    playergroup lv_playergroup;
    int lv_upgradeCount;

    // Automatic Variable Declarations
    string autoF8A818FF_val;

    // Variable Initialization
    lv_player = EventPlayer();
    lv_playergroup = PlayerGroupSingle(lv_player);

    // Conditions
    if (testConds) {
        if (!((libCOOC_gf_ActiveCommanderForPlayer(EventPlayer()) == "ZergStetmann"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gv_cM_Stetmann_StetzoneChanged[lv_player] = true;
    DialogControlSetAnimationState(libCOUI_gv_cU_GPPanel[lv_player], lv_playergroup, "ReminderStetzones", "NoReminder");
    autoF8A818FF_val = EventPlayerEffectUsed();
    if (autoF8A818FF_val == "PowerFieldEnergyRegenerationOn") {
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldEnergyRegeneration", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldHPRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldMovementSpeed", 0);
        DialogControlSetAnimationState(libCOUI_gv_cU_GPPanel[EventPlayer()], lv_playergroup, "ActiveZone", "Energy");
        libCOMI_gv_cM_Stetmann_StetzoneMode[lv_player] = libCOMI_ge_CM_Stetmann_StetzoneMode_MPRegen;
    }
    else if (autoF8A818FF_val == "PowerFieldHPRegenerationOn") {
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldEnergyRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldHPRegeneration", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldMovementSpeed", 0);
        DialogControlSetAnimationState(libCOUI_gv_cU_GPPanel[EventPlayer()], lv_playergroup, "ActiveZone", "Health");
        libCOMI_gv_cM_Stetmann_StetzoneMode[lv_player] = libCOMI_ge_CM_Stetmann_StetzoneMode_HPRegen;
    }
    else if (autoF8A818FF_val == "PowerFieldMovementSpeedOn") {
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldEnergyRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldHPRegeneration", 0);
        libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "PowerFieldMovementSpeed", 1);
        DialogControlSetAnimationState(libCOUI_gv_cU_GPPanel[EventPlayer()], lv_playergroup, "ActiveZone", "Speed");
        libCOMI_gv_cM_Stetmann_StetzoneMode[lv_player] = libCOMI_ge_CM_Stetmann_StetzoneMode_MovementSpeed;
    }
    else {
    }
    libCOMI_gf_CM_Stetmann_PlayerBonusCalc();
    libCOMI_gf_CM_Stetmann_ColorCalc();
    return true;
}

