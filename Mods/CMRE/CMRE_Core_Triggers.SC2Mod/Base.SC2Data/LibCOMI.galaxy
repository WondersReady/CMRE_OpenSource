    libCOMI_gt_CM_Stetmann_PowerFieldToggleRe = TriggerCreate("libCOMI_gt_CM_Stetmann_PowerFieldToggleRe_Func");
    TriggerEnable(libCOMI_gt_CM_Stetmann_PowerFieldToggleRe, false);
    TriggerAddEventPlayerEffectUsed(libCOMI_gt_CM_Stetmann_PowerFieldToggleRe, c_playerAny, "PowerFieldEnergyRegenerationOn");
