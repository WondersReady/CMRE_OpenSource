//--------------------------------------------------------------------------------------------------
// Trigger: CM_Nova_Building Completed Trigger
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Nova_BuildingCompletedTrigger_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    unit lv_progressUnit;
    string lv_progressUnitType;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = UnitGetOwner(EventUnitProgressUnit());
    lv_progressUnit = EventUnitProgressUnit();
    lv_progressUnitType = UnitGetType(EventUnitProgressUnit());

    // Conditions
    if (testConds) {
        if (!(((lv_progressUnitType == "Barracks") || (lv_progressUnitType == "Factory") || (lv_progressUnitType == "Starport")))) {
            return false;
        }

        if (!((TechTreeUpgradeCount(lv_player, "NovaCommander", c_techCountCompleteOnly) >= 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gf_CM_PrestigeNova_SpecializeUnitCharges(lv_progressUnitType, lv_progressUnit, lv_player);
    if ((lv_progressUnitType == "Barracks")) {
        UnitAbilityAdd(lv_progressUnit, "BarracksTrainNova");
        if ((libCOMI_gv_novaBarrackBuilt[lv_player] == 0)) {
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(0) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(0) + "].Charge.CountMax", lv_player), "BarracksTrainNovaMarine", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(1) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(1) + "].Charge.CountMax", lv_player), "BarracksTrainMarauderNova", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(2) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "BarracksTrainNova", "InfoArray[" + IntToString(2) + "].Charge.CountMax", lv_player), "BarracksTrainGhostNova", lv_player);
            libCOMI_gv_novaBarrackBuilt[lv_player] = 1;
        }

    }
    else if ((lv_progressUnitType == "Factory")) {
        UnitAbilityAdd(lv_progressUnit, "FactoryTrainNova");
        if ((libCOMI_gv_novaFactoryBuilt[lv_player] == 0)) {
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(0) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(0) + "].Charge.CountMax", lv_player), "FactoryTrainGoliathNova", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(1) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(1) + "].Charge.CountMax", lv_player), "FactoryTrainSiegeTankNova", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(2) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "FactoryTrainNova", "InfoArray[" + IntToString(2) + "].Charge.CountMax", lv_player), "FactoryTrainHellbatNova", lv_player);
            libCOMI_gv_novaFactoryBuilt[lv_player] = 1;
        }

    }
    else if ((lv_progressUnitType == "Starport")) {
        UnitAbilityAdd(lv_progressUnit, "StarportTrainNova");
        if ((libCOMI_gv_novaStarportBuilt[lv_player] == 0)) {
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(0) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(0) + "].Charge.CountMax", lv_player), "StarportTrainBansheeNova", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(1) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(1) + "].Charge.CountMax", lv_player), "StarportTrainRavenNova", lv_player);
            libCOMI_gf_CM_ModifyCooldown(libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(2) + "].Charge.TimeUse", lv_player), libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, "StarportTrainNova", "InfoArray[" + IntToString(2) + "].Charge.CountMax", lv_player), "StarportTrainLiberatorNova", lv_player);
            libCOMI_gv_novaStarportBuilt[lv_player] = 1;
        }

    }
    return true;
}

