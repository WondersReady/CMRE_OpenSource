        return true;
    }

    UnitBehaviorRemove(lv_dehakaUnit, libCOMI_gv_c_DehakaConsumeBehaviorDisable, c_unitBehaviorCountAll);
    if ((UnitHasBehavior2(lv_targetUnit, "ImpalerDehakaTenderize") == true)) {
