//--------------------------------------------------------------------------------------------------
// Trigger: CM_Horner_SupplyAchievement
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Horner_SupplyAchievement_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((libCOOC_gf_ActiveCommanderForPlayer(EventPlayer()) == "TerranHorner"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gf_CM_HornerStatUpdate(lv_player);
    if (((libCOMI_gf_DifficultyLevelForPlayerCoop(lv_player) == 3) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lv_player) == 4) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lv_player) == 5) || (libCOMI_gf_DifficultyLevelForPlayerCoop(lv_player) == 6)) && ((libCOMI_gv_miraFactionSupply[lv_player] >= 80.0) && (libCOMI_gv_mattFactionSupply[lv_player] >= 40.0))) {
        AchievementAward(lv_player, "CommanderHornerSupply");
    }

    return true;
}

