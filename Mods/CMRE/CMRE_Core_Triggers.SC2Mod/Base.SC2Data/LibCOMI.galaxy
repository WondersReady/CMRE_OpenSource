    TriggerEnable(libCOMI_gt_CM_Zeratul_TransportDropOff, false);
    TriggerAddEventPlayerEffectUsed(libCOMI_gt_CM_Zeratul_TransportDropOff, c_playerAny, "ZeratulVoidSeekerTrigger");
