//--------------------------------------------------------------------------------------------------
// Trigger: CM_CampaignMissionIntroZoomIn
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_CampaignMissionIntroZoomIn_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_originalDistance;
    int lv_indexPlayer;
    int lv_panel;
    int lv_countdownContainer;
    int lv_countdownIndex;

    // Automatic Variable Declarations
    playergroup auto96B9D080_g;
    const int auto25E5650F_ae = 1;
    const int auto25E5650F_ai = -1;
    playergroup auto17ABACB5_g;

    // Variable Initialization
    lv_panel = c_invalidDialogId;
    lv_countdownContainer = c_invalidDialogControlId;

    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gf_CM_CommanderFromStormInit();
    UnitPauseAll(true);
    GameSetMissionTimePaused(true);
    AITimePause(true);
    CinematicFade(false, 0.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, true);
    libCOMI_gf_CinematicModeCampaign(true, c_transitionDurationImmediate, true);
    CinematicFade(true, 1.5, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    auto96B9D080_g = libCOOC_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto96B9D080_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        lv_originalDistance = CameraGetDistance(lv_indexPlayer);
        CameraSetValue(lv_indexPlayer, c_cameraValueDistance, (lv_originalDistance+8.0), 0.0, -1, 10.0);
        CameraSetValue(lv_indexPlayer, c_cameraValueDistance, lv_originalDistance, 1.5, -1, 10.0);
    }
    Wait(1.5, c_timeGame);
    UnitPauseAll(true);
    GameSetMissionTimePaused(true);
    AITimePause(true);
    DialogCreate(500, 400, c_anchorCenter, 0, 0, true);
    DialogSetImageVisible(DialogLastCreated(), false);
    DialogSetFullscreen(DialogLastCreated(), true);
    lv_panel = DialogLastCreated();
    DialogControlCreateFromTemplate(DialogLastCreated(), c_triggerControlTypePanel, "Coop_StartCountdown/CountdownContainer");
    lv_countdownContainer = DialogControlLastCreated();
    DialogControlCreateFromTemplate(DialogLastCreated(), c_triggerControlTypePanel, "Coop_StartCountdown/CountdownContainer");
    DialogSetVisible(lv_panel, PlayerGroupAll(), true);
    Wait(0.5, c_timeReal);
    SoundPlayForPlayer(SoundLink("AC_CM_UI_Countdown_4MxFull", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 2.0);
    lv_countdownIndex = 3;
    for ( ; ( (auto25E5650F_ai >= 0 && lv_countdownIndex <= auto25E5650F_ae) || (auto25E5650F_ai < 0 && lv_countdownIndex >= auto25E5650F_ae) ) ; lv_countdownIndex += auto25E5650F_ai ) {
        DialogControlSendAnimationEvent(lv_countdownContainer, PlayerGroupAll(), ("Countdown" + IntToString(lv_countdownIndex)));
        Wait(1.0, c_timeReal);
    }
    DialogDestroy(lv_panel);
    libCOMI_gf_CinematicModeCampaign(false, 1.0, false);
    auto17ABACB5_g = libCOOC_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto17ABACB5_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((PlayerGetPropertyInt(lv_indexPlayer, c_playerPropSuppliesLimit) == 0)) {
            UISetFrameVisible(PlayerGroupSingle(lv_indexPlayer), c_syncFrameTypeSupply, false);
        }

    }
    libCMFE_gf_CMUIX_OptimizationApplyStartupEntry();
    GameSetMissionTimePaused(false);
    AITimePause(false);
    UnitPauseAll(false);
    TriggerSendEvent("GameStart");
    return true;
}

