void libCOMI_gf_CM_Mengsk_GlobalPower_Caster_Created (int lp_player) {
    // Variable Declarations
    int lv_itPlayer;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_itPlayer = lp_player;

    // Implementation
    libCOMI_gf_CM_Mengsk_GlobalCasterEnergyRegen(libCOMI_gv_cM_GlobalCasterUnit[lv_itPlayer]);
    UnitSetPropertyFixed(libCOMI_gv_cM_GlobalCasterUnit[lv_itPlayer], c_unitPropEnergy, RoundI(UnitGetPropertyFixed(libCOMI_gv_cM_GlobalCasterUnit[lv_itPlayer], c_unitPropEnergy, c_unitPropCurrent)));
    libCOMI_gf_CM_Mengsk_EnergyChanged(lv_itPlayer);
}

void libCOMI_gf_CM_Nova_Commander_Mastery_After (int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    if ((TechTreeUpgradeCount(lp_player, "NovaCommander", c_techCountCompleteOnly) >= 1)) {
        libCOMI_gf_CM_Nova_IterateExistingBuildings(lp_player);
    }

}

void libCOMI_gf_CM_Nova_Hero_Revive_After (int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    libCOMI_gv_cM_Nova_Hero_BuyBack_Active[lp_player] = false;
    TechTreeUpgradeAddLevel(lp_player, "NovaBuybackUnlock", -1);
    CatalogFieldValueSet(c_gameCatalogAbil, "NovaReviveInstantBuyback", "Cost[" + IntToString(0) + "].Resource[" + IntToString(c_resourceTypeMinerals) + "]", lp_player, "450");
}

void libCOMI_gf_CM_Nova_Commander_Initial (int lp_player) {
    // Variable Declarations
    int lv_itPlayer;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_itPlayer = lp_player;

    // Implementation
    TriggerExecute(libCOMI_gt_UnitNames_GenerateNameList, false, false);
    TriggerEnable(libCOMI_gt_UnitNames_Assign, true);
    TriggerEnable(libCOMI_gt_UnitNames_KillCountUpdate, true);
    TriggerEnable(libCOMI_gt_UnitNames_KillCountUpdateLaserTurret, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportActived, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportStop, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportTimeOut, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportAirBehaviorApplied, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportGroundBehaviorApplied, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinTransportTeleportUnload, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinBombingRunActivated, true);
    TriggerEnable(libCOMI_gt_CM_NovaGriffinBombingRunFinish, true);
    TriggerEnable(libCOMI_gt_CM_NovaSiegeModeProgressiveRangeIncreaseApply, true);
    TriggerEnable(libCOMI_gt_CM_NovaPsiStrike, true);
    TriggerEnable(libCOMI_gt_CM_Nova_BuildingCompletedTrigger, true);
}

