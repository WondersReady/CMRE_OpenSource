    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto353C26BA_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        lv_originalDistance = CameraGetDistance(lv_indexPlayer);
        CameraSetValue(lv_indexPlayer, c_cameraValueDistance, (lv_originalDistance+12.0), 0.0, -1, 10.0);
        CameraSetValue(lv_indexPlayer, c_cameraValueDistance, lv_originalDistance, 2.0, -1, 10.0);
    }
    Wait(3.0, c_timeGame);
    libCOMI_gf_CinematicModeCampaign(false, 1.0, false);
    auto0AE78D9F_g = libCOOC_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto0AE78D9F_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((PlayerGetPropertyInt(lv_indexPlayer, c_playerPropSuppliesLimit) == 0)) {
            UISetFrameVisible(PlayerGroupSingle(lv_indexPlayer), c_syncFrameTypeSupply, false);
        }

    }
    libCMFE_gf_CMUIX_OptimizationApplyStartupEntry();
    GameSetMissionTimePaused(false);
    AITimePause(false);
    UnitPauseAll(false);
    TriggerSendEvent("GameStart");
    return true;
}

