        for ( ; ( (autoF8A13B7A_ai >= 0 && lv_i <= autoF8A13B7A_ae) || (autoF8A13B7A_ai < 0 && lv_i >= autoF8A13B7A_ae) ) ; lv_i += autoF8A13B7A_ai ) {
            if ((UnitGetType(EventUnitCreatedUnit()) == libCOMI_gv_cM_Fenix_ChampionUnitReplaceType[lv_i])) {
