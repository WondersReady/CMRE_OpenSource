    TriggerEnable(libCOMI_gt_CM_Tychus_HeroReviveUsed, false);
    TriggerAddEventUnitOrder(libCOMI_gt_CM_Tychus_HeroReviveUsed, null, AbilityCommand("TychusFakeReviveTrain", 255));
