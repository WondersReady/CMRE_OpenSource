bool libCOMI_gt_CM_AICommonBuffWatcher_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_createdUnitType;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_createdUnitType = UnitGetType(EventUnitCreatedUnit());

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitCreatedUnit()) == c_playerAny))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupEnemy, 1), UnitGetOwner(EventUnitCreatedUnit())) == false))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupEnemy, 2), UnitGetOwner(EventUnitCreatedUnit())) == false))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnitCreatedUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterPlayer) | (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)))) == false))) {
            return false;
        }

        if (!((lv_createdUnitType == "Caboose"))) {
            return false;
        }

        if (!((lv_createdUnitType == "TarsonisEngineFast"))) {
            return false;
        }

        if (!((lv_createdUnitType == "TarsonisEngine"))) {
            return false;
        }

        if (!((lv_createdUnitType == "FreightCar"))) {
            return false;
        }

        if (!((lv_createdUnitType == "MutatorStormCloud"))) {
            return false;
        }

        if (!((lv_createdUnitType == "MutatorPurifierBeam"))) {
            return false;
        }

        if (!((lv_createdUnitType == "MutatorTornado"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorAdd(EventUnitCreatedUnit(), "AllUnitBehaviorController", EventUnitCreatedUnit(), 1);
    return true;
}

