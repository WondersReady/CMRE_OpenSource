// Trigger: CM_Zeratul_PurificationNova_Finale
//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Zeratul_PurificationNova_Finale_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_u;
    int lv_p;
