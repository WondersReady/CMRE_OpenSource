    lv_newUnitType = libCOMI_gf_CM_Zeratul_DevolveGetNewUnitType(lv_oldUnitType, (libCOMI_gf_CM_Zeratul_DevolveGetUnitTier(UnitGetType(lp_targetUnit)) - 1));
