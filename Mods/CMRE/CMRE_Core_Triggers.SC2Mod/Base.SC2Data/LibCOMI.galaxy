    if (testConds) {
        if (!((libCOOC_gf_PlayerIsCommander(lv_stetmann) == true))) {
            return false;
        }

        if (!((libCOOC_gf_CC_CommanderLevel(EventPlayer(), "ZergStetmann") >= 7))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "HiveStetmann") || (UnitGetType(EventUnit()) == "LairStetmann")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libCOMI_gf_CM_Stetmann_ThrowPowerTowerEvent(UnitGetOwner(EventUnit()));
    return true;
}

