void libCOMI_gf_CM_Stetmann_ColorCalc () {
    // Variable Declarations
    int lv_indexPlayer;
    int lv_red;
    int lv_green;
    int lv_blue;
    int lv_alpha;
    int lv_count;

    // Automatic Variable Declarations
    const int auto09AEA5B8_ae = libCOOC_gv_cCC_MAXPLAYERS;
    const int auto09AEA5B8_ai = 1;

    // Variable Initialization
    lv_alpha = 255;

    // Implementation
    lv_indexPlayer = 1;
    for ( ; ( (auto09AEA5B8_ai >= 0 && lv_indexPlayer <= auto09AEA5B8_ae) || (auto09AEA5B8_ai < 0 && lv_indexPlayer >= auto09AEA5B8_ae) ) ; lv_indexPlayer += auto09AEA5B8_ai ) {
        if ((libCOMI_gv_cM_Stetmann_StetzoneMode[lv_indexPlayer] == libCOMI_ge_CM_Stetmann_StetzoneMode_MovementSpeed)) {
            lv_red += 35;
            lv_green += 134;
            lv_blue += 255;
            lv_count += 1;
        }
        else if ((libCOMI_gv_cM_Stetmann_StetzoneMode[lv_indexPlayer] == libCOMI_ge_CM_Stetmann_StetzoneMode_MPRegen)) {
            lv_red += 211;
            lv_green += 58;
            lv_blue += 250;
            lv_count += 1;
        }
        else if ((libCOMI_gv_cM_Stetmann_StetzoneMode[lv_indexPlayer] == libCOMI_ge_CM_Stetmann_StetzoneMode_HPRegen)) {
            lv_red += 80;
            lv_green += 210;
            lv_blue += 13;
            lv_count += 1;
        }
    }
    lv_red = (lv_red / lv_count);
    lv_green = (lv_green / lv_count);
    lv_blue = (lv_blue / lv_count);
    ActorSend(ActorFrom("::Scene"), (("SplatEmitterUpdateTint 255," + IntToString(lv_red) + "," + IntToString(lv_green) + "," + IntToString(lv_blue))));
}

