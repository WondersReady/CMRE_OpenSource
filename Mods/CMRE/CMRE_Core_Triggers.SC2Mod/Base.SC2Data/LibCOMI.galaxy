//--------------------------------------------------------------------------------------------------
bool libCOMI_gt_CM_Mengsk_WeaponPickup_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_pickup;
    unit lv_pickerupper;
    int lv_player;

    // Automatic Variable Declarations
    playergroup auto9F4F2F13_g;
    unitgroup auto663E6980_g;
    int auto663E6980_u;
    string auto2B75F55C_val;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerActiveCount(TriggerGetCurrent()) > 1)) {
        return true;
    }

    while (true) {
        Wait(0.5, c_timeGame);
        auto9F4F2F13_g = libCOOC_gf_CC_PlayersOfCommander("TerranMengsk");
        lv_player = -1;
        while (true) {
            lv_player = PlayerGroupNextPlayer(auto9F4F2F13_g, lv_player);
            if (lv_player < 0) { break; }
            if ((UnitGroupCount(libCOMI_gv_cM_Mengsk_WeaponPickups[lv_player], c_unitCountAlive) > 0) && (UnitGroupCount(libCOMI_gv_cM_Mengsk_WeaponPickerUppers[lv_player], c_unitCountAlive) > 0)) {
                auto663E6980_g = libCOMI_gv_cM_Mengsk_WeaponPickups[lv_player];
                auto663E6980_u = UnitGroupCount(auto663E6980_g, c_unitCountAll);
                for (;; auto663E6980_u -= 1) {
                    lv_pickup = UnitGroupUnitFromEnd(auto663E6980_g, auto663E6980_u);
                    if (lv_pickup == null) { break; }
                    lv_pickerupper = UnitGroupClosestToPoint(libCOMI_gv_cM_Mengsk_WeaponPickerUppers[lv_player], UnitGetPosition(lv_pickup));
                    if ((UnitIsAlive(lv_pickerupper) == true) && (DistanceBetweenPoints(UnitGetPosition(lv_pickup), UnitGetPosition(lv_pickerupper)) <= 2.0)) {
                        auto2B75F55C_val = UnitGetType(lv_pickup);
                        if (auto2B75F55C_val == "TrooperMengskWeaponAAPickup") {
                            libCOMI_gf_CM_Mengsk_ForceMorphTrooper(lv_player, lv_pickerupper, lv_pickup, "TrooperMengskMorphAA", "TrooperMengskWeaponAA", "SetWeaponAA");
                        }
                        else if (auto2B75F55C_val == "TrooperMengskWeaponFlamethrowerPickup") {
                            libCOMI_gf_CM_Mengsk_ForceMorphTrooper(lv_player, lv_pickerupper, lv_pickup, "TrooperMengskMorphFlamethrower", "TrooperMengskWeaponFlamethrower", "SetWeaponFlamethrower");
                        }
                        else if (auto2B75F55C_val == "TrooperMengskWeaponImprovedPickup") {
                            libCOMI_gf_CM_Mengsk_ForceMorphTrooper(lv_player, lv_pickerupper, lv_pickup, "TrooperMengskMorphImproved", "TrooperMengskWeaponImproved", "SetWeaponImproved");
                        }
                        else {
                            UnitGroupRemove(libCOMI_gv_cM_Mengsk_WeaponPickups[lv_player], lv_pickup);
                        }
                    }

                    lv_pickerupper = null;
                }
            }

        }
    }
    return true;
}

