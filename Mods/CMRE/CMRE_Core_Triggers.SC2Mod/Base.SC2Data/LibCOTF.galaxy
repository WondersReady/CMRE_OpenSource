bool libCOTF_gt_UT_Init_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_vCommander;
    string lv_playerPermission;

    // Automatic Variable Declarations
    playergroup autoB5E0E3FF_g;
