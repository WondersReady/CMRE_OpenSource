    lv_timerIndex = 1;
    for ( ; ( (auto0296F541_ai >= 0 && lv_timerIndex <= auto0296F541_ae) || (auto0296F541_ai < 0 && lv_timerIndex >= auto0296F541_ae) ) ; lv_timerIndex += auto0296F541_ai ) {
        if ((EventTimer() == libCOTF_gv_pingResetTimer[lv_timerIndex])) {
