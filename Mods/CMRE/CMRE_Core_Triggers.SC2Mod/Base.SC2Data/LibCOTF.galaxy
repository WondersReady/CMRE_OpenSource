            TextExpressionSetToken("Param/Expression/lib_COTF_E04685D1", "B", lv_vColor);
            TextExpressionSetToken("Param/Expression/lib_COTF_E04685D1", "C", StringExternal(libCOTF_gf_AF_GetButtonText(EventPlayer(), lv_vButtonIndex)));
