//--------------------------------------------------------------------------------------------------
bool libCOTF_gt_RealmofTrialsTestShowDamage_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_takenDamage;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGroupHasUnit(libCOTF_gv_realmofTrialsTestUnitGroup, EventUnit()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_takenDamage = EventUnitDamageAmount();
    UnitSetPropertyFixed(EventUnit(), c_unitPropLife, libCOTF_gv_realmofTrialsTestUnitCurrentVital[1]);
    UnitSetPropertyFixed(EventUnit(), c_unitPropShields, libCOTF_gv_realmofTrialsTestUnitCurrentVital[2]);
    UnitSetPropertyFixed(EventUnit(), c_unitPropEnergy, libCOTF_gv_realmofTrialsTestUnitCurrentVital[3]);
    libCOTF_gv_realmofTrialsTestDamagePanelALL += lv_takenDamage;
    BoardItemSetText(libCOTF_gv_realmofTrialsTestDamagePanel, 2, 5, FixedToText(libCOTF_gv_realmofTrialsTestDamagePanelALL, 2));
    BoardItemSetText(libCOTF_gv_realmofTrialsTestDamagePanel, 2, 6, FixedToText((libCOTF_gv_realmofTrialsTestDamagePanelALL - libCOTF_gv_realmofTrialsTestDamagePanelALLOld), 2));
    if ((EventUnit() == libCOTF_gv_realmofTrialsTestTarget)) {
        if ((libCOTF_gv_realmofTrialsTestDamagePanelShow == true)) {
            TextExpressionSetToken("Param/Expression/lib_COTF_0472712B", "A", StringToText((EventUnitDamageEffect())));
            TextExpressionSetToken("Param/Expression/lib_COTF_0472712B", "B", FixedToText(lv_takenDamage, 2));
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, TextExpressionAssemble("Param/Expression/lib_COTF_0472712B"));
        }

        libCOTF_gv_realmofTrialsTestDamagePanelTarget += lv_takenDamage;
        BoardItemSetText(libCOTF_gv_realmofTrialsTestDamagePanel, 2, 2, FixedToText(libCOTF_gv_realmofTrialsTestDamagePanelTarget, 2));
        BoardItemSetText(libCOTF_gv_realmofTrialsTestDamagePanel, 2, 3, FixedToText((libCOTF_gv_realmofTrialsTestDamagePanelALL - libCOTF_gv_realmofTrialsTestDamagePanelALLOld), 2));
    }

    return true;
}

