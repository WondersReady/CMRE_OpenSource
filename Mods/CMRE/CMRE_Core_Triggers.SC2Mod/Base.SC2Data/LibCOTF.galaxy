    for ( ; auto4D85761B_i <= UserDataInstanceCount(auto4D85761B_userType) ; auto4D85761B_i += 1 ) {
        lv_itInstance = UserDataInstance(auto4D85761B_userType, auto4D85761B_i);
        lv_itStart = StringToDateTime(UserDataGetString(libCOTF_gv_cM_EventsEventTable, lv_itInstance, "Start", 1));
        lv_itEnd = StringToDateTime(UserDataGetString(libCOTF_gv_cM_EventsEventTable, lv_itInstance, "End", 1));
        lv_itDisabler = UserDataGetGameLink("SCEvent_Events", lv_itInstance, "Disabler", 1);
        lv_itSkin = UserDataGetGameLink("SCEvent_Events", lv_itInstance, "Skin", 1);
        lv_itUpgrade = UserDataGetGameLink(libCOTF_gv_cM_EventsEventTable, lv_itInstance, "Upgrade", 1);
        lv_itMessage = (UserDataGetString(libCOTF_gv_cM_EventsEventTable, lv_itInstance, "Message", 1));
        lv_itMessageFilter = libNtve_gf_ConvertTargetFilterStringToUnitFilter(UserDataGetString(libCOTF_gv_cM_EventsEventTable, lv_itInstance, "MessageFilter", 1));
        if (((CatalogEntryIsValid(c_gameCatalogUpgrade, lv_itDisabler) == true) || (libNtve_gf_DateTimeisBetween(lv_curDateTime, lv_itStart, lv_itEnd) == false))) {
            continue;
        }

        if ((CatalogEntryIsValid(c_gameCatalogSkin, lv_itSkin) == true)) {
            autoA4D9DCE3_g = PlayerGroupActive();
            lv_itPlayer = -1;
            while (true) {
                lv_itPlayer = PlayerGroupNextPlayer(autoA4D9DCE3_g, lv_itPlayer);
                if (lv_itPlayer < 0) { break; }
                PlayerApplySkin(lv_itPlayer, lv_itSkin, true);
            }
        }

        if ((CatalogEntryIsValid(c_gameCatalogUpgrade, lv_itUpgrade) == true)) {
            autoFA9B7711_g = PlayerGroupActive();
            lv_itPlayer = -1;
            while (true) {
                lv_itPlayer = PlayerGroupNextPlayer(autoFA9B7711_g, lv_itPlayer);
                if (lv_itPlayer < 0) { break; }
                TechTreeUpgradeAddLevel(lv_itPlayer, lv_itUpgrade, 1);
            }
        }

        auto29553B7A_g = UnitGroup(null, c_playerAny, RegionEntireMap(), lv_itMessageFilter, 0);
        auto29553B7A_u = UnitGroupCount(auto29553B7A_g, c_unitCountAll);
        for (;; auto29553B7A_u -= 1) {
            lv_itUnit = UnitGroupUnitFromEnd(auto29553B7A_g, auto29553B7A_u);
            if (lv_itUnit == null) { break; }
            ActorSend(libNtve_gf_MainActorofUnit(lv_itUnit), lv_itMessage);
        }
    }
    return true;
}

