    libCOTF_gf_UT_Horde_Multiply(EventUnitCreatedUnit(), libCOTF_gv_uT_Horde_Chance);
    UnitGroupAddUnitGroup(libCOTF_gv_uT_Horde_UG_Wave, UnitLastCreatedGroup());
